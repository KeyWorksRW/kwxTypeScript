// slider.kwxts — port of wxSamples/src/widgets/slider.cpp
//
// wxSL_VERTICAL is wxVERTICAL; the other wxSL_* style bits used here are
// generated.

import {
    ALIGN_CENTRE_HORIZONTAL,
    ALIGN_CENTRE_VERTICAL,
    ALL,
    createWxBoxSizer,
    createWxButton,
    createWxRadioBox,
    createWxSlider,
    createWxTextCtrl,
    EVT_BUTTON,
    EVT_CHECKBOX,
    EVT_RADIOBOX,
    EVT_SCROLL_BOTTOM,
    EVT_SCROLL_CHANGED,
    EVT_SCROLL_LINEDOWN,
    EVT_SCROLL_LINEUP,
    EVT_SCROLL_PAGEDOWN,
    EVT_SCROLL_PAGEUP,
    EVT_SCROLL_THUMBRELEASE,
    EVT_SCROLL_THUMBTRACK,
    EVT_SCROLL_TOP,
    EVT_SLIDER,
    EVT_UPDATE_UI,
    EXPAND,
    HORIZONTAL,
    ID_ANY,
    ID_HIGHEST,
    LEFT,
    RIGHT,
    LogWarning,
    RA_SPECIFY_COLS,
    readAndDeleteWxString,
    SL_AUTOTICKS,
    SL_BOTH,
    SL_BOTTOM,
    SL_INVERSE,
    SL_LEFT,
    SL_MIN_MAX_LABELS,
    SL_RIGHT,
    SL_SELRANGE,
    SL_TOP,
    SL_VALUE_LABEL,
    VERTICAL,
    wxCheckBox,
    wxCommandEvent,
    wxRadioBox,
    wxScrollEvent,
    wxSizer,
    wxSlider,
    wxTextCtrl,
    wxUpdateUIEvent,
    wxWindow,
} from "kwx";
import { platform, Pointer, pointerOf } from "kwx/platform";

import {
    addSizer,
    addSpacer,
    addStretchSpacer,
    addWin,
    attrs,
    bindEvent,
    border,
    doubleBorder,
    logMessage,
    makeStaticBoxSizer,
    tripleBorder,
    WidgetsPage,
    withString,
} from "./common.kwxts";

// Control ids, in the order of the C++ enum.
const SLIDER_PAGE_RESET = ID_HIGHEST;
const SLIDER_PAGE_CLEAR = SLIDER_PAGE_RESET + 1;
const SLIDER_PAGE_SET_VALUE = SLIDER_PAGE_CLEAR + 1;
const SLIDER_PAGE_SET_MIN_AND_MAX = SLIDER_PAGE_SET_VALUE + 1;
const SLIDER_PAGE_SET_RANGE = SLIDER_PAGE_SET_MIN_AND_MAX + 1;
const SLIDER_PAGE_SET_LINE_SIZE = SLIDER_PAGE_SET_RANGE + 1;
const SLIDER_PAGE_SET_PAGE_SIZE = SLIDER_PAGE_SET_LINE_SIZE + 1;
const SLIDER_PAGE_SET_TICK_FREQ = SLIDER_PAGE_SET_PAGE_SIZE + 1;
const SLIDER_PAGE_SET_THUMB_LEN = SLIDER_PAGE_SET_TICK_FREQ + 1;
const SLIDER_PAGE_CUR_VALUE_TEXT = SLIDER_PAGE_SET_THUMB_LEN + 1;
const SLIDER_PAGE_VALUE_TEXT = SLIDER_PAGE_CUR_VALUE_TEXT + 1;
const SLIDER_PAGE_MIN_TEXT = SLIDER_PAGE_VALUE_TEXT + 1;
const SLIDER_PAGE_MAX_TEXT = SLIDER_PAGE_MIN_TEXT + 1;
const SLIDER_PAGE_RANGE_MIN_TEXT = SLIDER_PAGE_MAX_TEXT + 1;
const SLIDER_PAGE_RANGE_MAX_TEXT = SLIDER_PAGE_RANGE_MIN_TEXT + 1;
const SLIDER_PAGE_LINE_SIZE_TEXT = SLIDER_PAGE_RANGE_MAX_TEXT + 1;
const SLIDER_PAGE_PAGE_SIZE_TEXT = SLIDER_PAGE_LINE_SIZE_TEXT + 1;
const SLIDER_PAGE_TICK_FREQ_TEXT = SLIDER_PAGE_PAGE_SIZE_TEXT + 1;
const SLIDER_PAGE_THUMB_LEN_TEXT = SLIDER_PAGE_TICK_FREQ_TEXT + 1;
const SLIDER_PAGE_RADIO_SIDES = SLIDER_PAGE_THUMB_LEN_TEXT + 1;
const SLIDER_PAGE_BOTH_SIDES = SLIDER_PAGE_RADIO_SIDES + 1;
const SLIDER_PAGE_SELECT_RANGE = SLIDER_PAGE_BOTH_SIDES + 1;
const SLIDER_PAGE_SLIDER = SLIDER_PAGE_SELECT_RANGE + 1;

// Sides radiobox values.
const SLIDER_TICKS_NONE = 0;
const SLIDER_TICKS_TOP = 1;
const SLIDER_TICKS_BOTTOM = 2;
const SLIDER_TICKS_LEFT = 3;
const SLIDER_TICKS_RIGHT = 4;

const SL_VERTICAL = VERTICAL; // wxSL_VERTICAL is wxVERTICAL (0x0008)

// The exact order of the wxScrollEvent identifiers in include/wx/event.h.
const SCROLL_EVENT_NAMES = [
    "wxEVT_SCROLL_TOP",
    "wxEVT_SCROLL_BOTTOM",
    "wxEVT_SCROLL_LINEUP",
    "wxEVT_SCROLL_LINEDOWN",
    "wxEVT_SCROLL_PAGEUP",
    "wxEVT_SCROLL_PAGEDOWN",
    "wxEVT_SCROLL_THUMBTRACK",
    "wxEVT_SCROLL_THUMBRELEASE",
    "wxEVT_SCROLL_CHANGED",
];

// The event types bound by EVT_COMMAND_SCROLL().
const SCROLL_EVENT_TYPES = [
    EVT_SCROLL_TOP,
    EVT_SCROLL_BOTTOM,
    EVT_SCROLL_LINEUP,
    EVT_SCROLL_LINEDOWN,
    EVT_SCROLL_PAGEUP,
    EVT_SCROLL_PAGEDOWN,
    EVT_SCROLL_THUMBTRACK,
    EVT_SCROLL_THUMBRELEASE,
    EVT_SCROLL_CHANGED,
];

/** Number of wxSlider events logged so far (SliderWidgetsPage::ms_numSliderEvents). */
let sliderEventCount = 0;

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

/** wxLogWarning(). */
function logWarning(text: string): void
{
    withString(text.replace(/%/g, "%%"), (ptr) => LogWarning(ptr));
}

/** Current text of a text control, '' when the control has no value. */
function textValue(control: wxTextCtrl): string
{
    const value = control.GetValue();
    return value ? readAndDeleteWxString(value.ptr) : "";
}

/** wxString::ToLong(): null when the text is not a (signed) number. */
function integerValue(control: wxTextCtrl | null): number | null
{
    if (!control)
    {
        return null;
    }
    const text = textValue(control).trim();
    return /^[+-]?\d+$/.test(text) ? Number(text) : null;
}

/** wxTextCtrl::SetValue() */
function setTextValue(control: wxTextCtrl | null, text: string): void
{
    if (!control)
    {
        return;
    }
    withString(text, (ptr) => control.SetValue(ptr));
}

/** wxWindow::SetToolTip() */
function setToolTip(control: wxWindow | null, tip: string): void
{
    if (!control)
    {
        return;
    }
    withString(tip, (ptr) => control.SetToolTip(ptr));
}

/**
 * Builds the `char**` array expected by wxRadioBox_Create.  The returned
 * buffers must stay reachable until the native call returns.
 */
function makeRadioBox(
    parent: Pointer,
    id: number,
    caption: string,
    items: string[],
    dimension: number,
    style: number,
): wxRadioBox
{
    const buffers: Uint8Array[] = [];
    const pointers = new BigUint64Array(items.length);

    for (let index = 0; index < items.length; index++)
    {
        const bytes = new TextEncoder().encode(items[index] + "\0");
        buffers.push(bytes);
        const address = pointerOf(bytes);
        pointers[index] = address === null ? 0n : address;
    }

    const choices = pointerOf(pointers);

    const box = withString(caption, (ptr) =>
        createWxRadioBox(
            parent, id, ptr, -1, -1, -1, -1,
            items.length, choices, dimension, style,
        ));

    // Keep the string buffers alive until the constructor has copied them.
    void buffers;
    return box!;
}

export class SliderPage extends WidgetsPage
{
    // the slider range
    private minValue = 0;
    private maxValue = 100;

    // the slider selection range
    private rangeMin = 20;
    private rangeMax = 80;

    // the check/radio boxes for styles
    private chkMinMaxLabels: wxCheckBox | null = null;
    private chkValueLabel: wxCheckBox | null = null;
    private chkInverse: wxCheckBox | null = null;
    private chkTicks: wxCheckBox | null = null;
    private chkBothSides: wxCheckBox | null = null;
    private chkSelectRange: wxCheckBox | null = null;

    private radioSides: wxRadioBox | null = null;

    // the slider itself and the sizer it is in
    private slider: wxSlider | null = null;
    private sizerSlider: wxSizer | null = null;

    // the text entries for set value/range
    private textValueCtl: wxTextCtrl | null = null;
    private textMin: wxTextCtrl | null = null;
    private textMax: wxTextCtrl | null = null;
    private textRangeMin: wxTextCtrl | null = null;
    private textRangeMax: wxTextCtrl | null = null;
    private textLineSize: wxTextCtrl | null = null;
    private textPageSize: wxTextCtrl | null = null;
    private textTickFreq: wxTextCtrl | null = null;
    private textThumbLen: wxTextCtrl | null = null;

    constructor(parent: Pointer)
    {
        super(parent, "icons/slider");
    }

    override getWidget(): wxWindow | null
    {
        return this.slider;
    }

    override createContent(): void
    {
        const sizerTop = createWxBoxSizer(HORIZONTAL)!;

        // left pane
        const sizerLeft = makeStaticBoxSizer(
            this.page.ptr, VERTICAL, "&Set style");

        this.chkInverse = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "&Inverse", ID_ANY, sizerLeft.box.ptr);
        this.chkTicks = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Show &ticks", ID_ANY, sizerLeft.box.ptr);
        this.chkMinMaxLabels = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Show min/max &labels", ID_ANY,
            sizerLeft.box.ptr);
        this.chkValueLabel = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Show &value label", ID_ANY, sizerLeft.box.ptr);

        const sides = ["default", "top", "bottom", "left", "right"];
        this.radioSides = makeRadioBox(
            sizerLeft.box.ptr, SLIDER_PAGE_RADIO_SIDES, "&Label position",
            sides, 1, RA_SPECIFY_COLS);
        addWin(sizerLeft.sizer, this.radioSides, 0, EXPAND, border());

        this.chkBothSides = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "&Both sides", SLIDER_PAGE_BOTH_SIDES,
            sizerLeft.box.ptr);
        this.chkSelectRange = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "&Selection range", SLIDER_PAGE_SELECT_RANGE,
            sizerLeft.box.ptr);

        setToolTip(this.chkBothSides,
            "\"Both sides\" is only supported \nin Universal");
        setToolTip(this.chkSelectRange,
            "\"Select range\" is only supported \nin wxMSW");

        addSpacer(sizerLeft.sizer, this.dip(5));

        const resetButton = withString("&Reset", (ptr) =>
            createWxButton(sizerLeft.box.ptr, SLIDER_PAGE_RESET, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(sizerLeft.sizer, resetButton, 0,
            ALIGN_CENTRE_HORIZONTAL | ALL, tripleBorder());

        // middle pane
        const sizerMiddle = makeStaticBoxSizer(
            this.page.ptr, VERTICAL, "&Change slider value");

        let sizerRow = this.createSizerWithTextAndLabel(
            "Current value", SLIDER_PAGE_CUR_VALUE_TEXT,
            (text) => text.SetEditable(false),
            sizerMiddle.box.ptr);
        addSizer(sizerMiddle.sizer, sizerRow, 0, EXPAND, border());

        sizerRow = this.createSizerWithTextAndButton(
            SLIDER_PAGE_SET_VALUE, "Set &value", SLIDER_PAGE_VALUE_TEXT,
            (text) =>
            {
                this.textValueCtl = text;
            },
            sizerMiddle.box.ptr);
        addSizer(sizerMiddle.sizer, sizerRow, 0, EXPAND, border());

        sizerRow = this.createSizerWithTextAndButton(
            SLIDER_PAGE_SET_MIN_AND_MAX, "&Min and max", SLIDER_PAGE_MIN_TEXT,
            (text) =>
            {
                this.textMin = text;
            },
            sizerMiddle.box.ptr);
        this.textMax = withString("", (ptr) =>
            createWxTextCtrl(sizerMiddle.box.ptr, SLIDER_PAGE_MAX_TEXT, ptr,
                -1, -1, -1, -1, BigInt(0)));
        if (this.textMax)
        {
            addWin(sizerRow, this.textMax, 1,
                ALIGN_CENTRE_VERTICAL | LEFT, border());
        }
        setTextValue(this.textMin, String(this.minValue));
        setTextValue(this.textMax, String(this.maxValue));
        addSizer(sizerMiddle.sizer, sizerRow, 0, EXPAND, border());

        sizerRow = this.createSizerWithTextAndButton(
            SLIDER_PAGE_SET_RANGE, "&Selection", SLIDER_PAGE_RANGE_MIN_TEXT,
            (text) =>
            {
                this.textRangeMin = text;
            },
            sizerMiddle.box.ptr);
        this.textRangeMax = withString("", (ptr) =>
            createWxTextCtrl(sizerMiddle.box.ptr, SLIDER_PAGE_RANGE_MAX_TEXT,
                ptr, -1, -1, -1, -1, BigInt(0)));
        if (this.textRangeMax)
        {
            addWin(sizerRow, this.textRangeMax, 1,
                ALIGN_CENTRE_VERTICAL | LEFT, border());
        }
        setTextValue(this.textRangeMin, String(this.rangeMin));
        setTextValue(this.textRangeMax, String(this.rangeMax));
        addSizer(sizerMiddle.sizer, sizerRow, 0, EXPAND, border());

        sizerRow = this.createSizerWithTextAndButton(
            SLIDER_PAGE_SET_LINE_SIZE, "Li&ne size", SLIDER_PAGE_LINE_SIZE_TEXT,
            (text) =>
            {
                this.textLineSize = text;
            },
            sizerMiddle.box.ptr);
        addSizer(sizerMiddle.sizer, sizerRow, 0, EXPAND, border());

        sizerRow = this.createSizerWithTextAndButton(
            SLIDER_PAGE_SET_PAGE_SIZE, "P&age size", SLIDER_PAGE_PAGE_SIZE_TEXT,
            (text) =>
            {
                this.textPageSize = text;
            },
            sizerMiddle.box.ptr);
        addSizer(sizerMiddle.sizer, sizerRow, 0, EXPAND, border());

        sizerRow = this.createSizerWithTextAndButton(
            SLIDER_PAGE_SET_TICK_FREQ, "Tick &frequency",
            SLIDER_PAGE_TICK_FREQ_TEXT,
            (text) =>
            {
                this.textTickFreq = text;
            },
            sizerMiddle.box.ptr);
        setTextValue(this.textTickFreq, "10");
        addSizer(sizerMiddle.sizer, sizerRow, 0, EXPAND, border());

        sizerRow = this.createSizerWithTextAndButton(
            SLIDER_PAGE_SET_THUMB_LEN, "Thumb &length",
            SLIDER_PAGE_THUMB_LEN_TEXT,
            (text) =>
            {
                this.textThumbLen = text;
            },
            sizerMiddle.box.ptr);
        addSizer(sizerMiddle.sizer, sizerRow, 0, EXPAND, border());

        // right pane
        const sizerRight = createWxBoxSizer(HORIZONTAL)!;
        this.sizerSlider = sizerRight; // save it to modify it later

        this.reset();
        this.createSlider();

        // the 3 panes compose the window
        addSizer(sizerTop, sizerLeft.sizer, 0, EXPAND | (ALL & ~LEFT),
            doubleBorder());
        addSizer(sizerTop, sizerMiddle.sizer, 1, EXPAND, doubleBorder());
        addSizer(sizerTop, sizerRight, 1, EXPAND | (ALL & ~RIGHT),
            doubleBorder());

        // final initializations
        this.page.SetSizer(sizerTop.ptr, false);

        this.bindEvents();
    }

    override recreateWidget(): void
    {
        this.createSlider();
    }

    // -- event bindings ------------------------------------------------------

    private bindEvents(): void
    {
        const buttons: Array<[number, () => void]> = [
            [SLIDER_PAGE_RESET, () => this.onButtonReset()],
            [SLIDER_PAGE_SET_VALUE, () => this.onButtonSetValue()],
            [SLIDER_PAGE_SET_MIN_AND_MAX, () => this.onButtonSetMinAndMax()],
            [SLIDER_PAGE_SET_RANGE, () => this.onButtonSetRange()],
            [SLIDER_PAGE_SET_LINE_SIZE, () => this.doSetLineSize()],
            [SLIDER_PAGE_SET_PAGE_SIZE, () => this.doSetPageSize()],
            [SLIDER_PAGE_SET_TICK_FREQ, () => this.doSetTickFreq()],
            [SLIDER_PAGE_SET_THUMB_LEN, () => this.doSetThumbLen()],
        ];

        for (const [id, action] of buttons)
        {
            bindEvent(this.page, id, id, EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                action();
            });
        }

        bindEvent(this.page, ID_ANY, ID_ANY, EVT_CHECKBOX, (eventPtr) =>
        {
            if (!eventPtr) return;
            this.createSlider();
        });
        bindEvent(this.page, ID_ANY, ID_ANY, EVT_RADIOBOX, (eventPtr) =>
        {
            if (!eventPtr) return;
            this.createSlider();
        });

        // EVT_UPDATE_UI: bound on the control itself.
        this.bindUpdateUI(SLIDER_PAGE_SET_VALUE, (event) =>
        {
            const value = integerValue(this.textValueCtl);
            event.Enable(value !== null && this.isValidValue(value));
        });

        this.bindUpdateUI(SLIDER_PAGE_SET_LINE_SIZE, (event) =>
        {
            const lineSize = integerValue(this.textLineSize);
            event.Enable(lineSize !== null && lineSize > 0 &&
                lineSize <= this.maxValue - this.minValue);
        });

        this.bindUpdateUI(SLIDER_PAGE_SET_PAGE_SIZE, (event) =>
        {
            const pageSize = integerValue(this.textPageSize);
            event.Enable(pageSize !== null && pageSize > 0 &&
                pageSize <= this.maxValue - this.minValue);
        });

        this.bindUpdateUI(SLIDER_PAGE_SET_TICK_FREQ, (event) =>
        {
            const frequency = integerValue(this.textTickFreq);
            event.Enable(
                this.chkTicks?.GetValue() === true &&
                frequency !== null && frequency > 0 &&
                frequency <= this.maxValue - this.minValue);
        });

        this.bindUpdateUI(SLIDER_PAGE_SET_THUMB_LEN, (event) =>
        {
            event.Enable(integerValue(this.textThumbLen) !== null);
        });

        this.bindUpdateUI(SLIDER_PAGE_SET_MIN_AND_MAX, (event) =>
        {
            const minNew = integerValue(this.textMin);
            const maxNew = integerValue(this.textMax);
            event.Enable(minNew !== null && maxNew !== null && minNew < maxNew);
        });

        this.bindUpdateUI(SLIDER_PAGE_SET_RANGE, (event) =>
        {
            const minNew = integerValue(this.textRangeMin);
            const maxNew = integerValue(this.textRangeMax);
            event.Enable(
                this.chkSelectRange?.GetValue() === true &&
                minNew !== null && maxNew !== null &&
                minNew < maxNew &&
                minNew >= this.minValue && maxNew <= this.maxValue);
        });

        this.bindUpdateUI(SLIDER_PAGE_RESET, (event) =>
        {
            event.Enable(
                this.chkInverse?.GetValue() === true ||
                this.chkTicks?.GetValue() !== true ||
                this.chkValueLabel?.GetValue() !== true ||
                this.chkMinMaxLabels?.GetValue() !== true ||
                this.chkBothSides?.GetValue() === true ||
                this.chkSelectRange?.GetValue() === true ||
                (this.radioSides ? this.radioSides.GetSelection() : 0) !==
                    SLIDER_TICKS_NONE);
        });

        this.bindUpdateUI(SLIDER_PAGE_CUR_VALUE_TEXT, (event) =>
        {
            const slider = this.slider;
            if (!slider)
            {
                return;
            }
            withString(String(slider.GetValue()), (ptr) => event.SetText(ptr));
        });

        this.bindUpdateUI(SLIDER_PAGE_RADIO_SIDES, (event) =>
        {
            event.Enable(
                this.chkValueLabel?.GetValue() === true ||
                this.chkTicks?.GetValue() === true);
        });

        // "Both sides" is only supported in Universal and wxMSW.
        this.bindUpdateUI(SLIDER_PAGE_BOTH_SIDES, (event) =>
        {
            event.Enable(platform === "windows");
        });

        // "Select range" is only supported in wxMSW.
        this.bindUpdateUI(SLIDER_PAGE_SELECT_RANGE, (event) =>
        {
            event.Enable(platform === "windows");
        });
    }

    /** Binds EVT_UPDATE_UI on the control that owns `id`. */
    private bindUpdateUI(
        id: number,
        handler: (event: wxUpdateUIEvent) => void,
    ): void
    {
        const control = this.page.FindWindowByIdSelf(id);
        if (!control)
        {
            return;
        }
        bindEvent(control, id, id, EVT_UPDATE_UI, (eventPtr) =>
        {
            if (!eventPtr) return;
            handler(new wxUpdateUIEvent(eventPtr, true));
        });
    }

    // -- operations ----------------------------------------------------------

    private isValidValue(value: number): boolean
    {
        return value >= this.minValue && value <= this.maxValue;
    }

    /** Reset the slider parameters. */
    private reset(): void
    {
        this.chkInverse?.SetValue(false);
        this.chkTicks?.SetValue(true);
        this.chkValueLabel?.SetValue(true);
        this.chkMinMaxLabels?.SetValue(true);
        this.chkBothSides?.SetValue(false);
        this.chkSelectRange?.SetValue(false);

        this.radioSides?.SetSelection(SLIDER_TICKS_NONE);
    }

    /** (Re)create the slider. */
    private createSlider(): void
    {
        const sizer = this.sizerSlider;
        if (!sizer)
        {
            return;
        }

        let flags = attrs.defaultFlags;

        if (this.chkInverse?.GetValue())
        {
            flags |= SL_INVERSE;
        }
        if (this.chkMinMaxLabels?.GetValue())
        {
            flags |= SL_MIN_MAX_LABELS;
        }
        if (this.chkValueLabel?.GetValue())
        {
            flags |= SL_VALUE_LABEL;
        }
        if (this.chkTicks?.GetValue())
        {
            flags |= SL_AUTOTICKS;
        }

        // The style names refer to the _ticks_ positions while the labels sit
        // on the opposite side, hence the apparent reversal below.
        switch (this.radioSides ? this.radioSides.GetSelection() : SLIDER_TICKS_NONE)
        {
            case SLIDER_TICKS_TOP:
                flags |= SL_BOTTOM;
                break;

            case SLIDER_TICKS_LEFT:
                flags |= SL_RIGHT | SL_VERTICAL;
                break;

            case SLIDER_TICKS_BOTTOM:
                flags |= SL_TOP;
                break;

            case SLIDER_TICKS_RIGHT:
                flags |= SL_LEFT | SL_VERTICAL;
                break;

            default: // nothing
                break;
        }

        if (this.chkBothSides?.GetValue())
        {
            flags |= SL_BOTH;
        }
        if (this.chkSelectRange?.GetValue())
        {
            flags |= SL_SELRANGE;
        }

        let value = this.minValue;
        const previous = this.slider;
        if (previous)
        {
            const oldValue = previous.GetValue();
            if (this.isValidValue(oldValue))
            {
                value = oldValue;
            }

            sizer.DetachWindow(previous.ptr);

            if (sizer.GetItemCount())
            {
                // we have 2 spacers, remove them too
                sizer.Remove(0);
                sizer.Remove(0);
            }

            previous.Delete();
            this.slider = null;
        }

        const slider = createWxSlider(
            this.page.ptr, SLIDER_PAGE_SLIDER, value,
            this.minValue, this.maxValue, -1, -1, -1, -1, BigInt(flags));
        if (!slider)
        {
            return;
        }
        this.slider = slider;

        this.notifyWidgetRecreation(slider);

        if (slider.HasFlag(SL_VERTICAL))
        {
            addStretchSpacer(sizer, 1);
            addWin(sizer, slider, 0, EXPAND, border());
            addStretchSpacer(sizer, 1);
        }
        else
        {
            addWin(sizer, slider, 1,
                ALIGN_CENTRE_HORIZONTAL | ALIGN_CENTRE_VERTICAL, border());
        }

        bindEvent(slider, SLIDER_PAGE_SLIDER, SLIDER_PAGE_SLIDER, EVT_SLIDER,
            (eventPtr) =>
            {
                if (!eventPtr) return;
                const event = new wxCommandEvent(eventPtr, true);
                logMessage(
                    `Slider event #${sliderEventCount++}: wxEVT_SLIDER (value = ${event.GetInt()})`);
            });

        for (const type of SCROLL_EVENT_TYPES)
        {
            bindEvent(slider, SLIDER_PAGE_SLIDER, SLIDER_PAGE_SLIDER, type,
                (eventPtr) =>
                {
                    if (!eventPtr) return;
                    this.onSliderScroll(eventPtr);
                });
        }

        setTextValue(this.textLineSize, String(slider.GetLineSize()));
        setTextValue(this.textPageSize, String(slider.GetPageSize()));
        setTextValue(this.textThumbLen, String(slider.GetThumbLength()));

        if (this.chkTicks?.GetValue())
        {
            this.doSetTickFreq();
        }

        if (this.chkSelectRange?.GetValue())
        {
            this.doSetSelectionRange();
        }

        this.page.Layout();
    }

    private doSetLineSize(): void
    {
        const slider = this.slider;
        if (!slider)
        {
            return;
        }

        const lineSize = integerValue(this.textLineSize);
        if (lineSize === null)
        {
            logWarning("Invalid slider line size");

            return;
        }

        slider.SetLineSize(lineSize);

        if (slider.GetLineSize() !== lineSize)
        {
            logWarning("Invalid line size in slider.");
        }
    }

    private doSetPageSize(): void
    {
        const slider = this.slider;
        if (!slider)
        {
            return;
        }

        const pageSize = integerValue(this.textPageSize);
        if (pageSize === null)
        {
            logWarning("Invalid slider page size");

            return;
        }

        slider.SetPageSize(pageSize);

        if (slider.GetPageSize() !== pageSize)
        {
            logWarning("Invalid page size in slider.");
        }
    }

    private doSetTickFreq(): void
    {
        const slider = this.slider;
        if (!slider)
        {
            return;
        }

        const frequency = integerValue(this.textTickFreq);
        if (frequency === null)
        {
            logWarning("Invalid slider tick frequency");

            return;
        }

        slider.SetTickFreq(frequency);
    }

    private doSetThumbLen(): void
    {
        const slider = this.slider;
        if (!slider)
        {
            return;
        }

        const length = integerValue(this.textThumbLen);
        if (length === null)
        {
            logWarning("Invalid slider thumb length");

            return;
        }

        slider.SetThumbLength(length);

        if (slider.GetThumbLength() !== length)
        {
            logWarning(
                `Invalid thumb length in slider: ${slider.GetThumbLength()}`);
        }

        this.page.Layout();
    }

    private doSetSelectionRange(): void
    {
        const slider = this.slider;
        if (!slider)
        {
            return;
        }

        const minNew = integerValue(this.textRangeMin);
        const maxNew = integerValue(this.textRangeMax);

        if (minNew === null || maxNew === null ||
            minNew >= maxNew || minNew < this.minValue ||
            maxNew > this.maxValue)
        {
            logWarning("Invalid selection range for the slider.");

            return;
        }

        this.rangeMin = minNew;
        this.rangeMax = maxNew;

        slider.SetSelection(this.rangeMin, this.rangeMax);

        if (slider.GetSelStart() !== this.rangeMin ||
            slider.GetSelEnd() !== this.rangeMax)
        {
            logWarning("Invalid selection range in slider.");
        }
    }

    // -- event handlers ------------------------------------------------------

    private onButtonReset(): void
    {
        this.reset();

        this.createSlider();
    }

    private onButtonSetMinAndMax(): void
    {
        const slider = this.slider;
        if (!slider)
        {
            return;
        }

        const minNew = integerValue(this.textMin);
        const maxNew = integerValue(this.textMax);

        if (minNew === null || maxNew === null || minNew >= maxNew)
        {
            logWarning("Invalid min/max values for the slider.");

            return;
        }

        this.minValue = minNew;
        this.maxValue = maxNew;

        slider.SetRange(minNew, maxNew);

        if (slider.GetMin() !== this.minValue ||
            slider.GetMax() !== this.maxValue)
        {
            logWarning("Invalid range in slider.");
        }
    }

    private onButtonSetRange(): void
    {
        this.doSetSelectionRange();
    }

    private onButtonSetValue(): void
    {
        const slider = this.slider;
        if (!slider)
        {
            return;
        }

        const value = integerValue(this.textValueCtl);
        if (value === null || !this.isValidValue(value))
        {
            logWarning("Invalid slider value.");

            return;
        }

        slider.SetValue(value);
    }

    private onSliderScroll(eventPtr: Pointer): void
    {
        const event = new wxScrollEvent(eventPtr, true);
        const index = event.GetEventType() - EVT_SCROLL_TOP;
        const name = SCROLL_EVENT_NAMES[index] ?? "wxEVT_SCROLL_UNKNOWN";

        logMessage(
            `Slider event #${sliderEventCount++}: ${name} `
            + `(pos = ${event.GetPosition()}, int value = `
            + `${new wxCommandEvent(eventPtr, true).GetInt()})`);
    }
}

export function createSliderPage(parent: Pointer): WidgetsPage
{
    return new SliderPage(parent);
}
