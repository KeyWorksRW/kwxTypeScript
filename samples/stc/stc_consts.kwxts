// stc_consts.kwxts — Scintilla control (wxSTC_*) constant values.
//
// BINDING GAP: kwxFFI exports no wxSTC_* constant at all. The generated
// constant table (wx/kwx_constants_table_gen.cpp, 2615 entries) and
// wx/kwx_constants_gen.ts contain not one of them, and no native
// `exp_wxSTC_*` accessor exists either, so `bound: false` for every symbol
// below. The sample needs them for its lexer/style/margin/fold/annotation
// setup, so the values are reproduced verbatim from the wxWidgets 3.3.4
// header the bindings are built against:
//
//     C:/rwCode/forks/wxWidgets/include/wx/stc/stc.h
//
// Each value is prefixed with its #define line number in that header. If the
// bindings gain real wxSTC_* constants, delete this module and import them
// from "kwx" instead.

// stc.h:68-69
export const wxSTC_WS_INVISIBLE = 0;
export const wxSTC_WS_VISIBLEALWAYS = 1;

// stc.h:74-76
export const wxSTC_EOL_CRLF = 0;
export const wxSTC_EOL_CR = 1;
export const wxSTC_EOL_LF = 2;

// stc.h:92-118 — marker symbols
