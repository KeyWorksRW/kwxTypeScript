function fileSave(): void
{
    const current = state;
    if (!current) return;

    const dialog = withStrings([
        "Testing save file dialog", "", "myletter.doc",
        "Text files (*.txt)|*.txt|Document files (*.doc;*.ods)|*.doc;*.ods",
    ], (ptrs) => createWxFileDialog(
        current.frame.ptr, ptrs[0], ptrs[1], ptrs[2], ptrs[3],
        -1, -1, FD_SAVE | FD_OVERWRITE_PROMPT, -1, -1));
    if (!dialog) return;

    dialog.SetFilterIndex(1);

    encryptCheckBox = null;
    encryptValue = false;

    const addCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_fun, customizerPtr) =>
        {
            if (!customizerPtr) return;
            const customizer = wrapWxFileDialogCustomize(customizerPtr);
            encryptCheckBox = withString("Encrypt",
                (ptr) => customizer.AddCheckBox(ptr));
        });
    const transferCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_fun) =>
        {
            if (encryptCheckBox) encryptValue = encryptCheckBox.GetValue();
        });
    customizerCallbacks.push(addCallback, transferCallback);

    const hook = createWxFileDialogCustomizeHook(
        null, addCallback.pointer, null, transferCallback.pointer);
    if (hook) dialog.SetCustomizeHook(hook.ptr);

    if (dialog.ShowModal() === ID_OK)
    {
        const message = `${takeText(dialog.GetPath())}, filter ` +
            `${dialog.GetFilterIndex()}${encryptValue ? ", encrypt" : ""}`;
        withString(message, (ptr) => LogMessage(ptr));
    }

    dialog.Destroy();
    if (hook) hook.Delete();
    encryptCheckBox = null;
    closeCustomizerCallbacks();
}

