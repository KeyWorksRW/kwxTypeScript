// event.kwxts — kwxTypeScript port of wxSamples/src/event
//
// Covers event.cpp (main frame, dynamic bind/connect, push/pop handlers, custom
// event), gestures.cpp (app-level FilterEvent, gesture and mouse frames) and
// chessboard.cpp/.h (new wxEvent class demo).
//
// Run from the repository root:
//   bin\Release\kwxts.exe samples\event\event.kwxts
//
// Port notes (see the final report for the full list):
//   * MyApp::FilterEvent() is an application-level override. It is reproduced
//     with wxEventFilter: createWxEventFilter() + wxEvtHandler_AddFilter()
//     installs a filter on the runtime's own wxApp that runs before every
//     handler, and the callback reports wxEventFilter::Event_Skip with
//     wxEventFilter_SetResult() (the thunk returns void). kwxEventFilter calls
//     the callback as FilterFunc(pObject, event), so the event pointer is the
//     callback's second argument.
//   * ChessBoardEvent (a new wxEvent-derived class with file/rank fields) cannot
//     be declared. wxNewEventType() supplies the two event types and a
//     wxCommandEvent carries the payload in GetExtraLong() as four packed bytes
//     (file, rank, fileTo, rankTo).
//   * ChessBoard::DoGetBestClientSize() is a kwxPanel hook: the board is a
//     kwxPanel and SetOnDoGetBestClientSize() reports the same pixel size, so
//     the sizer result matches the C++ override exactly.
//
// Substitutions:
//   * sample.xpm is loaded at run time instead of being compiled in by
//     wxICON(sample) (same artwork, same icon).
//   * gestures.cpp uses `#include "../image/horse.xpm"`; horse.xpm is loaded at
//     run time from the sample folder (same artwork, same bitmap).
//   * wxTwoFingerTapEvent, wxLongPressEvent and wxPressAndTapEvent add no members
//     of their own, so kwxgen emits no wrapper for them; their handlers wrap the
//     event as wxGestureEvent, which supplies every accessor they use.

declare const __dirname: string;

