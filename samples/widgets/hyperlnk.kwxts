// hyperlnk.kwxts — port of wxSamples/src/widgets/hyperlnk.cpp
//
// Both wxHyperlinkCtrl and wxGenericHyperlinkCtrl are selectable through the
// "Use generic version" check box, as in the C++ sample.
//
// wxHyperlinkCtrl is not a wxWindow in the bindings, so the window part of
// the control (label, sizer placement, destruction) goes through
// wrapWxWindow().

import {
    ALIGN_CENTRE,
    ALL,
    BORDER_MASK,
    createWxBoxSizer,
    createWxCheckBox,
    createWxGenericHyperlinkCtrl,
    createWxHyperlinkCtrl,
    createWxRadioBox,
    createWxStaticText,
    EVT_BUTTON,
    EVT_CHECKBOX,
    EVT_RADIOBOX,
    EXPAND,
    HL_ALIGN_CENTRE,
    HL_ALIGN_LEFT,
    HL_ALIGN_RIGHT,
    HL_DEFAULT_STYLE,
    HORIZONTAL,
    ID_ANY,
    ID_HIGHEST,
    LEFT,
    RA_SPECIFY_COLS,
    readAndDeleteWxString,
    RIGHT,
    VERTICAL,
    wxCheckBox,
    wxGenericHyperlinkCtrl,
    wxHyperlinkCtrl,
    wxRadioBox,
    wxTextCtrl,
    wxWindow,
    wrapWxGenericHyperlinkCtrl,
    wrapWxHyperlinkCtrl,
    wrapWxWindow,
} from "kwx";
import { Pointer, pointerOf } from "kwx/platform";

import {
    addSizer,
    addStretchSpacer,
    addWin,
    attrs,
    bindEvent,
    border,
    doubleBorder,
    logMessage,
    makeStaticBoxSizer,
    WidgetsPage,
    withString,
    withStrings,
} from "./common.kwxts";

const HYPERLINK_PAGE_RESET = ID_HIGHEST;
const HYPERLINK_PAGE_SET_LABEL = HYPERLINK_PAGE_RESET + 1;
const HYPERLINK_PAGE_SET_URL = HYPERLINK_PAGE_SET_LABEL + 1;
const HYPERLINK_PAGE_CTRL = HYPERLINK_PAGE_SET_URL + 1;

/** Alignment radio box indices (Align_Left, Align_Centre, Align_Right). */
const ALIGN_LEFT_INDEX = 0;
const ALIGN_CENTRE_INDEX = 1;
const ALIGN_RIGHT_INDEX = 2;

/**
 * Builds the `char**` array expected by wxRadioBox_Create.  The returned
 * buffers must stay reachable until the native call returns.
 */
function makeRadioBox(
    parent: Pointer,
    caption: string,
    items: string[],
    dimension: number,
    style: number,
): wxRadioBox
{
    const buffers: Uint8Array[] = [];
    const pointers = new BigUint64Array(items.length);

    for (let index = 0; index < items.length; index++)
    {
        const bytes = new TextEncoder().encode(items[index] + "\0");
        buffers.push(bytes);
        const address = pointerOf(bytes);
        pointers[index] = address === null ? 0n : address;
    }

    const choices = pointerOf(pointers);

    const box = withString(caption, (ptr) =>
        createWxRadioBox(
            parent, ID_ANY, ptr, -1, -1, -1, -1,
            items.length, choices, dimension, style,
        ));

    // Keep the string buffers alive until the constructor has copied them.
    void buffers;
    return box!;
}

/** Either hyperlink implementation, tracked together with its class. */
interface HyperlinkHandle
{
    ptr: Pointer;
    generic: boolean;
}

export class HyperlinkPage extends WidgetsPage
{
    private hyperlink: HyperlinkHandle | null = null;
    private hyperlinkLong: HyperlinkHandle | null = null;

    private labelText: wxTextCtrl | null = null;
    private urlText: wxTextCtrl | null = null;

    private alignRadio: wxRadioBox | null = null;
    private checkGeneric: wxCheckBox | null = null;

    constructor(parent: Pointer)
    {
        super(parent, "icons/hyperlnk");
    }

    override getWidget(): wxWindow | null
    {
        return this.hyperlink ? wrapWxWindow(this.hyperlink.ptr) : null;
    }

    override getWidgets(): wxWindow[]
    {
        const widgets = super.getWidgets();
        if (this.hyperlinkLong)
        {
            widgets.push(wrapWxWindow(this.hyperlinkLong.ptr));
        }
        return widgets;
    }

    override createContent(): void
    {
        const sizerTop = createWxBoxSizer(HORIZONTAL)!;

        // left pane
        const sizerLeft = makeStaticBoxSizer(
            this.page.ptr, VERTICAL, "Hyperlink details");

        const labelRow = this.createSizerWithTextAndButton(
            HYPERLINK_PAGE_SET_LABEL, "Set &Label", ID_ANY, (text) =>
            {
                this.labelText = text;
            }, sizerLeft.box.ptr);
        addSizer(sizerLeft.sizer, labelRow, 0, RIGHT, border());

        const urlRow = this.createSizerWithTextAndButton(
            HYPERLINK_PAGE_SET_URL, "Set &URL", ID_ANY, (text) =>
            {
                this.urlText = text;
            }, sizerLeft.box.ptr);
        addSizer(sizerLeft.sizer, urlRow, 0, RIGHT, border());

        const alignRadio = makeRadioBox(
            sizerLeft.box.ptr, "alignment",
            ["&left", "&centre", "&right"], 0, RA_SPECIFY_COLS);
        this.alignRadio = alignRadio;
        // start with "centre" selected since wxHL_DEFAULT_STYLE contains
        // wxHL_ALIGN_CENTRE
        alignRadio.SetSelection(ALIGN_CENTRE_INDEX);
        addWin(sizerLeft.sizer, alignRadio, 0, EXPAND, border());

        this.checkGeneric = withString("Use generic version", (ptr) =>
            createWxCheckBox(sizerLeft.box.ptr, ID_ANY, ptr,
                -1, -1, -1, -1, 0))!;
        const checkGeneric = this.checkGeneric;
        addWin(sizerLeft.sizer, checkGeneric, 0, EXPAND, border());

        // right pane
        const szHyperlinkLong = createWxBoxSizer(VERTICAL)!;
        const szHyperlink = createWxBoxSizer(HORIZONTAL)!;

        const visitText = withString("Visit ", (ptr) =>
            createWxStaticText(this.page.ptr, ID_ANY, ptr,
                -1, -1, -1, -1, 0))!;

        this.hyperlink = this.createHyperlinkControl(
            HYPERLINK_PAGE_CTRL, "wxWidgets website", "www.wxwidgets.org",
            HL_DEFAULT_STYLE);

        const funText = withString(" for fun!", (ptr) =>
            createWxStaticText(this.page.ptr, ID_ANY, ptr,
                -1, -1, -1, -1, 0))!;

        addStretchSpacer(szHyperlink);
        addWin(szHyperlink, visitText, 0, ALIGN_CENTRE, 0);
        if (this.hyperlink)
        {
            addWin(szHyperlink, wrapWxWindow(this.hyperlink.ptr), 0, ALIGN_CENTRE, 0);
        }
        addWin(szHyperlink, funText, 0, ALIGN_CENTRE, 0);
        addStretchSpacer(szHyperlink);
        szHyperlink.SetMinSize(this.dip(150), 0);

        this.hyperlinkLong = this.createHyperlinkControl(
            ID_ANY, "This is a long hyperlink", "www.wxwidgets.org",
            HL_DEFAULT_STYLE);

        addStretchSpacer(szHyperlinkLong);
        addSizer(szHyperlinkLong, szHyperlink, 0, ALIGN_CENTRE, 0);
        addStretchSpacer(szHyperlinkLong);
        if (this.hyperlinkLong)
        {
            addWin(szHyperlinkLong, wrapWxWindow(this.hyperlinkLong.ptr),
                0, EXPAND, 0);
        }
        addStretchSpacer(szHyperlinkLong);

        // the panes compose the window
        addSizer(sizerTop, sizerLeft.sizer, 0, ALL & ~LEFT, doubleBorder());
        addSizer(sizerTop, szHyperlinkLong, 1, EXPAND | (ALL & ~RIGHT),
            doubleBorder());

        // final initializations
        this.reset();

        this.page.SetSizer(sizerTop.ptr, false);

        bindEvent(this.page, HYPERLINK_PAGE_RESET, HYPERLINK_PAGE_RESET,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.reset();
                this.createHyperlink();
            });

        bindEvent(this.page, HYPERLINK_PAGE_SET_LABEL, HYPERLINK_PAGE_SET_LABEL,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onButtonSetLabel();
            });

        bindEvent(this.page, HYPERLINK_PAGE_SET_URL, HYPERLINK_PAGE_SET_URL,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onButtonSetURL();
            });

        bindEvent(this.page, ID_ANY, ID_ANY, EVT_RADIOBOX, (eventPtr) =>
        {
            if (!eventPtr) return;
            this.onAlignment();
        });

        bindEvent(this.page, ID_ANY, ID_ANY, EVT_CHECKBOX, (eventPtr) =>
        {
            if (!eventPtr) return;
            this.onGeneric();
        });
    }

    override recreateWidget(): void
    {
        this.createHyperlink();
    }

    /** Creates one hyperlink control of the currently requested class. */
    private createHyperlinkControl(
        id: number,
        label: string,
        urlAddress: string,
        style: number,
    ): HyperlinkHandle | null
    {
        const generic = this.checkGeneric?.GetValue() === true;

        const created = withStrings([label, urlAddress], (ptrs) =>
            generic
                ? createWxGenericHyperlinkCtrl(
                    this.page.ptr, id, ptrs[0], ptrs[1],
                    -1, -1, -1, -1, style)
                : createWxHyperlinkCtrl(
                    this.page.ptr, id, ptrs[0], ptrs[1],
                    -1, -1, -1, -1, style));

        return created ? { ptr: created.ptr, generic } : null;
    }

    /** The label of a hyperlink control (reached through wxWindow). */
    private hyperlinkLabel(hyperlink: HyperlinkHandle): string
    {
        const value = wrapWxWindow(hyperlink.ptr).GetLabel();
        return value ? readAndDeleteWxString(value.ptr) : "";
    }

    /** wxHyperlinkCtrl::GetURL() / wxGenericHyperlinkCtrl::GetURL(). */
    private hyperlinkUrl(hyperlink: HyperlinkHandle): string
    {
        const value = hyperlink.generic
            ? wrapWxGenericHyperlinkCtrl(hyperlink.ptr).GetURL()
            : wrapWxHyperlinkCtrl(hyperlink.ptr).GetURL();
        return value ? readAndDeleteWxString(value.ptr) : "";
    }

    /** wxHyperlinkCtrl::SetURL() / wxGenericHyperlinkCtrl::SetURL(). */
    private setHyperlinkUrl(hyperlink: HyperlinkHandle, urlAddress: string): void
    {
        withString(urlAddress, (ptr) =>
        {
            if (hyperlink.generic)
            {
                wrapWxGenericHyperlinkCtrl(hyperlink.ptr).SetURL(ptr);
            }
            else
            {
                wrapWxHyperlinkCtrl(hyperlink.ptr).SetURL(ptr);
            }
        });
    }

    /** Reset the control parameters from the current hyperlink. */
    private reset(): void
    {
        if (!this.hyperlink)
        {
            return;
        }

        const label = this.hyperlinkLabel(this.hyperlink);
        if (this.labelText)
        {
            withString(label, (ptr) => this.labelText?.SetValue(ptr));
        }

        const currentUrl = this.hyperlinkUrl(this.hyperlink);
        if (this.urlText)
        {
            withString(currentUrl, (ptr) => this.urlText?.SetValue(ptr));
        }
    }

    /** (Re)create the main hyperlink, keeping label and URL. */
    private createHyperlink(): void
    {
        const oldHyperlink = this.hyperlink;
        if (!oldHyperlink)
        {
            return;
        }

        const label = this.hyperlinkLabel(oldHyperlink);
        const urlAddress = this.hyperlinkUrl(oldHyperlink);

        const style = attrs.defaultFlags | (HL_DEFAULT_STYLE & ~BORDER_MASK);

        const created = this.createHyperlinkControl(
            HYPERLINK_PAGE_CTRL, label, urlAddress, style);
        if (!created)
        {
            return;
        }

        // update the sizer's child window, then drop the old control
        this.page.GetSizer()?.ReplaceWindow(oldHyperlink.ptr, created.ptr, true);
        wrapWxWindow(oldHyperlink.ptr).Destroy();
        this.hyperlink = created;

        this.notifyWidgetRecreation(wrapWxWindow(created.ptr));

        // relayout the sizer
        this.page.GetSizer()?.Layout();
    }

    /** (Re)create the long hyperlink with the requested alignment. */
    private createHyperlinkLong(align: number): void
    {
        const oldHyperlink = this.hyperlinkLong;
        if (!oldHyperlink)
        {
            return;
        }

        const style = attrs.defaultFlags | align
            | (HL_DEFAULT_STYLE & ~(HL_ALIGN_CENTRE | BORDER_MASK));

        const created = this.createHyperlinkControl(
            ID_ANY, "This is a long hyperlink", "www.wxwidgets.org", style);
        if (!created)
        {
            return;
        }

        // update the sizer's child window, then drop the old control
        this.page.GetSizer()?.ReplaceWindow(oldHyperlink.ptr, created.ptr, true);
        wrapWxWindow(oldHyperlink.ptr).Destroy();
        this.hyperlinkLong = created;

        // relayout the sizer
        this.page.GetSizer()?.Layout();
    }

    /** OnButtonSetLabel(): apply the label typed into the text control. */
    private onButtonSetLabel(): void
    {
        const hyperlink = this.hyperlink;
        const labelText = this.labelText;
        if (!hyperlink || !labelText)
        {
            return;
        }

        const value = labelText.GetValue();
        const labelValue = value ? readAndDeleteWxString(value.ptr) : "";
        withString(labelValue, (ptr) => wrapWxWindow(hyperlink.ptr).SetLabel(ptr));
    }

    /** OnButtonSetURL(): apply the URL typed into the text control. */
    private onButtonSetURL(): void
    {
        if (!this.hyperlink || !this.urlText)
        {
            return;
        }

        const value = this.urlText.GetValue();
        const urlValue = value ? readAndDeleteWxString(value.ptr) : "";
        if (this.hyperlink)
        {
            this.setHyperlinkUrl(this.hyperlink, urlValue);
        }
    }

    /** OnAlignment(): re-create the long hyperlink for the selected alignment. */
    private onAlignment(): void
    {
        const selection = this.alignRadio ? this.alignRadio.GetSelection() : -1;

        let align = HL_ALIGN_LEFT;
        switch (selection)
        {
            case ALIGN_CENTRE_INDEX:
                align = HL_ALIGN_CENTRE;
                break;

            case ALIGN_RIGHT_INDEX:
                align = HL_ALIGN_RIGHT;
                break;

            case ALIGN_LEFT_INDEX:
                align = HL_ALIGN_LEFT;
                break;

            default:
                logMessage("unknown alignment");
                break;
        }

        this.createHyperlinkLong(align);
    }

    /** OnGeneric(): re-create both hyperlinks after the generic toggle. */
    private onGeneric(): void
    {
        this.createHyperlink();
        this.onAlignment();
    }
}

export function createHyperlinkPage(parent: Pointer): WidgetsPage
{
    return new HyperlinkPage(parent);
}
