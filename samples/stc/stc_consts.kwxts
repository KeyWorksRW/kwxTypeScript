export const wxSTC_MARK_EMPTY = 5;
export const wxSTC_MARK_ARROWDOWN = 6;
export const wxSTC_MARK_VLINE = 9;
export const wxSTC_MARK_LCORNER = 10;
export const wxSTC_MARK_TCORNER = 11;
export const wxSTC_MARK_BOXPLUS = 12;
export const wxSTC_MARK_BOXPLUSCONNECTED = 13;
export const wxSTC_MARK_BOXMINUS = 14;
export const wxSTC_MARK_BOXMINUSCONNECTED = 15;
export const wxSTC_MARK_DOTDOTDOT = 23;

// stc.h:131-137 — folding marker numbers
