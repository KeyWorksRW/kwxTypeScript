// filectrl.kwxts — port of wxSamples/src/widgets/filectrl.cpp
//
// wxFileCtrl is bound (wxFileCtrl_gen.ts); wxGenericFileCtrl is not, so the
// sample uses the bound wxFileCtrl class for both "family" variants — the
// C++ code only selects the generic class through the IMPLEMENT_WIDGETS_PAGE
// family flags, it never names it explicitly.
//
// The wxFC_* style bits and wxWindowUpdateLocker are used as generated.

import {
    ALIGN_CENTRE_HORIZONTAL,
    ALL,
    createWxArrayString,
    createWxBoxSizer,
    createWxButton,
    createWxFileCtrl,
    createWxRadioBox,
    createWxWindowUpdateLocker,
    EVT_BUTTON,
    EVT_CHECKBOX,
    EVT_FILECTRL_FILEACTIVATED,
    EVT_FILECTRL_FILTERCHANGED,
    EVT_FILECTRL_FOLDERCHANGED,
    EVT_FILECTRL_SELECTIONCHANGED,
    EVT_RADIOBOX,
    EXPAND,
    FC_DEFAULT_STYLE,
    FC_MULTIPLE,
    FC_NOSHOWHIDDEN,
    FC_OPEN,
    FC_SAVE,
    FileSelectorDefaultWildcardStr,
    HORIZONTAL,
    ID_ANY,
    ID_HIGHEST,
    LEFT,
    readAndDeleteWxString,
    readWxString,
    RA_SPECIFY_COLS,
    RIGHT,
    VERTICAL,
    wxCheckBox,
    wxFileCtrl,
    wxFileCtrlEvent,
    wxRadioBox,
    wxSizer,
    wxTextCtrl,
    wxWindow,
    wxJoin,
} from "kwx";
import { pointerOf, Pointer } from "kwx/platform";

import {
    addSizer,
    addWin,
    attrs,
    bindEvent,
    border,
    doubleBorder,
    logMessage,
    makeStaticBoxSizer,
    tripleBorder,
    WidgetsPage,
    withString,
} from "./common.kwxts";

const FILECTRL_PAGE_RESET = ID_HIGHEST;
const FILECTRL_PAGE_SET_DIRECTORY = FILECTRL_PAGE_RESET + 1;
const FILECTRL_PAGE_SET_PATH = FILECTRL_PAGE_SET_DIRECTORY + 1;
const FILECTRL_PAGE_SET_FILENAME = FILECTRL_PAGE_SET_PATH + 1;
const FILECTRL_PAGE_CTRL = FILECTRL_PAGE_SET_FILENAME + 1;

const FILECTRL_MODE_OPEN = 0;
const FILECTRL_MODE_SAVE = 1;

/** wxString m_textCtrl->GetValue() */
function readTextValue(control: wxTextCtrl | null): string
{
    const value = control?.GetValue();
    return value ? readAndDeleteWxString(value.ptr) : "";
}

/**
 * Builds the wxRadioBox choice array.  Values stay referenced until the native
 * constructor has copied them.
 */
function createModeRadioBox(parent: Pointer, caption: string, items: string[]): wxRadioBox | null
{
    const buffers: Uint8Array[] = [];
    const pointers = new BigUint64Array(items.length);

    for (let index = 0; index < items.length; index++)
    {
        const bytes = new TextEncoder().encode(items[index] + "\0");
        buffers.push(bytes);
        const address = pointerOf(bytes);
        pointers[index] = address === null ? 0n : address;
    }

    const choices = items.length > 0 ? pointerOf(pointers) : null;

    const radioBox = withString(caption, (ptr) =>
        createWxRadioBox(parent, ID_ANY, ptr, -1, -1, -1, -1,
            items.length, choices, 0, RA_SPECIFY_COLS));

    void buffers;
    return radioBox;
}

export class FileCtrlPage extends WidgetsPage
{
    private fileCtrl: wxFileCtrl | null = null;

    private dirText: wxTextCtrl | null = null;
    private pathText: wxTextCtrl | null = null;
    private filenameText: wxTextCtrl | null = null;

    private chkMultiple: wxCheckBox | null = null;
    private chkNoShowHidden: wxCheckBox | null = null;

    private radioFileCtrlMode: wxRadioBox | null = null;

    private filters: wxCheckBox[] = [];
    private sizerTop: wxSizer | null = null;

    constructor(parent: Pointer)
    {
        super(parent, "icons/dirctrl");
    }

    override getWidget(): wxWindow | null
    {
        return this.fileCtrl;
    }

    override createContent(): void
    {
        const sizerTop = createWxBoxSizer(HORIZONTAL)!;
        this.sizerTop = sizerTop;

        // left pane
        const sizerLeft = createWxBoxSizer(VERTICAL)!;

        this.radioFileCtrlMode = createModeRadioBox(
            this.page.ptr, "wxFileCtrl mode", ["open", "save"]);
        if (this.radioFileCtrlMode)
        {
            addWin(sizerLeft, this.radioFileCtrlMode, 0, EXPAND, border());
        }

        addSizer(sizerLeft, this.createSizerWithTextAndButton(
            FILECTRL_PAGE_SET_DIRECTORY, "Set &directory", ID_ANY,
            (text) => { this.dirText = text; },
        ), 0, EXPAND, border());

        addSizer(sizerLeft, this.createSizerWithTextAndButton(
            FILECTRL_PAGE_SET_PATH, "Set &path", ID_ANY,
            (text) => { this.pathText = text; },
        ), 0, EXPAND, border());

        addSizer(sizerLeft, this.createSizerWithTextAndButton(
            FILECTRL_PAGE_SET_FILENAME, "Set &filename", ID_ANY,
            (text) => { this.filenameText = text; },
        ), 0, EXPAND, border());

        const sizerFlags = makeStaticBoxSizer(this.page.ptr, VERTICAL, "&Flags");
        this.chkMultiple = this.createCheckBoxAndAddToSizer(
            sizerFlags.sizer, "wxFC_MULTIPLE", ID_ANY, sizerFlags.box.ptr);
        this.chkNoShowHidden = this.createCheckBoxAndAddToSizer(
            sizerFlags.sizer, "wxFC_NOSHOWHIDDEN", ID_ANY, sizerFlags.box.ptr);
        addSizer(sizerLeft, sizerFlags.sizer, 0, EXPAND, border());

        const sizerFilters = makeStaticBoxSizer(this.page.ptr, VERTICAL, "&Filters");

        // wxString::Format("all files (%s)|%s", wxFileSelectorDefaultWildcardStr, ...)
        const defaultWildcard = readWxString(FileSelectorDefaultWildcardStr);
        this.filters = [
            this.createCheckBoxAndAddToSizer(
                sizerFilters.sizer,
                `all files (${defaultWildcard})|${defaultWildcard}`,
                ID_ANY, sizerFilters.box.ptr),
            this.createCheckBoxAndAddToSizer(
                sizerFilters.sizer, "C++ files (*.cpp; *.h)|*.cpp;*.h",
                ID_ANY, sizerFilters.box.ptr),
            this.createCheckBoxAndAddToSizer(
                sizerFilters.sizer, "PNG images (*.png)|*.png",
                ID_ANY, sizerFilters.box.ptr),
        ];
        addSizer(sizerLeft, sizerFilters.sizer, 0, EXPAND, border());

        const resetButton = withString("&Reset", (ptr) =>
            createWxButton(this.page.ptr, FILECTRL_PAGE_RESET, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(sizerLeft, resetButton, 0, ALIGN_CENTRE_HORIZONTAL, tripleBorder());

        // right pane: the wxFileCtrl is created once here and replaced by
        // createFileCtrl() afterwards.
        this.fileCtrl = withString("", (directory) =>
            withString("", (fileName) =>
                withString("", (wildcard) => createWxFileCtrl(
                    this.page.ptr, FILECTRL_PAGE_CTRL,
                    directory, fileName, wildcard,
                    -1, -1, -1, -1, FC_OPEN))));

        // DoubleBorder(ALL & ~LEFT) / DoubleBorder(ALL & ~RIGHT)
        addSizer(sizerTop, sizerLeft, 0, EXPAND | (ALL & ~LEFT), doubleBorder());
        if (this.fileCtrl)
        {
            addWin(sizerTop, this.fileCtrl, 1, EXPAND | (ALL & ~RIGHT), doubleBorder());
        }

        // final initializations
        this.reset();

        this.page.SetSizer(sizerTop.ptr, false);

        bindEvent(this.page, FILECTRL_PAGE_RESET, FILECTRL_PAGE_RESET,
            EVT_BUTTON, () =>
            {
                this.reset();
                this.createFileCtrl();
            });

        bindEvent(this.page, FILECTRL_PAGE_SET_DIRECTORY,
            FILECTRL_PAGE_SET_DIRECTORY, EVT_BUTTON, () =>
            {
                const directory = readTextValue(this.dirText);
                withString(directory,
                    (ptr) => this.fileCtrl?.SetDirectory(ptr));
            });

        bindEvent(this.page, FILECTRL_PAGE_SET_PATH, FILECTRL_PAGE_SET_PATH,
            EVT_BUTTON, () =>
            {
                const value = readTextValue(this.pathText);
                withString(value, (ptr) => this.fileCtrl?.SetPath(ptr));
            });

        bindEvent(this.page, FILECTRL_PAGE_SET_FILENAME,
            FILECTRL_PAGE_SET_FILENAME, EVT_BUTTON, () =>
            {
                const value = readTextValue(this.filenameText);
                withString(value, (ptr) => this.fileCtrl?.SetFilename(ptr));
            });

        bindEvent(this.page, ID_ANY, ID_ANY, EVT_CHECKBOX, (eventPtr) =>
        {
            if (!eventPtr) return;
            this.createFileCtrl();
        });

        bindEvent(this.page, ID_ANY, ID_ANY, EVT_RADIOBOX, (eventPtr) =>
        {
            if (!eventPtr) return;
            this.createFileCtrl();
        });

        for (const eventType of [EVT_FILECTRL_FILTERCHANGED,
            EVT_FILECTRL_FOLDERCHANGED, EVT_FILECTRL_SELECTIONCHANGED,
            EVT_FILECTRL_FILEACTIVATED])
        {
            bindEvent(this.page, ID_ANY, ID_ANY, eventType,
                (eventPtr) => this.onFileCtrl(eventPtr));
        }
    }

    override recreateWidget(): void
    {
        this.createFileCtrl();
    }

    /** FileCtrlWidgetsPage::Reset() */
    private reset(): void
    {
        if (this.dirText && this.fileCtrl)
        {
            const directory = this.fileCtrl.GetDirectory();
            if (directory)
            {
                withString(readAndDeleteWxString(directory.ptr),
                    (ptr) => this.dirText?.SetValue(ptr));
            }
        }

        this.radioFileCtrlMode?.SetSelection(
            (FC_DEFAULT_STYLE & FC_OPEN) !== 0
                ? FILECTRL_MODE_OPEN
                : FILECTRL_MODE_SAVE);
    }

    /** FileCtrlWidgetsPage::CreateFileCtrl() */
    private createFileCtrl(): void
    {
        const sizerTop = this.sizerTop;
        if (!sizerTop)
        {
            return;
        }

        // wxWindowUpdateLocker lock(this)
        const updateLocker = createWxWindowUpdateLocker(this.page.ptr);

        let style = attrs.defaultFlags;

        const openMode = this.radioFileCtrlMode?.GetSelection() === FILECTRL_MODE_OPEN;
        if (openMode)
        {
            style |= FC_OPEN;
            this.chkMultiple?.Enable(true);
            if (this.chkMultiple?.GetValue())
            {
                style |= FC_MULTIPLE;
            }
        }
        else
        {
            style |= FC_SAVE;
            // wxFC_SAVE is incompatible with wxFC_MULTIPLE
            this.chkMultiple?.SetValue(false);
            this.chkMultiple?.Enable(false);
        }

        if (this.chkNoShowHidden?.GetValue())
        {
            style |= FC_NOSHOWHIDDEN;
        }

        const newCtrl = withString("", (directory) =>
            withString("", (fileName) =>
                withString("", (wildcard) => createWxFileCtrl(
                    this.page.ptr, FILECTRL_PAGE_CTRL,
                    directory, fileName, wildcard,
                    -1, -1, -1, -1, style))));

        // wildcard = the checked filter labels joined by '|'
        const labels: string[] = [];
        for (const filter of this.filters)
        {
            if (!filter.GetValue())
            {
                continue;
            }
            const label = filter.GetLabel();
            if (label)
            {
                labels.push(readAndDeleteWxString(label.ptr));
            }
        }
        withString(labels.join("|"),
            (ptr) => newCtrl?.SetWildcard(ptr));

        // GetSizer()->Replace(m_fileCtrl, fileCtrl, true)
        if (this.fileCtrl && newCtrl)
        {
            sizerTop.ReplaceWindow(this.fileCtrl.ptr, newCtrl.ptr, true);
        }

        if (this.fileCtrl)
        {
            this.fileCtrl.Destroy();
            this.fileCtrl = null;
        }
        this.fileCtrl = newCtrl;

        if (this.fileCtrl)
        {
            this.notifyWidgetRecreation(this.fileCtrl);
        }

        sizerTop.Layout();
        updateLocker?.Delete();
    }

    /** FileCtrlWidgetsPage::OnFileCtrl() */
    private onFileCtrl(eventPtr: Pointer | null): void
    {
        if (!eventPtr) return;
        const event = new wxFileCtrlEvent(eventPtr, true);
        const eventType = event.GetEventType();

        if (eventType === EVT_FILECTRL_FOLDERCHANGED)
        {
            const directory = event.GetDirectory();
            logMessage("Folder changed event, new folder: "
                + `${directory ? readAndDeleteWxString(directory.ptr) : ""}`);
        }
        else if (eventType === EVT_FILECTRL_FILEACTIVATED)
        {
            logMessage(`File activated event: ${joinedFiles(event)}`);
        }
        else if (eventType === EVT_FILECTRL_SELECTIONCHANGED)
        {
            logMessage(`Selection changed event: ${joinedFiles(event)}`);
        }
        else if (eventType === EVT_FILECTRL_FILTERCHANGED)
        {
            logMessage("Filter changed event: filter "
                + `${event.GetFilterIndex() + 1} selected`);
        }
    }
}

/** wxJoin(event.GetFiles(), ' ') */
function joinedFiles(event: wxFileCtrlEvent): string
{
    const files = createWxArrayString();
    if (!files)
    {
        return "";
    }

    event.GetFiles(files.ptr);
    const joined = wxJoin(files.ptr, " ".charCodeAt(0));
    files.Delete();

    return joined ? readAndDeleteWxString(joined) : "";
}

export function createFileCtrlPage(parent: Pointer): WidgetsPage
{
    return new FileCtrlPage(parent);
}
