    variantArrayString,
    variantBool,
    variantString,
    walkAll,
    withString,
    withStrings,
} from "./support.kwxts";

//-----------------------------------------------------------------------------
// Property factories
//-----------------------------------------------------------------------------

function append(page: wxPropertyGridPage, prop: wxPGProperty | null): wxPGProperty | null
{
    if (!prop) return null;
    return page.Append(prop.ptr);
}

function makeCategory(label: string): wxPGProperty | null
{
    return withString(label, (text) => createWxPropertyCategory(text));
}

function makeString(label: string, value: string): wxPGProperty | null
{
    return withStrings([label, value], (ptrs) =>
        createWxStringProperty(ptrs[0], PG_LABEL, ptrs[1]));
}

function makeStringNamed(label: string, name: string, value: string): wxPGProperty | null
{
    return withStrings([label, name, value], (ptrs) =>
        createWxStringProperty(ptrs[0], ptrs[1], ptrs[2]));
}

function makeStringValueOnly(label: string, value: Pointer): wxPGProperty | null
{
    return withString(label, (text) => createWxStringProperty(text, PG_LABEL, value));
}

function makeInt(label: string, value: number): wxPGProperty | null
{
    return withString(label, (text) => createWxIntProperty(text, PG_LABEL, value));
}

function makeBool(label: string, value: boolean): wxPGProperty | null
{
    return withString(label, (text) => createWxBoolProperty(text, PG_LABEL, value));
}

function makeFloat(label: string, value: number): wxPGProperty | null
{
    return withString(label, (text) => createWxFloatProperty(text, PG_LABEL, value));
}

function makeUInt(label: string, value: bigint): wxPGProperty | null
{
    return withString(label, (text) => createWxUIntProperty(text, PG_LABEL, value));
}

function makeLongString(label: string, value: string): wxPGProperty | null
{
    return withStrings([label, value], (ptrs) =>
        createWxLongStringProperty(ptrs[0], PG_LABEL, ptrs[1]));
}

function makeArrayString(label: string, value: string[]): wxPGProperty | null
{
    const array = charPtrArray(value);
    return withString(label, (text) =>
        createWxArrayStringProperty(text, PG_LABEL, value.length, array.ptr));
}

function makeFile(label: string, value: string): wxPGProperty | null
{
    return withStrings([label, value], (ptrs) =>
        createWxFileProperty(ptrs[0], PG_LABEL, ptrs[1]));
}

function makeDir(label: string, value: string): wxPGProperty | null
{
    return withStrings([label, value], (ptrs) =>
        createWxDirProperty(ptrs[0], PG_LABEL, ptrs[1]));
}

function makeImageFile(label: string): wxPGProperty | null
{
    return withStrings([label, ""], (ptrs) =>
        createWxImageFileProperty(ptrs[0], PG_LABEL, ptrs[1]));
}

function makeColour(label: string, colour: Pointer): wxPGProperty | null
{
    let owned: wxColour | null = null;
    let value = colour;
    if (!value)
    {
        owned = createWxColourRGB(255, 255, 255, 255);
        value = owned ? owned.ptr : null;
    }
    if (!value)
    {
        if (owned) owned.Delete();
        return null;
    }
    try
    {
        return withString(label, (text) => createWxColourProperty(text, PG_LABEL, value));
    }
    finally
    {
        if (owned) owned.Delete();
    }
}

function makeFont(label: string): wxPGProperty | null
{
    const font = createWxFontDefault();
    if (!font) return null;
    try
    {
        return withString(label, (text) => createWxFontProperty(text, PG_LABEL, font.ptr));
    }
    finally
    {
        font.Delete();
    }
}

function makeDate(label: string): wxPGProperty | null
{
    const date = createWxDateTime();
    if (!date) return null;
    try
    {
        date.Now();
        return withString(label, (text) => createWxDateProperty(text, PG_LABEL, date.ptr));
    }
    finally
    {
        date.Delete();
    }
}

function makeEnum(
    label: string, labels: string[], values: number[], value: number,
    name: string | null = null,
): wxPGProperty | null
{
    const labelArray = charPtrArray(labels);
    const valueArray = intArray(values);
    if (name !== null)
    {
        return withStrings([label, name], (ptrs) =>
            createWxEnumProperty(ptrs[0], ptrs[1], labels.length, labelArray.ptr,
                values.length, valueArray.ptr, value));
    }
    return withString(label, (text) =>
        createWxEnumProperty(text, PG_LABEL, labels.length, labelArray.ptr,
            values.length, valueArray.ptr, value));
}

function makeFlags(
    label: string, labels: string[], values: number[], value: number,
): wxPGProperty | null
{
    const labelArray = charPtrArray(labels);
    const valueArray = intArray(values);
    return withString(label, (text) =>
        createWxFlagsProperty(text, PG_LABEL, labels.length, labelArray.ptr,
            values.length, valueArray.ptr, value));
}

function makeEditEnum(
    label: string, labels: string[], values: number[], value: string,
): wxPGProperty | null
{
    const labelArray = charPtrArray(labels);
    const valueArray = intArray(values);
    return withStrings([label, value], (ptrs) =>
        createWxEditEnumProperty(ptrs[0], PG_LABEL, labels.length, labelArray.ptr,
            values.length, valueArray.ptr, ptrs[1]));
}

function makeMultiChoice(label: string, choices: string[]): wxPGProperty | null
{
    const array = charPtrArray(choices);
    return withString(label, (text) =>
        createWxMultiChoiceProperty(text, PG_LABEL, choices.length, array.ptr));
}

function setHelp(page: wxPropertyGridPage, prop: wxPGProperty | null, text: string): void
{
    if (!prop) return;
    withString(text, (ptr) => page.SetPropertyHelpString(prop.ptr, ptr));
}

// wxPropertyGridInterface binds DisableProperty against wxPGProperty*, not a
// property name, so the caller passes the property it just appended.
function disable(page: wxPropertyGridPage, prop: wxPGProperty | null): void
{
    if (!prop) return;
    page.DisableProperty(prop.ptr);
}

function userHome(): string
{
    return withString("", (ptr) => takeText(wxGetUserHome(ptr)));
}

