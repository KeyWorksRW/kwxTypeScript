// archive.kwxts — kwxTypeScript port of wxSamples/src/archive/archive.cpp
//
// A command line utility built on the wxWidgets archive and filter streams:
//
//   c <archive> [file...]   create  (zip, tar; or single-file gzip/zlib)
//   l <archive>             list    (zip, tar; or the single-file filter name)
//   x <archive>             extract (zip, tar; or the single-file filter name)
//
//   --force-zip64           force ZIP64 when creating zip archives
//   -h, --help              show the usage text
//   --verbose               enable verbose wxWidgets logging
//
// Run from the repository root:
//   bin\Release\kwxts.exe samples\archive\archive.kwxts <command> <archive_name> [file_names...]
//
// The C++ original is a wxAppConsole; here wxWidgets is initialised and shut
// down around one synchronous command, with no event loop.
//
// Substitutions / known gaps (listed again in the conversion report):
//  * wxPATH_NATIVE is not exported by the binding constant table (its value is
//    0 in <wx/filename.h>); PATH_NATIVE below mirrors that enum value.
//  * wxCmdLineParser::Usage()/GetUsageString() are not bound, and the parser's
//    built-in error and usage output is written through wxMessageOutput. The
//    host application is a GUI wxApp, so wxGUIAppTraits cannot attach to the
//    console the kwxts executable already owns and wxMessageOutputBest falls
//    back to a modal message box. wxCmdLineParser is therefore not driven here;
//    the same descriptor (3 parameters, --force-zip64, plus the standard
//    -h/--help and --verbose switches) is parsed directly and the usage block
//    is reproduced with wxCmdLineParser's own layout rules.
//  * For the same reason normal output uses console.log (stdout) and
//    diagnostics use console.error (stderr) instead of wxPrintf/wxLogError.

import {
    createWxDateTime,
    createWxFileInputStream,
    createWxFileNameFromPath,
    createWxLogStderr,
    createWxString,
    createWxTempFileOutputStream,
    initialize,
    lib,
    PATH_GET_VOLUME,
    PATH_MKDIR_FULL,
    readAndDeleteWxString,
    S_DIR_DEFAULT,
    setAppName,
    shutdown,
    STREAM_FILEEXT,
    STREAM_PROTOCOL,
    wrapWxArchiveClassFactory,
    wrapWxFilterClassFactory,
    wrapWxZipOutputStream,
    wxArchiveClassFactory,
    wxArchiveClassFactory_Find,
    wxArchiveClassFactory_GetFirst,
    wxArchiveEntry,
    wxArchiveInputStream,
    wxArchiveOutputStream,
    wxFileName_MakeSafeRelativePath,
    wxFileName_MkdirForPath,
    wxFilterClassFactory,
    wxFilterClassFactory_Find,
    wxFilterClassFactory_GetFirst,
    wxFilterInputStream,
    wxFilterOutputStream,
    wxInputStream,
    wxLog_SetActiveTarget,
    wxLogStderr,
    wxOutputStream,
    wxString,
    wxTempFileOutputStream,
    ZIP_FORMAT_ZIP64,
} from "kwx";
import { args, exit, platform, pointerOf, Pointer } from "kwx/platform";

/** wxPathFormat::wxPATH_NATIVE — not exported by the binding constants. */
const PATH_NATIVE = 0;

/** ArchiveApp::ArchiveCommandType */
const CMD_CREATE = 0;
const CMD_LIST = 1;
const CMD_EXTRACT = 2;
const CMD_NONE = 3;

/** ArchiveApp::ArchiveCommandDesc / s_cmdDesc */
interface ArchiveCommandDesc
{
    readonly type: number;
    readonly id: string;
    readonly desc: string;
}

const S_CMD_DESC: readonly ArchiveCommandDesc[] =
[
    { type: CMD_CREATE, id: "c", desc: "create" },
    { type: CMD_LIST, id: "l", desc: "list" },
    { type: CMD_EXTRACT, id: "x", desc: "extract" },
];

/** ArchiveApp state (m_command, m_archiveFileName, m_fileNames, ...). */
interface ArchiveState
{
    readonly command: number;
    readonly archiveFileName: string;
    readonly fileNames: readonly string[];
    readonly forceZip64: boolean;
    archiveClassFactory: wxArchiveClassFactory | null;
    filterClassFactory: wxFilterClassFactory | null;
}

// ---------------------------------------------------------------------------
// Temporary wxString helpers
// ---------------------------------------------------------------------------

/** Call fn with a temporary wxString and release it on every path. */
function withString<T>(text: string, fn: (ptr: Pointer) => T): T
{
    const value = createWxString(text);
    try
    {
        return fn(value.ptr);
    }
    finally
    {
        value.Delete();
    }
}

/**
 * Consume a wxString* returned by a generated getter. Such values are allocated
 * by kwxFFI for the caller but wrapped as borrowed, so they are released as
 * pointers rather than through the wrapper.
 */
function readOwnedString(value: wxString | null): string
{
    return value ? readAndDeleteWxString(value.ptr) : "";
}

// ---------------------------------------------------------------------------
// wxFileName helpers (C++ constructs wxFileName objects inline)
// ---------------------------------------------------------------------------

/** wxFileName(path).GetFullName() */
function fileNameFullName(path: string): string
{
    return withString(path, (ptr) =>
    {
        const fileName = createWxFileNameFromPath(ptr, PATH_NATIVE);
        if (!fileName)
        {
            return "";
        }
        try
        {
            return readOwnedString(fileName.GetFullName());
        }
        finally
        {
            fileName.Delete();
        }
    });
}

/** wxFileName(path).GetName() */
function fileNameName(path: string): string
{
    return withString(path, (ptr) =>
    {
        const fileName = createWxFileNameFromPath(ptr, PATH_NATIVE);
        if (!fileName)
        {
            return "";
        }
        try
        {
            return readOwnedString(fileName.GetName());
        }
        finally
        {
            fileName.Delete();
        }
    });
}

/** wxFileName(path).GetPath() — default flags are wxPATH_GET_VOLUME. */
function fileNamePathOf(path: string): string
{
    return withString(path, (ptr) =>
    {
        const fileName = createWxFileNameFromPath(ptr, PATH_NATIVE);
        if (!fileName)
        {
            return "";
        }
        try
        {
            return readOwnedString(fileName.GetPath(PATH_GET_VOLUME, PATH_NATIVE));
        }
        finally
        {
            fileName.Delete();
        }
    });
}

// ---------------------------------------------------------------------------
// Factory helpers
// ---------------------------------------------------------------------------

/** Append a factory's comma-joined protocol list, matching AppendAllSupportedOfType. */
function appendJoined(all: string, joined: string): string
{
    if (joined.length === 0)
    {
        return all;
    }
    return all.length === 0 ? joined : all + ", " + joined;
}

/** GetAllSupported(type) — archive factories first, then filter factories. */
function getAllSupported(type: number): string
{
    let all = "";

    let archivePtr = wxArchiveClassFactory_GetFirst();
    while (archivePtr)
    {
        const factory = wrapWxArchiveClassFactory(archivePtr);
        all = appendJoined(all, readOwnedString(factory.GetProtocols(type)));
        archivePtr = factory.GetNext()?.ptr ?? null;
    }

    let filterPtr = wxFilterClassFactory_GetFirst();
    while (filterPtr)
    {
        const factory = wrapWxFilterClassFactory(filterPtr);
        all = appendJoined(all, readOwnedString(factory.GetProtocols(type)));
        filterPtr = factory.GetNext()?.ptr ?? null;
    }

    return all;
}

/** wxArchiveClassFactory::Find(name, wxSTREAM_FILEEXT) */
function findArchiveClassFactory(name: string): wxArchiveClassFactory | null
{
    return withString(name, (ptr) =>
    {
        const found = wxArchiveClassFactory_Find(ptr, STREAM_FILEEXT);
        return found ? wrapWxArchiveClassFactory(found) : null;
    });
}

/** wxFilterClassFactory::Find(name, wxSTREAM_FILEEXT) */
function findFilterClassFactory(name: string): wxFilterClassFactory | null
{
    return withString(name, (ptr) =>
    {
        const found = wxFilterClassFactory_Find(ptr, STREAM_FILEEXT);
        return found ? wrapWxFilterClassFactory(found) : null;
    });
}

// Class-factory streams hand over ownership, but the generated wrappers mark
// them borrowed, so the native objects are released through their delete
// symbols (the C++ sample holds them in std::unique_ptr).

function deleteArchiveInputStream(stream: wxArchiveInputStream): void
{
    lib.symbols.wxArchiveInputStream_Delete(stream.ptr);
}

function deleteArchiveOutputStream(stream: wxArchiveOutputStream): void
{
    lib.symbols.wxArchiveOutputStream_Delete(stream.ptr);
}

function deleteFilterInputStream(stream: wxFilterInputStream): void
{
    lib.symbols.wxFilterInputStream_Delete(stream.ptr);
}

function deleteFilterOutputStream(stream: wxFilterOutputStream): void
{
    lib.symbols.wxFilterOutputStream_Delete(stream.ptr);
}

function deleteArchiveEntry(entry: wxArchiveEntry): void
{
    lib.symbols.wxArchiveEntry_Delete(entry.ptr);
}

// ---------------------------------------------------------------------------
// Stream copying
// ---------------------------------------------------------------------------

const COPY_BUFFER_SIZE = 128 * 1024;

/** ArchiveApp::CopyStreamData */
function copyStreamData(input: wxInputStream, output: wxOutputStream, size: number): boolean
{
    const buffer = new Uint8Array(COPY_BUFFER_SIZE);
    const bufferPtr = pointerOf(buffer);

    let readSize = COPY_BUFFER_SIZE;
    let copiedData = 0;

    for (;;)
    {
        if (size !== -1 && copiedData + readSize > size)
        {
            readSize = size - copiedData;
        }

        input.Read(bufferPtr, readSize);

        const actuallyRead = input.LastRead();
        output.Write(bufferPtr, actuallyRead);
        if (output.LastWrite() !== actuallyRead)
        {
            console.error("Failed to output data");
            return false;
        }

        if (size === -1)
        {
            if (input.Eof())
            {
                break;
            }
        }
        else
        {
            copiedData += actuallyRead;
            if (copiedData >= size)
            {
                break;
            }
        }
    }

    return true;
}

// ---------------------------------------------------------------------------
// ArchiveApp::DoCreate
// ---------------------------------------------------------------------------

function doCreate(state: ArchiveState): number
{
    if (state.fileNames.length === 0)
    {
        console.error("Need at least one file to add to archive");
        return -1;
    }

    return withString(state.archiveFileName, (archiveNamePtr) =>
    {
        const fileOutputStream = createWxTempFileOutputStream(archiveNamePtr);
        if (!fileOutputStream)
        {
            return 1;
        }

        try
        {
            const archiveFactory = state.archiveClassFactory;
            if (archiveFactory)
            {
                const archiveStream = archiveFactory.NewStreamOutput(fileOutputStream.ptr);
                if (!archiveStream)
                {
                    return 1;
                }

                try
                {
                    // The original reinterpret_casts to wxZipOutputStream when the
                    // factory is the zip one.
                    const protocol = readOwnedString(archiveFactory.GetProtocol());
                    if (protocol.toLowerCase() === "zip" && state.forceZip64)
                    {
                        wrapWxZipOutputStream(archiveStream.ptr).SetFormat(ZIP_FORMAT_ZIP64);
                    }

                    for (const sourceName of state.fileNames)
                    {
                        const fullName = fileNameFullName(sourceName);
                        console.log("Adding " + fullName + "...");

                        const inputStream = withString(sourceName, (ptr) => createWxFileInputStream(ptr));
                        if (!inputStream)
                        {
                            return 1;
                        }

                        try
                        {
                            if (!inputStream.IsOk())
                            {
                                console.error("Could not open file");
                                return 1;
                            }

                            const length = inputStream.GetLength();
                            // wxDateTime::Now()
                            const dateTime = createWxDateTime();
                            if (!dateTime)
                            {
                                return 1;
                            }
                            dateTime.SetToCurrent();

                            let entryStarted = false;
                            try
                            {
                                entryStarted = withString(fullName, (namePtr) =>
                                    archiveStream.PutNextEntryDate(namePtr, dateTime.ptr, length));
                            }
                            finally
                            {
                                dateTime.Delete();
                            }

                            if (!entryStarted)
                            {
                                break;
                            }

                            if (!copyStreamData(inputStream, archiveStream, length))
                            {
                                return 1;
                            }
                        }
                        finally
                        {
                            inputStream.Delete();
                        }
                    }

                    if (!archiveStream.Close())
                    {
                        return 1;
                    }
                }
                finally
                {
                    deleteArchiveOutputStream(archiveStream);
                }
            }
            else
            {
                const filterFactory = state.filterClassFactory;
                if (!filterFactory)
                {
                    return 1;
                }

                if (state.fileNames.length !== 1)
                {
                    console.error(
                        "Filter-based formats only support archives consisting of a single file");
                    return -1;
                }

                const filterStream = filterFactory.NewStreamOutput(fileOutputStream.ptr);
                if (!filterStream)
                {
                    return 1;
                }

                try
                {
                    const inputStream = withString(state.fileNames[0], (ptr) => createWxFileInputStream(ptr));
                    if (!inputStream)
                    {
                        return 1;
                    }

                    try
                    {
                        if (!inputStream.IsOk())
                        {
                            console.error("Could not open file");
                            return 1;
                        }

                        if (!copyStreamData(inputStream, filterStream, inputStream.GetLength()))
                        {
                            return 1;
                        }
                    }
                    finally
                    {
                        inputStream.Delete();
                    }
                }
                finally
                {
                    // The filter stream's destructor flushes the trailer.
                    deleteFilterOutputStream(filterStream);
                }
            }

            fileOutputStream.Commit();
            console.log("Created archive");
            return 0;
        }
        finally
        {
            fileOutputStream.Delete();
        }
    });
}

// ---------------------------------------------------------------------------
// ArchiveApp::DoList
// ---------------------------------------------------------------------------

/** "%10lld" for a wxFileOffset printed through the FFI as a number. */
function paddedSize(value: number): string
{
    return String(value).padStart(10, " ");
}

function doList(state: ArchiveState): number
{
    return withString(state.archiveFileName, (archiveNamePtr) =>
    {
        const inputStream = createWxFileInputStream(archiveNamePtr);
        if (!inputStream)
        {
            return 1;
        }

        try
        {
            if (!inputStream.IsOk())
            {
                return 1;
            }

            const archiveFactory = state.archiveClassFactory;
            if (archiveFactory)
            {
                const archiveStream = archiveFactory.NewStreamInput(inputStream.ptr);
                if (!archiveStream)
                {
                    return 1;
                }

                try
                {
                    console.log("Archive: " + state.archiveFileName);
                    console.log("Length     Date       Time     Name");
                    console.log("---------- ---------- -------- ----");

                    let combinedSize = 0;
                    let entryCount = 0;

                    for (;;)
                    {
                        const entry = archiveStream.GetNextEntry();
                        if (!entry)
                        {
                            break;
                        }

                        try
                        {
                            const size = entry.GetSize();
                            combinedSize += size;
                            entryCount++;

                            const dateTime = entry.GetDateTime();
                            let isoDate = "";
                            let isoTime = "";
                            if (dateTime)
                            {
                                isoDate = readOwnedString(dateTime.FormatISODate());
                                isoTime = readOwnedString(dateTime.FormatISOTime());
                                lib.symbols.wxDateTime_Delete(dateTime.ptr);
                            }

                            const entryName = readOwnedString(entry.GetName(PATH_NATIVE));

                            console.log(
                                paddedSize(size) + " " + isoDate + " " + isoTime + " " + entryName);
                        }
                        finally
                        {
                            deleteArchiveEntry(entry);
                        }
                    }

                    // "----------                     -------" and
                    // "%10lld                     %d files": the total starts in
                    // the Name column (offset 31), i.e. 21 spaces after the width-10
                    // length field.
                    console.log("----------" + " ".repeat(21) + "-------");
                    console.log(paddedSize(combinedSize) + " ".repeat(21) +
                                entryCount + " files");
                }
                finally
                {
                    deleteArchiveInputStream(archiveStream);
                }

                return 0;
            }

            console.log("Archive \"" + state.archiveFileName + "\" contains a single file named \"" +
                        fileNameName(state.archiveFileName) + "\"");
            return 0;
        }
        finally
        {
            inputStream.Delete();
        }
    });
}

// ---------------------------------------------------------------------------
// ArchiveApp::DoExtract
// ---------------------------------------------------------------------------

function doExtract(state: ArchiveState): number
{
    return withString(state.archiveFileName, (archiveNamePtr) =>
    {
        const inputStream = createWxFileInputStream(archiveNamePtr);
        if (!inputStream)
        {
            return 1;
        }

        try
        {
            if (!inputStream.IsOk())
            {
                return 1;
            }

            const archiveFactory = state.archiveClassFactory;
            if (archiveFactory)
            {
                const archiveStream = archiveFactory.NewStreamInput(inputStream.ptr);
                if (!archiveStream)
                {
                    return 1;
                }

                try
                {
                    console.log("Extracting from: " + state.archiveFileName);

                    for (;;)
                    {
                        const entry = archiveStream.GetNextEntry();
                        if (!entry)
                        {
                            break;
                        }

                        try
                        {
                            const entryName = readOwnedString(entry.GetName(PATH_NATIVE));

                            // Never use the entry name as path directly, as it comes
                            // from the archive and could refer to a file outside the
                            // current directory.
                            const path = withString(entryName, (ptr) =>
                                readAndDeleteWxString(
                                    wxFileName_MakeSafeRelativePath(ptr, PATH_NATIVE)));
                            if (path.length === 0)
                            {
                                console.error("Skipping entry with unsafe name \"" + entryName + "\".");
                                continue;
                            }

                            if (entry.IsDir())
                            {
                                if (!withString(path, (ptr) =>
                                    wxFileName_MkdirForPath(ptr, S_DIR_DEFAULT, PATH_MKDIR_FULL)))
                                {
                                    return 1;
                                }
                                continue;
                            }

                            // Archives don't necessarily contain the entries for the
                            // parent directories, so create them if necessary.
                            const dir = fileNamePathOf(path);
                            if (dir.length > 0 &&
                                !withString(dir, (ptr) =>
                                    wxFileName_MkdirForPath(ptr, S_DIR_DEFAULT, PATH_MKDIR_FULL)))
                            {
                                return 1;
                            }

                            console.log("Extracting: " + path + "...");

                            const outputFile = withString(path, (ptr) => createWxTempFileOutputStream(ptr));
                            if (!outputFile)
                            {
                                return 1;
                            }

                            try
                            {
                                if (!copyStreamData(archiveStream, outputFile, entry.GetSize()))
                                {
                                    return 1;
                                }
                                outputFile.Commit();
                            }
                            finally
                            {
                                outputFile.Delete();
                            }
                        }
                        finally
                        {
                            deleteArchiveEntry(entry);
                        }
                    }

                    console.log("Extracted all files");
                }
                finally
                {
                    deleteArchiveInputStream(archiveStream);
                }

                return 0;
            }

            const filterFactory = state.filterClassFactory;
            if (!filterFactory)
            {
                return 1;
            }

            const filterStream = filterFactory.NewStreamInput(inputStream.ptr);
            if (!filterStream)
            {
                return 1;
            }

            try
            {
                console.log("Extracting single file from: " + state.archiveFileName);

                const outputName = fileNameName(state.archiveFileName);
                const outputFile = withString(outputName, (ptr) => createWxTempFileOutputStream(ptr));
                if (!outputFile)
                {
                    return 1;
                }

                try
                {
                    if (!copyStreamData(filterStream, outputFile, -1))
                    {
                        return 1;
                    }
                    outputFile.Commit();
                }
                finally
                {
                    outputFile.Delete();
                }

                console.log("Extracted successfully");
                return 0;
            }
            finally
            {
                deleteFilterInputStream(filterStream);
            }
        }
        finally
        {
            inputStream.Delete();
        }
    });
}

// ---------------------------------------------------------------------------
// ArchiveApp::OnRun
// ---------------------------------------------------------------------------

function runCommand(state: ArchiveState): number
{
    const archiveFactory = findArchiveClassFactory(state.archiveFileName);
    if (archiveFactory)
    {
        state.archiveClassFactory = archiveFactory;
    }
    else
    {
        const filterFactory = findFilterClassFactory(state.archiveFileName);
        if (!filterFactory)
        {
            console.error("File \"" + state.archiveFileName + "\" has unsupported extension, " +
                          "supported ones are: " + getAllSupported(STREAM_FILEEXT));
            return -1;
        }
        state.filterClassFactory = filterFactory;
    }

    switch (state.command)
    {
        case CMD_CREATE:
            return doCreate(state);
        case CMD_LIST:
            return doList(state);
        case CMD_EXTRACT:
            return doExtract(state);
        default:
            return -1;
    }
}

// ---------------------------------------------------------------------------
// Command line (ArchiveApp::OnInitCmdLine / OnCmdLineParsed)
// ---------------------------------------------------------------------------

type ParseOutcome =
    | { readonly kind: "ok"; readonly state: ArchiveState; readonly verbose: boolean }
    | { readonly kind: "help" }
    | { readonly kind: "usage-error"; readonly message: string }
    | { readonly kind: "command-error"; readonly message: string };

function parseCommandLine(argv: readonly string[]): ParseOutcome
{
    let helpRequested = false;
    let verbose = false;
    let forceZip64 = false;
    const params: string[] = [];
    let maybeOption = true;

    // wxCmdLineParser's default switch characters: "/-" on Windows, "-" elsewhere.
    const switchChars = platform === "windows" ? "/-" : "-";

    for (const arg of argv)
    {
        if (maybeOption && arg === "--")
        {
            maybeOption = false;
            continue;
        }

        const isSwitch = maybeOption && arg.length > 1 && switchChars.indexOf(arg[0]) !== -1;
        if (!isSwitch)
        {
            params.push(arg);
            continue;
        }

        const isLong = arg.length >= 3 && arg[0] === "-" && arg[1] === "-";
        const name = isLong ? arg.slice(2) : arg.slice(1);

        if (name === "h" || name === "help")
        {
            helpRequested = true;
        }
        else if (name === "verbose")
        {
            verbose = true;
        }
        else if (name === "force-zip64")
        {
            forceZip64 = true;
        }
        else
        {
            return {
                kind: "usage-error",
                message: (isLong ? "Unknown long option '" : "Unknown option '") + name + "'",
            };
        }
    }

    if (helpRequested)
    {
        return { kind: "help" };
    }

    if (params.length < 1)
    {
        return {
            kind: "usage-error",
            message: "The required parameter 'command' was not specified.",
        };
    }

    if (params.length < 2)
    {
        return {
            kind: "usage-error",
            message: "The required parameter 'archive_name' was not specified.",
        };
    }

    let command = CMD_NONE;
    for (const desc of S_CMD_DESC)
    {
        if (desc.id === params[0])
        {
            command = desc.type;
        }
    }

    if (command === CMD_NONE)
    {
        return { kind: "command-error", message: "Invalid command: " + params[0] };
    }

    return {
        kind: "ok",
        verbose,
        state: {
            command,
            archiveFileName: params[1],
            fileNames: params.slice(2),
            forceZip64,
            archiveClassFactory: null,
            filterClassFactory: null,
        },
    };
}

/**
 * wxCmdLineParser::GetUsageString() reproduced for this sample's descriptor:
 * the option list is padded to the longest name plus a three-character margin,
 * and the AddUsageText() blocks follow in registration order.
 */
function buildUsageText(): string
{
    const switchChar = platform === "windows" ? "/" : "-";

    const options: Array<[string, string]> =
    [
        ["  " + switchChar + "h, --help", "show this help message"],
        ["  --verbose", "generate verbose log messages"],
        ["  --force-zip64", "Force ZIP64 format when creating ZIP archives"],
    ];

    let lenMax = 0;
    for (const [name] of options)
    {
        if (name.length > lenMax)
        {
            lenMax = name.length;
        }
    }

    const lines: string[] = [];
    lines.push("Usage: archive [" + switchChar + "h] [--verbose] [--force-zip64] " +
               "command archive_name [file_names...]");

    for (const [name, desc] of options)
    {
        lines.push(name.padEnd(lenMax) + "   " + desc);
    }

    lines.push("");
    lines.push("command:");
    for (const desc of S_CMD_DESC)
    {
        lines.push("  " + desc.id + ": " + desc.desc);
    }

    lines.push("");
    lines.push("supported formats: " + getAllSupported(STREAM_PROTOCOL));

    return lines.join("\n") + "\n";
}

/** wxCmdLineParser::Usage() */
function printUsage(): void
{
    const usage = buildUsageText();
    // wxMessageOutputStderr appends a line feed only when one is missing.
    console.error(usage.endsWith("\n") ? usage.slice(0, -1) : usage);
}

// ---------------------------------------------------------------------------
// Entry point (ArchiveApp::OnInit / OnRun)
// ---------------------------------------------------------------------------

export function main(): number
{
    if (!initialize())
    {
        console.error("Failed to initialize wxWidgets");
        return 1;
    }

    setAppName("archive");

    // wxAppConsole creates a wxLogStderr target; this host runs a GUI wxApp, so
    // install the same target to keep wxWidgets' diagnostics on stderr instead
    // of wxLogGui's deferred message boxes.
    const logTarget = createWxLogStderr();
    if (logTarget)
    {
        wxLog_SetActiveTarget(logTarget.ptr);
    }

    let result = 1;

    try
    {
        const outcome = parseCommandLine(args);
        switch (outcome.kind)
        {
            case "help":
                printUsage();
                result = -1;
                break;

            case "usage-error":
                console.error(outcome.message);
                printUsage();
                result = -1;
                break;

            case "command-error":
                console.error(outcome.message);
                result = -1;
                break;

            case "ok":
                if (outcome.verbose && logTarget)
                {
                    logTarget.SetVerbose(true);
                }
                result = runCommand(outcome.state);
                break;
        }
    }
    finally
    {
        shutdown();
    }

    return result;
}

exit(main());
