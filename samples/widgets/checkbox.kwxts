// checkbox.kwxts — port of wxSamples/src/widgets/checkbox.cpp

import {
    ALIGN_CENTRE,
    ALIGN_CENTRE_HORIZONTAL,
    ALIGN_RIGHT,
    BOTTOM,
    CHK_2STATE,
    CHK_3STATE,
    CHK_ALLOW_3RD_STATE_FOR_USER,
    CHK_UNDETERMINED,
    createWxBoxSizer,
    createWxButton,
    createWxCheckBox,
    createWxRadioBox,
    EVT_BUTTON,
    EVT_CHECKBOX,
    EVT_RADIOBOX,
    EVT_UPDATE_UI,
    EXPAND,
    HORIZONTAL,
    ID_ANY,
    ID_HIGHEST,
    LEFT,
    readAndDeleteWxString,
    RIGHT,
    TOP,
    VERTICAL,
    wxCheckBox,
    wxCommandEvent,
    wxRadioBox,
    wxSizer,
    wxTextCtrl,
    wxUpdateUIEvent,
    wxWindow,
} from "kwx";
import { pointerOf, Pointer } from "kwx/platform";

import {
    addSizer,
    addSpacer,
    addStretchSpacer,
    addWin,
    attrs,
    bindEvent,
    border,
    doubleBorder,
    logMessage,
    makeStaticBoxSizer,
    tripleBorder,
    WidgetsPage,
    withString,
} from "./common.kwxts";

const CHECKBOX_PAGE_RESET = ID_HIGHEST;
const CHECKBOX_PAGE_CHANGE_LABEL = CHECKBOX_PAGE_RESET + 1;
const CHECKBOX_PAGE_CHECK = CHECKBOX_PAGE_CHANGE_LABEL + 1;
const CHECKBOX_PAGE_UNCHECK = CHECKBOX_PAGE_CHECK + 1;
const CHECKBOX_PAGE_PART_CHECK = CHECKBOX_PAGE_UNCHECK + 1;
const CHECKBOX_PAGE_CHK_RIGHT = CHECKBOX_PAGE_PART_CHECK + 1;
const CHECKBOX_PAGE_CHECKBOX = CHECKBOX_PAGE_CHK_RIGHT + 1;

const CHECKBOX_KIND_2STATE = 0;
const CHECKBOX_KIND_3STATE = 1;
const CHECKBOX_KIND_3STATE_USER = 2;

/** wxRadioBox takes a char** array of UTF-8 strings. */
function makeRadioBox(
    parent: Pointer,
    label: string,
    choices: string[],
    dimension: number,
    style: number,
): wxRadioBox
{
    const buffers = choices.map((choice) =>
        new TextEncoder().encode(choice + "\0"));
    const pointers = new BigUint64Array(buffers.length);
    for (let i = 0; i < buffers.length; ++i)
    {
        pointers[i] = BigInt(pointerOf(buffers[i]) as bigint);
    }

    return withString(label, (text) =>
        createWxRadioBox(
            parent, ID_ANY, text, -1, -1, -1, -1,
            choices.length, pointerOf(pointers), dimension, style))!;
}

export class CheckBoxPage extends WidgetsPage
{
    private chkRight: wxCheckBox | null = null;
    private radioKind: wxRadioBox | null = null;
    private checkbox: wxCheckBox | null = null;
    private sizerCheckbox: wxSizer | null = null;
    private textLabel: wxTextCtrl | null = null;

    constructor(parent: Pointer)
    {
        super(parent, "icons/checkbox");
    }

    override getWidget(): wxWindow | null
    {
        return this.checkbox;
    }

    override createContent(): void
    {
        const top = createWxBoxSizer(HORIZONTAL)!;

        // Left pane: style.
        const left = makeStaticBoxSizer(
            this.page.ptr, VERTICAL, "&Set style");

        this.chkRight = this.createCheckBoxAndAddToSizer(
            left.sizer, "&Right aligned", CHECKBOX_PAGE_CHK_RIGHT, left.box.ptr);

        addSpacer(left.sizer, this.dip(15));

        const kinds = [
            "usual &2-state checkbox",
            "&3rd state settable by program",
            "&user-settable 3rd state",
        ];
        this.radioKind = makeRadioBox(left.box.ptr, "&Kind", kinds, 1, 0);
        addWin(left.sizer, this.radioKind, 0, EXPAND, border());

        const reset = withString("&Reset", (ptr) =>
            createWxButton(left.box.ptr, CHECKBOX_PAGE_RESET, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(left.sizer, reset, 0, ALIGN_CENTRE_HORIZONTAL, tripleBorder());

        // Middle pane: operations.
        const middle = makeStaticBoxSizer(
            this.page.ptr, VERTICAL, "&Operations");

        addSizer(middle.sizer, this.createSizerWithTextAndButton(
            CHECKBOX_PAGE_CHANGE_LABEL, "Change label", ID_ANY,
            (text) => { this.textLabel = text; }, middle.box.ptr),
            0, EXPAND, border());

        const check = withString("&Check it", (ptr) =>
            createWxButton(middle.box.ptr, CHECKBOX_PAGE_CHECK, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(middle.sizer, check, 0, EXPAND, border());

        const uncheck = withString("&Uncheck it", (ptr) =>
            createWxButton(middle.box.ptr, CHECKBOX_PAGE_UNCHECK, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(middle.sizer, uncheck, 0, EXPAND, border());

        const partCheck = withString("Put in &3rd state", (ptr) =>
            createWxButton(middle.box.ptr, CHECKBOX_PAGE_PART_CHECK, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(middle.sizer, partCheck, 0, EXPAND, border());

        // Right pane: the checkbox itself.
        const right = createWxBoxSizer(HORIZONTAL)!;
        this.checkbox = withString("&Check me!", (ptr) =>
            createWxCheckBox(
                this.page.ptr, CHECKBOX_PAGE_CHECKBOX, ptr,
                -1, -1, -1, -1, 0))!;

        addStretchSpacer(right, 1);
        addWin(right, this.checkbox, 1, ALIGN_CENTRE, 0);
        addStretchSpacer(right, 1);
        right.SetMinSize(this.dip(150), 0);
        this.sizerCheckbox = right;

        // Compose the three panes.
        addSizer(top, left.sizer, 0, EXPAND | TOP | RIGHT | BOTTOM,
            doubleBorder());
        addSizer(top, middle.sizer, 1, EXPAND, doubleBorder());
        addSizer(top, right, 1, EXPAND | LEFT | TOP | BOTTOM,
            doubleBorder());

        this.reset();
        this.page.SetSizer(top.ptr, false);

        // Event table.
        bindEvent(this.page, CHECKBOX_PAGE_CHECKBOX, CHECKBOX_PAGE_CHECKBOX,
            EVT_CHECKBOX, (eventPtr) =>
            {
                if (!eventPtr) return;
                const event = new wxCommandEvent(eventPtr, true);
                const state = this.checkbox ? this.checkbox.Get3StateValue() : 0;
                logMessage(`Test checkbox ${event.IsChecked() ? "" : "un"}`
                    + `checked (value = ${state}).`);
            });

        bindEvent(this.page, CHECKBOX_PAGE_RESET, CHECKBOX_PAGE_RESET,
            EVT_BUTTON, () => { this.reset(); this.createCheckbox(); });
        bindEvent(this.page, CHECKBOX_PAGE_CHANGE_LABEL,
            CHECKBOX_PAGE_CHANGE_LABEL, EVT_BUTTON, () =>
            {
                if (!this.checkbox || !this.textLabel) return;
                const value = this.textLabel.GetValue();
                if (value) this.checkbox.SetLabel(value.ptr);
            });
        bindEvent(this.page, CHECKBOX_PAGE_CHECK, CHECKBOX_PAGE_CHECK,
            EVT_BUTTON, () => this.checkbox?.SetValue(true));
        bindEvent(this.page, CHECKBOX_PAGE_UNCHECK, CHECKBOX_PAGE_UNCHECK,
            EVT_BUTTON, () => this.checkbox?.SetValue(false));
        bindEvent(this.page, CHECKBOX_PAGE_PART_CHECK, CHECKBOX_PAGE_PART_CHECK,
            EVT_BUTTON, () => this.checkbox?.Set3StateValue(CHK_UNDETERMINED));

        bindEvent(this.page, CHECKBOX_PAGE_PART_CHECK, CHECKBOX_PAGE_PART_CHECK,
            EVT_UPDATE_UI, (eventPtr) =>
            {
                if (!eventPtr) return;
                const event = new wxUpdateUIEvent(eventPtr, true);
                event.Enable(this.checkbox?.Is3State() ?? false);
            });

        bindEvent(this.page, ID_ANY, ID_ANY, EVT_RADIOBOX,
            () => this.createCheckbox());
        bindEvent(this.page, CHECKBOX_PAGE_CHK_RIGHT, CHECKBOX_PAGE_CHK_RIGHT,
            EVT_CHECKBOX, () => this.createCheckbox());
    }

    override recreateWidget(): void
    {
        this.createCheckbox();
    }

    private reset(): void
    {
        this.chkRight?.SetValue(false);
        this.radioKind?.SetSelection(CHECKBOX_KIND_2STATE);
    }

    private createCheckbox(): void
    {
        const sizer = this.sizerCheckbox;
        if (!sizer)
        {
            return;
        }

        let label = "&Check me!";
        if (this.checkbox)
        {
            const current = this.checkbox.GetLabel();
            if (current)
            {
                label = readAndDeleteWxString(current.ptr);
            }
        }

        // wxSizer::Remove(0) repeats until the sizer is empty.
        while (sizer.GetItemCount() > 0)
        {
            sizer.Remove(0);
        }

        if (this.checkbox)
        {
            this.checkbox.Destroy();
            this.checkbox = null;
        }

        let flags = attrs.defaultFlags;
        if (this.chkRight?.GetValue())
        {
            flags |= ALIGN_RIGHT;
        }

        switch (this.radioKind?.GetSelection() ?? CHECKBOX_KIND_2STATE)
        {
            case CHECKBOX_KIND_3STATE_USER:
                flags |= CHK_3STATE | CHK_ALLOW_3RD_STATE_FOR_USER;
                break;
            case CHECKBOX_KIND_3STATE:
                flags |= CHK_3STATE;
                break;
            default:
                flags |= CHK_2STATE;
                break;
        }

        this.checkbox = withString(label, (ptr) =>
            createWxCheckBox(
                this.page.ptr, CHECKBOX_PAGE_CHECKBOX, ptr,
                -1, -1, -1, -1, flags))!;

        this.notifyWidgetRecreation(this.checkbox);

        addStretchSpacer(sizer, 1);
        addWin(sizer, this.checkbox, 1, ALIGN_CENTRE, 0);
        addStretchSpacer(sizer, 1);
        sizer.Layout();
    }
}

export function createCheckBoxPage(parent: Pointer): WidgetsPage
{
    return new CheckBoxPage(parent);
}
