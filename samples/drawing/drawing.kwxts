// The C++ sample has no compile-time alpha support on MSW, so a wxGraphicsContext
// is required for the Alpha screen there.  GTK3/macOS wxDC supports alpha.
const dcSupportsAlpha = platform !== "windows";

// ---------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------

const callbacks: Callback[] = [];
const closures: unknown[] = [];

function withString<T>(text: string, fn: (ptr: Pointer) => T): T
{
    const value = createWxString(text);
    try
    {
        return fn(value.ptr);
    }
    finally
    {
        value.Delete();
    }
}

function withTwoStrings<T>(
    first: string,
    second: string,
    fn: (a: Pointer, b: Pointer) => T,
): T
{
    return withString(first, (a) => withString(second, (b) => fn(a, b)));
}

function connectEvent(
    owner: Pointer,
    first: number,
    last: number,
    eventType: number,
    handler: (eventPtr: Pointer) => void,
): void
{
    const callback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            // wxClosure invokes every handler with a null event during teardown.
            if (!eventPtr) return;
            handler(eventPtr);
        },
    );
    callbacks.push(callback);

    const closure = createWxClosure(callback.pointer, null);
    if (!closure) return;
    closures.push(closure);

    lib.symbols.wxEvtHandler_Connect(
        owner, first, last, eventType, closure.ptr,
    );
}

function colourRGB(r: number, g: number, b: number, a: number = 255): wxColour | null
{
    return createWxColourRGB(r, g, b, a);
}

function setPen(dc: wxDC, colourPtr: Pointer, width: number = 0, style: number = PENSTYLE_SOLID): void
{
    const pen = createWxPenFromColour(colourPtr, width, style);
    if (!pen) return;
    dc.SetPen(pen.ptr);
    pen.Delete();
}

function setBrush(dc: wxDC, colourPtr: Pointer, style: number = BRUSHSTYLE_SOLID): void
{
    const brush = createWxBrushFromColour(colourPtr, style);
    if (!brush) return;
    dc.SetBrush(brush.ptr);
    brush.Delete();
}

function drawText(dc: wxDC, text: string, x: number, y: number): void
{
    withString(text, (ptr) => dc.DrawText(ptr, x, y));
}

function drawRotatedText(dc: wxDC, text: string, x: number, y: number, angle: number): void
{
    withString(text, (ptr) => dc.DrawRotatedText(ptr, x, y, angle));
}

function drawLabel(
    dc: wxDC, text: string,
    x: number, y: number, width: number, height: number,
    align: number,
): void
{
    withString(text, (ptr) => dc.DrawLabel(ptr, x, y, width, height, align, -1));
}

function drawRectangleRect(dc: wxDC, r: Rect): void
{
    dc.DrawRectangle(r.x, r.y, r.w, r.h);
}

// Font creation matching wxFontInfo(pointSize).Family(...).Underlined() etc.
function makeFontInfo(
    pointSize: number | null,
    family: number | null,
    underlined: boolean = false,
    italic: boolean = false,
    faceName: string = "",
): wxFont | null
{
    const info = pointSize === null
        ? createWxFontInfoDefault()
        : createWxFontInfo(pointSize);
    if (!info) return null;

    if (family !== null) info.SetFamily(family);
    if (underlined) info.SetUnderlined(true);
    if (italic) info.SetItalic(true);

    let font: wxFont | null;
    if (faceName)
    {
        font = withString(faceName, (ptr) =>
        {
            info.SetFaceName(ptr);
            return createWxFontFromInfo(info.ptr);
        });
    }
    else
    {
        font = createWxFontFromInfo(info.ptr);
    }

    info.Delete();
    return font;
}

function setFontInfo(
    dc: wxDC,
    pointSize: number | null,
    family: number | null,
    underlined: boolean = false,
    italic: boolean = false,
    faceName: string = "",
): void
{
    const font = makeFontInfo(pointSize, family, underlined, italic, faceName);
    if (!font) return;
    dc.SetFont(font.ptr);
    font.Delete();
}

function getFontCopy(dc: wxDC): wxFont | null
{
    const font = createWxFontDefault();
    if (!font) return null;
    dc.GetFont(font.ptr);
    return font;
}

function measureText(
    dc: wxDC, text: string,
): { width: number; height: number; descent: number }
{
    const w = new Int32Array(1);
    const h = new Int32Array(1);
    const d = new Int32Array(1);
    withString(text, (ptr) =>
    {
        dc.GetTextExtent(ptr, pointerOf(w), pointerOf(h), pointerOf(d), null, null);
    });
    return { width: w[0], height: h[0], descent: d[0] };
}

interface Rect { x: number; y: number; w: number; h: number }

function rectContains(r: Rect, x: number, y: number): boolean
{
    return x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h;
}

function normalizeRect(x1: number, y1: number, x2: number, y2: number): Rect
{
    return {
        x: Math.min(x1, x2),
        y: Math.min(y1, y2),
        w: Math.abs(x2 - x1),
        h: Math.abs(y2 - y1),
    };
}

function degToRad(deg: number): number
{
    return deg * Math.PI / 180.0;
}

