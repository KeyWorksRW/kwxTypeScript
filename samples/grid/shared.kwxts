// shared.kwxts — ids, state and small helpers for the wxGrid sample port.
//
// This module is imported by gridcontent.kwxts, handlers.kwxts and grid.kwxts.
// It only depends on the public binding surface.

import {
    createWxString,
    kwxMessageBox,
    LogError,
    LogMessage,
    LogWarning,
    OK,
    readAndDeleteWxString,
} from "kwx";
import { Callback, Pointer } from "kwx/platform";
import type {
    wxClosure,
    wxFrame,
    wxGrid,
    wxLogTextCtrl,
    wxMenuBar,
    wxTextCtrl,
} from "kwx";

