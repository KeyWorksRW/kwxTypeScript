// shared.kwxts — string, logging and wxDateTime helpers for the calendar port.
//
// These mirror the small helpers used by wxSamples/src/calendar/calendar.cpp:
// wxString::Format-based logging, wxDateTime formatting and the sizer-flag
// convenience calls. They contain no sample-specific state.

import {
    LogMessage,
    LogStatus,
    LogWarning,
    createWxDateTime,
    createWxSizerFlags,
    createWxString,
    kwxMessageBox,
    readAndDeleteWxString,
    wxDateTime_GetMonthName,
    wxDateTime_GetWeekDayName,
} from "kwx";
import type {
    wxCalendarCtrlBase,
    wxCalendarEvent,
    wxDateEvent,
    wxDateTime,
    wxSizer,
    wxSizerFlags,
} from "kwx";
import type { Pointer } from "kwx/platform";

// ---------------------------------------------------------------------------
// wxString lifetime
// ---------------------------------------------------------------------------

/** Call fn with a temporary wxString and release it on every path. */
export function withString<T>(text: string, fn: (ptr: Pointer) => T): T
{
    const value = createWxString(text);
    try
    {
        return fn(value.ptr);
    }
    finally
    {
        value.Delete();
    }
}

// ---------------------------------------------------------------------------
// Logging
// ---------------------------------------------------------------------------

/**
 * kwxFFI's LogMessage/LogStatus/LogWarning forward the whole wxString as the
 * printf-style format. Doubling '%' keeps user text from being interpreted as
 * a conversion specification; the visible output is unchanged.
 */
function escapeFormat(text: string): string
{
    return text.replace(/%/g, "%%");
}

/** wxLogMessage(message) */
export function logMessage(text: string): void
{
    withString(escapeFormat(text), (ptr) => LogMessage(ptr));
}

/** wxLogStatus(message) */
export function logStatus(text: string): void
{
    withString(escapeFormat(text), (ptr) => LogStatus(ptr));
}

/** wxLogWarning(message) */
export function logWarning(text: string): void
{
    withString(escapeFormat(text), (ptr) => LogWarning(ptr));
}

/** wxMessageBox(message, caption, style, parent) */
export function showMessage(
    parent: Pointer,
    message: string,
    caption: string,
    style: number,
): void
{
    withString(message, (messagePtr) =>
    {
        withString(caption, (captionPtr) =>
        {
            kwxMessageBox(messagePtr, captionPtr, style, parent, -1, -1);
        });
    });
}

// ---------------------------------------------------------------------------
// wxDateTime helpers
// ---------------------------------------------------------------------------

/** wxDateTime() — an invalid (wxDefaultDateTime) value. */
export function newDateTime(): wxDateTime
{
    // createWxDateTime() only fails if the native allocation fails.
    return createWxDateTime()!;
}

/** wxDateTime::Today() */
export function today(): wxDateTime
{
    const date = newDateTime();
    date.Today();
    return date;
}

/** m_calendar->GetDate() (the binding takes an out parameter). */
export function getCalendarDate(calendar: wxCalendarCtrlBase): wxDateTime
{
    const date = newDateTime();
    calendar.GetDate(date.ptr);
    return date;
}

/** event.GetDate() for a wxCalendarEvent. */
export function getCalendarEventDate(event: wxCalendarEvent): wxDateTime
{
    const date = newDateTime();
    event.GetDate(date.ptr);
    return date;
}

/** event.GetDate() for a wxDateEvent (date/time picker change events). */
export function getDateEventDate(event: wxDateEvent): wxDateTime
{
    const date = newDateTime();
    event.GetDate(date.ptr);
    return date;
}

/** wxDateTime::FormatISODate() */
export function formatISODate(date: wxDateTime): string
{
    const value = date.FormatISODate();
    return value ? readAndDeleteWxString(value.ptr) : "";
}

/** wxDateTime::FormatISOTime() */
export function formatISOTime(date: wxDateTime): string
{
    const value = date.FormatISOTime();
    return value ? readAndDeleteWxString(value.ptr) : "";
}

/** wxDateTime::GetWeekDayName(weekday) with the default Name_Full flag. */
export function weekDayName(weekday: number): string
{
    // Name_Full == 0x01, see wx/datetime.h.
    return readAndDeleteWxString(wxDateTime_GetWeekDayName(weekday, 1));
}

/** wxDateTime::GetMonthName(month) with the default Name_Full flag. */
export function monthName(month: number): string
{
    // Name_Full == 0x01, see wx/datetime.h.
    return readAndDeleteWxString(wxDateTime_GetMonthName(month, 1));
}

// ---------------------------------------------------------------------------
// Sizer helpers (wxSizerFlags is a real binding)
// ---------------------------------------------------------------------------

/** sizer->Add(window, wxSizerFlags(proportion).<setup>()) */
export function addWindowWithFlags(
    sizer: wxSizer,
    window: Pointer,
    proportion: number,
    setup: (flags: wxSizerFlags) => void,
): void
{
    const flags = createWxSizerFlags(proportion);
    if (!flags)
    {
        sizer.AddWindow(window, proportion, 0, 0, null);
        return;
    }
    setup(flags);
    sizer.AddWindowFlags(window, flags.ptr);
    flags.Delete();
}

/** sizer->Add(child, wxSizerFlags(proportion).<setup>()) */
export function addSizerWithFlags(
    sizer: wxSizer,
    child: Pointer,
    proportion: number,
    setup: (flags: wxSizerFlags) => void,
): void
{
    const flags = createWxSizerFlags(proportion);
    if (!flags)
    {
        sizer.AddSizer(child, proportion, 0, 0, null);
        return;
    }
    setup(flags);
    sizer.AddSizerFlags(child, flags.ptr);
    flags.Delete();
}
