// ===========================================================================
// animate.kwxts — kwxTypeScript port of wxSamples/src/animate (anitest.cpp)
//
// wxAnimationCtrl sample: a frame showing a throbber animation (a 1x/2x
// wxAnimationBundle), an "Animation frames" static box that inspects the
// individual frames (spin control, frame count, frame delay, frame bitmap),
// and a menu bar to play/stop the animation, replace it with wxNullAnimation,
// set an inactive bitmap, toggle wxAC_NO_AUTORESIZE, pick a background colour,
// open another animation file, and show an about box.
//
// Run from the repository root:
//   bin\Release\kwxts.exe samples\animate\animate.kwxts
//
// Porting notes (details in the report):
//   * wxHAS_NATIVE_ANIMATIONCTRL is set on the MSW build of the original, which
//     adds the "Use generic animation" check item and the wxGenericAnimationCtrl
//     branch of RecreateAnimation(). kwxFFI exposes no wxGenericAnimationCtrl,
//     so that menu item and its handler are the only dropped feature; the
//     native control is always used.
//   * `delete m_animationCtrl` becomes Destroy(): the control is parent-owned.
//   * wxICON(sample) uses the same artwork converted from ../sample.xpm to
//     sample.svg, loaded at run time (a kwxTypeScript program has no resources).
//   * EVT_SIZE(MyFrame::OnSize) is registered in the C++ event table but has no
//     declaration and no definition, so there is nothing to port for it.
// ===========================================================================

declare const __dirname: string;

import {
    AC_DEFAULT_STYLE,
    AC_NO_AUTORESIZE,
    ALL,
    ANIMATION_TYPE_ANY,
    ART_MISSING_IMAGE,
    BITMAP_SCREEN_DEPTH,
    DEFAULT_FRAME_STYLE,
    EVT_CLOSE_WINDOW,
    EVT_MENU,
    EVT_SPINCTRL,
    EVT_UPDATE_UI,
    FD_OPEN,
    HORIZONTAL,
    ID_ABOUT,
    ID_ANY,
    ID_EXIT,
    ID_OK,
    ID_OPEN,
    ID_STOP,
    LEFT,
    LogError,
    RIGHT,
    SP_ARROW_KEYS,
    STB_DEFAULT_STYLE,
    VERTICAL,
    createWxAboutDialogInfo,
    createWxAnimation,
    createWxAnimationBundle,
    createWxAnimationCtrl,
    createWxAnimationCtrlWithAnimation,
    createWxAnimationFromFile,
    createWxBitmapDefault,
    createWxBitmapFromImage,
    createWxBoxSizer,
    createWxClosure,
    createWxColourEmpty,
    createWxFileDialog,
    createWxFrame,
    createWxIconDefault,
    createWxImageDefault,
    createWxMenu,
    createWxMenuBar,
    createWxSizerFlags,
    createWxSpinCtrl,
    createWxStaticBitmap,
    createWxStaticBox,
    createWxStaticBoxSizer,
    createWxStaticText,
    createWxString,
    exitMainLoop,
    initialize,
    readAndDeleteWxString,
    run,
    setAppName,
    setTopWindow,
    shutdown,
    wxAboutBox,
    wxAboutDialogInfo,
    wxAnimation,
    wxAnimationBundle,
    wxAnimationCtrl,
    wxArtProvider_GetBitmap,
    wxBitmapBundle,
    wxBitmapBundle_FromSVGFile,
    wxClosure,
    wxCommandEvent,
    wxFrame,
    wxGetColourFromUserEx,
    wxImage,
    wxMenu,
    wxMenuBar,
    wxSizer,
    wxSizerFlags,
    wxSpinCtrl,
    wxStaticBitmap,
    wxStaticBox,
    wxStaticText,
} from "kwx";
import { Callback, exit, Pointer } from "kwx/platform";

// ---------------------------------------------------------------------------
// anitest.cpp:58-66 — the sample's private command ids. ID_PLAY is 1 and the
// rest follow it in declaration order.
// ---------------------------------------------------------------------------
const ID_PLAY = 1;
const ID_SET_NULL_ANIMATION = 2;
const ID_SET_INACTIVE_BITMAP = 3;
const ID_SET_NO_AUTO_RESIZE = 4;
const ID_SET_BGCOLOR = 5;

// ---------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------

interface EventBinding
{
    callback: Callback;
    closure: wxClosure;
}

/** Creates a wxString for the duration of `fn` and releases it afterwards. */
function withString<T>(text: string, fn: (ptr: Pointer) => T): T
{
    const value = createWxString(text);
    try
    {
        return fn(value.ptr);
    }
    finally
    {
        value.Delete();
    }
}

/** Absolute path of an asset shipped next to this module. */
function assetPath(name: string): string
{
    return __dirname.replace(/\\/g, "/") + "/" + name;
}

/**
 * wxLogError(). The messages below never contain printf escapes, so the text
 * reaches the log window unchanged.
 */
function logError(text: string): void
{
    withString(text, (ptr) => LogError(ptr));
}

/** sizer->Add(window, wxSizerFlags(proportion).<setup>()) */
function addWindowWithFlags(
    sizer: wxSizer,
    window: Pointer,
    proportion: number,
    setup: (flags: wxSizerFlags) => void,
): void
{
    const flags = createWxSizerFlags(proportion);
    if (!flags)
    {
        sizer.AddWindow(window, proportion, 0, 0, null);
        return;
    }
    setup(flags);
    sizer.AddWindowFlags(window, flags.ptr);
    flags.Delete();
}

/** sizer->Add(child, wxSizerFlags(proportion).<setup>()) */
function addSizerWithFlags(
    sizer: wxSizer,
    child: Pointer,
    proportion: number,
    setup: (flags: wxSizerFlags) => void,
): void
{
    const flags = createWxSizerFlags(proportion);
    if (!flags)
    {
        sizer.AddSizer(child, proportion, 0, 0, null);
        return;
    }
    setup(flags);
    sizer.AddSizerFlags(child, flags.ptr);
    flags.Delete();
}

/** wxStaticText(parent, wxID_ANY, text) with default position/size/style. */
function createLabel(parent: Pointer, text: string): wxStaticText | null
{
    return withString(text, (ptr) =>
        createWxStaticText(parent, ID_ANY, ptr, -1, -1, -1, -1, 0));
}

/** wxMenu with an empty title and default style (as in the C++ sample). */
function createPlainMenu(): wxMenu | null
{
    return withString("", (ptr) => createWxMenu(ptr, 0n));
}

/** wxStaticText::SetLabel(). */
function setLabel(label: wxStaticText, text: string): void
{
    withString(text, (ptr) => { label.SetLabel(ptr); });
}

/**
 * SetIcon(wxICON(sample)) from the converted 32x32 sample.svg artwork.
 * wxTopLevelWindow::SetIcon() copies the icon, so the temporaries are freed.
 */
function applyFrameIcon(frame: wxFrame): void
{
    const path = createWxString(assetPath("sample.svg"));
    let bundle: wxBitmapBundle | null = null;
    try
    {
        bundle = wxBitmapBundle_FromSVGFile(path.ptr, 32, 32);
    }
    finally
    {
        path.Delete();
    }
    if (!bundle)
    {
        return;
    }

    const bitmap = bundle.GetBitmap(32, 32);
    if (bitmap)
    {
        const icon = createWxIconDefault();
        if (icon)
        {
            icon.CopyFromBitmap(bitmap.ptr);
            frame.SetIcon(icon.ptr);
            icon.Delete();
        }
        bitmap.Delete();
    }
    bundle.Delete();
}

// ---------------------------------------------------------------------------
// MyFrame's control members (anitest.h:57-64)
// ---------------------------------------------------------------------------

interface AnimateFrameState
{
    frame: wxFrame;
    menuBar: wxMenuBar;
    animationCtrl: wxAnimationCtrl;
    frameBox: wxStaticBox;
    frameSpin: wxSpinCtrl;
    frameCount: wxStaticText;
    frameDelay: wxStaticText;
    frameBitmap: wxStaticBitmap;
    /** Native animations/bundle of the initial throbber; kept alive. */
    animations: wxAnimation[];
    bundles: wxAnimationBundle[];
    bindings: EventBinding[];
}

// ---------------------------------------------------------------------------
// Frame bitmap helpers (UpdateFrameInfo)
// ---------------------------------------------------------------------------

/** m_frameBitmap->SetBitmap(wxBitmapBundle()) — clears the shown frame. */
function clearFrameBitmap(state: AnimateFrameState): void
{
    const empty = createWxBitmapDefault();
    if (!empty)
    {
        return;
    }
    state.frameBitmap.SetBitmap(empty.ptr);
    empty.Delete();
}

/** m_frameBitmap->SetBitmap(wxBitmap(image)); wxStaticBitmap copies the bitmap. */
function setFrameBitmap(state: AnimateFrameState, image: wxImage): void
{
    const bitmap = createWxBitmapFromImage(image.ptr, BITMAP_SCREEN_DEPTH);
    if (!bitmap)
    {
        return;
    }
    state.frameBitmap.SetBitmap(bitmap.ptr);
    bitmap.Delete();
}

// ---------------------------------------------------------------------------
// MyFrame::UpdateFrameControls() / UpdateFrameInfo() (anitest.cpp:320-373)
// ---------------------------------------------------------------------------

function updateFrameControls(state: AnimateFrameState): void
{
    const animation = createWxAnimation();
    if (!animation)
    {
        return;
    }

    // const wxAnimation animation = m_animationCtrl->GetAnimation();
    state.animationCtrl.GetAnimation(animation.ptr);

    const count = animation.IsOk() ? animation.GetFrameCount() : 0;

    state.frameBox.Enable(count !== 0);

    if (count)
    {
        state.frameSpin.SetRange(0, count - 1);
        setLabel(state.frameCount, `(of ${count})`);
    }
    else
    {
        state.frameSpin.SetRange(0, 0);
        setLabel(state.frameCount, "(no frames)");
    }

    state.frameSpin.SetValue(0);

    animation.Delete();

    updateFrameInfo(state);
}

function updateFrameInfo(state: AnimateFrameState): void
{
    const animation = createWxAnimation();
    if (!animation)
    {
        return;
    }

    // const wxAnimation animation = m_animationCtrl->GetAnimation();
    state.animationCtrl.GetAnimation(animation.ptr);

    if (animation.IsOk() && animation.GetFrameCount() !== 0)
    {
        const frame = state.frameSpin.GetValue();

        const delay = animation.GetDelay(frame);
        setLabel(state.frameDelay,
            delay === -1 ? "Delay: forever" : `Delay: ${delay} ms`);

        const image = createWxImageDefault();
        if (image)
        {
            animation.GetFrame(frame, image.ptr);
            if (image.IsOk())
            {
                setFrameBitmap(state, image);
            }
            else
            {
                // wxLogError("Failed to get animation frame %u.", frame)
                logError(`Failed to get animation frame ${frame}.`);
                clearFrameBitmap(state);
            }
            image.Delete();
        }
        else
        {
            clearFrameBitmap(state);
        }
    }
    else
    {
        setLabel(state.frameDelay, "Delay: N/A");
        clearFrameBitmap(state);
    }

    animation.Delete();

    // Layout() — the frame's sizer re-lays the box after the bitmap changed.
    state.frame.GetSizer()?.Layout();
}

// ---------------------------------------------------------------------------
// MyFrame::RecreateAnimation() (anitest.cpp:275-318)
// ---------------------------------------------------------------------------

function recreateAnimation(state: AnimateFrameState, style: number): void
{
    const currentStyle = Number(state.animationCtrl.GetWindowStyle());

    const curr = createWxAnimation();
    if (!curr)
    {
        return;
    }

    // The animation is only carried over when the style changed, which is the
    // only reason to recreate the control here (switching between the native
    // and the generic control deliberately starts without an animation).
    if (style !== currentStyle)
    {
        state.animationCtrl.GetAnimation(curr.ptr);
    }

    const inactive = createWxBitmapDefault();
    if (inactive)
    {
        state.animationCtrl.GetInactiveBitmap(inactive.ptr);
    }

    const background = createWxColourEmpty();
    if (background)
    {
        state.animationCtrl.GetBackgroundColour(background.ptr);
    }

    const old = state.animationCtrl;

    // The original picks wxGenericAnimationCtrl when the "Use generic
    // animation" item is checked; that class is not bound, so the native
    // control is always recreated.
    const next = createWxAnimationCtrlWithAnimation(
        state.frame.ptr, ID_ANY, curr.ptr, -1, -1, -1, -1, style,
    );
    if (!next)
    {
        curr.Delete();
        inactive?.Delete();
        background?.Delete();
        return;
    }

    const sizer = state.frame.GetSizer();
    if (sizer)
    {
        // GetSizer()->Replace(old, m_animationCtrl)
        sizer.ReplaceWindow(old.ptr, next.ptr, false);
    }

    // delete old — a parent-owned window must be released with Destroy().
    old.Destroy();

    if (inactive)
    {
        next.SetInactiveBitmap(inactive.ptr);
    }
    if (background)
    {
        next.SetBackgroundColour(background.ptr);
    }

    state.animationCtrl = next;

    if (sizer)
    {
        sizer.Layout();
    }

    curr.Delete();
    inactive?.Delete();
    background?.Delete();

    updateFrameControls(state);
}

// ---------------------------------------------------------------------------
// MyFrame event handlers
// ---------------------------------------------------------------------------

/** MyFrame::OnPlay */
function onPlay(state: AnimateFrameState): void
{
    if (!state.animationCtrl.Play())
    {
        logError("Invalid animation");
    }
}

/** MyFrame::OnStop */
function onStop(state: AnimateFrameState): void
{
    state.animationCtrl.Stop();
}

/** MyFrame::OnSetNullAnimation */
function onSetNullAnimation(state: AnimateFrameState): void
{
    // wxNullAnimation is an empty (but valid) wxAnimation object.
    const nullAnimation = createWxAnimation();
    if (nullAnimation)
    {
        state.animationCtrl.SetAnimation(nullAnimation.ptr);
        nullAnimation.Delete();
    }

    updateFrameControls(state);
}

/** MyFrame::OnSetInactiveBitmap */
function onSetInactiveBitmap(state: AnimateFrameState, checked: boolean): void
{
    if (checked)
    {
        // set a dummy bitmap as the inactive bitmap
        const bitmap = wxArtProvider_GetBitmap(ART_MISSING_IMAGE, null, -1, -1);
        if (bitmap)
        {
            state.animationCtrl.SetInactiveBitmap(bitmap.ptr);
            bitmap.Delete();
        }
    }
    else
    {
        // wxNullBitmap
        const empty = createWxBitmapDefault();
        if (empty)
        {
            state.animationCtrl.SetInactiveBitmap(empty.ptr);
            empty.Delete();
        }
    }
}

/** MyFrame::OnSetNoAutoResize */
function onSetNoAutoResize(state: AnimateFrameState, checked: boolean): void
{
    // recreate the control with the new flag if necessary
    const style = AC_DEFAULT_STYLE | (checked ? AC_NO_AUTORESIZE : 0);

    if (style !== Number(state.animationCtrl.GetWindowStyle()))
    {
        recreateAnimation(state, style);
    }
}

/** MyFrame::OnSetBgColor */
function onSetBgColor(state: AnimateFrameState): void
{
    const initial = createWxColourEmpty();
    const colour = createWxColourEmpty();
    if (!initial || !colour)
    {
        initial?.Delete();
        colour?.Delete();
        return;
    }

    state.animationCtrl.GetBackgroundColour(initial.ptr);

    // wxGetColourFromUser(this, ctrl bg, "Choose the background colour")
    withString("Choose the background colour", (caption) =>
        wxGetColourFromUserEx(
            state.frame.ptr, initial.ptr, caption, colour.ptr,
        ));

    if (colour.IsOk())
    {
        state.animationCtrl.SetBackgroundColour(colour.ptr);
    }

    colour.Delete();
    initial.Delete();
}

/** MyFrame::OnOpen */
function onOpen(state: AnimateFrameState): void
{
    const dialog = withString("Please choose an animation", (message) =>
        withString("", (directory) =>
            withString("", (defaultFile) =>
                withString("*.gif;*.ani;*.webp", (wildcard) =>
                    createWxFileDialog(
                        state.frame.ptr, message, directory, defaultFile,
                        wildcard, -1, -1, FD_OPEN, -1, -1,
                    )))));

    if (!dialog)
    {
        return;
    }

    if (dialog.ShowModal() === ID_OK)
    {
        const path = dialog.GetPath();
        const filename = path ? readAndDeleteWxString(path.ptr) : "";

        // wxAnimation temp(m_animationCtrl->CreateAnimation());
        const temp = createWxAnimation();
        if (temp)
        {
            state.animationCtrl.CreateAnimation(temp.ptr);

            const loaded = withString(filename, (ptr) =>
                temp.LoadFile(ptr, ANIMATION_TYPE_ANY));

            if (!loaded)
            {
                logError(
                    "Sorry, this animation is not a valid format for wxAnimation.",
                );
            }
            else
            {
                state.animationCtrl.SetAnimation(temp.ptr);
                state.animationCtrl.Play();

                state.frame.GetSizer()?.Layout();

                updateFrameControls(state);
            }
            temp.Delete();
        }
    }

    dialog.Destroy();
}

/** MyFrame::OnQuit */
function onQuit(state: AnimateFrameState): void
{
    // Close() — EVT_CLOSE_WINDOW stops the main loop.
    state.frame.Close(false);
}

/** MyFrame::OnAbout */
function onAbout(state: AnimateFrameState): void
{
    const infoPtr = createWxAboutDialogInfo();
    if (!infoPtr)
    {
        return;
    }
    const info = new wxAboutDialogInfo(infoPtr);

    withString("wxAnimationCtrl and wxAnimation sample",
        (ptr) => info.SetName(ptr));
    withString("This sample program demonstrates the usage of wxAnimationCtrl",
        (ptr) => info.SetDescription(ptr));
    withString("(C) 2006 Julian Smart", (ptr) => info.SetCopyright(ptr));

    withString("Julian Smart", (ptr) => info.AddDeveloper(ptr));
    withString("Guillermo Rodriguez Garcia", (ptr) => info.AddDeveloper(ptr));
    withString("Francesco Montorsi", (ptr) => info.AddDeveloper(ptr));

    wxAboutBox(info.ptr, state.frame.ptr);

    info.Delete();
}

/** MyFrame::OnFrameSpin */
function onFrameSpin(state: AnimateFrameState): void
{
    updateFrameInfo(state);
}

/** MyFrame::OnUpdateUI — enables the play/stop/no-autoresize items. */
function onUpdateUI(state: AnimateFrameState): void
{
    const playing = state.animationCtrl.IsPlaying();

    state.menuBar.FindItem(ID_STOP)?.Enable(playing);
    state.menuBar.FindItem(ID_PLAY)?.Enable(!playing);
    state.menuBar.FindItem(ID_SET_NO_AUTO_RESIZE)?.Enable(!playing);
}

// ---------------------------------------------------------------------------
// MyFrame event table (anitest.cpp:68-87)
// ---------------------------------------------------------------------------

function bindEvent(
    target: wxFrame | wxSpinCtrl,
    state: AnimateFrameState,
    first: number,
    last: number,
    eventType: number,
    handler: (eventPtr: Pointer) => void,
): void
{
    const callback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            // wxClosure invokes every handler with a null event at teardown.
            if (!eventPtr)
            {
                return;
            }
            handler(eventPtr);
        },
    );
    const closure = createWxClosure(callback.pointer, null)!;
    target.Bind(first, last, eventType, closure.ptr);
    state.bindings.push({ callback, closure });
}

function bindFrameEvents(state: AnimateFrameState): void
{
    const frame = state.frame;

    const commandChecked = (id: number, handler: (checked: boolean) => void): void =>
    {
        bindEvent(frame, state, id, id, EVT_MENU, (eventPtr) =>
            handler(new wxCommandEvent(eventPtr).IsChecked()));
    };
    const command = (id: number, handler: () => void): void =>
    {
        bindEvent(frame, state, id, id, EVT_MENU, () => handler());
    };

    // EVT_MENU(ID_PLAY, MyFrame::OnPlay)
    command(ID_PLAY, () => onPlay(state));
    // EVT_MENU(ID_SET_NULL_ANIMATION, MyFrame::OnSetNullAnimation)
    command(ID_SET_NULL_ANIMATION, () => onSetNullAnimation(state));
    // EVT_MENU(ID_SET_INACTIVE_BITMAP, MyFrame::OnSetInactiveBitmap)
    commandChecked(ID_SET_INACTIVE_BITMAP,
        (checked) => onSetInactiveBitmap(state, checked));
    // EVT_MENU(ID_SET_NO_AUTO_RESIZE, MyFrame::OnSetNoAutoResize)
    commandChecked(ID_SET_NO_AUTO_RESIZE,
        (checked) => onSetNoAutoResize(state, checked));
    // EVT_MENU(ID_SET_BGCOLOR, MyFrame::OnSetBgColor)
    command(ID_SET_BGCOLOR, () => onSetBgColor(state));

    // EVT_MENU(wxID_STOP, MyFrame::OnStop)
    command(ID_STOP, () => onStop(state));
    // EVT_MENU(wxID_ABOUT, MyFrame::OnAbout)
    command(ID_ABOUT, () => onAbout(state));
    // EVT_MENU(wxID_EXIT, MyFrame::OnQuit)
    command(ID_EXIT, () => onQuit(state));
    // EVT_MENU(wxID_OPEN, MyFrame::OnOpen)
    command(ID_OPEN, () => onOpen(state));

    // EVT_UPDATE_UI(wxID_ANY, MyFrame::OnUpdateUI)
    bindEvent(frame, state, ID_ANY, ID_ANY, EVT_UPDATE_UI, () =>
        onUpdateUI(state));

    // EVT_SPINCTRL(wxID_ANY, MyFrame::OnFrameSpin) — bound on the control,
    // exactly as the C++ constructor does.
    bindEvent(state.frameSpin, state, ID_ANY, ID_ANY, EVT_SPINCTRL, () =>
        onFrameSpin(state));

    // The C++ frame has no close handler; ending the loop here is the
    // kwxTypeScript equivalent of the frame being destroyed.
    bindEvent(frame, state, ID_ANY, ID_ANY, EVT_CLOSE_WINDOW, () =>
        exitMainLoop());
}

// ---------------------------------------------------------------------------
// MyFrame constructor (anitest.cpp:116-220)
// ---------------------------------------------------------------------------

function createAnimateFrame(): AnimateFrameState | null
{
    const title = createWxString("Animation Demo");
    const frame = createWxFrame(
        null, ID_ANY, title.ptr, -1, -1, -1, -1, DEFAULT_FRAME_STYLE,
    );
    title.Delete();
    if (!frame)
    {
        return null;
    }

    applyFrameIcon(frame);

    // -----------------------------------------------------------------
    // Make a menubar
    // -----------------------------------------------------------------
    const fileMenu = createPlainMenu();
    const playMenu = createPlainMenu();
    const helpMenu = createPlainMenu();
    if (!fileMenu || !playMenu || !helpMenu)
    {
        return null;
    }

    // file_menu->Append(wxID_OPEN, "&Open Animation...\tCtrl+O", ...)
    withString("&Open Animation...\tCtrl+O", (text) =>
        withString("Loads an animation", (help) =>
            fileMenu.Append(ID_OPEN, text, help, false)));

    // file_menu->Append(wxID_EXIT) — the empty label selects the stock "E&xit".
    withString("", (text) => fileMenu.Append(ID_EXIT, text, null, false));

    // play_menu->Append(ID_PLAY, "Play\tCtrl+P", ...)
    withString("Play\tCtrl+P", (text) =>
        withString("Play the animation", (help) =>
            playMenu.Append(ID_PLAY, text, help, false)));
    // play_menu->Append(wxID_STOP, "Stop\tCtrl+S", ...)
    withString("Stop\tCtrl+S", (text) =>
        withString("Stop the animation", (help) =>
            playMenu.Append(ID_STOP, text, help, false)));
    playMenu.AppendSeparator();
    // play_menu->Append(ID_SET_NULL_ANIMATION, ...)
    withString("Set null animation", (text) =>
        withString("Sets the empty animation in the control", (help) =>
            playMenu.Append(ID_SET_NULL_ANIMATION, text, help, false)));
    // play_menu->AppendCheckItem(ID_SET_INACTIVE_BITMAP, ...)
    withString("Set inactive bitmap", (text) =>
        withString("Sets an inactive bitmap for the control", (help) =>
            playMenu.AppendCheckItem(ID_SET_INACTIVE_BITMAP, text, help)));
    // play_menu->AppendCheckItem(ID_SET_NO_AUTO_RESIZE, ...)
    withString("Set no autoresize", (text) =>
        withString("Tells the control not to resize automatically", (help) =>
            playMenu.AppendCheckItem(ID_SET_NO_AUTO_RESIZE, text, help)));
    // play_menu->Append(ID_SET_BGCOLOR, ...)
    withString("Set background colour...", (text) =>
        withString("Sets the background colour of the control", (help) =>
            playMenu.Append(ID_SET_BGCOLOR, text, help, false)));

    // The "Use generic animation" separator + check item of the
    // wxHAS_NATIVE_ANIMATIONCTRL branch cannot be ported: no
    // wxGenericAnimationCtrl binding exists.

    // help_menu->Append(wxID_ABOUT) — stock "&About".
    withString("", (text) => helpMenu.Append(ID_ABOUT, text, null, false));

    const menuBar = createWxMenuBar(0);
    if (!menuBar)
    {
        return null;
    }

    withString("&File", (ptr) => { menuBar.Append(fileMenu.ptr, ptr); });
    withString("&Animation", (ptr) => { menuBar.Append(playMenu.ptr, ptr); });
    withString("&Help", (ptr) => { menuBar.Append(helpMenu.ptr, ptr); });

    // Associate the menu bar with this frame
    frame.SetMenuBar(menuBar.ptr);

    frame.CreateStatusBar(1, STB_DEFAULT_STYLE, ID_ANY);

    // use a wxBoxSizer otherwise wxFrame will automatically resize the
    // animation control to fill its client area on user resizes
    const sz = createWxBoxSizer(VERTICAL);
    if (!sz)
    {
        return null;
    }

    const caption = createLabel(frame.ptr, "wxAnimationCtrl:");
    if (caption)
    {
        addWindowWithFlags(sz, caption.ptr, 0, (f) => { f.Center(); f.Border(ALL); });
    }

    const animationCtrl = createWxAnimationCtrl(
        frame.ptr, ID_ANY, -1, -1, -1, -1, AC_DEFAULT_STYLE,
    );
    if (!animationCtrl)
    {
        return null;
    }

    // wxAnimationBundle with the 1x and 2x throbber, added only when valid.
    const animations: wxAnimation[] = [];
    const bundles: wxAnimationBundle[] = [];
    const bundle = createWxAnimationBundle();
    if (bundle)
    {
        const throbber = withString(assetPath("throbber.gif"), (ptr) =>
            createWxAnimationFromFile(ptr, ANIMATION_TYPE_ANY));
        if (throbber)
        {
            if (throbber.IsOk())
            {
                bundle.Add(throbber.ptr);
                animations.push(throbber);
            }
            else
            {
                throbber.Delete();
            }
        }

        const throbber2x = withString(assetPath("throbber_2x.gif"), (ptr) =>
            createWxAnimationFromFile(ptr, ANIMATION_TYPE_ANY));
        if (throbber2x)
        {
            if (throbber2x.IsOk())
            {
                bundle.Add(throbber2x.ptr);
                animations.push(throbber2x);
            }
            else
            {
                throbber2x.Delete();
            }
        }

        if (bundle.IsOk())
        {
            animationCtrl.SetAnimationBundle(bundle.ptr);
            animationCtrl.Play();
            bundles.push(bundle);
        }
        else
        {
            bundle.Delete();
        }
    }

    // sz->Add(m_animationCtrl, wxSizerFlags().Centre().Border())
    addWindowWithFlags(sz, animationCtrl.ptr, 0, (f) => { f.Center(); f.Border(ALL); });

    // add controls allowing to examine the individual animation frames
    const boxText = createWxString("Animation frames");
    const frameBox = createWxStaticBox(
        frame.ptr, ID_ANY, boxText.ptr, -1, -1, -1, -1, 0,
    );
    boxText.Delete();
    if (!frameBox)
    {
        return null;
    }

    const frameSizer = createWxStaticBoxSizer(frameBox.ptr, VERTICAL);
    if (!frameSizer)
    {
        return null;
    }

    const spinSizer = createWxBoxSizer(HORIZONTAL);
    if (!spinSizer)
    {
        return null;
    }

    const frameLabel = createLabel(frameBox.ptr, "&Frame:");
    if (frameLabel)
    {
        addWindowWithFlags(spinSizer, frameLabel.ptr, 0,
            (f) => { f.CenterVertical(); f.Border(RIGHT); });
    }

    const frameSpin = withString("", (ptr) => createWxSpinCtrl(
        frameBox.ptr, ID_ANY, ptr, -1, -1, -1, -1,
        BigInt(SP_ARROW_KEYS), 0, 100, 0,
    ));
    if (!frameSpin)
    {
        return null;
    }
    addWindowWithFlags(spinSizer, frameSpin.ptr, 0, (f) => { f.CenterVertical(); });

    const frameCount = createLabel(frameBox.ptr, "");
    if (!frameCount)
    {
        return null;
    }
    addWindowWithFlags(spinSizer, frameCount.ptr, 0,
        (f) => { f.CenterVertical(); f.Border(LEFT); });

    addSizerWithFlags(frameSizer, spinSizer.ptr, 0,
        (f) => { f.Center(); f.Border(ALL); });

    const frameDelay = createLabel(frameBox.ptr, "");
    if (!frameDelay)
    {
        return null;
    }
    addWindowWithFlags(frameSizer, frameDelay.ptr, 0,
        (f) => { f.Center(); f.Border(ALL); });

    // wxStaticBitmap(m_frameBox, wxID_ANY, wxBitmapBundle()) — the binding
    // takes a wxBitmap, and wxStaticBitmap copies it.
    const emptyBitmap = createWxBitmapDefault();
    if (!emptyBitmap)
    {
        return null;
    }
    const frameBitmap = createWxStaticBitmap(
        frameBox.ptr, ID_ANY, emptyBitmap.ptr, -1, -1, -1, -1, 0,
    );
    emptyBitmap.Delete();
    if (!frameBitmap)
    {
        return null;
    }
    addWindowWithFlags(frameSizer, frameBitmap.ptr, 0,
        (f) => { f.Center(); f.Border(ALL); });

    // sz->Add(frameSizer, wxSizerFlags().Expand().Border())
    addSizerWithFlags(sz, frameSizer.ptr, 0, (f) => { f.Expand(); f.Border(ALL); });

    frame.SetSizer(sz.ptr, true);

    const state: AnimateFrameState = {
        frame,
        menuBar,
        animationCtrl,
        frameBox,
        frameSpin,
        frameCount,
        frameDelay,
        frameBitmap,
        animations,
        bundles,
        bindings: [],
    };

    updateFrameControls(state);

    // SetSize(FromDIP(wxSize(500, 400))) — keep the current position.
    const pos = frame.GetPosition();
    frame.SetSize(
        pos ? pos.GetX() : -1,
        pos ? pos.GetY() : -1,
        frame.FromDIP(500),
        frame.FromDIP(400),
        0,
    );

    return state;
}

// ---------------------------------------------------------------------------
// MyApp::OnInit (anitest.cpp:98-109)
// ---------------------------------------------------------------------------

export function main(): number
{
    if (!initialize())
    {
        console.error("Failed to initialize wxWidgets");
        return 1;
    }

    setAppName("animate");

    const state = createAnimateFrame();
    if (!state)
    {
        shutdown();
        return 1;
    }

    bindFrameEvents(state);

    state.frame.Show();
    setTopWindow(state.frame.ptr);

    const exitCode = run();

    // Events can only fire while the loop runs, so the closures are released
    // now that it has returned.
    for (const binding of state.bindings)
    {
        binding.callback.close();
    }

    shutdown();
    return exitCode;
}

exit(main());
