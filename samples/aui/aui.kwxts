/** MyFrame::OnCreateSizeReport() */
function onCreateSizeReport(state: FrameState): void
{
    const report = createSizeReport(state, state.dip(80), state.dip(80));
    if (!report)
    {
        return;
    }

    const start = getStartPosition(state);
    addPane(state, report.ptr, null, "Client Size Reporter", (info) =>
    {
