// about.kwxts — kwxTypeScript port of wxSamples/src/html/about/about.cpp
//
// wxHtml sample: an About box showing an HTML page with a tiled SVG background.
//
// Run from the repository root:
//   bin\Release\kwxts.exe samples\about\about.kwxts
//
// The C++ sample keeps its page in data/ and loads "data/about.htm" relative to
// the current directory. Here the page is resolved against __dirname instead so
// the sample works from any working directory.

declare const __dirname: string;

import {
    ALIGN_RIGHT,
    ALL,
    BITMAP_TYPE_XPM,
    CAPTION,
    CLOSE_BOX,
    createWxBitmapBundleFromSVGBase64,
    createWxBoxSizer,
    createWxButton,
    createWxClosure,
    createWxDialog,
    createWxFrame,
    createWxHtmlWindow,
    createWxIconLoad,
    createWxMenu,
    createWxMenuBar,
    createWxStaticLine,
    createWxString,
    DEFAULT_FRAME_STYLE,
    EVT_CLOSE_WINDOW,
    EVT_MENU,
    EXPAND,
    exitMainLoop,
    HW_SCROLLBAR_NEVER,
    ID_ABOUT,
    ID_ANY,
    ID_EXIT,
    ID_OK,
    initAllImageHandlers,
    initialize,
    LEFT,
    lib,
    RIGHT,
    run,
    setAppName,
    setTopWindow,
    shutdown,
    SYSTEM_MENU,
    VERTICAL,
    wxClosure,
    wxFrame,
    wxHtmlCell,
} from "kwx";
import { Callback, exit, platform, pointerOf } from "kwx/platform";

// wxDEFAULT_DIALOG_STYLE (include/wx/dialog.h):
//   (wxCAPTION | wxSYSTEM_MENU | wxCLOSE_BOX)
const DEFAULT_DIALOG_STYLE = CAPTION | SYSTEM_MENU | CLOSE_BOX;

// data/bg.svg, gzip-compressed and then base64-encoded.
//
// The C++ sample uses
//   wxBitmapBundle::FromSVGFile("data/bg.svg", wxSize(65, 45))
// which is not bound. The bound factory wxBitmapBundle_CreateFromSVGBase64()
// base64-decodes its argument and then gunzips the result before calling
//   wxBitmapBundle::FromSVG(svgBytes, svgLen, wxSize(default_w, default_h))
// (kwxFFI src/kwx_image.cpp), so the payload has to be base64(gzip(bg.svg)).
// Same SVG byte stream, same default tile size of 65x45.
const BACKGROUND_SVG_GZIP_BASE64 =
    "";

/** Absolute path of an asset shipped next to this module. */
function samplePath(name: string): string
{
    return __dirname.replace(/\\/g, "/") + "/" + name;
}

/**
 * Mirrors wxSizerFlags::GetDefaultBorderFractional(): wxGTK uses the GNOME HIG
 * 6px unit, wxOSX uses 5px, and the other ports (wxMSW) scale 5px by the DPI of
 * the main top-level window. wxSizerFlags itself is not bound, so border
 * distances are computed here and passed to wxSizer::AddWindow().
 */
function defaultBorderFractional(mainWindow: wxFrame): number
{
    if (platform === "linux")
    {
        return 6;
    }
    if (platform === "darwin")
    {
        return 5;
    }
    return 5 * mainWindow.GetDPIScaleFactor();
}

/** MyFrame::OnAbout — the modal "About" dialog with its HTML window. */
function showAboutDialog(parent: wxFrame): void
{
    const dialogTitle = createWxString("About");
    const dialog = createWxDialog(
        parent.ptr,
        ID_ANY,
        dialogTitle.ptr,
        -1,
        -1,
        -1,
        -1,
        DEFAULT_DIALOG_STYLE,
    );
    dialogTitle.Delete();

    if (!dialog)
    {
        console.error("about: failed to create the About dialog");
        return;
    }

    const topSizer = createWxBoxSizer(VERTICAL);
    if (!topSizer)
    {
        console.error("about: failed to create the dialog sizer");
        dialog.Destroy();
        return;
    }

    const htmlName = createWxString("htmlWindow");
    const html = createWxHtmlWindow(
        dialog.ptr,
        ID_ANY,
        -1,
        -1,
        380,
        160,
        BigInt(HW_SCROLLBAR_NEVER),
        htmlName.ptr,
    );
    htmlName.Delete();

    if (!html)
    {
        console.error("about: failed to create wxHtmlWindow");
        dialog.Destroy();
        return;
    }

    html.SetBorders(0);

    const pageLocation = createWxString(samplePath("data/about.htm"));
    const loaded = html.LoadPage(pageLocation.ptr);
    pageLocation.Delete();
    if (!loaded)
    {
        console.error("about: failed to load data/about.htm");
    }

    // html->SetHTMLBackgroundImage(wxBitmapBundle::FromSVGFile("data/bg.svg",
    //                                                         wxSize(65, 45)))
    // The bound native helper base64-decodes and then gunzips the payload, so it
    // is fed base64(gzip(bg.svg)) with the exact base64 length (strict decode).
    const encodedBackground = new TextEncoder().encode(BACKGROUND_SVG_GZIP_BASE64);
    const background = createWxBitmapBundleFromSVGBase64(
        pointerOf(encodedBackground),
        BigInt(encodedBackground.length),
        65,
        45,
    );
    if (background)
    {
        // wxHtmlWindow::SetBackgroundImage copies the bundle.
        html.SetBackgroundImage(background.ptr);
        background.Delete();
    }
    else
    {
        console.error("about: failed to build the SVG background bundle");
    }

    const representation = html.GetInternalRepresentation();
    if (representation)
    {
        // Borrowed pointer: the wxHtmlWindow owns this wxHtmlContainerCell.
        const rootCell = new wxHtmlCell(representation);
        html.SetInitialSize(rootCell.GetWidth(), rootCell.GetHeight());
    }

    // wxSizerFlags(1).DoubleBorder()
    const borderUnit = defaultBorderFractional(parent);
    const doubleBorder = Math.round(2 * borderUnit);
    const tripleBorder = Math.round(3 * borderUnit);

    topSizer.AddWindow(html.ptr, 1, ALL, doubleBorder, null);

    // wxSizerFlags().Expand().DoubleHorzBorder()
    const separator = createWxStaticLine(dialog.ptr, ID_ANY, -1, -1, -1, -1, 0);
    if (separator)
    {
        topSizer.AddWindow(separator.ptr, 0, EXPAND | LEFT | RIGHT, doubleBorder, null);
    }

    // wxSizerFlags().Right().TripleBorder()
    const okLabel = createWxString("OK");
    const okButton = createWxButton(dialog.ptr, ID_OK, okLabel.ptr, -1, -1, -1, -1, 0);
    okLabel.Delete();
    if (okButton)
    {
        okButton.SetDefault();
        topSizer.AddWindow(okButton.ptr, 0, ALIGN_RIGHT | ALL, tripleBorder, null);
    }

    dialog.SetSizer(topSizer.ptr, false);
    topSizer.Fit(dialog.ptr);

    dialog.ShowModal();
    dialog.Destroy();
}

/** MyFrame constructor — frame, icon and the File menu. */
function createAboutFrame(): wxFrame | null
{
    const frameTitle = createWxString("wxHtmlWindow testing application");
    const frame = createWxFrame(
        null,
        ID_ANY,
        frameTitle.ptr,
        -1,
        -1,
        -1,
        -1,
        DEFAULT_FRAME_STYLE,
    );
    frameTitle.Delete();

    if (!frame)
    {
        return null;
    }

    // SetIcon(wxICON(sample)) — the C++ sample compiles ../../sample.xpm in as a
    // resource. kwxTypeScript programs have no XPM resources, so the same XPM
    // file is loaded at run time through wxIcon::Load(..., wxBITMAP_TYPE_XPM).
    const iconPath = createWxString(samplePath("sample.xpm"));
    const icon = createWxIconLoad(iconPath.ptr, BigInt(BITMAP_TYPE_XPM), -1, -1);
    iconPath.Delete();
    if (icon)
    {
        if (icon.IsOk())
        {
            // wxTopLevelWindow::SetIcon copies the icon.
            frame.SetIcon(icon.ptr);
        }
        icon.Delete();
    }

    // create a menu bar: File -> About / Exit (stock labels, empty strings)
    const menuTitle = createWxString("");
    const fileMenu = createWxMenu(menuTitle.ptr, 0n);
    menuTitle.Delete();

    if (fileMenu)
    {
        const emptyLabel = createWxString("");
        const emptyHelp = createWxString("");
        fileMenu.Append(ID_ABOUT, emptyLabel.ptr, emptyHelp.ptr, false);
        fileMenu.Append(ID_EXIT, emptyLabel.ptr, emptyHelp.ptr, false);
        emptyLabel.Delete();
        emptyHelp.Delete();

        const menuBarTitle = createWxString("&File");
        const menuBar = createWxMenuBar(0);
        if (menuBar)
        {
            menuBar.Append(fileMenu.ptr, menuBarTitle.ptr);
            frame.SetMenuBar(menuBar.ptr);
        }
        menuBarTitle.Delete();
    }

    return frame;
}

interface AboutEventBindings
{
    aboutCallback: Callback;
    aboutClosure: wxClosure;
    quitCallback: Callback;
    quitClosure: wxClosure;
    closeCallback: Callback;
    closeClosure: wxClosure;
}

/** MyFrame's event table: EVT_MENU(wxID_ABOUT), EVT_MENU(wxID_EXIT), close. */
function connectAboutEvents(frame: wxFrame): AboutEventBindings
{
    const aboutCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            showAboutDialog(frame);
        },
    );
    const aboutClosure = createWxClosure(aboutCallback.pointer, null)!;
    lib.symbols.wxEvtHandler_Connect(
        frame.ptr,
        ID_ABOUT,
        ID_ABOUT,
        EVT_MENU,
        aboutClosure.ptr,
    );

    const quitCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            // MyFrame::OnQuit: Close(true)
            frame.Close(true);
        },
    );
    const quitClosure = createWxClosure(quitCallback.pointer, null)!;
    lib.symbols.wxEvtHandler_Connect(
        frame.ptr,
        ID_EXIT,
        ID_EXIT,
        EVT_MENU,
        quitClosure.ptr,
    );

    const closeCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            exitMainLoop();
        },
    );
    const closeClosure = createWxClosure(closeCallback.pointer, null)!;
    lib.symbols.wxEvtHandler_Connect(
        frame.ptr,
        ID_ANY,
        ID_ANY,
        EVT_CLOSE_WINDOW,
        closeClosure.ptr,
    );

    return {
        aboutCallback,
        aboutClosure,
        quitCallback,
        quitClosure,
        closeCallback,
        closeClosure,
    };
}

export function main(): number
{
    if (!initialize())
    {
        console.error("Failed to initialize wxWidgets");
        return 1;
    }

    setAppName("about");

    // MyApp::OnInit(): wxImage::AddHandler(new wxPNGHandler)
    // wxPNGHandler is not bound; initAllImageHandlers() registers the PNG (and
    // XPM) handlers the page and icon need.
    initAllImageHandlers();

    const frame = createAboutFrame();
    if (!frame)
    {
        console.error("about: failed to create the main frame");
        shutdown();
        return 1;
    }

    const bindings = connectAboutEvents(frame);

    frame.Show();
    setTopWindow(frame.ptr);

    const exitCode = run();

    bindings.aboutCallback.close();
    bindings.quitCallback.close();
    bindings.closeCallback.close();
    shutdown();
    return exitCode;
}

exit(main());
