//   Menu_Menu_*               = 300..
//   Menu_Test_*               = 400..
//   Menu_SubMenu(_*)          = 450..
//   Menu_Dummy_*              = 500..504
//   Menu_Help_About           = wxID_ABOUT
//   Menu_Popup_*              = 2000..
// ---------------------------------------------------------------------------

const Menu_File_Quit = ID_EXIT;
const Menu_File_ClearLog = 100;
const Menu_File_ShowDialog = 101;

const Menu_MenuBar_Toggle = 200;
const Menu_MenuBar_Append = 201;
const Menu_MenuBar_Insert = 202;
