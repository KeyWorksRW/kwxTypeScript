{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 30,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "ninja-clang",
            "displayName": "Ninja Multi-Config (Clang)",
            "description": "Build using Clang toolchain with Ninja Multi-Config generator",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_RC_COMPILER": "llvm-rc"
            }
        },
        {
            "name": "ninja-multi",
            "displayName": "Ninja Multi-Config",
            "description": "Default build using Ninja Multi-Config generator",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build"
        },
        {
            "name": "macos-universal",
            "displayName": "macOS Universal (x86_64 + arm64)",
            "description": "Build a macOS Universal binary with Ninja Multi-Config",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build-macos",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "release",
            "displayName": "Release (kwx_ts)",
            "description": "Builds the Release kwx_ts executable, regenerating the embedded bundle from wx/ and src/",
            "configurePreset": "ninja-multi",
            "configuration": "Release",
            "targets": ["kwx_ts"]
        },
        {
            "name": "debug",
            "displayName": "Debug (kwx_ts)",
            "configurePreset": "ninja-multi",
            "configuration": "Debug",
            "targets": ["kwx_ts"]
        }
    ]
}
