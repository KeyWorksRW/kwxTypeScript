function numericEntry(): void
{
    const current = state;
    if (!current) return;

    const result = withStrings([
        "This is some text, actually a lot of text.\nEven two rows of text.",
        "Enter a number:",
        "Numeric input test",
    ], (ptrs) => wxGetNumberFromUser(
        ptrs[0], ptrs[1], ptrs[2], 50n, 0n, 100n, current.frame.ptr, -1, -1));

    if (result === -1n)
    {
        messageBox("Invalid number entered or dialog cancelled.",
            "Numeric test result", OK | ICON_ERROR, current.frame.ptr);
    }
    else
    {
        messageBox(`You've entered ${result}`, "Numeric test result",
            OK | ICON_INFORMATION, current.frame.ptr);
    }
}

//-----------------------------------------------------------------------------
// Informative dialogs
//-----------------------------------------------------------------------------

function logDialog(): void
{
    {
        const busy = createWxBusyCursor();
        withString("This is some message - everything is ok so far.",
            (ptr) => LogMessage(ptr));
        withString("Another message...\n... this one is on multiple lines",
            (ptr) => LogMessage(ptr));
        withString("And then something went wrong!", (ptr) => LogWarning(ptr));
        wxYield();
        if (busy) busy.Delete();
    }

    withString("Intermediary error handler decided to abort.",
        (ptr) => LogError(ptr));
    withString("The top level caller detected an unrecoverable error.",
        (ptr) => LogError(ptr));

    const target = wxLog_GetActiveTarget();
    if (target) wrapWxLog(target).FlushActive();

    withString("And this is the same dialog but with only one message.",
        (ptr) => LogMessage(ptr));
}

function infoBarSimple(): void
{
    const current = state;
    if (!current) return;

    if (infoBarDontShowAgain)
    {
        messageBox("You asked to not see this again. Remember?", "",
            OK, current.frame.ptr);
        return;
    }

    infoBarCount += 1;
    let message: string;
    if (infoBarCount % 2)
    {
        message = `Short message #${infoBarCount} in the info bar.`;
    }
    else
    {
        message = `A very, very, very, very long message #${infoBarCount} showing what ` +
            "happens when a message is too long to fit in the info bar and has to be " +
            "either wrapped or ellipsized because it's just too long to fit in the " +
            "available space (unless you have a humongously wide monitor, in which case, " +
            "congratulations, you've managed to break this test).";
    }

    withString("Do not show this again",
        (ptr) => current.infoBarSimple.ShowCheckBox(ptr, false));
    withString(message, (ptr) => current.infoBarSimple.ShowMessage(ptr, 0));
}

function infoBarAdvanced(): void
{
    const current = state;
    if (!current) return;
    withString("Sorry, it didn't work out.", (ptr) =>
        current.infoBarAdvanced.ShowMessageFor(ptr, InfoBar_Timeout_Auto, ICON_WARNING));
}

function onInfoBarButton(tag: number): void
{
    const current = state;
    if (!current) return;

    if (tag === 1)
    {
        current.infoBarSimple.Dismiss();
        if (current.infoBarSimple.IsCheckBoxChecked())
        {
            infoBarDontShowAgain = true;
        }
    }
    else
    {
        withString("Still no, sorry again.", (ptr) =>
            current.infoBarAdvanced.ShowMessage(ptr, ICON_ERROR));
    }
}

//-----------------------------------------------------------------------------
// Generic dialogs
//-----------------------------------------------------------------------------

function centredDialog(onScreen: boolean): void
{
    const current = state;
    if (!current) return;

    const title = onScreen
        ? "Dialog centered on screen" : "Dialog centered on parent";
    const dialog = withString(title, (text) => createWxDialog(
        current.frame.ptr, ID_ANY, text, -1, -1, 200, 100, DEFAULT_DIALOG_STYLE));
    if (!dialog) return;

    const button = withString("Close", (text) =>
        createWxButtonLocal(dialog.ptr, ID_OK, text));
    if (button) wrapWxWindow(button).Centre(BOTH);

    if (onScreen) dialog.CentreOnScreen(BOTH);
    else dialog.CentreOnParent(BOTH);

    dialog.ShowModal();
    dialog.Destroy();
}

function onTopDialog(): void
{
    const current = state;
    if (!current) return;

    const dialog = withString("Dialog staying on top of other windows", (text) =>
        createWxDialog(current.frame.ptr, ID_ANY, text, -1, -1, 300, 100,
            DEFAULT_DIALOG_STYLE | STAY_ON_TOP));
    if (!dialog) return;

    const button = withString("Close", (text) =>
        createWxButtonLocal(dialog.ptr, ID_OK, text));
    if (button) wrapWxWindow(button).Centre(BOTH);

    dialog.ShowModal();
    dialog.Destroy();
}

function miniFrame(): void
{
    const current = state;
    if (!current) return;

    const frame = withString("Mini frame", (text) => createWxMiniFrame(
        current.frame.ptr, ID_ANY, text, -1, -1, -1, -1, CAPTION | CLOSE_BOX));
    if (!frame) return;

    const sizer = createWxBoxSizer(VERTICAL)!;
    const line1 = withString("Mini frames have slightly different appearance",
        (text) => createWxStaticText(frame.ptr, ID_ANY, text, -1, -1, -1, -1, 0));
    const line2 = withString("from the normal frames but that's the only difference.",
        (text) => createWxStaticText(frame.ptr, ID_ANY, text, -1, -1, -1, -1, 0));
    if (line1) addWin(sizer, line1.ptr, 0, (f) => { f.Border(ALL); });
    if (line2) addWin(sizer, line2.ptr, 0, (f) => { f.Border(ALL); });
    frame.SetSizer(sizer.ptr, true);

    const best = frame.GetBestSize();
    if (best)
    {
        frame.SetSize(-1, -1, best.GetWidth(), best.GetHeight(), 0);
    }

    frame.CentreOnParent(BOTH);
    frame.Show();
}

//-----------------------------------------------------------------------------
// Progress, app progress, busy info
//-----------------------------------------------------------------------------

function doShowProgress(
    dialog: wxProgressDialog | wxGenericProgressDialog,
    generic: boolean): void
{
    let cont = true;
    const skipBuffer = new Int32Array(1);
    const skipPtr = pointerOf(skipBuffer);

    for (let i = 0; i <= PROGRESS_MAX; i++)
    {
        let message: string;
        const determinate = i > PROGRESS_MAX / 2;

        if (i === PROGRESS_MAX)
        {
            message = "That's all, folks!\n\nNothing to see here any more.";
        }
        else if (!determinate)
        {
            message = "Testing indeterminate mode\n\n" +
                "This mode allows you to show to the user\n" +
                "that something is going on even if you don't know\n" +
                "when exactly will you finish.";
        }
        else
        {
            message = "Now in standard determinate mode\n\n" +
                "This is the standard usage mode in which you\n" +
                "update the dialog after performing each new step of work.\n" +
                "It requires knowing the total number of steps in advance.";
        }

        skipBuffer[0] = 0;
        if (determinate)
        {
            cont = generic
                ? withString(message, (ptr) =>
                    (dialog as wxGenericProgressDialog).Update(i, ptr, skipPtr))
                : withString(message, (ptr) =>
                    (dialog as wxProgressDialog).UpdateWithSkip(i, ptr, skipPtr));
        }
        else
        {
            cont = withString(message, (ptr) => dialog.Pulse(ptr, skipPtr));
        }

        if (skipBuffer[0] !== 0)
        {
            i += Math.floor(PROGRESS_MAX / 4);
            if (i >= PROGRESS_MAX) i = PROGRESS_MAX - 1;
        }

        if (!cont)
        {
            const answer = messageBox("Do you really want to cancel?",
                "Progress dialog question", YES_NO | ICON_QUESTION, null);
            if (answer === ID_YES) break;

            cont = true;
            dialog.Resume();
        }

        wxMilliSleep(100n);
    }

    if (!cont)
    {
        withString("Progress dialog aborted!", (ptr) => LogStatus(ptr));
    }
    else
    {
        withString(`Countdown from ${PROGRESS_MAX} finished`, (ptr) => LogStatus(ptr));
    }
}

function showProgress(generic: boolean): void
{
    const current = state;
    if (!current) return;

    const message = " ".repeat(100) + "\n\n\n\n";
    const style = PD_CAN_ABORT | PD_CAN_SKIP | PD_APP_MODAL |
        PD_ELAPSED_TIME | PD_ESTIMATED_TIME | PD_REMAINING_TIME | PD_SMOOTH;

    if (generic)
    {
        const dialog = withStrings(["Generic progress dialog example", message],
            (ptrs) => createWxGenericProgressDialog(
                ptrs[0], ptrs[1], PROGRESS_MAX, current.frame.ptr, style));
        if (!dialog) return;
        doShowProgress(dialog, true);
        dialog.Destroy();
    }
    else
    {
        const dialog = withStrings(["Progress dialog example", message],
            (ptrs) => createWxProgressDialog(
                ptrs[0], ptrs[1], PROGRESS_MAX, current.frame.ptr, style));
        if (!dialog) return;
        doShowProgress(dialog, false);
        dialog.Destroy();
    }
}

function showAppProgress(): void
{
    const current = state;
    if (!current) return;

    const progress = createWxAppProgressIndicator(current.frame.ptr, 100);
    if (!progress) return;

    if (!progress.IsAvailable())
    {
        withString("Progress indicator not available under this platform.",
            (ptr) => LogStatus(ptr));
        progress.Delete();
        return;
    }

    withString("Using application progress indicator...", (ptr) => LogStatus(ptr));

    const range = 10;
    progress.SetRange(range);
    for (let i = 0; i < range; i++)
    {
        progress.SetValue(i);
        wxMilliSleep(200n);
    }

    withString("Progress finished", (ptr) => LogStatus(ptr));
    progress.Delete();
}

function showBusyInfo(rich: boolean): void
{
    const current = state;
    if (!current) return;

    const disablerPtr = createWxWindowDisabler(null);
    const disabler = disablerPtr ? new wxWindowDisabler(disablerPtr) : null;

    if (!rich)
    {
        const info = withString("Working, please wait...", (text) =>
            createWxBusyInfo(text, current.frame.ptr));

        for (let i = 0; i < 18; i++)
        {
            wxMilliSleep(100n);
            wxYield();
        }
        wxSleep(2);

        if (info) info.Delete();
    }
    else
    {
        const flags = createWxBusyInfoFlags();
        if (flags)
        {
            flags.SetParent(current.frame.ptr);
            const bundle = wxArtProvider_GetBitmapBundle(ART_PRINT, ART_OTHER, 128, 128);
            if (bundle)
            {
                flags.SetIcon(bundle.ptr);
                bundle.Delete();
            }
            withString("<b>Printing your document</b>", (ptr) => flags.SetTitle(ptr));
            withString("Please wait...", (ptr) => flags.SetText(ptr));
            flags.SetForeground(WHITE);
            flags.SetBackground(BLACK);
            flags.SetTransparency(4 * ALPHA_OPAQUE / 5);

            const info = createWxBusyInfoWithFlags(flags.ptr);
            for (let i = 0; i < 20; i++)
            {
                wxYield();
                wxMilliSleep(250n);
            }
            if (info) info.Delete();
            flags.Delete();
        }
    }

    if (disabler) disabler.Delete();
}

//-----------------------------------------------------------------------------
// About dialogs
//-----------------------------------------------------------------------------

function aboutVersion(): { version: string; longVersion: string }
{
    const version = readWxString(VERSION_NUM_DOT_STRING);
    const channel = MINOR_VERSION % 2 ? "Development" : "Stable";
    return { version, longVersion: `${channel} version ${version}` };
}

function initAboutInfoMinimal(info: wxAboutDialogInfo): void
{
    const version = aboutVersion();
    withString("Dialogs Sample", (ptr) => info.SetName(ptr));
    withStrings([version.version, version.longVersion],
        (ptrs) => info.SetVersion(ptrs[0], ptrs[1]));
    withString("This sample shows different wxWidgets dialogs.",
        (ptr) => info.SetDescription(ptr));
    withString("Copyright (C) 1992-2026 wxWidgets dev team.",
        (ptr) => info.SetCopyright(ptr));
}

function initAboutInfoWebsite(info: wxAboutDialogInfo): void
{
    initAboutInfoMinimal(info);
    withStrings(["http://www.wxwidgets.org/", "wxWidgets web site"],
        (ptrs) => info.SetWebSite(ptrs[0], ptrs[1]));
}

function initAboutInfoAll(info: wxAboutDialogInfo): void
{
    initAboutInfoWebsite(info);

    withString("Vadim Zeitlin", (ptr) => info.AddDeveloper(ptr));
    withString("A.N. Other", (ptr) => info.AddDeveloper(ptr));

    const writers = createArrayString(["First D. Writer", "Second One"]);
    if (writers)
    {
        info.SetDocWriters(writers.ptr);
        writers.Delete();
    }

    withString(
        "                wxWindows Library Licence, Version 3.1\n" +
        "                ======================================\n" +
        "\n" +
        "  Copyright (c) 1998-2018 Julian Smart, Robert Roebling et al\n" +
        "\n" +
        "  Everyone is permitted to copy and distribute verbatim copies\n" +
        "  of this licence document, but changing it is not allowed.\n" +
        "\n" +
        "                       WXWINDOWS LIBRARY LICENCE\n" +
        "     TERMS AND CONDITIONS FOR COPYING, DISTRIBUTION AND MODIFICATION\n" +
        "\n" +
        "                    ...and so on and so forth...\n",
        (ptr) => info.SetLicence(ptr));

    withString("Wun Ngo Wen (Martian)", (ptr) => info.AddTranslator(ptr));
}

function showAboutDialog(which: number): void
{
    const current = state;
    if (!current) return;

    const infoPtr = createWxAboutDialogInfo();
    if (!infoPtr) return;
    const info = new wxAboutDialogInfo(infoPtr);
    if (!info) return;

    switch (which)
    {
        case 0: initAboutInfoMinimal(info); break;
        case 1: initAboutInfoWebsite(info); break;
        default: initAboutInfoAll(info); break;
    }

    if (which === 3)
    {
        const dialog = createWxGenericAboutDialog(info.ptr, current.frame.ptr);
        if (dialog)
        {
            const parent = dialog.GetCustomControlParent();
            const parentPtr = parent ? parent.ptr : null;
            const line1 = createWxStaticLine(parentPtr, ID_ANY, -1, -1, -1, -1, 0);
            if (line1) dialog.AddControl(line1.ptr);
            withString("Some custom text", (ptr) => dialog.AddText(ptr));
            const line2 = createWxStaticLine(parentPtr, ID_ANY, -1, -1, -1, -1, 0);
            if (line2) dialog.AddControl(line2.ptr);
            dialog.ShowModal();
            dialog.Destroy();
        }
    }
    else
    {
        wxAboutBox(info.ptr, current.frame.ptr);
    }

    info.Delete();
}

//-----------------------------------------------------------------------------
// Tips
//-----------------------------------------------------------------------------

function showTip(): void
{
    const current = state;
    if (!current) return;

    // C++ keeps the last tip index in a function-local static.
    if (tipIndex < 0) tipIndex = Math.floor(Math.random() * 5);

    const providerPtr = withString(assetPath("tips.txt"),
        (ptr) => wxCreateFileTipProvider(ptr, tipIndex));
    if (!providerPtr) return;

    const provider = new wxTipProvider(providerPtr);
    const showAtStartup = wxShowTip(current.frame.ptr, provider.ptr);

    if (showAtStartup)
    {
        messageBox("Will show tips on startup", "Tips dialog",
            OK | ICON_INFORMATION, current.frame.ptr);
    }

    tipIndex = provider.GetCurrentTip();
    provider.Delete();
}

function toggleTipWindow(): void
{
    const current = state;
    if (!current) return;

    if (current.tipWindowRef && current.tipWindowRef[0] !== 0n)
    {
        wrapWxTipWindow(current.tipWindowRef[0]).CloseTip();
        current.tipWindowRef[0] = 0n;
    }
    else
    {
        const text = "This is just some text to be shown in the tip window, " +
            "broken into multiple lines, each less than 60 logical pixels wide.";
        const tip = withString(text, (ptr) => createWxTipWindow(
            current.frame.ptr, ptr, current.frame.FromDIP(60)));
        if (!tip) return;

        // wxTipWindow::Ref clears the pointer from its destructor; mirror it so
        // the menu check state follows a tip that closes itself.
        if (!current.tipWindowRef)
        {
            current.tipWindowRef = new BigUint64Array(1);
        }
        current.tipWindowRef[0] = tip.ptr === null ? 0n : tip.ptr;
        tip.SetTipWindowPtr(pointerOf(current.tipWindowRef));
    }
}

//-----------------------------------------------------------------------------
// Modal hook / unsaved state
//-----------------------------------------------------------------------------

/** wxDialog::GetClassInfo()->GetClassName() for the modal-hook messages. */
function dialogClassName(dialogPtr: Pointer): string
{
    const info = wrapWxWindow(dialogPtr).GetClassInfo();
    if (!info) return "wxDialog";
    return takeText(info.GetClassNameEx());
}

function toggleModalHook(enabled: boolean): void
{
    const current = state;
    if (!current) return;

    if (!current.modalHook)
    {
        const hookPtr = createKwxModalDialogHook(null);
        if (!hookPtr) return;
        const hook = wrapWxModalDialogHook(hookPtr);
        current.modalHook = hook;

        // CaptureEnterDialog() makes Enter() invoke the callback for its side
        // effects and return wxID_NONE, so a void thunk can drive the hook.
        const enterCallback = new Callback(
            { parameters: ["pointer", "pointer", "pointer"], result: "void" },
            (_fun, dialogPtr) =>
            {
                if (!dialogPtr) return;
                withString(`Showing ${dialogClassName(dialogPtr)} modal dialog`,
                    (ptr) => LogStatus(ptr));
            });
        const exitCallback = new Callback(
            { parameters: ["pointer", "pointer", "pointer"], result: "void" },
            (_fun, dialogPtr) =>
            {
                if (!dialogPtr) return;
                withString(`Leaving ${dialogClassName(dialogPtr)} modal dialog`,
                    (ptr) => LogStatus(ptr));
            });
        modalHookCallbacks.push(enterCallback, exitCallback);
        hook.SetOnEnter(enterCallback.pointer);
        hook.SetOnExit(exitCallback.pointer);
        hook.CaptureEnterDialog(true);
    }

    if (enabled) current.modalHook.Register();
    else current.modalHook.Unregister();
}

//-----------------------------------------------------------------------------
// Find / replace
//-----------------------------------------------------------------------------

function decodeFindFlags(flags: number): string
{
    return `${flags & FR_DOWN ? "down" : "up"}, ` +
        `${flags & FR_WHOLEWORD ? "whole words only, " : ""}` +
        `${flags & FR_MATCHCASE ? "" : "not "}case sensitive`;
}

function showFindOrReplace(replace: boolean): void
{
    const current = state;
    if (!current || !current.findData) return;

    const existing = replace ? current.dlgReplace : current.dlgFind;
    if (existing)
    {
        existing.Destroy();
        if (replace) current.dlgReplace = null;
        else current.dlgFind = null;
        return;
    }

    const style = replace ? FR_REPLACEDIALOG : FR_NOWHOLEWORD;
    const dialog = withString(replace ? "Find and replace dialog" : "Find dialog",
        (title) => createWxFindReplaceDialog(
            current.frame.ptr, current.findData!.ptr, title, style));
    if (!dialog) return;

    if (replace) current.dlgReplace = dialog;
    else current.dlgFind = dialog;

    dialog.Show();
}

function onFindEvent(tag: number, eventPtr: Pointer): void
{
    const current = state;
    if (!current) return;

    const event = new wxFindDialogEvent(eventPtr);

    if (tag === 5)
    {
        // wxEVT_FIND_CLOSE
        const dialog = event.GetDialog();
        const dialogPtr = dialog ? dialog.ptr : null;
        let title = "Unknown";
        let idMenu = ID_ANY;

        if (current.dlgFind && current.dlgFind.ptr === dialogPtr)
        {
            title = "Find";
            idMenu = DIALOGS_FIND;
            current.dlgFind = null;
        }
        else if (current.dlgReplace && current.dlgReplace.ptr === dialogPtr)
        {
            title = "Replace";
            idMenu = DIALOGS_REPLACE;
            current.dlgReplace = null;
        }

        withString(`${title} dialog is being closed.`, (ptr) => LogMessage(ptr));

        if (idMenu !== ID_ANY) current.menuBar.Check(idMenu, false);

        if (dialog) dialog.Destroy();
        return;
    }

    const findString = takeText(event.GetFindString());
    const replaceString = takeText(event.GetReplaceString());
    const flags = decodeFindFlags(event.GetFlags());

    if (tag === 1 || tag === 2)
    {
        const prefix = tag === 2 ? "next " : "";
        withString(`Find ${prefix}'${findString}' (flags: ${flags})`,
            (ptr) => LogMessage(ptr));
    }
    else if (tag === 3 || tag === 4)
    {
        const prefix = tag === 4 ? "all " : "";
        withString(`Replace ${prefix}'${findString}' with '${replaceString}' (flags: ${flags})`,
            (ptr) => LogMessage(ptr));
    }
    else
    {
        withString("Unknown find dialog event!", (ptr) => LogError(ptr));
    }
}

//-----------------------------------------------------------------------------
// Canvas
//-----------------------------------------------------------------------------

function canvasPaint(): void
{
    const current = state;
    if (!current) return;

    const dc = createWxPaintDC(current.canvas.ptr);
    if (!dc) return;

    const colour = createWxColourEmpty();
    if (!colour)
    {
        dc.Delete();
        return;
    }

    if (current.canvas.UseBackgroundColour())
    {
        current.canvas.GetBackgroundColour(colour.ptr);
    }
    else
    {
        wxSystemSettings_GetColour(SYS_COLOUR_WINDOW, colour.ptr);
    }

    const brush = createWxBrushFromColour(colour.ptr, BRUSHSTYLE_SOLID);
    if (brush)
    {
        dc.SetBackground(brush.ptr);
        dc.Clear();
        brush.Delete();
    }
    dc.SetBackgroundMode(BRUSHSTYLE_TRANSPARENT);
    withString("wxWidgets common dialogs test application",
        (ptr) => dc.DrawText(ptr, 10, 10));

    colour.Delete();
    dc.Delete();
}

//-----------------------------------------------------------------------------
// Message box menu entries
//-----------------------------------------------------------------------------

function showMessageBox(): void
{
    const current = state;
    if (!current) return;

    const dialog = withStrings([
        "This is a message box\nThis is a long, long string to test out if the " +
        "message box is laid out properly.",
        "Message box text",
    ], (ptrs) => createWxMessageDialog(current.frame.ptr, ptrs[0], ptrs[1],
        CENTRE | NO_DEFAULT | YES_NO | CANCEL | ICON_INFORMATION));
    if (!dialog) return;

    const supported = withStrings([
        "Answer &Yes", "Answer &No", "Refuse to answer",
    ], (ptrs) => dialog.SetYesNoCancelLabels(ptrs[0], ptrs[1], ptrs[2]));

    const extended = supported
        ? "This platform supports custom button labels,\n" +
          "so you should see the descriptive labels below."
        : "Custom button labels are not supported on this platform,\n" +
          "so the default \"Yes\"/\"No\"/\"Cancel\" buttons are used.";
    withString(extended, (ptr) => dialog.SetExtendedMessage(ptr));

    handleMessageResult(dialog.ShowModal());
    dialog.Destroy();
}

function handleMessageResult(result: number): void
{
    switch (result)
    {
        case ID_YES:
            withString("You pressed \"Yes\"", (ptr) => LogStatus(ptr));
            break;
        case ID_NO:
            withString("You pressed \"No\"", (ptr) => LogStatus(ptr));
            break;
        case ID_CANCEL:
            withString("You pressed \"Cancel\"", (ptr) => LogStatus(ptr));
            break;
        default:
            withString("Unexpected wxMessageDialog return code!",
                (ptr) => LogError(ptr));
    }
}

function showMessageBoxWindowModal(): void
{
    const current = state;
    if (!current) return;

    const dialog = withStrings([
        "This is a message box\nThis is a long, long string to test out if the " +
        "message box is laid out properly.",
        "Message box text",
    ], (ptrs) => createWxMessageDialog(current.frame.ptr, ptrs[0], ptrs[1],
        CENTRE | NO_DEFAULT | YES_NO | CANCEL | ICON_INFORMATION));
    if (!dialog) return;

    const supported = withStrings([
        "Answer &Yes", "Answer &No", "Refuse to answer",
    ], (ptrs) => dialog.SetYesNoCancelLabels(ptrs[0], ptrs[1], ptrs[2]));

    const extended = supported
        ? "This platform supports custom button labels,\n" +
          "so you should see the descriptive labels below."
        : "Custom button labels are not supported on this platform,\n" +
          "so the default \"Yes\"/\"No\"/\"Cancel\" buttons are used.";
    withString(extended, (ptr) => dialog.SetExtendedMessage(ptr));

    modalDialogs.push(dialog);
    windowModalEvents().connect(
        dialog.ptr, ID_ANY, ID_ANY, EVT_WINDOW_MODAL_DIALOG_CLOSED, TAG_MESSAGE_BOX);
    dialog.ShowWindowModal();
}

//-----------------------------------------------------------------------------
// Menu dispatch
//-----------------------------------------------------------------------------

function handleMenuId(id: number): void
{
    const current = state;
    if (!current) return;

    switch (id)
    {
        case DIALOGS_MESSAGE_BOX: showMessageBox(); break;
        case DIALOGS_MESSAGE_BOX_WINDOW_MODAL: showMessageBoxWindowModal(); break;
        case DIALOGS_MESSAGE_DIALOG: showTestMessageBoxDialog(current.frame.ptr, false); break;
        case DIALOGS_MESSAGE_DIALOG_WINDOW_MODAL:
            showTestMessageBoxDialog(current.frame.ptr, false, true);
            break;
        case DIALOGS_RICH_MESSAGE_DIALOG:
            showTestMessageBoxDialog(current.frame.ptr, true, false);
            break;
        case DIALOGS_MESSAGE_BOX_WXINFO: wxInfoMessageBox(current.frame.ptr); break;

        case DIALOGS_CHOOSE_COLOUR: chooseColour(false); break;
        case DIALOGS_CHOOSE_COLOUR_ALPHA: chooseColour(true); break;
        case DIALOGS_CHOOSE_COLOUR_GENERIC: chooseColourGeneric(false); break;
        case DIALOGS_CHOOSE_COLOUR_GENERIC_ALPHA: chooseColourGeneric(true); break;
        case DIALOGS_GET_COLOUR: getColour(); break;
        case DIALOGS_CHOOSE_FONT: chooseFont(false); break;
        case DIALOGS_CHOOSE_FONT_GENERIC: chooseFont(true); break;

        case DIALOGS_SINGLE_CHOICE: singleChoice(); break;
        case DIALOGS_SINGLE_CHOICE_DATA: singleChoiceData(); break;
        case DIALOGS_MULTI_CHOICE: multiChoice(); break;
        case DIALOGS_REARRANGE: showRearrangeDialog(current.frame.ptr); break;
        case DIALOGS_ADDREMOVE: showAddRemoveDialog(current.frame.ptr); break;

        case DIALOGS_LINE_ENTRY: lineEntry(); break;
        case DIALOGS_TEXT_ENTRY: textEntry(); break;
        case DIALOGS_PASSWORD_ENTRY: passwordEntry(); break;
        case DIALOGS_CREDENTIAL_ENTRY: credentialEntry(); break;
        case DIALOGS_NUM_ENTRY: numericEntry(); break;

        case DIALOGS_FILE_OPEN: fileOpen(); break;
        case DIALOGS_FILE_OPEN2: fileOpen2(); break;
        case DIALOGS_FILES_OPEN: filesOpen(); break;
        case DIALOGS_FILES_OPEN_WINDOW_MODAL: filesOpenWindowModal(); break;
        case DIALOGS_FILE_SAVE: fileSave(); break;
        case DIALOGS_FILE_SAVE_WINDOW_MODAL: fileSaveWindowModal(); break;
        case DIALOGS_FILE_OPEN_GENERIC: fileOpenGeneric(); break;
        case DIALOGS_FILES_OPEN_GENERIC: filesOpenGeneric(); break;
        case DIALOGS_FILE_SAVE_GENERIC: fileSaveGeneric(); break;
        case DIALOGS_MAC_TOGGLE_ALWAYS_SHOW_TYPES:
            withStrings([
                "osx.openfiledialog.always-show-types",
                current.menuBar.IsChecked(id) ? "1" : "0",
            ], (ptrs) => wxSystemOptions_SetOption(ptrs[0], ptrs[1]));
            break;

        case DIALOGS_DIR_CHOOSE:
            doDirChoose(DD_DEFAULT_STYLE | DD_DIR_MUST_EXIST);
            break;
        case DIALOGS_DIRNEW_CHOOSE:
            doDirChoose(DD_DEFAULT_STYLE & ~DD_DIR_MUST_EXIST);
            break;
        case DIALOGS_DIRMULTIPLE_CHOOSE: dirChooseMultiple(); break;
        case DIALOGS_DIR_CHOOSE_WINDOW_MODAL: dirChooseWindowModal(); break;
        case DIALOGS_GENERIC_DIR_CHOOSE: genericDirChoose(); break;

        case DIALOGS_TIP: showTip(); break;
        case DIALOGS_LOG_DIALOG: logDialog(); break;
        case DIALOGS_INFOBAR_SIMPLE: infoBarSimple(); break;
        case DIALOGS_INFOBAR_ADVANCED: infoBarAdvanced(); break;

        case DIALOGS_MODAL: showModalDialog(current.frame.ptr); break;
        case DIALOGS_MODELESS:
            toggleModelessDialog(current.frame.ptr,
                current.menuBar.IsChecked(DIALOGS_MODELESS));
            break;
        case DIALOGS_CENTRE_SCREEN: centredDialog(true); break;
        case DIALOGS_CENTRE_PARENT: centredDialog(false); break;
        case DIALOGS_MINIFRAME: miniFrame(); break;
        case DIALOGS_ONTOP: onTopDialog(); break;

        case DIALOGS_PROGRESS: showProgress(false); break;
        case DIALOGS_PROGRESS_GENERIC: showProgress(true); break;
        case DIALOGS_APP_PROGRESS: showAppProgress(); break;
        case DIALOGS_BUSYINFO: showBusyInfo(false); break;
        case DIALOGS_BUSYINFO_RICH: showBusyInfo(true); break;

        case DIALOGS_ABOUTDLG_SIMPLE:
        case DIALOGS_SYSTEM_ABOUT:
            showAboutDialog(0);
            break;
        case DIALOGS_ABOUTDLG_FANCY: showAboutDialog(1); break;
        case DIALOGS_ABOUTDLG_FULL: showAboutDialog(2); break;
        case DIALOGS_ABOUTDLG_CUSTOM: showAboutDialog(3); break;

        case DIALOGS_FIND: showFindOrReplace(false); break;
        case DIALOGS_REPLACE: showFindOrReplace(true); break;

        case DIALOGS_REQUEST:
            withString("Sleeping for 3 seconds to allow you to switch to another window",
                (ptr) => LogStatus(ptr));
            wxSleep(3);
            current.frame.RequestUserAttention(USER_ATTENTION_ERROR);
            break;

        case DIALOGS_NOTIFY_MSG: showNotificationWindow(current.frame.ptr); break;
        case DIALOGS_SHOW_TIP: toggleTipWindow(); break;
        case DIALOGS_RICHTIP_DIALOG: showRichTipDialog(current.frame.ptr); break;

        case DIALOGS_PROPERTY_SHEET:
        case DIALOGS_PROPERTY_SHEET_TOOLBOOK:
        case DIALOGS_PROPERTY_SHEET_BUTTONTOOLBOOK:
            showSettingsDialog(current.frame.ptr, current.settings, id);
            break;

        case DIALOGS_STANDARD_BUTTON_SIZER_DIALOG:
            showStdButtonSizerDialog(current.frame.ptr);
            break;
        case DIALOGS_TEST_DEFAULT_ACTION:
            showTestDefaultActionDialog(current.frame.ptr);
            break;
        case DIALOGS_MODAL_HOOK:
            toggleModalHook(current.menuBar.IsChecked(DIALOGS_MODAL_HOOK));
            break;
        case DIALOGS_SIMULATE_UNSAVED:
            current.confirmExit = current.menuBar.IsChecked(DIALOGS_SIMULATE_UNSAVED);
            break;

        case ID_EXIT:
            current.frame.Close(true);
            break;
        default:
            break;
    }
}

//-----------------------------------------------------------------------------
// Window-modal dialog completion
//-----------------------------------------------------------------------------

interface ModalDialogHolder
{
    ptr: Pointer;
}

const modalDialogs: unknown[] = [];

const TAG_MESSAGE_BOX = 1;
const TAG_FILE_MULTI = 2;
const TAG_FILE_SAVE = 3;
const TAG_DIR = 4;

function onWindowModalClosed(tag: number, eventPtr: Pointer): void
{
    const current = state;
    if (!current) return;

    const event = new wxWindowModalDialogEvent(eventPtr);
    const dialog = event.GetDialog();
    if (!dialog) return;
    const dialogPtr = dialog.ptr;

    switch (tag)
    {
        case TAG_MESSAGE_BOX:
            handleMessageResult(dialog.GetReturnCode());
            break;

        case TAG_FILE_MULTI:
            if (dialog.GetReturnCode() === ID_OK)
            {
                const fileDialog = wrapWxFileDialog(dialogPtr);
                const pathBuffer = new BigUint64Array(MAX_SELECTED_PATHS);
                const nameBuffer = new BigUint64Array(MAX_SELECTED_PATHS);
                const count = fileDialog.GetPaths(pointerOf(pathBuffer), MAX_SELECTED_PATHS);
                fileDialog.GetFilenames(pointerOf(nameBuffer), MAX_SELECTED_PATHS);
                const paths = readStringArray(count, pathBuffer);
                const names = readStringArray(count, nameBuffer);
                let message = "";
                for (let n = 0; n < count; n++)
                {
                    message += `File ${n}: ${paths[n]} (${names[n]})\n`;
                }
                message += `Filter index: ${fileDialog.GetFilterIndex()}`;

                withStrings([message, "Selected files"], (ptrs) =>
                {
                    const second = createWxMessageDialog(
                        current.frame.ptr, ptrs[0], ptrs[1], OK | CENTRE);
                    if (!second) return;
                    second.ShowModal();
                    second.Destroy();
                });
            }
            break;

        case TAG_FILE_SAVE:
            if (dialog.GetReturnCode() === ID_OK)
            {
                const fileDialog = wrapWxFileDialog(dialogPtr);
                withString(
                    `${takeText(fileDialog.GetPath())}, filter ` +
                    `${fileDialog.GetFilterIndex()}`,
                    (ptr) => LogMessage(ptr));
            }
            break;

        case TAG_DIR:
            if (dialog.GetReturnCode() === ID_OK)
            {
                const dirDialog = wrapWxDirDialog(dialogPtr);
                withString(`Selected path: ${takeText(dirDialog.GetPath())}`,
                    (ptr) => LogMessage(ptr));
            }
            break;

        default:
            break;
    }

    dialog.Destroy();
}

//-----------------------------------------------------------------------------
// Routers
//-----------------------------------------------------------------------------

let menuRouter: EventRouter | null = null;
let closeRouter: EventRouter | null = null;
let updateRouter: EventRouter | null = null;
let paintRouter: EventRouter | null = null;
let infoBarRouter: EventRouter | null = null;
let colourRouter: EventRouter | null = null;
let findRouter: EventRouter | null = null;
let windowModalRouter: EventRouter | null = null;

function colourEvents(): EventRouter
{
    if (!colourRouter)
    {
        colourRouter = new EventRouter((_tag, eventPtr) =>
        {
            const event = new wxColourDialogEvent(eventPtr);
            const borrowed = event.GetColour();
            if (borrowed)
            {
                // The getter allocates; the generated wrapper is borrowed, so
                // take ownership explicitly and release it after the event.
                const colour = new wxColour(borrowed.ptr);
                applyColour(colour.ptr);
                colour.Delete();
            }
        });
    }
    return colourRouter;
}

function windowModalEvents(): EventRouter
{
    if (!windowModalRouter)
    {
        windowModalRouter = new EventRouter(onWindowModalClosed);
    }
    return windowModalRouter;
}

//-----------------------------------------------------------------------------
// Close handler
//-----------------------------------------------------------------------------

function onFrameClose(eventPtr: Pointer): void
{
    const current = state;
    if (!current) return;

    const event = new wxCloseEvent(eventPtr);

    if (current.confirmExit && event.CanVeto())
    {
        const dialog = withStrings([
            "You have an unsaved file; save before closing?", "OnClose",
        ], (ptrs) => createWxMessageDialog(current.frame.ptr, ptrs[0], ptrs[1],
            CENTRE | YES_NO | CANCEL | ICON_QUESTION));

        if (dialog)
        {
            withStrings(["&Save", "&Discard changes"], (ptrs) =>
                dialog.SetYesNoLabels(ptrs[0], ptrs[1]));

            const result = dialog.ShowModal();
            dialog.Destroy();

            if (result === ID_CANCEL)
            {
                event.Veto(true);
                withString("You cancelled closing the application.",
                    (ptr) => LogStatus(ptr));
                return;
            }
            if (result === ID_YES)
            {
                messageBox("You chose to save your file.", "OnClose", OK,
                    current.frame.ptr);
            }
            else if (result !== ID_NO)
            {
                withString("Unexpected wxMessageDialog return code!",
                    (ptr) => LogError(ptr));
            }
        }
    }

    event.Skip(true);
}

/** Creates a plain wxButton and returns its pointer. */
function createWxButtonLocal(parent: Pointer, id: number, text: Pointer): Pointer | null
{
    const button = createWxButton(parent, id, text, -1, -1, -1, -1, 0);
    return button ? button.ptr : null;
}

//-----------------------------------------------------------------------------
// Frame construction
//-----------------------------------------------------------------------------

function createFrame(): FrameState | null
{
    const title = createWxString("wxWidgets dialogs example");
    const frame = createWxFrame(
        null, ID_ANY, title.ptr, -1, -1, -1, -1, DEFAULT_FRAME_STYLE);
    title.Delete();
    if (!frame) return null;

    // SetIcon(wxICON(sample)): the XPM artwork is loaded from disk.
    const iconName = createWxString(assetPath("sample.xpm"));
    const icon = createWxIconLoad(
        iconName.ptr, BigInt(BITMAP_TYPE_XPM), -1, -1);
    iconName.Delete();
    if (icon)
    {
        if (icon.IsOk()) frame.SetIcon(icon.ptr);
        icon.Delete();
    }

    const colourData = createWxColourData();
    if (colourData)
    {
        colourData.SetChooseFull(true);
        const count = ColourData_NUM_CUSTOM;
        for (let i = 0; i < count; i++)
        {
            const level = i * 16;
            const colour = createWxColourRGB(level, level, level, 255);
            if (colour)
            {
                colourData.SetCustomColour(i, colour.ptr);
                colour.Delete();
            }
        }
    }

    frame.CreateStatusBar(1, STB_DEFAULT_STYLE, 0);

    const canvas = createWxScrolledWindow(
        frame.ptr, ID_ANY, -1, -1, -1, -1, HSCROLL | VSCROLL)!;
    canvas.SetFont(NORMAL_FONT);

    const infoBarSimple = createWxInfoBarEx(frame.ptr, ID_ANY, INFOBAR_CHECKBOX)!;
    const infoBarAdvanced = createWxInfoBar(frame.ptr, ID_ANY)!;

    withString("", (ptr) => infoBarAdvanced.AddButton(ID_UNDO, ptr));
    withString("", (ptr) => infoBarAdvanced.AddButton(ID_REDO, ptr));
    withString("", (ptr) => infoBarAdvanced.AddButton(ID_EXIT, ptr));
    infoBarAdvanced.RemoveButton(ID_EXIT);

    const ownBackground = createWxColourFromInt(0xc8ffff);
    if (ownBackground)
    {
        infoBarAdvanced.SetOwnBackgroundColour(ownBackground.ptr);
        ownBackground.Delete();
    }
    const ownForeground = createWxColourFromInt(0x123312);
    if (ownForeground)
    {
        infoBarAdvanced.SetForegroundColour(ownForeground.ptr);
        ownForeground.Delete();
    }

    // GetFont().Bold().Larger(): mutate a copy in place rather than wrapping the
    // borrowed wxFont results of Bold()/Larger().
    const frameFont = createWxFontDefault();
    if (frameFont)
    {
        frame.GetFont(frameFont.ptr);
        frameFont.MakeBold();
        frameFont.MakeLarger();
        infoBarAdvanced.SetFont(frameFont.ptr);
        frameFont.Delete();
    }

    infoBarAdvanced.SetShowHideEffects(SHOW_EFFECT_EXPAND, SHOW_EFFECT_EXPAND);
    infoBarAdvanced.SetEffectDuration(1500);

    const sizer = createWxBoxSizer(VERTICAL)!;
    addWin(sizer, infoBarSimple.ptr, 0, (f) => { f.Expand(); });
    addWin(sizer, canvas.ptr, 1, (f) => { f.Expand(); });
    addWin(sizer, infoBarAdvanced.ptr, 0, (f) => { f.Expand(); });
    frame.SetSizer(sizer.ptr, true);

    const canvasColour = backgroundColour(canvas);
    if (canvasColour)
    {
        frame.SetOwnBackgroundColour(canvasColour.ptr);
        canvasColour.Delete();
    }

    const menuBar = buildMenuBar();
    frame.SetMenuBar(menuBar.ptr);

    // MSW-specific access to the "system" menu (returns null elsewhere).
    const systemMenu = frame.MSWGetSystemMenu();
    if (systemMenu)
    {
        systemMenu.AppendSeparator();
        withString("&About",
            (ptr) => systemMenu.Append(DIALOGS_SYSTEM_ABOUT, ptr, null, false));
    }

    const frameState: FrameState = {
        frame,
        menuBar,
        canvas,
        infoBarSimple,
        infoBarAdvanced,
        confirmExit: false,
        colourData,
        settings: createSettingsData(),
        findData: createWxFindReplaceDataDefault(),
        dlgFind: null,
        dlgReplace: null,
        tipWindowRef: null,
        modalHook: null,
    };
    state = frameState;

    // --- event wiring
    menuRouter = new EventRouter((_tag, eventPtr) =>
    {
        const event = new wxCommandEvent(eventPtr);
        handleMenuId(event.GetId());
    });
    menuRouter.connect(frame.ptr, ID_ANY, ID_ANY, EVT_MENU);

    closeRouter = new EventRouter((_tag, eventPtr) => onFrameClose(eventPtr));
    closeRouter.connect(frame.ptr, ID_ANY, ID_ANY, EVT_CLOSE_WINDOW);

    updateRouter = new EventRouter((_tag, eventPtr) =>
    {
        const event = new wxUpdateUIEvent(eventPtr);
        event.Check(frameState.tipWindowRef !== null
            && frameState.tipWindowRef[0] !== 0n);
    });
    updateRouter.connect(frame.ptr, DIALOGS_SHOW_TIP, DIALOGS_SHOW_TIP, EVT_UPDATE_UI);

    paintRouter = new EventRouter(() => canvasPaint());
    paintRouter.connect(canvas.ptr, ID_ANY, ID_ANY, EVT_PAINT);

    infoBarRouter = new EventRouter((tag) => onInfoBarButton(tag));
    infoBarRouter.connect(infoBarSimple.ptr, ID_CLOSE, ID_CLOSE, EVT_BUTTON, 1);
    infoBarRouter.connect(infoBarAdvanced.ptr, ID_REDO, ID_REDO, EVT_BUTTON, 2);

    findRouter = new EventRouter(onFindEvent);
    findRouter.connect(frame.ptr, ID_ANY, ID_ANY, EVT_FIND, 1);
    findRouter.connect(frame.ptr, ID_ANY, ID_ANY, EVT_FIND_NEXT, 2);
    findRouter.connect(frame.ptr, ID_ANY, ID_ANY, EVT_FIND_REPLACE, 3);
    findRouter.connect(frame.ptr, ID_ANY, ID_ANY, EVT_FIND_REPLACE_ALL, 4);
    findRouter.connect(frame.ptr, ID_ANY, ID_ANY, EVT_FIND_CLOSE, 5);

    frame.Centre(BOTH);
    return frameState;
}

//-----------------------------------------------------------------------------
// Custom log target (MyLogGui / MyAppTraits::CreateLogTarget)
//-----------------------------------------------------------------------------

let customLogGui: kwxLogGui | null = null;
let logShowCallback: Callback | null = null;
let previousLogTarget: wxLog | null = null;
let logTraits: wxAppTraits | null = null;

function installCustomLogTarget(): void
{
    const appPtr = wxApp_GetApp();
    if (!appPtr) return;
    const traits = wrapWxApp(appPtr).GetTraits();
    if (!traits) return;

    const logGui = createKwxLogGui(null);
    if (!logGui) return;

    logShowCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_fun, messagePtr, titlePtr) =>
        {
            if (!messagePtr) return;
            const style = OK | CANCEL | CANCEL_DEFAULT | logGui.GetPendingStyle();
            const dialog = createWxMessageDialog(
                null, messagePtr, titlePtr, style);
            if (!dialog) return;
            withStrings([stockLabel(ID_COPY), stockLabel(ID_OK)],
                (ptrs) => dialog.SetOKCancelLabels(ptrs[0], ptrs[1]));
            withString("Note that this is a custom log dialog.",
                (ptr) => dialog.SetExtendedMessage(ptr));
            dialog.ShowModal();
            dialog.Destroy();
        });
    logGui.SetOnDoShowSingleLogMessage(logShowCallback.pointer);

    previousLogTarget = traits.SetLogTarget(logGui.ptr);
    logTraits = traits;
    customLogGui = logGui;
}

function uninstallCustomLogTarget(): void
{
    if (logTraits)
    {
        logTraits.SetLogTarget(previousLogTarget ? previousLogTarget.ptr : null);
    }
    if (customLogGui) customLogGui.Delete();
    customLogGui = null;
    logTraits = null;
    previousLogTarget = null;
    if (logShowCallback)
    {
        logShowCallback.close();
        logShowCallback = null;
    }
}

//-----------------------------------------------------------------------------
// Command line (MyApp::OnInitCmdLine / OnCmdLineParsed)
//-----------------------------------------------------------------------------

function startupProgressStyle(): number
{
    for (let i = 0; i < args.length; i++)
    {
        const arg = args[i];
        if (arg === "--progress")
        {
            const next = args[i + 1];
            return next !== undefined ? Number(next) : -1;
        }
        if (arg.startsWith("--progress="))
        {
            return Number(arg.substring("--progress=".length));
        }
    }
    return -1;
}

function showStartupProgress(style: number): void
{
    if (!Number.isFinite(style) || style === -1) return;

    const dialog = withStrings(
        ["Progress in progress", "Please wait, starting..."],
        (ptrs) => createWxProgressDialog(
            ptrs[0], ptrs[1], PROGRESS_MAX, null, style));
    if (!dialog) return;

    for (let i = 0; i <= PROGRESS_MAX; i++)
    {
        let message = "";
        if (i === 15)
        {
            message = "And the same dialog but with a very, very, very long" +
                " message, just to test how it appears in this case.";
        }
        else if (i === 30)
        {
            message = "Back to brevity";
        }
        else if (i === 80)
        {
            message = "Back and adjusted";
            dialog.Fit();
        }

        const cont = withString(message,
            (ptr) => dialog.UpdateWithMessage(i, ptr));
        if (!cont) break;
        wxMilliSleep(50n);
    }
    dialog.Destroy();
}

//-----------------------------------------------------------------------------
// Bootstrap
//-----------------------------------------------------------------------------

export function main(): number
{
    if (!initialize())
    {
        console.error("Failed to initialize wxWidgets");
        return 1;
    }

    // The C++ executable is "dialogs", so wxApp::GetAppName() is "dialogs".
    setAppName("dialogs");
    installCustomLogTarget();
    showStartupProgress(startupProgressStyle());
    initAllImageHandlers();

    const frameState = createFrame();
    if (!frameState)
    {
        console.error("Failed to create the main frame");
        shutdown();
        return 1;
    }

    frameState.frame.Show();
    setTopWindow(frameState.frame.ptr);

    const exitCode = run();

    if (menuRouter) menuRouter.close();
    if (closeRouter) closeRouter.close();
    if (updateRouter) updateRouter.close();
    if (paintRouter) paintRouter.close();
    if (infoBarRouter) infoBarRouter.close();
    if (colourRouter) colourRouter.close();
    if (findRouter) findRouter.close();
    if (windowModalRouter) windowModalRouter.close();
    closeModalTestRouters();
    closeMiscDialogRouters();

    closeCustomizerCallbacks();
    if (extraPanelRouter)
    {
        extraPanelRouter.close();
        extraPanelRouter = null;
    }
    if (extraPanelCallback)
    {
        extraPanelCallback.close();
        extraPanelCallback = null;
    }
    for (const callback of modalHookCallbacks) callback.close();

    uninstallCustomLogTarget();
    shutdown();
    return exitCode;
}

exit(main());
