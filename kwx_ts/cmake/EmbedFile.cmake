# kwx_ts — configure-time file embedding helper.
#
# Converts a file into a C++ byte array so the executable can carry runtime
# assets (the host runtime) without reading them from disk.
#
# kwx_ts_embed_file(<input> <symbol> <out_var>)
#   <input>   absolute path of the file to embed
#   <symbol>  C identifier for the generated array; <symbol>_len is also emitted
#   <out_var> receives the absolute path of the generated .cpp
#
# The generated translation unit declares and defines:
#   const char <symbol>[];
#   const unsigned int <symbol>_len;
# so the host can reference them with matching extern declarations.

include_guard(GLOBAL)

function(kwx_ts_embed_file input_path symbol_name out_var)
    if(NOT EXISTS "${input_path}")
        message(FATAL_ERROR "kwx_ts_embed_file: input '${input_path}' does not exist")
    endif()

    # The file is read at configure time, not build time. Without this the
    # executable silently keeps a stale copy after the input is edited.
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input_path}")

    if(NOT symbol_name MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
        message(FATAL_ERROR "kwx_ts_embed_file: '${symbol_name}' is not a valid C identifier")
    endif()

    file(READ "${input_path}" hex_data HEX)
    string(LENGTH "${hex_data}" hex_length)
    math(EXPR byte_count "${hex_length} / 2")

    # Turn "414243" (hex_data has no separators) into "static_cast<char>(0x41),...".
    # The cast keeps the target type `const char[]` so the host can pass the
    # array to JS_Eval without any pointer cast, and avoids narrowing errors.
    if(byte_count GREATER 0)
        string(REGEX REPLACE "(..)" "static_cast<char>(0x\\1)," byte_list "${hex_data}")
    else()
        set(byte_list "")
    endif()
    set(generated_dir "${CMAKE_CURRENT_BINARY_DIR}/generated")
    file(MAKE_DIRECTORY "${generated_dir}")

    set(generated_file "${generated_dir}/${symbol_name}_embed.cpp")

    # The array is NUL-terminated even though the length is passed separately:
    # QuickJS's lexer reads `*p` before checking `p >= buf_end`, so the byte at
    # the end of the buffer must be 0. Without the terminator the parser reads
    # whatever section follows the array and can fail with a spurious syntax
    # error. The extra byte is not counted in <symbol>_len.
    file(WRITE "${generated_file}"
"// Generated by kwx_ts_embed_file() from:\n"
"//   ${input_path}\n"
"// Do not edit; regenerate by reconfiguring the kwx_ts project.\n"
"#include <cstddef>\n"
"\n"
"extern const char ${symbol_name}[];\n"
"extern const unsigned int ${symbol_name}_len;\n"
"\n"
"const char ${symbol_name}[] = {\n"
"${byte_list}\n"
"static_cast<char>(0)\n"
"};\n"
"\n"
"const unsigned int ${symbol_name}_len = ${byte_count}U;\n"
    )

    set(${out_var} "${generated_file}" PARENT_SCOPE)
endfunction()
