export const wxSTC_MARKNUM_FOLDERSUB = 29;
export const wxSTC_MARKNUM_FOLDER = 30;
export const wxSTC_MARKNUM_FOLDEROPEN = 31;

/** stc.h:140 — 0xFE000000; narrowed to int32 as the C++ implicit conversion does. */
export const wxSTC_MASK_FOLDERS = 0xFE000000 | 0;

// stc.h:142-143
export const wxSTC_MARGIN_SYMBOL = 0;
