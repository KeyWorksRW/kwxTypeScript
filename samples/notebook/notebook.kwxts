    createWxPanel,
    createWxSimpleHelpProvider,
    createWxString,
    createWxTextCtrl,
    DEFAULT_FRAME_STYLE,
    EVT_AUINOTEBOOK_PAGE_CHANGED,
    EVT_AUINOTEBOOK_PAGE_CHANGING,
    EVT_CHOICEBOOK_PAGE_CHANGED,
    EVT_CHOICEBOOK_PAGE_CHANGING,
    EVT_IDLE,
    EVT_LISTBOOK_PAGE_CHANGED,
    EVT_LISTBOOK_PAGE_CHANGING,
    EVT_MENU,
    EVT_NOTEBOOK_PAGE_CHANGED,
    EVT_NOTEBOOK_PAGE_CHANGING,
    EVT_TOOLBOOK_PAGE_CHANGED,
    EVT_TOOLBOOK_PAGE_CHANGING,
    EVT_TREEBOOK_PAGE_CHANGED,
    EVT_TREEBOOK_PAGE_CHANGING,
    EVT_UPDATE_UI,
    EXPAND,
    expNB_BOTTOM,
    expNB_LEFT,
    expNB_NOPAGETHEME,
    expNB_RIGHT,
    expNB_TOP,
    expTBK_BUTTONBAR,
    expTBK_HORZ_LAYOUT,
    FRAME_EX_CONTEXTHELP,
    GTKAllowDiagnosticsControl,
    ICON_QUESTION,
    ID_ANY,
    ID_EXIT,
    ID_HIGHEST,
    initAllImageHandlers,
    initialize,
