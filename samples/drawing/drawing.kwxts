interface DrawingState
{
    frame: wxFrame;
    canvas: wxScrolledWindow;
    menuItemUseDC: wxMenuItem | null;

    // MyFrame state
    backgroundMode: number;
    textureBackground: boolean;
    mapMode: number;
    xUserScale: number;
    yUserScale: number;
    xLogicalOrigin: number;
    yLogicalOrigin: number;
    xAxisReversed: boolean;
    yAxisReversed: boolean;

    transformDx: number;
    transformDy: number;
    transformScx: number;
    transformScy: number;
    transformRot: number;

    colourForeground: wxColour | null;
    colourBackground: wxColour | null;
    backgroundBrush: wxBrush | null;

    outerScrollEnabled: boolean;
    innerScrollWidth: number;

    // MyCanvas state
    show: number;
    smileBmp: wxBitmap | null;
    stdIcon: wxIcon | null;
    clip: boolean;
    rubberBand: boolean;
    anchorX: number;
    anchorY: number;
    currentX: number;
    currentY: number;
    renderer: Pointer | null;
    useAntiAliasing: boolean;
    useBuffer: boolean;
    showBBox: boolean;
    sizeDIPW: number;
    sizeDIPH: number;
    customCursor: wxCursor | null;
    stockCursors: (wxCursor | null)[];
    cursorRects: Rect[];

    // Global bitmaps (gs_*)
    bmpNoMask: wxBitmap | null;
    bmpWithColMask: wxBitmap | null;
    bmpMask: wxBitmap | null;
    bmpWithMask: wxBitmap | null;
    bmp4: wxBitmap | null;
    bmp4Mono: wxBitmap | null;
    bmp36: wxBitmap | null;
}

// ---------------------------------------------------------------------------
// Bitmap loading (MyApp::LoadImages)
// ---------------------------------------------------------------------------

function loadBitmap(fileName: string, type: number): wxBitmap | null
{
    const path = `${__dirname}/${fileName}`;
    const bitmap = withString(path, (ptr) => createWxBitmapLoad(ptr, type));
    if (!bitmap || !bitmap.IsOk())
    {
        if (bitmap) bitmap.Delete();
        return null;
    }
    return bitmap;
}

function loadImages(state: DrawingState): boolean
{
    state.bmp4 = loadBitmap("pat4.bmp", BITMAP_TYPE_ANY);
    state.bmp4Mono = loadBitmap("pat4.bmp", BITMAP_TYPE_ANY);
    if (!state.bmp4 || !state.bmp4Mono) return false;

    {
        const maskPtr = createWxMaskColoured(state.bmp4Mono.ptr, BLACK);
        if (maskPtr) state.bmp4Mono.SetMask(maskPtr);
    }

    state.bmp36 = loadBitmap("pat36.bmp", BITMAP_TYPE_ANY);
    if (!state.bmp36) return false;
    {
        const maskPtr = createWxMaskColoured(state.bmp36.ptr, BLACK);
        if (maskPtr) state.bmp36.SetMask(maskPtr);
    }

    state.bmpNoMask = loadBitmap("image.bmp", BITMAP_TYPE_ANY);
    state.bmpWithMask = loadBitmap("image.bmp", BITMAP_TYPE_ANY);
    state.bmpWithColMask = loadBitmap("image.bmp", BITMAP_TYPE_ANY);
    if (!state.bmpNoMask || !state.bmpWithMask || !state.bmpWithColMask) return false;

    state.bmpMask = loadBitmap("mask.bmp", BITMAP_TYPE_ANY);
    if (!state.bmpMask) return false;

    {
        const maskPtr = createWxMaskColoured(state.bmpMask.ptr, BLACK);
        if (maskPtr) state.bmpWithMask.SetMask(maskPtr);
    }
    {
        const maskPtr = createWxMaskColoured(state.bmpWithColMask.ptr, WHITE);
        if (maskPtr) state.bmpWithColMask.SetMask(maskPtr);
    }

    return true;
}

// ---------------------------------------------------------------------------
// Drawing routines (MyCanvas::Draw*)
// ---------------------------------------------------------------------------

function drawTestBrushes(dc: wxDC): void
{
    const WIDTH = dc.FromDIP(200);
    const HEIGHT = dc.FromDIP(80);

    const x = dc.FromDIP(10);
    let y = dc.FromDIP(10);
    const o = dc.FromDIP(10);

    dc.SetBrush(GREEN_BRUSH);
    dc.DrawRectangle(x, y, WIDTH, HEIGHT);
    drawText(dc, "Solid green", x + o, y + o);

    y += HEIGHT;
    setBrush(dc, RED, BRUSHSTYLE_CROSSDIAG_HATCH);
    dc.DrawRectangle(x, y, WIDTH, HEIGHT);
    drawText(dc, "Diagonally hatched red", x + o, y + o);

    y += HEIGHT;
    setBrush(dc, BLUE, BRUSHSTYLE_CROSS_HATCH);
    dc.DrawRectangle(x, y, WIDTH, HEIGHT);
    drawText(dc, "Cross hatched blue", x + o, y + o);

    y += HEIGHT;
    setBrush(dc, CYAN, BRUSHSTYLE_VERTICAL_HATCH);
    dc.DrawRectangle(x, y, WIDTH, HEIGHT);
    drawText(dc, "Vertically hatched cyan", x + o, y + o);

    y += HEIGHT;
    setBrush(dc, BLACK, BRUSHSTYLE_HORIZONTAL_HATCH);
    dc.DrawRectangle(x, y, WIDTH, HEIGHT);
    drawText(dc, "Horizontally hatched black", x + o, y + o);

    y += HEIGHT;
    if (state_bitmaps.bmpMask)
    {
        const brush = createWxBrushFromBitmap(state_bitmaps.bmpMask.ptr);
        if (brush)
        {
            dc.SetBrush(brush.ptr);
            dc.DrawRectangle(x, y, WIDTH, HEIGHT);
            brush.Delete();
        }
    }
    drawText(dc, "Stipple mono", x + o, y + o);

    y += HEIGHT;
    if (state_bitmaps.bmpNoMask)
    {
        const brush = createWxBrushFromBitmap(state_bitmaps.bmpNoMask.ptr);
        if (brush)
        {
            dc.SetBrush(brush.ptr);
            dc.DrawRectangle(x, y, WIDTH, HEIGHT);
            brush.Delete();
        }
    }
    drawText(dc, "Stipple colour", x + o, y + o);
}

// Bitmaps are global in the C++ sample; this is filled from the state before
// each paint so the drawing helpers keep the original one-argument shape.
let state_bitmaps: DrawingState;

function drawTestPoly(dc: wxDC): void
{
    setBrush(dc, RED, BRUSHSTYLE_FDIAGONAL_HATCH);

    const starX = new Int32Array(5);
    const starY = new Int32Array(5);
    const star: [number, number][] = [
        [100, 60], [60, 150], [160, 100], [40, 100], [140, 150],
    ];
    for (let i = 0; i < 5; i++)
    {
        starX[i] = dc.FromDIP(star[i][0]);
        starY[i] = dc.FromDIP(star[i][1]);
    }

    drawText(dc, "You should see two (irregular) stars below, the left one hatched",
        dc.FromDIP(10), dc.FromDIP(10));
    drawText(dc, "except for the central region and the right one entirely hatched",
        dc.FromDIP(10), dc.FromDIP(30));
    drawText(dc, "The third star only has a hatched outline",
        dc.FromDIP(10), dc.FromDIP(50));

    dc.DrawPolygon(5, pointerOf(starX), pointerOf(starY),
        0, dc.FromDIP(30), ODDEVEN_RULE);
    dc.DrawPolygon(5, pointerOf(starX), pointerOf(starY),
        dc.FromDIP(160), dc.FromDIP(30), WINDING_RULE);

    setBrush(dc, GREEN, BRUSHSTYLE_FDIAGONAL_HATCH);

    const star2: [number, number][] = [
        [0, 100], [-59, -81], [95, 31], [-95, 31], [59, -81],
        [0, 80], [-47, -64], [76, 24], [-76, 24], [47, -64],
    ];
    const star2X = new Int32Array(10);
    const star2Y = new Int32Array(10);
    for (let i = 0; i < 10; i++)
    {
        star2X[i] = dc.FromDIP(star2[i][0]);
        star2Y[i] = dc.FromDIP(star2[i][1]);
    }
    const counts = new Int32Array([5, 5]);

    dc.DrawPolyPolygon(2, pointerOf(counts), pointerOf(star2X), pointerOf(star2Y),
        dc.FromDIP(450), dc.FromDIP(150), ODDEVEN_RULE);
}

function drawTestLines(dc: wxDC, x: number, y: number, width: number): void
{
    setPen(dc, BLACK, width);
    dc.SetBrush(WHITE_BRUSH);
    drawText(dc, `Testing lines of width ${width}`,
        dc.FromDIP(x + 10), dc.FromDIP(y - 10));
    dc.DrawRectangle(dc.FromDIP(x + 10), dc.FromDIP(y + 10),
        dc.FromDIP(100), dc.FromDIP(190));

    drawText(dc, "Solid/dot/short dash/long dash/dot dash",
        dc.FromDIP(x + 150), dc.FromDIP(y + 10));

    setPen(dc, BLACK, width, PENSTYLE_SOLID);
    dc.DrawLine(dc.FromDIP(x + 20), dc.FromDIP(y + 20),
        dc.FromDIP(100), dc.FromDIP(y + 20));
    setPen(dc, BLACK, width, PENSTYLE_DOT);
    dc.DrawLine(dc.FromDIP(x + 20), dc.FromDIP(y + 30),
        dc.FromDIP(100), dc.FromDIP(y + 30));
    setPen(dc, BLACK, width, PENSTYLE_SHORT_DASH);
    dc.DrawLine(dc.FromDIP(x + 20), dc.FromDIP(y + 40),
        dc.FromDIP(100), dc.FromDIP(y + 40));
    setPen(dc, BLACK, width, PENSTYLE_LONG_DASH);
    dc.DrawLine(dc.FromDIP(x + 20), dc.FromDIP(y + 50),
        dc.FromDIP(100), dc.FromDIP(y + 50));
    setPen(dc, BLACK, width, PENSTYLE_DOT_DASH);
    dc.DrawLine(dc.FromDIP(x + 20), dc.FromDIP(y + 60),
        dc.FromDIP(100), dc.FromDIP(y + 60));

    drawText(dc, "Hatches", dc.FromDIP(x + 150), dc.FromDIP(y + 70));
    setPen(dc, BLACK, width, PENSTYLE_BDIAGONAL_HATCH);
    dc.DrawLine(dc.FromDIP(x + 20), dc.FromDIP(y + 70),
        dc.FromDIP(100), dc.FromDIP(y + 70));
    setPen(dc, BLACK, width, PENSTYLE_CROSSDIAG_HATCH);
    dc.DrawLine(dc.FromDIP(x + 20), dc.FromDIP(y + 80),
        dc.FromDIP(100), dc.FromDIP(y + 80));
    setPen(dc, BLACK, width, PENSTYLE_FDIAGONAL_HATCH);
    dc.DrawLine(dc.FromDIP(x + 20), dc.FromDIP(y + 90),
        dc.FromDIP(100), dc.FromDIP(y + 90));
    setPen(dc, BLACK, width, PENSTYLE_CROSS_HATCH);
    dc.DrawLine(dc.FromDIP(x + 20), dc.FromDIP(y + 100),
        dc.FromDIP(100), dc.FromDIP(y + 100));
    setPen(dc, BLACK, width, PENSTYLE_HORIZONTAL_HATCH);
    dc.DrawLine(dc.FromDIP(x + 20), dc.FromDIP(y + 110),
        dc.FromDIP(100), dc.FromDIP(y + 110));
    setPen(dc, BLACK, width, PENSTYLE_VERTICAL_HATCH);
    dc.DrawLine(dc.FromDIP(x + 20), dc.FromDIP(y + 120),
        dc.FromDIP(100), dc.FromDIP(y + 120));

    drawText(dc, "User dash", dc.FromDIP(x + 150), dc.FromDIP(y + 140));
    const ud = createWxPenFromColour(BLACK, width, PENSTYLE_USER_DASH);
    if (ud)
    {
        const dash = new Int32Array([8, 2, 3, 2, 3, 2]);
        ud.SetDashes(6, pointerOf(dash));
        dc.SetPen(ud.ptr);
        dc.DrawLine(dc.FromDIP(x + 20), dc.FromDIP(y + 140),
            dc.FromDIP(100), dc.FromDIP(y + 140));
        dash[0] = 5;
        ud.SetDashes(6, pointerOf(dash));
        dc.SetPen(ud.ptr);
        dc.DrawLine(dc.FromDIP(x + 20), dc.FromDIP(y + 150),
            dc.FromDIP(100), dc.FromDIP(y + 150));
        dash[2] = 5;
        ud.SetDashes(6, pointerOf(dash));
        dc.SetPen(ud.ptr);
        dc.DrawLine(dc.FromDIP(x + 20), dc.FromDIP(y + 160),
            dc.FromDIP(100), dc.FromDIP(y + 160));
        dash[4] = 5;
        ud.SetDashes(6, pointerOf(dash));
        dc.SetPen(ud.ptr);
        dc.DrawLine(dc.FromDIP(x + 20), dc.FromDIP(y + 170),
            dc.FromDIP(100), dc.FromDIP(y + 170));
        ud.Delete();
    }

    const penWithCap = createWxPenFromColour(BLACK, width, PENSTYLE_SOLID);
    if (penWithCap)
    {
        dc.SetPen(penWithCap.ptr);
        drawText(dc, "Default cap", dc.FromDIP(x + 270), dc.FromDIP(y + 40));
        dc.DrawLine(dc.FromDIP(x + 200), dc.FromDIP(y + 50),
            dc.FromDIP(x + 250), dc.FromDIP(y + 50));

        penWithCap.SetCap(CAP_BUTT);
        dc.SetPen(penWithCap.ptr);
        drawText(dc, "Butt ", dc.FromDIP(x + 270), dc.FromDIP(y + 60));
        dc.DrawLine(dc.FromDIP(x + 200), dc.FromDIP(y + 70),
            dc.FromDIP(x + 250), dc.FromDIP(y + 70));

        penWithCap.SetCap(CAP_ROUND);
        dc.SetPen(penWithCap.ptr);
        drawText(dc, "Round cap", dc.FromDIP(x + 270), dc.FromDIP(y + 80));
        dc.DrawLine(dc.FromDIP(x + 200), dc.FromDIP(y + 90),
            dc.FromDIP(x + 250), dc.FromDIP(y + 90));

        penWithCap.SetCap(CAP_PROJECTING);
        dc.SetPen(penWithCap.ptr);
        drawText(dc, "Projecting cap", dc.FromDIP(x + 270), dc.FromDIP(y + 100));
        dc.DrawLine(dc.FromDIP(x + 200), dc.FromDIP(y + 110),
            dc.FromDIP(x + 250), dc.FromDIP(y + 110));
        penWithCap.Delete();
    }
}

function drawCrossHair(dc: wxDC, x: number, y: number, width: number, height: number): void
{
    drawText(dc, "Cross hair", dc.FromDIP(x + 10), dc.FromDIP(y + 10));
    dc.SetClippingRegion(dc.FromDIP(x), dc.FromDIP(y),
        dc.FromDIP(width), dc.FromDIP(height));
    setPen(dc, BLUE, 2);
    dc.CrossHair(dc.FromDIP(x + Math.trunc(width / 2)),
        dc.FromDIP(y + Math.trunc(height / 2)));
    dc.DestroyClippingRegion();
}

function drawDefault(dc: wxDC): void
{
    // Draw circle centered at the origin, then flood fill it with a different
    // color; done through a wxMemoryDC like the original.
    {
        const img = createWxImageSized(dc.FromDIP(21), dc.FromDIP(21));
        if (img)
        {
            img.Clear(1);
            const bmp = createWxBitmapFromImage(img.ptr, BITMAP_SCREEN_DEPTH);
            img.Delete();

            if (bmp)
            {
                const mdc = createWxMemoryDCWithBitmap(bmp.ptr);
                if (mdc)
                {
                    const brush = createWxBrushDefault();
                    const pen = createWxPenDefault();
                    if (brush) dc.GetBrush(brush.ptr);
                    if (pen) dc.GetPen(pen.ptr);

                    if (brush) mdc.SetBrush(brush.ptr);
                    if (pen) mdc.SetPen(pen.ptr);
                    mdc.DrawCircle(dc.FromDIP(10), dc.FromDIP(10), dc.FromDIP(10));

                    const c = createWxColourEmpty();
                    if (c)
                    {
                        if (mdc.GetPixel(dc.FromDIP(11), dc.FromDIP(11), c.ptr))
                        {
                            const fill = colourRGB(128, 128, 0);
                            if (fill)
                            {
                                setBrush(mdc, fill.ptr);
                                mdc.FloodFill(dc.FromDIP(11), dc.FromDIP(11),
                                    c.ptr, FLOOD_SURFACE);
                                fill.Delete();
                            }
                        }
                        c.Delete();
                    }
                    if (brush) brush.Delete();
                    if (pen) pen.Delete();
                    mdc.Delete();
                }

                const maskColour = colourRGB(1, 1, 1);
                if (maskColour)
                {
                    const maskPtr = createWxMaskColoured(bmp.ptr, maskColour.ptr);
                    if (maskPtr) bmp.SetMask(maskPtr);
                    maskColour.Delete();
                }

                dc.DrawBitmap(bmp.ptr, dc.FromDIP(-10), dc.FromDIP(-10), true);
                bmp.Delete();
            }
        }
    }

    dc.DrawCheckMark(dc.FromDIP(5), dc.FromDIP(80), dc.FromDIP(15), dc.FromDIP(15));
    dc.DrawCheckMark(dc.FromDIP(25), dc.FromDIP(80), dc.FromDIP(30), dc.FromDIP(30));
    dc.DrawCheckMark(dc.FromDIP(60), dc.FromDIP(80), dc.FromDIP(60), dc.FromDIP(60));

    // test for "blitting bitmap into DC damages selected brush" bug
    const rectSize =
        (state_bitmaps.stdIcon ? state_bitmaps.stdIcon.GetWidth() : 0) +
        dc.FromDIP(10);
    let x = dc.FromDIP(100);
    dc.SetPen(TRANSPARENT_PEN);
    dc.SetBrush(GREEN_BRUSH);
    dc.DrawRectangle(x, dc.FromDIP(10), rectSize, rectSize);
    if (state_bitmaps.stdIcon)
    {
        dc.DrawBitmap(state_bitmaps.stdIcon.ptr,
            x + dc.FromDIP(5), dc.FromDIP(15), true);
    }
    x += rectSize + dc.FromDIP(10);
    dc.DrawRectangle(x, dc.FromDIP(10), rectSize, rectSize);
    if (state_bitmaps.stdIcon)
    {
        dc.DrawIcon(state_bitmaps.stdIcon.ptr,
            x + dc.FromDIP(5), dc.FromDIP(15));
    }
    x += rectSize + dc.FromDIP(10);
    dc.DrawRectangle(x, dc.FromDIP(10), rectSize, rectSize);

    if (state_bitmaps.smileBmp && state_bitmaps.smileBmp.IsOk())
    {
        dc.DrawBitmap(state_bitmaps.smileBmp.ptr,
            x + rectSize - dc.FromDIP(20), rectSize - dc.FromDIP(10), true);
    }

    dc.SetBrush(BLACK_BRUSH);
    dc.DrawRectangle(0, dc.FromDIP(160), dc.FromDIP(1000), dc.FromDIP(300));

    // draw lines
    let bitmap = createWxBitmapEmpty(dc.FromDIP(20), dc.FromDIP(70), BITMAP_SCREEN_DEPTH);
    if (bitmap)
    {
        const memdc = createWxMemoryDCWithBitmap(bitmap.ptr);
        if (memdc)
        {
            memdc.SetBrush(BLACK_BRUSH);
            memdc.SetPen(WHITE_PEN);
            memdc.DrawRectangle(0, 0, dc.FromDIP(20), dc.FromDIP(70));
            memdc.DrawLine(dc.FromDIP(10), 0, dc.FromDIP(10), dc.FromDIP(70));

            // to the right
            memdc.SetPen(RED_PEN);
            memdc.DrawLine(dc.FromDIP(10), dc.FromDIP(5), dc.FromDIP(10), dc.FromDIP(5));
            memdc.DrawLine(dc.FromDIP(10), dc.FromDIP(10), dc.FromDIP(11), dc.FromDIP(10));
            memdc.DrawLine(dc.FromDIP(10), dc.FromDIP(15), dc.FromDIP(12), dc.FromDIP(15));
            memdc.DrawLine(dc.FromDIP(10), dc.FromDIP(20), dc.FromDIP(13), dc.FromDIP(20));

            // same to the left
            memdc.DrawLine(dc.FromDIP(10), dc.FromDIP(25), dc.FromDIP(10), dc.FromDIP(25));
            memdc.DrawLine(dc.FromDIP(10), dc.FromDIP(30), dc.FromDIP(9), dc.FromDIP(30));
            memdc.DrawLine(dc.FromDIP(10), dc.FromDIP(35), dc.FromDIP(8), dc.FromDIP(35));
            memdc.DrawLine(dc.FromDIP(10), dc.FromDIP(40), dc.FromDIP(7), dc.FromDIP(40));

            // XOR draw lines
            memdc.SetLogicalFunction(INVERT);
            memdc.SetPen(WHITE_PEN);
            memdc.DrawLine(dc.FromDIP(10), dc.FromDIP(50), dc.FromDIP(10), dc.FromDIP(50));
            memdc.DrawLine(dc.FromDIP(10), dc.FromDIP(55), dc.FromDIP(11), dc.FromDIP(55));
            memdc.DrawLine(dc.FromDIP(10), dc.FromDIP(60), dc.FromDIP(12), dc.FromDIP(60));
            memdc.DrawLine(dc.FromDIP(10), dc.FromDIP(65), dc.FromDIP(13), dc.FromDIP(65));

            memdc.DrawLine(dc.FromDIP(12), dc.FromDIP(50), dc.FromDIP(12), dc.FromDIP(50));
            memdc.DrawLine(dc.FromDIP(12), dc.FromDIP(55), dc.FromDIP(13), dc.FromDIP(55));
            memdc.DrawLine(dc.FromDIP(12), dc.FromDIP(60), dc.FromDIP(14), dc.FromDIP(60));
            memdc.DrawLine(dc.FromDIP(12), dc.FromDIP(65), dc.FromDIP(15), dc.FromDIP(65));

            memdc.Delete();
        }

        dc.DrawBitmap(bitmap.ptr, dc.FromDIP(10), dc.FromDIP(170), false);

        const image = new wxImage(bitmap.ConvertToImage());
        image.Rescale(dc.FromDIP(60), dc.FromDIP(210));
        const rescaled = createWxBitmapFromImage(image.ptr, BITMAP_SCREEN_DEPTH);
        image.Delete();
        bitmap.Delete();
        if (rescaled)
        {
            dc.DrawBitmap(rescaled.ptr, dc.FromDIP(50), dc.FromDIP(170), false);
            rescaled.Delete();
        }
    }

    // test the rectangle outline drawing
    dc.SetPen(WHITE_PEN);
    dc.SetBrush(TRANSPARENT_BRUSH);
    dc.DrawRectangle(dc.FromDIP(150), dc.FromDIP(170), dc.FromDIP(49), dc.FromDIP(29));
    dc.DrawRectangle(dc.FromDIP(200), dc.FromDIP(170), dc.FromDIP(49), dc.FromDIP(29));
    dc.SetPen(WHITE_PEN);
    dc.DrawLine(dc.FromDIP(250), dc.FromDIP(210), dc.FromDIP(250), dc.FromDIP(170));
    dc.DrawLine(dc.FromDIP(260), dc.FromDIP(200), dc.FromDIP(150), dc.FromDIP(200));

    // test the rectangle filled drawing
    dc.SetPen(TRANSPARENT_PEN);
    dc.SetBrush(WHITE_BRUSH);
    dc.DrawRectangle(dc.FromDIP(300), dc.FromDIP(170), dc.FromDIP(49), dc.FromDIP(29));
    dc.DrawRectangle(dc.FromDIP(350), dc.FromDIP(170), dc.FromDIP(49), dc.FromDIP(29));
    dc.SetPen(WHITE_PEN);
    dc.DrawLine(dc.FromDIP(400), dc.FromDIP(170), dc.FromDIP(400), dc.FromDIP(210));
    dc.DrawLine(dc.FromDIP(300), dc.FromDIP(200), dc.FromDIP(410), dc.FromDIP(200));

    // Draw tiny rectangles, including MSW GDI edge cases.
    dc.SetPen(RED_PEN);
    dc.SetBrush(WHITE_BRUSH);
    dc.DrawRectangle(dc.FromDIP(300), dc.FromDIP(220), dc.FromDIP(1), dc.FromDIP(1));
    dc.DrawRectangle(dc.FromDIP(310), dc.FromDIP(220), dc.FromDIP(2), dc.FromDIP(2));
    dc.DrawRectangle(dc.FromDIP(320), dc.FromDIP(220), dc.FromDIP(3), dc.FromDIP(3));
    dc.DrawRectangle(dc.FromDIP(330), dc.FromDIP(220), dc.FromDIP(4), dc.FromDIP(4));

    dc.SetPen(TRANSPARENT_PEN);
    dc.SetBrush(WHITE_BRUSH);
    dc.DrawRectangle(dc.FromDIP(300), dc.FromDIP(230), dc.FromDIP(1), dc.FromDIP(1));
    dc.DrawRectangle(dc.FromDIP(310), dc.FromDIP(230), dc.FromDIP(2), dc.FromDIP(2));
    dc.DrawRectangle(dc.FromDIP(320), dc.FromDIP(230), dc.FromDIP(3), dc.FromDIP(3));
    dc.DrawRectangle(dc.FromDIP(330), dc.FromDIP(230), dc.FromDIP(4), dc.FromDIP(4));

    // and now for filled rect with outline
    dc.SetPen(RED_PEN);
    dc.SetBrush(WHITE_BRUSH);
    dc.DrawRectangle(dc.FromDIP(500), dc.FromDIP(170), dc.FromDIP(49), dc.FromDIP(29));
    dc.DrawRectangle(dc.FromDIP(550), dc.FromDIP(170), dc.FromDIP(49), dc.FromDIP(29));
    dc.SetPen(WHITE_PEN);
    dc.DrawLine(dc.FromDIP(600), dc.FromDIP(170), dc.FromDIP(600), dc.FromDIP(210));
    dc.DrawLine(dc.FromDIP(500), dc.FromDIP(200), dc.FromDIP(610), dc.FromDIP(200));

    // rounded rectangles
    dc.SetPen(WHITE_PEN);
    dc.SetBrush(TRANSPARENT_BRUSH);
    dc.DrawRoundedRectangle(dc.FromDIP(150), dc.FromDIP(270),
        dc.FromDIP(49), dc.FromDIP(29), dc.FromDIP(6));
    dc.DrawRoundedRectangle(dc.FromDIP(200), dc.FromDIP(270),
        dc.FromDIP(49), dc.FromDIP(29), dc.FromDIP(6));
    dc.SetPen(WHITE_PEN);
    dc.DrawLine(dc.FromDIP(250), dc.FromDIP(270), dc.FromDIP(250), dc.FromDIP(310));
    dc.DrawLine(dc.FromDIP(150), dc.FromDIP(300), dc.FromDIP(260), dc.FromDIP(300));

    dc.SetPen(TRANSPARENT_PEN);
    dc.SetBrush(WHITE_BRUSH);
    dc.DrawRoundedRectangle(dc.FromDIP(300), dc.FromDIP(270),
        dc.FromDIP(49), dc.FromDIP(29), dc.FromDIP(6));
    dc.DrawRoundedRectangle(dc.FromDIP(350), dc.FromDIP(270),
        dc.FromDIP(49), dc.FromDIP(29), dc.FromDIP(6));
    dc.SetPen(WHITE_PEN);
    dc.DrawLine(dc.FromDIP(400), dc.FromDIP(270), dc.FromDIP(400), dc.FromDIP(310));
    dc.DrawLine(dc.FromDIP(300), dc.FromDIP(300), dc.FromDIP(410), dc.FromDIP(300));

    // JACS' bizarre behaviour test
    const totalWidth = dc.FromDIP(70);
    const totalHeight = dc.FromDIP(70);
    const bitmap2 = createWxBitmapEmpty(totalWidth, totalHeight, BITMAP_SCREEN_DEPTH);
    if (bitmap2)
    {
        const memdc2 = createWxMemoryDCWithBitmap(bitmap2.ptr);
        if (memdc2)
        {
            memdc2.SetBackground(YELLOW_BRUSH);
            memdc2.Clear();
            memdc2.SetPen(RED_PEN);
            memdc2.SetBrush(WHITE_BRUSH);
            memdc2.DrawRectangle(0, 0, totalWidth, totalHeight);
            memdc2.Delete();
        }
        dc.DrawBitmap(bitmap2.ptr, dc.FromDIP(500), dc.FromDIP(270), false);
        bitmap2.Delete();
    }

    // Repeat, but draw directly on dc
    x = dc.FromDIP(600);
    const y2 = dc.FromDIP(270);
    dc.SetPen(YELLOW_PEN);
    dc.SetBrush(YELLOW_BRUSH);
    dc.DrawRectangle(x, y2, totalWidth, totalHeight);

    dc.SetPen(RED_PEN);
    dc.SetBrush(WHITE_BRUSH);
    dc.DrawRectangle(x, y2, totalWidth, totalHeight);
}

function drawTextScreen(dc: wxDC): void
{
    // set underlined font for testing
    setFontInfo(dc, 12, FONTFAMILY_MODERN, true, false);
    drawText(dc, "This is text", dc.FromDIP(110), dc.FromDIP(10));
    drawRotatedText(dc, "That is text", dc.FromDIP(20), dc.FromDIP(10), -45);

    dc.SetFont(SWISS_FONT);

    dc.SetBackgroundMode(BRUSHSTYLE_TRANSPARENT);

    for (let n = -180; n < 180; n += 30)
    {
        drawRotatedText(dc, `     ${n} rotated text`,
            dc.FromDIP(400), dc.FromDIP(400), n);
    }

    setFontInfo(dc, 18, FONTFAMILY_SWISS, false, false);
    drawText(dc, "This is Swiss 18pt text.", dc.FromDIP(110), dc.FromDIP(40));

    const extent = measureText(dc, "This is Swiss 18pt text.");
    const length = extent.width;
    const height = extent.height;
    const descent = extent.descent;

    drawText(dc,
        `Dimensions are length ${length}, height ${height}, descent ${descent}`,
        dc.FromDIP(110), dc.FromDIP(80));

    drawText(dc, `CharHeight() returns: ${dc.GetCharHeight()}`,
        dc.FromDIP(110), dc.FromDIP(120));

    dc.DrawRectangle(dc.FromDIP(100), dc.FromDIP(40), dc.FromDIP(4),
        dc.FromDIP(height));

    // test the logical function effect
    let y = dc.FromDIP(150);
    dc.SetLogicalFunction(INVERT);
    drawText(dc, "There should be a text below", dc.FromDIP(110), y);
    dc.DrawRectangle(dc.FromDIP(110), y, dc.FromDIP(100), height);

    y += height;
    drawText(dc, "Visible text", dc.FromDIP(110), y);
    dc.DrawRectangle(dc.FromDIP(110), y, dc.FromDIP(100), height);
    drawText(dc, "Visible text", dc.FromDIP(110), y);
    dc.DrawRectangle(dc.FromDIP(110), y, dc.FromDIP(100), height);
    dc.SetLogicalFunction(COPY);

    y += height;
    dc.DrawRectangle(dc.FromDIP(110), y, dc.FromDIP(100), height);
    drawText(dc, "Another visible text", dc.FromDIP(110), y);

    y += height;
    drawText(dc, "And\nmore\ntext on\nmultiple\nlines", dc.FromDIP(110), y);
    y += 5 * height;

    dc.SetTextForeground(BLUE);
    drawRotatedText(dc, "Rotated text\ncan have\nmultiple lines\nas well",
        dc.FromDIP(110), y, 15);

    y += 7 * height;
    setFontInfo(dc, 12, FONTFAMILY_TELETYPE, false, false);
    {
        const brown = colourRGB(150, 75, 0);
        if (brown)
        {
            dc.SetTextForeground(brown.ptr);
            drawText(dc,
                "And some text with tab characters:\n" +
                "123456789012345678901234567890\n\taa\tbbb\tcccc",
                dc.FromDIP(10), y);
            brown.Delete();
        }
    }

    dc.SetBackgroundMode(BRUSHSTYLE_TRANSPARENT);
    if (platform === "windows")
    {
        setFontInfo(dc, 12, null, false, false, "Segoe UI Emoji");
        drawText(dc, "Smile in colour (only when using Direct2D): \u{1F60A}",
            dc.FromDIP(400), y);
    }
    else
    {
        dc.SetFont(SWISS_FONT);
        drawText(dc, "Smile in colour: \u{1F60A}", dc.FromDIP(400), y);
    }
}

interface RasterOperation { name: string; rop: number }

const rasterOperations: RasterOperation[] = [
    { name: "wxAND", rop: AND },
    { name: "wxAND_INVERT", rop: AND_INVERT },
    { name: "wxAND_REVERSE", rop: AND_REVERSE },
    { name: "wxCLEAR", rop: CLEAR },
    { name: "wxCOPY", rop: COPY },
    { name: "wxEQUIV", rop: EQUIV },
    { name: "wxINVERT", rop: INVERT },
    { name: "wxNAND", rop: NAND },
    { name: "wxNO_OP", rop: NO_OP },
    { name: "wxOR", rop: OR },
    { name: "wxOR_INVERT", rop: OR_INVERT },
    { name: "wxOR_REVERSE", rop: OR_REVERSE },
    { name: "wxSET", rop: SET },
    { name: "wxSRC_INVERT", rop: SRC_INVERT },
    { name: "wxXOR", rop: XOR },
];

function drawImages(dc: wxDC, stretch: boolean): void
{
    if (!state_bitmaps.bmpNoMask || !state_bitmaps.bmpWithColMask ||
        !state_bitmaps.bmpMask || !state_bitmaps.bmpWithMask)
    {
        return;
    }

    drawText(dc, "original image", 0, 0);
    dc.DrawBitmap(state_bitmaps.bmpNoMask.ptr, 0, dc.FromDIP(20), false);
    drawText(dc, "with colour mask", 0, dc.FromDIP(100));
    dc.DrawBitmap(state_bitmaps.bmpWithColMask.ptr, 0, dc.FromDIP(120), true);
    drawText(dc, "the mask image", 0, dc.FromDIP(200));
    dc.DrawBitmap(state_bitmaps.bmpMask.ptr, 0, dc.FromDIP(220), false);
    drawText(dc, "masked image", 0, dc.FromDIP(300));
    dc.DrawBitmap(state_bitmaps.bmpWithMask.ptr, 0, dc.FromDIP(320), true);

    const cx = state_bitmaps.bmpWithColMask.GetWidth();
    const cy = state_bitmaps.bmpWithColMask.GetHeight();

    const memDC = createWxMemoryDCWithBitmap(state_bitmaps.bmpWithColMask.ptr);
    if (!memDC) return;

    for (let n = 0; n < rasterOperations.length; n++)
    {
        const x = dc.FromDIP(120) + dc.FromDIP(150) * (n % 4);
        const y = dc.FromDIP(20) + dc.FromDIP(100) * Math.trunc(n / 4);

        drawText(dc, rasterOperations[n].name, x, y - dc.FromDIP(20));
        if (stretch)
        {
            dc.StretchBlit(x, y, cx, cy, memDC.ptr, 0, 0,
                Math.trunc(cx / 2), Math.trunc(cy / 2),
                rasterOperations[n].rop, true, 0, 0);
        }
        else
        {
            dc.Blit(x, y, cx, cy, memDC.ptr, 0, 0,
                rasterOperations[n].rop, true, 0, 0);
        }
    }

    memDC.Delete();
}

function drawWithLogicalOps(dc: wxDC): void
{
    const w = dc.FromDIP(60);
    const h = dc.FromDIP(60);

    // reuse the text colour here
    if (!state_bitmaps.colourForeground) return;
    setPen(dc, state_bitmaps.colourForeground.ptr);
    dc.SetBrush(TRANSPARENT_BRUSH);

    for (let n = 0; n < rasterOperations.length; n++)
    {
        const x = dc.FromDIP(20) + dc.FromDIP(150) * (n % 4);
        const y = dc.FromDIP(20) + dc.FromDIP(100) * Math.trunc(n / 4);

        drawText(dc, rasterOperations[n].name, x, y - dc.FromDIP(20));
        dc.SetLogicalFunction(rasterOperations[n].rop);
        dc.DrawRectangle(x, y, w, h);
        dc.DrawLine(x, y, x + w, y + h);
        dc.DrawLine(x + w, y, x, y + h);
    }

    // now some filled rectangles
    setBrush(dc, state_bitmaps.colourForeground.ptr);
    for (let n = 0; n < rasterOperations.length; n++)
    {
        const x = dc.FromDIP(20) + dc.FromDIP(150) * (n % 4);
        const y = dc.FromDIP(500) + dc.FromDIP(100) * Math.trunc(n / 4);

        drawText(dc, rasterOperations[n].name, x, y - dc.FromDIP(20));
        dc.SetLogicalFunction(rasterOperations[n].rop);
        dc.DrawRectangle(x, y, w, h);
    }
}

function drawAlpha(dc: wxDC): void
{
    const margin = dc.FromDIP(20);
    const width = dc.FromDIP(180);
    const radius = dc.FromDIP(30);

    const darkRed = colourRGB(128, 0, 0);
    if (darkRed)
    {
        setPen(dc, darkRed.ptr, 12);
        dc.SetBrush(RED_BRUSH);
        darkRed.Delete();
    }

    let rx = margin;
    let ry = margin + Math.trunc(width * 2 / 3);
    dc.DrawRoundedRectangle(rx, ry, width, width, radius);

    const darkBlue = colourRGB(0, 0, 128);
    const halfBlue = colourRGB(0, 0, 255, 192);
    if (darkBlue && halfBlue)
    {
        setPen(dc, darkBlue.ptr, 12);
        const brush = createWxBrushFromColour(halfBlue.ptr, BRUSHSTYLE_SOLID);
        if (brush)
        {
            dc.SetBrush(brush.ptr);
            brush.Delete();
        }
        darkBlue.Delete();
        halfBlue.Delete();
    }

    rx += Math.trunc(width * 4 / 5);
    ry -= Math.trunc(width * 2 / 3);
    dc.DrawRoundedRectangle(rx, ry, width, width, radius);

    const olive = colourRGB(128, 128, 0);
    const yellowAlpha = colourRGB(192, 192, 0, 192);
    if (olive && yellowAlpha)
    {
        setPen(dc, olive.ptr, 12);
        const brush = createWxBrushFromColour(yellowAlpha.ptr, BRUSHSTYLE_SOLID);
        if (brush)
        {
            dc.SetBrush(brush.ptr);
            brush.Delete();
        }
        olive.Delete();
        yellowAlpha.Delete();
    }

    rx += Math.trunc(width * 4 / 5);
    ry += Math.trunc(width / 2);
    dc.DrawRoundedRectangle(rx, ry, width, width, radius);

    dc.SetPen(TRANSPARENT_PEN);
    const yellow128 = colourRGB(255, 255, 128, 128);
    if (yellow128)
    {
        const brush = createWxBrushFromColour(yellow128.ptr, BRUSHSTYLE_SOLID);
        if (brush)
        {
            dc.SetBrush(brush.ptr);
            brush.Delete();
        }
        yellow128.Delete();
    }
    dc.DrawRoundedRectangle(0, margin + Math.trunc(width / 2),
        width * 3, dc.FromDIP(100), radius);

    const textBg = colourRGB(160, 192, 160, 160);
    const textFg = colourRGB(255, 128, 128, 128);
    if (textBg)
    {
        dc.SetTextBackground(textBg.ptr);
        textBg.Delete();
    }
    if (textFg)
    {
        dc.SetTextForeground(textFg.ptr);
        textFg.Delete();
    }
    setFontInfo(dc, 40, FONTFAMILY_SWISS, false, true);
    drawText(dc, "Hello!", dc.FromDIP(120), dc.FromDIP(80));
}

function hsvToRgb(h: number, s: number, v: number): [number, number, number]
{
    const i = Math.floor(h * 6);
    const f = h * 6 - i;
    const p = v * (1 - s);
    const q = v * (1 - f * s);
    const t = v * (1 - (1 - f) * s);
    let r = 0, g = 0, b = 0;
    switch (i % 6)
    {
        case 0: r = v; g = t; b = p; break;
        case 1: r = q; g = v; b = p; break;
        case 2: r = p; g = v; b = t; break;
        case 3: r = p; g = q; b = v; break;
        case 4: r = t; g = p; b = v; break;
        case 5: r = v; g = p; b = q; break;
    }
    return [Math.round(r * 255), Math.round(g * 255), Math.round(b * 255)];
}

// DrawGraphics() — modeled along Robin Dunn's GraphicsContext.py sample.
function drawGraphics(
    state: DrawingState,
    gc: ReturnType<typeof wrapWxGraphicsContext>,
    dip: (value: number) => number,
): void
{
    const BASE = dip(80);
    const BASE2 = Math.trunc(BASE / 2);
    const BASE4 = Math.trunc(BASE / 4);

    const defaultFont = createWxFontDefault();
    if (defaultFont)
    {
        wxSystemSettings_GetFont(SYS_DEFAULT_GUI_FONT, defaultFont.ptr);
        gc.SetFont(defaultFont.ptr, BLACK);
        defaultFont.Delete();
    }

    const pathPtr = gc.CreatePath();
    if (!pathPtr) return;
    const path = new wxGraphicsPath(pathPtr);

    path.AddCircle(0, 0, BASE2);
    path.MoveToPoint(0, -BASE2);
    path.AddLineToPoint(0, BASE2);
    path.MoveToPoint(-BASE2, 0);
    path.AddLineToPoint(BASE2, 0);
    path.CloseSubpath();
    path.AddRectangle(-BASE4, -Math.trunc(BASE4 / 2), BASE2, BASE4);

    gc.PushState();
    gc.Translate(dip(60), dip(75));

    {
        const navy = withString("navy", (ptr) => createWxColourByName(ptr));
        const pink = withString("pink", (ptr) => createWxColourByName(ptr));
        if (navy)
        {
            const pen = createWxPenFromColour(navy.ptr, 0, PENSTYLE_SOLID);
            if (pen) { gc.SetPen(pen.ptr); pen.Delete(); }
            navy.Delete();
        }
        if (pink)
        {
            const brush = createWxBrushFromColour(pink.ptr, BRUSHSTYLE_SOLID);
            if (brush) { gc.SetBrush(brush.ptr); brush.Delete(); }
            pink.Delete();
        }
    }

    const labels = ["StrokePath", "FillPath", "DrawPath"];
    for (let i = 0; i < 3; i++)
    {
        const w = new Float64Array(1);
        const h = new Float64Array(1);
        withString(labels[i], (ptr) =>
        {
            gc.GetTextExtent(ptr, pointerOf(w), pointerOf(h), null, null);
            gc.DrawText(ptr, -w[0] / 2,
                -BASE2 - h[0] - dip(4));
        });

        if (i === 0) gc.StrokePath(path.ptr);
        else if (i === 1) gc.FillPath(path.ptr, ODDEVEN_RULE);
        else gc.DrawPath(path.ptr, ODDEVEN_RULE);

        gc.Translate(2 * BASE, 0);
    }

    gc.PopState();
    gc.PushState();
    gc.Translate(dip(60), dip(200));

    gcDrawText(gc, "Scale", 0, -BASE2);
    gc.Translate(0, dip(20));

    {
        const red128 = colourRGB(178, 34, 34, 128);
        if (red128)
        {
            const brush = createWxBrushFromColour(red128.ptr, BRUSHSTYLE_SOLID);
            if (brush) { gc.SetBrush(brush.ptr); brush.Delete(); }
            red128.Delete();
        }
    }
    for (let i = 0; i < 8; i++)
    {
        gc.Scale(1.08, 1.08);
        gc.Translate(dip(5), dip(5));
        gc.DrawPath(path.ptr, ODDEVEN_RULE);
    }

    gc.PopState();
    gc.PushState();
    gc.Translate(dip(400), dip(200));

    gcDrawText(gc, "Rotate", 0, -BASE2);
    gc.Translate(0, dip(75));

    for (let angle = 0; angle < 360; angle += 30)
    {
        gc.PushState();

        const [r, g, b] = hsvToRgb(angle / 360.0, 1, 1);
        {
            const fill = colourRGB(r, g, b, 64);
            const stroke = colourRGB(r, g, b, 128);
            if (fill)
            {
                const brush = createWxBrushFromColour(fill.ptr, BRUSHSTYLE_SOLID);
                if (brush) { gc.SetBrush(brush.ptr); brush.Delete(); }
                fill.Delete();
            }
            if (stroke)
            {
                const pen = createWxPenFromColour(stroke.ptr, 0, PENSTYLE_SOLID);
                if (pen) { gc.SetPen(pen.ptr); pen.Delete(); }
                stroke.Delete();
            }
        }

        gc.Translate(1.5 * BASE2 * Math.cos(degToRad(angle)),
            1.5 * BASE2 * Math.sin(degToRad(angle)));
        gc.Rotate(degToRad(angle));
        gc.DrawPath(path.ptr, ODDEVEN_RULE);
        gc.PopState();
    }
    gc.PopState();

    gc.PushState();
    gc.Translate(dip(60), dip(400));
    const labelText = "Scaled smiley inside a square";
    gcDrawText(gc, labelText, 0, 0);

    const textWidth = new Float64Array(1);
    withString(labelText, (ptr) =>
    {
        gc.GetTextExtent(ptr, pointerOf(textWidth), null, null, null);
    });
    const rectSize = dip(100);
    const x0 = (textWidth[0] - rectSize) / 2;
    gc.DrawRectangle(x0, BASE2, rectSize, rectSize);
    if (state.smileBmp && state.smileBmp.IsOk())
    {
        const gbmp = gc.CreateBitmap(state.smileBmp.ptr);
        if (gbmp) gc.DrawBitmap(gbmp, x0, BASE2, rectSize, rectSize);
    }
    gc.PopState();

    // Draw graphics bitmap and its subbitmap
    gc.PushState();
    gc.Translate(dip(300), dip(400));
    gcDrawText(gc, "Smiley as a graphics bitmap", 0, 0);

    if (state.smileBmp && state.smileBmp.IsOk())
    {
        const gbmp1 = gc.CreateBitmap(state.smileBmp.ptr);
        if (gbmp1)
        {
            gc.DrawBitmap(gbmp1, 0, BASE2, dip(50), dip(50));
            const bmpw = state.smileBmp.GetWidth();
            const bmph = state.smileBmp.GetHeight();
            const gbmp2 = gc.CreateSubBitmap(gbmp1, 0, Math.trunc(bmph / 5),
                Math.trunc(bmpw / 2), Math.trunc(bmph / 2));
            if (gbmp2)
            {
                gc.DrawBitmap(gbmp2, dip(80), BASE2, dip(50),
                    dip(50) * (bmph / 2) / (bmpw / 2));
            }
        }
    }
    gc.PopState();

    path.Delete();
}

function gcDrawText(
    gc: ReturnType<typeof wrapWxGraphicsContext>,
    text: string,
    x: number,
    y: number,
): void
{
    withString(text, (ptr) => gc.DrawText(ptr, x, y));
}

function withFourStrings<T>(
    a: string, b: string, c: string, d: string,
    fn: (pa: Pointer, pb: Pointer, pc: Pointer, pd: Pointer) => T,
): T
{
    return withString(a, (pa) => withString(b, (pb) => withString(c, (pc) =>
        withString(d, (pd) => fn(pa, pb, pc, pd)))));
}

function drawCircles(dc: wxDC): void
{
    const x = dc.FromDIP(100);
    let y = dc.FromDIP(100);
    const r = dc.FromDIP(20);

    dc.SetPen(RED_PEN);
    dc.SetBrush(GREEN_BRUSH);

    drawText(dc, "Some circles", 0, y);
    dc.DrawCircle(x, y, r);
    dc.DrawCircle(x + 2 * r, y, r);
    dc.DrawCircle(x + 4 * r, y, r);

    y += 2 * r;
    drawText(dc, "And ellipses", 0, y);
    dc.DrawEllipse(x - r, y, 2 * r, r);
    dc.DrawEllipse(x + r, y, 2 * r, r);
    dc.DrawEllipse(x + 3 * r, y, 2 * r, r);

    y += 2 * r;
    drawText(dc, "And arcs", 0, y);
    dc.DrawArc(x - r, y, x + r, y, x, y);
    dc.DrawArc(x + 4 * r, y, x + 2 * r, y, x + 3 * r, y);
    dc.DrawArc(x + 5 * r, y, x + 5 * r, y, x + 6 * r, y);

    y += 2 * r;
    dc.DrawEllipticArc(x - r, y, 2 * r, r, 0, 90);
    dc.DrawEllipticArc(x + r, y, 2 * r, r, 90, 180);
    dc.DrawEllipticArc(x + 3 * r, y, 2 * r, r, 180, 270);
    dc.DrawEllipticArc(x + 5 * r, y, 2 * r, r, 270, 360);

    // same as above, just transparent brush
    dc.SetPen(RED_PEN);
    dc.SetBrush(TRANSPARENT_BRUSH);

    y += 2 * r;
    drawText(dc, "Some circles", 0, y);
    dc.DrawCircle(x, y, r);
    dc.DrawCircle(x + 2 * r, y, r);
    dc.DrawCircle(x + 4 * r, y, r);

    y += 2 * r;
    drawText(dc, "And ellipses", 0, y);
    dc.DrawEllipse(x - r, y, 2 * r, r);
    dc.DrawEllipse(x + r, y, 2 * r, r);
    dc.DrawEllipse(x + 3 * r, y, 2 * r, r);

    y += 2 * r;
    drawText(dc, "And arcs", 0, y);
    dc.DrawArc(x - r, y, x + r, y, x, y);
    dc.DrawArc(x + 4 * r, y, x + 2 * r, y, x + 3 * r, y);
    dc.DrawArc(x + 5 * r, y, x + 5 * r, y, x + 6 * r, y);

    y += 2 * r;
    dc.DrawEllipticArc(x - r, y, 2 * r, r, 0, 90);
    dc.DrawEllipticArc(x + r, y, 2 * r, r, 90, 180);
    dc.DrawEllipticArc(x + 3 * r, y, 2 * r, r, 180, 270);
    dc.DrawEllipticArc(x + 5 * r, y, 2 * r, r, 270, 360);
}

function drawSplines(dc: wxDC): void
{
    drawText(dc, "Some splines", dc.FromDIP(10), dc.FromDIP(5));

    const R = dc.FromDIP(300);
    const centerX = R + dc.FromDIP(20);
    const centerY = R + dc.FromDIP(20);
    const angles = [0, 10, 33, 77, 13, 145, 90];
    const radii = [100, 59, 85, 33, 90];
    const numPoints = 200;
    const xs = new Int32Array(numPoints);
    const ys = new Int32Array(numPoints);

    let radiusPos = 0;
    let anglePos = 0;
    let angle = 0;
    for (let i = 0; i < numPoints; i++)
    {
        angle += angles[anglePos];
        const r = Math.trunc(R * radii[radiusPos] / 100);
        xs[i] = centerX + Math.trunc(r * Math.cos(degToRad(angle)));
        ys[i] = centerY + Math.trunc(r * Math.sin(degToRad(angle)));

        anglePos++;
        if (anglePos >= angles.length) anglePos = 0;
        radiusPos++;
        if (radiusPos >= radii.length) radiusPos = 0;
    }

    dc.SetPen(RED_PEN);
    dc.DrawSplinePoints(numPoints, pointerOf(xs), pointerOf(ys));

    // less detailed spline calculation
    const letters: [number, number][][] = [
        [[0, 1], [1, 3], [2, 2], [3, 3], [4, 1]],
        [[5, 1], [6, 1], [7, 2], [8, 3], [9, 3]],
        [[5, 3], [6, 3], [7, 2], [8, 1], [9, 1]],
        [[10, 0], [11, 3], [12, 1], [13, 3], [14, 0]],
    ];

    const dx = Math.trunc(2 * R / letters[3][4][0]);
    const h = [-Math.trunc(R / 2), 0, Math.trunc(R / 4), Math.trunc(R / 2)];

    for (let m = 0; m < 4; m++)
    {
        const lx = new Int32Array(5);
        const ly = new Int32Array(5);
        for (let n = 0; n < 5; n++)
        {
            lx[n] = centerX - R + letters[m][n][0] * dx;
            ly[n] = centerY + h[letters[m][n][1]];
        }

        setPen(dc, BLUE, 1, PENSTYLE_DOT);
        dc.DrawLines(5, pointerOf(lx), pointerOf(ly), 0, 0);
        setPen(dc, BLACK, 4);
        dc.DrawSplinePoints(5, pointerOf(lx), pointerOf(ly));
    }
}

function offsetRect(r: Rect, dx: number, dy: number): void
{
    r.x += dx;
    r.y += dy;
}

function deflateRect(r: Rect, delta: number): void
{
    r.x += delta;
    r.y += delta;
    r.w -= 2 * delta;
    r.h -= 2 * delta;
}

function drawGradients(dc: wxDC): void
{
    const TEXT_HEIGHT = dc.GetCharHeight();

    // LHS: linear
    let r: Rect = { x: dc.FromDIP(10), y: dc.FromDIP(10), w: dc.FromDIP(50), h: dc.FromDIP(50) };
    drawText(dc, "wxRIGHT", r.x, r.y);
    offsetRect(r, 0, TEXT_HEIGHT);
    dc.GradientFillLinear(r.x, r.y, r.w, r.h, WHITE, BLUE, RIGHT);

    offsetRect(r, 0, r.h + dc.FromDIP(10));
    drawText(dc, "wxLEFT", r.x, r.y);
    offsetRect(r, 0, TEXT_HEIGHT);
    dc.GradientFillLinear(r.x, r.y, r.w, r.h, WHITE, BLUE, LEFT);

    offsetRect(r, 0, r.h + dc.FromDIP(10));
    drawText(dc, "wxDOWN", r.x, r.y);
    offsetRect(r, 0, TEXT_HEIGHT);
    dc.GradientFillLinear(r.x, r.y, r.w, r.h, WHITE, BLUE, DOWN);

    offsetRect(r, 0, r.h + dc.FromDIP(10));
    drawText(dc, "wxUP", r.x, r.y);
    offsetRect(r, 0, TEXT_HEIGHT);
    dc.GradientFillLinear(r.x, r.y, r.w, r.h, WHITE, BLUE, UP);

    // RHS: concentric
    r = { x: dc.FromDIP(200), y: dc.FromDIP(10), w: dc.FromDIP(50), h: dc.FromDIP(50) };
    drawText(dc, "Blue inside", r.x, r.y);
    offsetRect(r, 0, TEXT_HEIGHT);
    dc.GradientFillConcentric(r.x, r.y, r.w, r.h, BLUE, WHITE);

    offsetRect(r, 0, r.h + dc.FromDIP(10));
    drawText(dc, "White inside", r.x, r.y);
    offsetRect(r, 0, TEXT_HEIGHT);
    dc.GradientFillConcentric(r.x, r.y, r.w, r.h, WHITE, BLUE);

    offsetRect(r, 0, r.h + dc.FromDIP(10));
    drawText(dc, "Blue in top left corner", r.x, r.y);
    offsetRect(r, 0, TEXT_HEIGHT);
    dc.GradientFillConcentricCenter(r.x, r.y, r.w, r.h, BLUE, WHITE, 0, 0);

    offsetRect(r, 0, r.h + dc.FromDIP(10));
    drawText(dc, "Blue in bottom right corner", r.x, r.y);
    offsetRect(r, 0, TEXT_HEIGHT);
    dc.GradientFillConcentricCenter(r.x, r.y, r.w, r.h, BLUE, WHITE, r.w, r.h);

    // check that the area filled by the gradient is exactly the interior
    r.x = dc.FromDIP(350);
    r.y = dc.FromDIP(30);
    drawText(dc, "The interior should be filled but", r.x, r.y);
    r.y += TEXT_HEIGHT;
    drawText(dc, " the red border should remain visible:", r.x, r.y);
    r.y += TEXT_HEIGHT;

    r.w = dc.FromDIP(50);
    r.h = dc.FromDIP(50);
    const r2: Rect = { ...r, x: r.x + dc.FromDIP(60) };
    const r3: Rect = { ...r, y: r.y + dc.FromDIP(60) };
    const r4: Rect = { ...r2, y: r2.y + dc.FromDIP(60) };

    dc.SetPen(RED_PEN);
    drawRectangleRect(dc, r);
    deflateRect(r, 1);
    dc.GradientFillLinear(r.x, r.y, r.w, r.h, GREEN, BLACK, NORTH);
    drawRectangleRect(dc, r2);
    deflateRect(r2, 1);
    dc.GradientFillLinear(r2.x, r2.y, r2.w, r2.h, BLACK, GREEN, SOUTH);
    drawRectangleRect(dc, r3);
    deflateRect(r3, 1);
    dc.GradientFillLinear(r3.x, r3.y, r3.w, r3.h, GREEN, BLACK, EAST);
    drawRectangleRect(dc, r4);
    deflateRect(r4, 1);
    dc.GradientFillLinear(r4.x, r4.y, r4.w, r4.h, BLACK, GREEN, WEST);

    // BINDING GAP: the wxGraphicsGradientStops-based gradient demos need
    // wxGraphicsGradientStops / wxGraphicsPenInfo, which are not bound.
}

function drawColour(
    dc: wxDC,
    mono: wxFont | null,
    x: number,
    r: Rect,
    colourName: string,
    col: wxColour | null,
): void
{
    if (!col) return;

    const prev = getFontCopy(dc);
    if (mono) dc.SetFont(mono.ptr);

    const html = readAndDeleteWxString(col.GetAsString(BigInt(C2S_HTML_SYNTAX)));
    drawText(dc, html, x, r.y);

    if (prev)
    {
        dc.SetFont(prev.ptr);
        prev.Delete();
    }

    setBrush(dc, col.ptr);
    drawRectangleRect(dc, r);

    drawText(dc, colourName, r.x + r.w - 1 + x, r.y);
}

interface NamedSystemColour { index: number; name: string }

const sysColours: NamedSystemColour[] = [
    { index: SYS_COLOUR_3DDKSHADOW, name: "wxSYS_COLOUR_3DDKSHADOW" },
    { index: SYS_COLOUR_3DLIGHT, name: "wxSYS_COLOUR_3DLIGHT" },
    { index: SYS_COLOUR_ACTIVEBORDER, name: "wxSYS_COLOUR_ACTIVEBORDER" },
    { index: SYS_COLOUR_ACTIVECAPTION, name: "wxSYS_COLOUR_ACTIVECAPTION" },
    { index: SYS_COLOUR_APPWORKSPACE, name: "wxSYS_COLOUR_APPWORKSPACE" },
    { index: SYS_COLOUR_BTNFACE, name: "wxSYS_COLOUR_BTNFACE" },
    { index: SYS_COLOUR_BTNHIGHLIGHT, name: "wxSYS_COLOUR_BTNHIGHLIGHT" },
    { index: SYS_COLOUR_BTNSHADOW, name: "wxSYS_COLOUR_BTNSHADOW" },
    { index: SYS_COLOUR_BTNTEXT, name: "wxSYS_COLOUR_BTNTEXT" },
    { index: SYS_COLOUR_CAPTIONTEXT, name: "wxSYS_COLOUR_CAPTIONTEXT" },
    { index: SYS_COLOUR_DESKTOP, name: "wxSYS_COLOUR_DESKTOP" },
    { index: SYS_COLOUR_GRADIENTACTIVECAPTION, name: "wxSYS_COLOUR_GRADIENTACTIVECAPTION" },
    { index: SYS_COLOUR_GRADIENTINACTIVECAPTION, name: "wxSYS_COLOUR_GRADIENTINACTIVECAPTION" },
    { index: SYS_COLOUR_GRAYTEXT, name: "wxSYS_COLOUR_GRAYTEXT" },
    { index: SYS_COLOUR_HIGHLIGHTTEXT, name: "wxSYS_COLOUR_HIGHLIGHTTEXT" },
    { index: SYS_COLOUR_HIGHLIGHT, name: "wxSYS_COLOUR_HIGHLIGHT" },
    { index: SYS_COLOUR_HOTLIGHT, name: "wxSYS_COLOUR_HOTLIGHT" },
    { index: SYS_COLOUR_INACTIVEBORDER, name: "wxSYS_COLOUR_INACTIVEBORDER" },
    { index: SYS_COLOUR_INACTIVECAPTIONTEXT, name: "wxSYS_COLOUR_INACTIVECAPTIONTEXT" },
    { index: SYS_COLOUR_INACTIVECAPTION, name: "wxSYS_COLOUR_INACTIVECAPTION" },
    { index: SYS_COLOUR_INFOBK, name: "wxSYS_COLOUR_INFOBK" },
    { index: SYS_COLOUR_INFOTEXT, name: "wxSYS_COLOUR_INFOTEXT" },
    { index: SYS_COLOUR_LISTBOXHIGHLIGHTTEXT, name: "wxSYS_COLOUR_LISTBOXHIGHLIGHTTEXT" },
    { index: SYS_COLOUR_LISTBOXTEXT, name: "wxSYS_COLOUR_LISTBOXTEXT" },
    { index: SYS_COLOUR_LISTBOX, name: "wxSYS_COLOUR_LISTBOX" },
    { index: SYS_COLOUR_MENUBAR, name: "wxSYS_COLOUR_MENUBAR" },
    { index: SYS_COLOUR_MENUHILIGHT, name: "wxSYS_COLOUR_MENUHILIGHT" },
    { index: SYS_COLOUR_MENUTEXT, name: "wxSYS_COLOUR_MENUTEXT" },
    { index: SYS_COLOUR_MENU, name: "wxSYS_COLOUR_MENU" },
    { index: SYS_COLOUR_SCROLLBAR, name: "wxSYS_COLOUR_SCROLLBAR" },
    { index: SYS_COLOUR_WINDOWFRAME, name: "wxSYS_COLOUR_WINDOWFRAME" },
    { index: SYS_COLOUR_WINDOWTEXT, name: "wxSYS_COLOUR_WINDOWTEXT" },
    { index: SYS_COLOUR_WINDOW, name: "wxSYS_COLOUR_WINDOW" },
    { index: SYS_COLOUR_GRIDLINES, name: "wxSYS_COLOUR_GRIDLINES" },
    { index: SYS_COLOUR_LISTBOXHIGHLIGHT, name: "wxSYS_COLOUR_LISTBOXHIGHLIGHT" },
];

function drawSystemColours(dc: wxDC): void
{
    const mono = makeFontInfo(null, FONTFAMILY_TELETYPE);
    const textWidth = new Int32Array(1);
    const textHeight = new Int32Array(1);

    {
        const prev = getFontCopy(dc);
        if (mono) dc.SetFont(mono.ptr);
        withString("#01234567", (ptr) =>
        {
            dc.GetTextExtent(ptr, pointerOf(textWidth), pointerOf(textHeight), null, null, null);
        });
        if (prev)
        {
            dc.SetFont(prev.ptr);
            prev.Delete();
        }
    }

    const lineHeight = textHeight[0];
    const x = dc.FromDIP(10);
    const r: Rect = {
        x: textWidth[0] + x, y: x, w: dc.FromDIP(100), h: lineHeight,
    };

    drawText(dc, "System colours", x, r.y);
    r.y += 2 * lineHeight;

    const appearancePtr = wxSystemSettings_GetAppearance();
    if (appearancePtr)
    {
        const appearance = wrapWxSystemAppearance(appearancePtr);
        const appearanceName = readAndDeleteWxString(appearance.GetName());
        if (appearanceName)
        {
            drawText(dc, `System appearance: ${appearanceName}`, x, r.y);
            r.y += lineHeight;
        }

        // BINDING GAP: wxSystemAppearance only exposes IsDark() and
        // IsUsingDarkBackground(); IsSystemDark()/AreAppsDark() are not bound.
        const showDarkOrLight = (what: string, dark: boolean): void =>
        {
            drawText(dc, `${what}: ${dark ? "dark" : "light"}`, x, r.y);
            r.y += Math.trunc(lineHeight * 3 / 2);
        };
        showDarkOrLight("Current app", appearance.IsDark());
        showDarkOrLight("Background", appearance.IsUsingDarkBackground());
    }

    r.y += lineHeight;

    dc.SetPen(TRANSPARENT_PEN);

    for (const entry of sysColours)
    {
        const colour = createWxColourEmpty();
        if (colour)
        {
            wxSystemSettings_GetColour(entry.index, colour.ptr);
            drawColour(dc, mono, x, r, entry.name, colour);
            colour.Delete();
        }
        r.y += lineHeight;
    }

    if (mono) mono.Delete();
}

function drawDatabaseColours(dc: wxDC): void
{
    // BINDING GAP: wxColourDatabase (wxTheColourDatabase->GetAllNames()) is
    // not bound, so the list of database colour names cannot be produced.
    // The title is drawn at the same position as the original.
    const x = dc.FromDIP(10);
    drawText(dc, "wxColourDatabase colours", x, x);
}

const stockNames: string[] = [
    "NONE", "ARROW", "RIGHT_ARROW", "BULLSEYE", "CHAR", "CROSS", "HAND",
    "IBEAM", "LEFT_BUTTON", "MAGNIFIER", "MIDDLE_BUTTON", "NO_ENTRY",
    "PAINT_BRUSH", "PENCIL", "POINT_LEFT", "POINT_RIGHT", "QUESTION_ARROW",
    "RIGHT_BUTTON", "SIZENESW", "SIZENS", "SIZENWSE", "SIZEWE", "SIZING",
    "SPRAYCAN", "WAIT", "WATCH", "BLANK",
];

const stockCursorValues: number[] = [
    CURSOR_NONE, CURSOR_ARROW, CURSOR_RIGHT_ARROW, CURSOR_BULLSEYE,
    CURSOR_CHAR, CURSOR_CROSS, CURSOR_HAND, CURSOR_IBEAM,
    CURSOR_LEFT_BUTTON, CURSOR_MAGNIFIER, CURSOR_MIDDLE_BUTTON,
    CURSOR_NO_ENTRY, CURSOR_PAINT_BRUSH, CURSOR_PENCIL, CURSOR_POINT_LEFT,
    CURSOR_POINT_RIGHT, CURSOR_QUESTION_ARROW, CURSOR_RIGHT_BUTTON,
    CURSOR_SIZENESW, CURSOR_SIZENS, CURSOR_SIZENWSE, CURSOR_SIZEWE,
    CURSOR_SIZING, CURSOR_SPRAYCAN, CURSOR_WAIT, CURSOR_WATCH, CURSOR_BLANK,
];

function drawCursors(dc: wxDC, state: DrawingState): void
{
    const stockNamesCount = stockNames.length;
    state.cursorRects = new Array<Rect>(stockNamesCount);

    const x = dc.FromDIP(10);
    let y = x;

    dc.SetBackgroundMode(BRUSHSTYLE_TRANSPARENT);
    drawText(dc,
        `System cursor size: ${wxSystemSettings_GetMetric(SYS_CURSOR_X)}x` +
        `${wxSystemSettings_GetMetric(SYS_CURSOR_Y)}`,
        x, y);

    const w = dc.FromDIP(200);
    const h = wxSystemSettings_GetMetric(SYS_CURSOR_Y);
    const margin = dc.GetCharWidth();

    y += h;
    let r: Rect = { x, y, w: 2 * w + margin, h };
    state.cursorRects[0] = r;
    drawRectangleRect(dc, r);

    r.x += margin;
    drawLabel(dc, "Hover over this rectangle to see the custom cursor",
        r.x, r.y, r.w, r.h, ALIGN_LEFT | ALIGN_CENTER_VERTICAL);

    y += h + margin;
    drawText(dc, "Hover over a rectangle to see the corresponding stock cursor", x, y);

    y += h;

    for (let n = 1; n < stockNamesCount; ++n)
    {
        r = { x, y, w, h };
        if (n % 2)
        {
            r.x += w + margin;
        }
        else
        {
            y += h + margin;
        }

        state.cursorRects[n] = r;
        drawRectangleRect(dc, r);

        r.x += margin;
        drawLabel(dc, stockNames[n], r.x, r.y, r.w, r.h,
            ALIGN_LEFT | ALIGN_CENTER_VERTICAL);
    }
}

function drawRegions(dc: wxDC): void
{
    drawText(dc,
        "You should see a red rect partly covered by a cyan one on the left",
        dc.FromDIP(10), dc.FromDIP(5));
    drawText(dc,
        "and 5 smileys from which 4 are partially clipped on the right",
        dc.FromDIP(10), dc.FromDIP(5) + dc.GetCharHeight());
    drawText(dc,
        "The second copy should be identical but right part of it should be offset by 10 pixels.",
        dc.FromDIP(10), dc.FromDIP(5) + 2 * dc.GetCharHeight());

    drawRegionsHelper(dc, dc.FromDIP(10), true);
    drawRegionsHelper(dc, dc.FromDIP(350), false);
}

function drawRegionsHelper(dc: wxDC, x: number, firstTime: boolean): void
{
    const y = dc.FromDIP(100);

    dc.DestroyClippingRegion();
    dc.SetBrush(WHITE_BRUSH);
    dc.SetPen(TRANSPARENT_PEN);
    dc.DrawRectangle(x, y, dc.FromDIP(310), dc.FromDIP(310));

    dc.SetClippingRegion(x + dc.FromDIP(10), y + dc.FromDIP(10),
        dc.FromDIP(100), dc.FromDIP(270));

    dc.SetBrush(RED_BRUSH);
    dc.DrawRectangle(x, y, dc.FromDIP(310), dc.FromDIP(310));

    dc.SetClippingRegion(x + dc.FromDIP(10), y + dc.FromDIP(10),
        dc.FromDIP(100), dc.FromDIP(100));

    dc.SetBrush(CYAN_BRUSH);
    dc.DrawRectangle(x, y, dc.FromDIP(310), dc.FromDIP(310));

    dc.DestroyClippingRegion();

    const offset = firstTime ? 0 : dc.FromDIP(10);
    const region = createWxRegionFromRect(
        x + dc.FromDIP(110) + offset,
        y + dc.FromDIP(20) + offset,
        dc.FromDIP(100), dc.FromDIP(270));
    if (!region) return;

    dc.SetDeviceClippingRegion(region.ptr);

    dc.SetBrush(GREY_BRUSH);
    dc.DrawRectangle(x, y, dc.FromDIP(310), dc.FromDIP(310));

    if (state_bitmaps.smileBmp && state_bitmaps.smileBmp.IsOk())
    {
        const bmp = state_bitmaps.smileBmp.ptr;
        dc.DrawBitmap(bmp, x + dc.FromDIP(150), y + dc.FromDIP(150), true);
        dc.DrawBitmap(bmp, x + dc.FromDIP(130), y + dc.FromDIP(10), true);
        dc.DrawBitmap(bmp, x + dc.FromDIP(130), y + dc.FromDIP(280), true);
        dc.DrawBitmap(bmp, x + dc.FromDIP(100), y + dc.FromDIP(70), true);
        dc.DrawBitmap(bmp, x + dc.FromDIP(200), y + dc.FromDIP(70), true);
    }

    region.Delete();
}

// ---------------------------------------------------------------------------
// PrepareDC (MyFrame::PrepareDC)
// ---------------------------------------------------------------------------

function framePrepareDC(state: DrawingState, dc: wxDC): void
{
    if (dc.CanUseTransformMatrix())
    {
        const matrix = createWxAffineMatrix2D();
        if (matrix)
        {
            matrix.Translate(state.transformDx, state.transformDy);
            matrix.Rotate(degToRad(state.transformRot));
            matrix.Scale(state.transformScx, state.transformScy);
            dc.SetTransformMatrix(matrix.ptr);
            matrix.Delete();
        }
    }

    dc.SetLogicalOrigin(dc.FromDIP(state.xLogicalOrigin), dc.FromDIP(state.yLogicalOrigin));
    dc.SetAxisOrientation(!state.xAxisReversed, state.yAxisReversed);
    dc.SetUserScale(state.xUserScale, state.yUserScale);
    dc.SetMapMode(state.mapMode);
}

// ---------------------------------------------------------------------------
// MyCanvas::Draw / OnPaint
// ---------------------------------------------------------------------------

function drawCanvas(state: DrawingState, pdc: wxDC, screen: boolean): void
{
    state_bitmaps = state;

    let gcdc: wxGCDC | null = null;
    let dc: wxDC = pdc;

    if (state.renderer)
    {
        const candidate = createWxGCDC(pdc.ptr);
        if (candidate)
        {
            const gcPtr = lib.symbols.wxGraphicsRenderer_CreateContext(
                state.renderer, pdc.ptr);
            if (gcPtr)
            {
                const gc = wrapWxGraphicsContext(gcPtr);
                gc.SetAntialiasMode(
                    state.useAntiAliasing ? ANTIALIAS_DEFAULT : ANTIALIAS_NONE);
                candidate.SetGraphicsContext(gc.ptr);

                const bgColour = createWxColourEmpty();
                if (bgColour)
                {
                    state.canvas.GetBackgroundColour(bgColour.ptr);
                    const bgBrush = createWxBrushFromColour(bgColour.ptr, BRUSHSTYLE_SOLID);
                    if (bgBrush)
                    {
                        candidate.SetBackground(bgBrush.ptr);
                        bgBrush.Delete();
                    }
                    bgColour.Delete();
                }
            }
            gcdc = candidate;
            dc = candidate;
        }
    }

    try
    {
        state.canvas.PrepareDC(dc.ptr);
        framePrepareDC(state, dc);

        dc.SetBackgroundMode(state.backgroundMode);
        if (state.backgroundBrush)
        {
            dc.SetBackground(state.backgroundBrush.ptr);
        }
        if (state.colourForeground && state.colourForeground.IsOk())
        {
            dc.SetTextForeground(state.colourForeground.ptr);
        }
        if (state.colourBackground && state.colourBackground.IsOk())
        {
            dc.SetTextBackground(state.colourBackground.ptr);
        }

        if (state.textureBackground && !state.backgroundBrush)
        {
            const green = colourRGB(0, 128, 0);
            if (green)
            {
                const brush = createWxBrushFromColour(green.ptr, BRUSHSTYLE_SOLID);
                if (brush)
                {
                    dc.SetBackground(brush.ptr);
                    brush.Delete();
                }
                green.Delete();
            }
        }

        if (state.clip)
        {
            dc.SetClippingRegion(dc.FromDIP(100), dc.FromDIP(100),
                dc.FromDIP(100), dc.FromDIP(100));
        }

        dc.Clear();

        if (state.textureBackground)
        {
            dc.SetPen(MEDIUM_GREY_PEN);
            for (let i = 0; i < 200; i++)
            {
                dc.DrawLine(0, dc.FromDIP(i * 10), dc.FromDIP(i * 10), 0);
            }
        }

        switch (state.show)
        {
            case File_ShowDefault:
                drawDefault(dc);
                break;
            case File_ShowCircles:
                drawCircles(dc);
                break;
            case File_ShowSplines:
                drawSplines(dc);
                break;
            case File_ShowRegions:
                drawRegions(dc);
                break;
            case File_ShowText:
                drawTextScreen(dc);
                break;
            case File_ShowLines:
                drawTestLines(dc, 0, 100, 0);
                drawTestLines(dc, 0, 320, 1);
                drawTestLines(dc, 0, 540, 2);
                drawTestLines(dc, 0, 760, 6);
                drawCrossHair(dc, 0, 0, 400, 90);
                break;
            case File_ShowBrushes:
                drawTestBrushes(dc);
                break;
            case File_ShowPolygons:
                drawTestPoly(dc);
                break;
            case File_ShowMask:
                drawImages(dc, false);
                break;
            case File_ShowMaskStretch:
                drawImages(dc, true);
                break;
            case File_ShowOps:
                drawWithLogicalOps(dc);
                break;
            case File_ShowAlpha:
                drawAlpha(dc);
                break;
            case File_ShowGraphics:
                {
                    const gcPtr = dc.GetGraphicsContext();
                    if (gcPtr)
                    {
                        const gc = wrapWxGraphicsContext(gcPtr);
                        drawGraphics(state, gc, (value) => dc.FromDIP(value));
                    }
                }
                break;
            case File_ShowGradients:
                drawGradients(dc);
                break;
            case File_ShowSystemColours:
                drawSystemColours(dc);
                break;
            case File_ShowDatabaseColours:
                drawDatabaseColours(dc);
                break;
            case File_ShowCursors:
                drawCursors(dc, state);
                break;
            default:
                break;
        }

        // Rubber band instead of the C++ wxOverlay: the selection rectangle is
        // stored and repainted with the canvas, giving the same visual result.
        if (state.rubberBand)
        {
            const band = normalizeRect(
                state.anchorX, state.anchorY, state.currentX, state.currentY);
            dc.SetPen(GREY_PEN);
            const fill = colourRGB(192, 192, 192, 64);
            if (fill)
            {
                const brush = createWxBrushFromColour(fill.ptr, BRUSHSTYLE_SOLID);
                if (brush)
                {
                    dc.SetBrush(brush.ptr);
                    brush.Delete();
                }
                fill.Delete();
            }
            dc.DrawRectangle(band.x, band.y, band.w, band.h);
        }

        // For drawing with raw wxGraphicsContext there is no bounding box.
        if (state.showBBox && state.show !== File_ShowGraphics)
        {
            const green = colourRGB(0, 128, 0);
            if (green)
            {
                setPen(dc, green.ptr, 1, PENSTYLE_DOT);
                green.Delete();
            }
            dc.SetBrush(TRANSPARENT_BRUSH);
            dc.DrawRectangle(dc.MinX(), dc.MinY(),
                dc.MaxX() - dc.MinX() + 1, dc.MaxY() - dc.MinY() + 1);
        }

        // Adjust drawing area dimensions only if screen drawing is invoked.
        if (screen)
        {
            const x0 = new Int32Array(1);
            const y0 = new Int32Array(1);
            dc.GetDeviceOrigin(pointerOf(x0), pointerOf(y0));
            state.sizeDIPW =
                dc.ToDIP(dc.LogicalToDeviceX(dc.MaxX()) - x0[0]) + 1;
            state.sizeDIPH =
                dc.ToDIP(dc.LogicalToDeviceY(dc.MaxY()) - y0[0]) + 1;
        }
    }
    finally
    {
        if (gcdc) gcdc.Delete();
    }
}

function onPaint(state: DrawingState): void
{
    let dc: wxDC | null;
    if (state.useBuffer)
    {
        dc = createWxBufferedPaintDC(state.canvas.ptr, 0);
    }
    else
    {
        dc = createWxPaintDC(state.canvas.ptr);
    }
    if (!dc) return;
    try
    {
        drawCanvas(state, dc, true);
    }
    finally
    {
        dc.Delete();
    }
}

// ---------------------------------------------------------------------------
// Mouse handling
// ---------------------------------------------------------------------------

function stopRubberBanding(state: DrawingState): boolean
{
    if (!state.rubberBand) return false;
    state.rubberBand = false;
    state.canvas.Refresh(true);
    return true;
}

function onMouseMove(state: DrawingState, event: wxMouseEvent): void
{
    {
        const dc = createWxClientDC(state.canvas.ptr);
        if (dc)
        {
            state.canvas.PrepareDC(dc.ptr);
            framePrepareDC(state, dc);

            const posX = dc.DeviceToLogicalX(event.GetX());
            const posY = dc.DeviceToLogicalY(event.GetY());
            const dipX = dc.ToDIP(posX);
            const dipY = dc.ToDIP(posY);
            let text = `Mouse position: ${posX},${posY}`;
            if (posX !== dipX || posY !== dipY)
            {
                text += `; DIP position: ${dipX},${dipY}`;
            }
            setStatus(state, text, 0);
            dc.Delete();
        }
    }

    if (state.rubberBand)
    {
        const xx = new Int32Array(1);
        const yy = new Int32Array(1);
        state.canvas.CalcUnscrolledPosition(event.GetX(), event.GetY(),
            pointerOf(xx), pointerOf(yy));
        state.currentX = xx[0];
        state.currentY = yy[0];
        state.canvas.Refresh(true);
    }
}

function onMouseDown(state: DrawingState, event: wxMouseEvent): void
{
    const xx = new Int32Array(1);
    const yy = new Int32Array(1);
    state.canvas.CalcUnscrolledPosition(event.GetX(), event.GetY(),
        pointerOf(xx), pointerOf(yy));
    state.anchorX = xx[0];
    state.anchorY = yy[0];
    state.currentX = state.anchorX;
    state.currentY = state.anchorY;
    state.rubberBand = true;
    state.canvas.CaptureMouse();
}

function onMouseUp(state: DrawingState, event: wxMouseEvent): void
{
    if (!stopRubberBanding(state)) return;

    state.canvas.ReleaseMouse();

    const xx = new Int32Array(1);
    const yy = new Int32Array(1);
    state.canvas.CalcUnscrolledPosition(event.GetX(), event.GetY(),
        pointerOf(xx), pointerOf(yy));

    if (xx[0] !== state.anchorX || yy[0] !== state.anchorY)
    {
        const message =
            `Selected rectangle from (${state.anchorX}, ${state.anchorY}) ` +
            `to (${xx[0]}, ${yy[0]})`;
        withString(message, (ptr) => LogMessage(ptr));
    }
}

function onMouseCaptureLost(state: DrawingState): void
{
    stopRubberBanding(state);
    withString("Mouse capture lost", (ptr) => LogStatus(ptr));
}

function onSetCursor(state: DrawingState, event: wxSetCursorEvent): void
{
    // Only show cursors on the cursors screen.
    if (state.show !== File_ShowCursors)
    {
        event.Skip(true);
        return;
    }

    const posX = event.GetX();
    const posY = event.GetY();
    for (let n = 0; n < state.cursorRects.length; ++n)
    {
        const rect = state.cursorRects[n];
        if (rect && rectContains(rect, posX, posY))
        {
            const cursor = n === 0 ? state.customCursor : state.stockCursors[n];
            if (cursor) event.SetCursor(cursor.ptr);
            return;
        }
    }

    event.Skip(true);
}

// ---------------------------------------------------------------------------
// Frame helpers
// ---------------------------------------------------------------------------

function setStatus(state: DrawingState, text: string, pane: number): void
{
    withString(text, (ptr) => state.frame.SetStatusText(ptr, pane));
}

function defaultRenderer(): Pointer
{
    return lib.symbols.wxGraphicsRenderer_GetDefaultRenderer(null);
}

function useGraphicRenderer(state: DrawingState, renderer: Pointer): void
{
    state.renderer = renderer;

    if (renderer)
    {
        const rendererName = readAndDeleteWxString(
            lib.symbols.wxGraphicsRenderer_GetName(renderer));
        const major = new Int32Array(1);
        const minor = new Int32Array(1);
        const micro = new Int32Array(1);
        lib.symbols.wxGraphicsRenderer_GetVersion(renderer,
            pointerOf(major), pointerOf(minor), pointerOf(micro));
        setStatus(state,
            `Graphics renderer: ${rendererName} ${major[0]}.${minor[0]}.${micro[0]}`,
            1);
    }
    else
    {
        setStatus(state, "", 1);
    }

    state.canvas.Refresh(true);
}

function selectColour(state: DrawingState): wxColour | null
{
    const data = createWxColourData();
    if (!data)
    {
        return null;
    }

    let result: wxColour | null = null;
    const dialog = createWxColourDialog(state.frame.ptr, data.ptr);
    if (dialog)
    {
        if (dialog.ShowModal() === ID_OK)
        {
            const returned = createWxColourData();
            if (returned)
            {
                dialog.GetColourData(returned.ptr);
                const colour = createWxColourEmpty();
                if (colour)
                {
                    returned.GetColour(colour.ptr);
                    result = colour;
                }
                returned.Delete();
            }
        }
        dialog.Delete();
    }
    data.Delete();
    return result;
}

// TransformDataDialog equivalent (wxFloatingPointValidator is not bound;
// values are parsed and range-checked in the modal loop instead).
function showTransformDialog(
    state: DrawingState,
): { ok: boolean; dx: number; dy: number; scx: number; scy: number; rot: number }
{
    const result = { ok: false, dx: state.transformDx, dy: state.transformDy,
        scx: state.transformScx, scy: state.transformScy, rot: state.transformRot };

    const dialog = withString("Affine transformation parameters", (title) =>
        createWxDialog(state.frame.ptr, ID_ANY, title,
            -1, -1, -1, -1, DEFAULT_DIALOG_STYLE));
    if (!dialog)
    {
        return result;
    }

    const sizer = createWxBoxSizer(VERTICAL);
    const paramSizer = createWxFlexGridSizer(0, 2, BORDER_DEFAULT, BORDER_DEFAULT);
    if (!sizer || !paramSizer)
    {
        dialog.Destroy();
        return result;
    }

    const labels = [
        "Translation X:", "Translation Y:",
        "Scale X (0.2 - 5):", "Scale Y (0.2 - 5):",
        "Rotation angle (deg):",
    ];
    const initial = [
        String(state.transformDx), String(state.transformDy),
        String(state.transformScx), String(state.transformScy),
        String(state.transformRot),
    ];
    const controls: wxTextCtrl[] = [];

    for (let i = 0; i < labels.length; i++)
    {
        const staticText = withString(labels[i], (text) =>
            createWxStaticText(dialog.ptr, ID_ANY, text, -1, -1, -1, -1, 0));
        if (staticText)
        {
            paramSizer.AddWindow(staticText.ptr, 0, ALIGN_CENTER_VERTICAL, 0, null);
        }

        const ctrl = withString(initial[i], (text) =>
            createWxTextCtrl(dialog.ptr, ID_ANY, text, -1, -1, -1, -1, 0n));
        if (ctrl)
        {
            controls.push(ctrl);
            paramSizer.AddWindow(ctrl.ptr, 0, ALIGN_CENTER_VERTICAL, 0, null);
        }
    }

    sizer.AddSizer(paramSizer.ptr, 0, ALL, BORDER_DEFAULT * 2, null);
    const buttons = dialog.CreateSeparatedButtonSizer(BigInt(OK | CANCEL));
    if (buttons)
    {
        sizer.AddSizer(buttons, 0, EXPAND | ALL, BORDER_DEFAULT, null);
    }
    dialog.SetSizerAndFit(sizer.ptr, true);

    for (;;)
    {
        if (dialog.ShowModal() !== ID_OK)
        {
            break;
        }

        const values = controls.map((ctrl) =>
            parseFloat(readAndDeleteWxString(ctrl.GetValue())));

        const valid = values.every((v) => Number.isFinite(v)) &&
            values[2] >= 0.2 && values[2] <= 5.0 &&
            values[3] >= 0.2 && values[3] <= 5.0;

        if (!valid)
        {
            bell();
            continue;
        }

        result.ok = true;
        result.dx = values[0];
        result.dy = values[1];
        result.scx = values[2];
        result.scy = values[3];
        result.rot = values[4];
        break;
    }

    dialog.Destroy();
    return result;
}

function onShow(state: DrawingState, id: number): void
{
    if (id === File_ShowGraphics ||
        (!dcSupportsAlpha && id === File_ShowAlpha))
    {
        if (!state.renderer)
        {
            useGraphicRenderer(state, defaultRenderer());
        }
        if (state.menuItemUseDC) state.menuItemUseDC.Enable(!state.renderer);
    }
    else
    {
        if (state.menuItemUseDC) state.menuItemUseDC.Enable(true);
    }

    state.show = id;
    state.canvas.Refresh(true);
}

function replaceColour(current: wxColour | null, next: wxColour): wxColour
{
    if (current) current.Delete();
    return next;
}

function onOption(state: DrawingState, id: number): void
{
    switch (id)
    {
        case LogicalOrigin_MoveMouse:
            state.canvas.WarpPointer(100, 100);
            return;

        case MapMode_Text: state.mapMode = MM_TEXT; break;
        case MapMode_Lometric: state.mapMode = MM_LOMETRIC; break;
        case MapMode_Twips: state.mapMode = MM_TWIPS; break;
        case MapMode_Points: state.mapMode = MM_POINTS; break;
        case MapMode_Metric: state.mapMode = MM_METRIC; break;

        case LogicalOrigin_MoveDown: state.yLogicalOrigin += 10; break;
        case LogicalOrigin_MoveUp: state.yLogicalOrigin -= 10; break;
        case LogicalOrigin_MoveLeft: state.xLogicalOrigin += 10; break;
        case LogicalOrigin_MoveRight: state.xLogicalOrigin -= 10; break;
        case LogicalOrigin_Set:
            state.xLogicalOrigin = -100;
            state.yLogicalOrigin = -100;
            break;
        case LogicalOrigin_Restore:
            state.xLogicalOrigin = 0;
            state.yLogicalOrigin = 0;
            break;

        case UserScale_StretchHoriz: state.xUserScale *= 1.10; break;
        case UserScale_ShrinkHoriz: state.xUserScale /= 1.10; break;
        case UserScale_StretchVertic: state.yUserScale *= 1.10; break;
        case UserScale_ShrinkVertic: state.yUserScale /= 1.10; break;
        case UserScale_Restore:
            state.xUserScale = 1.0;
            state.yUserScale = 1.0;
            break;

        case AxisMirror_Vertic: state.yAxisReversed = !state.yAxisReversed; break;
        case AxisMirror_Horiz: state.xAxisReversed = !state.xAxisReversed; break;

        case TransformMatrix_Set:
            {
                const values = showTransformDialog(state);
                if (values.ok)
                {
                    state.transformDx = values.dx;
                    state.transformDy = values.dy;
                    state.transformScx = values.scx;
                    state.transformScy = values.scy;
                    state.transformRot = values.rot;
                }
            }
            break;
        case TransformMatrix_Reset:
            state.transformDx = 0.0;
            state.transformDy = 0.0;
            state.transformScx = 1.0;
            state.transformScy = 1.0;
            state.transformRot = 0.0;
            break;

        case Colour_AppearanceSystem:
        case Colour_AppearanceLight:
        case Colour_AppearanceDark:
            // BINDING GAP: wxApp::SetAppearance() needs a wxApp instance and
            // the runtime exposes no wxTheApp pointer, so switching the
            // appearance cannot be performed.
            break;

        case Colour_DatabaseCSS:
        case Colour_DatabaseTraditional:
            // BINDING GAP: wxTheColourDatabase is not bound.
            break;

        case Colour_TextForeground:
            {
                const colour = selectColour(state);
                if (colour) state.colourForeground = replaceColour(state.colourForeground, colour);
            }
            break;
        case Colour_TextBackground:
            {
                const colour = selectColour(state);
                if (colour) state.colourBackground = replaceColour(state.colourBackground, colour);
            }
            break;
        case Colour_Background:
            {
                const colour = selectColour(state);
                if (colour && colour.IsOk())
                {
                    if (!state.backgroundBrush)
                    {
                        state.backgroundBrush = createWxBrushFromColour(
                            colour.ptr, BRUSHSTYLE_SOLID);
                    }
                    else
                    {
                        state.backgroundBrush.SetColour(colour.ptr);
                    }
                }
                if (colour) colour.Delete();
            }
            break;

        case Colour_BackgroundMode:
            state.backgroundMode =
                state.backgroundMode === BRUSHSTYLE_SOLID
                    ? BRUSHSTYLE_TRANSPARENT
                    : BRUSHSTYLE_SOLID;
            break;

        case Colour_TextureBackgound:
            state.textureBackground = !state.textureBackground;
            break;

        default:
            return; // skip Refresh()
    }

    state.canvas.Refresh(true);
}

function onSave(state: DrawingState): void
{
    const wildcard =
        "Bitmap image (*.bmp)|*.bmp;*.BMP" +
        "|PNG image (*.png)|*.png;*.PNG" +
        "|SVG image (*.svg)|*.svg;*.SVG";

    const dialog = withFourStrings("Save as bitmap", "", "", wildcard,
        (message, directory, files, filter) => createWxFileDialog(
            state.frame.ptr,
            message, directory, files, filter,
            -1, -1,
            FD_SAVE | FD_OVERWRITE_PROMPT,
            -1, -1));

    if (!dialog)
    {
        return;
    }

    if (dialog.ShowModal() === ID_OK)
    {
        const path = readAndDeleteWxString(dialog.GetPath());
        const lower = path.toLowerCase();
        const width = state.sizeDIPW;
        const height = state.sizeDIPH;

        if (width > 0 && height > 0)
        {
            if (lower.endsWith(".svg"))
            {
                // The two-pass sizing of the original cannot be reproduced
                // without a default-constructed wxSVGFileDC; the canvas DIP
                // size plus the pen margin is used instead.
                const svg = withString(path, (ptr) =>
                    createWxSVGFileDCWithSize(ptr, width + 15, height + 15));
                if (svg)
                {
                    drawCanvasNoRenderer(state, svg);
                    svg.Delete();
                }
            }
            else
            {
                const bitmap = createWxBitmapDefault();
                const size = createWxSize(width, height);
                if (bitmap && size)
                {
                    bitmap.CreateWithDIPSize(size.ptr,
                        state.frame.GetDPIScaleFactor(), BITMAP_SCREEN_DEPTH);
                    size.Delete();

                    const mdc = createWxMemoryDCWithBitmap(bitmap.ptr);
                    if (mdc)
                    {
                        mdc.SetBackground(WHITE_BRUSH);
                        mdc.Clear();
                        drawCanvasNoRenderer(state, mdc);
                        mdc.Delete();
                    }

                    const image = new wxImage(bitmap.ConvertToImage());
                    withString(path, (ptr) => image.SaveFile(ptr, BITMAP_TYPE_ANY));
                    image.Delete();
                    bitmap.Delete();
                }
                else
                {
                    if (size) size.Delete();
                    if (bitmap) bitmap.Delete();
                }
            }
        }
    }

    dialog.Delete();
}

// Draw without a wxGraphicsContext (used for SVG output, like the original's
// PostScript path temporarily clears the renderer).
function drawCanvasNoRenderer(state: DrawingState, dc: wxDC): void
{
    const saved = state.renderer;
    state.renderer = null;
    try
    {
        drawCanvas(state, dc, false);
    }
    finally
    {
        state.renderer = saved;
    }
}

function onCopy(state: DrawingState): void
{
    if (platform !== "windows")
    {
        return; // enhanced metafiles are only used on MSW in the sample
    }

    const mdc = withString("", (ptr) => createWxMetafileDC(ptr));
    if (!mdc || !mdc.IsOk())
    {
        if (mdc) mdc.Delete();
        return;
    }

    drawCanvasNoRenderer(state, mdc);

    const metafilePtr = mdc.Close();
    mdc.Delete();

    if (!metafilePtr)
    {
        return;
    }

    const metafile = new wxMetafile(metafilePtr);
    metafile.SetClipboard(0, 0);
    metafile.Delete();
}

// ---------------------------------------------------------------------------
// Menu construction
// ---------------------------------------------------------------------------

function appendItem(menu: wxMenu, id: number, text: string, help: string = ""): void
{
    withTwoStrings(text, help, (t, h) => menu.Append(id, t, h, false));
}

function appendCheckItem(menu: wxMenu, id: number, text: string, help: string = ""): void
{
    withTwoStrings(text, help, (t, h) => menu.AppendCheckItem(id, t, h));
}

function appendRadioItem(menu: wxMenu, id: number, text: string, help: string = ""): void
{
    withTwoStrings(text, help, (t, h) => menu.AppendRadioItem(id, t, h));
}

function checkMenuItem(menu: wxMenu, id: number): void
{
    const itemPtr = menu.FindItem(id);
    if (!itemPtr) return;
    wrapWxMenuItem(itemPtr).Check(true);
}

// ---------------------------------------------------------------------------
// Frame creation (MyFrame ctor + MyCanvas ctor + app OnInit)
// ---------------------------------------------------------------------------

function createDrawingFrame(): DrawingState
{
    const titlePtr = createWxString("Drawing sample");
    const frame = createWxFrame(null, ID_ANY, titlePtr.ptr,
        -1, -1, -1, -1, DEFAULT_FRAME_STYLE);
    titlePtr.Delete();
    if (!frame) throw new Error("Failed to create the main frame");

    const canvas = createWxScrolledWindow(frame.ptr, ID_ANY,
        -1, -1, -1, -1, HSCROLL | VSCROLL);
    if (!canvas) throw new Error("Failed to create the drawing canvas");
    canvas.SetScrollbars(10, 10, 100, 450, 0, 0, false);

    const state: DrawingState = {
        frame,
        canvas,
        menuItemUseDC: null,

        backgroundMode: BRUSHSTYLE_SOLID,
        textureBackground: false,
        mapMode: MM_TEXT,
        xUserScale: 1.0,
        yUserScale: 1.0,
        xLogicalOrigin: 0,
        yLogicalOrigin: 0,
        xAxisReversed: false,
        yAxisReversed: false,

        transformDx: 0.0,
        transformDy: 0.0,
        transformScx: 1.0,
        transformScy: 1.0,
        transformRot: 0.0,

        colourForeground: colourRGB(0, 0, 0),
        colourBackground: colourRGB(192, 192, 192),
        backgroundBrush: null,

        outerScrollEnabled: true,
        innerScrollWidth: 0,

        show: File_ShowDefault,
        smileBmp: loadBitmap("smile.xpm", BITMAP_TYPE_XPM),
        stdIcon: null,
        clip: false,
        rubberBand: false,
        anchorX: 0,
        anchorY: 0,
        currentX: 0,
        currentY: 0,
        renderer: null,
        useAntiAliasing: true,
        useBuffer: false,
        showBBox: false,
        sizeDIPW: 0,
        sizeDIPH: 0,
        customCursor: null,
        stockCursors: [],
        cursorRects: [],

        bmpNoMask: null,
        bmpWithColMask: null,
        bmpMask: null,
        bmpWithMask: null,
        bmp4: null,
        bmp4Mono: null,
        bmp36: null,
    };

    state_bitmaps = state;

    // MyCanvas::MyCanvas: m_smile_bmp and m_std_icon
    {
        const iconPtr = wxArtProvider_GetIcon(
            ART_INFORMATION, ART_OTHER, -1, -1);
        if (iconPtr)
        {
            state.stdIcon = new wxIcon(iconPtr);
        }
    }

    // wxCursorBundle(cursor.xpm, cursor_2x.xpm, hotSpot(4,4)).  The bundle and
    // the hotspot are not bound; a wxCursor created from cursor.xpm is used.
    {
        const path = `${__dirname}/cursor.xpm`;
        const image = withString(path, (ptr) => createWxImageFromFile(ptr));
        if (image)
        {
            state.customCursor = createWxCursorFromImage(image.ptr);
            image.Delete();
        }
    }

    // Stock cursors for the cursors screen (index 0 holds the custom cursor).
    for (let i = 1; i < stockCursorValues.length; i++)
    {
        state.stockCursors[i] = createWxCursorFromStock(stockCursorValues[i]);
    }

    // ----- Menus -----
    const emptyTitle = (): wxMenu | null =>
        withString("", (title) => createWxMenu(title, 0n));
    const menuScreen = emptyTitle();
    const menuFile = emptyTitle();
    const menuMapMode = emptyTitle();
    const menuUserScale = emptyTitle();
    const menuAxis = emptyTitle();
    const menuLogical = emptyTitle();
    const menuTransformMatrix = emptyTitle();
    const menuColour = emptyTitle();
    const menuBar = createWxMenuBar(0);

    if (!menuScreen || !menuFile || !menuMapMode || !menuUserScale ||
        !menuAxis || !menuLogical || !menuTransformMatrix || !menuColour ||
        !menuBar)
    {
        throw new Error("Failed to create the menu bar");
    }

    appendItem(menuScreen, File_ShowDefault, "&Default screen\tF1");
    appendItem(menuScreen, File_ShowText, "&Text screen\tF2");
    appendItem(menuScreen, File_ShowLines, "&Lines screen\tF3");
    appendItem(menuScreen, File_ShowBrushes, "&Brushes screen\tF4");
    appendItem(menuScreen, File_ShowPolygons, "&Polygons screen\tF5");
    appendItem(menuScreen, File_ShowMask, "&Mask screen\tF6");
    appendItem(menuScreen, File_ShowMaskStretch, "1/&2 scaled mask\tShift-F6");
    appendItem(menuScreen, File_ShowOps, "&Raster operations screen\tF7");
    appendItem(menuScreen, File_ShowRegions, "Re&gions screen\tF8");
    appendItem(menuScreen, File_ShowCircles, "&Circles screen\tF9");
    appendItem(menuScreen, File_ShowAlpha, "&Alpha screen\tF10");
    appendItem(menuScreen, File_ShowSplines, "Spl&ines screen\tF11");
    appendItem(menuScreen, File_ShowGradients, "&Gradients screen\tF12");
    appendItem(menuScreen, File_ShowGraphics, "&Graphics screen");
    appendItem(menuScreen, File_ShowSystemColours, "System &colours");
    appendItem(menuScreen, File_ShowDatabaseColours, "Databa&se colours");
    appendItem(menuScreen, File_ShowCursors, "C&ursors screen");

    {
        let accel = 0;
        appendRadioItem(menuFile, File_DC,
            `Use wx&DC\t${accel++}`);
        appendRadioItem(menuFile, File_GC_Default,
            `Use default wx&GraphicContext\t${accel++}`);

        if (platform === "windows")
        {
            const gdiPlusPtr = lib.symbols.wxGraphicsRenderer_GetGDIPlusRenderer(null);
            if (gdiPlusPtr)
            {
                appendRadioItem(menuFile, File_GC_GDIPlus,
                    `Use &GDI+\t${accel++}`);
            }

            const direct2DPtr = lib.symbols.wxGraphicsRenderer_GetDirect2DRenderer(null);
            if (direct2DPtr)
            {
                appendRadioItem(menuFile, File_GC_Direct2D,
                    `Use &Direct2D\t${accel++}`);
            }
        }
    }

    menuFile.AppendSeparator();
    appendCheckItem(menuFile, File_BBox, "Show bounding box\tCtrl-E",
        "Show extents used in drawing operations");
    appendCheckItem(menuFile, File_Clip, "&Clip\tCtrl-C", "Clip/unclip drawing");
    appendCheckItem(menuFile, File_Buffer, "&Use wx&BufferedPaintDC\tCtrl-Z",
        "Buffer painting");
    appendCheckItem(menuFile, File_AntiAliasing,
        "&Anti-Aliasing in wxGraphicContext\tCtrl-Shift-A",
        "Enable Anti-Aliasing in wxGraphicContext");
    checkMenuItem(menuFile, File_AntiAliasing);
    menuFile.AppendSeparator();
    appendCheckItem(menuFile, File_AutoscrollOuter, "&Outer Scroll Zone",
        "Autoscroll zone outside window");
    appendCheckItem(menuFile, File_AutoscrollInner, "&Inner Scroll Zone",
        "Autoscroll zone inside window");
    menuFile.AppendSeparator();
    if (platform === "windows")
    {
        appendItem(menuFile, File_Copy, "Copy to clipboard");
    }
    appendItem(menuFile, File_Save, "&Save...\tCtrl-S", "Save drawing to file");
    menuFile.AppendSeparator();
    appendItem(menuFile, File_About, "&About\tCtrl-A", "Show about dialog");
    menuFile.AppendSeparator();
    appendItem(menuFile, File_Quit, "E&xit\tAlt-X", "Quit this program");

    appendItem(menuMapMode, MapMode_Text, "&TEXT map mode");
    appendItem(menuMapMode, MapMode_Lometric, "&LOMETRIC map mode");
    appendItem(menuMapMode, MapMode_Twips, "T&WIPS map mode");
    appendItem(menuMapMode, MapMode_Points, "&POINTS map mode");
    appendItem(menuMapMode, MapMode_Metric, "&METRIC map mode");

    appendItem(menuUserScale, UserScale_StretchHoriz,
        "Stretch &horizontally\tCtrl-H");
    appendItem(menuUserScale, UserScale_ShrinkHoriz,
        "Shrin&k horizontally\tCtrl-G");
    appendItem(menuUserScale, UserScale_StretchVertic,
        "Stretch &vertically\tCtrl-V");
    appendItem(menuUserScale, UserScale_ShrinkVertic,
        "&Shrink vertically\tCtrl-W");
    menuUserScale.AppendSeparator();
    appendItem(menuUserScale, UserScale_Restore,
        "&Restore to normal\tCtrl-0");

    appendCheckItem(menuAxis, AxisMirror_Horiz, "Mirror horizontally\tCtrl-M");
    appendCheckItem(menuAxis, AxisMirror_Vertic, "Mirror vertically\tCtrl-N");

    appendItem(menuLogical, LogicalOrigin_MoveDown, "Move &down\tCtrl-D");
    appendItem(menuLogical, LogicalOrigin_MoveUp, "Move &up\tCtrl-U");
    appendItem(menuLogical, LogicalOrigin_MoveLeft, "Move &right\tCtrl-L");
    appendItem(menuLogical, LogicalOrigin_MoveRight, "Move &left\tCtrl-R");
    menuLogical.AppendSeparator();
    appendItem(menuLogical, LogicalOrigin_Set,
        "Set to (&100, 100)\tShift-Ctrl-1");
    appendItem(menuLogical, LogicalOrigin_Restore,
        "&Restore to normal\tShift-Ctrl-0");
    menuLogical.AppendSeparator();
    appendItem(menuLogical, LogicalOrigin_MoveMouse,
        "Move &mouse to logical (100, 100)\tShift-Ctrl-M");

    appendItem(menuTransformMatrix, TransformMatrix_Set,
        "Set &transformation matrix");
    menuTransformMatrix.AppendSeparator();
    appendItem(menuTransformMatrix, TransformMatrix_Reset,
        "Restore to &normal");

    appendRadioItem(menuColour, Colour_AppearanceSystem,
        "Use &system appearance");
    appendRadioItem(menuColour, Colour_AppearanceLight,
        "Use &light appearance");
    appendRadioItem(menuColour, Colour_AppearanceDark,
        "Use &dark appearance");
    menuColour.AppendSeparator();
    appendRadioItem(menuColour, Colour_DatabaseCSS, "&Use CSS colours");
    appendRadioItem(menuColour, Colour_DatabaseTraditional,
        "Use &traditional colours");
    menuColour.AppendSeparator();
    appendItem(menuColour, Colour_TextForeground, "Text &foreground...");
    appendItem(menuColour, Colour_TextBackground, "Text &background...");
    appendItem(menuColour, Colour_Background, "Background &colour...");
    appendCheckItem(menuColour, Colour_BackgroundMode,
        "&Opaque/transparent\tCtrl-B");
    appendCheckItem(menuColour, Colour_TextureBackgound,
        "Draw textured back&ground\tCtrl-T");

    withString("&Drawing", (label) => menuBar.Append(menuFile.ptr, label));
    withString("Scree&n", (label) => menuBar.Append(menuScreen.ptr, label));
    withString("&Mode", (label) => menuBar.Append(menuMapMode.ptr, label));
    withString("&Scale", (label) => menuBar.Append(menuUserScale.ptr, label));
    withString("&Axis", (label) => menuBar.Append(menuAxis.ptr, label));
    withString("&Origin", (label) => menuBar.Append(menuLogical.ptr, label));
    withString("&Transformation",
        (label) => menuBar.Append(menuTransformMatrix.ptr, label));
    withString("&Colours", (label) => menuBar.Append(menuColour.ptr, label));

    menuBar.Check(Colour_AppearanceSystem, true);
    frame.SetMenuBar(menuBar.ptr);

    {
        const dcItemPtr = menuFile.FindItem(File_DC);
        state.menuItemUseDC = dcItemPtr ? wrapWxMenuItem(dcItemPtr) : null;
    }

    // ----- Status bar -----
    frame.CreateStatusBar(2, 0, ID_ANY);
    setStatus(state, "Welcome to wxWidgets!", 0);

    // ----- wxEVT_SYS_COLOUR_CHANGED / wxEVT_SYS_METRIC_CHANGED -----
    connectEvent(canvas.ptr, ID_ANY, ID_ANY, EVT_SYS_COLOUR_CHANGED, () =>
    {
        if (state.show === File_ShowSystemColours) canvas.Refresh(true);
    });
    connectEvent(canvas.ptr, ID_ANY, ID_ANY, EVT_SYS_METRIC_CHANGED, () =>
    {
        // wxSysMetricChangedEvent is not bound, so the metric kind cannot be
        // checked; refresh for any metric change on the cursors screen.
        if (state.show === File_ShowCursors) canvas.Refresh(true);
    });

    // ----- Canvas event table -----
    connectEvent(canvas.ptr, ID_ANY, ID_ANY, EVT_PAINT, () => onPaint(state));
    connectEvent(canvas.ptr, ID_ANY, ID_ANY, EVT_MOTION, (eventPtr) =>
    {
        onMouseMove(state, new wxMouseEvent(eventPtr));
    });
    connectEvent(canvas.ptr, ID_ANY, ID_ANY, EVT_LEFT_DOWN, (eventPtr) =>
    {
        onMouseDown(state, new wxMouseEvent(eventPtr));
    });
    connectEvent(canvas.ptr, ID_ANY, ID_ANY, EVT_LEFT_UP, (eventPtr) =>
    {
        onMouseUp(state, new wxMouseEvent(eventPtr));
    });
    connectEvent(canvas.ptr, ID_ANY, ID_ANY, EVT_MOUSE_CAPTURE_LOST, () =>
    {
        onMouseCaptureLost(state);
    });
    connectEvent(canvas.ptr, ID_ANY, ID_ANY, EVT_SET_CURSOR, (eventPtr) =>
    {
        onSetCursor(state, new wxSetCursorEvent(eventPtr));
    });

    // ----- Frame event table -----
    connectEvent(frame.ptr, File_Quit, File_Quit, EVT_MENU, () =>
    {
        frame.Close(true);
    });
    connectEvent(frame.ptr, File_About, File_About, EVT_MENU, () =>
    {
        const message =
            "This is the about dialog of the drawing sample.\n" +
            "This sample tests various primitive drawing functions\n" +
            "(without any attempts to prevent flicker).\n" +
            "Copyright (c) Robert Roebling 1999";
        withTwoStrings(message, "About Drawing", (m, c) =>
            kwxMessageBox(m, c, OK | ICON_INFORMATION, frame.ptr, -1, -1));
    });
    connectEvent(frame.ptr, File_Clip, File_Clip, EVT_MENU, (eventPtr) =>
    {
        const event = new wxCommandEvent(eventPtr);
        state.clip = event.IsChecked();
        canvas.Refresh(true);
    });
    connectEvent(frame.ptr, File_Buffer, File_Buffer, EVT_MENU, (eventPtr) =>
    {
        const event = new wxCommandEvent(eventPtr);
        state.useBuffer = event.IsChecked();
        canvas.Refresh(true);
    });
    connectEvent(frame.ptr, File_BBox, File_BBox, EVT_MENU, (eventPtr) =>
    {
        const event = new wxCommandEvent(eventPtr);
        state.showBBox = event.IsChecked();
        canvas.Refresh(true);
    });
    connectEvent(frame.ptr, File_BBox, File_BBox, EVT_UPDATE_UI, (eventPtr) =>
    {
        const event = new wxUpdateUIEvent(eventPtr);
        event.Enable(state.show !== File_ShowGraphics);
    });

    if (File_AntiAliasing >= 0)
    {
        connectEvent(frame.ptr, File_AntiAliasing, File_AntiAliasing, EVT_MENU,
            (eventPtr) =>
            {
                const event = new wxCommandEvent(eventPtr);
                state.useAntiAliasing = event.IsChecked();
                canvas.Refresh(true);
            });
        connectEvent(frame.ptr, File_AntiAliasing, File_AntiAliasing,
            EVT_UPDATE_UI, (eventPtr) =>
            {
                const event = new wxUpdateUIEvent(eventPtr);
                event.Enable(state.renderer !== null);
            });
    }

    connectEvent(frame.ptr, File_AutoscrollOuter, File_AutoscrollOuter,
        EVT_MENU, () =>
        {
            state.outerScrollEnabled = false;
            // BINDING GAP: wxScrolledWindow::DisableAutoScrollOutside() is not
            // bound, so only the menu state is updated.
        });
    connectEvent(frame.ptr, File_AutoscrollOuter, File_AutoscrollOuter,
        EVT_UPDATE_UI, (eventPtr) =>
        {
            const event = new wxUpdateUIEvent(eventPtr);
            event.Check(state.outerScrollEnabled);
            event.Enable(state.outerScrollEnabled);
        });
    connectEvent(frame.ptr, File_AutoscrollInner, File_AutoscrollInner,
        EVT_MENU, () =>
        {
            state.innerScrollWidth =
                state.canvas.FromDIP(16) - state.innerScrollWidth;
            // BINDING GAP: wxScrolledWindow::EnableAutoScrollInside() is not
            // bound, so only the menu state is updated.
        });
    connectEvent(frame.ptr, File_AutoscrollInner, File_AutoscrollInner,
        EVT_UPDATE_UI, (eventPtr) =>
        {
            const event = new wxUpdateUIEvent(eventPtr);
            event.Check(state.innerScrollWidth !== 0);
        });

    // Graphics context radio items
    connectEvent(frame.ptr, File_DC, File_DC, EVT_MENU, () =>
    {
        useGraphicRenderer(state, null);
    });
    connectEvent(frame.ptr, File_GC_Default, File_GC_Default, EVT_MENU, () =>
    {
        useGraphicRenderer(state, defaultRenderer());
    });
    if (File_GC_GDIPlus >= 0 &&
        lib.symbols.wxGraphicsRenderer_GetGDIPlusRenderer(null))
    {
        connectEvent(frame.ptr, File_GC_GDIPlus, File_GC_GDIPlus, EVT_MENU, () =>
        {
            useGraphicRenderer(state,
                lib.symbols.wxGraphicsRenderer_GetGDIPlusRenderer(null));
        });
    }
    if (File_GC_Direct2D >= 0 &&
        lib.symbols.wxGraphicsRenderer_GetDirect2DRenderer(null))
    {
        connectEvent(frame.ptr, File_GC_Direct2D, File_GC_Direct2D, EVT_MENU, () =>
        {
            useGraphicRenderer(state,
                lib.symbols.wxGraphicsRenderer_GetDirect2DRenderer(null));
        });
    }

    connectEvent(frame.ptr, File_Copy, File_Copy, EVT_MENU, () =>
    {
        onCopy(state);
    });
    connectEvent(frame.ptr, File_Save, File_Save, EVT_MENU, () =>
    {
        onSave(state);
    });

    connectEvent(frame.ptr, MenuShow_First, MenuShow_Last, EVT_MENU,
        (eventPtr) =>
        {
            const event = new wxCommandEvent(eventPtr);
            onShow(state, event.GetId());
        });

    // EVT_MENU_RANGE(MenuOption_First, MenuOption_Last, OnOption); the
    // LogicalOrigin_MoveMouse case is handled inside onOption so the range
    // cannot shadow it.
    connectEvent(frame.ptr, MenuOption_First, MenuOption_Last, EVT_MENU,
        (eventPtr) =>
        {
            const event = new wxCommandEvent(eventPtr);
            onOption(state, event.GetId());
        });

    // Window close: exit the main loop (never call Close here).
    connectEvent(frame.ptr, ID_ANY, ID_ANY, EVT_CLOSE_WINDOW, () =>
    {
        exitMainLoop();
    });

    // ----- Frame size / position -----
    frame.SetSize(0, 0, frame.FromDIP(800), frame.FromDIP(700), 0);
    frame.Centre(BOTH);

    // ----- Images -----
    if (!loadImages(state))
    {
        withString(
            "Can't load one of the bitmap files needed for this sample from the " +
            "current or parent directory, please copy them there.",
            (ptr) => LogMessage(ptr));
    }

    return state;
}

// ---------------------------------------------------------------------------
// Lifecycle
// ---------------------------------------------------------------------------

function cleanup(state: DrawingState): void
{
    state.bmpNoMask?.Delete();
    state.bmpWithColMask?.Delete();
    state.bmpMask?.Delete();
    state.bmpWithMask?.Delete();
    state.bmp4?.Delete();
    state.bmp4Mono?.Delete();
    state.bmp36?.Delete();

    state.smileBmp?.Delete();
    state.stdIcon?.Delete();
    state.customCursor?.Delete();
    for (const cursor of state.stockCursors)
    {
        cursor?.Delete();
    }

    state.colourForeground?.Delete();
    state.colourBackground?.Delete();
    state.backgroundBrush?.Delete();
}

export function main(): number
{
    if (!initialize())
    {
        console.error("Failed to initialize wxWidgets");
        return 1;
    }

    setAppName("Drawing sample");
    initAllImageHandlers();

    const state = createDrawingFrame();
    setTopWindow(state.frame.ptr);
    state.frame.Show();

    const exitCode = run();

    cleanup(state);

    for (const callback of callbacks)
    {
        callback.close();
    }

    shutdown();
    return exitCode;
}

exit(main());
