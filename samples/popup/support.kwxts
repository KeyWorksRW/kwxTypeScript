// support.kwxts — shared helpers for the "popup" sample port.
//
// Mirrors the common code that popup.cpp spreads across its translation unit:
// the control-id enum, wxSizerFlags-based layout helpers, the log window
// plumbing and a small registry that maps a window pointer back to the
// SimpleTransientPopup that owns it.

import {
    createWxBoxSizer,
    createWxSizerFlags,
    createWxString,
    ID_ABOUT,
    ID_EXIT,
    lib,
    LogMessage,
    wxSizer,
    wxSizerFlags,
} from "kwx";
import { Pointer } from "kwx/platform";

// ---------------------------------------------------------------------------
// Control and command IDs (popup.cpp:46-56)
//
//   Minimal_Quit              = wxID_EXIT
//   Minimal_About             = wxID_ABOUT
//   Minimal_TestDialog        = Minimal_About + 1
//   ... and so on for the rest of the enum.
// ---------------------------------------------------------------------------

export const MINIMAL_QUIT = ID_EXIT;
export const MINIMAL_ABOUT = ID_ABOUT;
export const MINIMAL_TEST_DIALOG = MINIMAL_ABOUT + 1;
export const MINIMAL_START_SIMPLE_POPUP = MINIMAL_TEST_DIALOG + 1;
export const MINIMAL_START_SCROLLED_POPUP = MINIMAL_START_SIMPLE_POPUP + 1;
export const MINIMAL_LOG_WINDOW = MINIMAL_START_SCROLLED_POPUP + 1;
export const MINIMAL_POPUP_BUTTON = MINIMAL_LOG_WINDOW + 1;
export const MINIMAL_POPUP_SPINCTRL = MINIMAL_POPUP_BUTTON + 1;

// ---------------------------------------------------------------------------
// Strings and logging
// ---------------------------------------------------------------------------

/** Run `fn` with a temporary wxString and release it on every path. */
export function withString<T>(text: string, fn: (ptr: Pointer) => T): T
{
    const value = createWxString(text);
    try
    {
        return fn(value.ptr);
    }
    finally
    {
        value.Delete();
    }
}

/**
 * wxLogMessage(message).
 *
 * kwxFFI's LogMessage(wxString*) forwards the whole string as the printf-style
 * format, so every message this sample emits is fully formatted first: the
 * C++ "%p" / "%d" conversions are resolved into the text below.
 */
export function logMessage(text: string): void
{
    withString(text, (ptr) => { LogMessage(ptr); });
}

/**
 * "%p" for the log messages.
 *
 * The runtime cannot forward variadic arguments to wxLogMessage("%p", ...),
 * so the pointer is spelled out as 0x-prefixed uppercase hex.
 */
export function fmtPointer(value: Pointer): string
{
    if (value === null || value === 0n)
    {
        return "0";
    }
    return "0x" + value.toString(16).toUpperCase();
}

// ---------------------------------------------------------------------------
// Sizers
// ---------------------------------------------------------------------------

/** A wxBoxSizer that can only fail on allocation failure. */
export function newBoxSizer(orient: number): wxSizer
{
    const sizer = createWxBoxSizer(orient);
    if (!sizer)
    {
        throw new Error("popup: failed to allocate a wxBoxSizer");
    }
    return sizer;
}

/**
 * sizer->Add(window, flags).
 *
 * wxSizerFlags is bound, so Border() keeps its native, DPI-aware default
 * distance instead of a value recomputed here.
 */
export function addWithFlags(
    sizer: wxSizer,
    window: Pointer,
    configure: (flags: wxSizerFlags) => void,
    proportion = 0,
): void
{
    const flags = createWxSizerFlags(proportion);
    if (!flags)
    {
        return;
    }

    try
    {
        configure(flags);
        sizer.AddWindowFlags(window, flags.ptr);
    }
    finally
    {
        flags.Delete();
    }
}

// ---------------------------------------------------------------------------
// Live SimpleTransientPopup registry
// ---------------------------------------------------------------------------

/** Minimal view of a live popup used to resolve the owner of an event. */
export interface LivePopup
{
    readonly popupPtr: Pointer;
}

const livePopups: LivePopup[] = [];

export function registerLivePopup(entry: LivePopup): void
{
    livePopups.push(entry);
}

export function unregisterLivePopup(entry: LivePopup): void
{
    const index = livePopups.indexOf(entry);
    if (index >= 0)
    {
        livePopups.splice(index, 1);
    }
}

/** Drop every registry entry without touching the native windows. */
export function clearLivePopups(): void
{
    livePopups.length = 0;
}

/**
 * SimpleTransientPopup that owns `windowPtr`.
 *
 * Handlers installed on the popup itself receive the popup pointer; handlers
 * installed on a child control (button, spin control, panel) receive the
 * child, so the parent chain is walked until a registered popup is found.
 * `T` is the concrete popup record registered by the caller (PopupState).
 */
export function popupOwningWindow<T extends LivePopup>(windowPtr: Pointer): T | null
{
    let current = windowPtr;
    while (current)
    {
        for (const entry of livePopups)
        {
            if (entry.popupPtr === current)
            {
                return entry as T;
            }
        }

        current = lib.symbols.wxWindow_GetParent(current);
    }

    return null;
}
