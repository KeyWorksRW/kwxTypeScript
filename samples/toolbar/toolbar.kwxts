// toolbar.kwxts — kwxTypeScript port of wxSamples/src/toolbar/toolbar.cpp
//
// The wxToolBar sample: a frame whose main (frame-managed) toolbar can be
// rebuilt at run time with a different size, orientation, row count, tooltip
// mode, custom disabled images and toolbar style. The Tools menu adds/removes
// the print tool, toggles the help tool state, inserts/removes a wxSearchCtrl
// in the toolbar, changes tool packing and toggles the radio tools of a second,
// frame-independent vertical toolbar.
//
// Run from the repository root:
//   bin\Release\kwxts.exe samples\toolbar\toolbar.kwxts
//
// Porting notes (all substitutions are also listed in the final report):
//   * The C++ sample uses wxBITMAP_BUNDLE_2(new/open/save/copy/cut/paste/
//     print/help): 16x16 + 32x32 PNG bundles. The binding has no factory that
//     builds a wxBitmapBundle from a wxBitmap, but wxBitmapBundle::FromSVGFile
//     IS bound, and the sample ships the vector originals of exactly these PNGs
//     in its "vector" folder. Those SVGs are copied here unchanged and loaded
//     with FromSVGFile at the artwork's default 16x16 DIP size, so they scale to
//     32x32 for the large toolbar just like the 2x PNG variant did.
//   * The "About" tool image is the SVG embedded in toolbar.cpp; it is written
//     verbatim to about.svg and loaded with FromSVGFile(path, sizeBitmap).
//   * wxToolBar::AddTool() (the kwxFFI wrapper) takes wxBitmap arguments and
//     hard-codes wxITEM_NORMAL, so the drop-down "New" tool is created through
//     the wxToolBarBase wrapper (lib.symbols.wxToolBarBase_AddTool), which passes
//     (wxItemKind) kind correctly. That wrapper dereferences bmpDisabled, so the
//     normal bundle is passed for the (never disabled) New tool; wxWidgets would
//     otherwise generate a shadowed copy.
//   * MyCustomBitmapBundleImpl (a C++ wxBitmapBundleImpl subclass that rescales
//     the user-chosen bitmap and paints its pixel size on it) cannot be
//     subclassed from script. The same artwork is produced once at the current
//     tool bitmap size with wxMemoryDC and added as a normal tool bitmap; it
//     does not re-render when the DPI or the tool size changes.
//   * wxToolBarToolBase is not bound: "Toggle &search field" uses the control's
//     id with RemoveTool()/AddControl() instead of re-attaching the stored tool
//     object (the detached tool object is not freed).
//   * The toolbar returned by wxFrame::CreateToolBar() and wxFrame::GetToolBar()
//     is borrowed (owned by the frame), so `delete toolBar` goes through
//     lib.symbols.wxToolBar_Delete, exactly like the C++ operator delete.
//
// Everything else — every menu entry, accelerator text, tool label, help
// string, tool id, update-UI handler and state transition — mirrors the C++
// event table (see bindToolbarEvents).

declare const __dirname: string;

import {
    BORDER_NONE,
    CENTRE,
    DEFAULT_FRAME_STYLE,
    EVT_CLOSE_WINDOW,
    EVT_COMBOBOX,
    EVT_MENU,
