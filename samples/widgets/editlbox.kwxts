// editlbox.kwxts — port of wxSamples/src/widgets/editlbox.cpp
//
// wxEL_ALLOW_NEW / wxEL_ALLOW_EDIT / wxEL_ALLOW_DELETE / wxEL_NO_REORDER are
// not exported by kwx_constants_gen.ts; the values below come from
// include/wx/editlbox.h (0x0100, 0x0200, 0x0400, 0x0800).

import {
    ALIGN_CENTRE_HORIZONTAL,
    ALL,
    createWxArrayString,
    createWxBoxSizer,
    createWxButton,
    createWxEditableListBox,
    EVT_BUTTON,
    EVT_CHECKBOX,
    EXPAND,
    HORIZONTAL,
    ID_ANY,
    ID_HIGHEST,
    LEFT,
    RIGHT,
    VERTICAL,
    wxArrayString,
    wxCheckBox,
    wxEditableListBox,
    wxListCtrl,
    wxSizer,
    wxWindow,
} from "kwx";
import { Pointer } from "kwx/platform";

import {
    addSizer,
    addWin,
    attrs,
    bindEvent,
    border,
    doubleBorder,
    makeStaticBoxSizer,
    tripleBorder,
    WidgetsPage,
    withString,
} from "./common.kwxts";

const EDITABLE_LISTBOX_PAGE_RESET = ID_HIGHEST;
const EDITABLE_LISTBOX_PAGE_LISTBOX = EDITABLE_LISTBOX_PAGE_RESET + 1;

// Not generated by kwxgen; values from wx/editlbox.h.
const EL_ALLOW_NEW = 0x0100;
const EL_ALLOW_EDIT = 0x0200;
const EL_ALLOW_DELETE = 0x0400;
const EL_NO_REORDER = 0x0800;

export class EditableListboxPage extends WidgetsPage
{
    private chkAllowNew: wxCheckBox | null = null;
    private chkAllowEdit: wxCheckBox | null = null;
    private chkAllowDelete: wxCheckBox | null = null;
    private chkAllowNoReorder: wxCheckBox | null = null;

    private lbox: wxEditableListBox | null = null;
    private sizerLbox: wxSizer | null = null;

    constructor(parent: Pointer)
    {
        // The C++ page reuses the listbox icon.
        super(parent, "icons/listbox");
    }

    override getWidget(): wxWindow | null
    {
        if (!this.lbox)
        {
            return null;
        }
        const listCtrl: wxListCtrl | null = this.lbox.GetListCtrl();
        return listCtrl;
    }

    override createContent(): void
    {
        const sizerTop = createWxBoxSizer(HORIZONTAL)!;

        // left pane
        const sizerLeft = makeStaticBoxSizer(
            this.page.ptr, VERTICAL, "&Set listbox parameters");

        this.chkAllowNew = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Allow new items", ID_ANY, sizerLeft.box.ptr);
        this.chkAllowEdit = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Allow editing items", ID_ANY, sizerLeft.box.ptr);
        this.chkAllowDelete = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Allow deleting items", ID_ANY, sizerLeft.box.ptr);
        this.chkAllowNoReorder = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Block user reordering", ID_ANY, sizerLeft.box.ptr);

        const button = withString("&Reset", (ptr) =>
            createWxButton(sizerLeft.box.ptr, EDITABLE_LISTBOX_PAGE_RESET, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(sizerLeft.sizer, button, 0, ALIGN_CENTRE_HORIZONTAL, tripleBorder());

        // right pane
        const sizerRight = createWxBoxSizer(VERTICAL)!;
        this.lbox = withString("Match these wildcards:", (ptr) =>
            createWxEditableListBox(
                this.page.ptr, EDITABLE_LISTBOX_PAGE_LISTBOX, ptr,
                -1, -1, -1, -1, 0));

        if (this.lbox)
        {
            addWin(sizerRight, this.lbox, 1, EXPAND, border());
        }
        sizerRight.SetMinSize(this.dip(150), 0);
        this.sizerLbox = sizerRight;

        // the 3 panes compose the window; DoubleBorder(ALL & ~LEFT/RIGHT)
        addSizer(sizerTop, sizerLeft.sizer, 0, EXPAND | (ALL & ~LEFT), doubleBorder());
        addSizer(sizerTop, sizerRight, 1, EXPAND | (ALL & ~RIGHT), doubleBorder());

        this.reset();

        this.page.SetSizer(sizerTop.ptr, false);

        bindEvent(this.page, EDITABLE_LISTBOX_PAGE_RESET, EDITABLE_LISTBOX_PAGE_RESET,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.reset();
                this.createLbox();
            });

        bindEvent(this.page, ID_ANY, ID_ANY, EVT_CHECKBOX, (eventPtr) =>
        {
            if (!eventPtr) return;
            this.createLbox();
        });
    }

    override recreateWidget(): void
    {
        this.createLbox();
    }

    /** Reset the listbox parameters. */
    private reset(): void
    {
        this.chkAllowNew?.SetValue(false);
        this.chkAllowEdit?.SetValue(false);
        this.chkAllowDelete?.SetValue(false);
        this.chkAllowNoReorder?.SetValue(false);
    }

    /** (Re)create the listbox. */
    private createLbox(): void
    {
        let flags = attrs.defaultFlags;

        if (this.chkAllowNew?.GetValue())
        {
            flags |= EL_ALLOW_NEW;
        }
        if (this.chkAllowEdit?.GetValue())
        {
            flags |= EL_ALLOW_EDIT;
        }
        if (this.chkAllowDelete?.GetValue())
        {
            flags |= EL_ALLOW_DELETE;
        }
        if (this.chkAllowNoReorder?.GetValue())
        {
            flags |= EL_NO_REORDER;
        }

        const items: wxArrayString | null = createWxArrayString();
        if (this.lbox)
        {
            if (items)
            {
                this.lbox.GetStrings(items.ptr);
            }
            this.sizerLbox?.DetachWindow(this.lbox.ptr);
            this.lbox.Delete();
            this.lbox = null;
        }

        this.lbox = withString("Match these wildcards:", (ptr) =>
            createWxEditableListBox(
                this.page.ptr, EDITABLE_LISTBOX_PAGE_LISTBOX, ptr,
                -1, -1, -1, -1, flags));

        if (!this.lbox)
        {
            items?.Delete();
            return;
        }

        this.notifyWidgetRecreation(this.lbox);

        if (items)
        {
            this.lbox.SetStrings(items.ptr);
        }

        if (this.sizerLbox)
        {
            addWin(this.sizerLbox, this.lbox, 1, EXPAND, border());
            this.sizerLbox.Layout();
        }

        items?.Delete();
    }
}

export function createEditableListboxPage(parent: Pointer): WidgetsPage
{
    return new EditableListboxPage(parent);
}
