// ---------------------------------------------------------------------------
// edit.cpp — DeterminePrefs()
// ---------------------------------------------------------------------------

/** wxString::BeforeFirst(ch) */
function beforeFirst(value: string, ch: string): string
{
    const index = value.indexOf(ch);
    return index < 0 ? value : value.slice(0, index);
}

/** wxString::AfterFirst(ch) */
function afterFirst(value: string, ch: string): string
{
    const index = value.indexOf(ch);
    return index < 0 ? "" : value.slice(index + 1);
}

/**
 * Determines the language from the file patterns.
 * Returns "" when nothing matches, like the C++ (wxEmptyString).
 */
export function determinePrefs(filename: string): string
{
    for (const language of g_LanguagePrefs)
    {
        let filepattern = language.filepattern.toLowerCase();
        while (filepattern !== "")
        {
            const current = beforeFirst(filepattern, ";");
            if (current === filename ||
                current === beforeLast(filename, ".") + ".*" ||
                current === "*." + afterLast(filename, "."))
            {
                return language.name;
            }
            filepattern = afterFirst(filepattern, ";");
        }
    }
    return "";
}

/** wxString::BeforeLast(ch) */
function beforeLast(value: string, ch: string): string
{
    const index = value.lastIndexOf(ch);
    return index < 0 ? "" : value.slice(0, index);
}

/** wxString::AfterLast(ch) */
function afterLast(value: string, ch: string): string
{
    const index = value.lastIndexOf(ch);
    return index < 0 ? value : value.slice(index + 1);
}

/** wxFileName::GetFullName() — the last path component. */
export function fileNameOf(path: string): string
{
    const index = Math.max(path.lastIndexOf("/"), path.lastIndexOf("\\"));
    return index < 0 ? path : path.slice(index + 1);
}
