// pages.kwxts — property page population for the wxPropertyGrid sample port.
//
// The three pages mirror FormMain::PopulateWithStandardItems,
// PopulateWithLibraryConfig, PopulateWithExamples and AddTestProperties.
//
// Every property is created with a public createWx* factory and appended with
// wxPropertyGridPage::Append.  Nested value properties are assembled with
// wxPGProperty::AppendChild / wxPropertyGridInterface::AppendIn before insertion.
// The wxPropertyGridInterface mixin supplies the cell, image, colour, editor and
// read-only operations on the grid, manager and page objects.

import {
    ALWAYS_SHOW_SB,
    ART_FOLDER,
    ART_OTHER,
    ART_REMOVABLE,
    ART_REPORT_VIEW,
    BLACK,
    BLACK_PEN,
    BLUE,
    BORDER_DOUBLE,
    BORDER_NONE,
    BORDER_RAISED,
    BORDER_SIMPLE,
    BORDER_SUNKEN,
    CAPTION,
    CLIP_CHILDREN,
    CLOSE_BOX,
    createWxArrayStringProperty,
    createWxBitmapEmpty,
    createWxBitmapVector,
    createWxBoolProperty,
    createWxColourProperty,
    createWxColourRGB,
    createWxDateProperty,
    createWxDateTime,
    createWxDirProperty,
    createWxEditEnumProperty,
    createWxEnumProperty,
    createWxFileProperty,
    createWxFlagsProperty,
    createWxFloatProperty,
    createWxFontDefault,
    createWxFontProperty,
    createWxImageFileProperty,
    createWxIntProperty,
    createWxLongStringProperty,
    createWxMemoryDCWithBitmap,
    createWxMultiChoiceProperty,
    createWxPenFromColour,
    createWxPropertyCategory,
    createWxStringProperty,
    createWxUIntProperty,
    DP_ALLOWNONE,
    DP_DROPDOWN,
    DP_SHOWCENTURY,
    FONTSTYLE_ITALIC,
    FRAME_FLOAT_ON_PARENT,
    FRAME_NO_TASKBAR,
    FRAME_SHAPED,
    FRAME_TOOL_WINDOW,
    FULL_REPAINT_ON_RESIZE,
    GREEN,
    ICONIZE,
    MAXIMIZE,
    PENSTYLE_SOLID,
    PG_LABEL,
    PG_SPLITTER_AUTO_CENTER,
    RED,
    RESIZE_BORDER,
    STAY_ON_TOP,
    SYSTEM_MENU,
    TAB_TRAVERSAL,
    VERSION_NUM_DOT_STRING,
    VSCROLL,
    WANTS_CHARS,
    WHITE,
    WHITE_BRUSH,
    wxArtProvider_GetBitmapBundle,
    wxBitmapBundle_FromBitmaps,
    wxGetOsDescription,
    wxGetUserHome,
    wxGetUserId,
    wxGetUserName,
    wxPGProperty,
    wxPropertyGrid,
    wxPropertyGridManager,
    wxPropertyGridPage,
