// splash.kwxts — kwxTypeScript port of wxSamples/src/splash/splash.cpp
//
// The wxSplashScreen sample: a main frame with File/Help menus and a two-pane
// status bar. OnInit loads splash.png (or the small-screen artwork on a PDA),
// draws a runtime banner onto the bitmap with a memory DC, and shows it as a
// splash screen that times out after six seconds. Help > About shows a second,
// non-timing splash centred on the parent with a wxMediaCtrl playing press.mpg.
//
// Run from the repository root:
//   bin\Release\kwxts.exe samples\splash\splash.kwxts
//
// Assets: splash.png and press.mpg are copied verbatim from the C++ sample;
// mobile.xpm and ../sample.xpm are reproduced pixel-for-pixel as mobile.svg and
// sample.svg (see the comments at their load sites).

declare const __dirname: string;

import {
    ALIGN_CENTRE_VERTICAL,
    ALIGN_LEFT,
    ALIGN_RIGHT,
    BITMAP_TYPE_PNG,
    BORDER_SIMPLE,
    BRUSHSTYLE_SOLID,
    createWxBitmapDefault,
    createWxBitmapFromImage,
    createWxBrushDefault,
    createWxBrushFromColour,
    createWxClosure,
    createWxColourRGB,
    createWxFontFromInfo,
    createWxFontInfo,
    createWxFrame,
    createWxIconDefault,
    createWxMediaCtrl,
    createWxMemoryDCWithBitmap,
    createWxMenu,
    createWxMenuBar,
    createWxPNGHandler,
    createWxSize,
    createWxSplashScreen,
    createWxString,
    DEFAULT_FRAME_STYLE,
    EVT_MENU,
    ID_ABOUT,
    ID_ANY,
    ID_EXIT,
    ID_HIGHEST,
    initialize,
    readWxString,
    run,
    setAppName,
    setTopWindow,
    shutdown,
    STAY_ON_TOP,
    STB_DEFAULT_STYLE,
    SYS_SCREEN_PDA,
    VERSION_NUM_DOT_STRING,
    wrapWxBitmapBundle,
    wxBitmapBundle_FromSVGFile,
    wxImage_AddHandler,
    wxBitmap,
    wxClosure,
    wxFrame,
    wxImageHandler,
    wxMediaCtrl,
    wxSplashScreen,
    wxSystemSettings_GetScreenType,
    wxYield,
} from "kwx";
import { Callback, exit, platform, Pointer } from "kwx/platform";

// ---------------------------------------------------------------------------
// constants
// ---------------------------------------------------------------------------

/** enum { Minimal_Run = wxID_HIGHEST } — declared but unused by the sample. */
const MINIMAL_RUN = ID_HIGHEST;
void MINIMAL_RUN;

// wxSPLASH_* from wx/generic/splash.h. The kwxFFI constant table does not
// export these names, so they are spelled out here with their header values.
const SPLASH_CENTRE_ON_PARENT = 0x01;
const SPLASH_CENTRE_ON_SCREEN = 0x02;
const SPLASH_TIMEOUT = 0x04;

/** Native dimensions of the converted mobile.xpm (header "144 108 ..."). */
const MOBILE_WIDTH = 144;
const MOBILE_HEIGHT = 108;

/** Native dimensions of the converted ../sample.xpm (header "32 32 ..."). */
const SAMPLE_ICON_SIZE = 32;

// ---------------------------------------------------------------------------
// helpers
// ---------------------------------------------------------------------------

/** Absolute path of an asset shipped next to this module. */
function samplePath(name: string): string
{
    return __dirname.replace(/\\/g, "/") + "/" + name;
}

/** Call fn with a temporary wxString and release it on every path. */
function withString(text: string, fn: (ptr: Pointer) => void): void
{
    const value = createWxString(text);
    try
    {
        fn(value.ptr);
    }
    finally
    {
        value.Delete();
    }
}

/** Load an SVG asset as a native wxBitmapBundle* (owned by wxWidgets here). */
function loadSvgBundle(name: string, width: number, height: number): Pointer
{
    let bundle: Pointer = null;
    withString(samplePath(name), (path) =>
    {
        bundle = wxBitmapBundle_FromSVGFile(path, width, height);
    });
    return bundle;
}

/** Wrap the SVG bundle and render it as a bitmap at its native size. */
function svgBitmap(name: string, width: number, height: number): wxBitmap | null
{
    const bundlePtr = loadSvgBundle(name, width, height);
    if (!bundlePtr)
    {
        return null;
    }

    const bundle = wrapWxBitmapBundle(bundlePtr);
    const bitmap = bundle.GetBitmap(width, height);
    bundle.Delete();
    return bitmap;
}

interface SplashState
{
    readonly frame: wxFrame;
    readonly isPda: boolean;
    /** wxImage handler owned by wxWidgets after AddHandler(). */
    pngHandler: wxImageHandler | null;
    /** Splash screens are destroyed by wxWidgets; never deleted here. */
    readonly splashScreens: wxSplashScreen[];
    /** Media controls are owned by their splash window. */
    readonly mediaControls: wxMediaCtrl[];
    /** Bitmaps / bundles kept alive for the event loop. */
    readonly bitmaps: wxBitmap[];
    readonly callbacks: Callback[];
    readonly closures: wxClosure[];
}

/**
 * Load the small-screen artwork: wxBitmap(mobile_xpm) with the XPM converted to
 * mobile.svg and rendered at its native 144x108 size.
 */
function loadPdaBitmap(_state: SplashState): wxBitmap | null
{
    return svgBitmap("mobile.svg", MOBILE_WIDTH, MOBILE_HEIGHT);
}

/** SetIcon(wxICON(sample)) — sample.svg reproduces ../sample.xpm exactly. */
function setFrameIcon(frame: wxFrame): void
{
    const bitmap = svgBitmap("sample.svg", SAMPLE_ICON_SIZE, SAMPLE_ICON_SIZE);
    if (!bitmap)
    {
        return;
    }

    const icon = createWxIconDefault();
    if (!icon)
    {
        return;
    }

    icon.CopyFromBitmap(bitmap.ptr);
    if (icon.IsOk())
    {
        // wxTopLevelWindow::SetIcon copies the icon.
        frame.SetIcon(icon.ptr);
    }
    icon.Delete();
}

/**
 * MyApp::DecorateSplashScreen — draw the orange banner and the two white
 * labels directly onto the splash bitmap through a memory DC.
 */
function decorateSplashScreen(bitmap: wxBitmap): void
{
    // wxMemoryDC memDc(bmp);
    const memDc = createWxMemoryDCWithBitmap(bitmap.ptr);
    if (!memDc)
    {
        return;
    }

    try
    {
        const width = bitmap.GetWidth();
        const height = bitmap.GetHeight();

        // wxRect(wxPoint(0, (h/10)*9), wxPoint(w, h))
        const bannerTop = Math.trunc(height / 10) * 9;
        const bannerHeight = height - bannerTop;

        // wxDCBrushChanger bc(memDc, wxBrush(wxColour(255, 102, 0)));
        const savedBrush = createWxBrushDefault();
        const orange = createWxColourRGB(255, 102, 0, 255);
        const bannerBrush = orange ? createWxBrushFromColour(orange.ptr, BRUSHSTYLE_SOLID) : null;

        if (savedBrush)
        {
            memDc.GetBrush(savedBrush.ptr);
        }
        if (bannerBrush)
        {
            memDc.SetBrush(bannerBrush.ptr);
        }

        memDc.DrawRectangle(0, bannerTop, width, bannerHeight);
        memDc.DrawLine(0, bannerTop, width, bannerTop);

        // end of the wxDCBrushChanger scope
        if (savedBrush)
        {
            memDc.SetBrush(savedBrush.ptr);
        }

        // memDc.SetTextForeground(*wxWHITE);
        const white = createWxColourRGB(255, 255, 255, 255);
        if (white)
        {
            memDc.SetTextForeground(white.ptr);
        }

        // wxString::Format("wxWidgets %s", wxVERSION_NUM_DOT_STRING)
        const description = "wxWidgets " + readWxString(VERSION_NUM_DOT_STRING);

        // "%s%s wxWidgets. %s" with the compile-date year, as in __DATE__.
        const year = String(new Date().getFullYear());
        const copyrightLabel = "\u00A9" + year + " wxWidgets. All rights reserved.";

        // bannerRect.Deflate(5, 0)
        const labelX = 5;
        const labelWidth = width - 10;

        withString(description, (text) =>
        {
            memDc.DrawLabel(text, labelX, bannerTop, labelWidth, bannerHeight,
                ALIGN_CENTRE_VERTICAL | ALIGN_LEFT, -1);
        });

        // memDc.SetFont(wxFontInfo(8));
        const fontInfo = createWxFontInfo(8);
        const font = fontInfo ? createWxFontFromInfo(fontInfo.ptr) : null;
        if (font)
        {
            memDc.SetFont(font.ptr);
        }

        withString(copyrightLabel, (text) =>
        {
            memDc.DrawLabel(text, labelX, bannerTop, labelWidth, bannerHeight,
                ALIGN_CENTRE_VERTICAL | ALIGN_RIGHT, -1);
        });

        font?.Delete();
        fontInfo?.Delete();
        white?.Delete();
        bannerBrush?.Delete();
        orange?.Delete();
        savedBrush?.Delete();
    }
    finally
    {
        // The bitmap must be deselected before it is handed to wxSplashScreen.
        memDc.Delete();
    }
}

/** Load splash.png, returning null when the load fails (ok == false). */
function loadSplashPng(): wxBitmap | null
{
    const bitmap = createWxBitmapDefault();
    if (!bitmap)
    {
        return null;
    }

    let ok = false;
    withString(samplePath("splash.png"), (path) =>
    {
        ok = bitmap.LoadFile(path, BITMAP_TYPE_PNG) !== 0;
        if (!ok)
        {
            bitmap.Delete();
        }
    });

    return ok ? bitmap : null;
}

// ---------------------------------------------------------------------------
// main frame
// ---------------------------------------------------------------------------

/** MyFrame::MyFrame — frame, File/Help menus, two-pane status bar. */
function createSplashFrame(): SplashState | null
{
    const title = createWxString("wxSplashScreen sample application");
    const frame = createWxFrame(null, ID_ANY, title.ptr, -1, -1, -1, -1, DEFAULT_FRAME_STYLE);
    title.Delete();

    if (!frame)
    {
        return null;
    }

    // m_isPda = (wxSystemSettings::GetScreenType() <= wxSYS_SCREEN_PDA);
    const isPda = wxSystemSettings_GetScreenType() <= SYS_SCREEN_PDA;

    // SetIcon(wxICON(sample));
    setFrameIcon(frame);

    // wxMenu *menuFile = new wxMenu; wxMenu *helpMenu = new wxMenu;
    const noTitle = createWxString("");
    const fileMenu = createWxMenu(noTitle.ptr, 0n);
    const helpMenu = createWxMenu(noTitle.ptr, 0n);
    noTitle.Delete();

    if (fileMenu && helpMenu)
    {
        // helpMenu->Append(wxID_ABOUT, "&About\tF1", "Show about frame");
        withString("&About\tF1", (label) =>
        {
            withString("Show about frame", (help) =>
            {
                helpMenu.Append(ID_ABOUT, label, help, false);
            });
        });

        // menuFile->Append(wxID_EXIT, "E&xit\tAlt-X", "Quit this program");
        withString("E&xit\tAlt-X", (label) =>
        {
            withString("Quit this program", (help) =>
            {
                fileMenu.Append(ID_EXIT, label, help, false);
            });
        });

        // menuBar->Append(menuFile, "&File"); menuBar->Append(helpMenu, "&Help");
        const menuBar = createWxMenuBar(0);
        if (menuBar)
        {
            withString("&File", (label) => menuBar.Append(fileMenu.ptr, label));
            withString("&Help", (label) => menuBar.Append(helpMenu.ptr, label));
            frame.SetMenuBar(menuBar.ptr);
        }
    }

    // CreateStatusBar(2); SetStatusText("Welcome to wxWidgets!");
    frame.CreateStatusBar(2, STB_DEFAULT_STYLE, 0);
    withString("Welcome to wxWidgets!", (text) => frame.SetStatusText(text, 0));

    return {
        frame,
        isPda,
        pngHandler: null,
        splashScreens: [],
        mediaControls: [],
        bitmaps: [],
        callbacks: [],
        closures: [],
    };
}

// ---------------------------------------------------------------------------
// event handlers
// ---------------------------------------------------------------------------

/** MyFrame::OnQuit — Close(true) */
function onQuit(state: SplashState): void
{
    state.frame.Close(true);
}

/**
 * MyFrame::OnAbout — build a half-size copy of the splash bitmap and show a
 * non-timing splash centred on the frame with a media control inside it.
 */
function onAbout(state: SplashState): void
{
    const bitmap = state.isPda ? loadPdaBitmap(state) : loadSplashPng();
    const ok = bitmap !== null && (state.isPda ? bitmap.IsOk() : true);
    if (!bitmap || !ok)
    {
        return;
    }

    state.bitmaps.push(bitmap);

    // wxImage image = bitmap.ConvertToImage();
    const image = bitmap.ConvertToImage();
    if (!image)
    {
        return;
    }

    // do not scale on already small screens
    if (!state.isPda)
    {
        const size = bitmap.GetSize();
        if (size)
        {
            image.Rescale(
                Math.trunc(size.GetWidth() / 2),
                Math.trunc(size.GetHeight() / 2));
        }
    }

    // bitmap = wxBitmap(image);
    const scaled = createWxBitmapFromImage(image.ptr, -1);
    image.Delete();
    if (!scaled)
    {
        return;
    }
    state.bitmaps.push(scaled);

    // new wxSplashScreen(bitmap, wxSPLASH_CENTRE_ON_PARENT | wxSPLASH_NO_TIMEOUT,
    //     0, this, wxID_ANY, wxDefaultPosition, wxDefaultSize,
    //     wxSIMPLE_BORDER | wxSTAY_ON_TOP);
    const splash = createWxSplashScreen(
        scaled.ptr,
        BigInt(SPLASH_CENTRE_ON_PARENT),
        0,
        state.frame.ptr,
        ID_ANY,
        -1, -1, -1, -1,
        BigInt(BORDER_SIMPLE | STAY_ON_TOP));
    if (!splash)
    {
        return;
    }
    state.splashScreens.push(splash);

    const splashWindow = splash.GetSplashWindow();
    if (!splashWindow)
    {
        return;
    }

    // wxMediaCtrl *media = new wxMediaCtrl(win, wxID_EXIT, "press.mpg", wxPoint(2,2));
    const media = createSplashMedia(splashWindow);
    if (media)
    {
        state.mediaControls.push(media);
        media.Play();
    }
}

/** new wxMediaCtrl(parent, wxID_EXIT, file, wxPoint(2,2)) with default size. */
function createSplashMedia(parent: Pointer): wxMediaCtrl | null
{
    let media: wxMediaCtrl | null = null;
    withString(samplePath("press.mpg"), (fileName) =>
    {
        media = createWxMediaCtrl(parent, ID_EXIT, fileName, 2, 2, -1, -1, 0n, null, null);
    });
    return media;
}

/** The event table: EVT_MENU(wxID_EXIT), EVT_MENU(wxID_ABOUT). */
function bindSplashEvents(state: SplashState): void
{
    const quitCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            onQuit(state);
        },
    );
    const quitClosure = createWxClosure(quitCallback.pointer, null)!;
    state.frame.Bind(ID_EXIT, ID_EXIT, EVT_MENU, quitClosure.ptr);

    const aboutCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            onAbout(state);
        },
    );
    const aboutClosure = createWxClosure(aboutCallback.pointer, null)!;
    state.frame.Bind(ID_ABOUT, ID_ABOUT, EVT_MENU, aboutClosure.ptr);

    state.callbacks.push(quitCallback, aboutCallback);
    state.closures.push(quitClosure, aboutClosure);
}

// ---------------------------------------------------------------------------
// bootstrap
// ---------------------------------------------------------------------------

export function main(): number
{
    if (!initialize())
    {
        console.error("Failed to initialize wxWidgets");
        return 1;
    }

    setAppName("splash");

    // wxImage::AddHandler(new wxPNGHandler);
    // wxWidgets takes ownership of the handler; never delete it.
    const pngHandler = createWxPNGHandler();
    if (pngHandler)
    {
        wxImage_AddHandler(pngHandler.ptr);
    }

    const state = createSplashFrame();
    if (!state)
    {
        console.error("splash: failed to create the main frame");
        shutdown();
        return 1;
    }
    state.pngHandler = pngHandler;

    bindSplashEvents(state);

    const bitmap = state.isPda ? loadPdaBitmap(state) : loadSplashPng();
    const ok = bitmap !== null && (state.isPda ? bitmap.IsOk() : true);

    if (bitmap && ok)
    {
        state.bitmaps.push(bitmap);

        // we can even draw dynamic artwork onto our splashscreen
        decorateSplashScreen(bitmap);

        // show the splashscreen
        const splash = createWxSplashScreen(
            bitmap.ptr,
            BigInt(SPLASH_CENTRE_ON_SCREEN | SPLASH_TIMEOUT),
            6000,
            state.frame.ptr,
            ID_ANY,
            -1, -1, -1, -1,
            BigInt(BORDER_SIMPLE | STAY_ON_TOP));
        if (splash)
        {
            state.splashScreens.push(splash);
        }
    }

    // we don't need it at least on wxGTK with GTK+ 2.12.9
    if (platform !== "linux")
    {
        wxYield();
    }

    state.frame.Show();
    setTopWindow(state.frame.ptr);

    const exitCode = run();

    for (const callback of state.callbacks)
    {
        callback.close();
    }
    shutdown();
    return exitCode;
}

exit(main());
