//-----------------------------------------------------------------------------
// Event plumbing
//-----------------------------------------------------------------------------

interface BoundHandler
{
    callback: Callback;
    // Kept referenced until after run() returns.
    closure: wxClosure;
}

const boundHandlers: BoundHandler[] = [];

// Callbacks installed on the native PropertyGrid extension hooks.
const extraCallbacks: Callback[] = [];

// The wxPGMultiButton created by the custom editor's CreateControls().
let multiButtonButtons: wxPGMultiButton | null = null;

// wxXmlResource handler registration is done only once.
let xrcInitialized = false;

// The custom (Examples) page hooks are shared between grid replacements so the
// fixed native callback pool is never exhausted by repeated style changes.
let pageState: AppState | null = null;
let pageHandlingCallback: Callback | null = null;
const pageByToken = new Map<number, kwxPropertyGridPage>();
let nextPageToken = 1;

interface SharedPageHandler
{
    callback: Callback;
    closure: wxClosure;
    type: number;
}

let pageEventHandlers: SharedPageHandler[] | null = null;

function bindEvent(
    target: wxEvtHandler,
    first: number,
    last: number,
    type: number,
    handler: (eventPtr: Pointer) => void,
): void
{
    // The runtime callback pool has 64 fixed slots; keep headroom for the
    // repeated "Run Minimal Sample" invocations.
    if (boundHandlers.length >= 60)
    {
        console.error("propgrid: native callback pool full, event not bound");
        return;
    }

    const callback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr) return;
            handler(eventPtr);
        },
    );

    const closure = createWxClosure(callback.pointer, null);
    if (!closure)
    {
        callback.close();
        return;
    }

    target.Bind(first, last, type, closure.ptr);
    boundHandlers.push({ callback, closure });
}

//-----------------------------------------------------------------------------
// Application state
//-----------------------------------------------------------------------------

interface AppState
{
    frame: wxFrame;
    panel: wxPanel;
    topSizer: wxBoxSizer | null;
    btnSizer: wxBoxSizer | null;
    manager: wxPropertyGridManager | null;
    grid: wxPropertyGrid | null;
    logWindow: wxLogWindow | null;
    menuTry: wxMenu;
    menuTools1: wxMenu;
    menuTools2: wxMenu;
    itemEnable: wxMenuItem | null;
    itemCatColours: wxMenuItem | null;
    hasHeader: boolean;
    labelEditingEnabled: boolean;
    multiButtonEditor: kwxPGTextCtrlEditor | null;
    storedValues: wxVariant | null;
    savedState: string;
    popup: wxPopupWindow | null;
    popupPanel: wxScrolledWindow | null;
    popupGrid: wxPropertyGrid | null;
    popupSizer: wxBoxSizer | null;
}

interface MenuSet
{
    menuTry: wxMenu;
    menuTools1: wxMenu;
    menuTools2: wxMenu;
    itemEnable: wxMenuItem | null;
    itemCatColours: wxMenuItem | null;
}

//-----------------------------------------------------------------------------
// Grid creation
//-----------------------------------------------------------------------------

const DEFAULT_PG_STYLE = PG_BOLD_MODIFIED
    | PG_SPLITTER_AUTO_CENTER
    | PG_AUTO_SORT
    | PG_TOOLBAR
    | PG_DESCRIPTION;

function defaultExtraStyle(): number
{
    // wxALWAYS_NATIVE_DOUBLE_BUFFER is 0 on MSW, 1 elsewhere.
    const nativeBuffer = platform !== "windows" ? PG_EX_NATIVE_DOUBLE_BUFFERING : 0;
    return nativeBuffer | PG_EX_MODE_BUTTONS | PG_EX_MULTIPLE_SELECTION;
}

function populateGrid(state: AppState): void
{
    const manager = state.manager;
    const grid = state.grid;
    if (!manager || !grid) return;

    const title = takeText(state.frame.GetTitle());
    const frameStyle = Number(state.frame.GetWindowStyle());

    withString("Standard Items", (label) => manager.AddPage(label, null));
    manager.SelectPage(0);
    let page = manager.GetPage(0);
    if (page) populateStandardItems(page, grid, title, frameStyle);

    withString("wxWidgets Library Config", (label) => manager.AddPage(label, null));
    manager.SelectPage(1);
    page = manager.GetPage(1);
    if (page) populateLibraryConfig(page, grid, manager);

    // Use a custom page (wxMyPropertyGridPage) to test the custom
    // wxPropertyGridPage feature.
    withString("Examples", (label) =>
    {
        const token = nextPageToken++;
        const custom = createKwxPropertyGridPage(BigInt(token));
        if (custom)
        {
            pageByToken.set(token, custom);
            if (!pageHandlingCallback)
            {
                pageHandlingCallback = new Callback(
                    { parameters: ["pointer"], result: "void" },
                    (_f, _d, objectPtr) =>
                    {
                        if (!objectPtr) return;
                        pageByToken.get(Number(objectPtr))
                            ?.SetIsHandlingAllEventsResult(false);
                    },
                );
                extraCallbacks.push(pageHandlingCallback);
            }
            custom.SetOnIsHandlingAllEvents(pageHandlingCallback.pointer);

            withString("IntProperty", (text) =>
            {
                const prop = createWxIntProperty(text, PG_LABEL, 12345678);
                if (prop) custom.Append(prop.ptr);
            });

            manager.AddPageObject(label, null, custom.ptr);
            bindCustomPageEvents(state, custom);
        }
        else
        {
            const plain = manager.AddPage(label, null);
            if (plain)
            {
                withString("IntProperty", (text) =>
                {
                    const prop = createWxIntProperty(text, PG_LABEL, 12345678);
                    if (prop) plain.Append(prop.ptr);
                });
            }
        }
    });

    manager.SelectPage(2);
    page = manager.GetPage(2);
    if (page) populateExamples(page, state.multiButtonEditor?.ptr ?? null);

    // Initialize the Size/Position substitutes with the frame geometry, as the
    // C++ wxSizeProperty / wxPointProperty constructors do.
    const frameSize = state.frame.GetSize();
    const framePos = state.frame.GetPosition();
    if (frameSize)
    {
        const sizeWidth = findProperty(manager, "Size.Width");
        const sizeHeight = findProperty(manager, "Size.Height");
        if (sizeWidth) setValueLong(grid, sizeWidth, frameSize.GetWidth());
        if (sizeHeight) setValueLong(grid, sizeHeight, frameSize.GetHeight());
    }
    if (framePos)
    {
        const pointX = findProperty(manager, "Position.X");
        const pointY = findProperty(manager, "Position.Y");
        if (pointX) setValueLong(grid, pointX, framePos.GetX());
        if (pointY) setValueLong(grid, pointY, framePos.GetY());
    }

    // The C++ sample leaves the first page selected.
    manager.SelectPage(0);
}

function createGrid(state: AppState, style = -1, extraStyle = -1): void
{
    if (style < 0) style = DEFAULT_PG_STYLE;
    if (extraStyle < 0) extraStyle = defaultExtraStyle();

    const manager = createWxPropertyGridManager(
        state.panel.ptr, PGID, -1, -1, -1, -1, style);
    if (!manager) return;

    state.manager = manager;
    state.grid = manager.GetGrid();
    const grid = state.grid;
    if (!grid) return;

    manager.SetExtraStyle(BigInt(extraStyle));

    // This is the default validation failure behaviour.
    manager.SetValidationFailureBehavior(PG_VFB_MARK_CELL | PG_VFB_SHOW_MESSAGEBOX);

    grid.SetVerticalSpacing(2);

    const cell: wxPGCell | null = createWxPGCell();
    if (cell)
    {
        withString("Unspecified", (ptr) => cell.SetText(ptr));
        cell.SetFgCol(LIGHT_GREY);
        grid.SetUnspecifiedValueAppearance(cell.ptr);
        cell.Delete();
    }

    populateGrid(state);

    grid.MakeColumnEditable(0, state.labelEditingEnabled);
    manager.ShowHeader(state.hasHeader);
    if (state.hasHeader)
    {
        withString("Units", (ptr) => manager.SetColumnTitle(2, ptr));
    }
}

function replaceGrid(state: AppState, style: number, extraStyle: number): void
{
    const old = state.manager;
    pageByToken.clear();
    createGrid(state, style, extraStyle);

    // wxSizer exposes Replace(index, ...) only, not Replace(window, window).
    // Rebuilding the two top-level items is equivalent here.
    if (state.topSizer)
    {
        state.topSizer.Clear(false);
        if (state.manager)
            state.topSizer.AddWindow(state.manager.ptr, 1, EXPAND, 0, null);
        if (state.btnSizer)
            state.topSizer.AddSizer(state.btnSizer.ptr, 0, EXPAND | ALL, 5, null);
    }

    if (old) old.Destroy();
    state.manager?.SetFocus();
    state.panel.Layout();
}

