// dialogs.kwxts — the modal dialogs used by the richtext sample.
//
// Ported from MyFrame::OnFont / OnParagraph / OnFormat / OnInsertSymbol /
// OnInsertURL / OnInsertImage / OnViewHTML / OnPageSetup.

import {
    ALL,
    ALIGN_CENTER,
    BLUE,
    BORDER_SUNKEN,
    DEFAULT_DIALOG_STYLE,
    EXPAND,
    FD_OPEN,
    ID_ANY,
    ID_CANCEL,
    ID_OK,
    RICHTEXT_FORMAT_BULLETS,
    RICHTEXT_FORMAT_FONT,
    RICHTEXT_FORMAT_INDENTS_SPACING,
    RICHTEXT_FORMAT_TABS,
    RICHTEXT_HANDLER_SAVE_IMAGES_TO_MEMORY,
    RICHTEXT_SETSTYLE_CHARACTERS_ONLY,
    RICHTEXT_SETSTYLE_OPTIMIZE,
    RICHTEXT_SETSTYLE_WITH_UNDO,
    RICHTEXT_TYPE_HTML,
    TE_READONLY,
    TEXT_ATTR_FONT,
    VERTICAL,
    VSCROLL,
    createWxArrayInt,
    createWxBoxSizer,
    createWxButton,
    createWxDialog,
    createWxFileDialog,
    createWxFontDefault,
    createWxHtmlWindow,
    createWxImageFromFile,
    createWxNotebook,
    createWxPanel,
    createWxRichTextAttr,
    createWxRichTextCtrl,
    createWxRichTextFormattingDialog,
    createWxRichTextHTMLHandler,
    createWxStringOutputStream,
    createWxSymbolPickerDialog,
    readAndDeleteWxString,
    wxFrame,
    wxRichTextCtrl,
} from "kwx";

import { getTextFromUser, withString } from "./support.kwxts";

/** wxRichTextFormattingDialog pages for OnFont / OnParagraph / OnFormat. */
export function showFormattingDialog(
    frame: wxFrame,
    ctrl: wxRichTextCtrl,
    start: number,
    end: number,
    pages: number,
    applyFlags: number,
    allowPixelFontSize: boolean,
): void
{
    const dialog = withString("Formatting", (title) =>
        createWxRichTextFormattingDialog(
            BigInt(pages), frame.ptr, title, ID_ANY, -1, -1, -1, -1,
            BigInt(DEFAULT_DIALOG_STYLE),
        ));
    if (!dialog)
    {
        return;
    }

    if (allowPixelFontSize)
    {
        dialog.SetOptions(1); // Option_AllowPixelFontSize
    }

    dialog.GetStyle(ctrl.ptr, BigInt(start), BigInt(end));

    if (dialog.ShowModal() === ID_OK)
    {
        dialog.ApplyStyle(ctrl.ptr, BigInt(start), BigInt(end), applyFlags);
    }

    dialog.Destroy();
}

/** MyFrame::OnInsertSymbol() */
export function showSymbolDialog(frame: wxFrame, ctrl: wxRichTextCtrl): void
{
    const attr = createWxRichTextAttr();
    if (!attr)
    {
        return;
    }

    attr.SetFlags(BigInt(TEXT_ATTR_FONT));
    ctrl.GetStyle(ctrl.GetInsertionPoint(), attr.ptr);

    let currentFontName = "";
    if (attr.HasFont())
    {
        const font = createWxFontDefault();
        if (font)
        {
            attr.GetFont(font.ptr);
            if (font.IsOk())
            {
                const faceName = font.GetFaceName();
                if (faceName)
                {
                    currentFontName = readAndDeleteWxString(faceName.ptr);
                }
            }
            font.Delete();
        }
    }

    const dialog = withString("*", (symbol) =>
        withString("", (fontName) =>
            withString(currentFontName, (normalFont) =>
                withString("Symbols", (caption) =>
                    createWxSymbolPickerDialog(
                        symbol, fontName, normalFont, frame.ptr, ID_ANY, caption,
                        -1, -1, -1, -1, BigInt(DEFAULT_DIALOG_STYLE),
                    )))));
    if (!dialog)
    {
        attr.Delete();
        return;
    }

    if (dialog.ShowModal() === ID_OK && dialog.HasSelection())
    {
        const insertionPoint = Number(ctrl.GetInsertionPoint());
        const symbol = dialog.GetSymbol();
        const symbolText = symbol ? readAndDeleteWxString(symbol.ptr) : "";
        if (symbolText !== "")
        {
            withString(symbolText, (text) => ctrl.WriteText(text));
        }

        if (!dialog.UseNormalFont())
        {
            const font = createWxFontDefault();
            if (font)
            {
                attr.GetFont(font.ptr);
                const fontName = dialog.GetFontName();
                if (fontName)
                {
                    const name = readAndDeleteWxString(fontName.ptr);
                    withString(name, (face) => font.SetFaceName(face));
                }
                attr.SetFont(font.ptr);
                ctrl.SetStyle(
                    BigInt(insertionPoint), BigInt(insertionPoint + 1), attr.ptr,
                );
                font.Delete();
            }
        }
    }

    dialog.Destroy();
    attr.Delete();
}

/** MyFrame::OnInsertURL() */
export function showInsertUrlDialog(frame: wxFrame, ctrl: wxRichTextCtrl): void
{
    const url = getTextFromUser("URL:", "Insert URL", "", frame.ptr);
    if (url === "")
    {
        return;
    }

    // wxRichTextAttr urlStyle; urlStyle.SetTextColour(*wxBLUE);
    // urlStyle.SetFontUnderlined(true);
    const urlStyle = createWxRichTextAttr();
    if (!urlStyle)
    {
        return;
    }
    urlStyle.SetTextColour(BLUE);
    urlStyle.SetFontUnderlined(true);

    ctrl.BeginStyle(urlStyle.ptr);
    withString(url, (value) =>
    {
        ctrl.BeginURL(value, null);
        ctrl.WriteText(value);
        ctrl.EndURL();
    });
    ctrl.EndStyle();

    urlStyle.Delete();
}

/** MyFrame::OnInsertImage() */
export function showInsertImageDialog(frame: wxFrame, ctrl: wxRichTextCtrl): void
{
    const wildcard =
        "BMP and GIF files (*.bmp;*.gif)|*.bmp;*.gif|" +
        "PNG files (*.png)|*.png|" +
        "JPEG files (*.jpg;*.jpeg)|*.jpg;*.jpeg";

    const dialog = withString("Choose an image", (caption) =>
        withString(wildcard, (filter) =>
            withString("", (empty) =>
                createWxFileDialog(
                    frame.ptr, caption, empty, empty, filter,
                    -1, -1, FD_OPEN, -1, -1,
                ))));
    if (!dialog)
    {
        return;
    }

    if (dialog.ShowModal() === ID_OK)
    {
        const path = dialog.GetPath();
        if (path)
        {
            const fileName = readAndDeleteWxString(path.ptr);
            const image = withString(fileName, (file) => createWxImageFromFile(file));
            if (image && image.IsOk() && image.GetType() !== 0)
            {
                withString(fileName, (file) =>
                    ctrl.WriteImageFile(file, image.GetType(), null));
            }
            if (image)
            {
                image.Delete();
            }
        }
    }

    dialog.Destroy();
}

/** MyFrame::OnViewHTML() */
export function showHtmlDialog(frame: wxFrame, ctrl: wxRichTextCtrl): void
{
    const dialog = withString("HTML", (title) =>
        createWxDialog(
            frame.ptr, ID_ANY, title, -1, -1, 500, 400, DEFAULT_DIALOG_STYLE,
        ));
    if (!dialog)
    {
        return;
    }

    const sizer = createWxBoxSizer(VERTICAL);
    if (sizer)
    {
        dialog.SetSizer(sizer.ptr, true);
    }

    const htmlWindow = withString("", (name) =>
        createWxHtmlWindow(
            dialog.ptr, ID_ANY, -1, -1, 500, 400,
            BigInt(BORDER_SUNKEN), name,
        ));
    if (htmlWindow && sizer)
    {
        sizer.AddWindow(htmlWindow.ptr, 1, EXPAND | ALL, 5, null);
    }

    const cancelButton = withString("&Close", (label) =>
        createWxButton(dialog.ptr, ID_CANCEL, label, -1, -1, -1, -1, 0));
    if (cancelButton && sizer)
    {
        sizer.AddWindow(cancelButton.ptr, 0, ALL | ALIGN_CENTER, 5, null);
    }

    // wxStringOutputStream strStream(&text);
    const stream = createWxStringOutputStream();
    const handler = withString("HTML", (name) =>
        withString("html", (ext) =>
            createWxRichTextHTMLHandler(name, ext, RICHTEXT_TYPE_HTML)));

    if (handler && stream && htmlWindow)
    {
        handler.SetFlags(RICHTEXT_HANDLER_SAVE_IMAGES_TO_MEMORY);

        // wxArrayInt fontSizeMapping; 7, 9, 11, 12, 14, 22, 100
        const fontSizeMapping = createWxArrayInt();
        if (fontSizeMapping)
        {
            for (const size of [7, 9, 11, 12, 14, 22, 100])
            {
                fontSizeMapping.Add(size);
            }
            handler.SetFontSizeMapping(fontSizeMapping.ptr);
            fontSizeMapping.Delete();
        }

        const buffer = ctrl.GetBuffer();
        let saved = false;
        if (buffer)
        {
            saved = handler.SaveFile(buffer.ptr, stream.ptr);
        }

        if (saved)
        {
            const page = stream.GetString();
            if (page)
            {
                htmlWindow.SetPage(page.ptr);
                readAndDeleteWxString(page.ptr);
            }
        }

        if (sizer)
        {
            sizer.Fit(dialog.ptr);
        }

        dialog.ShowModal();

        // Now delete the temporary images.
        handler.DeleteTemporaryImages();
    }
    else
    {
        dialog.ShowModal();
    }

    if (handler)
    {
        handler.Delete();
    }
    if (stream)
    {
        stream.Delete();
    }

    dialog.Destroy();
}

/** MyFrame::OnPageSetup() — the sample shows a test dialog, not the print setup. */
export function showPageSetupTestDialog(frame: wxFrame): void
{
    const dialog = withString("Testing", (title) =>
        createWxDialog(frame.ptr, ID_ANY, title, 10, 10, 400, 300, DEFAULT_DIALOG_STYLE));
    if (!dialog)
    {
        return;
    }

    const notebook = createWxNotebook(dialog.ptr, ID_ANY, 5, 5, 300, 250, 0);
    if (notebook)
    {
        const panel = createWxPanel(notebook.ptr, ID_ANY, -1, -1, -1, -1, 0);
        const panel2 = createWxPanel(notebook.ptr, ID_ANY, -1, -1, -1, -1, 0);

        if (panel)
        {
            createWxRichTextCtrl(
                panel.ptr, ID_ANY, 5, 5, 200, 150, VSCROLL | TE_READONLY,
            );
            withString("Page 1", (label) =>
                notebook.AddPage(panel.ptr, label, false, -1));
        }
        if (panel2)
        {
            createWxRichTextCtrl(
                panel2.ptr, ID_ANY, 5, 5, 200, 150, VSCROLL | TE_READONLY,
            );
            withString("Page 2", (label) =>
                notebook.AddPage(panel2.ptr, label, false, -1));
        }
    }

    withString("OK", (label) =>
        createWxButton(dialog.ptr, ID_OK, label, 5, 180, -1, -1, 0));

    dialog.ShowModal();
    dialog.Destroy();
}
