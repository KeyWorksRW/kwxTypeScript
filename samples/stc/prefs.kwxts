// ---------------------------------------------------------------------------
// prefs.cpp — LanguageInfo g_LanguagePrefs
// ---------------------------------------------------------------------------

export interface StyleType
{
    type: number;
    words: string | null;
}

export interface LanguageInfo
{
    name: string;
    filepattern: string;
    lexer: number;
    styles: StyleType[];
    folds: number;
}

const styleType = (type: number, words: string | null = null): StyleType => ({ type, words });

/** Pads a style list to STYLE_TYPES_COUNT with the C++ {-1, nullptr} filler. */
const padStyles = (styles: StyleType[]): StyleType[] =>
{
    const result = styles.slice();
    while (result.length < STYLE_TYPES_COUNT)
    {
        result.push({ type: -1, words: null });
    }
    return result;
};

export const g_LanguagePrefs: LanguageInfo[] = [
    {
        name: "C++",
        filepattern: "*.c;*.cc;*.cpp;*.cxx;*.cs;*.h;*.hh;*.hpp;*.hxx;*.sma",
        lexer: wxSTC_LEX_CPP,
        styles: padStyles([
            styleType(mySTC_TYPE_DEFAULT),
            styleType(mySTC_TYPE_COMMENT),
            styleType(mySTC_TYPE_COMMENT_LINE),
            styleType(mySTC_TYPE_COMMENT_DOC),
            styleType(mySTC_TYPE_NUMBER),
            styleType(mySTC_TYPE_WORD1, CppWordlist1),
            styleType(mySTC_TYPE_STRING),
            styleType(mySTC_TYPE_CHARACTER),
            styleType(mySTC_TYPE_UUID),
            styleType(mySTC_TYPE_PREPROCESSOR),
            styleType(mySTC_TYPE_OPERATOR),
            styleType(mySTC_TYPE_IDENTIFIER),
            styleType(mySTC_TYPE_STRING_EOL),
            styleType(mySTC_TYPE_DEFAULT),
            styleType(mySTC_TYPE_REGEX),
            styleType(mySTC_TYPE_COMMENT_SPECIAL),
            styleType(mySTC_TYPE_WORD2, CppWordlist2),
            styleType(mySTC_TYPE_WORD3, CppWordlist3),
            styleType(mySTC_TYPE_ERROR),
        ]),
        folds: mySTC_FOLD_COMMENT | mySTC_FOLD_COMPACT | mySTC_FOLD_PREPROC,
    },
    {
        name: "Python",
        filepattern: "*.py;*.pyw",
        lexer: wxSTC_LEX_PYTHON,
        styles: padStyles([
            styleType(mySTC_TYPE_DEFAULT),
            styleType(mySTC_TYPE_COMMENT_LINE),
            styleType(mySTC_TYPE_NUMBER),
            styleType(mySTC_TYPE_STRING),
            styleType(mySTC_TYPE_CHARACTER),
            styleType(mySTC_TYPE_WORD1, PythonWordlist1),
            styleType(mySTC_TYPE_DEFAULT),
            styleType(mySTC_TYPE_DEFAULT),
            styleType(mySTC_TYPE_DEFAULT),
            styleType(mySTC_TYPE_DEFAULT, PythonWordlist2),
            styleType(mySTC_TYPE_OPERATOR),
            styleType(mySTC_TYPE_IDENTIFIER),
            styleType(mySTC_TYPE_DEFAULT),
            styleType(mySTC_TYPE_STRING_EOL),
        ]),
        folds: mySTC_FOLD_COMMENTPY | mySTC_FOLD_QUOTESPY,
    },
    {
        name: DEFAULT_LANGUAGE,
        filepattern: "*.*",
        lexer: wxSTC_LEX_PROPERTIES,
        styles: padStyles([
            styleType(mySTC_TYPE_DEFAULT),
            styleType(mySTC_TYPE_DEFAULT),
            styleType(mySTC_TYPE_DEFAULT),
            styleType(mySTC_TYPE_DEFAULT),
            styleType(mySTC_TYPE_DEFAULT),
        ]),
        folds: 0,
    },
];

export const g_LanguagePrefsSize = g_LanguagePrefs.length;

