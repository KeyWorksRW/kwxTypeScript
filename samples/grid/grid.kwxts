// ---------------------------------------------------------------------------
// GridFrame::SetDefaults()
// ---------------------------------------------------------------------------

function setDefaults(state: GridFrameState): void
{
    const bar = state.menuBar;
    bar.Check(ID_TOGGLEROWLABELS, true);
    bar.Check(ID_TOGGLECOLLABELS, true);
    bar.Check(ID_TOGGLEEDIT, true);
    bar.Check(ID_TOGGLEROWSIZING, true);
    bar.Check(ID_TOGGLECOLSIZING, true);
    bar.Check(ID_TOGGLEROWLABELSIZING, false);
    bar.Check(ID_TOGGLECOLLABELSIZING, false);
    bar.Check(ID_TOGGLECOLMOVING, false);
    bar.Check(ID_TOGGLECOLHIDING, true);
    bar.Check(ID_TOGGLEGRIDSIZING, true);
    bar.Check(ID_TOGGLEGRIDDRAGCELL, false);
    bar.Check(ID_TOGGLEGRIDLINES, true);
    bar.Check(ID_CELLOVERFLOW, true);
}

// ---------------------------------------------------------------------------
// GridFrame constructor
// ---------------------------------------------------------------------------

function createGridFrame(): GridFrameState | null
{
    const title = createWxString("wxWidgets grid class demo");
    const frame = createWxFrame(
        null, ID_ANY, title.ptr, -1, -1, -1, -1, DEFAULT_FRAME_STYLE,
    );
    title.Delete();

    if (!frame)
    {
        return null;
    }

    const menus = buildMenus();
    if (!menus)
    {
        frame.Destroy();
        return null;
    }
    frame.SetMenuBar(menus.menuBar.ptr);

    const gridWidth = frame.FromDIP(800);
    const gridHeight = frame.FromDIP(450);
    const grid = createWxGrid(
        frame.ptr,
        ID_ANY,
        0,
        0,
        gridWidth,
        gridHeight,
        WANTS_CHARS,
    );
    if (!grid)
    {
        frame.Destroy();
        return null;
    }

    const empty = createWxString("");
    const logWin = createWxTextCtrl(
        frame.ptr,
        ID_ANY,
        empty.ptr,
        -1,
        -1,
        -1,
        8 * frame.GetCharHeight(),
        BigInt(TE_MULTILINE),
    );
    empty.Delete();

    if (!logWin)
    {
        frame.Destroy();
        return null;
    }

    const logger = createWxLogTextCtrl(logWin.ptr);
    if (!logger)
    {
        frame.Destroy();
        return null;
    }

    // wxLog *m_logOld = wxLog::SetActiveTarget(logger);
    const logOld = lib.symbols.wxLog_SetActiveTarget(logger.ptr);

    const state: GridFrameState =
    {
        frame: frame as wxFrame,
        menuBar: menus.menuBar,
        grid: grid as wxGrid,
        logWin: logWin as wxTextCtrl,
        logger: logger as wxLogTextCtrl,
        logOld,
        addToSel: false,
        customTab: false,
        checkeredOn: false,
        colouredOn: false,
        checkeredSaved: null,
        hiddenColSizes: new Map<number, number>(),
        hiddenRowSizes: new Map<number, number>(),
        keepAlive: [],
        callbacks: [],
        closures: [],
    };

    populateGrid(state);

    const topSizer = createWxBoxSizer(VERTICAL);
    if (topSizer)
    {
        // topSizer->Add(grid, wxSizerFlags(2).Expand());
        topSizer.AddWindow(grid.ptr, 2, EXPAND, 0, null);
        // topSizer->Add(logWin, wxSizerFlags(1).Expand());
        topSizer.AddWindow(logWin.ptr, 1, EXPAND, 0, null);
        frame.SetSizerAndFit(topSizer.ptr, true);
    }

    frame.Centre(BOTH);
    setDefaults(state);

    return state;
}

// ---------------------------------------------------------------------------
// Event table
// ---------------------------------------------------------------------------

const GRID_EVENT_TYPES: readonly number[] =
[
    EVT_GRID_LABEL_LEFT_CLICK,
    EVT_GRID_CELL_LEFT_CLICK,
    EVT_GRID_ROW_SIZE,
    EVT_GRID_COL_SIZE,
    EVT_GRID_COL_AUTO_SIZE,
    EVT_GRID_ROW_LABEL_SIZE,
    EVT_GRID_COL_LABEL_SIZE,
    EVT_GRID_ROW_MOVE,
    EVT_GRID_COL_MOVE,
    EVT_GRID_SELECT_CELL,
    EVT_GRID_RANGE_SELECTING,
    EVT_GRID_RANGE_SELECTED,
    EVT_GRID_CELL_CHANGING,
    EVT_GRID_CELL_CHANGED,
    EVT_GRID_CELL_BEGIN_DRAG,
    EVT_GRID_EDITOR_SHOWN,
    EVT_GRID_EDITOR_HIDDEN,
    EVT_GRID_TABBING,
    EVT_CONTEXT_MENU,
];

function connectEvents(state: GridFrameState): void
{
    // EVT_CLOSE_WINDOW: stop the loop instead of closing from inside a handler.
    const closeCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            exitMainLoop();
        },
    );
    const closeClosure = createWxClosure(closeCallback.pointer, null)!;
    lib.symbols.wxEvtHandler_Connect(
        state.frame.ptr, ID_ANY, ID_ANY, EVT_CLOSE_WINDOW, closeClosure.ptr,
    );
    state.callbacks.push(closeCallback);
    state.closures.push(closeClosure);

    // EVT_MENU for the whole menu tree.
    const menuCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            handleMenuEvent(state, eventPtr);
        },
    );
    const menuClosure = createWxClosure(menuCallback.pointer, null)!;
    lib.symbols.wxEvtHandler_Connect(
        state.frame.ptr, ID_ANY, ID_ANY, EVT_MENU, menuClosure.ptr,
    );
    state.callbacks.push(menuCallback);
    state.closures.push(menuClosure);

    // Every EVT_GRID_* entry on the grid; one callback per binding keeps the
    // ownership rules of the sample template.
    for (const type of GRID_EVENT_TYPES)
    {
        const callback = new Callback(
            { parameters: ["pointer", "pointer", "pointer"], result: "void" },
            (_closureFun, _data, eventPtr) =>
            {
                if (!eventPtr)
                {
                    return;
                }
                handleGridEvent(state, eventPtr);
            },
        );
        const closure = createWxClosure(callback.pointer, null)!;
        lib.symbols.wxEvtHandler_Connect(
            state.grid.ptr, ID_ANY, ID_ANY, type, closure.ptr,
        );
        state.callbacks.push(callback);
        state.closures.push(closure);
    }
}

// ---------------------------------------------------------------------------
// main
// ---------------------------------------------------------------------------

export function main(): number
{
    if (!initialize())
    {
        console.error("Failed to initialize wxWidgets");
        return 1;
    }

    setAppName("wxGrid demo");

    const state = createGridFrame();
    if (!state)
    {
        console.error("grid: failed to create the main frame");
        shutdown();
        return 1;
    }

    connectEvents(state);

    state.frame.Show();
    setTopWindow(state.frame.ptr);

    const exitCode = run();

    // GridFrame::~GridFrame(): restore the previous log target, then delete the
    // logger. The log text control is owned by the frame.
    lib.symbols.wxLog_SetActiveTarget(state.logOld);
    state.logger.Delete();

    for (const callback of state.callbacks)
    {
        callback.close();
    }
    shutdown();
    return exitCode;
}

exit(main());
