const ITALIC_FONT_HELP = "Font of this property's wxPGCell has "
    + "been modified. Obtain property's cell "
    + "with wxPGProperty::"
    + "GetOrCreateCell(column).";

export function populateLibraryConfig(
    page: wxPropertyGridPage, grid: wxPropertyGrid, manager: wxPropertyGridManager,
): void
{
    if (manager.HasFlag(PG_SPLITTER_AUTO_CENTER))
    {
        page.SetColumnProportion(0, 3);
        page.SetColumnProportion(1, 1);
    }

    const folder = wxArtProvider_GetBitmapBundle(ART_REPORT_VIEW, ART_OTHER, -1, -1);

    const italicFont = grid.GetCaptionFont();
    if (italicFont) italicFont.SetStyle(FONTSTYLE_ITALIC);

    const top = append(page, makeCategory("wxWidgets Library Configuration"));
    if (top && folder)
    {
        page.SetPropertyCell(top.ptr, 0, PG_LABEL, folder.ptr, null, null);
    }
    if (top)
    {
        withString("Is Enabled", (ptr) =>
            page.SetPropertyCell(top.ptr, 1, ptr, null, null, null));
        const value = variantString("Is Enabled");
        if (value)
        {
            page.SetPropertyValue(top.ptr, value.ptr);
            value.Delete();
        }
    }

    for (const group of LIB_CONF)
    {
        const category = makeCategory(group.group);
        if (category)
        {
            if (top) page.AppendIn(top.ptr, category.ptr);
            else page.Append(category.ptr);

            if (folder)
            {
                page.SetPropertyCell(category.ptr, 0, PG_LABEL, folder.ptr, null, null);
            }
            const cell = category.GetCell(0);
            if (cell && italicFont) cell.SetFont(italicFont.ptr);
            withString(ITALIC_FONT_HELP, (ptr) => category.SetHelpString(ptr));
        }

        for (const item of group.items)
        {
            const boolProp = append(page, makeBool(item.label, item.value));
            if (!item.defined) disable(page, boolProp);
        }
    }

    if (top)
    {
        withString("UseCheckbox", (key) =>
        {
            const value = variantBool(true);
            if (!value) return;
            page.SetPropertyAttribute(top.ptr, key, value.ptr, PG_RECURSE);
            value.Delete();
        });
    }

    if (folder) folder.Delete();
}

//-----------------------------------------------------------------------------
// Examples page
//-----------------------------------------------------------------------------

const ENUM_LABELS = ["One Item", "Another Item", "One More", "This Is Last"];
const ENUM_VALUES = [40, 80, 120, 160];

const SOC_LABELS = ENUM_LABELS.concat([
    "Look, it continues", "Even More", "And More", "", "True End of the List",
]);
const SOC_VALUES = ENUM_VALUES.concat([200, 240, 280, 300, 320]);

function makeVectorProperty(label: string): wxPGProperty | null
{
    const prop = makeString(label, "<composed>");
    if (!prop) return null;
    for (const axis of ["X", "Y", "Z"])
    {
        const child = makeFloat(axis, 0.0);
        if (child) prop.AppendChild(child.ptr);
    }
    return prop;
}

function makeTriangleProperty(label: string): wxPGProperty | null
{
    const prop = makeStringNamed(label, label, "<composed>");
    if (!prop) return null;
    for (const corner of ["A", "B", "C"])
    {
        const child = makeVectorProperty(corner);
        if (child) prop.AppendChild(child.ptr);
    }
    return prop;
}

function buildSpeeds(): wxPGProperty | null
{
    const speeds = makeString("Speeds", "<composed>");
    if (!speeds) return null;
    const maxSpeed = makeInt("Max. Speed (mph)", 290);
    if (maxSpeed) speeds.AppendChild(maxSpeed.ptr);
    const accel = makeFloat("0-100 mph (sec)", 3.9);
    if (accel) speeds.AppendChild(accel.ptr);
    const quarter = makeFloat("1/4 mile (sec)", 8.6);
    if (quarter) speeds.AppendChild(quarter.ptr);
    return speeds;
}

function buildCar(): wxPGProperty | null
{
    const car = makeString("Car", "<composed>");
    if (!car) return null;

    const model = makeString("Model", "Lamborghini Diablo SV");
    if (model) car.AppendChild(model.ptr);

    const engine = makeInt("Engine Size (cc)", 5707);
    if (engine) car.AppendChild(engine.ptr);

    const speeds = buildSpeeds();
    if (speeds) car.AppendChild(speeds.ptr);

    const price = makeInt("Price ($)", 300000);
    if (price) car.AppendChild(price.ptr);

    const convertible = makeBool("Convertible", false);
    if (convertible) car.AppendChild(convertible.ptr);

    return car;
}

// The C++ sample draws two bitmaps (60x15 and 120x30) and combines them into a
// wxBitmapBundle::FromBitmaps() bundle for "StringPropertyWithBitmap".
function makeTestBitmapBundle(): wxBitmapBundle | null
{
    const bitmap1 = createWxBitmapEmpty(60, 15, 32);
    const bitmap2 = createWxBitmapEmpty(120, 30, 32);
    if (!bitmap1 || !bitmap2)
    {
        bitmap1?.Delete();
        bitmap2?.Delete();
        return null;
    }

    const dc1 = createWxMemoryDCWithBitmap(bitmap1.ptr);
    if (dc1)
    {
        dc1.SetBackground(WHITE_BRUSH);
        dc1.Clear();
        dc1.SetPen(BLACK_PEN);
        dc1.SetBrush(WHITE_BRUSH);
        dc1.DrawRectangle(0, 0, 60, 15);
        dc1.DrawLine(0, 0, 59, 14);
        dc1.SetTextForeground(BLACK);
        withString("x1", (ptr) => dc1.DrawText(ptr, 0, 0));
        dc1.Delete();
    }

    const dc2 = createWxMemoryDCWithBitmap(bitmap2.ptr);
    if (dc2)
    {
        dc2.SetBackground(WHITE_BRUSH);
        dc2.Clear();
        const pen = createWxPenFromColour(BLUE, 2, PENSTYLE_SOLID);
        if (pen) dc2.SetPen(pen.ptr);
        dc2.SetBrush(WHITE_BRUSH);
        dc2.DrawRectangle(0, 0, 120, 30);
        dc2.DrawLine(0, 0, 119, 31);
        dc2.SetTextForeground(BLUE);
        const font = createWxFontDefault();
        if (font)
        {
            dc2.GetFont(font.ptr);
            font.SetPointSize(2 * font.GetPointSize());
            dc2.SetFont(font.ptr);
            font.Delete();
        }
        withString("x2", (ptr) => dc2.DrawText(ptr, 0, 0));
        if (pen) pen.Delete();
        dc2.Delete();
    }
    bitmap2.SetScaleFactor(2);

    const vector = createWxBitmapVector();
    if (!vector)
    {
        bitmap1.Delete();
        bitmap2.Delete();
        return null;
    }
    vector.Add(bitmap1.ptr);
    vector.Add(bitmap2.ptr);
    const raw = wxBitmapBundle_FromBitmaps(vector.ptr);
    vector.Delete();
    bitmap1.Delete();
    bitmap2.Delete();
    return raw ? new wxBitmapBundle(raw) : null;
}

export function populateExamples(
    page: wxPropertyGridPage, multiButtonEditor: Pointer | null,
): void
{
    // IntProperty was appended by populateGrid() before this function runs.

    const spin = append(page, makeInt("SpinCtrl", 0));
    attrLong(spin, "Min", -2);
    attrLong(spin, "Max", 16384);
    attrLong(spin, "Step", 2);
    attrBool(spin, "MotionSpin", true);
    if (spin)
    {
        withString("SpinCtrl", (ptr) => page.SetPropertyEditorByName(spin.ptr, ptr));
    }
    setHelp(page, spin,
        "This is regular wxIntProperty, which editor has been "
        + "changed to wxPGEditor_SpinCtrl. Note however that "
        + "static wxPropertyGrid::RegisterAdditionalEditors() "
        + "needs to be called prior to using it.");

    append(page, makeBool("BoolProperty", false));

    const boolCheckBox = append(page, makeBool("BoolProperty with CheckBox", false));
    attrBool(boolCheckBox, "UseCheckbox", true);
    setHelp(page, boolCheckBox,
        "Property attribute wxPG_BOOL_USE_CHECKBOX has been set to true.");

    const floatProp = append(page, makeFloat("FloatProperty", 1234500.23));
    attrDouble(floatProp, "Min", -100.12);

    const longString = append(page, makeLongString("LongStringProperty",
        "This is much longer string than the first one. Edit it by clicking the button."));
    if (longString) withString("LongStringProp", (ptr) => longString.SetName(ptr));

    append(page, makeArrayString("ArrayStringProperty",
        ["String 1", "String 2", "String 3"]));

    const fileProp = append(page, makeFile("FileProperty", ""));
    attrString(fileProp, "Wildcard", "Text Files (*.txt)|*.txt");
    attrString(fileProp, "DialogTitle", "Custom File Dialog Title");
    attrBool(fileProp, "ShowFullPath", false);
    // The sample's name is "TextFile"; set it explicitly.
    if (fileProp) withString("TextFile", (ptr) => fileProp.SetName(ptr));
    if (fileProp)
    {
        attrString(fileProp, "ShowRelativePath", "C:\\Windows");
        setValueString(page, fileProp, "C:\\Windows\\System32\\msvcrt71.dll");
    }

    append(page, makeImageFile("ImageFile"));

    const colour = append(page, makeColour("ColourProperty", RED));
    if (colour)
    {
        colour.SetAutoUnspecified(true);
        withString("ComboBox", (ptr) => page.SetPropertyEditorByName(colour.ptr, ptr));
    }
    setHelp(page, colour,
        "wxPropertyGrid::SetPropertyEditor method has been used to change "
        + "editor of this property to wxPGEditor_ComboBox)");

    const alpha = createWxColourRGB(15, 200, 95, 128);
    append(page, alpha ? makeColour("ColourPropertyWithAlpha", alpha.ptr) : null);
    if (alpha) alpha.Delete();
    attrBool(findPropertyByName(page, "ColourPropertyWithAlpha"), "HasAlpha", true);
    setHelp(page, findPropertyByName(page, "ColourPropertyWithAlpha"),
        "Attribute \"HasAlpha\" is set to true for this property.");

    append(page, makeColour("ColourProperty2", GREEN));

    append(page, makeEnum("EnumProperty", ENUM_LABELS, ENUM_VALUES, 80));

    const enum2 = append(page, makeEnum("EnumProperty 2", SOC_LABELS, SOC_VALUES, 240));
    if (enum2) withString("Testing Extra", (ptr) => enum2.AddChoice(ptr, 360));

    const enum3 = append(page, makeEnum("EnumProperty 3", SOC_LABELS, SOC_VALUES, 240));
    attrString(enum3, "Hint", "Dummy Hint");
    setHelp(page, enum3, "This property uses \"Hint\" attribute.");

    const enum4 = append(page, makeEnum("EnumProperty 4", SOC_LABELS, SOC_VALUES, 240));
    if (enum4) withString("4th only", (ptr) => enum4.AddChoice(ptr, 360));
    setHelp(page, enum4, "Should have one extra item when compared to EnumProperty 3");

    const enum5 = append(page, makeEnum("EnumProperty With Bitmap", SOC_LABELS, SOC_VALUES,
        280, "EnumProperty 5"));
    setHelp(page, enum5, "Should have bitmap in front of the displayed value");
    const removable = wxArtProvider_GetBitmapBundle(ART_REMOVABLE, ART_OTHER, -1, -1);
    if (enum5 && removable) page.SetPropertyImage(enum5.ptr, removable.ptr);
    if (removable) removable.Delete();

    const password = append(page, makeString("Password", "password"));
    attrBool(password, "Password", true);
    setHelp(page, password, "Has attribute wxPG_STRING_PASSWORD set to true");

    const dir = append(page, makeDir("DirProperty", userHome()));
    attrString(dir, "DialogTitle", "This is a custom dir dialog title");

    const stringProp = append(page, makeString("StringProperty", ""));
    if (stringProp)
    {
        page.SetPropertyMaxLength(stringProp.ptr, 6);
        setValueString(page, stringProp, "some text");
    }
    setHelp(page, stringProp,
        "Max length of this text has been limited to 6, using wxPropertyGrid::SetPropertyMaxLength.");

    const autoComplete = append(page, makeString("StringProperty AutoComplete", ""));
    attrArrayString(autoComplete, "AutoComplete", [
        "One choice",
        "Another choice",
        "Another choice, yeah",
        "Yet another choice",
        "Yet another choice, bear with me",
    ]);
    setHelp(page, autoComplete,
        "AutoComplete attribute has been set for this property "
        + "(try writing something beginning with 'a', 'o' or 'y').");

    const wideProp = append(page, makeString("StringPropertyWithBitmap", "Test Text"));
    const wideBundle = makeTestBitmapBundle();
    if (wideProp && wideBundle) page.SetPropertyImage(wideProp.ptr, wideBundle.ptr);
    if (wideBundle) wideBundle.Delete();

    const flagsProp = append(page, makeFlags("FlagsProperty",
        ["Bit 0", "Bit 1", "Bit 2", "Bit 3"], [0x01, 0x02, 0x04, 0x08], 0x03));
    attrBool(flagsProp, "UseCheckbox", true);

    const tchoices = ["Cabbage", "Carrot", "Onion", "Potato", "Strawberry"];
    append(page, makeEnum("EnumProperty X", tchoices,
        tchoices.map((_, index) => index), 0));

    const multi = append(page, makeMultiChoice("MultiChoiceProperty", tchoices));
    if (multi)
    {
        const selection = variantArrayString(["Carrot", "Potato"]);
        if (selection)
        {
            page.SetPropertyValue(multi.ptr, selection.ptr);
            selection.Delete();
        }
        attrLong(multi, "UserStringMode", 1);
    }

    // wxSizeProperty / wxPointProperty are C++-only classes.  The closest
    // bound equivalent is a composed wxStringProperty with int children.
    const sizeProp = makeStringNamed("SizeProperty", "Size", "<composed>");
    if (sizeProp)
    {
        const w = makeInt("Width", 0);
        const h = makeInt("Height", 0);
        if (w) sizeProp.AppendChild(w.ptr);
        if (h) sizeProp.AppendChild(h.ptr);
        append(page, sizeProp);
    }

    const pointProp = makeStringNamed("PointProperty", "Position", "<composed>");
    if (pointProp)
    {
        const px = makeInt("X", 0);
        const py = makeInt("Y", 0);
        if (px) pointProp.AppendChild(px.ptr);
        if (py) pointProp.AppendChild(py.ptr);
        append(page, pointProp);
    }

    const uint = append(page, makeUInt("UIntProperty", 0xFEEEFEEEFEEEn));
    attrLong(uint, "Prefix", PG_PREFIX_NONE);
    attrLong(uint, "Base", PG_BASE_HEX);

    const editEnum = append(page, makeEditEnum("EditEnumProperty",
        ["Choice 1", "Choice 2", "Choice 3"], [0, 1, 2], "Choice not in the list"));
    attrString(editEnum, "Hint", "Dummy Hint");

    const date = append(page, makeDate("DateProperty"));
    attrLong(date, "PickerStyle", DP_DROPDOWN | DP_SHOWCENTURY | DP_ALLOWNONE);
    setHelp(page, date,
        "Attribute wxPG_DATE_PICKER_STYLE has been set to (long)"
        + "(wxDP_DROPDOWN | wxDP_SHOWCENTURY | wxDP_ALLOWNONE).");

    // --- 3D Object ---------------------------------------------------------
    const top = makeString("3D Object", "<composed>");
    if (top)
    {
        const triangle1 = makeStringNamed("Triangle 1", "Triangle 1", "<composed>");
        if (triangle1)
        {
            for (const label of ["A", "B", "C"])
            {
                const child = makeVectorProperty(label);
                if (child) triangle1.AppendChild(child.ptr);
            }
            top.AppendChild(triangle1.ptr);
        }

        const triangle2 = makeTriangleProperty("Triangle 2");
        if (triangle2) top.AppendChild(triangle2.ptr);

        const triangle3 = makeStringNamed("Triangle 3", "Triangle 3", "<composed>");
        if (triangle3)
        {
            for (const label of ["A", "B", "C"])
            {
                const child = makeVectorProperty(label);
                if (child) triangle3.AppendChild(child.ptr);
            }
            top.AppendChild(triangle3.ptr);
        }

        const triangle4 = makeTriangleProperty("Triangle 4");
        if (triangle4) top.AppendChild(triangle4.ptr);

        append(page, top);
    }
    setHelp(page, findPropertyByName(page, "3D Object"),
        "3D Object is wxStringProperty with value \"<composed>\". Two of its children are similar wxStringProperties with "
        + "three wxVectorProperty children, and other two are custom wxTriangleProperties.");

    // --- Car ---------------------------------------------------------------
    const car = buildCar();
    if (car)
    {
        append(page, car);
        // This is how a child property is referred to by name.
        const maxSpeed = findPropertyByName(page, "Max. Speed (mph)");
        if (maxSpeed) setValueLong(page, maxSpeed, 300);
    }

    const multiple = append(page, makeLongString("MultipleButtons", ""));
    if (multiple && multiButtonEditor)
        page.SetPropertyEditor(multiple.ptr, multiButtonEditor);

    append(page, makeEnum("SingleChoiceProperty",
        ["Cat", "Dog", "Gibbon", "Otter"], [0, 1, 2, 3], 0));

    append(page, makeEnum("Variable Height Bitmaps",
        ["Wee", "Not so wee", "Friggin' huge"], [0, 1, 2], 0));

    // --- wxWidgets Traits --------------------------------------------------
    const traits = makeString("wxWidgets Traits", "<composed>");
    if (traits)
    {
        const release = makeString("Latest Release", "3.1.2");
        if (release) traits.AppendChild(release.ptr);

        const winApi = makeBool("Win API", true);
        if (winApi) traits.AppendChild(winApi.ptr);

        const qt = makeBool("QT", true);
        if (qt) traits.AppendChild(qt.ptr);

        const cocoa = makeBool("Cocoa", true);
        if (cocoa) traits.AppendChild(cocoa.ptr);

        const haiku = makeBool("Haiku", false);
        if (haiku) traits.AppendChild(haiku.ptr);

        const trunk = makeStringValueOnly("Trunk Version", VERSION_NUM_DOT_STRING);
        if (trunk) traits.AppendChild(trunk.ptr);

        const gtk = makeBool("GTK+", true);
        if (gtk) traits.AppendChild(gtk.ptr);

        const android = makeBool("Android", false);
        if (android) traits.AppendChild(android.ptr);

        append(page, traits);
        // The C++ sample calls SetPropertyReadOnly() before adding the children,
        // so only the parent ends up read-only.
        page.SetPropertyReadOnly(traits.ptr, true, PG_DONT_RECURSE);
    }

    // AddTestProperties(): MyColourProperty is a C++ subclass of
    // wxColourProperty, so a plain wxColourProperty is used instead.
    const customColour = append(page, makeColour("CustomColourProperty", GREEN));
    if (customColour)
    {
        customColour.SetAutoUnspecified(true);
        withString("ComboBox", (ptr) =>
            page.SetPropertyEditorByName(customColour.ptr, ptr));
    }
    setHelp(page, customColour,
        "This is a MyColourProperty from the sample app. "
        + "It is built by subclassing wxColourProperty.");
}
