/** MyFrame::OnAbout() */
function onAbout(state: FrameState): void
{
    messageBox(
        "wxAUI Demo\nAn advanced window management library for wxWidgets" +
        "\n(c) Copyright 2005-2006, Kirix Corporation",
        "About wxAUI Demo", OK, state.frame.ptr,
    );
}

//---------------------------------------------------------------------------
// Event connections (wxBEGIN_EVENT_TABLE ... wxEND_EVENT_TABLE)
//---------------------------------------------------------------------------

const MENU_IDS = [
    ID_CreateTree, ID_CreateGrid, ID_CreateText, ID_CreateHTML,
    ID_CreateSizeReport, ID_CreateNotebook,
    ID_CreatePerspective, ID_CopyLayout, ID_PasteLayout,
    ID_EditNotebookLayout,
    ID_AllowFloating, ID_TransparentHint, ID_VenetianBlindsHint,
    ID_RectangleHint, ID_NoHint, ID_HintFade, ID_TransparentDrag,
    ID_LiveUpdate, ID_AllowActivePane,
    ID_NotebookTabFixedWidth, ID_NotebookTabPin, ID_NotebookTabUnpin,
    ID_NotebookMultiLine, ID_NotebookNoCloseButton, ID_NotebookCloseButton,
    ID_NotebookCloseButtonAll, ID_NotebookCloseButtonActive,
    ID_NotebookAllowTabMove, ID_NotebookAllowTabExternalMove,
    ID_NotebookAllowTabSplit, ID_NotebookScrollButtons, ID_NotebookWindowList,
    ID_NotebookArtDefault, ID_NotebookArtFlat,
    ...(HAS_NATIVE_TABART ? [ID_NotebookArtNative] : []),
    ID_NotebookArtGloss, ID_NotebookArtSimple,
    ID_NotebookNextTab, ID_NotebookPrevTab,
    ID_NotebookAlignTop, ID_NotebookAlignBottom,
    ID_NotebookSplit, ID_NotebookUnsplit, ID_NotebookNewTab,
    ID_NotebookDeleteTab,
    ID_NotebookNormalTab, ID_NotebookPinTab, ID_NotebookLockTab,
    ID_NoGradient, ID_VerticalGradient, ID_HorizontalGradient,
    ID_AllowToolbarResizing,
    ID_ShowTextForMinPanes, ID_ShowIconsForMinPanes, ID_ShowBothForMinPanes,
    ID_RotateMinPanesIcons,
    ID_Settings, ID_CustomizeToolbar,
    ID_GridContent, ID_TreeContent, ID_TextContent, ID_SizeReportContent,
    ID_HTMLContent, ID_NotebookContent,
    ID_EXIT, ID_ABOUT,
];

const UPDATE_UI_IDS = [
    ID_NotebookTabFixedWidth, ID_NotebookTabPin, ID_NotebookTabUnpin,
    ID_NotebookMultiLine, ID_NotebookNoCloseButton, ID_NotebookCloseButton,
    ID_NotebookCloseButtonAll, ID_NotebookCloseButtonActive,
    ID_NotebookAllowTabMove, ID_NotebookAllowTabExternalMove,
    ID_NotebookAllowTabSplit, ID_NotebookScrollButtons, ID_NotebookWindowList,
    ID_AllowFloating, ID_TransparentHint, ID_VenetianBlindsHint,
    ID_RectangleHint, ID_NoHint, ID_HintFade, ID_TransparentDrag,
    ID_LiveUpdate, ID_NoGradient, ID_VerticalGradient, ID_HorizontalGradient,
    ID_AllowToolbarResizing,
    ID_NotebookArtDefault, ID_NotebookArtFlat,
    ...(HAS_NATIVE_TABART ? [ID_NotebookArtNative] : []),
    ID_NotebookArtGloss, ID_NotebookArtSimple,
];

function onMenuCommand(state: FrameState, id: number): void
{
    switch (id)
    {
        case ID_CreateTree:
            onCreateTree(state);
            break;
        case ID_CreateGrid:
            onCreateGrid(state);
            break;
        case ID_CreateText:
            onCreateText(state);
            break;
        case ID_CreateHTML:
            onCreateHTML(state);
            break;
        case ID_CreateSizeReport:
            onCreateSizeReport(state);
            break;
        case ID_CreateNotebook:
            onCreateNotebook(state);
            break;
        case ID_CreatePerspective:
            onCreatePerspective(state);
            break;
        case ID_CopyLayout:
            onCopyLayout(state);
            break;
        case ID_PasteLayout:
            onPasteLayout(state);
            break;
        case ID_EditNotebookLayout:
            onEditNotebookLayout(state);
            break;

        case ID_AllowFloating:
        case ID_TransparentHint:
        case ID_VenetianBlindsHint:
        case ID_RectangleHint:
        case ID_NoHint:
        case ID_HintFade:
        case ID_TransparentDrag:
        case ID_LiveUpdate:
        case ID_AllowActivePane:
            onManagerFlag(state, id);
            break;

        case ID_NotebookTabFixedWidth:
        case ID_NotebookTabPin:
        case ID_NotebookTabUnpin:
        case ID_NotebookMultiLine:
        case ID_NotebookNoCloseButton:
        case ID_NotebookCloseButton:
        case ID_NotebookCloseButtonAll:
        case ID_NotebookCloseButtonActive:
        case ID_NotebookAllowTabMove:
        case ID_NotebookAllowTabExternalMove:
        case ID_NotebookAllowTabSplit:
        case ID_NotebookScrollButtons:
        case ID_NotebookWindowList:
        case ID_NotebookArtDefault:
        case ID_NotebookArtFlat:
        case ID_NotebookArtNative:
        case ID_NotebookArtGloss:
        case ID_NotebookArtSimple:
            onNotebookFlag(state, id);
            break;

        case ID_NotebookNextTab:
        case ID_NotebookPrevTab:
            onNotebookNextOrPrev(state, id);
            break;

        case ID_NotebookAlignTop:
        case ID_NotebookAlignBottom:
            onTabAlignment(state, id);
            break;

        case ID_NotebookSplit:
            onNotebookSplit(state);
            break;
        case ID_NotebookUnsplit:
            onNotebookUnsplit(state);
            break;
        case ID_NotebookNewTab:
            onNotebookNewTab(state);
            break;
        case ID_NotebookDeleteTab:
            onNotebookDeleteTab(state);
            break;

        case ID_NotebookNormalTab:
        case ID_NotebookPinTab:
        case ID_NotebookLockTab:
            onNotebookSetTabKind(state, id);
            break;

        case ID_NoGradient:
        case ID_VerticalGradient:
        case ID_HorizontalGradient:
            onGradient(state, id);
            break;

        case ID_AllowToolbarResizing:
            onToolbarResizing(state);
            break;

        case ID_ShowTextForMinPanes:
        case ID_ShowIconsForMinPanes:
        case ID_ShowBothForMinPanes:
        case ID_RotateMinPanesIcons:
            onMinPanesStyle(state);
            break;

        case ID_Settings:
            onSettings(state);
            break;

        case ID_CustomizeToolbar:
            onCustomizeToolbar(state);
            break;

        case ID_GridContent:
        case ID_TreeContent:
        case ID_TextContent:
        case ID_SizeReportContent:
        case ID_HTMLContent:
        case ID_NotebookContent:
            onChangeContentPane(state, id);
            break;

        case ID_EXIT:
            state.frame.Close(true);
            break;

        case ID_ABOUT:
            onAbout(state);
            break;

        default:
            if (id >= ID_FirstPerspective &&
                id <= ID_FirstPerspective + 1000)
            {
                onRestorePerspective(state, id);
            }
            break;
    }
}

function connectEvents(state: FrameState): void
{
    // shared closures for the size reporters (created before any are needed)
    const reportPaintCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            paintSizeReport(state, eventPtr);
        },
    );
    state.callbacks.push(reportPaintCallback);

    const reportSizeCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            const event = new wxEvent(eventPtr);
            const windowPtr = event.GetEventObject();
            if (windowPtr)
            {
                wrapWxWindow(windowPtr).Refresh(true);
            }
        },
    );
    state.callbacks.push(reportSizeCallback);

    const reportEraseCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, _eventPtr) =>
        {
            // intentionally empty
        },
    );
    state.callbacks.push(reportEraseCallback);

    const paintClosure = createWxClosure(reportPaintCallback.pointer, null);
    const sizeClosure = createWxClosure(reportSizeCallback.pointer, null);
    const eraseClosure = createWxClosure(reportEraseCallback.pointer, null);
    if (paintClosure && sizeClosure && eraseClosure)
    {
        state.closures.push(paintClosure, sizeClosure, eraseClosure);
        state.sizeReportPaint = paintClosure;
        state.sizeReportSize = sizeClosure;
        state.sizeReportErase = eraseClosure;
    }

    for (const window of state.pendingSizeReports)
    {
        registerSizeReportEvents(state, window);
    }
    state.pendingSizeReports.length = 0;

    // EVT_MENU / EVT_MENU_RANGE
    const menuCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            const event = new wxCommandEvent(eventPtr);
            onMenuCommand(state, event.GetId());
        },
    );
    state.callbacks.push(menuCallback);

    const menuClosure = createWxClosure(menuCallback.pointer, null);
    if (menuClosure)
    {
        state.closures.push(menuClosure);
        for (const id of MENU_IDS)
        {
            lib.symbols.wxEvtHandler_Connect(
                state.frame.ptr, id, id, EVT_MENU, menuClosure.ptr);
        }
        lib.symbols.wxEvtHandler_Connect(
            state.frame.ptr, ID_FirstPerspective, ID_FirstPerspective + 1000,
            EVT_MENU, menuClosure.ptr);
    }

    // EVT_UPDATE_UI
    const updateUICallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            onUpdateUI(state, new wxUpdateUIEvent(eventPtr));
        },
    );
    state.callbacks.push(updateUICallback);

    const updateUIClosure = createWxClosure(updateUICallback.pointer, null);
    if (updateUIClosure)
    {
        state.closures.push(updateUIClosure);
        for (const id of UPDATE_UI_IDS)
        {
            lib.symbols.wxEvtHandler_Connect(
                state.frame.ptr, id, id, EVT_UPDATE_UI, updateUIClosure.ptr);
        }
    }

    // EVT_UPDATE_UI(ID_NotebookNormalTab..ID_NotebookLockTab) -> OnUpdateTabKindUI
    const tabKindCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            onUpdateTabKindUI(state, new wxUpdateUIEvent(eventPtr));
        },
    );
    state.callbacks.push(tabKindCallback);

    const tabKindClosure = createWxClosure(tabKindCallback.pointer, null);
    if (tabKindClosure)
    {
        state.closures.push(tabKindClosure);
        for (const id of [ID_NotebookNormalTab, ID_NotebookPinTab, ID_NotebookLockTab])
        {
            lib.symbols.wxEvtHandler_Connect(
                state.frame.ptr, id, id, EVT_UPDATE_UI, tabKindClosure.ptr);
        }
    }

    // EVT_UPDATE_UI(ID_RotateMinPanesIcons) -> OnUpdateUIRotateMinPanes
    const rotateCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            const event = new wxUpdateUIEvent(eventPtr);
            const menuBar = wrapWxMenuBar(state.menuBar.ptr);
            // Rotating icons doesn't make sense if only text is shown.
            event.Enable(!menuBar.IsChecked(ID_ShowTextForMinPanes));
        },
    );
    state.callbacks.push(rotateCallback);

    const rotateClosure = createWxClosure(rotateCallback.pointer, null);
    if (rotateClosure)
    {
        state.closures.push(rotateClosure);
        lib.symbols.wxEvtHandler_Connect(
            state.frame.ptr, ID_RotateMinPanesIcons, ID_RotateMinPanesIcons,
            EVT_UPDATE_UI, rotateClosure.ptr);
    }

    // EVT_ERASE_BACKGROUND / EVT_SIZE on the frame: both just Skip()
    const eraseCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            new wxEvent(eventPtr).Skip(true);
        },
    );
    state.callbacks.push(eraseCallback);

    const sizeCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            new wxEvent(eventPtr).Skip(true);
        },
    );
    state.callbacks.push(sizeCallback);

    const frameEraseClosure = createWxClosure(eraseCallback.pointer, null);
    const frameSizeClosure = createWxClosure(sizeCallback.pointer, null);
    if (frameEraseClosure && frameSizeClosure)
    {
        state.closures.push(frameEraseClosure, frameSizeClosure);
        lib.symbols.wxEvtHandler_Connect(
            state.frame.ptr, ID_ANY, ID_ANY, EVT_ERASE_BACKGROUND,
            frameEraseClosure.ptr);
        lib.symbols.wxEvtHandler_Connect(
            state.frame.ptr, ID_ANY, ID_ANY, EVT_SIZE, frameSizeClosure.ptr);
    }

    // EVT_AUI_PANE_CLOSE
    const paneCloseCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            onPaneClose(state, new wxAuiManagerEvent(eventPtr));
        },
    );
    state.callbacks.push(paneCloseCallback);

    const paneCloseClosure = createWxClosure(paneCloseCallback.pointer, null);
    if (paneCloseClosure)
    {
        state.closures.push(paneCloseClosure);
        lib.symbols.wxEvtHandler_Connect(
            state.frame.ptr, ID_ANY, ID_ANY, EVT_AUI_PANE_CLOSE,
            paneCloseClosure.ptr);
    }

    // EVT_AUITOOLBAR_TOOL_DROPDOWN(ID_DropDownToolbarItem)
    const dropdownCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            onDropDownToolbarItem(state, new wxAuiToolBarEvent(eventPtr));
        },
    );
    state.callbacks.push(dropdownCallback);

    const dropdownClosure = createWxClosure(dropdownCallback.pointer, null);
    if (dropdownClosure)
    {
        state.closures.push(dropdownClosure);
        lib.symbols.wxEvtHandler_Connect(
            state.frame.ptr, ID_DropDownToolbarItem, ID_DropDownToolbarItem,
            EVT_AUITOOLBAR_TOOL_DROPDOWN, dropdownClosure.ptr);
    }

    // EVT_AUINOTEBOOK_* handlers (all with wxID_ANY)
    const allowDndCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            // for the purpose of this test application, explicitly
            // allow all notebook drag and drop events
            new wxAuiNotebookEvent(eventPtr).Allow();
        },
    );
    state.callbacks.push(allowDndCallback);

    const pageCloseCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            onNotebookPageClose(state, new wxAuiNotebookEvent(eventPtr));
        },
    );
    state.callbacks.push(pageCloseCallback);

    const pageClosedCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            onNotebookPageClosed(state, new wxAuiNotebookEvent(eventPtr));
        },
    );
    state.callbacks.push(pageClosedCallback);

    const pageChangingCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            onNotebookPageChanging(state, new wxAuiNotebookEvent(eventPtr));
        },
    );
    state.callbacks.push(pageChangingCallback);

    const tabRightCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            onNotebookTabRightClick(state, new wxAuiNotebookEvent(eventPtr));
        },
    );
    state.callbacks.push(tabRightCallback);

    const bgDClickCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            onNotebookTabBackgroundDClick(state, new wxAuiNotebookEvent(eventPtr));
        },
    );
    state.callbacks.push(bgDClickCallback);

    const notebookConnections: Array<[Callback, number]> = [
        [allowDndCallback, EVT_AUINOTEBOOK_ALLOW_DND],
        [pageCloseCallback, EVT_AUINOTEBOOK_PAGE_CLOSE],
        [pageClosedCallback, EVT_AUINOTEBOOK_PAGE_CLOSED],
        [pageChangingCallback, EVT_AUINOTEBOOK_PAGE_CHANGING],
        [tabRightCallback, EVT_AUINOTEBOOK_TAB_RIGHT_DOWN],
        [bgDClickCallback, EVT_AUINOTEBOOK_BG_DCLICK],
    ];

    for (const entry of notebookConnections)
    {
        const closure = createWxClosure(entry[0].pointer, null);
        if (closure)
        {
            state.closures.push(closure);
            lib.symbols.wxEvtHandler_Connect(
                state.frame.ptr, ID_ANY, ID_ANY, entry[1], closure.ptr);
        }
    }

    // EVT_CLOSE_WINDOW: end the event loop instead of destroying the frame
    const closeCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, _eventPtr) =>
        {
            exitMainLoop();
        },
    );
    state.callbacks.push(closeCallback);

    const closeClosure = createWxClosure(closeCallback.pointer, null);
    if (closeClosure)
    {
        state.closures.push(closeClosure);
        lib.symbols.wxEvtHandler_Connect(
            state.frame.ptr, ID_ANY, ID_ANY, EVT_CLOSE_WINDOW, closeClosure.ptr);
    }
}

//---------------------------------------------------------------------------
// Asset path
//---------------------------------------------------------------------------

declare const __dirname: string;

function samplePath(name: string): string
{
    return __dirname.replace(/\\/g, "/") + "/" + name;
}

//---------------------------------------------------------------------------
// wxApp::OnInit / wxIMPLEMENT_APP
//---------------------------------------------------------------------------

export function main(): number
{
    if (!initialize())
    {
        console.error("Failed to initialize wxWidgets");
        return 1;
    }

    setAppName("aui");

    // The C++ sample uses the compiled-in sample_xpm icon; this port loads the
    // same artwork from disk, so the XPM handler must be registered first.
    initAllImageHandlers();

    const state = createAuiFrame();
    if (!state)
    {
        console.error("aui: failed to create the main frame");
        shutdown();
        return 1;
    }

    connectEvents(state);

    state.frame.Show();
    setTopWindow(state.frame.ptr);

    const exitCode = run();

    for (const callback of state.callbacks)
    {
        callback.close();
    }

    shutdown();
    return exitCode;
}

exit(main());
