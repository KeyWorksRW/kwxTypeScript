// toggle.kwxts — port of wxSamples/src/widgets/toggle.cpp
//
// Known binding gaps (see the final report):
//  * wxAnyButton owns SetBitmap()/SetBitmapPressed()/SetBitmapFocus()/
//    SetBitmapCurrent()/SetBitmapDisabled(); wxToggleButton does not redeclare
//    them, so they are reached through wrapWxAnyButton() (a valid upcast of a
//    wxToggleButton, which derives from wxAnyButton).
//  * wxART_* icons are replaced by wxArtProvider_GetBitmap() because only the
//    bitmap setters are bound.

import {
    ALIGN_CENTRE,
    ALIGN_CENTRE_HORIZONTAL,
    ALL,
    ART_BUTTON,
    ART_ERROR,
    ART_HELP,
    ART_INFORMATION,
    ART_MISSING_IMAGE,
    ART_OTHER,
    ART_WARNING,
    BLACK,
    BU_BOTTOM,
    BU_LEFT,
    BU_RIGHT,
    BU_TOP,
    CENTRE,
    createWxBitmapEmpty,
    createWxBitmapToggleButton,
    createWxBoxSizer,
    createWxButton,
    createWxFontDefault,
    createWxMemoryDC,
    createWxRadioBox,
    createWxToggleButton,
    CYAN_BRUSH,
    EVT_BUTTON,
    EVT_CHECKBOX,
    EVT_RADIOBOX,
    EVT_TOGGLEBUTTON,
    EXPAND,
    HORIZONTAL,
    ID_ANY,
    ID_HIGHEST,
    LEFT,
    TOP,
    BOTTOM,
    readAndDeleteWxString,
    RIGHT,
    Strip_Mnemonics,
    VERTICAL,
    wxArtProvider_GetBitmap,
    wxBitmap,
    wxCheckBox,
    wxCommandEvent,
    wxRadioBox,
    wxSizer,
    wxTextCtrl,
    wxToggleButton,
    wxWindow,
    wrapWxAnyButton,
    wxStripMenuCodes,
} from "kwx";
import { Pointer, pointerOf } from "kwx/platform";

import {
    addSizer,
    addSpacer,
    addStretchSpacer,
    addWin,
    attrs,
    bindEvent,
    border,
    doubleBorder,
    logMessage,
    makeStaticBoxSizer,
    tripleBorder,
    WidgetsPage,
    withString,
} from "./common.kwxts";

const TOGGLE_RESET = ID_HIGHEST;
const TOGGLE_CHANGE_LABEL = TOGGLE_RESET + 1;
const TOGGLE_PICKER = TOGGLE_CHANGE_LABEL + 1;

// ToggleImagePos_* / ToggleHAlign_* / ToggleVAlign_* (indices into the radios).
const TOGGLE_IMAGE_POS_LEFT = 0;
const TOGGLE_HALIGN_LEFT = 0;
const TOGGLE_HALIGN_CENTRE = 1;
const TOGGLE_HALIGN_RIGHT = 2;
const TOGGLE_VALIGN_TOP = 0;
const TOGGLE_VALIGN_CENTRE = 1;
const TOGGLE_VALIGN_BOTTOM = 2;

/**
 * Builds the `char**` array expected by wxRadioBox_Create.  The returned
 * buffers must stay reachable until the native call returns.
 */
function makeRadioBox(
    parent: Pointer,
    caption: string,
    items: string[],
    dimension: number,
): wxRadioBox
{
    const buffers: Uint8Array[] = [];
    const pointers = new BigUint64Array(items.length);

    for (let index = 0; index < items.length; index++)
    {
        const bytes = new TextEncoder().encode(items[index] + "\0");
        buffers.push(bytes);
        const address = pointerOf(bytes);
        pointers[index] = address === null ? 0n : address;
    }

    const choices = pointerOf(pointers);

    const box = withString(caption, (ptr) =>
        createWxRadioBox(
            parent, ID_ANY, ptr, -1, -1, -1, -1,
            items.length, choices, dimension, 0,
        ));

    // Keep the string buffers alive until the constructor has copied them.
    void buffers;
    return box!;
}

interface ToggleControls
{
    chkFit: wxCheckBox;
    chkDisable: wxCheckBox;
    chkUseMarkup: wxCheckBox;
    chkBitmapOnly: wxCheckBox;
    chkTextAndBitmap: wxCheckBox;
    chkUseBitmapClass: wxCheckBox;
    chkUsePressed: wxCheckBox;
    chkUseFocused: wxCheckBox;
    chkUseCurrent: wxCheckBox;
    chkUseDisabled: wxCheckBox;
    radioImagePos: wxRadioBox;
    radioHAlign: wxRadioBox;
    radioVAlign: wxRadioBox;
    sizerToggle: wxSizer;
    textLabel: wxTextCtrl;
}

export class TogglePage extends WidgetsPage
{
    private controls: ToggleControls | null = null;
    private toggle: wxToggleButton | null = null;

    /** Bitmaps handed to the native button; released on the next recreation. */
    private bitmaps: wxBitmap[] = [];

    constructor(parent: Pointer)
    {
        super(parent, "icons/toggle");
    }

    override getWidget(): wxWindow | null
    {
        return this.toggle;
    }

    override createContent(): void
    {
        const sizerTop = createWxBoxSizer(HORIZONTAL)!;

        // left pane
        const sizerLeft = makeStaticBoxSizer(this.page.ptr, VERTICAL, "Styles");

        const chkBitmapOnly = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "&Bitmap only", ID_ANY, sizerLeft.box.ptr);
        const chkTextAndBitmap = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Text &and bitmap", ID_ANY, sizerLeft.box.ptr);
        const chkUseMarkup = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Interpret &markup", ID_ANY, sizerLeft.box.ptr);
        const chkFit = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "&Fit exactly", ID_ANY, sizerLeft.box.ptr);
        const chkDisable = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Disable", ID_ANY, sizerLeft.box.ptr);
        const chkUseBitmapClass = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Use wxBitmapToggleButton", ID_ANY, sizerLeft.box.ptr);
        chkUseBitmapClass.SetValue(true);

        addSpacer(sizerLeft.sizer, this.dip(5));

        const sizerUseLabels = makeStaticBoxSizer(
            sizerLeft.box.ptr, VERTICAL,
            "&Use the following bitmaps in addition to the normal one?");

        const chkUsePressed = this.createCheckBoxAndAddToSizer(
            sizerUseLabels.sizer, "&Pressed (small help icon)", ID_ANY,
            sizerUseLabels.box.ptr);
        const chkUseFocused = this.createCheckBoxAndAddToSizer(
            sizerUseLabels.sizer, "&Focused (small error icon)", ID_ANY,
            sizerUseLabels.box.ptr);
        const chkUseCurrent = this.createCheckBoxAndAddToSizer(
            sizerUseLabels.sizer, "&Current (small warning icon)", ID_ANY,
            sizerUseLabels.box.ptr);
        const chkUseDisabled = this.createCheckBoxAndAddToSizer(
            sizerUseLabels.sizer, "&Disabled (broken image icon)", ID_ANY,
            sizerUseLabels.box.ptr);

        addSizer(sizerLeft.sizer, sizerUseLabels.sizer, 0, EXPAND, border());
        addSpacer(sizerLeft.sizer, this.dip(10));

        const radioImagePos = makeRadioBox(
            sizerLeft.box.ptr, "Image &position",
            ["left", "right", "top", "bottom"], 0);
        addWin(sizerLeft.sizer, radioImagePos, 0, EXPAND, border());
        addSpacer(sizerLeft.sizer, this.dip(15));

        const radioHAlign = makeRadioBox(
            sizerLeft.box.ptr, "&Horz alignment",
            ["left", "centre", "right"], 0);
        const radioVAlign = makeRadioBox(
            sizerLeft.box.ptr, "&Vert alignment",
            ["top", "centre", "bottom"], 0);

        addWin(sizerLeft.sizer, radioHAlign, 0, EXPAND, border());
        addWin(sizerLeft.sizer, radioVAlign, 0, EXPAND, border());
        addSpacer(sizerLeft.sizer, this.dip(5));

        const resetButton = withString("&Reset", (ptr) =>
            createWxButton(sizerLeft.box.ptr, TOGGLE_RESET, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(sizerLeft.sizer, resetButton, 0, ALIGN_CENTRE_HORIZONTAL, tripleBorder());

        // middle pane
        const sizerMiddle = makeStaticBoxSizer(this.page.ptr, VERTICAL, "&Operations");

        let textLabel: wxTextCtrl | null = null;
        const sizerRow = this.createSizerWithTextAndButton(
            TOGGLE_CHANGE_LABEL, "Change label", ID_ANY,
            (text) =>
            {
                textLabel = text;
            },
            sizerMiddle.box.ptr);
        addSizer(sizerMiddle.sizer, sizerRow, 0, EXPAND, border());

        // right pane
        const sizerToggle = createWxBoxSizer(HORIZONTAL)!;
        sizerToggle.SetMinSize(this.dip(150), 0);

        const textControl = textLabel as wxTextCtrl | null;
        if (!textControl)
        {
            return;
        }
        withString("&Toggle me!", (ptr) => textControl.SetValue(ptr));

        const controls: ToggleControls = {
            chkFit,
            chkDisable,
            chkUseMarkup,
            chkBitmapOnly,
            chkTextAndBitmap,
            chkUseBitmapClass,
            chkUsePressed,
            chkUseFocused,
            chkUseCurrent,
            chkUseDisabled,
            radioImagePos,
            radioHAlign,
            radioVAlign,
            sizerToggle,
            textLabel: textControl,
        };
        this.controls = controls;

        // the three panes compose the window
        addSizer(sizerTop, sizerLeft.sizer, 0, EXPAND | (ALL & ~LEFT), doubleBorder());
        addSizer(sizerTop, sizerMiddle.sizer, 1, EXPAND | ALL, doubleBorder());
        addSizer(sizerTop, sizerToggle, 1, EXPAND | (ALL & ~RIGHT), doubleBorder());

        // do create the main control
        this.reset();
        this.createToggle();

        this.page.SetSizer(sizerTop.ptr, false);

        bindEvent(this.page, TOGGLE_RESET, TOGGLE_RESET, EVT_BUTTON, () =>
        {
            this.reset();
            this.createToggle();
        });
        bindEvent(this.page, TOGGLE_CHANGE_LABEL, TOGGLE_CHANGE_LABEL,
            EVT_BUTTON, () => this.changeLabel());
        bindEvent(this.page, ID_ANY, ID_ANY, EVT_CHECKBOX, () => this.createToggle());
        bindEvent(this.page, ID_ANY, ID_ANY, EVT_RADIOBOX, () => this.createToggle());
        bindEvent(this.page, ID_ANY, ID_ANY, EVT_TOGGLEBUTTON, (eventPtr) =>
        {
            if (!eventPtr) return;
            const event = new wxCommandEvent(eventPtr);
            const eventState = event.IsChecked() ? "on" : "off";
            const controlState = this.toggle && this.toggle.GetValue() ? "on" : "off";
            logMessage(
                `Button toggled, currently ${eventState} (event) or ${controlState} (control)`);
        });
    }

    override recreateWidget(): void
    {
        this.createToggle();
    }

    /** ToggleWidgetsPage::Reset() */
    private reset(): void
    {
        const controls = this.controls;
        if (!controls)
        {
            return;
        }

        controls.chkFit.SetValue(true);
        controls.chkDisable.SetValue(false);
        controls.chkUseMarkup.SetValue(false);

        controls.chkBitmapOnly.SetValue(false);
        controls.chkTextAndBitmap.SetValue(false);
        controls.chkUseBitmapClass.SetValue(true);

        controls.chkUsePressed.SetValue(true);
        controls.chkUseFocused.SetValue(true);
        controls.chkUseCurrent.SetValue(true);
        controls.chkUseDisabled.SetValue(true);

        controls.radioImagePos.SetSelection(TOGGLE_IMAGE_POS_LEFT);
        controls.radioHAlign.SetSelection(TOGGLE_HALIGN_CENTRE);
        controls.radioVAlign.SetSelection(TOGGLE_VALIGN_CENTRE);

        if (this.toggle)
        {
            this.toggle.SetValue(false);
        }
    }

    /** ToggleWidgetsPage::OnButtonChangeLabel() */
    private changeLabel(): void
    {
        const controls = this.controls;
        const toggle = this.toggle;
        if (!controls || !toggle)
        {
            return;
        }

        const labelText = this.textLabelValue();
        if (controls.chkUseMarkup.GetValue())
        {
            withString(labelText, (ptr) => toggle.SetLabelMarkup(ptr));
        }
        else
        {
            withString(labelText, (ptr) => toggle.SetLabel(ptr));
        }

        if (controls.chkBitmapOnly.GetValue())
        {
            this.createToggle();
        }
    }

    /** ToggleWidgetsPage::CreateToggle() */
    private createToggle(): void
    {
        const controls = this.controls;
        if (!controls)
        {
            return;
        }

        for (const previous of this.bitmaps)
        {
            previous.Delete();
        }
        this.bitmaps.length = 0;

        let label = "";
        let value = false;

        const previousToggle = this.toggle;
        if (previousToggle)
        {
            const previousLabel = previousToggle.GetLabel();
            label = previousLabel ? readAndDeleteWxString(previousLabel.ptr) : "";
            value = previousToggle.GetValue();

            const count = controls.sizerToggle.GetItemCount();
            for (let index = 0; index < count; index++)
            {
                controls.sizerToggle.Remove(0);
            }

            previousToggle.Delete();
            this.toggle = null;
        }

        if (!label)
        {
            // creating for the first time or recreating a toggle button after
            // a bitmap button
            label = this.textLabelValue();
        }

        let flags = attrs.defaultFlags;

        switch (controls.radioHAlign.GetSelection())
        {
            case TOGGLE_HALIGN_LEFT:
                flags |= BU_LEFT;
                break;

            case TOGGLE_HALIGN_RIGHT:
                flags |= BU_RIGHT;
                break;

            default:
                // centre horizontal alignment is the default (no style)
                break;
        }

        switch (controls.radioVAlign.GetSelection())
        {
            case TOGGLE_VALIGN_TOP:
                flags |= BU_TOP;
                break;

            case TOGGLE_VALIGN_BOTTOM:
                flags |= BU_BOTTOM;
                break;

            default:
                // centre vertical alignment is the default (no style)
                break;
        }

        let toggle: wxToggleButton | null = null;
        let showsBitmap = false;

        if (controls.chkBitmapOnly.GetValue())
        {
            showsBitmap = true;

            const normal = this.createBitmap("normal", ART_INFORMATION);

            if (controls.chkUseBitmapClass.GetValue())
            {
                toggle = createWxBitmapToggleButton(
                    this.page.ptr, TOGGLE_PICKER,
                    normal ? normal.ptr : null, -1, -1, -1, -1, 0);
            }
            else
            {
                toggle = withString("", (ptr) =>
                    createWxToggleButton(this.page.ptr, TOGGLE_PICKER, ptr,
                        -1, -1, -1, -1, 0));

                if (toggle && normal)
                {
                    wrapWxAnyButton(toggle.ptr).SetBitmapLabel(normal.ptr);
                }
            }

            if (toggle)
            {
                const anyButton = wrapWxAnyButton(toggle.ptr);

                if (controls.chkUsePressed.GetValue())
                {
                    const pushed = this.createBitmap("pushed", ART_HELP);
                    if (pushed)
                    {
                        anyButton.SetBitmapPressed(pushed.ptr);
                    }
                }
                if (controls.chkUseFocused.GetValue())
                {
                    const focused = this.createBitmap("focused", ART_ERROR);
                    if (focused)
                    {
                        anyButton.SetBitmapFocus(focused.ptr);
                    }
                }
                if (controls.chkUseCurrent.GetValue())
                {
                    const current = this.createBitmap("hover", ART_WARNING);
                    if (current)
                    {
                        anyButton.SetBitmapCurrent(current.ptr);
                    }
                }
                if (controls.chkUseDisabled.GetValue())
                {
                    const disabled = this.createBitmap("disabled", ART_MISSING_IMAGE);
                    if (disabled)
                    {
                        anyButton.SetBitmapDisabled(disabled.ptr);
                    }
                }
            }
        }
        else // normal button
        {
            toggle = withString(label, (ptr) =>
                createWxToggleButton(this.page.ptr, TOGGLE_PICKER, ptr,
                    -1, -1, -1, -1, flags));
        }

        if (!toggle)
        {
            return;
        }

        this.toggle = toggle;
        this.notifyWidgetRecreation(toggle);

        toggle.SetValue(value);

        if (!showsBitmap && controls.chkTextAndBitmap.GetValue())
        {
            showsBitmap = true;

            const positions = [LEFT, RIGHT, TOP, BOTTOM];
            const selection = Math.max(
                0, Math.min(positions.length - 1, controls.radioImagePos.GetSelection()));

            const anyButton = wrapWxAnyButton(toggle.ptr);
            anyButton.SetBitmap(this.artBitmap(ART_INFORMATION), positions[selection]);

            if (controls.chkUsePressed.GetValue())
            {
                anyButton.SetBitmapPressed(this.artBitmap(ART_HELP));
            }
            if (controls.chkUseFocused.GetValue())
            {
                anyButton.SetBitmapFocus(this.artBitmap(ART_ERROR));
            }
            if (controls.chkUseCurrent.GetValue())
            {
                anyButton.SetBitmapCurrent(this.artBitmap(ART_WARNING));
            }
            if (controls.chkUseDisabled.GetValue())
            {
                anyButton.SetBitmapDisabled(this.artBitmap(ART_MISSING_IMAGE));
            }
        }

        controls.chkUseBitmapClass.Enable(showsBitmap);
        controls.chkTextAndBitmap.Enable(!controls.chkBitmapOnly.GetValue());

        controls.chkUsePressed.Enable(showsBitmap);
        controls.chkUseFocused.Enable(showsBitmap);
        controls.chkUseCurrent.Enable(showsBitmap);
        controls.chkUseDisabled.Enable(showsBitmap);

        toggle.Enable(!controls.chkDisable.GetValue());

        this.addButtonToSizer(toggle);

        controls.sizerToggle.Layout();
    }

    /** ToggleWidgetsPage::AddButtonToSizer() */
    private addButtonToSizer(toggle: wxToggleButton): void
    {
        const controls = this.controls;
        if (!controls)
        {
            return;
        }

        if (controls.chkFit.GetValue())
        {
            addStretchSpacer(controls.sizerToggle);
            addWin(controls.sizerToggle, toggle, 0, CENTRE, border());
            addStretchSpacer(controls.sizerToggle);
        }
        else // take up the entire space
        {
            addWin(controls.sizerToggle, toggle, 1, EXPAND, border());
        }
    }

    /** ToggleWidgetsPage::CreateBitmap() */
    private createBitmap(label: string, artId: Pointer): wxBitmap | null
    {
        // "shouldn't hardcode but it's simpler like this"
        const bitmap = createWxBitmapEmpty(this.dip(180), this.dip(70), -1);
        if (!bitmap)
        {
            return null;
        }

        const dc = createWxMemoryDC();
        if (!dc)
        {
            bitmap.Delete();
            return null;
        }

        dc.SelectObject(bitmap.ptr);

        const font = createWxFontDefault();
        if (font)
        {
            this.page.GetFont(font.ptr);
            dc.SetFont(font.ptr);
        }

        dc.SetBackground(CYAN_BRUSH);
        dc.Clear();
        dc.SetTextForeground(BLACK);

        // wxStripMenuCodes(GetValue()) + "\n(" + label + " state)"
        const unmarked = withString(this.textLabelValue(), (ptr) =>
            readAndDeleteWxString(wxStripMenuCodes(ptr, Strip_Mnemonics)));

        const icon = wxArtProvider_GetBitmap(artId, ART_OTHER, -1, -1);
        withString(unmarked + "\n(" + label + " state)", (ptr) =>
            dc.DrawLabelBitmap(
                ptr, icon ? icon.ptr : null,
                this.dip(10), this.dip(10),
                bitmap.GetWidth() - this.dip(20), bitmap.GetHeight() - this.dip(20),
                ALIGN_CENTRE, -1));
        icon?.Delete();

        dc.Delete();
        if (font)
        {
            font.Delete();
        }

        this.bitmaps.push(bitmap);
        return bitmap;
    }

    /** wxArtProvider::GetBitmap(wxART_*, wxART_BUTTON) replacement for icons. */
    private artBitmap(artId: Pointer): Pointer
    {
        const bitmap = wxArtProvider_GetBitmap(artId, ART_BUTTON, -1, -1);
        if (!bitmap)
        {
            return null;
        }
        this.bitmaps.push(bitmap);
        return bitmap.ptr;
    }

    /** m_textLabel->GetValue() */
    private textLabelValue(): string
    {
        const textLabel = this.controls ? this.controls.textLabel : null;
        if (!textLabel)
        {
            return "";
        }
        const value = textLabel.GetValue();
        return value ? readAndDeleteWxString(value.ptr) : "";
    }
}

export function createTogglePage(parent: Pointer): WidgetsPage
{
    return new TogglePage(parent);
}
