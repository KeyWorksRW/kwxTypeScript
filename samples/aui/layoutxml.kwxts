// layoutxml.kwxts — MyXmlSerializer / MyXmlDeserializer from auidemo.cpp
//
// Ported from:
//   class MyXmlSerializer   : public wxAuiSerializer     (auidemo.cpp:1683-1851)
//   class MyXmlDeserializer : public wxAuiDeserializer   (auidemo.cpp:1853-2147)
//
// A foreign language cannot derive from wxAuiSerializer/wxAuiDeserializer, so
// the binding supplies callback-driven subclasses (kwxAuiSerializer /
// kwxAuiDeserializer, see build/_deps/kwxffi-src/include/kwx_aui_serializer.h).
// Every virtual is forwarded to a (pObject, arg1, arg2) callback, and the
// layout information structures cross the ABI as borrowed handles.  This module
// reproduces the C++ XML document construction and parsing on top of that.
//
// The document is built with wxXmlDocument/wxXmlNode exactly as the C++ sample
// does, so the produced XML (and the accepted format) is identical:
//
//   <aui-layout version="3.3.0">
//     <panes>
//       <pane name="..."> ... </pane>
//     </panes>
//     <notebooks>
//       <notebook name="...">
//         <tab> ... </tab>
//       </notebook>
//     </notebooks>
//   </aui-layout>

import {
    createKwxAuiDeserializer,
    createKwxAuiSerializer,
    createWxAuiPaneLayoutInfo,
    createWxAuiPaneLayoutInfoArray,
    createWxAuiTabLayoutInfo,
    createWxAuiTabLayoutInfoArray,
    createWxArrayInt,
    createWxString,
    createWxXmlDocument,
    createWxXmlNode,
    kwxAuiDeserializer,
    kwxAuiSerializer,
    lib,
    LogError,
    LogWarning,
    readAndDeleteWxString,
    readWxString,
    wrapWxAuiManager,
    wrapWxAuiNotebook,
    wrapWxAuiPaneInfo,
    wrapWxAuiPaneLayoutInfo,
    wrapWxAuiTabLayoutInfo,
    wrapWxArrayInt,
    wrapWxkwxAuiCallbackResult,
    wrapWxkwxAuiOrphanedPage,
    wxAuiPaneLayoutInfo,
    wxAuiTabLayoutInfo,
    wxString,
    wxXmlDocument,
    wxXmlNode,
    XML_ELEMENT_NODE,
    XML_TEXT_NODE,
} from "kwx";
import { Callback, Pointer } from "kwx/platform";

/** The format version written by the C++ sample. */
const XML_VERSION = "3.3.0";

/** wxXmlDocument::Save() default indent step. */
const XML_INDENT = 2;

//---------------------------------------------------------------------------
// Small helpers
//---------------------------------------------------------------------------

function withString<T>(text: string, fn: (ptr: Pointer) => T): T
{
    const value = createWxString(text);
    try
    {
        return fn(value.ptr);
    }
    finally
    {
        value.Delete();
    }
}

/**
 * Reads and frees a wxString returned by a getter.
 *
 * The generated wrappers mark these pointers `borrowed`, but the native
 * accessors (wxXmlNode_GetName/GetNodeContent, wxAuiPaneLayoutInfo_GetName,
 * wxXmlDocument_SaveToString, ...) each return a newly allocated wxString, so
 * the pointer must be deleted to avoid leaking it.
 */
function takeString(value: wxString | null): string
{
    if (!value)
    {
        return "";
    }
    return readAndDeleteWxString(value.ptr);
}

function logWarning(message: string): void
{
    withString(message, (ptr) => LogWarning(ptr));
}

function logError(message: string): void
{
    withString(message, (ptr) => LogError(ptr));
}

function nodeName(node: wxXmlNode): string
{
    return takeString(node.GetName());
}

function nodeContent(node: wxXmlNode): string
{
    return takeString(node.GetNodeContent());
}

/** `node->GetAttribute(name, &value)`, returning `fallback` when absent. */
function attribute(node: wxXmlNode, name: string, fallback: string): string
{
    const value = withString(name, (attributeName) =>
        withString(fallback, (defaultValue) =>
            node.GetAttributeWithDefault(attributeName, defaultValue)));

    if (!value)
    {
        return fallback;
    }
    return takeString(value);
}

/** `new wxXmlNode(wxXML_ELEMENT_NODE, name)` */
function makeElement(name: string): wxXmlNode | null
{
    return withString(name, (nodeNamePtr) =>
        withString("", (empty) =>
            createWxXmlNode(XML_ELEMENT_NODE, nodeNamePtr, empty, 0)));
}

/** `new wxXmlNode(wxXML_TEXT_NODE, {}, value)` */
function makeText(value: string): wxXmlNode | null
{
    return withString("", (empty) =>
        withString(value, (content) =>
            createWxXmlNode(XML_TEXT_NODE, empty, content, 0)));
}

/** AddChild(parent, name, value) of the C++ sample. */
function addTextChild(parent: wxXmlNode, name: string, value: string): void
{
    const node = makeElement(name);
    if (!node)
    {
        return;
    }

    const text = makeText(value);
    if (text)
    {
        node.AddChild(text.ptr);
    }
    parent.AddChild(node.ptr);
}

/** AddChild(parent, name, int): 0 is the default and is not written. */
function addIntChild(parent: wxXmlNode, name: string, value: number): void
{
    if (value === 0)
    {
        return;
    }
    addTextChild(parent, name, String(value));
}

/** AddChild(parent, name, wxRect): wxDefaultPosition/wxDefaultSize are skipped. */
function addRectChild(
    parent: wxXmlNode,
    name: string,
    x: number,
    y: number,
    width: number,
    height: number,
): void
{
    if (x === -1 && y === -1 && width === -1 && height === -1)
    {
        return;
    }
    addTextChild(parent, name, x + "," + y + " " + width + "x" + height);
}

/** Reads wxAuiPaneLayoutInfo::GetFloatingPos() and releases the allocation. */
function pointOf(
    point: { GetX(): number; GetY(): number; ptr: Pointer } | null,
): { x: number; y: number }
{
    if (!point)
    {
        return { x: -1, y: -1 };
    }

    const x = point.GetX();
    const y = point.GetY();
    lib.symbols.wxPoint_Delete(point.ptr);
    return { x, y };
}

/** Reads a size getter and releases the allocation. */
function sizeOf(
    size: { GetWidth(): number; GetHeight(): number; ptr: Pointer } | null,
): { w: number; h: number }
{
    if (!size)
    {
        return { w: -1, h: -1 };
    }

    const w = size.GetWidth();
    const h = size.GetHeight();
    lib.symbols.wxSize_Delete(size.ptr);
    return { w, h };
}

/**
 * Reads a wxArrayInt created by a native "Get..." accessor and deletes it.
 *
 * As with the string getters, the generated wrapper flags the array borrowed
 * while the native function allocates it, so the allocation is paired here with
 * wxArrayInt_Delete instead of being leaked.
 */
function takeIntArray(ptr: Pointer): number[]
{
    if (!ptr)
    {
        return [];
    }

    const array = wrapWxArrayInt(ptr);
    const values: number[] = [];
    for (let index = 0; index < array.GetCount(); ++index)
    {
        values.push(array.Item(index));
    }

    lib.symbols.wxArrayInt_Delete(ptr);
    return values;
}

/** AddPagesList(): comma-separated page indices, omitted when empty. */
function addPagesList(node: wxXmlNode, name: string, pages: number[]): void
{
    if (pages.length === 0)
    {
        return;
    }
    addTextChild(node, name, pages.join(","));
}

//---------------------------------------------------------------------------
// MyXmlSerializer
//---------------------------------------------------------------------------

interface DockLayoutSource
{
    GetDockDirection(): number;
    GetDockLayer(): number;
    GetDockRow(): number;
    GetDockPos(): number;
    GetDockProportion(): number;
    GetDockSize(): number;
}

/** AddDockLayout() of the C++ sample, shared by panes and notebook tabs. */
function addDockLayout(node: wxXmlNode, layout: DockLayoutSource): void
{
    addIntChild(node, "direction", layout.GetDockDirection());
    addIntChild(node, "layer", layout.GetDockLayer());
    addIntChild(node, "row", layout.GetDockRow());
    addIntChild(node, "position", layout.GetDockPos());
    addIntChild(node, "proportion", layout.GetDockProportion());
    addIntChild(node, "size", layout.GetDockSize());
}

export interface SerializerSession
{
    readonly serializer: kwxAuiSerializer;

    /** MyXmlSerializer::GetXML() */
    xml(): string;

    /** Releases the serializer and every callback registered for it. */
    dispose(): void;
}

/**
 * Creates a MyXmlSerializer equivalent: the serializer object plus the ten
 * virtual hooks that build the XML document.
 *
 * The hooks stay registered for the lifetime of the session; the caller runs
 * wxAuiManager::SaveLayout()/wxAuiNotebook::SaveLayout() and then calls
 * xml()/dispose().
 */
export function createSerializerSession(): SerializerSession | null
{
    const doc = createWxXmlDocument();
    if (!doc)
    {
        return null;
    }

    const serializer = createKwxAuiSerializer(null);
    if (!serializer)
    {
        doc.Delete();
        return null;
    }

    const callbacks: Callback[] = [];
    let root: wxXmlNode | null = null;
    let panes: wxXmlNode | null = null;
    let books: wxXmlNode | null = null;
    let book: wxXmlNode | null = null;

    const hook = (fn: (arg1: Pointer, arg2: Pointer) => void): Pointer =>
    {
        const callback = new Callback(
            { parameters: ["pointer", "pointer", "pointer"], result: "void" },
            (_object, arg1, arg2) =>
            {
                fn(arg1, arg2);
            },
        );
        callbacks.push(callback);
        return callback.pointer;
    };

    // --- SavePane() helpers ------------------------------------------------

    const addPaneNode = (pane: wxAuiPaneLayoutInfo): void =>
    {
        const node = makeElement("pane");
        if (!node)
        {
            return;
        }

        withString("name", (attributeName) =>
        {
            withString(takeString(pane.GetName()), (value) =>
                node.AddAttribute(attributeName, value));
        });

        addDockLayout(node, pane);

        const position = pointOf(pane.GetFloatingPos());
        const size = sizeOf(pane.GetFloatingSize());
        addRectChild(node, "floating-rect",
            position.x, position.y, size.w, size.h);

        const clientSize = sizeOf(pane.GetFloatingClientSize());
        addRectChild(node, "floating-client-rect",
            position.x, position.y, clientSize.w, clientSize.h);

        // Don't bother creating many "maximized" nodes with value 0 when we can
        // have at most one of them with value 1.
        if (pane.IsMaximized())
        {
            addIntChild(node, "maximized", 1);
        }

        // Also don't mark visible pages (as most of them are) as being so.
        if (pane.IsHidden())
        {
            addIntChild(node, "hidden", 1);
        }

        if (panes)
        {
            panes.AddChild(node.ptr);
        }
    };

    const saveTabNode = (tab: wxAuiTabLayoutInfo): void =>
    {
        const node = makeElement("tab");
        if (!node)
        {
            return;
        }

        addDockLayout(node, tab);

        addPagesList(node, "pages",
            takeIntArray(lib.symbols.wxAuiTabLayoutInfo_GetPages(tab.ptr)));
        addPagesList(node, "pinned",
            takeIntArray(lib.symbols.wxAuiTabLayoutInfo_GetPinned(tab.ptr)));

        addIntChild(node, "active", tab.GetActive());

        if (book)
        {
            book.AddChild(node.ptr);
        }
    };

    // --- wxAuiSerializer hooks ---------------------------------------------

    const onBeforeSave = hook(() =>
    {
        root = makeElement("aui-layout");
        if (!root)
        {
            return;
        }

        withString("version", (attributeName) =>
        {
            withString(XML_VERSION, (value) =>
                root!.AddAttribute(attributeName, value));
        });

        doc.SetRoot(root.ptr);
    });

    const onBeforeSavePanes = hook(() =>
    {
        panes = makeElement("panes");
    });

    const onSavePane = hook((panePtr) =>
    {
        if (panePtr)
        {
            addPaneNode(wrapWxAuiPaneLayoutInfo(panePtr));
        }
    });

    const onAfterSavePanes = hook(() =>
    {
        if (root && panes)
        {
            root.AddChild(panes.ptr);
            panes = null;
        }
    });

    const onBeforeSaveNotebooks = hook(() =>
    {
        books = makeElement("notebooks");
    });

    const onBeforeSaveNotebook = hook((namePtr) =>
    {
        book = makeElement("notebook");
        if (!book)
        {
            return;
        }

        withString("name", (attributeName) =>
        {
            withString(readWxString(namePtr), (value) =>
                book!.AddAttribute(attributeName, value));
        });
    });

    const onSaveNotebookTabControl = hook((tabPtr) =>
    {
        if (tabPtr)
        {
            saveTabNode(wrapWxAuiTabLayoutInfo(tabPtr));
        }
    });

    const onAfterSaveNotebook = hook(() =>
    {
        if (books && book)
        {
            books.AddChild(book.ptr);
            book = null;
        }
    });

    const onAfterSaveNotebooks = hook(() =>
    {
        if (root && books)
        {
            root.AddChild(books.ptr);
            books = null;
        }
    });

    const onAfterSave = hook(() =>
    {
        // MyXmlSerializer::AfterSave() is empty.
    });

    serializer.SetOnBeforeSave(onBeforeSave);
    serializer.SetOnBeforeSavePanes(onBeforeSavePanes);
    serializer.SetOnSavePane(onSavePane);
    serializer.SetOnAfterSavePanes(onAfterSavePanes);
    serializer.SetOnBeforeSaveNotebooks(onBeforeSaveNotebooks);
    serializer.SetOnBeforeSaveNotebook(onBeforeSaveNotebook);
    serializer.SetOnSaveNotebookTabControl(onSaveNotebookTabControl);
    serializer.SetOnAfterSaveNotebook(onAfterSaveNotebook);
    serializer.SetOnAfterSaveNotebooks(onAfterSaveNotebooks);
    serializer.SetOnAfterSave(onAfterSave);

    return {
        serializer,
        xml(): string
        {
            const text = doc.SaveToString(XML_INDENT);
            return text ? takeString(text) : "";
        },
        dispose(): void
        {
            serializer.Delete();
            for (const callback of callbacks)
            {
                callback.close();
            }
            doc.Delete();
        },
    };
}

//---------------------------------------------------------------------------
// MyXmlDeserializer
//---------------------------------------------------------------------------

interface DeserializerContext
{
    error: string;
    fail(message: string): void;
}

interface DeserializerSession
{
    readonly deserializer: kwxAuiDeserializer | null;
    readonly context: DeserializerContext;
    dispose(): void;
}

function getInt(context: DeserializerContext, text: string): number
{
    const value = Number.parseInt(text, 10);
    if (Number.isNaN(value))
    {
        context.fail("Failed to parse integer");
        return 0;
    }
    return value;
}

function getSize(
    context: DeserializerContext,
    text: string,
): { width: number; height: number }
{
    const separator = text.indexOf("x");
    const widthText = separator < 0 ? text : text.substring(0, separator);
    const heightText = separator < 0 ? "" : text.substring(separator + 1);

    // Special case which wouldn't be parsed by the unsigned conversion.
    if (widthText === "-1" && heightText === widthText)
    {
        return { width: -1, height: -1 };
    }

    const width = Number.parseInt(widthText, 10);
    const height = Number.parseInt(heightText, 10);
    if (Number.isNaN(width) || Number.isNaN(height))
    {
        context.fail("Failed to parse size");
        return { width: -1, height: -1 };
    }

    return { width, height };
}

function getRect(
    context: DeserializerContext,
    text: string,
): { x: number; y: number; width: number; height: number }
{
    const space = text.indexOf(" ");
    const positionText = space < 0 ? text : text.substring(0, space);
    const sizeText = space < 0 ? "" : text.substring(space + 1);

    const comma = positionText.indexOf(",");
    const xText = comma < 0 ? positionText : positionText.substring(0, comma);
    const yText = comma < 0 ? "" : positionText.substring(comma + 1);

    const x = Number.parseInt(xText, 10);
    const y = Number.parseInt(yText, 10);
    if (Number.isNaN(x) || Number.isNaN(y))
    {
        context.fail("Failed to parse position");
        return { x: -1, y: -1, width: -1, height: -1 };
    }

    const size = getSize(context, sizeText);
    return { x, y, width: size.width, height: size.height };
}

interface DockLayoutTarget
{
    SetDockDirection(direction: number): void;
    SetDockLayer(layer: number): void;
    SetDockRow(row: number): void;
    SetDockPos(pos: number): void;
    SetDockProportion(proportion: number): void;
    SetDockSize(size: number): void;
}

/** LoadDockLayout(): returns true when the node was a layout field. */
function loadDockLayout(
    context: DeserializerContext,
    node: wxXmlNode,
    target: DockLayoutTarget,
): boolean
{
    const name = nodeName(node);
    const content = nodeContent(node);

    switch (name)
    {
        case "direction":
            target.SetDockDirection(getInt(context, content));
            return true;
        case "layer":
            target.SetDockLayer(getInt(context, content));
            return true;
        case "row":
            target.SetDockRow(getInt(context, content));
            return true;
        case "position":
            target.SetDockPos(getInt(context, content));
            return true;
        case "proportion":
            target.SetDockProportion(getInt(context, content));
            return true;
        case "size":
            target.SetDockSize(getInt(context, content));
            return true;
        default:
            return false;
    }
}

function createPaneInfo(
    context: DeserializerContext,
    node: wxXmlNode,
): wxAuiPaneLayoutInfo | null
{
    const info = withString(attribute(node, "name", ""),
        (name) => createWxAuiPaneLayoutInfo(name));
    if (!info)
    {
        return null;
    }

    let child = node.GetChildren();
    while (child)
    {
        if (!loadDockLayout(context, child, info))
        {
            const name = nodeName(child);
            const content = nodeContent(child);

            if (name === "floating-rect")
            {
                const rect = getRect(context, content);
                info.SetFloatingPos(rect.x, rect.y);
                info.SetFloatingSize(rect.width, rect.height);
            }
            else if (name === "floating-client-rect")
            {
                const rect = getRect(context, content);
                info.SetFloatingPos(rect.x, rect.y);
                info.SetFloatingClientSize(rect.width, rect.height);
            }
            else if (name === "maximized")
            {
                info.SetMaximized(getInt(context, content) !== 0);
            }
            else if (name === "hidden")
            {
                info.SetHidden(getInt(context, content) !== 0);
            }
            else
            {
                context.fail("Unexpected pane child node name");
            }
        }

        child = child.GetNext();
    }

    return info;
}

function findNotebookNode(books: wxXmlNode | null, name: string): wxXmlNode | null
{
    let node = books ? books.GetChildren() : null;
    while (node)
    {
        if (nodeName(node) === "notebook" && attribute(node, "name", "") === name)
        {
            return node;
        }
        node = node.GetNext();
    }
    return null;
}

/** Copies a JS list into a wxArrayInt for wxAuiTabLayoutInfo::SetPages(). */
function applyTabPages(
    tab: wxAuiTabLayoutInfo,
    values: number[],
    pinned: boolean,
): void
{
    if (values.length === 0)
    {
        return;
    }

    const array = createWxArrayInt();
    if (!array)
    {
        return;
    }

    for (const value of values)
    {
        array.Add(value);
    }

    // SetPages()/SetPinned() copy the wxArrayInt contents.
    if (pinned)
    {
        tab.SetPinned(array.ptr);
    }
    else
    {
        tab.SetPages(array.ptr);
    }

    array.Delete();
}

function loadNotebookTabs(
    context: DeserializerContext,
    notebookNode: wxXmlNode,
    array: { Add(item: Pointer): void },
): void
{
    let node = notebookNode.GetChildren();
    while (node)
    {
        if (nodeName(node) !== "tab")
        {
            context.fail("Unexpected tab node name");
            return;
        }

        const tab = createWxAuiTabLayoutInfo();
        if (!tab)
        {
            return;
        }

        const pages: number[] = [];
        const pinned: number[] = [];

        let child = node.GetChildren();
        while (child)
        {
            if (!loadDockLayout(context, child, tab))
            {
                const name = nodeName(child);
                const content = nodeContent(child);

                if (name === "pages" || name === "pinned")
                {
                    const indices = content === "" ? [] : content.split(",");
                    for (const indexText of indices)
                    {
                        const index = getInt(context, indexText);
                        (name === "pages" ? pages : pinned).push(index);
                    }
                }
                else if (name === "active")
                {
                    tab.SetActive(getInt(context, content));
                }
                else
                {
                    context.fail("Unexpected tab child node name");
                }
            }

            child = child.GetNext();
        }

        applyTabPages(tab, pages, false);
        applyTabPages(tab, pinned, true);

        array.Add(tab.ptr);
        tab.Delete();
        node = node.GetNext();
    }
}

/**
 * Creates a MyXmlDeserializer equivalent bound to `manager`, after parsing and
 * validating `xml` the same way the C++ constructor does.
 */
export function createDeserializerSession(
    manager: Pointer,
    xml: string,
): DeserializerSession
{
    const context: DeserializerContext = {
        error: "",
        fail(message: string): void
        {
            if (context.error === "")
            {
                context.error = message;
            }
        },
    };

    const doc = createWxXmlDocument();
    const empty: DeserializerSession = {
        deserializer: null,
        context,
        dispose(): void
        {
            doc?.Delete();
        },
    };

    if (!doc)
    {
        context.fail("Failed to create XML document.");
        return empty;
    }

    if (!withString(xml, (text) => doc.LoadFromString(text, 0)))
    {
        context.fail("Failed to load XML document.");
        return empty;
    }

    const documentNode = doc.GetDocumentNode();
    const layout = documentNode ? documentNode.GetChildren() : null;
    if (!layout)
    {
        context.fail("Missing layout node");
        return empty;
    }
    if (nodeName(layout) !== "aui-layout")
    {
        context.fail("Unexpected XML node name");
        return empty;
    }
    if (attribute(layout, "version", "") !== XML_VERSION)
    {
        context.fail("Unexpected XML version");
        return empty;
    }
    if (layout.GetNext())
    {
        context.fail("Unexpected multiple layout nodes");
        return empty;
    }

    let panesNode: wxXmlNode | null = null;
    let booksNode: wxXmlNode | null = null;

    // Check that we only have the top level nodes that we expect.
    let node: wxXmlNode | null = layout.GetChildren();
    while (node)
    {
        const name = nodeName(node);
        if (name === "panes")
        {
            if (panesNode)
            {
                context.fail("Unexpected multiple panes nodes");
                return empty;
            }
            panesNode = node;
        }
        else if (name === "notebooks")
        {
            if (booksNode)
            {
                context.fail("Unexpected multiple notebooks nodes");
                return empty;
            }
            booksNode = node;
        }
        else
        {
            context.fail("Unexpected node name");
            return empty;
        }
        node = node.GetNext();
    }

    const deserializer = createKwxAuiDeserializer(manager, null);
    if (!deserializer)
    {
        context.fail("Failed to create the layout deserializer.");
        return empty;
    }

    const callbacks: Callback[] = [];

    const hook = (fn: (arg1: Pointer, arg2: Pointer) => void): Pointer =>
    {
        const callback = new Callback(
            { parameters: ["pointer", "pointer", "pointer"], result: "void" },
            (_object, arg1, arg2) =>
            {
                fn(arg1, arg2);
            },
        );
        callbacks.push(callback);
        return callback.pointer;
    };

    // --- wxAuiDeserializer hooks -------------------------------------------

    const onLoadPanes = hook((resultPtr) =>
    {
        if (!resultPtr)
        {
            return;
        }

        const result = wrapWxkwxAuiCallbackResult(resultPtr);
        const array = createWxAuiPaneLayoutInfoArray();
        if (!array)
        {
            return;
        }

        let paneNode = panesNode ? panesNode.GetChildren() : null;
        while (paneNode)
        {
            if (nodeName(paneNode) !== "pane")
            {
                context.fail("Unexpected pane node name");
                break;
            }

            const info = createPaneInfo(context, paneNode);
            if (info)
            {
                array.Add(info.ptr);
                info.Delete();
            }

            paneNode = paneNode.GetNext();
        }

        result.SetPointer(array.ptr);
    });

    const onLoadNotebookTabs = hook((namePtr, resultPtr) =>
    {
        if (!resultPtr)
        {
            return;
        }

        const result = wrapWxkwxAuiCallbackResult(resultPtr);
        const array = createWxAuiTabLayoutInfoArray();
        if (!array)
        {
            return;
        }

        const name = readWxString(namePtr);
        const notebookNode = findNotebookNode(booksNode, name);
        if (!notebookNode)
        {
            // As in the sample, a missing notebook is a hard error.
            context.fail("Notebook with the given name not found");
            result.SetPointer(array.ptr);
            return;
        }

        loadNotebookTabs(context, notebookNode, array);
        result.SetPointer(array.ptr);
    });

    const onCreatePaneWindow = hook((panePtr) =>
    {
        // MyXmlDeserializer::CreatePaneWindow(): report the unknown pane and
        // return null so the manager skips it.
        if (!panePtr)
        {
            return;
        }
        const pane = wrapWxAuiPaneInfo(panePtr);
        logWarning("Unknown pane \"" + takeString(pane.GetName()) + "\"");
    });

    const onHandleOrphanedPage = hook((infoPtr) =>
    {
        if (!infoPtr)
        {
            return;
        }

        const info = wrapWxkwxAuiOrphanedPage(infoPtr);
        const page = info.GetPage();

        // If the first ("Welcome") page is not attached, insert it in the
        // beginning of the main tab control.
        if (page === 0)
        {
            // We don't need to change tabCtrl, it's set to the main one by
            // default, but check that this is indeed the case.
            const book = info.GetNotebook();
            const tabCtrl = info.GetTabCtrl();
            const mainTabCtrl = book ? book.GetMainTabCtrl() : null;

            if (!tabCtrl || tabCtrl.ptr !== mainTabCtrl)
            {
                logWarning("Unexpected tab control for an orphaned page!");
                info.SetResult(false);
                return;
            }

            info.SetTabIndex(0);
            info.SetResult(true);
            return;
        }

        // This is completely artificial, but just keep the pages up to the
        // third one that are not attached to any tab control.
        info.SetResult(page <= 2);
    });

    deserializer.SetOnLoadPanes(onLoadPanes);
    deserializer.SetOnLoadNotebookTabs(onLoadNotebookTabs);
    deserializer.SetOnCreatePaneWindow(onCreatePaneWindow);
    deserializer.SetOnHandleOrphanedPage(onHandleOrphanedPage);
    // AfterLoad() is not overridden, so the base implementation still runs.

    return {
        deserializer,
        context,
        dispose(): void
        {
            deserializer.Delete();
            for (const callback of callbacks)
            {
                callback.close();
            }
            doc.Delete();
        },
    };
}

/** MyFrame::OnCopyLayout() / OnPasteLayout() work on the whole manager layout. */
export function saveManagerLayout(manager: Pointer): string
{
    const session = createSerializerSession();
    if (!session)
    {
        return "";
    }

    try
    {
        wrapWxAuiManager(manager).SaveLayout(session.serializer.ptr);
        return session.xml();
    }
    finally
    {
        session.dispose();
    }
}

/** wxAuiNotebook::SaveLayout() with the sample's "notebook" section only. */
export function saveNotebookLayout(manager: Pointer, book: Pointer, name: string): string
{
    const session = createSerializerSession();
    if (!session)
    {
        return "";
    }

    try
    {
        const serializer = session.serializer;

        // This is a hack, but it allows us to reuse the full serializer without
        // duplicating its code.
        serializer.BeforeSave();
        serializer.BeforeSaveNotebooks();

        withString(name, (label) =>
            wrapWxAuiNotebook(book).SaveLayout(label, serializer.ptr));

        serializer.AfterSaveNotebooks();
        serializer.AfterSave();

        return session.xml();
    }
    finally
    {
        session.dispose();
    }
}

/**
 * Restores a manager layout.  Returns the error message, or "" on success.
 * On failure the caller logs it, mirroring the C++ try/catch around the
 * deserializer constructor and wxAuiManager::LoadLayout().
 */
export function loadManagerLayout(manager: Pointer, xml: string): string
{
    const session = createDeserializerSession(manager, xml);
    try
    {
        if (!session.deserializer)
        {
            return session.context.error;
        }

        wrapWxAuiManager(manager).LoadLayout(session.deserializer.ptr);
        return session.context.error;
    }
    finally
    {
        session.dispose();
    }
}

/** Restores a notebook layout.  Returns the error message, or "" on success. */
export function loadNotebookLayout(
    manager: Pointer,
    book: Pointer,
    name: string,
    xml: string,
): string
{
    const session = createDeserializerSession(manager, xml);
    try
    {
        if (!session.deserializer)
        {
            return session.context.error;
        }

        withString(name, (label) =>
            wrapWxAuiNotebook(book).LoadLayout(label, session.deserializer!.ptr));
        return session.context.error;
    }
    finally
    {
        session.dispose();
    }
}

/** Reports a serializer/deserializer failure the way wxLogError() would. */
export function reportLayoutError(prefix: string, message: string): void
{
    logError(prefix + (message === "" ? "unknown error" : message));
}
