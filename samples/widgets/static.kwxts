// static.kwxts — port of wxSamples/src/widgets/static.cpp
//
// Both wxStaticText and wxGenericStaticText are created according to the
// "Generic wxStaticText" check box, wxStaticBox can use a window label, and
// CreateStatic() holds a wxWindowUpdateLocker, all as in the C++ sample.
//
// wxLI_VERTICAL/wxLI_HORIZONTAL are not exported as such, but wx/defs.h
// defines them as aliases of wxVERTICAL/wxHORIZONTAL, which are used here.

import {
    ALIGN_BOTTOM,
    ALIGN_CENTRE_HORIZONTAL,
    ALIGN_CENTRE_VERTICAL,
    ALIGN_LEFT,
    ALIGN_RIGHT,
    ALIGN_TOP,
    ALL,
    BOTTOM,
    createWxBoxSizer,
    createWxButton,
    createWxCheckBox,
    createWxGenericStaticText,
    createWxRadioBox,
    createWxStaticBox,
    createWxStaticBoxWithLabelWindow,
    createWxStaticBoxSizer,
    createWxStaticLine,
    createWxStaticText,
    createWxTextCtrl,
    createWxWindowUpdateLocker,
    EVT_BUTTON,
    EVT_CHECKBOX,
    EVT_LEFT_UP,
    EVT_RADIOBOX,
    EXPAND,
    GREEN,
    HORIZONTAL,
    HSCROLL,
    ID_ANY,
    LEFT,
    readAndDeleteWxString,
    RIGHT,
    ST_ELLIPSIZE_END,
    ST_ELLIPSIZE_MIDDLE,
    ST_ELLIPSIZE_START,
    ST_NO_AUTORESIZE,
    ST_WRAP,
    TE_MULTILINE,
    TOP,
    VERTICAL,
    wxCheckBox,
    wxCommandEvent,
    wxControl,
    wxRadioBox,
    wxSizer,
    wxStaticLine,
    wxTextCtrl,
    wxWindow,
} from "kwx";
import { Pointer, pointerOf } from "kwx/platform";

import {
    addSizer,
    addSpacer,
    addWin,
    attrs,
    bindEvent,
    border,
    doubleBorder,
    logMessage,
    makeStaticBoxSizer,
    StaticBoxSizerParts,
    tripleBorder,
    WidgetsPage,
    withString,
} from "./common.kwxts";

// StaticHAlign_* / StaticVAlign_* / StaticEllipsize_* (radio box indices).
const STATIC_HALIGN_LEFT = 0;
const STATIC_HALIGN_CENTRE = 1;
const STATIC_HALIGN_RIGHT = 2;

const STATIC_VALIGN_TOP = 0;
const STATIC_VALIGN_CENTRE = 1;
const STATIC_VALIGN_BOTTOM = 2;

const STATIC_ELLIPSIZE_START = 0;
const STATIC_ELLIPSIZE_MIDDLE = 1;
const STATIC_ELLIPSIZE_END = 2;

/**
 * Builds the `char**` array expected by wxRadioBox_Create.  The returned
 * buffers must stay reachable until the native call returns.
 */
function makeRadioBox(
    parent: Pointer,
    caption: string,
    items: string[],
    dimension: number,
): wxRadioBox
{
    const buffers: Uint8Array[] = [];
    const pointers = new BigUint64Array(items.length);

    for (let index = 0; index < items.length; index++)
    {
        const bytes = new TextEncoder().encode(items[index] + "\0");
        buffers.push(bytes);
        const address = pointerOf(bytes);
        pointers[index] = address === null ? 0n : address;
    }

    const choices = pointerOf(pointers);

    const box = withString(caption, (ptr) =>
        createWxRadioBox(
            parent, ID_ANY, ptr, -1, -1, -1, -1,
            items.length, choices, dimension, 0,
        ));

    // Keep the string buffers alive until the constructor has copied them.
    void buffers;
    return box!;
}

interface StaticControls
{
    chkVert: wxCheckBox;
    chkGeneric: wxCheckBox;
    chkBoxWithCheck: wxCheckBox;
    chkAutoResize: wxCheckBox;
    chkWrap: wxCheckBox;
    chkEllipsize: wxCheckBox;
    chkGreen: wxCheckBox;
    radioHAlign: wxRadioBox;
    radioVAlign: wxRadioBox;
    radioEllipsize: wxRadioBox;
    textBox: wxTextCtrl;
    textLabel: wxTextCtrl;
    textLabelWithMarkup: wxTextCtrl;
}

export class StaticPage extends WidgetsPage
{
    private controls: StaticControls | null = null;
    private sizerStatic: wxSizer | null = null;
    private statBox: StaticBoxSizerParts | null = null;
    private statText: wxControl | null = null;
    private statMarkup: wxControl | null = null;
    private statLine: wxStaticLine | null = null;

    constructor(parent: Pointer)
    {
        super(parent, "icons/statbox");
    }

    override getWidget(): wxWindow | null
    {
        return this.statText;
    }

    override getWidgets(): wxWindow[]
    {
        const widgets: wxWindow[] = [];
        if (this.statBox)
        {
            widgets.push(this.statBox.box);
        }
        if (this.statText)
        {
            widgets.push(this.statText);
        }
        if (this.statMarkup)
        {
            widgets.push(this.statMarkup);
        }
        if (this.statLine)
        {
            widgets.push(this.statLine);
        }
        return widgets;
    }

    override createContent(): void
    {
        const sizerTop = createWxBoxSizer(HORIZONTAL)!;

        // left pane
        const sizerLeft = makeStaticBoxSizer(this.page.ptr, VERTICAL, "&Set style");

        const chkGeneric = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "&Generic wxStaticText", ID_ANY, sizerLeft.box.ptr);
        bindEvent(chkGeneric, ID_ANY, ID_ANY, EVT_CHECKBOX, () => this.createStatic());

        const chkBoxWithCheck = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Checkable &box", ID_ANY, sizerLeft.box.ptr);
        bindEvent(chkBoxWithCheck, ID_ANY, ID_ANY, EVT_CHECKBOX,
            () => this.createStatic());

        const chkVert = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "&Vertical line", ID_ANY, sizerLeft.box.ptr);
        bindEvent(chkVert, ID_ANY, ID_ANY, EVT_CHECKBOX, () => this.createStatic());

        const chkAutoResize = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "&Fit to text", ID_ANY, sizerLeft.box.ptr);
        bindEvent(chkAutoResize, ID_ANY, ID_ANY, EVT_CHECKBOX, () => this.createStatic());

        const chkWrap = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "&Wrap", ID_ANY, sizerLeft.box.ptr);
        bindEvent(chkWrap, ID_ANY, ID_ANY, EVT_CHECKBOX, () => this.createStatic());

        addSpacer(sizerLeft.sizer, this.dip(15));

        const radioHAlign = makeRadioBox(
            sizerLeft.box.ptr, "&Horz alignment", ["left", "centre", "right"], 3);
        bindEvent(radioHAlign, ID_ANY, ID_ANY, EVT_RADIOBOX, () => this.createStatic());

        const radioVAlign = makeRadioBox(
            sizerLeft.box.ptr, "&Vert alignment", ["top", "centre", "bottom"], 3);
        withString("Relevant for Generic wxStaticText only", (ptr) =>
            radioVAlign.SetToolTip(ptr));
        bindEvent(radioVAlign, ID_ANY, ID_ANY, EVT_RADIOBOX, () => this.createStatic());

        addWin(sizerLeft.sizer, radioHAlign, 0, EXPAND, border());
        addWin(sizerLeft.sizer, radioVAlign, 0, EXPAND, border());

        addSpacer(sizerLeft.sizer, this.dip(15));

        const chkEllipsize = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "&Ellipsize", ID_ANY, sizerLeft.box.ptr);
        bindEvent(chkEllipsize, ID_ANY, ID_ANY, EVT_CHECKBOX,
            () => this.onCheckEllipsize());

        const radioEllipsize = makeRadioBox(
            sizerLeft.box.ptr, "&Ellipsize mode", ["&start", "&middle", "&end"], 3);
        bindEvent(radioEllipsize, ID_ANY, ID_ANY, EVT_RADIOBOX,
            () => this.createStatic());

        addWin(sizerLeft.sizer, radioEllipsize, 0, EXPAND, border());

        const buttonReset = withString("&Reset", (ptr) =>
            createWxButton(sizerLeft.box.ptr, ID_ANY, ptr, -1, -1, -1, -1, 0))!;
        bindEvent(buttonReset, ID_ANY, ID_ANY, EVT_BUTTON, () =>
        {
            this.reset();
            this.createStatic();
        });
        addWin(sizerLeft.sizer, buttonReset, 0, ALIGN_CENTRE_HORIZONTAL, tripleBorder());

        // middle pane
        const sizerMiddle = makeStaticBoxSizer(this.page.ptr, VERTICAL, "&Change labels");

        const textBox = withString("", (ptr) =>
            createWxTextCtrl(sizerMiddle.box.ptr, ID_ANY, ptr,
                -1, -1, -1, -1, BigInt(0)))!;
        const buttonBoxText = withString("Change &box label", (ptr) =>
            createWxButton(sizerMiddle.box.ptr, ID_ANY, ptr, -1, -1, -1, -1, 0))!;
        bindEvent(buttonBoxText, ID_ANY, ID_ANY, EVT_BUTTON, () => this.changeBoxLabel());
        addWin(sizerMiddle.sizer, textBox, 0, EXPAND, border());
        addWin(sizerMiddle.sizer, buttonBoxText, 0, LEFT | BOTTOM, border());

        const textLabel = withString("", (ptr) =>
            createWxTextCtrl(sizerMiddle.box.ptr, ID_ANY, ptr, -1, -1, -1, -1,
                BigInt(TE_MULTILINE | HSCROLL)))!;
        const buttonLabelText = withString("Change &text label", (ptr) =>
            createWxButton(sizerMiddle.box.ptr, ID_ANY, ptr, -1, -1, -1, -1, 0))!;
        bindEvent(buttonLabelText, ID_ANY, ID_ANY, EVT_BUTTON,
            () => this.changeLabelText());
        addWin(sizerMiddle.sizer, textLabel, 0, EXPAND, border());
        addWin(sizerMiddle.sizer, buttonLabelText, 0, LEFT | BOTTOM, border());

        const textLabelWithMarkup = withString("", (ptr) =>
            createWxTextCtrl(sizerMiddle.box.ptr, ID_ANY, ptr, -1, -1, -1, -1,
                BigInt(TE_MULTILINE | HSCROLL)))!;
        const buttonMarkupText = withString("Change decorated text label", (ptr) =>
            createWxButton(sizerMiddle.box.ptr, ID_ANY, ptr, -1, -1, -1, -1, 0))!;
        bindEvent(buttonMarkupText, ID_ANY, ID_ANY, EVT_BUTTON,
            () => this.changeMarkupLabel());
        addWin(sizerMiddle.sizer, textLabelWithMarkup, 0, EXPAND, border());
        addWin(sizerMiddle.sizer, buttonMarkupText, 0, LEFT | BOTTOM, border());

        const chkGreen = this.createCheckBoxAndAddToSizer(
            sizerMiddle.sizer, "Decorated label on g&reen", ID_ANY, sizerMiddle.box.ptr);
        bindEvent(chkGreen, ID_ANY, ID_ANY, EVT_CHECKBOX, () => this.createStatic());

        const controls: StaticControls = {
            chkVert,
            chkGeneric,
            chkBoxWithCheck,
            chkAutoResize,
            chkWrap,
            chkEllipsize,
            chkGreen,
            radioHAlign,
            radioVAlign,
            radioEllipsize,
            textBox,
            textLabel,
            textLabelWithMarkup,
        };
        this.controls = controls;

        // final initializations
        // NB: must be done _before_ calling createStatic()
        this.reset();

        withString("This is a &box", (ptr) => textBox.SetValue(ptr));
        withString("And this is a\n\tlabel inside the box with a &mnemonic.\n"
            + "Only this text is affected by the ellipsize settings.",
        (ptr) => textLabel.SetValue(ptr));
        withString("Another label, this time <b>decorated</b>\n"
            + "with <u>markup</u>; here you need entities\n"
            + "for the symbols: &lt; &gt; &amp;&amp; &apos; &quot;\n"
            + "but you can still use &mnemonics too",
        (ptr) => textLabelWithMarkup.SetValue(ptr));

        // right pane
        const sizerRight = createWxBoxSizer(HORIZONTAL)!;
        sizerRight.SetMinSize(this.dip(150), 0);
        this.sizerStatic = sizerRight;

        this.createStatic();

        // the three panes compose the window
        addSizer(sizerTop, sizerLeft.sizer, 0, EXPAND | (ALL & ~LEFT), doubleBorder());
        addSizer(sizerTop, sizerMiddle.sizer, 0, EXPAND | ALL, doubleBorder());
        addSizer(sizerTop, sizerRight, 1, EXPAND | (ALL & ~RIGHT), doubleBorder());

        this.page.SetSizer(sizerTop.ptr, false);
    }

    override recreateWidget(): void
    {
        this.createStatic();
    }

    /** StaticWidgetsPage::Reset() */
    private reset(): void
    {
        const controls = this.controls;
        if (!controls)
        {
            return;
        }

        controls.chkGeneric.SetValue(false);
        controls.chkBoxWithCheck.SetValue(false);
        controls.chkVert.SetValue(false);
        controls.chkAutoResize.SetValue(true);
        controls.chkWrap.SetValue(false);
        controls.chkEllipsize.SetValue(false);
        controls.radioEllipsize.Enable(false);

        controls.radioHAlign.SetSelection(STATIC_HALIGN_LEFT);
        controls.radioVAlign.SetSelection(STATIC_VALIGN_TOP);
    }

    /** StaticWidgetsPage::OnCheckEllipsize() */
    private onCheckEllipsize(): void
    {
        const controls = this.controls;
        if (!controls)
        {
            return;
        }

        controls.radioEllipsize.Enable(controls.chkEllipsize.GetValue());
        this.createStatic();
    }

    /** StaticWidgetsPage::OnButtonBoxText() */
    private changeBoxLabel(): void
    {
        const statBox = this.statBox;
        const controls = this.controls;
        if (!statBox || !controls)
        {
            return;
        }

        withString(this.textValue(controls.textBox), (ptr) => statBox.box.SetLabel(ptr));
    }

    /** StaticWidgetsPage::OnButtonLabelText() */
    private changeLabelText(): void
    {
        const statText = this.statText;
        const controls = this.controls;
        if (!statText || !controls)
        {
            return;
        }

        withString(this.textValue(controls.textLabel), (ptr) => statText.SetLabel(ptr));

        // test GetLabel() and GetLabelText(); the first should return the label
        // as it is written in the relative text control, the second should
        // return the label as it is shown in the wxStaticText
        logMessage(`The original label should be '${this.widgetLabel(statText)}'`);
        logMessage(`The label text is '${this.widgetLabelText(statText)}'`);
    }

    /** StaticWidgetsPage::OnButtonLabelWithMarkupText() */
    private changeMarkupLabel(): void
    {
        const statMarkup = this.statMarkup;
        const controls = this.controls;
        if (!statMarkup || !controls)
        {
            return;
        }

        withString(this.textValue(controls.textLabelWithMarkup),
            (ptr) => statMarkup.SetLabelMarkup(ptr));

        logMessage(`The original label should be '${this.widgetLabel(statMarkup)}'`);
        logMessage(`The label text is '${this.widgetLabelText(statMarkup)}'`);
    }

    /** StaticWidgetsPage::CreateStatic() */
    private createStatic(): void
    {
        const controls = this.controls;
        const sizerStatic = this.sizerStatic;
        if (!controls || !sizerStatic)
        {
            return;
        }

        // wxWindowUpdateLocker lock(this)
        const updateLocker = createWxWindowUpdateLocker(this.page.ptr);

        const isVert = controls.chkVert.GetValue();

        const previous = this.statBox;
        if (previous)
        {
            // wxSizer::Remove(wxSizer*) deletes the corresponding wxSizerItem,
            // and a sizer item owns its child sizer: the static box sizer (and
            // with it its wxStaticBox) is gone after this call.  Only the text
            // windows, which are left alive by the sizer, are destroyed here.
            sizerStatic.RemoveSizer(previous.sizer.ptr);
            this.statText?.Destroy();
            this.statMarkup?.Destroy();
            this.statLine?.Destroy();

            this.statBox = null;
            this.statText = null;
            this.statMarkup = null;
            this.statLine = null;
        }

        let flagsBox = 0;
        let flagsText = attrs.defaultFlags;
        let flagsMarkupText = attrs.defaultFlags;

        if (!controls.chkAutoResize.GetValue())
        {
            flagsText |= ST_NO_AUTORESIZE;
            flagsMarkupText |= ST_NO_AUTORESIZE;
        }

        if (controls.chkWrap.GetValue())
        {
            flagsText |= ST_WRAP;
            flagsMarkupText |= ST_WRAP;
        }

        let align = 0;

        switch (controls.radioHAlign.GetSelection())
        {
            case STATIC_HALIGN_CENTRE:
                align |= ALIGN_CENTRE_HORIZONTAL;
                break;

            case STATIC_HALIGN_RIGHT:
                align |= ALIGN_RIGHT;
                break;

            default:
                align |= ALIGN_LEFT;
                break;
        }

        switch (controls.radioVAlign.GetSelection())
        {
            case STATIC_VALIGN_CENTRE:
                align |= ALIGN_CENTRE_VERTICAL;
                break;

            case STATIC_VALIGN_BOTTOM:
                align |= ALIGN_BOTTOM;
                break;

            default:
                align |= ALIGN_TOP;
                break;
        }

        if (controls.chkEllipsize.GetValue())
        {
            switch (controls.radioEllipsize.GetSelection())
            {
                case STATIC_ELLIPSIZE_MIDDLE:
                    flagsText |= ST_ELLIPSIZE_MIDDLE;
                    break;

                case STATIC_ELLIPSIZE_END:
                    flagsText |= ST_ELLIPSIZE_END;
                    break;

                default:
                    flagsText |= ST_ELLIPSIZE_START;
                    break;
            }
        }

        flagsText |= align;
        flagsMarkupText |= align;
        flagsBox |= align;

        const boxText = this.textValue(controls.textBox);

        let box;
        if (controls.chkBoxWithCheck.GetValue())
        {
            const label = withString(boxText, (ptr) =>
                createWxCheckBox(this.page.ptr, ID_ANY, ptr, -1, -1, -1, -1, 0))!;
            bindEvent(label, ID_ANY, ID_ANY, EVT_CHECKBOX, (eventPtr) =>
            {
                if (!eventPtr) return;
                const event = new wxCommandEvent(eventPtr, true);
                logMessage("Box check box has been "
                    + (event.IsChecked() ? "" : "un") + "checked");
            });
            box = createWxStaticBoxWithLabelWindow(
                this.page.ptr, ID_ANY, label.ptr, -1, -1, -1, -1, flagsBox)!;
        }
        else
        {
            box = withString(boxText, (ptr) =>
                createWxStaticBox(
                    this.page.ptr, ID_ANY, ptr, -1, -1, -1, -1, flagsBox))!;
        }

        const sizerStatBox = createWxStaticBoxSizer(
            box.ptr, isVert ? HORIZONTAL : VERTICAL)!;

        const useGeneric = controls.chkGeneric.GetValue();

        const statText: wxControl = withString(this.textValue(controls.textLabel),
            (ptr) => useGeneric
                ? createWxGenericStaticText(
                    box.ptr, ID_ANY, ptr, -1, -1, -1, -1, flagsText)!
                : createWxStaticText(
                    box.ptr, ID_ANY, ptr, -1, -1, -1, -1, flagsText)!);

        const statMarkup: wxControl = withString("", (ptr) => useGeneric
            ? createWxGenericStaticText(
                box.ptr, ID_ANY, ptr, -1, -1, -1, -1, flagsMarkupText)!
            : createWxStaticText(
                box.ptr, ID_ANY, ptr, -1, -1, -1, -1, flagsMarkupText)!);
        withString(this.textValue(controls.textLabelWithMarkup),
            (ptr) => statMarkup.SetLabelMarkup(ptr));

        if (controls.chkGreen.GetValue())
        {
            statMarkup.SetBackgroundColour(GREEN);
        }

        // wxLI_VERTICAL/wxLI_HORIZONTAL are aliases of wxVERTICAL/wxHORIZONTAL.
        const statLine = createWxStaticLine(
            box.ptr, ID_ANY, -1, -1, -1, -1, isVert ? VERTICAL : HORIZONTAL)!;

        withString("Tooltip for a label inside the box", (ptr) => statText.SetToolTip(ptr));

        addWin(sizerStatBox, statText, 0, EXPAND, 0);
        addWin(sizerStatBox, statLine, 0, EXPAND | TOP | BOTTOM, doubleBorder());
        addWin(sizerStatBox, statMarkup, 0, 0, 0);

        this.notifyWidgetRecreation(statText);
        this.notifyWidgetRecreation(statMarkup);
        this.notifyWidgetRecreation(statLine);

        addSizer(sizerStatic, sizerStatBox, 1, EXPAND, 0);

        sizerStatic.Layout();

        bindEvent(statText, ID_ANY, ID_ANY, EVT_LEFT_UP, () =>
        {
            logMessage("Clicked on static text");
        });
        bindEvent(box, ID_ANY, ID_ANY, EVT_LEFT_UP, () =>
        {
            logMessage("Clicked on static box");
        });

        this.setUpWidget();

        this.statBox = { sizer: sizerStatBox, box };
        this.statText = statText;
        this.statMarkup = statMarkup;
        this.statLine = statLine;

        updateLocker?.Delete();
    }

    /** wxTextCtrl::GetValue() as a JS string. */
    private textValue(control: wxTextCtrl): string
    {
        const value = control.GetValue();
        return value ? readAndDeleteWxString(value.ptr) : "";
    }

    /** wxControl::GetLabel() as a JS string. */
    private widgetLabel(control: wxControl): string
    {
        const value = control.GetLabel();
        return value ? readAndDeleteWxString(value.ptr) : "";
    }

    /** wxControl::GetLabelText() as a JS string. */
    private widgetLabelText(control: wxControl): string
    {
        const value = control.GetLabelText();
        return value ? readAndDeleteWxString(value.ptr) : "";
    }
}

export function createStaticPage(parent: Pointer): WidgetsPage
{
    return new StaticPage(parent);
}
