// listbox.kwxts — port of wxSamples/src/widgets/listbox.cpp
//
// Every listbox method used by the C++ sample is bound.  Two substitutions were
// needed:
//  * wxLB_HSCROLL is not exported by kwx_constants_gen.ts; wx/defs.h defines it
//    as wxHSCROLL, which is bound.
//  * EVT_UPDATE_UI_RANGE is not exported, so the "Move item up/down" buttons get
//    one EVT_UPDATE_UI binding each.
//
// wxDynamicCast() to wxCheckListBox / wxRearrangeList is replaced by keeping a
// typed reference to the control that was created for the selected list type.

import {
    ALIGN_CENTRE_HORIZONTAL,
    ALL,
    createWxArrayInt,
    createWxArrayString,
    createWxBoxSizer,
    createWxButton,
    createWxCheckListBox,
    createWxListBox,
    createWxRadioBox,
    createWxRearrangeList,
    createWxTextCtrl,
    EVT_BUTTON,
    EVT_CHECKBOX,
    EVT_CHECKLISTBOX,
    EVT_LISTBOX,
    EVT_LISTBOX_DCLICK,
    EVT_RADIOBOX,
    EVT_TEXT_ENTER,
    EVT_UPDATE_UI,
    EXPAND,
    HORIZONTAL,
    HSCROLL,
    ID_ANY,
    ID_HIGHEST,
    LB_ALWAYS_SB,
    LB_EXTENDED,
    LB_MULTIPLE,
    LB_OWNERDRAW,
    LB_SINGLE,
    LB_SORT,
    LEFT,
    LogWarning,
    RA_SPECIFY_COLS,
    readAndDeleteWxString,
    RIGHT,
    VERTICAL,
    wxArrayInt,
    wxArrayString,
    wxCheckBox,
    wxCheckListBox,
    wxCommandEvent,
    wxItemContainer,
    wxListBox,
    wxRadioBox,
    wxRearrangeList,
    wxSizer,
    wxTextCtrl,
    wxUpdateUIEvent,
    wxWindow,
    wrapWxWindow,
} from "kwx";
import { Pointer, pointerOf } from "kwx/platform";

import {
    addSizer,
    addSpacer,
    addWin,
    attrs,
    bindEvent,
    border,
    doubleBorder,
    logMessage,
    makeStaticBoxSizer,
    tripleBorder,
    WidgetsPage,
    withString,
} from "./common.kwxts";
import { runItemContainerTest } from "./itemcontainer.kwxts";

// Control ids (enum starting at wxID_HIGHEST).
const LISTBOX_PAGE_RESET = ID_HIGHEST;
const LISTBOX_PAGE_ADD = LISTBOX_PAGE_RESET + 1;
const LISTBOX_PAGE_ADD_TEXT = LISTBOX_PAGE_ADD + 1;
const LISTBOX_PAGE_ADD_SEVERAL = LISTBOX_PAGE_ADD_TEXT + 1;
const LISTBOX_PAGE_ADD_MANY = LISTBOX_PAGE_ADD_SEVERAL + 1;
const LISTBOX_PAGE_CLEAR = LISTBOX_PAGE_ADD_MANY + 1;
const LISTBOX_PAGE_CHANGE = LISTBOX_PAGE_CLEAR + 1;
const LISTBOX_PAGE_CHANGE_TEXT = LISTBOX_PAGE_CHANGE + 1;
const LISTBOX_PAGE_DELETE = LISTBOX_PAGE_CHANGE_TEXT + 1;
const LISTBOX_PAGE_DELETE_TEXT = LISTBOX_PAGE_DELETE + 1;
const LISTBOX_PAGE_DELETE_SEL = LISTBOX_PAGE_DELETE_TEXT + 1;
const LISTBOX_PAGE_LISTBOX = LISTBOX_PAGE_DELETE_SEL + 1;
const LISTBOX_PAGE_ENSURE_VISIBLE = LISTBOX_PAGE_LISTBOX + 1;
const LISTBOX_PAGE_ENSURE_VISIBLE_TEXT = LISTBOX_PAGE_ENSURE_VISIBLE + 1;
const LISTBOX_PAGE_CONTAINER_TESTS = LISTBOX_PAGE_ENSURE_VISIBLE_TEXT + 1;
const LISTBOX_PAGE_GET_TOP_ITEM = LISTBOX_PAGE_CONTAINER_TESTS + 1;
const LISTBOX_PAGE_GET_COUNT_PER_PAGE = LISTBOX_PAGE_GET_TOP_ITEM + 1;
const LISTBOX_PAGE_MOVE_UP = LISTBOX_PAGE_GET_COUNT_PER_PAGE + 1;
const LISTBOX_PAGE_MOVE_DOWN = LISTBOX_PAGE_MOVE_UP + 1;

// "Selection mode" radio box item indices.
const LBOX_SEL_SINGLE = 0;
const LBOX_SEL_EXTENDED = 1;
const LBOX_SEL_MULTIPLE = 2;

// "List type" radio box item indices.
const LBOX_TYPE_LIST_BOX = 0;
const LBOX_TYPE_CHECK_LIST_BOX = 1;
const LBOX_TYPE_REARRANGE_LIST = 2;

/**
 * Builds the `char**` array expected by wxListBox_Create / wxCheckListBox_Create
 * and by wxListBox::InsertItems().  The returned buffers must stay reachable
 * until the native call returns.
 */
function charPtrArray(
    items: string[],
): { ptr: Pointer; keep: (Uint8Array | BigUint64Array)[] }
{
    const buffers: Uint8Array[] = [];
    const pointers = new BigUint64Array(items.length);

    for (let index = 0; index < items.length; index++)
    {
        const bytes = new TextEncoder().encode(items[index] + "\0");
        buffers.push(bytes);
        const address = pointerOf(bytes);
        pointers[index] = address === null ? 0n : address;
    }

    return {
        ptr: items.length === 0 ? null : pointerOf(pointers),
        keep: [...buffers, pointers],
    };
}

/**
 * Builds the `char**` array expected by wxRadioBox_Create.  The returned
 * buffers must stay reachable until the native call returns.
 */
function makeRadioBox(
    parent: Pointer,
    caption: string,
    items: string[],
    dimension: number,
    style: number,
): wxRadioBox
{
    const built = charPtrArray(items);
    const box = withString(caption, (ptr) =>
        createWxRadioBox(
            parent, ID_ANY, ptr, -1, -1, -1, -1,
            items.length, built.ptr, dimension, style,
        ));
    void built.keep;

    return box!;
}

/** wxLogWarning() with a temporary wxString. */
function logWarning(text: string): void
{
    withString(text.replace(/%/g, "%%"), (ptr) => LogWarning(ptr));
}

/** wxTextCtrl::GetValue() as a JS string. */
function readText(control: wxTextCtrl | null): string
{
    const value = control ? control.GetValue() : null;
    return value ? readAndDeleteWxString(value.ptr) : "";
}

/** wxTextCtrl::SetValue(). */
function writeText(control: wxTextCtrl | null, text: string): void
{
    if (!control)
    {
        return;
    }
    withString(text, (ptr) => control.SetValue(ptr));
}

/** wxString::ToULong(): null when the text is not an unsigned integer. */
function parseUnsigned(text: string): number | null
{
    const trimmed = text.trim();
    if (!/^\d+$/.test(trimmed))
    {
        return null;
    }
    const value = Number(trimmed);
    return Number.isSafeInteger(value) ? value : null;
}

let newItemCounter = 0;

/** wxListBox sample page. */
export class ListboxPage extends WidgetsPage
{
    private radioSelMode: wxRadioBox | null = null;
    private radioListType: wxRadioBox | null = null;

    private chkVScroll: wxCheckBox | null = null;
    private chkHScroll: wxCheckBox | null = null;
    private chkSort: wxCheckBox | null = null;
    private chkOwnerDraw: wxCheckBox | null = null;

    private listbox: wxListBox | null = null;
    private checkListBox: wxCheckListBox | null = null;
    private rearrangeList: wxRearrangeList | null = null;
    private sizerLbox: wxSizer | null = null;

    private textAdd: wxTextCtrl | null = null;
    private textChange: wxTextCtrl | null = null;
    private textEnsureVisible: wxTextCtrl | null = null;
    private textDelete: wxTextCtrl | null = null;

    constructor(parent: Pointer)
    {
        super(parent, "icons/listbox");
    }

    override getWidget(): wxWindow | null
    {
        return this.listbox;
    }

    override createContent(): void
    {
        /*
           Three panes: the style pane on the left, the pane with the buttons
           performing listbox operations in the middle and the listbox itself on
           the right.
        */
        const sizerTop = createWxBoxSizer(HORIZONTAL)!;

        // left pane
        const sizerLeft = makeStaticBoxSizer(
            this.page.ptr, VERTICAL, "&Set listbox parameters");

        this.chkVScroll = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Always show &vertical scrollbar", ID_ANY,
            sizerLeft.box.ptr);
        this.chkHScroll = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Show &horizontal scrollbar", ID_ANY,
            sizerLeft.box.ptr);
        this.chkSort = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "&Sort items", ID_ANY, sizerLeft.box.ptr);
        this.chkOwnerDraw = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "&Owner drawn", ID_ANY, sizerLeft.box.ptr);

        this.radioSelMode = makeRadioBox(
            sizerLeft.box.ptr, "Selection &mode:",
            ["single", "extended", "multiple"], 1, RA_SPECIFY_COLS);
        this.radioListType = makeRadioBox(
            sizerLeft.box.ptr, "&List type:",
            ["list box", "check list box", "rearrange list"], 1,
            RA_SPECIFY_COLS);

        addSpacer(sizerLeft.sizer, this.dip(5));
        addWin(sizerLeft.sizer, this.radioSelMode, 0, EXPAND | ALL, border());

        addSpacer(sizerLeft.sizer, this.dip(5));
        addWin(sizerLeft.sizer, this.radioListType, 0, EXPAND | ALL, border());

        const resetButton = withString("&Reset", (ptr) =>
            createWxButton(sizerLeft.box.ptr, LISTBOX_PAGE_RESET, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(sizerLeft.sizer, resetButton, 0,
            ALIGN_CENTRE_HORIZONTAL, tripleBorder());

        // middle pane
        const sizerMiddle = makeStaticBoxSizer(
            this.page.ptr, VERTICAL, "&Change listbox contents");

        const sizerRowAdd = createWxBoxSizer(HORIZONTAL)!;
        const addButton = withString("&Add this string", (ptr) =>
            createWxButton(sizerMiddle.box.ptr, LISTBOX_PAGE_ADD, ptr,
                -1, -1, -1, -1, 0))!;
        this.textAdd = withString("test item \t0", (ptr) =>
            createWxTextCtrl(
                sizerMiddle.box.ptr, LISTBOX_PAGE_ADD_TEXT, ptr,
                -1, -1, -1, -1, BigInt(0)));
        addWin(sizerRowAdd, addButton, 0, RIGHT, border());
        if (this.textAdd)
        {
            addWin(sizerRowAdd, this.textAdd, 1, LEFT, border());
        }
        addSizer(sizerMiddle.sizer, sizerRowAdd, 0, EXPAND, border());

        const addSeveralButton = withString("&Insert a few strings", (ptr) =>
            createWxButton(sizerMiddle.box.ptr, LISTBOX_PAGE_ADD_SEVERAL, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(sizerMiddle.sizer, addSeveralButton, 0, EXPAND, border());

        const addManyButton = withString("Add &many strings", (ptr) =>
            createWxButton(sizerMiddle.box.ptr, LISTBOX_PAGE_ADD_MANY, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(sizerMiddle.sizer, addManyButton, 0, EXPAND, border());

        const sizerRowChange = createWxBoxSizer(HORIZONTAL)!;
        const changeButton = withString("C&hange current", (ptr) =>
            createWxButton(sizerMiddle.box.ptr, LISTBOX_PAGE_CHANGE, ptr,
                -1, -1, -1, -1, 0))!;
        this.textChange = withString("", (ptr) =>
            createWxTextCtrl(
                sizerMiddle.box.ptr, LISTBOX_PAGE_CHANGE_TEXT, ptr,
                -1, -1, -1, -1, BigInt(0)));
        addWin(sizerRowChange, changeButton, 0, RIGHT, border());
        if (this.textChange)
        {
            addWin(sizerRowChange, this.textChange, 1, LEFT, border());
        }
        addSizer(sizerMiddle.sizer, sizerRowChange, 0, EXPAND, border());

        const sizerRowVisible = createWxBoxSizer(HORIZONTAL)!;
        const ensureVisibleButton = withString("Make item &visible", (ptr) =>
            createWxButton(sizerMiddle.box.ptr, LISTBOX_PAGE_ENSURE_VISIBLE,
                ptr, -1, -1, -1, -1, 0))!;
        this.textEnsureVisible = withString("", (ptr) =>
            createWxTextCtrl(
                sizerMiddle.box.ptr, LISTBOX_PAGE_ENSURE_VISIBLE_TEXT, ptr,
                -1, -1, -1, -1, BigInt(0)));
        addWin(sizerRowVisible, ensureVisibleButton, 0, RIGHT, border());
        if (this.textEnsureVisible)
        {
            addWin(sizerRowVisible, this.textEnsureVisible, 1, LEFT, border());
        }
        addSizer(sizerMiddle.sizer, sizerRowVisible, 0, EXPAND, border());

        const sizerRowDelete = createWxBoxSizer(HORIZONTAL)!;
        const deleteButton = withString("&Delete this item", (ptr) =>
            createWxButton(sizerMiddle.box.ptr, LISTBOX_PAGE_DELETE, ptr,
                -1, -1, -1, -1, 0))!;
        this.textDelete = withString("", (ptr) =>
            createWxTextCtrl(
                sizerMiddle.box.ptr, LISTBOX_PAGE_DELETE_TEXT, ptr,
                -1, -1, -1, -1, BigInt(0)));
        addWin(sizerRowDelete, deleteButton, 0, RIGHT, border());
        if (this.textDelete)
        {
            addWin(sizerRowDelete, this.textDelete, 1, LEFT, border());
        }
        addSizer(sizerMiddle.sizer, sizerRowDelete, 0, EXPAND, border());

        const deleteSelButton = withString("Delete &selection", (ptr) =>
            createWxButton(sizerMiddle.box.ptr, LISTBOX_PAGE_DELETE_SEL, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(sizerMiddle.sizer, deleteSelButton, 0, EXPAND, border());

        const clearButton = withString("&Clear", (ptr) =>
            createWxButton(sizerMiddle.box.ptr, LISTBOX_PAGE_CLEAR, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(sizerMiddle.sizer, clearButton, 0, EXPAND, border());

        const moveUpButton = withString("Move item &up", (ptr) =>
            createWxButton(sizerMiddle.box.ptr, LISTBOX_PAGE_MOVE_UP, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(sizerMiddle.sizer, moveUpButton, 0, EXPAND, border());

        const moveDownButton = withString("Move item &down", (ptr) =>
            createWxButton(sizerMiddle.box.ptr, LISTBOX_PAGE_MOVE_DOWN, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(sizerMiddle.sizer, moveDownButton, 0, EXPAND, border());

        const topItemButton = withString("Get top item", (ptr) =>
            createWxButton(sizerMiddle.box.ptr, LISTBOX_PAGE_GET_TOP_ITEM, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(sizerMiddle.sizer, topItemButton, 0, EXPAND, border());

        const pageCountButton = withString("Get count per page", (ptr) =>
            createWxButton(sizerMiddle.box.ptr, LISTBOX_PAGE_GET_COUNT_PER_PAGE,
                ptr, -1, -1, -1, -1, 0))!;
        addWin(sizerMiddle.sizer, pageCountButton, 0, EXPAND, border());

        const testsButton = withString("Run &tests", (ptr) =>
            createWxButton(sizerMiddle.box.ptr, LISTBOX_PAGE_CONTAINER_TESTS,
                ptr, -1, -1, -1, -1, 0))!;
        addWin(sizerMiddle.sizer, testsButton, 0, EXPAND, border());

        // right pane
        const sizerRight = createWxBoxSizer(VERTICAL)!;
        // wxLB_HSCROLL is not exported; wx/defs.h defines it as wxHSCROLL.
        this.listbox = createWxListBox(
            this.page.ptr, LISTBOX_PAGE_LISTBOX, -1, -1, -1, -1, 0, null,
            HSCROLL);
        if (this.listbox)
        {
            addWin(sizerRight, this.listbox, 1, EXPAND, border());
        }
        sizerRight.SetMinSize(this.dip(150), 0);
        this.sizerLbox = sizerRight;

        // the 3 panes compose the window
        addSizer(sizerTop, sizerLeft.sizer, 0,
            EXPAND | (ALL & ~LEFT), doubleBorder());
        addSizer(sizerTop, sizerMiddle.sizer, 1, EXPAND | ALL, doubleBorder());
        addSizer(sizerTop, sizerRight, 1,
            EXPAND | (ALL & ~RIGHT), doubleBorder());

        // final initializations
        this.reset();

        this.page.SetSizer(sizerTop.ptr, false);

        if (this.listbox)
        {
            this.bindListboxEvents(this.listbox);
        }

        bindEvent(this.page, LISTBOX_PAGE_RESET, LISTBOX_PAGE_RESET,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.reset();
                this.createLbox();
            });

        bindEvent(this.page, LISTBOX_PAGE_CHANGE, LISTBOX_PAGE_CHANGE,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onButtonChange();
            });

        bindEvent(this.page, LISTBOX_PAGE_DELETE, LISTBOX_PAGE_DELETE,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onButtonDelete();
            });

        bindEvent(this.page, LISTBOX_PAGE_DELETE_SEL, LISTBOX_PAGE_DELETE_SEL,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onButtonDeleteSel();
            });

        bindEvent(this.page, LISTBOX_PAGE_ENSURE_VISIBLE,
            LISTBOX_PAGE_ENSURE_VISIBLE, EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onButtonEnsureVisible();
            });

        bindEvent(this.page, LISTBOX_PAGE_CLEAR, LISTBOX_PAGE_CLEAR,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.listbox?.Clear();
            });

        bindEvent(this.page, LISTBOX_PAGE_ADD, LISTBOX_PAGE_ADD,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onButtonAdd();
            });

        bindEvent(this.page, LISTBOX_PAGE_ADD_SEVERAL, LISTBOX_PAGE_ADD_SEVERAL,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onButtonAddSeveral();
            });

        bindEvent(this.page, LISTBOX_PAGE_ADD_MANY, LISTBOX_PAGE_ADD_MANY,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onButtonAddMany();
            });

        bindEvent(this.page, LISTBOX_PAGE_CONTAINER_TESTS,
            LISTBOX_PAGE_CONTAINER_TESTS, EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.runContainerTests();
            });

        bindEvent(this.page, LISTBOX_PAGE_GET_TOP_ITEM,
            LISTBOX_PAGE_GET_TOP_ITEM, EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                const item = this.listbox ? this.listbox.GetTopItem() : 0;
                logMessage(`Topmost visible item is: ${item}`);
            });

        bindEvent(this.page, LISTBOX_PAGE_GET_COUNT_PER_PAGE,
            LISTBOX_PAGE_GET_COUNT_PER_PAGE, EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                const count = this.listbox
                    ? this.listbox.GetCountPerPage() : 0;
                logMessage(`${count} items fit into this listbox.`);
            });

        bindEvent(this.page, LISTBOX_PAGE_MOVE_UP, LISTBOX_PAGE_MOVE_UP,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.rearrangeList?.MoveCurrentUp();
            });

        bindEvent(this.page, LISTBOX_PAGE_MOVE_DOWN, LISTBOX_PAGE_MOVE_DOWN,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.rearrangeList?.MoveCurrentDown();
            });

        // EVT_TEXT_ENTER handlers on the text controls.
        if (this.textAdd)
        {
            bindEvent(this.textAdd, LISTBOX_PAGE_ADD_TEXT,
                LISTBOX_PAGE_ADD_TEXT, EVT_TEXT_ENTER, (eventPtr) =>
                {
                    if (!eventPtr) return;
                    this.onButtonAdd();
                });
        }

        if (this.textDelete)
        {
            bindEvent(this.textDelete, LISTBOX_PAGE_DELETE_TEXT,
                LISTBOX_PAGE_DELETE_TEXT, EVT_TEXT_ENTER, (eventPtr) =>
                {
                    if (!eventPtr) return;
                    this.onButtonDelete();
                });
        }

        if (this.textEnsureVisible)
        {
            bindEvent(this.textEnsureVisible, LISTBOX_PAGE_ENSURE_VISIBLE_TEXT,
                LISTBOX_PAGE_ENSURE_VISIBLE_TEXT, EVT_TEXT_ENTER, (eventPtr) =>
                {
                    if (!eventPtr) return;
                    this.onButtonEnsureVisible();
                });
        }

        // EVT_CHECKBOX / EVT_RADIOBOX recreate the control.
        bindEvent(this.page, ID_ANY, ID_ANY, EVT_CHECKBOX, (eventPtr) =>
        {
            if (!eventPtr) return;
            this.createLbox();
        });

        bindEvent(this.page, ID_ANY, ID_ANY, EVT_RADIOBOX, (eventPtr) =>
        {
            if (!eventPtr) return;
            this.createLbox();
        });

        // EVT_UPDATE_UI handlers (the C++ event table entries).
        bindEvent(this.page, LISTBOX_PAGE_RESET, LISTBOX_PAGE_RESET,
            EVT_UPDATE_UI, (eventPtr) =>
            {
                if (!eventPtr) return;
                const event = new wxUpdateUIEvent(eventPtr, true);
                event.Enable(
                    (this.radioSelMode
                        ? this.radioSelMode.GetSelection()
                        : LBOX_SEL_SINGLE) !== LBOX_SEL_SINGLE
                    || (this.chkSort?.GetValue() ?? false)
                    || (this.chkOwnerDraw?.GetValue() ?? false)
                    || !(this.chkHScroll?.GetValue() ?? false)
                    || (this.chkVScroll?.GetValue() ?? false));
            });

        bindEvent(this.page, LISTBOX_PAGE_ADD_SEVERAL, LISTBOX_PAGE_ADD_SEVERAL,
            EVT_UPDATE_UI, (eventPtr) =>
            {
                if (!eventPtr) return;
                new wxUpdateUIEvent(eventPtr, true).Enable(!this.hasSortStyle());
            });

        bindEvent(this.page, LISTBOX_PAGE_CLEAR, LISTBOX_PAGE_CLEAR,
            EVT_UPDATE_UI, (eventPtr) =>
            {
                if (!eventPtr) return;
                new wxUpdateUIEvent(eventPtr, true)
                    .Enable(this.listboxCount() !== 0);
            });

        bindEvent(this.page, LISTBOX_PAGE_DELETE_TEXT,
            LISTBOX_PAGE_DELETE_TEXT, EVT_UPDATE_UI, (eventPtr) =>
            {
                if (!eventPtr) return;
                new wxUpdateUIEvent(eventPtr, true)
                    .Enable(this.listboxCount() !== 0);
            });

        bindEvent(this.page, LISTBOX_PAGE_DELETE, LISTBOX_PAGE_DELETE,
            EVT_UPDATE_UI, (eventPtr) =>
            {
                if (!eventPtr) return;
                new wxUpdateUIEvent(eventPtr, true)
                    .Enable(this.validIndex(this.textDelete, false) !== null);
            });

        bindEvent(this.page, LISTBOX_PAGE_CHANGE, LISTBOX_PAGE_CHANGE,
            EVT_UPDATE_UI, (eventPtr) =>
            {
                if (!eventPtr) return;
                new wxUpdateUIEvent(eventPtr, true)
                    .Enable(this.selectedIndexes().length !== 0);
            });

        bindEvent(this.page, LISTBOX_PAGE_CHANGE_TEXT, LISTBOX_PAGE_CHANGE_TEXT,
            EVT_UPDATE_UI, (eventPtr) =>
            {
                if (!eventPtr) return;
                new wxUpdateUIEvent(eventPtr, true)
                    .Enable(this.selectedIndexes().length !== 0);
            });

        bindEvent(this.page, LISTBOX_PAGE_DELETE_SEL, LISTBOX_PAGE_DELETE_SEL,
            EVT_UPDATE_UI, (eventPtr) =>
            {
                if (!eventPtr) return;
                new wxUpdateUIEvent(eventPtr, true)
                    .Enable(this.selectedIndexes().length !== 0);
            });

        bindEvent(this.page, LISTBOX_PAGE_ENSURE_VISIBLE,
            LISTBOX_PAGE_ENSURE_VISIBLE, EVT_UPDATE_UI, (eventPtr) =>
            {
                if (!eventPtr) return;
                new wxUpdateUIEvent(eventPtr, true).Enable(
                    this.validIndex(this.textEnsureVisible, false) !== null);
            });

        // EVT_UPDATE_UI_RANGE(ListboxPage_MoveUp, ListboxPage_MoveDown, ...)
        const updateMoveButtons = (eventPtr: Pointer): void =>
        {
            if (!eventPtr) return;
            const selection = this.radioListType
                ? this.radioListType.GetSelection() : -1;
            new wxUpdateUIEvent(eventPtr, true)
                .Enable(selection === LBOX_TYPE_REARRANGE_LIST);
        };

        bindEvent(this.page, LISTBOX_PAGE_MOVE_UP, LISTBOX_PAGE_MOVE_UP,
            EVT_UPDATE_UI, updateMoveButtons);
        bindEvent(this.page, LISTBOX_PAGE_MOVE_DOWN, LISTBOX_PAGE_MOVE_DOWN,
            EVT_UPDATE_UI, updateMoveButtons);
    }

    override recreateWidget(): void
    {
        this.createLbox();
    }

    /** Reset the listbox parameters. */
    private reset(): void
    {
        this.radioSelMode?.SetSelection(LBOX_SEL_SINGLE);
        this.radioListType?.SetSelection(LBOX_TYPE_LIST_BOX);
        this.chkVScroll?.SetValue(false);
        this.chkHScroll?.SetValue(true);
        this.chkSort?.SetValue(false);
        this.chkOwnerDraw?.SetValue(false);
    }

    private listboxCount(): number
    {
        return this.listbox ? this.listbox.GetCount() : 0;
    }

    /** True when the current listbox has the wxLB_SORT style. */
    private hasSortStyle(): boolean
    {
        const box = this.listbox;
        if (!box)
        {
            return false;
        }
        return (box.GetWindowStyle() & BigInt(LB_SORT)) !== 0n;
    }

    /** Indices of the selected items (wxListBox::GetSelections()). */
    private selectedIndexes(): number[]
    {
        const box = this.listbox;
        if (!box)
        {
            return [];
        }

        const capacity = box.GetCount();
        if (capacity === 0)
        {
            return [];
        }

        const buffer = new Int32Array(capacity);
        const count = box.GetSelections(pointerOf(buffer), capacity);
        if (count <= 0)
        {
            return [];
        }

        return Array.from(buffer.subarray(0, count));
    }

    /**
     * Read a listbox item index from the given control, returning null when it
     * is invalid.  The warning is only given when the value is really used.
     */
    private validIndex(control: wxTextCtrl | null, report = true): number | null
    {
        const text = readText(control);
        const index = parseUnsigned(text);
        const box = this.listbox;

        if (!box || index === null || index >= box.GetCount())
        {
            if (report)
            {
                logWarning(`Invalid index "${text}"`);
            }
            return null;
        }

        return index;
    }

    /** (Re)create the listbox. */
    private createLbox(): void
    {
        let flags = attrs.defaultFlags;
        switch (this.radioSelMode ? this.radioSelMode.GetSelection() : -1)
        {
            case LBOX_SEL_EXTENDED:
                flags |= LB_EXTENDED;
                break;

            case LBOX_SEL_MULTIPLE:
                flags |= LB_MULTIPLE;
                break;

            default:
                flags |= LB_SINGLE;
                break;
        }

        if (this.chkVScroll?.GetValue())
        {
            flags |= LB_ALWAYS_SB;
        }
        if (this.chkHScroll?.GetValue())
        {
            flags |= HSCROLL; // wxLB_HSCROLL == wxHSCROLL
        }
        if (this.chkSort?.GetValue())
        {
            flags |= LB_SORT;
        }
        if (this.chkOwnerDraw?.GetValue())
        {
            flags |= LB_OWNERDRAW;
        }

        const items: string[] = [];
        const order: number[] = [];
        const old = this.listbox;
        if (old)
        {
            const count = old.GetCount();
            for (let index = 0; index < count; index++)
            {
                const value = old.GetString(index);
                items.push(value ? readAndDeleteWxString(value.ptr) : "");

                // wxCheckListBox::IsChecked() has to be queried before the old
                // control is destroyed.
                const checked = this.checkListBox
                    ? this.checkListBox.IsChecked(index) : false;
                order.push(checked ? index : ~index);
            }

            this.sizerLbox?.DetachWindow(old.ptr);
            old.Destroy();
            this.listbox = null;
            this.checkListBox = null;
            this.rearrangeList = null;
        }

        const listType = this.radioListType
            ? this.radioListType.GetSelection() : LBOX_TYPE_LIST_BOX;

        let control: wxListBox | null = null;

        if (listType === LBOX_TYPE_CHECK_LIST_BOX)
        {
            const built = charPtrArray(items);
            const checkList = createWxCheckListBox(
                this.page.ptr, LISTBOX_PAGE_LISTBOX, -1, -1, -1, -1,
                items.length, built.ptr, flags);
            void built.keep;

            if (checkList)
            {
                for (let index = 0; index < order.length; index++)
                {
                    checkList.Check(index, order[index] >= 0);
                }
                this.checkListBox = checkList;
            }
            control = checkList;
        }
        else if (listType === LBOX_TYPE_REARRANGE_LIST)
        {
            const arrayOrder: wxArrayInt | null = createWxArrayInt();
            const arrayItems: wxArrayString | null = createWxArrayString();
            if (arrayOrder && arrayItems)
            {
                for (const value of order)
                {
                    arrayOrder.Add(value);
                }
                for (const item of items)
                {
                    withString(item, (ptr) => arrayItems.Add(ptr));
                }

                const rearrange = createWxRearrangeList(
                    this.page.ptr, LISTBOX_PAGE_LISTBOX, -1, -1, -1, -1,
                    arrayOrder.ptr, arrayItems.ptr, flags);
                if (rearrange)
                {
                    this.rearrangeList = rearrange;
                    control = rearrange;
                }
            }

            arrayOrder?.Delete();
            arrayItems?.Delete();
        }
        else
        {
            const built = charPtrArray(items);
            control = createWxListBox(
                this.page.ptr, LISTBOX_PAGE_LISTBOX, -1, -1, -1, -1,
                items.length, built.ptr, flags);
            void built.keep;
        }

        this.listbox = control;
        if (!control)
        {
            return;
        }

        this.notifyWidgetRecreation(control);
        this.bindListboxEvents(control);

        if (this.sizerLbox)
        {
            addWin(this.sizerLbox, control, 1, EXPAND, border());
            this.sizerLbox.Layout();
        }
    }

    /** Event table entries for wxListBox / wxCheckListBox / wxRearrangeList. */
    private bindListboxEvents(control: wxListBox): void
    {
        bindEvent(control, LISTBOX_PAGE_LISTBOX, LISTBOX_PAGE_LISTBOX,
            EVT_LISTBOX, (eventPtr) =>
            {
                if (!eventPtr) return;
                const event = new wxCommandEvent(eventPtr, true);
                const selection = event.GetSelection();
                writeText(this.textDelete, String(selection));

                if (event.IsSelection())
                {
                    logMessage(`Listbox item ${selection} selected`);
                }
                else
                {
                    logMessage(`Listbox item ${selection} deselected`);
                }
            });

        bindEvent(control, LISTBOX_PAGE_LISTBOX, LISTBOX_PAGE_LISTBOX,
            EVT_LISTBOX_DCLICK, (eventPtr) =>
            {
                if (!eventPtr) return;
                const item = new wxCommandEvent(eventPtr, true).GetInt();
                logMessage(`Listbox item ${item} double clicked`);
            });

        bindEvent(control, LISTBOX_PAGE_LISTBOX, LISTBOX_PAGE_LISTBOX,
            EVT_CHECKLISTBOX, (eventPtr) =>
            {
                if (!eventPtr) return;
                const item = new wxCommandEvent(eventPtr, true).GetInt();
                logMessage(`Listbox item ${item} toggled`);
            });
    }

    /** OnButtonChange() */
    private onButtonChange(): void
    {
        const selections = this.selectedIndexes();
        const box = this.listbox;
        withString(readText(this.textChange), (ptr) =>
        {
            for (const index of selections)
            {
                box?.SetString(index, ptr);
            }
        });
    }

    /** OnButtonEnsureVisible() */
    private onButtonEnsureVisible(): void
    {
        const index = this.validIndex(this.textEnsureVisible);
        if (index === null)
        {
            return;
        }
        this.listbox?.EnsureVisible(index);
    }

    /** OnButtonDelete() */
    private onButtonDelete(): void
    {
        const index = this.validIndex(this.textDelete);
        if (index === null)
        {
            return;
        }
        this.listbox?.DeleteItem(index);
    }

    /** OnButtonDeleteSel() */
    private onButtonDeleteSel(): void
    {
        const selections = this.selectedIndexes();
        for (let index = selections.length; index > 0; --index)
        {
            this.listbox?.DeleteItem(selections[index - 1]);
        }
    }

    /** OnButtonAdd() */
    private onButtonAdd(): void
    {
        const textAdd = this.textAdd;
        if (!textAdd)
        {
            return;
        }

        const item = readText(textAdd);
        if (!textAdd.IsModified())
        {
            // update the default string
            newItemCounter += 1;
            writeText(textAdd, `test item \t${newItemCounter}`);
        }

        const box = this.listbox;
        withString(item, (ptr) =>
        {
            box?.Append(ptr);
        });
    }

    /** OnButtonAddMany() */
    private onButtonAddMany(): void
    {
        // "many" means 1000 here
        for (let index = 0; index < 1000; index++)
        {
            const box = this.listbox;
            withString(`item #${index}`, (ptr) =>
            {
                box?.Append(ptr);
            });
        }
    }

    /** OnButtonAddSeveral() */
    private onButtonAddSeveral(): void
    {
        const items = [
            "First",
            "another one",
            "and the last (very very very very very very very very very very long) one",
        ];
        const built = charPtrArray(items);
        this.listbox?.InsertItems(built.ptr, 0, items.length);
        void built.keep;
    }

    /** "Run tests": ItemContainerWidgetsPage::OnButtonTestItemContainer() */
    private runContainerTests(): void
    {
        const box = this.listbox;
        if (!box)
        {
            return;
        }
        runItemContainerTest(
            new wxItemContainer(box.ptr, true), wrapWxWindow(box.ptr));
    }
}

export function createListboxPage(parent: Pointer): WidgetsPage
{
    return new ListboxPage(parent);
}
