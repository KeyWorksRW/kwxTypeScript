declare const __dirname: string;

function assetPath(name: string): string
{
    return __dirname.replace(/\\/g, "/") + "/" + name;
}

//-----------------------------------------------------------------------------
// Frame state
//-----------------------------------------------------------------------------

interface FrameState
{
    frame: wxFrame;
    menuBar: wxMenuBar;
    canvas: wxScrolledWindow;
    infoBarSimple: wxInfoBar;
    infoBarAdvanced: wxInfoBar;
    confirmExit: boolean;
    colourData: wxColourData | null;
    settings: SettingsData;
    findData: wxFindReplaceData | null;
    dlgFind: wxFindReplaceDialog | null;
    dlgReplace: wxFindReplaceDialog | null;
    tipWindowRef: BigUint64Array | null;
    modalHook: wxModalDialogHook | null;
}

let state: FrameState | null = null;

let infoBarCount = 0;
let infoBarDontShowAgain = false;

// wxFileDialog customize-hook state (must survive between the callbacks).
const customizerCallbacks: Callback[] = [];
const customizerRouters: EventRouter[] = [];
const modalHookCallbacks: Callback[] = [];
let hookText: wxFileDialogCustomControl | null = null;
let hookChoiceSize: wxFileDialogCustomControl | null = null;
let hookRadioPortrait: wxFileDialogCustomControl | null = null;
let hookRadioLandscape: wxFileDialogCustomControl | null = null;
let hookCheckBox: wxFileDialogCustomControl | null = null;
let hookButton: wxFileDialogCustomControl | null = null;
let hookLabel: wxFileDialogCustomControl | null = null;
let hookInfo = "";

let encryptCheckBox: wxFileDialogCustomControl | null = null;
let encryptValue = false;

let fileOpen2Extension = "";
let tipIndex = -1;

/** MSW system-menu command ids must be multiples of 16 (see dialogs.cpp). */
const DIALOGS_SYSTEM_ABOUT = 0x4010;

const DEFAULT_WILDCARD = readWxString(FileSelectorDefaultWildcardStr);
const PROGRESS_MAX = 100;
/** Capacity of the char** buffers filled by TArrayStringOutVoid getters. */
const MAX_SELECTED_PATHS = 1024;

//-----------------------------------------------------------------------------
// Menu helpers
//-----------------------------------------------------------------------------

function newMenu(): wxMenu
{
    // wxMenu_Create expects a real wxString*; a null title crashes natively.
    return withString("", (ptr) => createWxMenu(ptr, 0n))!;
}

function menuAppend(menu: wxMenu, id: number, label: string): void
{
    withString(label, (ptr) => menu.Append(id, ptr, null, false));
}

function menuAppendCheck(menu: wxMenu, id: number, label: string): void
{
    withString(label, (ptr) => menu.AppendCheckItem(id, ptr, null));
}

function menuAppendRadio(
    menu: wxMenu, id: number, label: string, help: string | null): void
{
    if (help === null)
    {
        withString(label, (ptr) => menu.AppendRadioItem(id, ptr, null));
    }
    else
    {
        withStrings([label, help], (ptrs) =>
            menu.AppendRadioItem(id, ptrs[0], ptrs[1]));
    }
}

function menuAppendSub(menu: wxMenu, id: number, label: string, sub: wxMenu): void
{
    withString(label, (ptr) => menu.AppendSub(id, ptr, sub.ptr, null));
}

function menuAppendSubMenu(menu: wxMenu, label: string, sub: wxMenu): void
{
    // wxMenu_AppendSubMenu dereferences its help argument, so pass "" (the
    // C++ default) rather than null.
    withStrings([label, ""],
        (ptrs) => menu.AppendSubMenu(sub.ptr, ptrs[0], ptrs[1]));
}

//-----------------------------------------------------------------------------
// Generic helpers
//-----------------------------------------------------------------------------

function homeDir(): string
{
    return takeText(wxGetHomeDir());
}

function positionOf(window: wxWindow): { x: number; y: number }
{
    const point = window.GetPosition();
    if (!point) return { x: -1, y: -1 };
    return { x: point.GetX(), y: point.GetY() };
}

function sizeOf(window: wxWindow): { w: number; h: number }
{
    const size = window.GetSize();
    if (!size) return { w: -1, h: -1 };
    return { w: size.GetWidth(), h: size.GetHeight() };
}

function isCheckedOption(id: number): boolean
{
    const current = state;
    return current ? current.menuBar.IsChecked(id) : false;
}

function messageBox(
    message: string, caption: string, style: number, parent: Pointer): number
{
    return withStrings([message, caption], (ptrs) =>
        kwxMessageBox(ptrs[0], ptrs[1], style, parent, -1, -1));
}

/**
 * wxGetTextFromUser's size overload is not exported, so use the same
 * wxTextEntryDialog the free function creates. wxTextEntryDialogStyle is
 * wxOK | wxCANCEL | wxCENTRE, and an explicit position wins over centring.
 */
function getTextFromUser(
    message: string, caption: string, defaultValue: string,
    parent: Pointer, x: number, y: number, centre: boolean,
    width: number = -1, height: number = -1): string
{
    let style = OK | CANCEL | CENTRE;
    if (!centre || x !== -1 || y !== -1) style &= ~CENTRE;

    const dialog = withStrings([message, caption, defaultValue], (ptrs) =>
        createWxTextEntryDialog(parent, ptrs[0], ptrs[1], ptrs[2],
            BigInt(style), x, y, width, height));
    if (!dialog) return "";

    let value = "";
    if (dialog.ShowModal() === ID_OK) value = takeText(dialog.GetValue());
    dialog.Destroy();
    return value;
}

function getPasswordFromUser(
    message: string, caption: string, defaultValue: string, parent: Pointer): string
{
    const messageBuffer = new TextEncoder().encode(message + "\0");
    const captionBuffer = new TextEncoder().encode(caption + "\0");
    const defaultBuffer = new TextEncoder().encode(defaultValue + "\0");

    const messagePtr = pointerOf(messageBuffer);
    const captionPtr = pointerOf(captionBuffer);
    const defaultPtr = pointerOf(defaultBuffer);

    const length = wxGetPasswordFromUser(
        messagePtr, captionPtr, defaultPtr, parent, null);
    if (length <= 0) return "";

    const output = new Uint8Array(length + 1);
    const outputPtr = pointerOf(output);
    wxGetPasswordFromUser(messagePtr, captionPtr, defaultPtr, parent, outputPtr);
    return readCString(outputPtr);
}

function getEnv(name: string): string | null
{
    const variable = createWxString(name);
    const value = createWxString("");
    const found = wxGetEnv(variable.ptr, value.ptr);
    let result: string | null = null;
    if (found)
    {
        const buffer = new Uint8Array(4096);
        const bufferPtr = pointerOf(buffer);
        value.GetString(bufferPtr);
        result = readCString(bufferPtr);
    }
    value.Delete();
    variable.Delete();
    return result;
}

//-----------------------------------------------------------------------------
// Menu bar construction
//-----------------------------------------------------------------------------

function buildMenuBar(): wxMenuBar
{
    const menuDlg = newMenu();

    menuAppend(menuDlg, DIALOGS_MESSAGE_BOX, "&Message box\tCtrl-M");
    menuAppend(menuDlg, DIALOGS_MESSAGE_BOX_WINDOW_MODAL, "Window-Modal Message box ");
    menuAppend(menuDlg, DIALOGS_MESSAGE_DIALOG, "Message dialog\tShift-Ctrl-M");
    menuAppend(menuDlg, DIALOGS_MESSAGE_DIALOG_WINDOW_MODAL, "Window-Modal Message dialog");
    menuAppend(menuDlg, DIALOGS_RICH_MESSAGE_DIALOG, "Rich message dialog");

    const choicesMenu = newMenu();
    const colourMenu = newMenu();
    menuAppend(colourMenu, DIALOGS_CHOOSE_COLOUR, "&No opacity");
    menuAppend(colourMenu, DIALOGS_CHOOSE_COLOUR_ALPHA, "&With opacity");
    menuAppendSub(choicesMenu, ID_ANY, "&Choose bg colour", colourMenu);
    menuAppend(choicesMenu, DIALOGS_GET_COLOUR, "&Choose fg colour");
    menuAppend(choicesMenu, DIALOGS_CHOOSE_FONT, "Choose &font\tShift-Ctrl-J");
    menuAppend(choicesMenu, DIALOGS_SINGLE_CHOICE, "&Single choice\tCtrl-C");
    menuAppend(choicesMenu, DIALOGS_SINGLE_CHOICE_DATA, "Single choice with &data");
    menuAppend(choicesMenu, DIALOGS_MULTI_CHOICE, "M&ultiple choice\tCtrl-U");
    menuAppend(choicesMenu, DIALOGS_REARRANGE, "&Rearrange dialog\tCtrl-R");
    menuAppend(choicesMenu, DIALOGS_ADDREMOVE, "&Add/remove items control\tCtrl-A");
    choicesMenu.AppendSeparator();
    const genericColourMenu = newMenu();
    menuAppend(genericColourMenu, DIALOGS_CHOOSE_COLOUR_GENERIC, "&No opacity");
    menuAppend(genericColourMenu, DIALOGS_CHOOSE_COLOUR_GENERIC_ALPHA, "&With opacity");
    menuAppendSub(choicesMenu, ID_ANY, "&Choose colour (generic)", genericColourMenu);
    menuAppend(choicesMenu, DIALOGS_CHOOSE_FONT_GENERIC, "Choose &font (generic)");
    menuAppendSub(menuDlg, ID_ANY, "&Choices and selectors", choicesMenu);

    const entryMenu = newMenu();
    menuAppend(entryMenu, DIALOGS_LINE_ENTRY, "Single line &entry\tCtrl-E");
    menuAppend(entryMenu, DIALOGS_TEXT_ENTRY, "Multi line text &entry\tShift-Ctrl-E");
    menuAppend(entryMenu, DIALOGS_PASSWORD_ENTRY, "&Password entry\tCtrl-P");
    menuAppend(entryMenu, DIALOGS_CREDENTIAL_ENTRY, "&Credential entry\tShift-Ctrl-C");
    menuAppend(entryMenu, DIALOGS_NUM_ENTRY, "&Numeric entry\tCtrl-N");
    menuAppendSub(menuDlg, ID_ANY, "&Entry dialogs", entryMenu);

    const fileMenu = newMenu();
    menuAppend(fileMenu, DIALOGS_FILE_OPEN, "&Open file\tCtrl-O");
    menuAppend(fileMenu, DIALOGS_FILE_OPEN2, "&Second open file\tCtrl-2");
    menuAppend(fileMenu, DIALOGS_FILES_OPEN, "Open &files\tShift-Ctrl-O");
    menuAppend(fileMenu, DIALOGS_FILES_OPEN_WINDOW_MODAL, "Window-Modal Open files");
    menuAppend(fileMenu, DIALOGS_FILE_SAVE, "Sa&ve file\tCtrl-S");
    menuAppend(fileMenu, DIALOGS_FILE_SAVE_WINDOW_MODAL, "Window-Modal Save file");
    fileMenu.AppendSeparator();
    menuAppend(fileMenu, DIALOGS_FILE_OPEN_GENERIC, "&Open file (generic)");
    menuAppend(fileMenu, DIALOGS_FILES_OPEN_GENERIC, "Open &files (generic)");
    menuAppend(fileMenu, DIALOGS_FILE_SAVE_GENERIC, "Sa&ve file (generic)");
    fileMenu.AppendSeparator();
    menuAppendRadio(fileMenu, DIALOGS_FILE_USE_CUSTOMIZER,
        "Use new customization API",
        "Use wxFileDialog::SetCustomizeHook() for file dialog customization");
    menuAppendRadio(fileMenu, DIALOGS_FILE_USE_EXTRA_CONTROL_CREATOR,
        "Use old customization API",
        "Use wxFileDialog::SetExtraControlCreator() for file dialog customization");
    if (platform === "darwin")
    {
        fileMenu.AppendSeparator();
        menuAppendCheck(fileMenu, DIALOGS_MAC_TOGGLE_ALWAYS_SHOW_TYPES,
            "macOS only: Toggle open file \"Always show types\"\tRawCtrl+Ctrl+S");
    }
    menuAppendSub(menuDlg, ID_ANY, "&File operations", fileMenu);

    const dirMenu = newMenu();
    menuAppend(dirMenu, DIALOGS_DIR_CHOOSE, "&Choose a directory\tCtrl-D");
    menuAppend(dirMenu, DIALOGS_DIR_CHOOSE_WINDOW_MODAL, "Choose a directory window-modally");
    menuAppend(dirMenu, DIALOGS_DIRNEW_CHOOSE,
        "Choose a directory (with \"Ne&w\" button)\tShift-Ctrl-D");
    menuAppend(dirMenu, DIALOGS_DIRMULTIPLE_CHOOSE,
        "Choose multiple and hidden directories\tAlt-Ctrl-D");
    menuAppendSub(menuDlg, ID_ANY, "&Directory operations", dirMenu);
    dirMenu.AppendSeparator();
    menuAppend(dirMenu, DIALOGS_GENERIC_DIR_CHOOSE, "&Choose a directory (generic)");

    const infoMenu = newMenu();
    menuAppend(infoMenu, DIALOGS_TIP, "&Tip of the day\tCtrl-T");
    menuAppend(infoMenu, DIALOGS_PROGRESS, "Pro&gress dialog\tCtrl-G");
    menuAppend(infoMenu, DIALOGS_PROGRESS_GENERIC, "Generic progress dialog\tCtrl-Alt-G");
    menuAppend(infoMenu, DIALOGS_APP_PROGRESS, "&App progress\tShift-Ctrl-G");
    menuAppend(infoMenu, DIALOGS_BUSYINFO, "&Busy info dialog\tCtrl-B");
    menuAppend(infoMenu, DIALOGS_BUSYINFO_RICH, "&Rich busy info dialog\tShift-Ctrl-B");
    menuAppend(infoMenu, DIALOGS_LOG_DIALOG, "&Log dialog\tCtrl-L");
    menuAppend(infoMenu, DIALOGS_INFOBAR_SIMPLE, "Simple &info bar\tCtrl-I");
    menuAppend(infoMenu, DIALOGS_INFOBAR_ADVANCED, "&Advanced info bar\tShift-Ctrl-I");
    menuAppend(infoMenu, DIALOGS_MESSAGE_BOX_WXINFO, "&wxWidgets information\tCtrl-W");
    menuAppendSub(menuDlg, ID_ANY, "&Informative dialogs", infoMenu);

    const findMenu = newMenu();
    menuAppendCheck(findMenu, DIALOGS_FIND, "&Find dialog\tCtrl-F");
    menuAppendCheck(findMenu, DIALOGS_REPLACE, "Find and &replace dialog\tShift-Ctrl-F");
    menuAppendSub(menuDlg, ID_ANY, "&Searching", findMenu);

    const dialogsMenu = newMenu();
    menuAppend(dialogsMenu, DIALOGS_MODAL, "&Modal dialog\tShift-Ctrl-W");
    menuAppendCheck(dialogsMenu, DIALOGS_MODELESS, "Mode&less dialog\tShift-Ctrl-Z");
    menuAppend(dialogsMenu, DIALOGS_CENTRE_SCREEN, "Centered on &screen\tShift-Ctrl-1");
    menuAppend(dialogsMenu, DIALOGS_CENTRE_PARENT, "Centered on &parent\tShift-Ctrl-2");
    menuAppend(dialogsMenu, DIALOGS_MINIFRAME, "&Mini frame");
    menuAppend(dialogsMenu, DIALOGS_ONTOP, "Dialog staying on &top");
    menuAppendSub(menuDlg, ID_ANY, "&Generic dialogs", dialogsMenu);

    const sheetMenu = newMenu();
    menuAppend(sheetMenu, DIALOGS_PROPERTY_SHEET, "&Standard property sheet\tShift-Ctrl-P");
    menuAppend(sheetMenu, DIALOGS_PROPERTY_SHEET_TOOLBOOK, "&Toolbook sheet\tShift-Ctrl-T");
    if (platform === "darwin")
    {
        menuAppend(sheetMenu, DIALOGS_PROPERTY_SHEET_BUTTONTOOLBOOK,
            "Button &Toolbook sheet\tShift-Ctrl-U");
    }
    menuAppendSub(menuDlg, ID_ANY, "&Property sheets", sheetMenu);

    const notifMenu = newMenu();
    menuAppend(notifMenu, DIALOGS_REQUEST, "&Request user attention\tCtrl-Shift-R");
    notifMenu.AppendSeparator();
    menuAppend(notifMenu, DIALOGS_NOTIFY_MSG, "User &Notification\tCtrl-Shift-N");
    menuAppendSubMenu(menuDlg, "&User notifications", notifMenu);

    menuAppendCheck(menuDlg, DIALOGS_SHOW_TIP, "Show &tip window\tShift-Ctrl-H");
    menuAppend(menuDlg, DIALOGS_RICHTIP_DIALOG, "Rich &tooltip dialog...\tCtrl-H");
    menuDlg.AppendSeparator();
    menuAppend(menuDlg, DIALOGS_STANDARD_BUTTON_SIZER_DIALOG,
        "&Standard Buttons Sizer Dialog");
    menuAppend(menuDlg, DIALOGS_TEST_DEFAULT_ACTION, "&Test dialog default action");
    menuAppendCheck(menuDlg, DIALOGS_MODAL_HOOK, "Enable modal dialog hook");
    menuAppendCheck(menuDlg, DIALOGS_SIMULATE_UNSAVED,
        "Simulate an unsaved document at exit");
    menuAppendCheck(menuDlg, DIALOGS_USE_WRAPPER_FUNCTIONS,
        "Use wrapper functions for dialogs");
    menuDlg.AppendSeparator();
    menuAppend(menuDlg, ID_EXIT, "E&xit\tAlt-X");

    const editMenu = newMenu();
    menuAppend(editMenu, ID_UNDO, "&Undo\tCtrl+Z");
    menuAppend(editMenu, ID_REDO, "&Redo\tCtrl+Y");
    editMenu.AppendSeparator();
    menuAppend(editMenu, ID_CUT, "Cu&t\tCtrl+X");
    menuAppend(editMenu, ID_COPY, "&Copy\tCtrl+C");
    menuAppend(editMenu, ID_PASTE, "&Paste\tCtrl+V");
    menuAppend(editMenu, ID_CLEAR, "&Delete");
    editMenu.AppendSeparator();
    menuAppend(editMenu, ID_SELECTALL, "Select All\tCtrl+A");

    const helpMenu = newMenu();
    menuAppend(helpMenu, DIALOGS_ABOUTDLG_SIMPLE, "&About (simple)...\tF1");
    menuAppend(helpMenu, DIALOGS_ABOUTDLG_FANCY, "About (&fancy)...\tShift-F1");
    menuAppend(helpMenu, DIALOGS_ABOUTDLG_FULL, "About (f&ull)...\tCtrl-F1");
    menuAppend(helpMenu, DIALOGS_ABOUTDLG_CUSTOM, "About (&custom)...\tCtrl-Shift-F1");

    const menuBar = createWxMenuBar(0)!;
    withStrings(["&Dialogs", "&Edit", "&Help"], (ptrs) =>
    {
        menuBar.Append(menuDlg.ptr, ptrs[0]);
        menuBar.Append(editMenu.ptr, ptrs[1]);
        menuBar.Append(helpMenu.ptr, ptrs[2]);
    });
    return menuBar;
}

//-----------------------------------------------------------------------------
// Colours
//-----------------------------------------------------------------------------

function applyColour(colour: Pointer): void
{
    const current = state;
    if (!current) return;

    const background = backgroundColour(current.canvas);
    if (background)
    {
        const same = coloursEqual(colour, background.ptr);
        background.Delete();
        if (same) return;
    }

    current.canvas.SetBackgroundColour(colour);
    current.canvas.Refresh(true);
}

function chooseColour(alpha: boolean): void
{
    const current = state;
    if (!current || !current.colourData) return;
    const data = current.colourData;

    const background = backgroundColour(current.canvas);
    if (background)
    {
        data.SetColour(background.ptr);
        background.Delete();
    }
    data.SetChooseAlpha(alpha);

    const dialog = createWxColourDialog(current.frame.ptr, data.ptr);
    if (!dialog) return;
    withString("Please choose the background colour", (text) => dialog.SetTitle(text));

    // The dialog is connected once with a router shared by every colour dialog.
    colourEvents().connect(dialog.ptr, ID_ANY, ID_ANY, EVT_COLOUR_CHANGED);

    if (dialog.ShowModal() === ID_OK)
    {
        dialog.GetColourData(data.ptr);
    }

    const chosen = createWxColourEmpty();
    if (chosen)
    {
        data.GetColour(chosen.ptr);
        applyColour(chosen.ptr);
        chosen.Delete();
    }
    dialog.Destroy();
}

/**
 * wxGetColourFromUser() without the caption parameter: same body as the
 * wxWidgets function, using a persistent wxColourData for the custom colours.
 */
let userColourData: wxColourData | null = null;
let userColourDataUsed = false;

function getColourFromUser(
    parent: Pointer, initial: Pointer, caption: string): wxColour | null
{
    if (!userColourData) userColourData = createWxColourData();
    const data = userColourData;
    if (!data) return null;

    if (userColourDataUsed && platform === "windows") data.SetChooseFull(true);
    if (initial) data.SetColour(initial);

    const dialog = createWxColourDialog(parent, data.ptr);
    if (!dialog) return null;
    withString(caption, (ptr) => dialog.SetTitle(ptr));

    let result: wxColour | null = null;
    if (dialog.ShowModal() === ID_OK)
    {
        dialog.GetColourData(data.ptr);
        result = createWxColourEmpty();
        if (result) data.GetColour(result.ptr);
    }
    dialog.Destroy();
    userColourDataUsed = true;
    return result;
}

function getColour(): void
{
    const current = state;
    if (!current) return;

    const initial = foregroundColour(current.canvas);
    const result = getColourFromUser(current.frame.ptr,
        initial ? initial.ptr : null, "Please choose the foreground colour");
    if (initial) initial.Delete();

    if (result)
    {
        if (result.IsOk())
        {
            current.canvas.SetForegroundColour(result.ptr);
            current.canvas.Refresh(true);
        }
        result.Delete();
    }
}

function chooseColourGeneric(alpha: boolean): void
{
    const current = state;
    if (!current || !current.colourData) return;
    const data = current.colourData;

    const background = backgroundColour(current.canvas);
    if (background)
    {
        data.SetColour(background.ptr);
        background.Delete();
    }
    data.SetChooseFull(true);
    data.SetChooseAlpha(alpha);

    const count = ColourData_NUM_CUSTOM;
    for (let i = 0; i < count; i++)
    {
        const level = i * Math.floor(256 / count);
        const colour = createWxColourRGB(level, level, level, 255);
        if (colour)
        {
            data.SetCustomColour(i, colour.ptr);
            colour.Delete();
        }
    }

    const dialog = createWxGenericColourDialog(current.frame.ptr, data.ptr);
    if (!dialog) return;

    if (dialog.ShowModal() === ID_OK)
    {
        dialog.GetColourData(data.ptr);
        const chosen = createWxColourEmpty();
        if (chosen)
        {
            data.GetColour(chosen.ptr);
            current.canvas.SetBackgroundColour(chosen.ptr);
            current.canvas.Refresh(true);
            chosen.Delete();
        }
    }
    dialog.Destroy();
}

//-----------------------------------------------------------------------------
// Fonts
//-----------------------------------------------------------------------------

function chooseFont(generic: boolean): void
{
    const current = state;
    if (!current) return;

    const data = createWxFontData();
    if (!data) return;

    const initialFont = createWxFontDefault();
    if (initialFont)
    {
        current.canvas.GetFont(initialFont.ptr);
        data.SetInitialFont(initialFont.ptr);
        initialFont.Delete();
    }

    const fg = foregroundColour(current.canvas);
    if (fg)
    {
        data.SetColour(fg.ptr);
        fg.Delete();
    }

    const dialog = generic
        ? createWxGenericFontDialog(current.frame.ptr, data.ptr)
        : createWxFontDialog(current.frame.ptr, data.ptr);

    if (dialog && dialog.ShowModal() === ID_OK)
    {
        dialog.GetFontData(data.ptr);

        const chosen = createWxFontDefault();
        if (chosen)
        {
            data.GetChosenFont(chosen.ptr);
            current.canvas.SetFont(chosen.ptr);
            chosen.Delete();
        }

        const colour = createWxColourEmpty();
        if (colour)
        {
            data.GetColour(colour.ptr);
            current.canvas.SetForegroundColour(colour.ptr);
            colour.Delete();
        }
        current.canvas.Refresh(true);
    }

    if (dialog) dialog.Destroy();
    data.Delete();
}

//-----------------------------------------------------------------------------
// Choice dialogs
//-----------------------------------------------------------------------------

function choicePosition(): { x: number; y: number }
{
    const current = state;
    if (!current) return { x: 50, y: 50 };
    const position = positionOf(current.frame);
    return { x: position.x + 50, y: position.y + 50 };
}

function singleChoice(): void
{
    const current = state;
    if (!current) return;

    const choices = ["One", "Two", "Three", "Four", "Five"];

    if (isCheckedOption(DIALOGS_USE_WRAPPER_FUNCTIONS))
    {
        const array = createArrayString(choices);
        if (!array) return;
        const position = choicePosition();
        const index = withStrings([
            "This is a small sample\nA single-choice convenience dialog",
            "Please select a value",
        ], (ptrs) => wxGetSingleChoiceIndexEx(
            ptrs[0], ptrs[1], choices.length, array.ptr,
            current.frame.ptr, position.x, position.y, true, 500, 400, 2));
        array.Delete();

        if (index !== -1)
        {
            withString(`You selected "${choices[index]}"`, (ptr) => LogMessage(ptr));
        }
        return;
    }

    const array = createArrayString(choices);
    if (!array) return;
    const dialog = withStrings([
        "This is a small sample\nA single-choice convenience dialog",
        "Please select a value",
    ], (ptrs) => createWxSingleChoiceDialog(
        current.frame.ptr, ptrs[0], ptrs[1], array.ptr, CHOICEDLG_STYLE));
    array.Delete();
    if (!dialog) return;

    dialog.SetSelection(2);
    if (dialog.ShowModal() === ID_OK)
    {
        const value = takeText(dialog.GetStringSelection());
        withStrings([value, "Got string"], (ptrs) =>
        {
            const second = createWxMessageDialog(
                current.frame.ptr, ptrs[0], ptrs[1], OK | CENTRE);
            if (!second) return;
            second.ShowModal();
            second.Destroy();
        });
    }
    dialog.Destroy();
}

function singleChoiceData(): void
{
    const current = state;
    if (!current) return;

    const choices = ["One", "Two", "Three", "Four", "Five"];
    const values = new Int32Array([1, 2, 3, 4, 5]);
    const base = pointerOf(values) as bigint;

    const clientData = new BigUint64Array(values.length);
    for (let i = 0; i < values.length; i++)
    {
        clientData[i] = base + BigInt(i * 4);
    }

    const array = createArrayString(choices);
    if (!array) return;
    const position = choicePosition();
    const clientDataPtr = pointerOf(clientData);

    const result = withStrings([
        "This is a small sample\nA single-choice convenience dialog\n" +
        "using an explicit position and size",
        "Please select a value",
    ], (ptrs) => wxGetSingleChoiceDataEx(
        ptrs[0], ptrs[1], choices.length, array.ptr, clientDataPtr,
        current.frame.ptr, position.x, position.y, true, 500, 400, 2));
    array.Delete();

    if (result === null) return;

    let index = -1;
    for (let i = 0; i < values.length; i++)
    {
        if (clientData[i] === (result as bigint)) index = i;
    }
    if (index < 0) return;

    withString(`You selected "${choices[index]}" (${values[index]})`,
        (ptr) => LogMessage(ptr));
}

function multiChoice(): void
{
    const current = state;
    if (!current) return;

    const choices = [
        "One", "Two", "Three", "Four", "Five",
        "Six", "Seven", "Eight", "Nine", "Ten",
        "Eleven", "Twelve", "Seventeen",
    ];

    const selections = createWxArrayInt();
    const array = createArrayString(choices);
    if (!selections || !array)
    {
        if (selections) selections.Delete();
        if (array) array.Delete();
        return;
    }

    let count: number;

    if (isCheckedOption(DIALOGS_USE_WRAPPER_FUNCTIONS))
    {
        const position = choicePosition();
        count = withStrings([
            "This is a small sample\nA multi-choice convenience dialog",
            "Please select a value",
        ], (ptrs) => wxGetSelectedChoicesEx(
            selections.ptr, ptrs[0], ptrs[1], choices.length, array.ptr,
            current.frame.ptr, position.x, position.y, true, 500, 400));
        array.Delete();
    }
    else
    {
        const dialog = withStrings([
            "This is a small sample\nA multi-choice convenience dialog",
            "Please select a value",
        ], (ptrs) => createWxMultiChoiceDialog(
            current.frame.ptr, ptrs[0], ptrs[1], choices.length, array.ptr,
            BigInt(CHOICEDLG_STYLE), -1, -1));
        array.Delete();

        if (!dialog)
        {
            selections.Delete();
            return;
        }

        dialog.SetSelections(selections.ptr);
        if (dialog.ShowModal() === ID_OK)
        {
            dialog.GetSelections(selections.ptr);
            count = selections.GetCount();
        }
        else
        {
            count = -1;
        }
        dialog.Destroy();
    }

    if (count >= 0)
    {
        let message: string;
        if (count === 0)
        {
            message = "You did not select any items";
        }
        else
        {
            message = `You selected ${count} items:\n`;
            for (let n = 0; n < count; n++)
            {
                const selection = selections.Item(n);
                message += `\t${n}: ${selection} (${choices[selection]})\n`;
            }
        }
        withString(message, (ptr) => LogMessage(ptr));
    }

    selections.Delete();
}

//-----------------------------------------------------------------------------
// File dialogs
//-----------------------------------------------------------------------------

function fileStateDescription(dialog: wxFileDialog): string
{
    const filename = takeText(dialog.GetCurrentlySelectedFilename());

    let message: string;
    if (filename === "")
    {
        message = "Nothing";
    }
    else
    {
        const path = createWxString(filename);
        const isFile = wxFileName_FileExistsForPath(path.ptr);
        const isDir = isFile ? false : wxFileName_DirExistsForPath(path.ptr);
        path.Delete();

        if (isFile) message = "File";
        else if (isDir) message = "Directory";
        else message = "Something else";
    }
    message += " selected";

    const filter = dialog.GetCurrentlySelectedFilterIndex();
    if (filter !== NOT_FOUND && filter !== -1)
    {
        message += ` (filter=${filter})`;
    }
    return message;
}

function paperSize(selection: number): string
{
    switch (selection)
    {
        case -1: return "<none>";
        case 0: return "A4";
        case 1: return "Letter";
        default: return "INVALID";
    }
}

function createFileCustomizeHook(dialog: wxFileDialog): wxFileDialogCustomizeHook | null
{
    const addCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_fun, customizerPtr) =>
        {
            if (!customizerPtr) return;
            const customizer = wrapWxFileDialogCustomize(customizerPtr);

            hookText = withString("Just some extra text:",
                (ptr) => customizer.AddTextCtrl(ptr));

            const sizes = charPtrArray(["A4", "Letter"]);
            hookChoiceSize = customizer.AddChoice(2, sizes.ptr);
            void sizes.keep;

            hookRadioPortrait = withString("&Portrait",
                (ptr) => customizer.AddRadioButton(ptr));
            hookRadioLandscape = withString("&Landscape",
                (ptr) => customizer.AddRadioButton(ptr));
            hookCheckBox = withString("Enable Custom Button",
                (ptr) => customizer.AddCheckBox(ptr));
            hookButton = withString("Custom Button",
                (ptr) => customizer.AddButton(ptr));
            hookLabel = withString("Nothing selected",
                (ptr) => customizer.AddStaticText(ptr));

            if (hookCheckBox && hookButton)
            {
                const controlRouter = new EventRouter((tag) =>
                {
                    if (tag === 1)
                    {
                        if (!hookCheckBox || !hookButton) return;
                        if (hookCheckBox.GetValue()) hookButton.Enable(true);
                        else hookButton.Disable();
                    }
                    else
                    {
                        messageBox("Custom button pressed",
                            "wxWidgets dialogs sample",
                            OK | ICON_INFORMATION, dialog.ptr);
                    }
                });
                controlRouter.connect(hookCheckBox.ptr, ID_ANY, ID_ANY, EVT_CHECKBOX, 1);
                controlRouter.connect(hookButton.ptr, ID_ANY, ID_ANY, EVT_BUTTON, 2);
                customizerRouters.push(controlRouter);
            }
        });

    const updateCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_fun) =>
        {
            if (hookCheckBox && hookButton)
            {
                if (hookCheckBox.GetValue())
                {
                    hookButton.Enable(true);
                }
                else
                {
                    hookButton.Disable();
                }
            }

            const selected = takeText(dialog.GetCurrentlySelectedFilename());
            const path = createWxString(selected);
            const hasFile = wxFileName_FileExistsForPath(path.ptr);
            path.Delete();

            for (const control of [hookRadioPortrait, hookRadioLandscape])
            {
                if (!control) continue;
                if (hasFile) control.Enable(true);
                else control.Disable();
            }

            if (hookLabel)
            {
                withString(fileStateDescription(dialog),
                    (ptr) => hookLabel!.SetLabelText(ptr));
            }
        });

    const transferCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_fun) =>
        {
            const size = hookChoiceSize ? hookChoiceSize.GetSelection() : -1;
            const portrait = hookRadioPortrait ? hookRadioPortrait.GetValue() : false;
            const enabled = hookCheckBox ? hookCheckBox.GetValue() : false;
            const text = hookText ? takeText(hookText.GetTextValue()) : "";
            hookInfo = `paper=${paperSize(size)} (${portrait ? "portrait" : "landscape"}), ` +
                `enabled=${enabled ? 1 : 0}, text="${text}"`;
        });

    customizerCallbacks.push(addCallback, updateCallback, transferCallback);

    return createWxFileDialogCustomizeHook(
        null, addCallback.pointer, updateCallback.pointer, transferCallback.pointer);
}

//-----------------------------------------------------------------------------
// Old-style file dialog customization (MyExtraPanel)
//-----------------------------------------------------------------------------

interface ExtraPanelState
{
    button: wxButton;
    dialogPtr: Pointer;
    portraitPtr: Pointer;
    text: string;
    checked: boolean;
    paperSize: string;
    orientation: string;
}

const extraPanelStates = new Map<string, ExtraPanelState>();
const extraControlStates = new Map<string, ExtraPanelState>();

let extraPanelRouter: EventRouter | null = null;
let extraPanelCallback: Callback | null = null;

function resetExtraPanelState(): void
{
    extraPanelStates.clear();
    extraControlStates.clear();
}

function extraPanelInfo(state: ExtraPanelState): string
{
    return `paper=${state.paperSize} (${state.orientation}), ` +
        `enabled=${state.checked ? 1 : 0}, text="${state.text}"`;
}

function extraPanelSink(tag: number, eventPtr: Pointer): void
{
    if (!eventPtr) return;

    if (tag === 5)
    {
        const event = new wxUpdateUIEvent(eventPtr);
        const object = event.GetEventObject();
        const state = object
            ? extraControlStates.get(String(object.ptr)) : undefined;
        if (!state) return;
        withString(fileStateDescription(wrapWxFileDialog(state.dialogPtr)),
            (ptr) => { event.SetText(ptr); });
        return;
    }

    const event = new wxCommandEvent(eventPtr);
    const object = event.GetEventObject();
    const objectPtr = object ? object.ptr : null;
    const state = objectPtr
        ? extraControlStates.get(String(objectPtr)) : undefined;
    if (!state) return;

    if (tag === 1)
    {
        state.checked = event.IsChecked();
        state.button.Enable(state.checked);
    }
    else if (tag === 2)
    {
        state.paperSize = paperSize(event.GetSelection());
    }
    else if (tag === 3)
    {
        if (objectPtr === state.portraitPtr) state.orientation = "portrait";
        else state.orientation = "landscape";
    }
    else if (tag === 4)
    {
        state.text = takeText(event.GetString());
    }
}

/** MyExtraPanel: creates the panel under the dialog that wx passes in. */
function createExtraPanel(parentPtr: Pointer): void
{
    const panel = createWxPanel(parentPtr, ID_ANY, -1, -1, -1, -1, TAB_TRAVERSAL);
    if (!panel) return;

    const button = withString("Custom Button", (text) =>
        createWxButton(panel.ptr, -1, text, -1, -1, -1, -1, 0));
    const check = withString("Enable Custom Button", (text) =>
        createWxCheckBox(panel.ptr, -1, text, -1, -1, -1, -1, 0));
    if (!button || !check) return;
    button.Enable(false);

    const sizes = charPtrArray(["A4", "Letter"]);
    const choice = createWxChoice(
        panel.ptr, ID_ANY, -1, -1, -1, -1, 2, sizes.ptr, 0);
    void sizes.keep;

    const portrait = withString("&Portrait", (text) =>
        createWxRadioButton(panel.ptr, ID_ANY, text, -1, -1, -1, -1, RB_GROUP));
    const landscape = withString("&Landscape", (text) =>
        createWxRadioButton(panel.ptr, ID_ANY, text, -1, -1, -1, -1, 0));
    const label = withString("Nothing selected", (text) =>
        createWxStaticText(panel.ptr, ID_ANY, text, -1, -1, -1, -1, 0));
    const text = withString("extra text", (value) => createWxTextCtrl(
        panel.ptr, -1, value, -1, -1, 40 * panel.GetCharWidth(), -1, 0n));
    if (!choice || !portrait || !landscape || !label || !text) return;

    const state: ExtraPanelState = {
        button,
        dialogPtr: parentPtr,
        portraitPtr: portrait.ptr,
        text: "extra text",
        checked: false,
        paperSize: "",
        orientation: "",
    };
    extraPanelStates.set(String(panel.ptr), state);
    for (const control of [check, choice, portrait, landscape, text, label])
    {
        extraControlStates.set(String(control.ptr), state);
    }

    if (!extraPanelRouter) extraPanelRouter = new EventRouter(extraPanelSink);
    extraPanelRouter.connect(check.ptr, ID_ANY, ID_ANY, EVT_CHECKBOX, 1);
    extraPanelRouter.connect(choice.ptr, ID_ANY, ID_ANY, EVT_CHOICE, 2);
    extraPanelRouter.connect(portrait.ptr, ID_ANY, ID_ANY, EVT_RADIOBUTTON, 3);
    extraPanelRouter.connect(landscape.ptr, ID_ANY, ID_ANY, EVT_RADIOBUTTON, 3);
    extraPanelRouter.connect(text.ptr, ID_ANY, ID_ANY, EVT_TEXT, 4);
    extraPanelRouter.connect(label.ptr, ID_ANY, ID_ANY, EVT_UPDATE_UI, 5);

    const sizer = createWxBoxSizer(HORIZONTAL)!;
    const caption = withString("Just some extra text:", (value) =>
        createWxStaticText(panel.ptr, ID_ANY, value, -1, -1, -1, -1, 0));
    if (caption) addWin(sizer, caption.ptr, 0, (f) => { f.Center(); f.Border(ALL); });
    addWin(sizer, text.ptr, 1, (f) => { f.Center(); f.Border(ALL); });
    sizer.AddSpacer(10);
    addWin(sizer, choice.ptr, 0, (f) => { f.Center(); f.Border(RIGHT); });
    addWin(sizer, portrait.ptr, 0, (f) => { f.Center(); f.Border(ALL); });
    addWin(sizer, landscape.ptr, 0, (f) => { f.Center(); f.Border(ALL); });
    addWin(sizer, check.ptr, 0, (f) => { f.Center(); f.Border(ALL); });
    sizer.AddSpacer(5);
    addWin(sizer, button.ptr, 0, (f) => { f.Center(); f.Border(ALL); });
    sizer.AddSpacer(5);
    addWin(sizer, label.ptr, 1, (f) => { f.Center(); f.Border(ALL); });

    panel.SetSizerAndFit(sizer.ptr, true);
}

function fileOpen(): void
{
    const current = state;
    if (!current) return;

    const wildcard = `All files (${DEFAULT_WILDCARD})|${DEFAULT_WILDCARD}|` +
        "C++ files (*.cpp;*.h)|*.cpp;*.h";

    const dialog = withStrings([
        "Testing open file dialog", "", "", wildcard,
    ], (ptrs) => createWxFileDialog(
        current.frame.ptr, ptrs[0], ptrs[1], ptrs[2], ptrs[3],
        -1, -1, FD_OPEN, -1, -1));
    if (!dialog) return;

    const wxwin = getEnv("WXWIN");
    if (wxwin)
    {
        withString(`${wxwin}/src`, (ptr) => dialog.AddShortcut(ptr, 0));
        withString(`${wxwin}/include`, (ptr) => dialog.AddShortcut(ptr, FD_SHORTCUT_TOP));
    }

    const useExtra = isCheckedOption(DIALOGS_FILE_USE_EXTRA_CONTROL_CREATOR);
    let hasExtra = false;
    let hook: wxFileDialogCustomizeHook | null = null;

    hookInfo = "";
    resetExtraPanelState();
    resetHookState();
    if (useExtra)
    {
        // The ::SetExtraControlCreator() trampoline calls the callback with the
        // parent window and returns the first child it creates under it.
        if (!extraPanelCallback)
        {
            extraPanelCallback = new Callback(
                { parameters: ["pointer", "pointer", "pointer"], result: "void" },
                (parentPtr) =>
                {
                    if (parentPtr) createExtraPanel(parentPtr);
                });
        }
        hasExtra = dialog.SetExtraControlCreator(extraPanelCallback.pointer);
    }
    else
    {
        hook = createFileCustomizeHook(dialog);
        hasExtra = hook !== null && dialog.SetCustomizeHook(hook.ptr);
    }

    dialog.CentreOnParent(BOTH);
    const home = homeDir();
    withString(home, (ptr) => dialog.SetDirectory(ptr));

    const result = dialog.ShowModal();
    let extraInfo = "<not supported>";
    if (result === ID_OK)
    {
        if (hasExtra)
        {
            if (useExtra)
            {
                const extra = dialog.GetExtraControl();
                const panelState = extra
                    ? extraPanelStates.get(String(extra.ptr)) : undefined;
                if (panelState) extraInfo = extraPanelInfo(panelState);
            }
            else
            {
                extraInfo = hookInfo;
            }
        }

        const info = `Full file name: ${takeText(dialog.GetPath())}\n` +
            `Path: ${takeText(dialog.GetDirectory())}\n` +
            `Name: ${takeText(dialog.GetFilename())}\n` +
            `Custom window: ${extraInfo}`;

        withStrings([info, "Selected file"], (ptrs) =>
        {
            const second = createWxMessageDialog(
                current.frame.ptr, ptrs[0], ptrs[1], OK | CENTRE);
            if (!second) return;
            second.ShowModal();
            second.Destroy();
        });
    }

    dialog.Destroy();
    if (hook) hook.Delete();
    resetHookState();
    closeCustomizerCallbacks();
    if (extraPanelRouter)
    {
        extraPanelRouter.close();
        extraPanelRouter = null;
    }
    if (extraPanelCallback)
    {
        extraPanelCallback.close();
        extraPanelCallback = null;
    }
    resetExtraPanelState();
}

function resetHookState(): void
{
    hookText = null;
    hookChoiceSize = null;
    hookRadioPortrait = null;
    hookRadioLandscape = null;
    hookCheckBox = null;
    hookButton = null;
    hookLabel = null;
}

/** Releases the customize-hook callbacks once their dialog is destroyed. */
function closeCustomizerCallbacks(): void
{
    for (const router of customizerRouters) router.close();
    customizerRouters.length = 0;
    for (const callback of customizerCallbacks) callback.close();
    customizerCallbacks.length = 0;
}

function fileOpen2(): void
{
    const current = state;
    if (!current) return;

    const wildcard = `Waveform (*.wav)|*.wav|Plain text (*.txt)|*.txt|` +
        `All files (${DEFAULT_WILDCARD})|${DEFAULT_WILDCARD}`;

    const selected = withStrings([
        "Select the file to load", "", "", fileOpen2Extension, wildcard,
    ], (ptrs) => wxFileSelector(
        ptrs[0], ptrs[1], ptrs[2], ptrs[3], ptrs[4],
        FD_OPEN | FD_CHANGE_DIR | FD_PREVIEW | FD_NO_FOLLOW | FD_SHOW_HIDDEN,
        current.frame.ptr, -1, -1));

    if (!selected) return;

    const path = takeText(selected);
    const dot = path.lastIndexOf(".");
    fileOpen2Extension = dot >= 0 ? path.substring(dot + 1) : "";

    withString(
        `You selected the file '${path}', remembered extension '${fileOpen2Extension}'`,
        (ptr) => LogMessage(ptr));
}

function filesOpen(): void
{
    const current = state;
    if (!current) return;

    const wildcard = `All files (${DEFAULT_WILDCARD})|${DEFAULT_WILDCARD}|` +
        "C++ files (*.cpp;*.h)|*.cpp;*.h";

    const dialog = withStrings([
        "Testing open multiple file dialog", "", "", wildcard,
    ], (ptrs) => createWxFileDialog(
        current.frame.ptr, ptrs[0], ptrs[1], ptrs[2], ptrs[3],
        -1, -1, FD_OPEN | FD_MULTIPLE, -1, -1));
