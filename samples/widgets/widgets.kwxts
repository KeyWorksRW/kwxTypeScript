// widgets.kwxts — kwxTypeScript port of wxSamples/src/widgets/widgets.cpp
//
// The wxWidgets "widgets" sample: a wxTreebook of demonstration pages grouped
// by control family, a log list box fed by a custom wxLog target, and a
// "Widget" menu that applies attributes (tooltip, colours, font, enabled,
// visible, border, variant, layout direction, busy cursor) to the widget(s) of
// the currently selected page.
//
// Run from the repository root:
//   bin\Release\kwxts.exe samples\widgets\widgets.kwxts

declare const __dirname: string;

import {
    ALIGN_RIGHT,
    BK_DEFAULT,
    BORDER_DOUBLE,
    BORDER_MASK,
    BORDER_NONE,
    BORDER_RAISED,
    BORDER_SIMPLE,
    BORDER_STATIC,
    BORDER_SUNKEN,
    BOTTOM,
    CENTRE,
    createWxBoxSizer,
    createWxButton,
    createWxColourEmpty,
    createWxFontDefault,
    createWxFrame,
    createWxIconDefault,
    createWxListBox,
    createWxMenu,
    createWxMenuBar,
    createWxPanel,
    createWxSize,
    createWxString,
    createWxTextEntryDialog,
    createWxTreeItemId,
    createWxTreebook,
    DEFAULT_FRAME_STYLE,
    EVT_BUTTON,
    EVT_CLOSE_WINDOW,
    EVT_MENU,
    EVT_TREEBOOK_PAGE_CHANGED,
    EVT_TREEBOOK_PAGE_CHANGING,
    EVT_UPDATE_UI,
    exitMainLoop,
    EXPAND,
    HORIZONTAL,
    HOURGLASS_CURSOR,
    ID_ANY,
    ID_EXIT,
    ID_OK,
    initialize,
    Null_Cursor,
    Layout_Default,
    Layout_LeftToRight,
    Layout_RightToLeft,
    LEFT,
    readAndDeleteWxString,
    RIGHT,
    run,
    setAppName,
    setTopWindow,
    setVendorName,
    shutdown,
    VERTICAL,
    WINDOW_VARIANT_LARGE,
    WINDOW_VARIANT_MINI,
    WINDOW_VARIANT_NORMAL,
    WINDOW_VARIANT_SMALL,
    wxApp_GetApp,
    wxBeginBusyCursor,
    wxBitmapBundle_FromSVGFile,
    wxBookCtrlEvent,
    wxCommandEvent,
    wxEndBusyCursor,
    wxGetColourFromUser,
    wxGetFontFromUser,
    wxGetNumberFromUser,
    wxGetTextFromUser,
    wxMenu,
    wxMenuBar,
    wxPersistentRegisterAndRestore,
    wxPersistentRegisterAndRestoreTreebookNoName,
    wxTextEntry,
    wxUpdateUIEvent,
    wrapWxApp,
    wrapWxBitmapBundle,
} from "kwx";
