// ---------------------------------------------------------------------------
// Persistent frame state (GridFrame member fields)
// ---------------------------------------------------------------------------

/** A selected block, mirroring wxGridBlockCoords. */
export interface GridBlock
{
    readonly top: number;
    readonly left: number;
    readonly bottom: number;
    readonly right: number;
}

export interface GridFrameState
{
    readonly frame: wxFrame;
    readonly menuBar: wxMenuBar;
    readonly grid: wxGrid;
    readonly logWin: wxTextCtrl;
    readonly logger: wxLogTextCtrl;
    /** wxLog::SetActiveTarget() result before the log window was installed. */
    readonly logOld: Pointer;

    /** GridFrame::m_addToSel */
    addToSel: boolean;
    /** Custom EVT_GRID_TABBING handler active (ID_TAB_CUSTOM). */
    customTab: boolean;
    /** Static flags in ToggleGridCells(). */
    checkeredOn: boolean;
    colouredOn: boolean;
    /** Effective per-cell background colours captured before checkering. */
    checkeredSaved: Uint32Array | null;

    /** Colours captured by wxGrid::HideCol()/HideRow() before hiding. */
    readonly hiddenColSizes: Map<number, number>;
    readonly hiddenRowSizes: Map<number, number>;

    /** Native renderers/editors/attributes owned by the grid. */
    readonly keepAlive: unknown[];

    /** Every Callback must outlive run(). */
    readonly callbacks: Callback[];
    /** Every wxClosure must outlive run(). */
    readonly closures: wxClosure[];
}

// ---------------------------------------------------------------------------
// String and logging helpers
// ---------------------------------------------------------------------------

/** Call fn with a temporary wxString and release it on every path. */
export function withString<T>(text: string, fn: (ptr: Pointer) => T): T
{
    const value = createWxString(text);
    try
    {
        return fn(value.ptr);
    }
    finally
    {
        value.Delete();
    }
}

export function logMessage(text: string): void
{
    withString(text, (ptr) => LogMessage(ptr));
}

export function logError(text: string): void
{
    withString(text, (ptr) => LogError(ptr));
}

export function logWarning(text: string): void
{
    withString(text, (ptr) => LogWarning(ptr));
}

/** wxMessageBox(message, caption, style, parent) */
export function showMessage(
    parent: Pointer,
    message: string,
    caption: string,
    style: number,
): void
{
    withString(message, (messagePtr) =>
    {
        withString(caption, (captionPtr) =>
        {
            kwxMessageBox(messagePtr, captionPtr, style, parent, -1, -1);
        });
    });
}

/** Reports a feature that the binding surface cannot provide. */
export function unavailable(
    state: GridFrameState,
    feature: string,
    api: string,
): void
{
    showMessage(
        state.frame.ptr,
        feature + " is not available in kwxTypeScript: " + api +
            " is not exposed by the wxGrid bindings.",
        "wxGrid demo",
        OK,
    );
}

/** Reads an owned wxString returned by a getter. */
export function takeString(ptr: Pointer): string
{
    return readAndDeleteWxString(ptr);
}

/** Sets a cell's value. */
export function setCellValue(
    grid: wxGrid,
    row: number,
    col: number,
    text: string,
): void
{
    withString(text, (ptr) => grid.SetCellValue(row, col, ptr));
}

/** Reads the grid cursor position into a small structure. */
export function cursorCell(grid: wxGrid): { row: number; col: number }
{
    return { row: grid.GetGridCursorRow(), col: grid.GetGridCursorCol() };
}
