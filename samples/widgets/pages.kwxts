        label: "Spin",
        categories: ALL_CTRLS | NATIVE_CTRLS | EDITABLE_CTRLS,
        create: createSpinBtnPage,
    },
    {
        label: "Static",
        categories: ALL_CTRLS | NATIVE_CTRLS,
        create: createStaticPage,
    },
    {
