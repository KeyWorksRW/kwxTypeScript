// gridcontent.kwxts — the GridFrame constructor's grid setup.
//
// Mirrors griddemo.cpp's GridFrame::GridFrame() up to the point where the grid
// is populated. Features that need an unbound wxGrid API or a C++ virtual
// override are marked in the code and reported by the sample.

import {
    ALIGN_CENTRE,
    ALIGN_INVALID,
    ALIGN_TOP,
    BLUE,
    GREEN,
    GridSelectCells,
    LIGHT_GREY,
    RED,
    createWxColourRGB,
    createWxGridCellAttr,
    createWxGridCellAutoWrapStringEditor,
    createWxGridCellAutoWrapStringRenderer,
    createWxGridCellBoolEditor,
    createWxGridCellChoiceEditor,
    createWxGridCellDateEditor,
    createWxGridCellDateRenderer,
    createWxGridCellNumberEditor,
} from "kwx";
import { pointerOf } from "kwx/platform";
import type {
    wxGrid,
    wxGridCellAttr,
    wxGridCellAutoWrapStringEditor,
    wxGridCellAutoWrapStringRenderer,
    wxGridCellChoiceEditor,
    wxGridCellDateEditor,
    wxGridCellDateRenderer,
} from "kwx";

import { GridFrameState, setCellValue, withString } from "./shared.kwxts";

/** Builds the char** array expected by wxGridCellChoiceEditor. */
function buildChoiceEditor(
    state: GridFrameState,
    choices: readonly string[],
): wxGridCellChoiceEditor | null
{
    const encoded: Uint8Array[] = [];
    const pointers = new Uint8Array(choices.length * 8);
    const view = new DataView(pointers.buffer);

    for (let i = 0; i < choices.length; i++)
    {
        const bytes = new TextEncoder().encode(choices[i] + "\0");
        encoded.push(bytes);
        const ptr = pointerOf(bytes);
        view.setBigUint64(i * 8, ptr === null ? 0n : ptr, true);
    }

    const editor = createWxGridCellChoiceEditor(
        choices.length,
        pointerOf(pointers),
        false,
    );

    // The editor copies the strings in its constructor; keep the buffers
    // referenced for the whole process anyway.
    state.keepAlive.push(encoded, pointers);
    if (editor)
    {
        state.keepAlive.push(editor);
    }
    return editor;
}

function makeAutoWrapRenderer(
    state: GridFrameState,
): wxGridCellAutoWrapStringRenderer | null
{
    const renderer = createWxGridCellAutoWrapStringRenderer();
    if (renderer)
    {
        state.keepAlive.push(renderer);
    }
    return renderer;
}

function makeAutoWrapEditor(
    state: GridFrameState,
): wxGridCellAutoWrapStringEditor | null
{
    const editor = createWxGridCellAutoWrapStringEditor();
    if (editor)
    {
        state.keepAlive.push(editor);
    }
    return editor;
}

function makeDateRenderer(
    state: GridFrameState,
    format: string,
): wxGridCellDateRenderer | null
{
    const renderer = withString(format, (ptr) => createWxGridCellDateRenderer(ptr));
    if (renderer)
    {
        state.keepAlive.push(renderer);
    }
    return renderer;
}

function makeDateEditor(
    state: GridFrameState,
    format: string,
): wxGridCellDateEditor | null
{
    const editor = withString(format, (ptr) => createWxGridCellDateEditor(ptr));
    if (editor)
    {
        state.keepAlive.push(editor);
    }
    return editor;
}

/** wxString::Format("%g", value) for the values used by the sample. */
function formatG(value: number): string
{
    const precision = 6;
    const exponent = Math.floor(Math.log10(Math.abs(value)));
    if (exponent < -4 || exponent >= precision)
    {
        return value.toExponential(precision - 1).replace(/\.?0+e/, "e");
    }

    const decimals = Math.max(0, precision - 1 - exponent);
    let text = value.toFixed(decimals);
    if (text.indexOf(".") !== -1)
    {
        text = text.replace(/0+$/, "").replace(/\.$/, "");
    }
    return text;
}

function setCellBackground(
    grid: wxGrid,
    row: number,
    col: number,
    red: number,
    green: number,
    blue: number,
): void
{
    const colour = createWxColourRGB(red, green, blue, 255);
    if (!colour)
    {
        return;
    }
    grid.SetCellBackgroundColour(row, col, colour.ptr);
    colour.Delete();
}

function makeAttr(state: GridFrameState): wxGridCellAttr | null
{
    const attr = createWxGridCellAttr();
    if (attr)
    {
        state.keepAlive.push(attr);
    }
    return attr;
}

/**
 * GridFrame::GridFrame() grid setup. The caller has already created the grid
 * and installed it in the frame.
 */
export function populateGrid(state: GridFrameState): void
{
    const grid = state.grid;

    // grid->CreateGrid(0, 0)
    grid.CreateGrid(0, 0, GridSelectCells);

    // grid->GetTable()->SetAttrProvider(new CustomColumnHeadersProvider())
    // is not possible: wxGridCellAttrProvider cannot be subclassed from the
    // binding. The standard provider is left in place.

    grid.AppendRows(1000, true);
    grid.AppendCols(100, true);

    const ir = grid.GetNumberRows();
    grid.DeleteRows(0, ir, true);
    grid.AppendRows(ir, true);

    const defaultRowSize = grid.GetDefaultRowSize();
    grid.SetRowSize(0, 4 * defaultRowSize);
    setCellValue(grid, 0, 0, "Ctrl+Home\nwill go to\nthis cell");

    setCellValue(grid, 0, 1, "A long piece of text to demonstrate wrapping.");
    const wrapRenderer1 = makeAutoWrapRenderer(state);
    const wrapEditor1 = makeAutoWrapEditor(state);
    if (wrapRenderer1)
    {
        grid.SetCellRenderer(0, 1, wrapRenderer1.ptr);
    }
    if (wrapEditor1)
    {
        grid.SetCellEditor(0, 1, wrapEditor1.ptr);
    }

    setCellValue(grid, 0, 2, "Blah");
    setCellValue(grid, 0, 3, "Read only");
    grid.SetReadOnly(0, 3, true);

    setCellValue(grid, 0, 4, "Can veto edit this cell");

    grid.SetColSize(10, state.frame.FromDIP(150));

    let longtext =
        "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ\n\n";
    longtext += "With tabs :\n";
    longtext += "Home,\t\thome\t\t\tagain\n";
    longtext += "Long word at start :\n";
    longtext += "ILikeToBeHereWhen I can\n";
    longtext += "Long word in the middle :\n";
    longtext += "When IComeHome,ColdAnd tired\n";
    longtext += "Long last word :\n";
    longtext += "It's GoodToWarmMyBonesBesideTheFire";
    setCellValue(grid, 0, 10, longtext);
    const wrapRenderer2 = makeAutoWrapRenderer(state);
    const wrapEditor2 = makeAutoWrapEditor(state);
    if (wrapRenderer2)
    {
        grid.SetCellRenderer(0, 10, wrapRenderer2.ptr);
    }
    if (wrapEditor2)
    {
        grid.SetCellEditor(0, 10, wrapEditor2.ptr);
    }
    setCellValue(grid, 0, 11, "K1 cell editor blocker");

    setCellValue(grid, 0, 5, "Press\nCtrl+arrow\nto skip over\ncells");

    const endRow = grid.GetNumberRows() - 1;
    const endCol = grid.GetNumberCols() - 1;

    grid.SetRowSize(endRow, 4 * defaultRowSize);
    setCellValue(grid, endRow - 1, endCol - 1, "Test background colour setting");
    setCellBackground(grid, endRow - 1, endCol, 255, 127, 127);
    setCellBackground(grid, endRow, endCol - 1, 255, 127, 127);
    setCellValue(grid, endRow, endCol, "Ctrl+End\nwill go to\nthis cell");
    setCellValue(
        grid,
        1,
        0,
        "This default cell will overflow into neighboring cells, " +
            "but not if you turn overflow off.",
    );

    setCellValue(grid, 2, 0, "This one always overflows");
    // grid->SetCellFitMode(2, 0, wxGridFitMode::Overflow()) is not bound.

    grid.SetCellTextColour(1, 2, RED);
    grid.SetCellBackgroundColour(1, 2, GREEN);

    setCellValue(grid, 1, 4, "I'm in the middle");

    setCellValue(grid, 2, 2, "red");

    grid.SetCellTextColour(2, 2, RED);
    setCellValue(grid, 3, 3, "green on grey");
    grid.SetCellTextColour(3, 3, GREEN);
    grid.SetCellBackgroundColour(3, 3, LIGHT_GREY);

    setCellValue(grid, 4, 4, "a weird looking cell");
    grid.SetCellAlignment(4, 4, ALIGN_CENTRE, ALIGN_CENTRE);
    // MyGridCellRenderer (green ellipse) needs a C++ virtual override.

    setCellValue(grid, 4, 5, "3");
    // MyGridStarRenderer / MyGridStarEditor need C++ virtual overrides.

    // grid->SetCellRenderer(3, 0, new wxGridCellBoolRenderer);
    // grid->SetCellRenderer(3, 1, new wxGridCellBoolRenderer);
    // The binding has no createWxGridCellBoolRenderer() factory, but the grid's
    // own type registry hands out its wxGridCellBoolRenderer for the standard
    // "bool" data type, which is exactly the renderer the C++ code installs.
    // The table keeps its string values, so the renderer maps "1" to a checked
    // box and every other value (including the empty cell 3,0) to an unchecked
    // one, just like the C++ version.
    const boolRenderer = withString(
        "bool",
        (typeName) => grid.GetDefaultRendererForType(typeName),
    );
    if (boolRenderer)
    {
        grid.SetCellRenderer(3, 0, boolRenderer);
        grid.SetCellRenderer(3, 1, boolRenderer);
    }

    const boolEditor1 = createWxGridCellBoolEditor();
    const boolEditor2 = createWxGridCellBoolEditor();
    state.keepAlive.push(boolEditor1, boolEditor2);
    if (boolEditor1)
    {
        grid.SetCellEditor(3, 0, boolEditor1.ptr);
    }
    setCellBackground(grid, 3, 0, 255, 127, 127);
    if (boolEditor2)
    {
        grid.SetCellEditor(3, 1, boolEditor2.ptr);
    }
    setCellValue(grid, 3, 1, "1");

    let attr = makeAttr(state);
    if (attr)
    {
        attr.SetTextColour(BLUE);
        grid.SetColAttr(5, attr.ptr);
    }
    attr = makeAttr(state);
    if (attr)
    {
        attr.SetBackgroundColour(RED);
        grid.SetRowAttr(5, attr.ptr);
    }

    setCellValue(grid, 2, 4, "a wider column");
    grid.SetColSize(4, Math.trunc((3 * grid.GetDefaultColSize()) / 2));
    grid.SetColMinimalWidth(4, grid.GetColSize(4));

    grid.SetCellTextColour(5, 8, GREEN);
    setCellValue(grid, 5, 8, "Bg from row attr\nText col from cell attr");
    setCellValue(
        grid,
        5,
        5,
        "Bg from row attr Text col from col attr and this text is so long " +
            "that it covers over many many empty cells but is broken by one " +
            "that isn't",
    );

    // Some numeric columns with different formatting.
    grid.SetColFormatFloat(6, -1, -1);
    grid.SetReadOnly(0, 6, true);
    setCellValue(grid, 0, 6, "Default\nfloat format");
    setCellValue(grid, 1, 6, formatG(3.1415));
    setCellValue(grid, 2, 6, formatG(1415.0));
    setCellValue(grid, 3, 6, formatG(12345.67890));

    grid.SetColFormatFloat(7, 6, 2);
    grid.SetReadOnly(0, 7, true);
    setCellValue(grid, 0, 7, "Width 6\nprecision 2");
    setCellValue(grid, 1, 7, formatG(3.1415));
    setCellValue(grid, 2, 7, formatG(1415.0));
    setCellValue(grid, 3, 7, formatG(12345.67890));

    const customFormat = "float:-1,4,g";
    withString(customFormat, (ptr) => grid.SetColFormatCustom(8, ptr));
    grid.SetReadOnly(0, 8, true);
    setCellValue(grid, 0, 8, "Compact\nformat");
    setCellValue(grid, 1, 8, "31415e-4");
    setCellValue(grid, 2, 8, "1415");
    setCellValue(grid, 3, 8, "123456789e-4");

    grid.SetColFormatNumber(9);
    grid.SetReadOnly(0, 9, true);
    setCellValue(grid, 0, 9, "Integer\ncolumn");
    setCellValue(grid, 1, 9, "17");
    setCellValue(grid, 2, 9, "0");
    const numberEditor = createWxGridCellNumberEditor(0, 100);
    if (numberEditor)
    {
        state.keepAlive.push(numberEditor);
        grid.SetCellEditor(2, 9, numberEditor.ptr);
    }
    setCellValue(grid, 2, 10, "<- This cell uses [0, 100] range");
    setCellValue(grid, 3, 9, "-666");
    grid.SetCellAlignment(3, 9, ALIGN_CENTRE, ALIGN_TOP);
    setCellValue(grid, 3, 10, "<- This numeric cell should be centred");

    grid.SetReadOnly(0, 13, true);
    setCellValue(grid, 0, 13, "Localized date\ncolumn");
    withString("", (ptr) => grid.SetColFormatDate(13, ptr)); // Localized by default.
    setCellValue(grid, 1, 13, "Today");
    grid.SetReadOnly(0, 14, true);
    setCellValue(grid, 0, 14, "ISO 8601 date\ncolumn");
    withString("%Y-%m-%d", (ptr) => grid.SetColFormatDate(14, ptr));
    setCellValue(grid, 1, 14, "Tomorrow");

    setCellValue(grid, 13, 0, "Date cell:");
    setCellValue(grid, 13, 1, "Today");
    const dateRenderer1 = makeDateRenderer(state, "");
    const dateEditor1 = makeDateEditor(state, "");
    if (dateRenderer1)
    {
        grid.SetCellRenderer(13, 1, dateRenderer1.ptr);
    }
    if (dateEditor1)
    {
        grid.SetCellEditor(13, 1, dateEditor1.ptr);
    }

    setCellValue(grid, 14, 0, "ISO date cell:");
    setCellValue(grid, 14, 1, "Tomorrow");
    const dateRenderer2 = makeDateRenderer(state, "%Y-%m-%d");
    const dateEditor2 = makeDateEditor(state, "");
    if (dateRenderer2)
    {
        grid.SetCellRenderer(14, 1, dateRenderer2.ptr);
    }
    if (dateEditor2)
    {
        grid.SetCellEditor(14, 1, dateEditor2.ptr);
    }

    setCellValue(grid, 13, 3, "String using default ellipsization");
    // grid->SetCellFitMode(13, 3, wxGridFitMode::Ellipsize()) is not bound.

    setCellValue(grid, 13, 4, "String ellipsized in the middle");
    // grid->SetCellFitMode(13, 4, wxGridFitMode::Ellipsize(wxELLIPSIZE_MIDDLE))
    // is not bound.

    const choices: readonly string[] =
    [
        "Please select a choice",
        "This takes two cells",
        "Another choice",
    ];
    const choiceEditor = buildChoiceEditor(state, choices);
    if (choiceEditor)
    {
        grid.SetCellEditor(4, 2, choiceEditor.ptr);
    }
    grid.SetCellSize(4, 2, 1, 2);
    setCellValue(grid, 4, 2, choices[0]);
    // grid->SetCellOverflow(4, 2, false) is not bound.

    grid.SetCellSize(7, 1, 3, 4);
    grid.SetCellAlignment(7, 1, ALIGN_CENTRE, ALIGN_CENTRE);
    setCellValue(grid, 7, 1, "Big box!");

    // create a separator-like row: it's grey and it's non-resizable
    // grid->DisableRowResize(10) is not bound.
    grid.SetRowSize(10, Math.trunc((3 * defaultRowSize) / 2));
    attr = makeAttr(state);
    if (attr)
    {
        attr.SetBackgroundColour(LIGHT_GREY);
        attr.SetAlignment(ALIGN_INVALID, ALIGN_CENTRE);
        grid.SetRowAttr(10, attr.ptr);
    }
    setCellValue(
        grid,
        10,
        0,
        "You can't resize this row interactively -- try it",
    );

    // this does exactly nothing except testing that SetAttr() handles null
    // attributes and does reference counting correctly. wxGrid::SetAttr() is
    // not bound, and the calls have no visible effect, so they are omitted.

    // grid->Bind(wxEVT_CONTEXT_MENU, ...) is wired by the frame.
}
