//-----------------------------------------------------------------------------
// Menu helpers (wxMenu::Append always needs a help string)
//-----------------------------------------------------------------------------

export function appendMenu(
    menu: wxMenu, id: number, label: string, help = "",
): void
{
    withStrings([label, help], (ptrs) => menu.Append(id, ptrs[0], ptrs[1], false));
}

export function appendCheckItem(
    menu: wxMenu, id: number, label: string, help = "",
): void
{
    withStrings([label, help], (ptrs) => menu.AppendCheckItem(id, ptrs[0], ptrs[1]));
}

export function appendRadioItem(
    menu: wxMenu, id: number, label: string, help = "",
): void
{
    withStrings([label, help], (ptrs) => menu.AppendRadioItem(id, ptrs[0], ptrs[1]));
}

//-----------------------------------------------------------------------------
// wxString helpers
//-----------------------------------------------------------------------------

/** Calls fn with a temporary wxString and always releases it. */
export function withString<T>(text: string, fn: (ptr: Pointer) => T): T
{
    const value: wxString = createWxString(text);
    try
    {
        return fn(value.ptr);
    }
    finally
    {
        value.Delete();
    }
}

/** Calls fn with several temporary wxStrings and always releases them. */
export function withStrings<T>(values: string[], fn: (ptrs: Pointer[]) => T): T
{
    const created: wxString[] = [];
    for (const value of values) created.push(createWxString(value));
    try
    {
        return fn(created.map((value) => value.ptr));
    }
    finally
    {
        for (const value of created) value.Delete();
    }
}

/** Reads any wxString getter result (wrapper or raw pointer). */
export function takeText(value: wxString | Pointer | null): string
{
    if (!value) return "";
    const ptr = typeof value === "object" ? value.ptr : value;
    return readAndDeleteWxString(ptr);
}

//-----------------------------------------------------------------------------
// Native array helpers
//-----------------------------------------------------------------------------

/** Keeps native buffers reachable for the whole process. */
export const keepAlive: unknown[] = [];

/**
 * Builds the `char**` array expected by the kwxFFI string-array parameters.
 * wxPropertyGrid copies the strings in the constructor, but the buffers are
 * kept reachable anyway.
 */
export function charPtrArray(items: string[]): { ptr: Pointer; keep: (Uint8Array | BigUint64Array)[] }
{
    const keep: (Uint8Array | BigUint64Array)[] = [];
    const pointers = new BigUint64Array(items.length);
    keep.push(pointers);

    for (let i = 0; i < items.length; i++)
    {
        const bytes = new TextEncoder().encode(items[i] + "\0");
        keep.push(bytes);
        const address = pointerOf(bytes);
        pointers[i] = address === null ? 0n : address;
    }

    keepAlive.push(keep);
    return { ptr: pointerOf(pointers), keep };
}

/** Builds a C `int*` array for TArrayInt parameters. */
export function intArray(values: number[]): { ptr: Pointer; keep: Int32Array }
{
    const buffer = new Int32Array(values);
    keepAlive.push(buffer);
    return { ptr: pointerOf(buffer), keep: buffer };
}

/** Creates a wxArrayString from a list of JS strings. */
export function createArrayString(items: string[]): wxArrayString | null
{
    const array = createWxArrayString();
    if (!array) return null;
    for (const item of items)
    {
        const value = createWxString(item);
        array.Add(value.ptr);
        value.Delete();
    }
    return array;
}

//-----------------------------------------------------------------------------
// wxVariant helpers
//-----------------------------------------------------------------------------

export function variantLong(value: number): wxVariant
{
    // kwxFFI's CreateFrom* helpers dereference the name pointer, so an empty
    // wxString must be supplied (the C++ WXVARIANT macro uses an empty name).
    const name = createWxString("");
    try
    {
        return createWxVariantFromLong(BigInt(Math.trunc(value)), name.ptr)!;
    }
    finally
    {
        name.Delete();
    }
}

export function variantDouble(value: number): wxVariant
{
    const name = createWxString("");
    try
    {
        return createWxVariantFromDouble(value, name.ptr)!;
    }
    finally
    {
        name.Delete();
    }
}

export function variantBool(value: boolean): wxVariant
{
    const name = createWxString("");
    try
    {
        return createWxVariantFromBool(value, name.ptr)!;
    }
    finally
    {
        name.Delete();
    }
}

export function variantString(value: string): wxVariant
{
    const text = createWxString(value);
    const name = createWxString("");
    try
    {
        return createWxVariantFromString(text.ptr, name.ptr)!;
    }
    finally
    {
        name.Delete();
        text.Delete();
    }
}

export function variantArrayString(items: string[]): wxVariant | null
{
    const array = createArrayString(items);
    if (!array) return null;
    const name = createWxString("");
    try
    {
        return createWxVariantFromArrayString(array.ptr, name.ptr);
    }
    finally
    {
        name.Delete();
        array.Delete();
    }
}

//-----------------------------------------------------------------------------
// Attribute helpers (wxPGProperty::SetAttribute is bound)
//-----------------------------------------------------------------------------

export function attrLong(prop: wxPGProperty | null, name: string, value: number): void
{
    if (!prop) return;
    const key = createWxString(name);
    const variant = variantLong(value);
    try
    {
        prop.SetAttribute(key.ptr, variant.ptr);
    }
    finally
    {
        variant.Delete();
        key.Delete();
    }
}

export function attrDouble(prop: wxPGProperty | null, name: string, value: number): void
{
    if (!prop) return;
    const key = createWxString(name);
    const variant = variantDouble(value);
    try
    {
        prop.SetAttribute(key.ptr, variant.ptr);
    }
    finally
    {
        variant.Delete();
        key.Delete();
    }
}

export function attrBool(prop: wxPGProperty | null, name: string, value: boolean): void
{
    if (!prop) return;
    const key = createWxString(name);
    const variant = variantBool(value);
    try
    {
        prop.SetAttribute(key.ptr, variant.ptr);
    }
    finally
    {
        variant.Delete();
        key.Delete();
    }
}

export function attrString(prop: wxPGProperty | null, name: string, value: string): void
{
    if (!prop) return;
    const key = createWxString(name);
    const variant = variantString(value);
    try
    {
        prop.SetAttribute(key.ptr, variant.ptr);
    }
    finally
    {
        variant.Delete();
        key.Delete();
    }
}

export function attrArrayString(prop: wxPGProperty | null, name: string, items: string[]): void
{
    if (!prop) return;
    const key = createWxString(name);
    const variant = variantArrayString(items);
    if (!variant)
    {
        key.Delete();
        return;
    }
    try
    {
        prop.SetAttribute(key.ptr, variant.ptr);
    }
    finally
    {
        variant.Delete();
        key.Delete();
    }
}

//-----------------------------------------------------------------------------
// Property tree navigation
//-----------------------------------------------------------------------------

export function propName(prop: wxPGProperty): string
{
    return takeText(prop.GetName());
}

export function propLabel(prop: wxPGProperty): string
{
    return takeText(prop.GetLabel());
}

/** The local (non-dotted) property name, as used by wxPG's name map. */
export function propBaseName(prop: wxPGProperty): string
{
    return takeText(prop.GetBaseName());
}

function findInChildren(node: wxPGProperty, path: string): wxPGProperty | null
{
    const count = node.GetChildCount();
    for (let i = 0; i < count; i++)
    {
        const child = node.Item(i);
        if (!child) continue;

        const name = propBaseName(child);
        if (path === name) return child;

        const prefix = name + ".";
        if (path.startsWith(prefix))
        {
            const deeper = findInChildren(child, path.substring(prefix.length));
            if (deeper) return deeper;
        }
        else if (path.indexOf(".") < 0)
        {
            // Categories and containers are transparent to a plain name.
            const deeper = findInChildren(child, path);
            if (deeper) return deeper;
        }
    }
    return null;
}

/** Finds a property by name (or dotted path) on any manager page. */
export function findProperty(
    manager: wxPropertyGridManager, path: string,
): wxPGProperty | null
{
    if (!path) return null;
    return withString(path, (ptr) => manager.GetPropertyByName(ptr));
}

/** Returns a manager page by its label (wxPropertyGridManager::GetPage(name)). */
export function findPage(
    manager: wxPropertyGridManager, name: string,
): wxPropertyGridPage | null
{
    const index = withString(name, (ptr) => manager.GetPageByName(ptr));
    return index >= 0 ? manager.GetPage(index) : null;
}

/** Finds a property by name on one already-fetched page root. */
export function findPropertyInPage(
    root: wxPGProperty, path: string,
): wxPGProperty | null
{
    return findInChildren(root, path);
}

export function walkAll(node: wxPGProperty, fn: (prop: wxPGProperty) => void): void
{
    const count = node.GetChildCount();
    for (let i = 0; i < count; i++)
    {
        const child = node.Item(i);
        if (!child) continue;
        fn(child);
        walkAll(child, fn);
    }
}

export function walkVisible(node: wxPGProperty, fn: (prop: wxPGProperty) => void): void
{
    const count = node.GetChildCount();
    for (let i = 0; i < count; i++)
    {
        const child = node.Item(i);
        if (!child) continue;
        fn(child);
        if (child.GetChildCount() > 0 && child.IsExpanded())
            walkVisible(child, fn);
    }
}

export function walkCategories(node: wxPGProperty, fn: (prop: wxPGProperty) => void): void
{
    const count = node.GetChildCount();
    for (let i = 0; i < count; i++)
    {
        const child = node.Item(i);
        if (!child) continue;
        if (child.IsCategory()) fn(child);
        walkCategories(child, fn);
    }
}

export function walkAllPages(
    manager: wxPropertyGridManager, fn: (prop: wxPGProperty) => void,
): void
{
    const pages = manager.GetPageCount();
    for (let i = 0; i < pages; i++)
    {
        const page = manager.GetPage(i);
        const root = page ? page.GetRoot() : null;
        if (root) walkAll(root, fn);
    }
}

//-----------------------------------------------------------------------------
// Value / message helpers
//-----------------------------------------------------------------------------

/** Anything exposing wxPropertyGridInterface::SetPropertyValue(). */
type ValueTarget = wxPropertyGrid | wxPropertyGridPage;

export function setValueLong(target: ValueTarget, prop: wxPGProperty, value: number): void
{
    const variant = variantLong(value);
    try
    {
        target.SetPropertyValue(prop.ptr, variant.ptr);
    }
    finally
    {
        variant.Delete();
    }
}

export function setValueString(target: ValueTarget, prop: wxPGProperty, value: string): void
{
    const variant = variantString(value);
    try
    {
        target.SetPropertyValue(prop.ptr, variant.ptr);
    }
    finally
    {
        variant.Delete();
    }
}

export function setValueBool(grid: wxPropertyGrid, prop: wxPGProperty, value: boolean): void
{
    const variant = variantBool(value);
    try
    {
        grid.SetPropertyValue(prop.ptr, variant.ptr);
    }
    finally
    {
        variant.Delete();
    }
}

export function setValueDouble(grid: wxPropertyGrid, prop: wxPGProperty, value: number): void
{
    const variant = variantDouble(value);
    try
    {
        grid.SetPropertyValue(prop.ptr, variant.ptr);
    }
    finally
    {
        variant.Delete();
    }
}

export function messageBox(
    message: string, caption = "Message", style = OK, parent: Pointer = null,
): number
{
    return withStrings([message, caption], (ptrs) =>
        kwxMessageBox(ptrs[0], ptrs[1], style, parent, -1, -1));
}

export function logMessage(text: string): void
{
    withString(text, (ptr) => LogMessage(ptr));
}

export function logDebug(text: string): void
{
    withString(text, (ptr) => LogDebug(ptr));
}

export function logVerbose(text: string): void
{
    withString(text, (ptr) => LogVerbose(ptr));
}

export function logError(text: string): void
{
    withString(text, (ptr) => LogError(ptr));
}

/** wxGetTextFromUser() returning "" when cancelled. */
export function getUserText(
    message: string, caption: string, defaultValue: string,
    parent: Pointer, x: number, y: number, centre: boolean,
): string
{
    const messageBuffer = new TextEncoder().encode(message + "\0");
    const captionBuffer = new TextEncoder().encode(caption + "\0");
    const defaultBuffer = new TextEncoder().encode(defaultValue + "\0");

    const messagePtr = pointerOf(messageBuffer);
    const captionPtr = pointerOf(captionBuffer);
    const defaultPtr = pointerOf(defaultBuffer);

    const length = wxGetTextFromUser(
        messagePtr, captionPtr, defaultPtr, parent, x, y, centre ? 1 : 0, null);
    if (length <= 0) return "";

    const output = new Uint8Array(length + 1);
    const outputPtr = pointerOf(output);
    wxGetTextFromUser(
        messagePtr, captionPtr, defaultPtr, parent, x, y, centre ? 1 : 0, outputPtr);

    return readCString(outputPtr);
}
