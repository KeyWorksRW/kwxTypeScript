// about.kwxts — the About box (AppAbout) and the Properties dialog
// (EditProperties) from stctest.cpp / edit.cpp.
//
// Both C++ dialogs call ShowModal() at the end of their constructors, so each
// function here builds the dialog, shows it modally and destroys it.

import {
    ALL,
    BOTH,
    BOTTOM,
    createWxBoxSizer,
    createWxButton,
    createWxDialog,
    createWxFont,
    createWxGridSizer,
    createWxStaticBitmap,
    createWxStaticBox,
    createWxStaticBoxSizer,
    createWxStaticText,
    DEFAULT_DIALOG_STYLE,
    FONTFAMILY_DEFAULT,
    FONTENCODING_DEFAULT,
    FONTSTYLE_NORMAL,
    FONTWEIGHT_BOLD,
    HORIZONTAL,
    ID_ANY,
    ID_OK,
    LEFT,
    RESIZE_BORDER,
    RIGHT,
    TOP,
    VERTICAL,
    wxDialog,
} from "kwx";
import { Pointer } from "kwx/platform";
import { sampleBitmap32 } from "./assets.kwxts";
import { addSizer, addSpacer, addWindow, withString } from "./runtime.kwxts";
import { EditInfo } from "./edit.kwxts";
import { wxSTC_EOL_CR, wxSTC_EOL_CRLF, wxSTC_EOL_LF } from "./stc_consts.kwxts";

const APP_MAINT = "Otto Wyss";
const APP_VENDOR = "wxWidgets";
const APP_COPYRIGHT = "(C) 2003 Otto Wyss";
const APP_LICENCE = "wxWidgets";
const APP_DESCR = "See http://wxguide.sourceforge.net/";

/** wxStaticText(parent, wxID_ANY, text, wxDefaultPosition, wxSize(w, -1)) */
function label80(dialog: wxDialog, text: string)
{
    return withString(text, (value) =>
        createWxStaticText(dialog.ptr, ID_ANY, value, -1, -1, 80, -1, 0));
}

/** wxStaticText(parent, wxID_ANY, text) */
function label(dialog: wxDialog, text: string)
{
    return withString(text, (value) =>
        createWxStaticText(dialog.ptr, ID_ANY, value, -1, -1, -1, -1, 0));
}

/**
 * AppAbout::AppAbout(parent, milliseconds, style)
 *
 * `milliseconds` is 0 for every caller in the sample (AppFrame::OnAbout and the
 * context menu both use the default), so no timer is created — exactly as in the
 * C++, where the timer is only started when milliseconds > 0.
 */
export function showAbout(parent: Pointer, appname: string, appVersion: string): void
{
    const style = DEFAULT_DIALOG_STYLE | RESIZE_BORDER;
    const dialog = withString("", (title) =>
        createWxDialog(parent, ID_ANY, title, -1, -1, -1, -1, style));
    if (!dialog)
    {
        return;
    }

    // sets the application title
    withString("About ..", (title) => dialog.SetTitle(title));

    // Get version of Scintilla: APP_VERSION "(libver, lexerver)".
    // BINDING GAP: wxStyledTextCtrl::GetLibraryVersionInfo() and
    // GetLexerVersionInfo() are not bound, so only APP_VERSION is shown.
    const versionInfo = appVersion;

    // about info
    const aboutinfo = createWxGridSizer(0, 2, 0, 2);
    if (aboutinfo)
    {
        const addPair = (caption: string, value: string): void =>
        {
            const captionText = label(dialog, caption);
            if (captionText)
            {
                addWindow(aboutinfo, captionText.ptr, 0, (flags) => flags.Left());
            }
            const valueText = label(dialog, value);
            if (valueText)
            {
                addWindow(aboutinfo, valueText.ptr, 1, (flags) =>
                {
                    flags.Expand();
                    flags.Left();
                });
            }
        };

        addPair("Written by: ", APP_MAINT);
        addPair("Version: ", versionInfo);
        addPair("Licence type: ", APP_LICENCE);
        addPair("Copyright: ", APP_COPYRIGHT);
    }

    // about icon/title/info
    const aboutpane = createWxBoxSizer(HORIZONTAL);
    if (!aboutpane)
    {
        dialog.Destroy();
        return;
    }

    const bitmap = sampleBitmap32();
    if (bitmap)
    {
        const staticBitmap = createWxStaticBitmap(
            dialog.ptr, ID_ANY, bitmap.ptr, -1, -1, -1, -1, 0);
        if (staticBitmap)
        {
            addWindow(aboutpane, staticBitmap.ptr, 0, (flags) =>
            {
                flags.Left();
                flags.CenterVertical();
                flags.BorderSize(LEFT | RIGHT, dialog.FromDIP(20));
            });
        }
    }
    if (aboutinfo)
    {
        addSizer(aboutpane, aboutinfo.ptr, 1, (flags) => flags.Expand());
    }
    addSpacer(aboutpane, 60, 0);

    // about complete
    const totalpane = createWxBoxSizer(VERTICAL);
    if (!totalpane)
    {
        dialog.Destroy();
        return;
    }

    addSpacer(totalpane, 0, 20);

    const appnameText = label(dialog, appname);
    if (appnameText)
    {
        // appname->SetFont(wxFontInfo(24).Bold());
        const font = withString("", (face) =>
            createWxFont(
                24, FONTFAMILY_DEFAULT, FONTSTYLE_NORMAL, FONTWEIGHT_BOLD,
                false, face, FONTENCODING_DEFAULT));
        if (font)
        {
            appnameText.SetFont(font.ptr);
            font.Delete();
        }
        addWindow(totalpane, appnameText.ptr, 0, (flags) =>
        {
            flags.Center();
            flags.BorderSize(LEFT | RIGHT, dialog.FromDIP(40));
        });
    }

    addSpacer(totalpane, 0, 10);
    addSizer(totalpane, aboutpane.ptr, 0, (flags) =>
    {
        flags.Expand();
        flags.Border(ALL);
    });

    const description = label(dialog, APP_DESCR);
    if (description)
    {
        addWindow(totalpane, description.ptr, 0, (flags) =>
        {
            flags.Center();
            flags.DoubleBorder(ALL);
        });
    }

    const okButton = withString("OK", (text) =>
        createWxButton(dialog.ptr, ID_OK, text, -1, -1, -1, -1, 0));
    if (okButton)
    {
        okButton.SetDefault();
        addWindow(totalpane, okButton.ptr, 0, (flags) =>
        {
            flags.Center();
            flags.DoubleBorder(LEFT | RIGHT | BOTTOM);
        });
    }

    dialog.SetSizerAndFit(totalpane.ptr, true);
    dialog.CenterOnScreen(BOTH);
    dialog.ShowModal();
    dialog.Destroy();
}

/** The EOL mode name shown by EditProperties. */
function eolName(eolMode: number): string
{
    switch (eolMode)
    {
        case wxSTC_EOL_CR: return "CR (Unix)";
        case wxSTC_EOL_CRLF: return "CRLF (Windows)";
        case wxSTC_EOL_LF: return "CR (Macintosh)";
        default: return "";
    }
}

/** EditProperties::EditProperties(edit, style) */
export function showEditProperties(parent: Pointer, info: EditInfo): void
{
    const style = DEFAULT_DIALOG_STYLE | RESIZE_BORDER;
    const dialog = withString("", (title) =>
        createWxDialog(parent, ID_ANY, title, -1, -1, -1, -1, style));
    if (!dialog)
    {
        return;
    }

    withString("Properties", (title) => dialog.SetTitle(title));

    // full name
    const fullname = createWxBoxSizer(HORIZONTAL);
    if (!fullname)
    {
        dialog.Destroy();
        return;
    }
    addSpacer(fullname, 10, 0);
    const filenameCaption = label80(dialog, "Full filename");
    if (filenameCaption)
    {
        addWindow(fullname, filenameCaption.ptr, 0, (flags) =>
        {
            flags.Left();
            flags.CenterVertical();
        });
    }
    const filenameValue = label(dialog, info.filename);
    if (filenameValue)
    {
        addWindow(fullname, filenameValue.ptr, 0, (flags) =>
        {
            flags.Left();
            flags.CenterVertical();
        });
    }

    // text info
    const textinfo = createWxGridSizer(0, 4, 0, 2);
    if (textinfo)
    {
        const addLeft = (caption: string): void =>
        {
            const control = label80(dialog, caption);
            if (control)
            {
                addWindow(textinfo, control.ptr, 0, (flags) =>
                {
                    flags.Left();
                    flags.CenterVertical();
                    flags.Border(LEFT);
                });
            }
        };
        const addLeftValue = (value: string): void =>
        {
            const control = label(dialog, value);
            if (control)
            {
                addWindow(textinfo, control.ptr, 0, (flags) =>
                {
                    flags.Left();
                    flags.CenterVertical();
                    flags.Border(RIGHT);
                });
            }
        };
        const addRightValue = (value: string): void =>
        {
            const control = label(dialog, value);
            if (control)
            {
                addWindow(textinfo, control.ptr, 0, (flags) =>
                {
                    flags.Right();
                    flags.CenterVertical();
                    flags.Border(RIGHT);
                });
            }
        };

        addLeft("Language");
        addLeftValue(info.languageName);
        addLeft("Lexer-ID: ");
        addRightValue(`${info.lexer}`);
        addLeft("Line endings");
        addLeftValue(eolName(info.eolMode));
    }

    // text info box
    const informationBox = withString("Information", (title) =>
        createWxStaticBox(dialog.ptr, ID_ANY, title, -1, -1, -1, -1, 0));
    const textinfos = informationBox
        ? createWxStaticBoxSizer(informationBox.ptr, VERTICAL)
        : null;
    if (textinfos)
    {
        if (textinfo)
        {
            addSizer(textinfos, textinfo.ptr, 0, (flags) => flags.Expand());
        }
        addSpacer(textinfos, 0, 6);
    }

    // statistic
    const statistic = createWxGridSizer(0, 4, 0, 2);
    if (statistic)
    {
        const addLeft = (caption: string): void =>
        {
            const control = label80(dialog, caption);
            if (control)
            {
                addWindow(statistic, control.ptr, 0, (flags) =>
                {
                    flags.Left();
                    flags.CenterVertical();
                    flags.Border(LEFT);
                });
            }
        };
        const addRightValue = (value: string): void =>
        {
            const control = label(dialog, value);
            if (control)
            {
                addWindow(statistic, control.ptr, 0, (flags) =>
                {
                    flags.Right();
                    flags.CenterVertical();
                    flags.Border(RIGHT);
                });
            }
        };

        addLeft("Total lines");
        addRightValue(`${info.lineCount}`);
        addLeft("Total chars");
        addRightValue(`${info.textLength}`);
        addLeft("Current line");
        addRightValue(`${info.currentLine}`);
        addLeft("Current pos");
        addRightValue(`${info.currentPos}`);
    }

    // char/line statistics
    const statisticsBox = withString("Statistics", (title) =>
        createWxStaticBox(dialog.ptr, ID_ANY, title, -1, -1, -1, -1, 0));
    const statistics = statisticsBox
        ? createWxStaticBoxSizer(statisticsBox.ptr, VERTICAL)
        : null;
    if (statistics)
    {
        if (statistic)
        {
            addSizer(statistics, statistic.ptr, 0, (flags) => flags.Expand());
        }
        addSpacer(statistics, 0, 6);
    }

    // total pane
    const totalpane = createWxBoxSizer(VERTICAL);
    if (!totalpane)
    {
        dialog.Destroy();
        return;
    }

    addSizer(totalpane, fullname.ptr, 0, (flags) =>
    {
        flags.Expand();
        flags.DoubleBorder(LEFT | RIGHT | TOP);
    });
    addSpacer(totalpane, 0, 6);
    if (textinfos)
    {
        addSizer(totalpane, textinfos.ptr, 0, (flags) =>
        {
            flags.Expand();
            flags.DoubleHorzBorder();
        });
    }
    addSpacer(totalpane, 0, 10);
    if (statistics)
    {
        addSizer(totalpane, statistics.ptr, 0, (flags) =>
        {
            flags.Expand();
            flags.DoubleHorzBorder();
        });
    }
    addSpacer(totalpane, 0, 6);

    const okButton = withString("OK", (text) =>
        createWxButton(dialog.ptr, ID_OK, text, -1, -1, -1, -1, 0));
    if (okButton)
    {
        okButton.SetDefault();
        addWindow(totalpane, okButton.ptr, 0, (flags) =>
        {
            flags.Center();
            flags.DoubleBorder(ALL);
        });
    }

    dialog.SetSizerAndFit(totalpane.ptr, true);
    dialog.ShowModal();
    dialog.Destroy();
}
