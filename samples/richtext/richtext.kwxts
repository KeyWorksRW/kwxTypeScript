// ---------------------------------------------------------------------------
// state
// ---------------------------------------------------------------------------

interface RichTextState
{
    frame: wxFrame;
    ctrl: kwxRichTextCtrl;
    lock: LockState;
    styleList: wxRichTextStyleListCtrl | null;
    styleCombo: wxRichTextStyleComboCtrl | null;
    sheet: wxRichTextStyleSheet;
    printing: wxRichTextPrinting | null;
    assets: RichTextAssets;
    bundles: wxBitmapBundle[];
    bitmaps: wxBitmap[];
    callbacks: Callback[];
    closures: wxClosure[];
}

/** wxRichTextStyleSheet* gs_AlternateStyleSheet (MyFrame::OnSwitchStyleSheets). */
let alternateStyleSheet: wxRichTextStyleSheet | null = null;

/** Bitmaps handed to the field types (wxRichTextFieldTypeStandard owns copies). */
const fieldBundles: wxBitmapBundle[] = [];
const fieldBitmaps: wxBitmap[] = [];

// ---------------------------------------------------------------------------
// menu/toolbar helpers
// ---------------------------------------------------------------------------

function newMenu(): wxMenu | null
{
    return withString("", (title) => createWxMenu(title, 0n));
}

function append(menu: wxMenu, id: number, text: string, help: string = ""): void
{
    withString(text, (label) =>
    {
        if (help !== "")
        {
            withString(help, (hint) => menu.Append(id, label, hint, false));
        }
        else
        {
            menu.Append(id, label, null, false);
        }
    });
}

function appendCheck(menu: wxMenu, id: number, text: string): void
{
    withString(text, (label) => menu.AppendCheckItem(id, label, null));
}

function addTool(
    toolBar: ReturnType<typeof createWxToolBar>,
    id: number,
    bitmap: wxBitmap | null,
    shortHelp: string,
): void
{
    if (!toolBar || !bitmap)
    {
        return;
    }
    withString("", (label) =>
    {
        withString(shortHelp, (short) =>
        {
            withString("", (long) =>
            {
                toolBar.AddTool(
                    id, label, bitmap.ptr, Null_Bitmap(), ITEM_NORMAL,
                    short, long, null,
                );
            });
        });
    });
}

function addCheckTool(
    toolBar: ReturnType<typeof createWxToolBar>,
    id: number,
    bitmap: wxBitmap | null,
    shortHelp: string,
): void
{
    if (!toolBar || !bitmap)
    {
        return;
    }
    withString("", (label) =>
    {
        withString(shortHelp, (short) =>
        {
            toolBar.AddCheckTool(
                id, label, bitmap.ptr, Null_Bitmap(), short, null,
            );
        });
    });
}

// ---------------------------------------------------------------------------
// MyApp::CreateStyles()
// ---------------------------------------------------------------------------

/** Face name of a wxFontInfo(pointSize).Family(family) font. */
function fontFaceName(family: number): string
{
    const font = withString("", (face) =>
        createWxFont(
            12, family, FONTSTYLE_NORMAL, FONTWEIGHT_NORMAL,
            false, face, FONTENCODING_DEFAULT,
        ));
    if (!font)
    {
        return "";
    }
    let name = "";
    const faceName = font.GetFaceName();
    if (faceName)
    {
        name = readAndDeleteWxString(faceName.ptr);
    }
    font.Delete();
    return name;
}

function createStyles(): wxRichTextStyleSheet | null
{
    const sheet = createWxRichTextStyleSheet();
    if (!sheet)
    {
        return null;
    }

    const romanFace = fontFaceName(FONTFAMILY_ROMAN);
    const swissFace = fontFaceName(FONTFAMILY_SWISS);

    // ---- Paragraph styles -------------------------------------------------

    // "Normal"
    {
        const def = withString("Normal", (name) =>
            createWxRichTextParagraphStyleDefinition(name));
        const attr = createWxRichTextAttr();
        if (def && attr)
        {
            withString(romanFace, (face) => attr.SetFontFaceName(face));
            attr.SetFontSize(12);
            // Let's set all attributes for this style
            attr.SetFlags(BigInt(
                TEXT_ATTR_FONT | TEXT_ATTR_BACKGROUND_COLOUR | TEXT_ATTR_TEXT_COLOUR |
                    TEXT_ATTR_ALIGNMENT | TEXT_ATTR_LEFT_INDENT | TEXT_ATTR_RIGHT_INDENT |
                    TEXT_ATTR_TABS | TEXT_ATTR_PARA_SPACING_BEFORE |
                    TEXT_ATTR_PARA_SPACING_AFTER | TEXT_ATTR_LINE_SPACING |
                    TEXT_ATTR_BULLET_STYLE | TEXT_ATTR_BULLET_NUMBER,
            ));
            def.SetStyle(attr.ptr);
            sheet.AddParagraphStyle(def.ptr);
        }
        attr?.Delete();
    }

    // "Indented"
    {
        const def = withString("Indented", (name) =>
            createWxRichTextParagraphStyleDefinition(name));
        const attr = createWxRichTextAttr();
        if (def && attr)
        {
            withString(romanFace, (face) => attr.SetFontFaceName(face));
            attr.SetFontSize(12);
            attr.SetLeftIndent(100, 0);
            // We only want to affect indentation
            attr.SetFlags(BigInt(TEXT_ATTR_LEFT_INDENT | TEXT_ATTR_RIGHT_INDENT));
            def.SetStyle(attr.ptr);
            sheet.AddParagraphStyle(def.ptr);
        }
        attr?.Delete();
    }

    // "Red Bold Indented"
    {
        const def = withString("Red Bold Indented", (name) =>
            createWxRichTextParagraphStyleDefinition(name));
        const attr = createWxRichTextAttr();
        if (def && attr)
        {
            withString(romanFace, (face) => attr.SetFontFaceName(face));
            attr.SetFontSize(12);
            attr.SetFontWeight(FONTWEIGHT_BOLD);
            attr.SetTextColour(RED);
            attr.SetFontSize(12);
            attr.SetLeftIndent(100, 0);
            // We want to affect indentation, font and text colour
            attr.SetFlags(BigInt(
                TEXT_ATTR_LEFT_INDENT | TEXT_ATTR_RIGHT_INDENT | TEXT_ATTR_FONT |
                    TEXT_ATTR_TEXT_COLOUR,
            ));
            def.SetStyle(attr.ptr);
            sheet.AddParagraphStyle(def.ptr);
        }
        attr?.Delete();
    }

    // "First Line Indented"
    {
        const def = withString("First Line Indented", (name) =>
            createWxRichTextParagraphStyleDefinition(name));
        const attr = createWxRichTextAttr();
        if (def && attr)
        {
            withString(swissFace, (face) => attr.SetFontFaceName(face));
            attr.SetFontSize(12);
            attr.SetLeftIndent(100, -100);
            // We only want to affect indentation
            attr.SetFlags(BigInt(TEXT_ATTR_LEFT_INDENT | TEXT_ATTR_RIGHT_INDENT));
            def.SetStyle(attr.ptr);
            sheet.AddParagraphStyle(def.ptr);
        }
        attr?.Delete();
    }

    // ---- Character styles -------------------------------------------------

    // "Bold"
    {
        const def = withString("Bold", (name) =>
            createWxRichTextCharacterStyleDefinition(name));
        const attr = createWxRichTextAttr();
        if (def && attr)
        {
            withString(romanFace, (face) => attr.SetFontFaceName(face));
            attr.SetFontSize(12);
            attr.SetFontWeight(FONTWEIGHT_BOLD);
            // We only want to affect boldness
            attr.SetFlags(BigInt(TEXT_ATTR_FONT_WEIGHT));
            def.SetStyle(attr.ptr);
            sheet.AddCharacterStyle(def.ptr);
        }
        attr?.Delete();
    }

    // "Italic"
    {
        const def = withString("Italic", (name) =>
            createWxRichTextCharacterStyleDefinition(name));
        const attr = createWxRichTextAttr();
        if (def && attr)
        {
            withString(romanFace, (face) => attr.SetFontFaceName(face));
            attr.SetFontSize(12);
            attr.SetFontStyle(FONTSTYLE_ITALIC);
            // We only want to affect italics
            attr.SetFlags(BigInt(TEXT_ATTR_FONT_ITALIC));
            def.SetStyle(attr.ptr);
            sheet.AddCharacterStyle(def.ptr);
        }
        attr?.Delete();
    }

    // "Red Bold"
    {
        const def = withString("Red Bold", (name) =>
            createWxRichTextCharacterStyleDefinition(name));
        const attr = createWxRichTextAttr();
        if (def && attr)
        {
            withString(romanFace, (face) => attr.SetFontFaceName(face));
            attr.SetFontSize(12);
            attr.SetFontWeight(FONTWEIGHT_BOLD);
            attr.SetTextColour(RED);
            // We only want to affect colour, weight and face
            attr.SetFlags(BigInt(
                TEXT_ATTR_FONT_FACE | TEXT_ATTR_FONT_WEIGHT | TEXT_ATTR_TEXT_COLOUR,
            ));
            def.SetStyle(attr.ptr);
            sheet.AddCharacterStyle(def.ptr);
        }
        attr?.Delete();
    }

    // ---- List styles ------------------------------------------------------

    // "Bullet List 1"
    {
        const def = withString("Bullet List 1", (name) =>
            createWxRichTextListStyleDefinition(name));
        if (def)
        {
            for (let level = 0; level < 10; level++)
            {
                let bulletText: string;
                if (level === 0)
                {
                    bulletText = "standard/circle";
                }
                else if (level === 1)
                {
                    bulletText = "standard/square";
                }
                else if (level === 2)
                {
                    bulletText = "standard/circle";
                }
                else if (level === 3)
                {
                    bulletText = "standard/square";
                }
                else
                {
                    bulletText = "standard/circle";
                }

                withString(bulletText, (symbol) =>
                    def.SetAttributes(
                        level, (level + 1) * 60, 60,
                        TEXT_ATTR_BULLET_STYLE_STANDARD, symbol,
                    ));
            }
            sheet.AddListStyle(def.ptr);
        }
    }

    // "Numbered List 1"
    {
        const def = withString("Numbered List 1", (name) =>
            createWxRichTextListStyleDefinition(name));
        if (def)
        {
            for (let level = 0; level < 10; level++)
            {
                let numberStyle: number;
                if (level === 0)
                {
                    numberStyle = TEXT_ATTR_BULLET_STYLE_ARABIC |
                        TEXT_ATTR_BULLET_STYLE_PERIOD;
                }
                else if (level === 1)
                {
                    numberStyle = TEXT_ATTR_BULLET_STYLE_LETTERS_LOWER |
                        TEXT_ATTR_BULLET_STYLE_PARENTHESES;
                }
                else if (level === 2)
                {
                    numberStyle = TEXT_ATTR_BULLET_STYLE_ROMAN_LOWER |
                        TEXT_ATTR_BULLET_STYLE_PARENTHESES;
                }
                else if (level === 3)
                {
                    numberStyle = TEXT_ATTR_BULLET_STYLE_ROMAN_UPPER |
                        TEXT_ATTR_BULLET_STYLE_PARENTHESES;
                }
                else
                {
                    numberStyle = TEXT_ATTR_BULLET_STYLE_ARABIC |
                        TEXT_ATTR_BULLET_STYLE_PERIOD;
                }

                numberStyle |= TEXT_ATTR_BULLET_STYLE_ALIGN_RIGHT;

                // bulletSymbol is dereferenced by the binding, so pass an empty
                // string rather than null (the C++ default argument).
                withString("", (symbol) =>
                    def.SetAttributes(level, (level + 1) * 60, 60, numberStyle, symbol));
            }
            sheet.AddListStyle(def.ptr);
        }
    }

    // "Outline List 1"
    {
        const def = withString("Outline List 1", (name) =>
            createWxRichTextListStyleDefinition(name));
        if (def)
        {
            for (let level = 0; level < 10; level++)
            {
                let numberStyle: number;
                if (level < 4)
                {
                    numberStyle = TEXT_ATTR_BULLET_STYLE_OUTLINE |
                        TEXT_ATTR_BULLET_STYLE_PERIOD;
                }
                else
                {
                    numberStyle = TEXT_ATTR_BULLET_STYLE_ARABIC |
                        TEXT_ATTR_BULLET_STYLE_PERIOD;
                }

                withString("", (symbol) =>
                    def.SetAttributes(level, (level + 1) * 120, 120, numberStyle, symbol));
            }
            sheet.AddListStyle(def.ptr);
        }
    }

    return sheet;
}

// ---------------------------------------------------------------------------
// frame construction (MyFrame::MyFrame)
// ---------------------------------------------------------------------------

function createMainFrame(
    sheet: wxRichTextStyleSheet,
    lock: LockState,
): RichTextState | null
{
    // wxSize size = wxGetDisplaySize(); size.Scale(0.75, 0.75);
    let width = 800;
    let height = 600;
    let displayWidth = 800;
    let displayHeight = 600;
    const displayPtr = wxGetDisplaySize();
    if (displayPtr)
    {
        const display = new wxSize(displayPtr, true);
        displayWidth = display.GetWidth();
        displayHeight = display.GetHeight();
        width = Math.floor(displayWidth * 0.75);
        height = Math.floor(displayHeight * 0.75);
    }

    const frame = withString("wxRichTextCtrl Sample", (title) =>
        createWxFrame(
            null, ID_ANY, title, -1, -1, width, height, DEFAULT_FRAME_STYLE,
        ));
    if (!frame)
    {
        return null;
    }

    const state: RichTextState = {
        frame,
        ctrl: null as unknown as kwxRichTextCtrl,
        lock,
        styleList: null,
        styleCombo: null,
        sheet,
        printing: null,
        assets: { bitmap: () => null },
        bundles: [],
        bitmaps: [],
        callbacks: [],
        closures: [],
    };

    // SetIcon(wxICON(sample)) — ../sample.xpm converted to sample.svg.
    const frameIconBundle = loadSvgBundle("sample.svg", 32, 32);
    if (frameIconBundle)
    {
        state.bundles.push(frameIconBundle);
        const iconBitmap = frameIconBundle.GetBitmap(32, 32);
        if (iconBitmap)
        {
            state.bitmaps.push(iconBitmap);
            const icon = createWxIconDefault();
            if (icon)
            {
                icon.CopyFromBitmap(iconBitmap.ptr);
                frame.SetIcon(icon.ptr);
            }
        }
    }

    // ---- menus ------------------------------------------------------------
    const fileMenu = newMenu();
    const editMenu = newMenu();
    const formatMenu = newMenu();
    const listsMenu = newMenu();
    const tableMenu = newMenu();
    const insertMenu = newMenu();
    const helpMenu = newMenu();

    if (helpMenu)
    {
        append(helpMenu, ID_ABOUT, "&About\tF1", "Show about dialog");
    }

    if (fileMenu)
    {
        append(fileMenu, ID_OPEN, "&Open\tCtrl+O", "Open a file");
        append(fileMenu, ID_SAVE, "&Save\tCtrl+S", "Save a file");
        append(fileMenu, ID_SAVEAS, "&Save As...\tF12", "Save to a new file");
        fileMenu.AppendSeparator();
        append(fileMenu, ID_RELOAD, "&Reload Text\tF2", "Reload the initial text");
        fileMenu.AppendSeparator();
        append(fileMenu, ID_PAGE_SETUP, "Page Set&up...", "Page setup");
        append(fileMenu, ID_PRINT, "&Print...\tCtrl+P", "Print");
        append(fileMenu, ID_PREVIEW, "Print Pre&view", "Print preview");
        fileMenu.AppendSeparator();
        append(fileMenu, ID_VIEW_HTML, "&View as HTML", "View HTML");
        fileMenu.AppendSeparator();
        append(fileMenu, ID_EXIT, "E&xit\tAlt+X", "Quit this program");
    }

    if (editMenu)
    {
        append(editMenu, ID_UNDO, "&Undo\tCtrl+Z");
        append(editMenu, ID_REDO, "&Redo\tCtrl+Y");
        editMenu.AppendSeparator();
        append(editMenu, ID_CUT, "Cu&t\tCtrl+X");
        append(editMenu, ID_COPY, "&Copy\tCtrl+C");
        append(editMenu, ID_PASTE, "&Paste\tCtrl+V");
        editMenu.AppendSeparator();
        append(editMenu, ID_SELECTALL, "Select A&ll\tCtrl+A");
        editMenu.AppendSeparator();
        append(editMenu, ID_SET_FONT_SCALE, "Set &Text Scale...");
        append(editMenu, ID_SET_DIMENSION_SCALE, "Set &Dimension Scale...");
    }

    if (formatMenu)
    {
        appendCheck(formatMenu, ID_FORMAT_BOLD, "&Bold\tCtrl+B");
        appendCheck(formatMenu, ID_FORMAT_ITALIC, "&Italic\tCtrl+I");
        appendCheck(formatMenu, ID_FORMAT_UNDERLINE, "&Underline\tCtrl+U");
        formatMenu.AppendSeparator();
        appendCheck(formatMenu, ID_FORMAT_STRIKETHROUGH, "Stri&kethrough");
        appendCheck(formatMenu, ID_FORMAT_SUPERSCRIPT, "Superscrip&t");
        appendCheck(formatMenu, ID_FORMAT_SUBSCRIPT, "Subscrip&t");
        formatMenu.AppendSeparator();
        appendCheck(formatMenu, ID_FORMAT_ALIGN_LEFT, "L&eft Align");
        appendCheck(formatMenu, ID_FORMAT_ALIGN_RIGHT, "&Right Align");
        appendCheck(formatMenu, ID_FORMAT_ALIGN_CENTRE, "&Centre");
        formatMenu.AppendSeparator();
        append(formatMenu, ID_FORMAT_INDENT_MORE, "Indent &More");
        append(formatMenu, ID_FORMAT_INDENT_LESS, "Indent &Less");
        formatMenu.AppendSeparator();
        append(formatMenu, ID_FORMAT_PARAGRAPH_SPACING_MORE, "Increase Paragraph &Spacing");
        append(formatMenu, ID_FORMAT_PARAGRAPH_SPACING_LESS, "Decrease &Paragraph Spacing");
        formatMenu.AppendSeparator();
        append(formatMenu, ID_FORMAT_LINE_SPACING_SINGLE, "Normal Line Spacing");
        append(formatMenu, ID_FORMAT_LINE_SPACING_HALF, "1.5 Line Spacing");
        append(formatMenu, ID_FORMAT_LINE_SPACING_DOUBLE, "Double Line Spacing");
        formatMenu.AppendSeparator();
        append(formatMenu, ID_FORMAT_FONT, "&Font...");
        append(formatMenu, ID_FORMAT_IMAGE, "Image Property");
        append(formatMenu, ID_FORMAT_PARAGRAPH, "&Paragraph...");
        append(formatMenu, ID_FORMAT_CONTENT, "Font and Pa&ragraph...\tShift+Ctrl+F");
        formatMenu.AppendSeparator();
        append(formatMenu, ID_SWITCH_STYLE_SHEETS, "&Switch Style Sheets");
        append(formatMenu, ID_MANAGE_STYLES, "&Manage Styles");
    }

    if (listsMenu)
    {
        append(listsMenu, ID_FORMAT_BULLETS_AND_NUMBERING, "Bullets and &Numbering...");
        listsMenu.AppendSeparator();
        append(listsMenu, ID_FORMAT_NUMBER_LIST, "Number List");
        append(listsMenu, ID_FORMAT_ITEMIZE_LIST, "Itemize List");
        append(listsMenu, ID_FORMAT_RENUMBER_LIST, "Renumber List");
        append(listsMenu, ID_FORMAT_PROMOTE_LIST, "Promote List Items");
        append(listsMenu, ID_FORMAT_DEMOTE_LIST, "Demote List Items");
        append(listsMenu, ID_FORMAT_CLEAR_LIST, "Clear List Formatting");
    }

    if (tableMenu)
    {
        append(tableMenu, ID_TABLE_ADD_COLUMN, "&Add Column");
        append(tableMenu, ID_TABLE_ADD_ROW, "Add &Row");
        append(tableMenu, ID_TABLE_DELETE_COLUMN, "Delete &Column");
        append(tableMenu, ID_TABLE_DELETE_ROW, "&Delete Row");
    }

    if (insertMenu)
    {
        append(insertMenu, ID_INSERT_SYMBOL, "&Symbol...\tCtrl+I");
        append(insertMenu, ID_INSERT_URL, "&URL...");
        append(insertMenu, ID_INSERT_IMAGE, "&Image...");
    }

    const menuBar = createWxMenuBar(0);
    if (menuBar)
    {
        if (fileMenu) withString("&File", (t) => menuBar.Append(fileMenu.ptr, t));
        if (editMenu) withString("&Edit", (t) => menuBar.Append(editMenu.ptr, t));
        if (formatMenu) withString("F&ormat", (t) => menuBar.Append(formatMenu.ptr, t));
        if (listsMenu) withString("&Lists", (t) => menuBar.Append(listsMenu.ptr, t));
        if (tableMenu) withString("&Tables", (t) => menuBar.Append(tableMenu.ptr, t));
        if (insertMenu) withString("&Insert", (t) => menuBar.Append(insertMenu.ptr, t));
        if (helpMenu) withString("&Help", (t) => menuBar.Append(helpMenu.ptr, t));
        frame.SetMenuBar(menuBar.ptr);
    }

    // ---- status bar -------------------------------------------------------
    // bool is_pda = wxSystemSettings::GetScreenType() <= wxSYS_SCREEN_PDA;
    const isPda = wxSystemSettings_GetScreenType() <= SYS_SCREEN_PDA;

    if (!isPda)
    {
        frame.CreateStatusBar(2, STB_DEFAULT_STYLE, ID_ANY);
        withString("Welcome to wxRichTextCtrl!", (text) => frame.SetStatusText(text, 0));
    }

    // ---- sizer, toolbar ---------------------------------------------------
    const sizer = createWxBoxSizer(VERTICAL);
    if (sizer)
    {
        frame.SetSizer(sizer.ptr, true);
    }

    // On Mac, don't create a 'native' wxToolBar because small bitmaps are not
    // supported by native toolbars.
    withString("mac.toolbar.no-native", (name) => wxSystemOptions_SetOptionInt(name, 1));

    const toolBar = createWxToolBar(
        frame.ptr, ID_ANY, -1, -1, -1, -1,
        BORDER_NONE | TB_FLAT | TB_NODIVIDER | TB_NOALIGN,
    );
    if (toolBar && sizer)
    {
        sizer.AddWindow(toolBar.ptr, 0, EXPAND, 0, null);
    }

    // Asset accessor backed by the converted SVG files.
    const bitmapCache = new Map<string, wxBitmap>();
    state.assets =
    {
        bitmap: (name: string, w: number, h: number): wxBitmap | null =>
        {
            const key = name + ":" + w + "x" + h;
            const cached = bitmapCache.get(key);
            if (cached)
            {
                return cached;
            }
            const bundle = loadSvgBundle(name, w, h);
            if (!bundle)
            {
                return null;
            }
            state.bundles.push(bundle);
            const bitmap = bundle.GetBitmap(w, h);
            if (!bitmap)
            {
                return null;
            }
            state.bitmaps.push(bitmap);
            bitmapCache.set(key, bitmap);
            return bitmap;
        },
    };

    if (toolBar)
    {
        addTool(toolBar, ID_OPEN, state.assets.bitmap("open.svg", 16, 16), "Open");
        addTool(toolBar, ID_SAVEAS, state.assets.bitmap("save.svg", 16, 16), "Save");
        toolBar.AddSeparator();
        addTool(toolBar, ID_CUT, state.assets.bitmap("cut.svg", 16, 16), "Cut");
        addTool(toolBar, ID_COPY, state.assets.bitmap("copy.svg", 16, 16), "Copy");
        addTool(toolBar, ID_PASTE, state.assets.bitmap("paste.svg", 16, 16), "Paste");
        toolBar.AddSeparator();
        addTool(toolBar, ID_UNDO, state.assets.bitmap("undo.svg", 16, 16), "Undo");
        addTool(toolBar, ID_REDO, state.assets.bitmap("redo.svg", 16, 16), "Redo");
        toolBar.AddSeparator();
        addCheckTool(toolBar, ID_FORMAT_BOLD, state.assets.bitmap("bold.svg", 16, 16), "Bold");
        addCheckTool(toolBar, ID_FORMAT_ITALIC, state.assets.bitmap("italic.svg", 16, 16), "Italic");
        addCheckTool(toolBar, ID_FORMAT_UNDERLINE, state.assets.bitmap("underline.svg", 16, 16), "Underline");
        toolBar.AddSeparator();
        addCheckTool(toolBar, ID_FORMAT_ALIGN_LEFT, state.assets.bitmap("alignleft.svg", 16, 16), "Align Left");
        addCheckTool(toolBar, ID_FORMAT_ALIGN_CENTRE, state.assets.bitmap("centre.svg", 16, 16), "Centre");
        addCheckTool(toolBar, ID_FORMAT_ALIGN_RIGHT, state.assets.bitmap("alignright.svg", 16, 16), "Align Right");
        toolBar.AddSeparator();
        addTool(toolBar, ID_FORMAT_INDENT_LESS, state.assets.bitmap("indentless.svg", 16, 16), "Indent Less");
        addTool(toolBar, ID_FORMAT_INDENT_MORE, state.assets.bitmap("indentmore.svg", 16, 16), "Indent More");
        toolBar.AddSeparator();
        addTool(toolBar, ID_FORMAT_FONT, state.assets.bitmap("font.svg", 16, 16), "Font");
        toolBar.AddSeparator();

        // wxRichTextStyleComboCtrl* combo = new wxRichTextStyleComboCtrl(
        //     toolBar, ID_RICHTEXT_STYLE_COMBO, wxDefaultPosition,
        //     wxSize(160, -1), wxCB_READONLY);
        state.styleCombo = createWxRichTextStyleComboCtrl(
            toolBar.ptr, ID_RICHTEXT_STYLE_COMBO, -1, -1, 160, -1,
            BigInt(CB_READONLY),
        );
        if (state.styleCombo)
        {
            toolBar.AddControl(state.styleCombo.ptr);
        }

        toolBar.Realize();
    }

    // ---- splitter, editor, style list -------------------------------------
    const splitter = createWxSplitterWindow(
        frame.ptr, ID_ANY, -1, -1, -1, -1, SP_LIVE_UPDATE,
    );
    if (splitter && sizer)
    {
        sizer.AddWindow(splitter.ptr, 1, EXPAND, 0, null);
    }

    // m_richTextCtrl = new MyRichTextCtrl(splitter, ID_RICHTEXT_CTRL, ...)
    // createKwxRichTextCtrl is the hookable wxRichTextCtrl subclass.
    const ctrl = createKwxRichTextCtrl(
        splitter ? splitter.ptr : frame.ptr, ID_RICHTEXT_CTRL,
        -1, -1, -1, -1, VSCROLL | HSCROLL,
    );
    if (!ctrl)
    {
        frame.Destroy();
        return null;
    }
    state.ctrl = ctrl;

    // MyRichTextCtrl::CanDeleteRange / CanInsertContent.
    bindControlHooks(ctrl, lock, state.callbacks);

    const font = withString("", (faceName) =>
        createWxFont(
            12, FONTFAMILY_ROMAN, FONTSTYLE_NORMAL, FONTWEIGHT_NORMAL,
            false, faceName, FONTENCODING_DEFAULT,
        ));
    if (font)
    {
        ctrl.SetFont(font.ptr);
        font.Delete();
    }

    // m_richTextCtrl->SetMargins(10, 10);
    // wxRichTextCtrl reaches wxTextEntryBase through a non-primary base, so the
    // method is emitted on the wxTextEntry wrapper; kwxFFI cross-casts the
    // window pointer through wxWindow* + dynamic_cast (src/wx_textentry.cpp).
    wrapWxTextEntry(ctrl.ptr).SetMargins(10, 10);

    // m_richTextCtrl->SetStyleSheet(wxGetApp().GetStyleSheet());
    ctrl.SetStyleSheet(sheet.ptr);

    if (state.styleCombo)
    {
        state.styleCombo.SetStyleSheet(sheet.ptr);
        state.styleCombo.SetRichTextCtrl(ctrl.ptr);
        state.styleCombo.UpdateStyles();
    }

    const styleList = createWxRichTextStyleListCtrl(
        splitter ? splitter.ptr : frame.ptr, ID_RICHTEXT_STYLE_LIST,
        -1, -1, -1, -1, 0n,
    );
    state.styleList = styleList;

    if (splitter && styleList)
    {
        if (isPda && displayWidth < displayHeight)
        {
            splitter.SplitHorizontally(ctrl.ptr, styleList.ptr, 0);
        }
        else
        {
            const clientSize = frame.GetClientSize();
            const splitWidth = clientSize
                ? Math.floor(clientSize.GetWidth() * 4 / 5)
                : 0;
            splitter.SplitVertically(ctrl.ptr, styleList.ptr, splitWidth);
            splitter.SetSashGravity(0.8);
        }
    }

    frame.Layout();
    if (splitter)
    {
        splitter.UpdateSize();
    }

    if (styleList)
    {
        styleList.SetStyleSheet(sheet.ptr);
        styleList.SetRichTextCtrl(ctrl.ptr);
        styleList.UpdateStyles();
    }

    // ---- printing (MyApp::OnInit) -----------------------------------------
    withString("Test Document", (name) =>
    {
        state.printing = createWxRichTextPrinting(name, frame.ptr);
    });
    if (state.printing)
    {
        withString("@TITLE@", (text) =>
            state.printing!.SetFooterText(
                text, RICHTEXT_PAGE_ALL, RICHTEXT_PAGE_CENTRE,
            ));
        withString("Page @PAGENUM@", (text) =>
            state.printing!.SetFooterText(
                text, RICHTEXT_PAGE_ALL, RICHTEXT_PAGE_RIGHT,
            ));
    }

    writeInitialText(ctrl, state.assets, lock);

    return state;
}

// ---------------------------------------------------------------------------
// event handlers
// ---------------------------------------------------------------------------

function showAbout(state: RichTextState): void
{
    message(
        "This is a demo for wxRichTextCtrl, a control for editing styled text.\n" +
            "(c) Julian Smart, 2005",
        "About wxRichTextCtrl Sample",
        state.frame.ptr,
    );
}

/** wxRichTextBuffer::GetExtWildcard() + "All files" suffix. */
function extensionFilter(save: boolean, fileTypes: number[]): string
{
    const types = createWxArrayInt();
    const filterPtr = wxRichTextBuffer_GetExtWildcard(
        false, save, types ? types.ptr : null,
    );
    let filter = filterPtr ? readAndDeleteWxString(filterPtr) : "";
    if (types)
    {
        const count = types.GetCount();
        for (let i = 0; i < count; i++)
        {
            fileTypes.push(types.Item(i));
        }
        types.Delete();
    }

    if (filter !== "")
    {
        filter += "|";
    }
    if (!save)
    {
        filter += "All files (*.*)|*.*";
    }
    return filter;
}

function openFile(state: RichTextState): void
{
    const fileTypes: number[] = [];
    const filter = extensionFilter(false, fileTypes);

    const dialog = withString("Choose a filename", (caption) =>
        withString(filter, (wildcard) =>
            withString("", (empty) =>
                createWxFileDialog(
                    state.frame.ptr, caption, empty, empty, wildcard,
                    -1, -1, FD_OPEN, -1, -1,
                ))));
    if (!dialog)
    {
        return;
    }

    if (dialog.ShowModal() === ID_OK)
    {
        const path = dialog.GetPath();
        if (path)
        {
            const fileName = readAndDeleteWxString(path.ptr);
            if (fileName !== "")
            {
                const index = dialog.GetFilterIndex();
                const fileType = index < fileTypes.length
                    ? fileTypes[index]
                    : RICHTEXT_TYPE_TEXT;
                withString(fileName, (file) => state.ctrl.LoadFile(file, fileType));
            }
        }
    }

    dialog.Destroy();
}

function saveFile(state: RichTextState): void
{
    const filename = state.ctrl.GetFilename();
    const name = filename ? readAndDeleteWxString(filename.ptr) : "";
    if (name === "")
    {
        saveFileAs(state);
        return;
    }
    withString(name, (file) => state.ctrl.SaveFile(file, 0));
}

function saveFileAs(state: RichTextState): void
{
    const fileTypes: number[] = [];
    const filter = extensionFilter(true, fileTypes);

    const dialog = withString("Choose a filename", (caption) =>
        withString(filter, (wildcard) =>
            withString("", (empty) =>
                createWxFileDialog(
                    state.frame.ptr, caption, empty, empty, wildcard,
                    -1, -1, FD_SAVE, -1, -1,
                ))));
    if (!dialog)
    {
        return;
    }

    if (dialog.ShowModal() === ID_OK)
    {
        const path = dialog.GetPath();
        if (path)
        {
            const fileName = readAndDeleteWxString(path.ptr);
            if (fileName !== "")
            {
                const started = Date.now();
                withString(fileName, (file) => state.ctrl.SaveFile(file, 0));
                const elapsed = Date.now() - started;
                message("Saving took " + elapsed + "ms", "", state.frame.ptr);
            }
        }
    }

    dialog.Destroy();
}

function applyIndent(state: RichTextState, delta: number): void
{
    const attr = createWxRichTextAttr();
    if (!attr)
    {
        return;
    }

    attr.SetFlags(BigInt(TEXT_ATTR_LEFT_INDENT));
    if (state.ctrl.GetStyle(state.ctrl.GetInsertionPoint(), attr.ptr))
    {
        const insertion = Number(state.ctrl.GetInsertionPoint());
        const range = state.ctrl.HasSelection()
            ? selectionRange(state.ctrl)
            : { start: insertion, end: insertion };

        const indent = Number(attr.GetLeftIndent()) + delta;
        if (delta > 0 || Number(attr.GetLeftIndent()) > 0)
        {
            attr.SetLeftIndent(Math.max(0, indent), 0);
            attr.SetFlags(BigInt(TEXT_ATTR_LEFT_INDENT));
            state.ctrl.SetStyle(BigInt(range.start), BigInt(range.end), attr.ptr);
        }
    }

    attr.Delete();
}

function applyLineSpacing(state: RichTextState, spacing: number): void
{
    const attr = createWxRichTextAttr();
    if (!attr)
    {
        return;
    }

    attr.SetFlags(BigInt(TEXT_ATTR_LINE_SPACING));
    if (state.ctrl.GetStyle(state.ctrl.GetInsertionPoint(), attr.ptr))
    {
        const insertion = Number(state.ctrl.GetInsertionPoint());
        const range = state.ctrl.HasSelection()
            ? selectionRange(state.ctrl)
            : { start: insertion, end: insertion };

        attr.SetFlags(BigInt(TEXT_ATTR_LINE_SPACING));
        attr.SetLineSpacing(spacing);
        state.ctrl.SetStyle(BigInt(range.start), BigInt(range.end), attr.ptr);
    }

    attr.Delete();
}

function applyParagraphSpacing(state: RichTextState, more: boolean): void
{
    const attr = createWxRichTextAttr();
    if (!attr)
    {
        return;
    }

    attr.SetFlags(BigInt(TEXT_ATTR_PARA_SPACING_AFTER));
    if (state.ctrl.GetStyle(state.ctrl.GetInsertionPoint(), attr.ptr))
    {
        const insertion = Number(state.ctrl.GetInsertionPoint());
        const range = state.ctrl.HasSelection()
            ? selectionRange(state.ctrl)
            : { start: insertion, end: insertion };

        const current = attr.GetParagraphSpacingAfter();
        if (more)
        {
            attr.SetParagraphSpacingAfter(current + 20);
            attr.SetFlags(BigInt(TEXT_ATTR_PARA_SPACING_AFTER));
            state.ctrl.SetStyle(BigInt(range.start), BigInt(range.end), attr.ptr);
        }
        else if (current >= 20)
        {
            attr.SetParagraphSpacingAfter(current - 20);
            attr.SetFlags(BigInt(TEXT_ATTR_PARA_SPACING_AFTER));
            state.ctrl.SetStyle(BigInt(range.start), BigInt(range.end), attr.ptr);
        }
    }

    attr.Delete();
}

/** Selection range used by the formatting dialogs. */
function formattingRange(ctrl: wxRichTextCtrl): { start: number; end: number }
{
    if (ctrl.HasSelection())
    {
        return selectionRange(ctrl);
    }
    return { start: 0, end: Number(ctrl.GetLastPosition()) + 1 };
}

// ---------------------------------------------------------------------------
// MyRichTextCtrl::FindCurrentPosition / FindTable
// ---------------------------------------------------------------------------

function findCurrentPosition(ctrl: wxRichTextCtrl): wxRichTextObject | null
{
    let position = -1;

    if (ctrl.HasSelection())
    {
        // range.ToInternal().GetLength() == 1
        const range = selectionRange(ctrl);
        if (range.end - range.start === 1)
        {
            position = range.start;
        }
    }
    if (position === -1)
    {
        // wxRichTextCtrl::GetCaretPosition() returns m_caretPosition while
        // GetInsertionPoint() returns m_caretPosition + 1, so subtracting one
        // yields the same value.
        position = Number(
            ctrl.GetAdjustedCaretPosition(ctrl.GetInsertionPoint() - 1n),
        );
    }

    const focus = ctrl.GetFocusObject();
    if (!focus)
    {
        return null;
    }
    const raw = focus.GetLeafObjectAtPosition(BigInt(position));
    if (!raw)
    {
        return null;
    }
    return new wxRichTextObject(raw, true);
}

function findTable(ctrl: wxRichTextCtrl): wxRichTextTable | null
{
    let obj = findCurrentPosition(ctrl);
    while (obj)
    {
        if (isRichTextObjectKind(obj, "wxRichTextTable"))
        {
            return new wxRichTextTable(obj.ptr, true);
        }
        obj = obj.GetParent();
    }
    return null;
}

// ---------------------------------------------------------------------------
// table commands
// ---------------------------------------------------------------------------

function getCellAttribute(table: wxRichTextTable, row: number, column: number): wxRichTextAttr | null
{
    const cell = table.GetCell(row, column);
    if (!cell)
    {
        return null;
    }
    const attr = createWxRichTextAttr();
    if (!attr)
    {
        return null;
    }
    cell.GetAttributes(attr.ptr);
    return attr;
}

function tableAddColumn(ctrl: wxRichTextCtrl): void
{
    const table = findTable(ctrl);
    if (!table)
    {
        return;
    }
    const cellAttr = getCellAttribute(table, 0, 0);
    if (cellAttr)
    {
        table.AddColumns(table.GetColumnCount(), 1, cellAttr.ptr);
        cellAttr.Delete();
    }
}

function tableAddRow(ctrl: wxRichTextCtrl): void
{
    const table = findTable(ctrl);
    if (!table)
    {
        return;
    }
    const cellAttr = getCellAttribute(table, 0, 0);
    if (cellAttr)
    {
        table.AddRows(table.GetRowCount(), 1, cellAttr.ptr);
        cellAttr.Delete();
    }
}

function focusedCell(table: wxRichTextTable): { row: number; column: number }
{
    const rowBuffer = new Int32Array(1);
    const colBuffer = new Int32Array(1);
    table.GetFocusedCell(pointerOf(rowBuffer), pointerOf(colBuffer));
    return { row: rowBuffer[0], column: colBuffer[0] };
}

function tableDeleteColumn(ctrl: wxRichTextCtrl): void
{
    const table = findTable(ctrl);
    if (!table)
    {
        return;
    }
    let column = focusedCell(table).column;
    if (column === -1)
    {
        column = table.GetColumnCount() - 1;
    }
    table.DeleteColumns(column, 1);
}

function tableDeleteRow(ctrl: wxRichTextCtrl): void
{
    const table = findTable(ctrl);
    if (!table)
    {
        return;
    }
    let row = focusedCell(table).row;
    if (row === -1)
    {
        row = table.GetRowCount() - 1;
    }
    table.DeleteRows(row, 1);
}

// ---------------------------------------------------------------------------
// image property dialog
// ---------------------------------------------------------------------------

/** MyFrame::OnImage() */
function showImageProperties(state: RichTextState): void
{
    const ctrl = state.ctrl;
    const range = selectionRange(ctrl);
    if (range.end - range.start !== 1)
    {
        return;
    }

    const focus = ctrl.GetFocusObject();
    if (!focus)
    {
        return;
    }
    const raw = focus.GetLeafObjectAtPosition(BigInt(range.start));
    if (!raw)
    {
        return;
    }

    const image = new wxRichTextObject(raw, true);
    if (!isRichTextObjectKind(image, "wxRichTextImage"))
    {
        return;
    }

    const dialog = withString("", (caption) =>
        createWxRichTextObjectPropertiesDialog(
            image.ptr, state.frame.ptr, ID_ANY, caption,
            -1, -1, -1, -1, BigInt(DEFAULT_DIALOG_STYLE),
        ));
    if (!dialog)
    {
        return;
    }

    if (dialog.ShowModal() === ID_OK)
    {
        // imageDlg.ApplyStyle(m_richTextCtrl) — the one-argument overload
        // applies the dialog's attributes to the image's own range.
        dialog.ApplyStyleToCtrl(ctrl.ptr, RICHTEXT_SETSTYLE_WITH_UNDO);
    }

    dialog.Destroy();
}

// ---------------------------------------------------------------------------
// style sheet commands
// ---------------------------------------------------------------------------

/** MyFrame::OnSwitchStyleSheets() */
function switchStyleSheets(state: RichTextState): void
{
    const ctrl = state.ctrl;
    let sheet = ctrl.GetStyleSheet();

    // One-time creation of an alternate style sheet
    if (!alternateStyleSheet)
    {
        if (!sheet)
        {
            return;
        }
        alternateStyleSheet = createWxRichTextStyleSheetCopy(sheet.ptr);
        if (!alternateStyleSheet)
        {
            return;
        }

        // Make some modifications
        const count = Number(alternateStyleSheet.GetParagraphStyleCount());
        for (let i = 0; i < count; i++)
        {
            const def = alternateStyleSheet.GetParagraphStyle(BigInt(i));
            if (!def)
            {
                continue;
            }
            const style = def.GetStyle();
            if (!style)
            {
                continue;
            }

            if (style.HasTextColour())
            {
                style.SetTextColour(BLUE);
            }

            if (style.HasAlignment())
            {
                if (style.GetAlignment() === TEXT_ALIGNMENT_CENTRE)
                {
                    style.SetAlignment(TEXT_ALIGNMENT_RIGHT);
                }
                else if (style.GetAlignment() === TEXT_ALIGNMENT_LEFT)
                {
                    style.SetAlignment(TEXT_ALIGNMENT_CENTRE);
                }
            }
            if (style.HasLeftIndent())
            {
                style.SetLeftIndent(Number(style.GetLeftIndent()) * 2, 0);
            }
        }
    }

    // Switch sheets
    const tmp = alternateStyleSheet;
    alternateStyleSheet = sheet;
    sheet = tmp;
    if (!sheet)
    {
        return;
    }

    ctrl.SetStyleSheet(sheet.ptr);
    ctrl.ApplyStyleSheet(sheet.ptr); // Makes the control reflect the new style definitions

    if (state.styleList)
    {
        state.styleList.SetStyleSheet(sheet.ptr);
        state.styleList.UpdateStyles();
    }

    if (state.styleCombo)
    {
        state.styleCombo.SetStyleSheet(sheet.ptr);
        state.styleCombo.UpdateStyles();
    }
}

/** MyFrame::OnManageStyles() */
function manageStyles(state: RichTextState): void
{
    const sheet = state.ctrl.GetStyleSheet() ?? state.sheet;
    const flags = RICHTEXT_ORGANISER_CREATE_STYLES | RICHTEXT_ORGANISER_EDIT_STYLES;

    const dialog = withString("Style Manager", (caption) =>
        createWxRichTextStyleOrganiserDialog(
            flags, sheet.ptr, null, state.frame.ptr, ID_ANY, caption,
            -1, -1, -1, -1, BigInt(DEFAULT_DIALOG_STYLE),
        ));
    if (!dialog)
    {
        return;
    }

    dialog.ShowModal();
    dialog.Destroy();
}

/** MyFrame::OnBulletsAndNumbering() */
function bulletsAndNumbering(state: RichTextState): void
{
    const sheet = state.ctrl.GetStyleSheet() ?? state.sheet;

    const dialog = withString("Bullets and Numbering", (caption) =>
        createWxRichTextStyleOrganiserDialog(
            RICHTEXT_ORGANISER_BROWSE_NUMBERING, sheet.ptr, state.ctrl.ptr,
            state.frame.ptr, ID_ANY, caption, -1, -1, -1, -1,
            BigInt(DEFAULT_DIALOG_STYLE),
        ));
    if (!dialog)
    {
        return;
    }

    if (dialog.ShowModal() === ID_OK)
    {
        if (dialog.GetSelectedStyleDefinition())
        {
            dialog.ApplyStyle(state.ctrl.ptr);
        }
    }

    dialog.Destroy();
}

// ---------------------------------------------------------------------------
// menu dispatch
// ---------------------------------------------------------------------------

/** EVT_MENU dispatcher for the sample's own ids (100..145). */
function dispatchMenu(state: RichTextState, id: number): void
{
    const ctrl = state.ctrl;

    switch (id)
    {
        case ID_FORMAT_BOLD:
            ctrl.ApplyBoldToSelection();
            break;
        case ID_FORMAT_ITALIC:
            ctrl.ApplyItalicToSelection();
            break;
        case ID_FORMAT_UNDERLINE:
            ctrl.ApplyUnderlineToSelection();
            break;
        case ID_FORMAT_STRIKETHROUGH:
            ctrl.ApplyTextEffectToSelection(TEXT_ATTR_EFFECT_STRIKETHROUGH);
            break;
        case ID_FORMAT_SUPERSCRIPT:
            ctrl.ApplyTextEffectToSelection(TEXT_ATTR_EFFECT_SUPERSCRIPT);
            break;
        case ID_FORMAT_SUBSCRIPT:
            ctrl.ApplyTextEffectToSelection(TEXT_ATTR_EFFECT_SUBSCRIPT);
            break;
        case ID_FORMAT_ALIGN_LEFT:
            ctrl.ApplyAlignmentToSelection(TEXT_ALIGNMENT_LEFT);
            break;
        case ID_FORMAT_ALIGN_CENTRE:
            ctrl.ApplyAlignmentToSelection(TEXT_ALIGNMENT_CENTRE);
            break;
        case ID_FORMAT_ALIGN_RIGHT:
            ctrl.ApplyAlignmentToSelection(TEXT_ALIGNMENT_RIGHT);
            break;
        case ID_FORMAT_INDENT_MORE:
            applyIndent(state, 100);
            break;
        case ID_FORMAT_INDENT_LESS:
            applyIndent(state, -100);
            break;
        case ID_FORMAT_LINE_SPACING_HALF:
            applyLineSpacing(state, 15);
            break;
        case ID_FORMAT_LINE_SPACING_DOUBLE:
            applyLineSpacing(state, 20);
            break;
        case ID_FORMAT_LINE_SPACING_SINGLE:
            applyLineSpacing(state, 0);
            break;
        case ID_FORMAT_PARAGRAPH_SPACING_MORE:
            applyParagraphSpacing(state, true);
            break;
        case ID_FORMAT_PARAGRAPH_SPACING_LESS:
            applyParagraphSpacing(state, false);
            break;
        case ID_FORMAT_FONT:
        {
            const range = formattingRange(ctrl);
            showFormattingDialog(
                state.frame, ctrl, range.start, range.end, RICHTEXT_FORMAT_FONT,
                RICHTEXT_SETSTYLE_WITH_UNDO | RICHTEXT_SETSTYLE_OPTIMIZE |
                    RICHTEXT_SETSTYLE_CHARACTERS_ONLY,
                true,
            );
            break;
        }
        case ID_FORMAT_PARAGRAPH:
        {
            const range = formattingRange(ctrl);
            showFormattingDialog(
                state.frame, ctrl, range.start, range.end,
                RICHTEXT_FORMAT_INDENTS_SPACING | RICHTEXT_FORMAT_TABS |
                    RICHTEXT_FORMAT_BULLETS,
                RICHTEXT_SETSTYLE_WITH_UNDO | RICHTEXT_SETSTYLE_OPTIMIZE,
                false,
            );
            break;
        }
        case ID_FORMAT_CONTENT:
        {
            const range = formattingRange(ctrl);
            showFormattingDialog(
                state.frame, ctrl, range.start, range.end,
                RICHTEXT_FORMAT_FONT | RICHTEXT_FORMAT_INDENTS_SPACING |
                    RICHTEXT_FORMAT_TABS | RICHTEXT_FORMAT_BULLETS,
                RICHTEXT_SETSTYLE_WITH_UNDO | RICHTEXT_SETSTYLE_OPTIMIZE,
                false,
            );
            break;
        }
        case ID_FORMAT_IMAGE:
            showImageProperties(state);
            break;
        case ID_RELOAD:
            ctrl.Clear();
            writeInitialText(ctrl, state.assets, state.lock);
            break;
        case ID_INSERT_SYMBOL:
            showSymbolDialog(state.frame, ctrl);
            break;
        case ID_INSERT_URL:
            showInsertUrlDialog(state.frame, ctrl);
            break;
        case ID_INSERT_IMAGE:
            showInsertImageDialog(state.frame, ctrl);
            break;
        case ID_FORMAT_NUMBER_LIST:
            if (ctrl.HasSelection())
            {
                const range = selectionRange(ctrl);
                withString("Numbered List 1", (name) =>
                    ctrl.SetListStyle(
                        BigInt(range.start), BigInt(range.end), name,
                        RICHTEXT_SETSTYLE_WITH_UNDO | RICHTEXT_SETSTYLE_RENUMBER,
                        1, -1,
                    ));
            }
            break;
        case ID_FORMAT_BULLETS_AND_NUMBERING:
            bulletsAndNumbering(state);
            break;
        case ID_FORMAT_ITEMIZE_LIST:
            if (ctrl.HasSelection())
            {
                const range = selectionRange(ctrl);
                withString("Bullet List 1", (name) =>
                    ctrl.SetListStyle(
                        BigInt(range.start), BigInt(range.end), name,
                        RICHTEXT_SETSTYLE_WITH_UNDO, 1, -1,
                    ));
            }
            break;
        case ID_FORMAT_RENUMBER_LIST:
            if (ctrl.HasSelection())
            {
                const range = selectionRange(ctrl);
                ctrl.NumberList(
                    BigInt(range.start), BigInt(range.end), null,
                    RICHTEXT_SETSTYLE_WITH_UNDO | RICHTEXT_SETSTYLE_RENUMBER,
                    1, -1,
                );
            }
            break;
        case ID_FORMAT_PROMOTE_LIST:
            if (ctrl.HasSelection())
            {
                const range = selectionRange(ctrl);
                ctrl.PromoteList(
                    1, BigInt(range.start), BigInt(range.end), null,
                    RICHTEXT_SETSTYLE_WITH_UNDO, -1,
                );
            }
            break;
        case ID_FORMAT_DEMOTE_LIST:
            if (ctrl.HasSelection())
            {
                const range = selectionRange(ctrl);
                ctrl.PromoteList(
                    -1, BigInt(range.start), BigInt(range.end), null,
                    RICHTEXT_SETSTYLE_WITH_UNDO, -1,
                );
            }
            break;
        case ID_FORMAT_CLEAR_LIST:
            if (ctrl.HasSelection())
            {
                const range = selectionRange(ctrl);
                ctrl.ClearListStyle(
                    BigInt(range.start), BigInt(range.end),
                    RICHTEXT_SETSTYLE_WITH_UNDO,
                );
            }
            break;
        case ID_TABLE_ADD_COLUMN:
            tableAddColumn(ctrl);
            break;
        case ID_TABLE_ADD_ROW:
            tableAddRow(ctrl);
            break;
        case ID_TABLE_DELETE_COLUMN:
            tableDeleteColumn(ctrl);
            break;
        case ID_TABLE_DELETE_ROW:
            tableDeleteRow(ctrl);
            break;
        case ID_VIEW_HTML:
            showHtmlDialog(state.frame, ctrl);
            break;
        case ID_SWITCH_STYLE_SHEETS:
            switchStyleSheets(state);
            break;
        case ID_MANAGE_STYLES:
            manageStyles(state);
            break;
        case ID_PAGE_SETUP:
            showPageSetupTestDialog(state.frame);
            break;
        case ID_PRINT:
            if (state.printing)
            {
                const buffer = ctrl.GetBuffer();
                if (buffer)
                {
                    state.printing.PrintBuffer(buffer.ptr, true);
                }
            }
            break;
        case ID_PREVIEW:
            if (state.printing)
            {
                const buffer = ctrl.GetBuffer();
                if (buffer)
                {
                    state.printing.PreviewBuffer(buffer.ptr);
                }
            }
            break;
        case ID_SET_FONT_SCALE:
        {
            const value = formatG(ctrl.GetFontScale());
            const text = getTextFromUser(
                "Enter a text scale factor:", "Text Scale Factor",
                value, state.frame.ptr,
            );
            if (text !== "" && value !== text)
            {
                const parsed = parseFloat(text);
                ctrl.SetFontScale(Number.isNaN(parsed) ? 1.0 : parsed, true);
            }
            break;
        }
        case ID_SET_DIMENSION_SCALE:
        {
            const value = formatG(ctrl.GetDimensionScale());
            const text = getTextFromUser(
                "Enter a dimension scale factor:", "Dimension Scale Factor",
                value, state.frame.ptr,
            );
            if (text !== "" && value !== text)
            {
                const parsed = parseFloat(text);
                ctrl.SetDimensionScale(Number.isNaN(parsed) ? 1.0 : parsed, true);
            }
            break;
        }
        default:
            break;
    }
}

/** EVT_UPDATE_UI dispatcher for the sample's own ids (100..145). */
function dispatchUpdateUI(state: RichTextState, event: wxUpdateUIEvent, id: number): void
{
    const ctrl = state.ctrl;

    switch (id)
    {
        case ID_FORMAT_BOLD:
            event.Check(ctrl.IsSelectionBold());
            break;
        case ID_FORMAT_ITALIC:
            event.Check(ctrl.IsSelectionItalics());
            break;
        case ID_FORMAT_UNDERLINE:
            event.Check(ctrl.IsSelectionUnderlined());
            break;
        case ID_FORMAT_STRIKETHROUGH:
            event.Check(ctrl.DoesSelectionHaveTextEffectFlag(TEXT_ATTR_EFFECT_STRIKETHROUGH));
            break;
        case ID_FORMAT_SUPERSCRIPT:
            event.Check(ctrl.DoesSelectionHaveTextEffectFlag(TEXT_ATTR_EFFECT_SUPERSCRIPT));
            break;
        case ID_FORMAT_SUBSCRIPT:
            event.Check(ctrl.DoesSelectionHaveTextEffectFlag(TEXT_ATTR_EFFECT_SUBSCRIPT));
            break;
        case ID_FORMAT_ALIGN_LEFT:
            event.Check(ctrl.IsSelectionAligned(TEXT_ALIGNMENT_LEFT));
            break;
        case ID_FORMAT_ALIGN_CENTRE:
            event.Check(ctrl.IsSelectionAligned(TEXT_ALIGNMENT_CENTRE));
            break;
        case ID_FORMAT_ALIGN_RIGHT:
            event.Check(ctrl.IsSelectionAligned(TEXT_ALIGNMENT_RIGHT));
            break;
        case ID_FORMAT_CONTENT:
        case ID_FORMAT_FONT:
        case ID_FORMAT_PARAGRAPH:
            event.Enable(ctrl.HasSelection());
            break;
        case ID_FORMAT_IMAGE:
        {
            // MyFrame::OnUpdateImage()
            let enable = false;
            const range = selectionRange(ctrl);
            if (range.end - range.start === 1)
            {
                const focus = ctrl.GetFocusObject();
                if (focus)
                {
                    const raw = focus.GetLeafObjectAtPosition(BigInt(range.start));
                    if (raw)
                    {
                        enable = isRichTextObjectKind(
                            new wxRichTextObject(raw, true),
                            "wxRichTextImage",
                        );
                    }
                }
            }
            event.Enable(enable);
            break;
        }
        case ID_TABLE_ADD_COLUMN:
        case ID_TABLE_ADD_ROW:
            // OnTableFocusedUpdateUI
            event.Enable(findTable(ctrl) !== null);
            break;
        case ID_TABLE_DELETE_COLUMN:
        case ID_TABLE_DELETE_ROW:
        {
            // OnTableHasCellsUpdateUI
            let enable = false;
            const table = findTable(ctrl);
            if (table)
            {
                enable = id === ID_TABLE_DELETE_COLUMN
                    ? table.GetColumnCount() > 1
                    : table.GetRowCount() > 1;
            }
            event.Enable(enable);
            break;
        }
        default:
            break;
    }
}

function bindEvents(state: RichTextState): void
{
    const bind = (
        first: number,
        last: number,
        type: number,
        handler: (eventPtr: Pointer) => void,
    ): void =>
    {
        const callback = new Callback(
            { parameters: ["pointer", "pointer", "pointer"], result: "void" },
            (_closureFun, _data, eventPtr) =>
            {
                if (!eventPtr)
                {
                    return; // wxClosure's teardown sweep passes a null event
                }
                handler(eventPtr);
            },
        );
        const closure = createWxClosure(callback.pointer, null);
        if (!closure)
        {
            callback.close();
            return;
        }
        state.frame.Bind(first, last, type, closure.ptr);
        state.callbacks.push(callback);
        state.closures.push(closure);
    };

    // EVT_MENU_RANGE(ID_FORMAT_BOLD, ID_RICHTEXT_STYLE_COMBO) — every toolbar
    // tool uses the same ids (wxEVT_TOOL == wxEVT_MENU).
    bind(ID_FORMAT_BOLD, ID_RICHTEXT_STYLE_COMBO, EVT_MENU, (eventPtr) =>
    {
        if (!eventPtr) return;
        const event = new wxCommandEvent(eventPtr);
        dispatchMenu(state, event.GetId());
    });

    // EVT_UPDATE_UI_RANGE(ID_FORMAT_BOLD, ID_RICHTEXT_STYLE_COMBO), bound per
    // id because EVT_UPDATE_UI_RANGE is not exported.
    bind(ID_FORMAT_BOLD, ID_RICHTEXT_STYLE_COMBO, EVT_UPDATE_UI, (eventPtr) =>
    {
        if (!eventPtr) return;
        const event = new wxUpdateUIEvent(eventPtr);
        dispatchUpdateUI(state, event, event.GetId());
    });

    bind(ID_EXIT, ID_EXIT, EVT_MENU, () => state.frame.Close(true));
    bind(ID_ABOUT, ID_ABOUT, EVT_MENU, () => showAbout(state));
    bind(ID_OPEN, ID_OPEN, EVT_MENU, () => openFile(state));
    bind(ID_SAVE, ID_SAVE, EVT_MENU, () => saveFile(state));
    bind(ID_SAVEAS, ID_SAVEAS, EVT_MENU, () => saveFileAs(state));
    bind(ID_UNDO, ID_UNDO, EVT_MENU, () => state.ctrl.Undo());
    bind(ID_REDO, ID_REDO, EVT_MENU, () => state.ctrl.Redo());
    bind(ID_CUT, ID_CUT, EVT_MENU, () => state.ctrl.Cut());
    bind(ID_COPY, ID_COPY, EVT_MENU, () => state.ctrl.Copy());
    bind(ID_PASTE, ID_PASTE, EVT_MENU, () => state.ctrl.Paste());
    bind(ID_SELECTALL, ID_SELECTALL, EVT_MENU, () => state.ctrl.SelectAll());

    // EVT_TEXT_URL(wxID_ANY) — MyFrame::OnURL()
    bind(ID_ANY, ID_ANY, EVT_TEXT_URL, (eventPtr) =>
    {
        if (!eventPtr) return;
        const event = new wxTextUrlEvent(eventPtr, true);
        const text = event.GetString();
        if (text)
        {
            const url = readAndDeleteWxString(text.ptr);
            withString(url, (msg) =>
            {
                withString("", (caption) =>
                {
                    kwxMessageBox(msg, caption, OK, state.frame.ptr, -1, -1);
                });
            });
        }
    });

    // EVT_RICHTEXT_STYLESHEET_REPLACING(wxID_ANY)
    bind(ID_ANY, ID_ANY, EVT_RICHTEXT_STYLESHEET_REPLACING, (eventPtr) =>
    {
        if (!eventPtr) return;
        new wxRichTextEvent(eventPtr).Veto();
    });

    bind(ID_ANY, ID_ANY, EVT_CLOSE_WINDOW, () => exitMainLoop());
}

// ---------------------------------------------------------------------------
// MyRichTextCtrl overrides (richtext.cpp: PrepareContent, CanDeleteRange,
// CanInsertContent).
//
// The C++ PrepareContent override tags the objects about to be inserted with a
// "Lock" property, so Defragment() cannot merge a locked run into its
// neighbours (wxRichTextPlainText::CanMerge compares the property sets). The
// guards below read the property back through wxRichTextObject::GetProperties(),
// which kwxFFI returns as a borrowed reference to the object's own properties.
//
// Each hook is void and publishes its answer with the matching Set*Result
// function; kwxFFI falls back to the base-class behaviour when no result is
// published, so a hook that cannot answer (teardown sweep, null argument) simply
// returns.
// ---------------------------------------------------------------------------

/** obj->GetProperties().HasProperty("Lock") — the C++ test. */
function isLockedObject(objectPtr: Pointer): boolean
{
    if (!objectPtr)
    {
        return false;
    }
    const properties = wrapWxRichTextObject(objectPtr).GetProperties();
    if (!properties)
    {
        return false;
    }
    return withString("Lock", (name) => properties.HasProperty(name));
}

/** obj->GetProperties().GetPropertyLong("Lock"), or -1 when it is not locked. */
function lockedObjectId(objectPtr: Pointer): number
{
    if (!objectPtr)
    {
        return -1;
    }
    const properties = wrapWxRichTextObject(objectPtr).GetProperties();
    if (!properties)
    {
        return -1;
    }
    return withString("Lock", (name) =>
        properties.HasProperty(name) ? Number(properties.GetPropertyLong(name)) : -1);
}

function bindControlHooks(
    ctrl: kwxRichTextCtrl,
    lock: LockState,
    callbacks: Callback[],
): void
{
    const hook = (handler: (arg1: Pointer, arg2: Pointer) => void): Callback =>
        resultHook(callbacks, handler);

    // MyRichTextCtrl::PrepareContent — tag the content that is about to be
    // inserted (or the paragraph a buffer reset restores). The C++ override
    // walks the container's children and each child's children.
    const prepareContent = hook((containerPtr) =>
    {
        if (!containerPtr || !lock.locked)
        {
            return;
        }
        const container = wrapWxRichTextParagraphLayoutBox(containerPtr);
        withString("Lock", (name) =>
        {
            for (let paragraph = container.GetFirstChild(); paragraph;
                 paragraph = paragraph.GetNextSibling())
            {
                for (let object = paragraph.GetFirstChild(); object;
                     object = object.GetNextSibling())
                {
                    const properties = object.GetProperties();
                    if (properties)
                    {
                        properties.SetPropertyLong(name, BigInt(lock.lockId));
                    }
                }
            }
        });
    });
    ctrl.SetOnPrepareContent(prepareContent.pointer);

    // MyRichTextCtrl::CanDeleteRange — refuse a range holding a locked object.
    const canDeleteRange = hook((containerPtr, rangePtr) =>
    {
        if (!containerPtr || !rangePtr)
        {
            return;
        }
        const range = new wxRichTextRange(rangePtr, true);
        const start = Number(range.GetStart());
        const end = Number(range.GetEnd());
        const container = wrapWxRichTextParagraphLayoutBox(containerPtr);
        let canDelete = true;
        for (let position = start; position < end; position++)
        {
            if (isLockedObject(container.GetLeafObjectAtPosition(BigInt(position))))
            {
                canDelete = false;
                break;
            }
        }
        ctrl.SetCanDeleteRangeResult(canDelete);
    });
    ctrl.SetOnCanDeleteRange(canDeleteRange.pointer);

    // MyRichTextCtrl::CanInsertContent — no insertion inside a locked run.
    const canInsertContent = hook((containerPtr, positionPtr) =>
    {
        if (!containerPtr)
        {
            return;
        }
        // The native third argument is a `long` delivered through the pointer
        // slot, so a position of 0 arrives as null.
        const position = positionPtr === null ? 0 : Number(positionPtr);
        const container = wrapWxRichTextParagraphLayoutBox(containerPtr);

        const lock1 = lockedObjectId(
            container.GetLeafObjectAtPosition(BigInt(position)));
        const lock2 = lockedObjectId(
            container.GetLeafObjectAtPosition(BigInt(position - 1)));

        let canInsert = true;
        if (lock1 !== -1 && lock1 === lock2)
        {
            canInsert = false;
        }
        // Don't allow insertion before a locked object if it's at the beginning.
        if (position === 0 && lock1 !== -1)
        {
            canInsert = false;
        }
        ctrl.SetCanInsertContentResult(canInsert);
    });
    ctrl.SetOnCanInsertContent(canInsertContent.pointer);
}

// ---------------------------------------------------------------------------
// field types (MyApp::OnInit)
// ---------------------------------------------------------------------------

/**
 * A kwxFFI hook callback. The runtime thunk forwards (pObject, arg1, arg2); the
 * sample ignores pObject, which is null for every hook it installs.
 */
function resultHook(
    callbacks: Callback[],
    handler: (arg1: Pointer, arg2: Pointer) => void,
): Callback
{
    const callback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_object, arg1, arg2) => handler(arg1, arg2),
    );
    callbacks.push(callback);
    return callback;
}

/** wxRichTextFieldTypePropertiesTest's shared overrides. */
function bindPropertiesTestHooks(
    fieldType: kwxRichTextFieldTypeStandard,
    label: string,
    callbacks: Callback[],
): void
{
    // CanEditProperties() { return true; }
    const canEdit = resultHook(callbacks, () => fieldType.SetCanEditPropertiesResult(true));
    fieldType.SetOnCanEditProperties(canEdit.pointer);

    // EditProperties() { wxMessageBox("Editing <label>"); return true; }
    const edit = resultHook(callbacks, () =>
    {
        withString("Editing " + label, (text) =>
            withString("Message", (caption) =>
                kwxMessageBox(text, caption, OK, null, -1, -1)));
        fieldType.SetEditPropertiesResult(true);
    });
    fieldType.SetOnEditProperties(edit.pointer);

    // GetPropertiesMenuLabel() { return GetLabel(); }
    const menuLabel = resultHook(callbacks, () =>
    {
        withString(label, (text) => fieldType.SetPropertiesMenuLabelResult(text));
    });
    fieldType.SetOnGetPropertiesMenuLabel(menuLabel.pointer);
}

function registerFieldTypes(callbacks: Callback[]): void
{
    // wxRichTextFieldTypePropertiesTest("rectangle", "RECTANGLE", RECTANGLE).
    const rectangle = withString("rectangle", (name) =>
        withString("RECTANGLE", (label) =>
            createKwxRichTextFieldTypeStandard(
                null, name, label, RICHTEXT_FIELD_STYLE_RECTANGLE,
            )));
    if (rectangle)
    {
        bindPropertiesTestHooks(rectangle, "RECTANGLE", callbacks);
        wxRichTextBuffer_AddFieldType(rectangle.ptr);
    }

    // wxRichTextFieldTypeStandard("begin-section", "SECTION", START_TAG)
    const beginSection = withString("begin-section", (name) =>
        withString("SECTION", (label) =>
            createWxRichTextFieldTypeStandard(
                name, label, RICHTEXT_FIELD_STYLE_START_TAG,
            )));
    if (beginSection)
    {
        beginSection.SetBackgroundColour(BLUE);
        wxRichTextBuffer_AddFieldType(beginSection.ptr);
    }

    // wxRichTextFieldTypeStandard("end-section", "SECTION", END_TAG)
    const endSection = withString("end-section", (name) =>
        withString("SECTION", (label) =>
            createWxRichTextFieldTypeStandard(
                name, label, RICHTEXT_FIELD_STYLE_END_TAG,
            )));
    if (endSection)
    {
        endSection.SetBackgroundColour(BLUE);
        wxRichTextBuffer_AddFieldType(endSection.ptr);
    }

    // wxRichTextFieldTypeStandard("bitmap", wxBitmap(paste_xpm), NO_BORDER)
    const pasteBundle = loadSvgBundle("paste.svg", 16, 16);
    if (pasteBundle)
    {
        fieldBundles.push(pasteBundle);
        const pasteBitmap = pasteBundle.GetBitmap(16, 16);
        if (pasteBitmap)
        {
            fieldBitmaps.push(pasteBitmap);
            const bitmapType = withString("bitmap", (name) =>
                createWxRichTextFieldTypeStandardWithBitmap(
                    name, pasteBitmap.ptr, RICHTEXT_FIELD_STYLE_NO_BORDER,
                ));
            if (bitmapType)
            {
                wxRichTextBuffer_AddFieldType(bitmapType.ptr);
            }
        }
    }

    // wxRichTextFieldTypeCompositeTest("composite", "This is a field value").
    // It derives from wxRichTextFieldTypePropertiesTest, so it keeps the
    // CanEditProperties/EditProperties/GetPropertiesMenuLabel overrides and adds
    // UpdateField, which rebuilds the children as a paragraph of plain text.
    const label = "This is a field value";
    const composite = withString("composite", (name) =>
        withString(label, (text) =>
            createKwxRichTextFieldTypeStandard(
                null, name, text, RICHTEXT_FIELD_STYLE_COMPOSITE,
            )));
    if (composite)
    {
        bindPropertiesTestHooks(composite, label, callbacks);

        const update = resultHook(callbacks, (bufferPtr, fieldPtr) =>
        {
            if (!bufferPtr || !fieldPtr)
            {
                return;
            }
            const buffer = wrapWxRichTextBuffer(bufferPtr);
            const field = wrapWxRichTextField(fieldPtr);

            const attr = createWxRichTextAttr();
            if (attr)
            {
                buffer.GetAttributes(attr.ptr);
                const boxAttr = attr.GetTextBoxAttr();
                if (boxAttr)
                {
                    boxAttr.Reset();
                }
                attr.SetParagraphSpacingAfter(0);
                attr.SetLineSpacing(10);
                field.SetAttributes(attr.ptr);
                attr.Delete();
            }

            field.DeleteChildren();
            const startBuffer = new BigInt64Array(1);
            const endBuffer = new BigInt64Array(1);
            withString(label, (text) =>
                field.AddParagraph(text, null, pointerOf(startBuffer), pointerOf(endBuffer)));

            composite.SetUpdateFieldResult(true);
        });
        composite.SetOnUpdateField(update.pointer);

        wxRichTextBuffer_AddFieldType(composite.ptr);
    }
}

// ---------------------------------------------------------------------------
// wxRichTextEnhancedDrawingHandler (richtext.cpp)
// ---------------------------------------------------------------------------

function registerEnhancedDrawingHandler(
    callbacks: Callback[],
): void
{
    // wxRichTextBuffer::AddDrawingHandler(new wxRichTextEnhancedDrawingHandler)
    // The buffer takes ownership of the handler.
    const handler = withString("enhanceddrawing", (name) =>
        createKwxRichTextDrawingHandler(null, name));
    if (!handler)
    {
        return;
    }

    // HasVirtualAttributes(obj) { return obj->GetProperties().HasProperty("Lock"); }
    const hasVirtualAttributes = resultHook(callbacks, (objectPtr) =>
    {
        handler.SetHasVirtualAttributesResult(isLockedObject(objectPtr));
    });
    handler.SetOnHasVirtualAttributes(hasVirtualAttributes.pointer);

    // GetVirtualAttributes(attr, obj) — grey background for locked content. The
    // C++ sample never calls EnableVirtualAttributes(), so wxRichTextContext
    // never asks the handler and m_lockBackgroundColour is never painted; the
    // hook is installed for fidelity.
    const getVirtualAttributes = resultHook(callbacks, (attrPtr, objectPtr) =>
    {
        if (!isLockedObject(objectPtr))
        {
            handler.SetGetVirtualAttributesResult(false);
            return;
        }
        if (attrPtr)
        {
            const attr = new wxRichTextAttr(attrPtr, true);
            const colour = createWxColourRGB(220, 220, 220, 255);
            if (colour)
            {
                attr.SetBackgroundColour(colour.ptr);
                colour.Delete();
            }
        }
        handler.SetGetVirtualAttributesResult(true);
    });
    handler.SetOnGetVirtualAttributes(getVirtualAttributes.pointer);

    // GetVirtualSubobjectAttributesCount() { return 0; }
    const subobjectCount = resultHook(callbacks, () =>
        handler.SetGetVirtualSubobjectAttributesCountResult(0));
    handler.SetOnGetVirtualSubobjectAttributesCount(subobjectCount.pointer);

    // HasVirtualText() { return false; }
    const hasVirtualText = resultHook(callbacks, () =>
        handler.SetHasVirtualTextResult(false));
    handler.SetOnHasVirtualText(hasVirtualText.pointer);

    // GetVirtualText() { return false; } — publishing no result keeps the
    // base-class false, which is what the C++ override returns.
    const getVirtualText = resultHook(callbacks, () => {});
    handler.SetOnGetVirtualText(getVirtualText.pointer);

    wxRichTextBuffer_AddDrawingHandler(handler.ptr);
}

// ---------------------------------------------------------------------------
// bootstrap (MyApp::OnInit)
// ---------------------------------------------------------------------------

function registerHandlers(): void
{
    // wxRichTextBuffer::AddHandler(new wxRichTextXMLHandler);
    // wxRichTextBuffer::AddHandler(new wxRichTextHTMLHandler);
    const xmlHandler = withString("XML", (name) =>
        withString("xml", (ext) =>
            createWxRichTextXMLHandler(name, ext, RICHTEXT_TYPE_XML)));
    if (xmlHandler)
    {
        wxRichTextBuffer_AddHandler(xmlHandler.ptr);
    }

    const htmlHandler = withString("HTML", (name) =>
        withString("html", (ext) =>
            createWxRichTextHTMLHandler(name, ext, RICHTEXT_TYPE_HTML)));
    if (htmlHandler)
    {
        wxRichTextBuffer_AddHandler(htmlHandler.ptr);
    }

    // wxImage::AddHandler(new wxPNGHandler/JPEGHandler/GIFHandler)
    const png = createWxPNGHandler();
    if (png) wxImage_AddHandler(png.ptr);
    const jpeg = createWxJPEGHandler();
    if (jpeg) wxImage_AddHandler(jpeg.ptr);
    const gif = createWxGIFHandler();
    if (gif) wxImage_AddHandler(gif.ptr);

    // wxFileSystem::AddHandler(new wxMemoryFSHandler) — the handler becomes
    // owned by wxFileSystem, so it is never deleted here.
    const memoryFSHandler = createWxMemoryFSHandler();
    if (memoryFSHandler) wxFileSystem_AddHandler(memoryFSHandler.ptr);
}

export function main(): number
{
    if (!initialize())
    {
        console.error("Failed to initialize wxWidgets");
        return 1;
    }

    setAppName("wxRichTextCtrl Sample");

    // wxHelpProvider::Set(new wxSimpleHelpProvider); the provider is owned by
    // wxWidgets after this call and must not be deleted.
    const helpProvider = createWxSimpleHelpProvider();
    if (helpProvider) helpProvider.Set();

    // MyApp::OnInit(): m_styleSheet = new wxRichTextStyleSheet; CreateStyles();
    const sheet = createStyles();
    if (!sheet)
    {
        console.error("richtext: failed to create the style sheet");
        shutdown();
        return 1;
    }

    // MyRichTextCtrl::m_lockId / m_locked (BeginLock, EndLock, IsLocked).
    const lock: LockState = { lockId: 0, locked: false };

    registerHandlers();

    const fieldCallbacks: Callback[] = [];
    // MyRichTextCtrl::SetEnhancedDrawingHandler()
    registerEnhancedDrawingHandler(fieldCallbacks);
    registerFieldTypes(fieldCallbacks);

    const state = createMainFrame(sheet, lock);
    if (!state)
    {
        console.error("richtext: failed to create the main frame");
        sheet.Delete();
        for (const callback of fieldCallbacks)
        {
            callback.close();
        }
        shutdown();
        return 1;
    }
    for (const callback of fieldCallbacks)
    {
        state.callbacks.push(callback);
    }

    bindEvents(state);

    // The C++ code obtains a 75%-of-display frame and shows it in place.
    state.frame.Show();
    setTopWindow(state.frame.ptr);

    const exitCode = run();

    for (const callback of state.callbacks)
    {
        callback.close();
    }
    if (state.printing)
    {
        state.printing.Delete();
    }
    // MyApp::OnExit(): delete m_styleSheet
    sheet.Delete();
    shutdown();
    return exitCode;
}

exit(main());
