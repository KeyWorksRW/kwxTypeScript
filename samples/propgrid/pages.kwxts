// Standard Items page
//-----------------------------------------------------------------------------

const FS_WINDOWSTYLE_LABELS = [
    "wxSIMPLE_BORDER",
    "wxDOUBLE_BORDER",
    "wxSUNKEN_BORDER",
    "wxRAISED_BORDER",
    "wxNO_BORDER",
    "wxTAB_TRAVERSAL",
    "wxWANTS_CHARS",
    "wxVSCROLL",
    "wxALWAYS_SHOW_SB",
    "wxCLIP_CHILDREN",
    "wxFULL_REPAINT_ON_RESIZE",
];

const FS_WINDOWSTYLE_VALUES = [
    BORDER_SIMPLE,
    BORDER_DOUBLE,
    BORDER_SUNKEN,
    BORDER_RAISED,
    BORDER_NONE,
    TAB_TRAVERSAL,
    WANTS_CHARS,
    VSCROLL,
    ALWAYS_SHOW_SB,
    CLIP_CHILDREN,
    FULL_REPAINT_ON_RESIZE,
];

const FS_FRAMESTYLE_LABELS = [
    "wxCAPTION",
    "wxMINIMIZE",
    "wxMAXIMIZE",
    "wxCLOSE_BOX",
    "wxSTAY_ON_TOP",
    "wxSYSTEM_MENU",
    "wxRESIZE_BORDER",
    "wxFRAME_TOOL_WINDOW",
    "wxFRAME_NO_TASKBAR",
    "wxFRAME_FLOAT_ON_PARENT",
    "wxFRAME_SHAPED",
];

const FS_FRAMESTYLE_VALUES = [
    CAPTION,
    ICONIZE,
    MAXIMIZE,
    CLOSE_BOX,
    STAY_ON_TOP,
    SYSTEM_MENU,
    RESIZE_BORDER,
    FRAME_TOOL_WINDOW,
    FRAME_NO_TASKBAR,
    FRAME_FLOAT_ON_PARENT,
    FRAME_SHAPED,
];

export function populateStandardItems(
    page: wxPropertyGridPage, grid: wxPropertyGrid, title: string, frameStyle: number,
): void
{
    append(page, makeCategory("Appearance"));

    append(page, makeString("Label", title));
    const fontProp = append(page, makeFont("Font"));
    setHelp(page, fontProp, "Editing this will change font used in the property grid.");

    append(page, makeColour("Margin Colour", grid.GetMarginColour()?.ptr ?? null));
    append(page, makeColour("Cell Colour", grid.GetCellBackgroundColour()?.ptr ?? null));
    append(page, makeColour("Cell Text Colour", grid.GetCellTextColour()?.ptr ?? null));
    append(page, makeColour("Line Colour", grid.GetLineColour()?.ptr ?? null));

    append(page, makeFlags(
        "Window Styles",
        FS_WINDOWSTYLE_LABELS.concat(FS_FRAMESTYLE_LABELS),
        FS_WINDOWSTYLE_VALUES.concat(FS_FRAMESTYLE_VALUES),
        frameStyle));

    // wxCursorProperty is not bound; the Cursor item is omitted.

    const positionCategory = append(page, makeCategory("Position"));
    if (positionCategory)
    {
        withString("PositionCategory", (ptr) => positionCategory.SetName(ptr));
        withString(
            "Change in items in this category will cause respective changes in frame.",
            (ptr) => positionCategory.SetHelpString(ptr));
    }

    const height = append(page, makeInt("Height", 480));
    attrLong(height, "Min", 10);
    attrLong(height, "Max", 2048);
    attrString(height, "Units", "Pixels");
    if (height) page.SetPropertyValueUnspecified(height.ptr);
    attrString(height, "Hint", "Enter new height for window");
    setHelp(page, height, "This property uses attributes \"Units\" and \"Hint\".");

    const width = append(page, makeInt("Width", 640));
    attrLong(width, "Min", 10);
    attrLong(width, "Max", 2048);
    attrString(width, "Units", "Pixels");
    if (width) page.SetPropertyValueUnspecified(width.ptr);
    attrString(width, "Hint", "Enter new width for window");
    setHelp(page, width, "This property uses attributes \"Units\" and \"Hint\".");

    const x = append(page, makeInt("X", 10));
    attrString(x, "Units", "Pixels");
    setHelp(page, x, "This property uses \"Units\" attribute.");

    const y = append(page, makeInt("Y", 10));
    attrString(y, "Units", "Pixels");
    setHelp(page, y, "This property uses \"Units\" attribute.");

    const disabledHelp = "This property is simply disabled. In order to have label disabled as well, "
        + "you need to set wxPG_EX_GREY_LABEL_WHEN_DISABLED using SetExtraStyle.";

    append(page, makeCategory("Environment"));
    const osProp = append(page, makeString("Operating System", takeText(wxGetOsDescription())));
    const userId = append(page, makeString("User Id", takeText(wxGetUserId())));
    append(page, makeDir("User Home", userHome()));
    const userName = append(page, makeString("User Name", takeText(wxGetUserName())));

    disable(page, osProp);
    disable(page, userId);
    disable(page, userName);

    setHelp(page, osProp, disabledHelp);
    setHelp(page, userId, disabledHelp);
    setHelp(page, userName, disabledHelp);

    append(page, makeCategory("More Examples"));

    const fontData = append(page, makeFont("FontDataProperty"));
    setHelp(page, fontData,
        "This demonstrates wxFontDataProperty class defined in this sample app. "
        + "It is exactly like wxFontProperty from the library, but also has colour sub-property.");

    const dirs = append(page, makeArrayString("DirsProperty", []));
    setHelp(page, dirs,
        "This demonstrates wxDirsProperty class defined in this sample app. "
        + "It is built with WX_PG_IMPLEMENT_ARRAYSTRING_PROPERTY_WITH_VALIDATOR macro, "
        + "with custom action (dir dialog popup) defined.");

    const arrayDouble = append(page,
        makeArrayString("ArrayDoubleProperty", ["-1", "-0.5", "0", "0.5", "1"]));
    setHelp(page, arrayDouble,
        "This demonstrates wxArrayDoubleProperty class defined in this sample app. "
        + "It is an example of a custom list editor property.");

    const information = append(page, makeLongString("Information",
        "Editing properties will have immediate effect on this window, "
        + "and vice versa (at least in most cases, that is)."));
    setHelp(page, information, "This property is read-only.");
    if (information) page.SetPropertyReadOnly(information.ptr, true, PG_RECURSE);

    // Fill columns 3 and 4 with test text, as the C++ sample does.
    const root = page.GetRoot();
    const folder = wxArtProvider_GetBitmapBundle(ART_FOLDER, ART_OTHER, -1, -1);
    if (root && folder)
    {
        walkAll(root, (prop) =>
        {
            if (prop.IsCategory()) return;
            withString("Cell 3", (text) =>
                page.SetPropertyCell(prop.ptr, 3, text, folder.ptr, null, null));
            withString("Cell 4", (text) =>
                page.SetPropertyCell(prop.ptr, 4, text, null, WHITE, BLACK));
        });
        folder.Delete();
    }
}

// Local helper: resolves a property on the page currently being populated.
function findPropertyByName(page: wxPropertyGridPage, name: string): wxPGProperty | null
{
    return withString(name, (ptr) => page.GetPropertyByName(ptr));
}

//-----------------------------------------------------------------------------
// wxWidgets Library Config page
//-----------------------------------------------------------------------------

interface LibConfItem { label: string; value: boolean; defined: boolean }
interface LibConfGroup { group: string; items: LibConfItem[] }

function onOff(label: string, value: boolean): LibConfItem
{
    return { label, value, defined: true };
}

function missing(label: string): LibConfItem
{
    return { label, value: false, defined: false };
}

