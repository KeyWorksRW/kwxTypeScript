// dirctrl.kwxts — port of wxSamples/src/widgets/dirctrl.cpp
//
// wxGenericDirCtrl::GetPath(item), wxDirDialogDefaultFolderStr and
// wxWindowUpdateLocker are all used as in the C++ sample.
//
// wxDirFilterListCtrl is not used by this page (the C++ sample only reaches
// it through wxGenericDirCtrl::GetFilterListCtrl(), which is not needed
// here), so it is not instantiated.

import {
    ALIGN_CENTRE_HORIZONTAL,
    ALL,
    createWxBoxSizer,
    createWxButton,
    createWxGenericDirCtrl,
    createWxRadioBox,
    createWxTreeItemId,
    createWxWindowUpdateLocker,
    DirDialogDefaultFolderStr,
    DIRCTRL_3D_INTERNAL,
    DIRCTRL_DIR_ONLY,
    DIRCTRL_EDIT_LABELS,
    DIRCTRL_MULTIPLE,
    DIRCTRL_SELECT_FIRST,
    DIRCTRL_SHOW_FILTERS,
    EVT_BUTTON,
    EVT_CHECKBOX,
    EVT_DIRCTRL_FILEACTIVATED,
    EVT_DIRCTRL_SELECTIONCHANGED,
    EVT_RADIOBOX,
    EXPAND,
    FileSelectorDefaultWildcardStr,
    HORIZONTAL,
    ID_ANY,
    ID_HIGHEST,
    LEFT,
    PATH_NATIVE,
    RA_SPECIFY_COLS,
    readAndDeleteWxString,
    RIGHT,
    TheApp,
    VERTICAL,
    createWxFileNameFromPath,
    wxCheckBox,
    wxGenericDirCtrl,
    wxRadioBox,
    wxStandardPaths,
    wxStandardPaths_Get,
    wxString,
    wxTextCtrl,
    wxTreeEvent,
    wxTreeItemId,
    wxWindow,
    wrapWxApp,
    wrapWxGenericDirCtrl,
    wrapWxStandardPaths,
} from "kwx";
import { Pointer, pointerOf, readCString } from "kwx/platform";

import {
    addSizer,
    addWin,
    attrs,
    bindEvent,
    border,
    doubleBorder,
    logMessage,
    makeStaticBoxSizer,
    tripleBorder,
    WidgetsPage,
    withString,
} from "./common.kwxts";

const DIR_CTRL_PAGE_RESET = ID_HIGHEST;
const DIR_CTRL_PAGE_SET_PATH = DIR_CTRL_PAGE_RESET + 1;
const DIR_CTRL_PAGE_CTRL = DIR_CTRL_PAGE_SET_PATH + 1;

/** Indices of the "Standard path" radio box. */
const STD_PATH_UNKNOWN = 0;
const STD_PATH_CONFIG = 1;
const STD_PATH_DATA = 2;
const STD_PATH_DOCUMENTS = 3;
const STD_PATH_LOCAL_DATA = 4;
const STD_PATH_PLUGINS = 5;
const STD_PATH_RESOURCES = 6;
const STD_PATH_USER_CONFIG = 7;
const STD_PATH_USER_DATA = 8;
const STD_PATH_USER_LOCAL_DATA = 9;

/**
 * Builds the `char**` array expected by wxRadioBox_Create.  The returned
 * buffers must stay reachable until the native call returns.
 */
function makeRadioBox(
    parent: Pointer,
    caption: string,
    items: string[],
    dimension: number,
    style: number,
): wxRadioBox
{
    const buffers: Uint8Array[] = [];
    const pointers = new BigUint64Array(items.length);

    for (let index = 0; index < items.length; index++)
    {
        const bytes = new TextEncoder().encode(items[index] + "\0");
        buffers.push(bytes);
        const address = pointerOf(bytes);
        pointers[index] = address === null ? 0n : address;
    }

    const choices = pointerOf(pointers);

    const box = withString(caption, (ptr) =>
        createWxRadioBox(
            parent, ID_ANY, ptr, -1, -1, -1, -1,
            items.length, choices, dimension, style,
        ));

    // Keep the string buffers alive until the constructor has copied them.
    void buffers;
    return box!;
}

/** wxString getter result as a plain string. */
function wxStringOf(value: wxString | null): string
{
    return value ? readAndDeleteWxString(value.ptr) : "";
}

/** wxFileName comparison used to detect that SetPath() failed. */
function samePath(first: string, second: string): boolean
{
    const firstName = withString(first,
        (ptr) => createWxFileNameFromPath(ptr, PATH_NATIVE));
    const secondName = withString(second,
        (ptr) => createWxFileNameFromPath(ptr, PATH_NATIVE));

    if (!firstName || !secondName)
    {
        return first === second;
    }

    const equal = firstName.SameAs(secondName.ptr, PATH_NATIVE);
    firstName.Delete();
    secondName.Delete();
    return equal;
}

export class DirCtrlPage extends WidgetsPage
{
    private dirCtrl: wxGenericDirCtrl | null = null;

    private pathEntry: wxTextCtrl | null = null;

    private stdPathRadio: wxRadioBox | null = null;

    private checkDirOnly: wxCheckBox | null = null;
    private check3D: wxCheckBox | null = null;
    private checkFirst: wxCheckBox | null = null;
    private checkFilters: wxCheckBox | null = null;
    private checkLabels: wxCheckBox | null = null;
    private checkMulti: wxCheckBox | null = null;

    private filterChecks: wxCheckBox[] = [];

    constructor(parent: Pointer)
    {
        super(parent, "icons/dirctrl");
    }

    override getWidget(): wxWindow | null
    {
        return this.dirCtrl;
    }

    override createContent(): void
    {
        const sizerTop = createWxBoxSizer(HORIZONTAL)!;

        // left pane
        const sizerLeft = makeStaticBoxSizer(
            this.page.ptr, VERTICAL, "Dir control details");

        const pathRow = this.createSizerWithTextAndButton(
            DIR_CTRL_PAGE_SET_PATH, "Set &path", ID_ANY, (text) =>
            {
                this.pathEntry = text;
            }, sizerLeft.box.ptr);
        addSizer(sizerLeft.sizer, pathRow, 0, RIGHT, border());

        const sizerFlags = makeStaticBoxSizer(
            sizerLeft.box.ptr, VERTICAL, "&Flags");
        this.checkDirOnly = this.createCheckBoxAndAddToSizer(
            sizerFlags.sizer, "wxDIRCTRL_DIR_ONLY", ID_ANY, sizerFlags.box.ptr);
        this.check3D = this.createCheckBoxAndAddToSizer(
            sizerFlags.sizer, "wxDIRCTRL_3D_INTERNAL", ID_ANY, sizerFlags.box.ptr);
        this.checkFirst = this.createCheckBoxAndAddToSizer(
            sizerFlags.sizer, "wxDIRCTRL_SELECT_FIRST", ID_ANY, sizerFlags.box.ptr);
        this.checkFilters = this.createCheckBoxAndAddToSizer(
            sizerFlags.sizer, "wxDIRCTRL_SHOW_FILTERS", ID_ANY, sizerFlags.box.ptr);
        this.checkLabels = this.createCheckBoxAndAddToSizer(
            sizerFlags.sizer, "wxDIRCTRL_EDIT_LABELS", ID_ANY, sizerFlags.box.ptr);
        this.checkMulti = this.createCheckBoxAndAddToSizer(
            sizerFlags.sizer, "wxDIRCTRL_MULTIPLE", ID_ANY, sizerFlags.box.ptr);
        addSizer(sizerLeft.sizer, sizerFlags.sizer, 0, EXPAND, border());

        const sizerFilters = makeStaticBoxSizer(
            sizerLeft.box.ptr, VERTICAL, "&Filters");

        const wildcard = FileSelectorDefaultWildcardStr
            ? readCString(FileSelectorDefaultWildcardStr)
            : "*";
        const filterLabels = [
            `all files (${wildcard})|${wildcard}`,
            "C++ files (*.cpp; *.h)|*.cpp;*.h",
            "PNG images (*.png)|*.png",
        ];
        for (const label of filterLabels)
        {
            this.filterChecks.push(this.createCheckBoxAndAddToSizer(
                sizerFilters.sizer, label, ID_ANY, sizerFilters.box.ptr));
        }
        addSizer(sizerLeft.sizer, sizerFilters.sizer, 0, EXPAND, border());

        const resetButton = withString("&Reset", (ptr) =>
            createWxButton(sizerFilters.box.ptr, DIR_CTRL_PAGE_RESET, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(sizerLeft.sizer, resetButton, 0, ALIGN_CENTRE_HORIZONTAL,
            tripleBorder());

        // middle pane
        const stdPathRadio = makeRadioBox(
            this.page.ptr, "Standard path",
            [
                "&none", "&config", "&data", "&documents", "&local data",
                "&plugins", "&resources", "&user config", "&user data",
                "&user local data",
            ],
            1, RA_SPECIFY_COLS);
        this.stdPathRadio = stdPathRadio;

        // right pane
        const dirCtrl = wrapWxGenericDirCtrl(createWxGenericDirCtrl(
            this.page.ptr, DIR_CTRL_PAGE_CTRL, null,
            -1, -1, -1, -1, BigInt(attrs.defaultFlags), null, 0));
        this.dirCtrl = dirCtrl;

        // the panes compose the window
        addSizer(sizerTop, sizerLeft.sizer, 0, ALL & ~LEFT, doubleBorder());
        addWin(sizerTop, stdPathRadio, 0, EXPAND, doubleBorder());
        addWin(sizerTop, dirCtrl, 1, EXPAND | (ALL & ~RIGHT),
            doubleBorder());

        this.page.SetSizer(sizerTop.ptr, false);

        // final initializations
        this.reset();

        bindEvent(this.page, DIR_CTRL_PAGE_RESET, DIR_CTRL_PAGE_RESET,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.reset();
                this.createDirCtrl(false);
            });

        bindEvent(this.page, DIR_CTRL_PAGE_SET_PATH, DIR_CTRL_PAGE_SET_PATH,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onButtonSetPath();
            });

        bindEvent(this.page, ID_ANY, ID_ANY, EVT_CHECKBOX, (eventPtr) =>
        {
            if (!eventPtr) return;
            this.createDirCtrl(false);
        });

        bindEvent(this.page, ID_ANY, ID_ANY, EVT_RADIOBOX, (eventPtr) =>
        {
            if (!eventPtr) return;
            this.onRadioBox();
        });

        // Bound on the page by control id, like the C++ event table, so the
        // handlers survive the control re-creation.
        bindEvent(this.page, DIR_CTRL_PAGE_CTRL, DIR_CTRL_PAGE_CTRL,
            EVT_DIRCTRL_SELECTIONCHANGED, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onSelChanged(eventPtr);
            });

        bindEvent(this.page, DIR_CTRL_PAGE_CTRL, DIR_CTRL_PAGE_CTRL,
            EVT_DIRCTRL_FILEACTIVATED, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onFileActivated(eventPtr);
            });
    }

    override recreateWidget(): void
    {
        this.createDirCtrl(false);
    }

    /** Reset the control parameters and re-create the control. */
    private reset(): void
    {
        this.pathEntry?.Clear();

        this.checkDirOnly?.SetValue(false);
        this.check3D?.SetValue(false);
        this.checkFirst?.SetValue(false);
        this.checkFilters?.SetValue(false);
        this.checkLabels?.SetValue(false);
        this.checkMulti?.SetValue(false);

        this.stdPathRadio?.SetSelection(0);

        for (const check of this.filterChecks)
        {
            check.SetValue(false);
        }

        this.createDirCtrl(true);
    }

    /** (Re)create the directory control with the selected flags and filters. */
    private createDirCtrl(defaultPath: boolean): void
    {
        // wxWindowUpdateLocker noUpdates(this)
        const updateLocker = createWxWindowUpdateLocker(this.page.ptr);

        let style = attrs.defaultFlags;
        if (this.checkDirOnly?.GetValue())
        {
            style |= DIRCTRL_DIR_ONLY;
        }
        if (this.check3D?.GetValue())
        {
            style |= DIRCTRL_3D_INTERNAL;
        }
        if (this.checkFirst?.GetValue())
        {
            style |= DIRCTRL_SELECT_FIRST;
        }
        if (this.checkFilters?.GetValue())
        {
            style |= DIRCTRL_SHOW_FILTERS;
        }
        if (this.checkLabels?.GetValue())
        {
            style |= DIRCTRL_EDIT_LABELS;
        }
        if (this.checkMulti?.GetValue())
        {
            style |= DIRCTRL_MULTIPLE;
        }

        const currentPath = defaultPath || !this.dirCtrl
            ? ""
            : wxStringOf(this.dirCtrl.GetPath());

        const created = withString(currentPath, (ptr) =>
            wrapWxGenericDirCtrl(createWxGenericDirCtrl(
                this.page.ptr, DIR_CTRL_PAGE_CTRL,
                defaultPath ? DirDialogDefaultFolderStr : ptr,
                -1, -1, -1, -1, BigInt(style), null, 0)));

        const filters: string[] = [];
        for (const check of this.filterChecks)
        {
            if (check.GetValue())
            {
                const labelValue = check.GetLabel();
                const label = labelValue ? readAndDeleteWxString(labelValue.ptr) : "";
                filters.push(label);
            }
        }
        withString(filters.join("|"), (ptr) => created.SetFilter(ptr));

        // update the sizer's child window
        if (this.dirCtrl)
        {
            this.page.GetSizer()?.ReplaceWindow(
                this.dirCtrl.ptr, created.ptr, true);
            this.dirCtrl.Destroy();
        }
        this.dirCtrl = created;

        this.notifyWidgetRecreation(created);

        // relayout the sizer
        this.page.GetSizer()?.Layout();

        updateLocker?.Delete();
    }

    /** OnButtonSetPath(): navigate to the path typed into the text control. */
    private onButtonSetPath(): void
    {
        if (!this.dirCtrl || !this.pathEntry)
        {
            return;
        }

        const path = wxStringOf(this.pathEntry.GetValue());
        withString(path, (ptr) => this.dirCtrl?.SetPath(ptr));
    }

    /** OnRadioBox(): navigate to the selected standard path. */
    private onRadioBox(): void
    {
        if (!this.dirCtrl || !this.stdPathRadio)
        {
            return;
        }

        // wxTheApp->SetAppName("widgets")
        if (TheApp)
        {
            withString("widgets", (ptr) => wrapWxApp(TheApp).SetAppName(ptr));
        }

        const stdPathsPointer = wxStandardPaths_Get();
        const stdPaths: wxStandardPaths | null = stdPathsPointer
            ? wrapWxStandardPaths(stdPathsPointer)
            : null;

        let path = "";
        switch (this.stdPathRadio.GetSelection())
        {
            case STD_PATH_CONFIG:
                path = stdPaths ? wxStringOf(stdPaths.GetConfigDir()) : "";
                break;

            case STD_PATH_DATA:
                path = stdPaths ? wxStringOf(stdPaths.GetDataDir()) : "";
                break;

            case STD_PATH_DOCUMENTS:
                path = stdPaths ? wxStringOf(stdPaths.GetDocumentsDir()) : "";
                break;

            case STD_PATH_LOCAL_DATA:
                path = stdPaths ? wxStringOf(stdPaths.GetLocalDataDir()) : "";
                break;

            case STD_PATH_PLUGINS:
                path = stdPaths ? wxStringOf(stdPaths.GetPluginsDir()) : "";
                break;

            case STD_PATH_RESOURCES:
                path = stdPaths ? wxStringOf(stdPaths.GetResourcesDir()) : "";
                break;

            case STD_PATH_USER_CONFIG:
                path = stdPaths ? wxStringOf(stdPaths.GetUserConfigDir()) : "";
                break;

            case STD_PATH_USER_DATA:
                path = stdPaths ? wxStringOf(stdPaths.GetUserDataDir()) : "";
                break;

            case STD_PATH_USER_LOCAL_DATA:
                path = stdPaths ? wxStringOf(stdPaths.GetUserLocalDataDir()) : "";
                break;

            case STD_PATH_UNKNOWN:
            default:
                // leave the path unchanged
                break;
        }

        withString(path, (ptr) => this.dirCtrl?.SetPath(ptr));

        // wxFileName comparison, as the paths may differ by case only
        const current = this.dirCtrl.GetPath();
        const currentPath = current ? readAndDeleteWxString(current.ptr) : "";
        if (!samePath(currentPath, path))
        {
            logMessage(`Failed to go to "${path}", the current path is "${currentPath}".`);
        }
    }

    /** Resolves the full path of the tree item carried by a wxTreeEvent. */
    private treeItemPath(event: wxTreeEvent): string
    {
        const item: wxTreeItemId | null = createWxTreeItemId();
        if (!item)
        {
            return "";
        }

        event.GetItem(item.ptr);

        const text = this.dirCtrl ? this.dirCtrl.GetPathForItem(item.ptr) : null;
        item.Delete();
        return text ? readAndDeleteWxString(text.ptr) : "";
    }

    /** OnSelChanged(): log the newly selected item. */
    private onSelChanged(eventPtr: Pointer): void
    {
        if (this.dirCtrl)
        {
            const event = new wxTreeEvent(eventPtr, true);
            logMessage(`Selection changed to "${this.treeItemPath(event)}"`);
        }

        new wxTreeEvent(eventPtr, true).Skip(true);
    }

    /** OnFileActivated(): log the activated item. */
    private onFileActivated(eventPtr: Pointer): void
    {
        if (this.dirCtrl)
        {
            const event = new wxTreeEvent(eventPtr, true);
            logMessage(`File activated "${this.treeItemPath(event)}"`);
        }

        new wxTreeEvent(eventPtr, true).Skip(true);
    }
}

export function createDirCtrlPage(parent: Pointer): WidgetsPage
{
    return new DirCtrlPage(parent);
}
