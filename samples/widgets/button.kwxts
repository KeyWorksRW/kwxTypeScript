// button.kwxts — port of wxSamples/src/widgets/button.cpp
//
// Known binding gaps (see the final report):
//  * wxValidator/wxIntegerValidator are not bound, so the image margin entries
//    are not restricted to 0..100 while typing; invalid values are still
//    rejected when "Horizontal and vertical" is pressed.
//  * In this binding set wxButton derives from wxControl, not from wxAnyButton,
//    so its bitmap setters are reached through wrapWxAnyButton(button.ptr).

import {
    ALIGN_CENTRE,
    ALIGN_CENTRE_HORIZONTAL,
    ALIGN_CENTRE_VERTICAL,
    ALL,
    ART_BUTTON,
    ART_ERROR,
    ART_HELP,
    ART_INFORMATION,
    ART_MISSING_IMAGE,
    ART_WARNING,
    BOTTOM,
    BU_BOTTOM,
    BU_EXACTFIT,
    BU_LEFT,
    BU_RIGHT,
    BU_TOP,
    createWxBitmapButton,
    createWxBoxSizer,
    createWxButton,
    createWxCommandLinkButton,
    createWxRadioBox,
    createWxTextCtrl,
    EVT_BUTTON,
    EVT_CHECKBOX,
    EVT_RADIOBOX,
    EXPAND,
    HORIZONTAL,
    ID_ANY,
    ID_HIGHEST,
    LEFT,
    LogWarning,
    readAndDeleteWxString,
    RIGHT,
    TOP,
    VERTICAL,
    wxAnyButton,
    wxArtProvider_GetBitmap,
    wxBitmap,
    wxButton,
    wxCheckBox,
    wxCommandLinkButton,
    wxRadioBox,
    wxSizer,
    wxTextCtrl,
    wxWindow,
    wxWindow_FindWindowById,
    wrapWxAnyButton,
    wrapWxWindow,
} from "kwx";
import { Pointer, pointerOf } from "kwx/platform";

import {
    addSizer,
    addSpacer,
    addStretchSpacer,
    addWin,
    attrs,
    bindEvent,
    border,
    doubleBorder,
    logMessage,
    makeStaticBoxSizer,
    tripleBorder,
    WidgetsPage,
    withString,
} from "./common.kwxts";

// Control ids (enum starting at wxID_HIGHEST).
const BUTTON_PAGE_RESET = ID_HIGHEST;
const BUTTON_PAGE_CHANGE_LABEL = BUTTON_PAGE_RESET + 1;
const BUTTON_PAGE_CHANGE_NOTE = BUTTON_PAGE_CHANGE_LABEL + 1;
const BUTTON_PAGE_CHANGE_IMAGE_MARGINS = BUTTON_PAGE_CHANGE_NOTE + 1;
const BUTTON_PAGE_BUTTON = BUTTON_PAGE_CHANGE_IMAGE_MARGINS + 1;

// ButtonImagePos_* item indices.
const BUTTON_IMAGE_POS_LEFT = 0;
const BUTTON_IMAGE_POS_RIGHT = 1;
const BUTTON_IMAGE_POS_TOP = 2;
const BUTTON_IMAGE_POS_BOTTOM = 3;

// ButtonHAlign_* item indices.
const BUTTON_HALIGN_LEFT = 0;
const BUTTON_HALIGN_CENTRE = 1;
const BUTTON_HALIGN_RIGHT = 2;

// ButtonVAlign_* item indices.
const BUTTON_VALIGN_TOP = 0;
const BUTTON_VALIGN_CENTRE = 1;
const BUTTON_VALIGN_BOTTOM = 2;

/**
 * Builds the `char**` array expected by wxRadioBox_Create.  The returned
 * buffers must stay reachable until the native call returns.
 */
function makeRadioBox(
    parent: Pointer,
    caption: string,
    items: string[],
    dimension: number,
    style: number,
): wxRadioBox
{
    const buffers: Uint8Array[] = [];
    const pointers = new BigUint64Array(items.length);

    for (let index = 0; index < items.length; index++)
    {
        const bytes = new TextEncoder().encode(items[index] + "\0");
        buffers.push(bytes);
        const address = pointerOf(bytes);
        pointers[index] = address === null ? 0n : address;
    }

    const choices = pointerOf(pointers);

    const box = withString(caption, (ptr) =>
        createWxRadioBox(
            parent, ID_ANY, ptr, -1, -1, -1, -1,
            items.length, choices, dimension, style,
        ));

    // Keep the string buffers alive until the constructor has copied them.
    void buffers;
    return box!;
}

/** wxLEFT/wxRIGHT/wxTOP/wxBOTTOM selected by the "Image &position" radio box. */
function imagePositionDirection(position: number): number
{
    switch (position)
    {
        case BUTTON_IMAGE_POS_RIGHT:
            return RIGHT;
        case BUTTON_IMAGE_POS_TOP:
            return TOP;
        case BUTTON_IMAGE_POS_BOTTOM:
            return BOTTOM;
        default:
            return LEFT;
    }
}

/** wxLogWarning() with a temporary wxString. */
function logWarning(text: string): void
{
    withString(text.replace(/%/g, "%%"), (ptr) => LogWarning(ptr));
}

/** Applies an art bitmap through wxAnyButton and releases it afterwards. */
function applyAnyButtonBitmap(
    button: wxButton,
    type: Pointer,
    apply: (anyButton: wxAnyButton, bitmapPtr: Pointer) => void,
): void
{
    const bitmap = wxArtProvider_GetBitmap(type, ART_BUTTON, -1, -1);
    if (!bitmap)
    {
        return;
    }

    apply(wrapWxAnyButton(button.ptr), bitmap.ptr);
    bitmap.Delete();
}

export class ButtonPage extends WidgetsPage
{
    private chkBitmapOnly: wxCheckBox | null = null;
    private chkTextAndBitmap: wxCheckBox | null = null;
    private chkFit: wxCheckBox | null = null;
    private chkAuthNeeded: wxCheckBox | null = null;
    private chkCommandLink: wxCheckBox | null = null;
    private chkUseMarkup: wxCheckBox | null = null;
    private chkDefault: wxCheckBox | null = null;
    private chkUseBitmapClass: wxCheckBox | null = null;

    private chkUsePressed: wxCheckBox | null = null;
    private chkUseFocused: wxCheckBox | null = null;
    private chkUseCurrent: wxCheckBox | null = null;
    private chkUseDisabled: wxCheckBox | null = null;

    private radioImagePos: wxRadioBox | null = null;
    private radioHAlign: wxRadioBox | null = null;
    private radioVAlign: wxRadioBox | null = null;

    private button: wxButton | null = null;
    private cmdLnkButton: wxCommandLinkButton | null = null;
    private sizerButton: wxSizer | null = null;

    private textLabel: wxTextCtrl | null = null;
    private textNote: wxTextCtrl | null = null;
    private sizerNote: wxSizer | null = null;

    private textImageMarginH: wxTextCtrl | null = null;
    private textImageMarginV: wxTextCtrl | null = null;

    private imageMarginH = 0;
    private imageMarginV = 0;

    constructor(parent: Pointer)
    {
        super(parent, "icons/button");
    }

    override getWidget(): wxWindow | null
    {
        return this.button;
    }

    override createContent(): void
    {
        const topSizer = createWxBoxSizer(HORIZONTAL)!;

        // left pane
        const sizerLeft = makeStaticBoxSizer(this.page.ptr, VERTICAL, "&Set style");

        this.chkBitmapOnly = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "&Bitmap only", ID_ANY, sizerLeft.box.ptr);
        this.chkTextAndBitmap = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Text &and bitmap", ID_ANY, sizerLeft.box.ptr);
        this.chkFit = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "&Fit exactly", ID_ANY, sizerLeft.box.ptr);
        this.chkAuthNeeded = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Require a&uth", ID_ANY, sizerLeft.box.ptr);
        this.chkCommandLink = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Use command &link button", ID_ANY, sizerLeft.box.ptr);
        this.chkUseMarkup = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Interpret &markup", ID_ANY, sizerLeft.box.ptr);
        this.chkDefault = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "&Default", ID_ANY, sizerLeft.box.ptr);

        const useBitmapClass = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Use wxBitmapButton", ID_ANY, sizerLeft.box.ptr);
        useBitmapClass.SetValue(true);
        this.chkUseBitmapClass = useBitmapClass;

        addSpacer(sizerLeft.sizer, this.dip(5));

        const sizerUseLabels = makeStaticBoxSizer(
            sizerLeft.box.ptr, VERTICAL,
            "&Use the following bitmaps in addition to the normal one?");

        this.chkUsePressed = this.createCheckBoxAndAddToSizer(
            sizerUseLabels.sizer, "&Pressed (small help icon)", ID_ANY,
            sizerUseLabels.box.ptr);
        this.chkUseFocused = this.createCheckBoxAndAddToSizer(
            sizerUseLabels.sizer, "&Focused (small error icon)", ID_ANY,
            sizerUseLabels.box.ptr);
        this.chkUseCurrent = this.createCheckBoxAndAddToSizer(
            sizerUseLabels.sizer, "&Current (small warning icon)", ID_ANY,
            sizerUseLabels.box.ptr);
        this.chkUseDisabled = this.createCheckBoxAndAddToSizer(
            sizerUseLabels.sizer, "&Disabled (broken image icon)", ID_ANY,
            sizerUseLabels.box.ptr);
        addSizer(sizerLeft.sizer, sizerUseLabels.sizer, 0, EXPAND | ALL, border());

        addSpacer(sizerLeft.sizer, this.dip(10));

        const radioImagePos = makeRadioBox(
            sizerLeft.box.ptr, "Image &position",
            ["left", "right", "top", "bottom"], 0, 0);
        this.radioImagePos = radioImagePos;
        addWin(sizerLeft.sizer, radioImagePos, 0, EXPAND | ALL, border());

        const sizerImageMargins = makeStaticBoxSizer(
            sizerLeft.box.ptr, VERTICAL, "Image margins");
        const sizerImageMarginsRow = this.createSizerWithTextAndButton(
            BUTTON_PAGE_CHANGE_IMAGE_MARGINS, "Horizontal and vertical", ID_ANY,
            (text) =>
            {
                this.textImageMarginH = text;
            },
            sizerImageMargins.box.ptr);

        this.textImageMarginV = withString("", (ptr) =>
            createWxTextCtrl(
                sizerImageMargins.box.ptr, ID_ANY, ptr,
                -1, -1, -1, -1, BigInt(0)));

        if (this.textImageMarginV)
        {
            addWin(sizerImageMarginsRow, this.textImageMarginV, 1,
                ALIGN_CENTRE_VERTICAL | LEFT, border());
        }

        this.setTextValue(this.textImageMarginH, this.imageMarginH);
        this.setTextValue(this.textImageMarginV, this.imageMarginV);

        addSizer(sizerImageMargins.sizer, sizerImageMarginsRow, 0,
            ALL | ALIGN_CENTRE, border());
        addSizer(sizerLeft.sizer, sizerImageMargins.sizer, 0, EXPAND | ALL, border());

        addSpacer(sizerLeft.sizer, this.dip(15));

        const radioHAlign = makeRadioBox(
            sizerLeft.box.ptr, "&Horz alignment",
            ["left", "centre", "right"], 0, 0);
        const radioVAlign = makeRadioBox(
            sizerLeft.box.ptr, "&Vert alignment",
            ["top", "centre", "bottom"], 0, 0);
        this.radioHAlign = radioHAlign;
        this.radioVAlign = radioVAlign;

        addWin(sizerLeft.sizer, radioHAlign, 0, EXPAND | ALL, border());
        addWin(sizerLeft.sizer, radioVAlign, 0, EXPAND | ALL, border());

        addSpacer(sizerLeft.sizer, this.dip(5));

        const resetButton = withString("&Reset", (ptr) =>
            createWxButton(sizerLeft.box.ptr, BUTTON_PAGE_RESET, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(sizerLeft.sizer, resetButton, 0,
            ALIGN_CENTRE_HORIZONTAL | ALL, tripleBorder());

        // middle pane
        const sizerMiddle = makeStaticBoxSizer(
            this.page.ptr, VERTICAL, "&Operations");

        const sizerRow = this.createSizerWithTextAndButton(
            BUTTON_PAGE_CHANGE_LABEL, "Change label", ID_ANY,
            (text) =>
            {
                this.textLabel = text;
            },
            sizerMiddle.box.ptr);
        this.setTextString(this.textLabel, "&Press me!");
        addSizer(sizerMiddle.sizer, sizerRow, 0, EXPAND | ALL, border());

        const sizerNote = this.createSizerWithTextAndButton(
            BUTTON_PAGE_CHANGE_NOTE, "Change note", ID_ANY,
            (text) =>
            {
                this.textNote = text;
            },
            sizerMiddle.box.ptr);
        this.sizerNote = sizerNote;
        this.setTextString(this.textNote, "Writes down button clicks in the log.");
        addSizer(sizerMiddle.sizer, sizerNote, 0, EXPAND | ALL, border());

        // right pane
        const sizerButton = createWxBoxSizer(VERTICAL)!;
        sizerButton.SetMinSize(this.dip(150), 0);
        this.sizerButton = sizerButton;

        // the 3 panes compose the window
        addSizer(topSizer, sizerLeft.sizer, 0, EXPAND | (ALL & ~LEFT), doubleBorder());
        addSizer(topSizer, sizerMiddle.sizer, 1, EXPAND | ALL, doubleBorder());
        addSizer(topSizer, sizerButton, 1, EXPAND | (ALL & ~RIGHT), doubleBorder());

        // do create the main control
        this.reset();
        this.createButton();

        this.page.SetSizer(topSizer.ptr, false);

        bindEvent(this.page, BUTTON_PAGE_BUTTON, BUTTON_PAGE_BUTTON,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onButton();
            });
        bindEvent(this.page, BUTTON_PAGE_RESET, BUTTON_PAGE_RESET,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onButtonReset();
            });
        bindEvent(this.page, BUTTON_PAGE_CHANGE_LABEL, BUTTON_PAGE_CHANGE_LABEL,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onButtonChangeLabel();
            });
        bindEvent(this.page, BUTTON_PAGE_CHANGE_NOTE, BUTTON_PAGE_CHANGE_NOTE,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onButtonChangeNote();
            });
        bindEvent(this.page,
            BUTTON_PAGE_CHANGE_IMAGE_MARGINS, BUTTON_PAGE_CHANGE_IMAGE_MARGINS,
            EVT_BUTTON, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onButtonChangeImageMargins();
            });

        bindEvent(this.page, ID_ANY, ID_ANY, EVT_CHECKBOX, (eventPtr) =>
        {
            if (!eventPtr) return;
            this.onCheckOrRadioBox();
        });
        bindEvent(this.page, ID_ANY, ID_ANY, EVT_RADIOBOX, (eventPtr) =>
        {
            if (!eventPtr) return;
            this.onCheckOrRadioBox();
        });
    }

    override recreateWidget(): void
    {
        this.createButton();
    }

    /** ButtonWidgetsPage::Reset() */
    private reset(): void
    {
        this.chkBitmapOnly?.SetValue(false);
        this.chkFit?.SetValue(false);
        this.chkAuthNeeded?.SetValue(false);
        this.chkTextAndBitmap?.SetValue(false);
        this.chkDefault?.SetValue(false);
        this.chkCommandLink?.SetValue(false);
        this.chkUseMarkup?.SetValue(false);
        this.chkUseBitmapClass?.SetValue(true);

        this.chkUsePressed?.SetValue(true);
        this.chkUseFocused?.SetValue(true);
        this.chkUseCurrent?.SetValue(true);
        this.chkUseDisabled?.SetValue(true);

        this.radioImagePos?.SetSelection(BUTTON_IMAGE_POS_LEFT);
        this.radioHAlign?.SetSelection(BUTTON_HALIGN_CENTRE);
        this.radioVAlign?.SetSelection(BUTTON_VALIGN_CENTRE);

        this.imageMarginH = 0;
        this.imageMarginV = 0;
        this.setTextValue(this.textImageMarginH, this.imageMarginH);
        this.setTextValue(this.textImageMarginV, this.imageMarginV);
    }

    /** ButtonWidgetsPage::CreateButton() */
    private createButton(): void
    {
        let label = "";

        if (this.button)
        {
            if (this.cmdLnkButton)
            {
                const mainLabel = this.cmdLnkButton.GetMainLabel();
                if (mainLabel)
                {
                    label = readAndDeleteWxString(mainLabel.ptr);
                }
            }
            else
            {
                const currentLabel = this.button.GetLabel();
                if (currentLabel)
                {
                    label = readAndDeleteWxString(currentLabel.ptr);
                }
            }

            const sizerButton = this.sizerButton;
            if (sizerButton)
            {
                const count = sizerButton.GetItemCount();
                for (let index = 0; index < count; index++)
                {
                    sizerButton.Remove(0);
                }
            }

            this.button.Destroy();
            this.button = null;
            this.cmdLnkButton = null;
        }

        if (!label)
        {
            // Creating for the first time or recreating a button after a bitmap
            // button: take the label from the text entry.
            const labelValue = this.textLabel ? this.textLabel.GetValue() : null;
            label = labelValue ? readAndDeleteWxString(labelValue.ptr) : "";
        }

        let flags = attrs.defaultFlags;

        const horizontalSelection = this.radioHAlign
            ? this.radioHAlign.GetSelection()
            : BUTTON_HALIGN_CENTRE;
        switch (horizontalSelection)
        {
            case BUTTON_HALIGN_LEFT:
                flags |= BU_LEFT;
                break;
            case BUTTON_HALIGN_RIGHT:
                flags |= BU_RIGHT;
                break;
            default:
                break;
        }

        const verticalSelection = this.radioVAlign
            ? this.radioVAlign.GetSelection()
            : BUTTON_VALIGN_CENTRE;
        switch (verticalSelection)
        {
            case BUTTON_VALIGN_TOP:
                flags |= BU_TOP;
                break;
            case BUTTON_VALIGN_BOTTOM:
                flags |= BU_BOTTOM;
                break;
            default:
                // centre vertical alignment is the default (no style)
                break;
        }

        if (this.chkFit?.GetValue())
        {
            flags |= BU_EXACTFIT;
        }

        let showsBitmap = false;

        if (this.chkBitmapOnly?.GetValue())
        {
            this.chkCommandLink?.SetValue(false); // cannot be "Bitmap only"

            showsBitmap = true;

            if (this.chkUseBitmapClass?.GetValue())
            {
                const bitmap = this.createBitmap(ART_INFORMATION);
                if (bitmap)
                {
                    this.button = createWxBitmapButton(
                        this.page.ptr, BUTTON_PAGE_BUTTON, bitmap.ptr,
                        -1, -1, -1, -1, flags);
                    bitmap.Delete();
                }
            }
            else
            {
                this.button = withString("", (ptr) =>
                    createWxButton(this.page.ptr, BUTTON_PAGE_BUTTON, ptr,
                        -1, -1, -1, -1, flags));

                const button = this.button;
                if (button)
                {
                    applyAnyButtonBitmap(button, ART_INFORMATION,
                        (anyButton, bitmapPtr) =>
                        {
                            anyButton.SetBitmapLabel(bitmapPtr);
                        });
                }
            }

            this.applyBitmapMargins();
            this.applyAuxiliaryBitmaps();

            this.cmdLnkButton = null;
        }
        else // normal button
        {
            this.cmdLnkButton = null;

            if (this.chkCommandLink?.GetValue())
            {
                const noteValue = this.textNote ? this.textNote.GetValue() : null;
                const note = noteValue ? readAndDeleteWxString(noteValue.ptr) : "";

                this.cmdLnkButton = withString(label, (labelPtr) =>
                    withString(note, (notePtr) =>
                        createWxCommandLinkButton(
                            this.page.ptr, BUTTON_PAGE_BUTTON, labelPtr, notePtr,
                            -1, -1, -1, -1, flags)));

                this.button = this.cmdLnkButton;
            }
            else
            {
                this.button = withString(label, (ptr) =>
                    createWxButton(this.page.ptr, BUTTON_PAGE_BUTTON, ptr,
                        -1, -1, -1, -1, flags));
            }
        }

        const noteVisible = this.chkCommandLink
            ? this.chkCommandLink.GetValue()
            : false;
        this.sizerNote?.ShowItems(noteVisible);

        if (this.button)
        {
            this.notifyWidgetRecreation(this.button);
        }

        if (!showsBitmap && this.chkTextAndBitmap?.GetValue())
        {
            showsBitmap = true;

            const position = this.radioImagePos
                ? this.radioImagePos.GetSelection()
                : BUTTON_IMAGE_POS_LEFT;
            const direction = imagePositionDirection(position);

            const button = this.button;
            if (button)
            {
                applyAnyButtonBitmap(button, ART_INFORMATION,
                    (anyButton, bitmapPtr) =>
                    {
                        anyButton.SetBitmap(bitmapPtr, direction);
                    });
            }

            this.applyBitmapMargins();
            this.applyAuxiliaryBitmaps();
        }

        if (this.chkTextAndBitmap)
        {
            this.chkTextAndBitmap.Enable(!(this.chkBitmapOnly?.GetValue() ?? false));
        }
        if (this.chkBitmapOnly)
        {
            this.chkBitmapOnly.Enable(!(this.chkTextAndBitmap?.GetValue() ?? false));
        }
        if (this.chkCommandLink)
        {
            this.chkCommandLink.Enable(!(this.chkBitmapOnly?.GetValue() ?? false));
        }

        this.chkUseBitmapClass?.Enable(showsBitmap);

        this.chkUsePressed?.Enable(showsBitmap);
        this.chkUseFocused?.Enable(showsBitmap);
        this.chkUseCurrent?.Enable(showsBitmap);
        this.chkUseDisabled?.Enable(showsBitmap);
        this.radioImagePos?.Enable(this.chkTextAndBitmap?.GetValue() ?? false);
        this.textImageMarginH?.Enable(showsBitmap);
        this.textImageMarginV?.Enable(showsBitmap);

        const changeMarginsButton = wxWindow_FindWindowById(
            BigInt(BUTTON_PAGE_CHANGE_IMAGE_MARGINS), this.page.ptr);
        if (changeMarginsButton)
        {
            wrapWxWindow(changeMarginsButton).Enable(showsBitmap);
        }

        if (this.chkAuthNeeded?.GetValue())
        {
            this.button?.SetAuthNeeded(true);
        }

        if (this.chkDefault?.GetValue())
        {
            this.button?.SetDefault();
        }

        const sizerButton = this.sizerButton;
        if (sizerButton)
        {
            addStretchSpacer(sizerButton);
            if (this.button)
            {
                addWin(sizerButton, this.button, 0, ALIGN_CENTRE | ALL, border());
            }
            addStretchSpacer(sizerButton, 2);

            sizerButton.Layout();
        }
    }

    /** Sets the bitmap margins of the current button. */
    private applyBitmapMargins(): void
    {
        const button = this.button;
        if (!button)
        {
            return;
        }

        wrapWxAnyButton(button.ptr).SetBitmapMargins(
            this.imageMarginH, this.imageMarginV);
    }

    /** Applies the pressed/focused/current/disabled bitmaps when requested. */
    private applyAuxiliaryBitmaps(): void
    {
        const button = this.button;
        if (!button)
        {
            return;
        }

        if (this.chkUsePressed?.GetValue())
        {
            applyAnyButtonBitmap(button, ART_HELP, (anyButton, bitmapPtr) =>
            {
                anyButton.SetBitmapPressed(bitmapPtr);
            });
        }
        if (this.chkUseFocused?.GetValue())
        {
            applyAnyButtonBitmap(button, ART_ERROR, (anyButton, bitmapPtr) =>
            {
                anyButton.SetBitmapFocus(bitmapPtr);
            });
        }
        if (this.chkUseCurrent?.GetValue())
        {
            applyAnyButtonBitmap(button, ART_WARNING, (anyButton, bitmapPtr) =>
            {
                anyButton.SetBitmapCurrent(bitmapPtr);
            });
        }
        if (this.chkUseDisabled?.GetValue())
        {
            applyAnyButtonBitmap(button, ART_MISSING_IMAGE, (anyButton, bitmapPtr) =>
            {
                anyButton.SetBitmapDisabled(bitmapPtr);
            });
        }
    }

    /** wxArtProvider::GetBitmap(type, wxART_BUTTON) for the bitmap branches. */
    private createBitmap(type: Pointer): wxBitmap | null
    {
        return wxArtProvider_GetBitmap(type, ART_BUTTON, -1, -1);
    }

    private setTextString(text: wxTextCtrl | null, value: string): void
    {
        if (!text)
        {
            return;
        }
        withString(value, (ptr) => text.SetValue(ptr));
    }

    private setTextValue(text: wxTextCtrl | null, value: number): void
    {
        this.setTextString(text, String(value));
    }

    // -- event handlers ------------------------------------------------------

    private onButtonReset(): void
    {
        this.reset();
        this.createButton();
    }

    private onCheckOrRadioBox(): void
    {
        this.createButton();
        // make sure the text field for changing the note displays correctly
        this.page.Layout();
    }

    private onButtonChangeLabel(): void
    {
        const labelValue = this.textLabel ? this.textLabel.GetValue() : null;
        const labelText = labelValue ? readAndDeleteWxString(labelValue.ptr) : "";

        if (this.cmdLnkButton)
        {
            const commandLink = this.cmdLnkButton;
            withString(labelText, (ptr) => commandLink.SetMainLabel(ptr));
        }
        else if (this.button)
        {
            const button = this.button;
            if (this.chkUseMarkup?.GetValue())
            {
                withString(labelText, (ptr) => button.SetLabelMarkup(ptr));
            }
            else
            {
                withString(labelText, (ptr) => button.SetLabel(ptr));
            }
        }

        if (this.chkBitmapOnly?.GetValue())
        {
            this.createButton();
        }

        this.sizerButton?.Layout();
    }

    private onButtonChangeNote(): void
    {
        const commandLink = this.cmdLnkButton;
        const noteValue = this.textNote ? this.textNote.GetValue() : null;
        if (!commandLink || !noteValue)
        {
            return;
        }

        const noteText = readAndDeleteWxString(noteValue.ptr);
        withString(noteText, (ptr) => commandLink.SetNote(ptr));

        this.sizerButton?.Layout();
    }

    private onButtonChangeImageMargins(): void
    {
        const marginHValue = this.textImageMarginH
            ? this.textImageMarginH.GetValue()
            : null;
        const marginVValue = this.textImageMarginV
            ? this.textImageMarginV.GetValue()
            : null;

        const marginH = marginHValue
            ? Number(readAndDeleteWxString(marginHValue.ptr))
            : Number.NaN;
        const marginV = marginVValue
            ? Number(readAndDeleteWxString(marginVValue.ptr))
            : Number.NaN;

        if (!Number.isFinite(marginH) || !Number.isFinite(marginV) ||
            marginH < 0 || marginV < 0)
        {
            logWarning("Invalid margin values for bitmap.");
            return;
        }

        this.imageMarginH = Math.trunc(marginH);
        this.imageMarginV = Math.trunc(marginV);

        this.applyBitmapMargins();
        this.button?.Refresh(true);
        this.sizerButton?.Layout();
    }

    private onButton(): void
    {
        logMessage("Test button clicked.");
    }
}

export function createButtonPage(parent: Pointer): WidgetsPage
{
    return new ButtonPage(parent);
}
