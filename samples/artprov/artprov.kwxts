// artprov.kwxts — kwxTypeScript port of wxSamples/src/artprov
//
//   arttest.cpp   MyApp::OnInit, MyFrame (File/Help menus and the
//                 OnQuit/OnLogs/OnAbout/OnBrowser/OnPlugProvider handlers),
//                 MyArtProvider::CreateBitmap()
//   artbrows.cpp  wxArtBrowserDialog: FillClients/FillBitmaps, SetArtClient,
//                 SetArtBitmap, OnSelectItem, OnChangeSize, OnChooseClient
//
// Run from the repository root:
//   bin\Release\kwxts.exe samples\artprov\artprov.kwxts
//
// Assets: the four 48x48 art bitmaps (info/error/warning/question.xpm), the
// 16x16 null.xpm placeholder and the 32x32 sample.xpm frame icon are the same
// artwork converted to SVG and loaded at run time from this folder.
//
// Reported deviation: a custom wxArtProvider subclass cannot be plugged in from
// the TypeScript runtime — the only callback shape available is
// `void(pointer, pointer, pointer)`, while kwxArtProv's CreateBitmap callback
// must *return* a wxBitmap pointer. File/Plug-in art provider therefore drives
// an equivalent local provider that answers exactly the four wxART_MESSAGE_BOX
// ids MyArtProvider::CreateBitmap() answered.

