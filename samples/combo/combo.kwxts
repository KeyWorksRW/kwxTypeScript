// combo.kwxts — kwxTypeScript port of wxSamples/src/combo/combo.cpp
//
// The wxComboCtrl / wxOwnerDrawnComboBox sample: a frame demonstrating
// owner-drawn combo boxes, custom dropdown button bitmaps, a wxListView popup,
// a wxTreeCtrl popup, a custom button action (file dialog), a wxCheckBox used as
// the combo's main control, and a side-by-side comparison dialog against the
// native wxComboBox.
//
// Run from the repository root:
//   bin\Release\kwxts.exe samples\combo\combo.kwxts
//
// Drift-check notes (relative to the earlier partial port of this folder):
//   * The custom popups no longer have to be omitted: kwxFFI now ships
//     kwxListViewComboPopup / kwxTreeCtrlComboPopup, and wxComboCtrl exposes
//     SetPopupControl(), UseAltPopupWindow(), SetPopupMinWidth(),
//     SetTextCtrlStyle() and SetMainControl().
//   * wxFileSelectorCombo is ported through kwxComboCtrl's
//     SetOnButtonClick()/SetOnDoSetPopupControl() callbacks, and the checkbox
//     main-control combo through SetMainControl() + createWxCheckBoxDefault().
//   * wxComboCtrl::GetButtonSize() is bound now, so the "button on the left"
//     combo uses the C++ values (butSize.x - 2, butSize.y - 6).
//   * The drop button artwork is loaded from the original .svg files with
//     wxBitmapBundle::FromSVGFile() and installed with SetButtonBitmaps().
//     wxIcon(wxICON(sample)) is reproduced from the converted sample.svg.
//   * Events are installed with wxEvtHandler::Bind(); the earlier partial port
//     used the legacy Connect() path.
//   * Remaining gap: wxPenStyleComboBox::OnDrawItem()/OnDrawBackground()/
//     OnMeasureItem() cannot be reproduced. SetOnDrawItem() forwards
//     (pObject, dc, rect) only — the runtime's native callback trampoline is a
//     fixed void(void*, void*, void*), so the item index and flags never reach
//     JavaScript, and the int-returning measure callbacks cannot return a
//     value. Those combos therefore keep wxWidgets' default item rendering
//     (same items, same selection, uniform row height) without the pen-style
//     preview line, the alternating row heights and the alternate row colour.
//   * wxComboCtrlWithCustomPopupAnim::AnimateShow() is likewise not
//     reproducible (it returns bool, which the same trampoline cannot
//     deliver); the ListView combo keeps wxWidgets' default popup show, so the
//     dropdown appears without the wxSHOW_EFFECT_BLEND animation.

import {
    ALL,
    ALIGN_CENTER_VERTICAL,
    BOTH,
    CAPTION,
    CB_READONLY,
    CB_SORT,
    CC_STD_BUTTON,
    CLOSE_BOX,
    DEFAULT_FRAME_STYLE,
    EVT_CLOSE_WINDOW,
    EVT_COMBOBOX,
    EVT_IDLE,
    EVT_MENU,
    EVT_TEXT,
    EVT_TEXT_ENTER,
    EXPAND,
    FD_OPEN,
    HORIZONTAL,
    ICON_INFORMATION,
    ID_ABOUT,
    ID_ANY,
    ID_EXIT,
    ID_HIGHEST,
    ID_OK,
    LEFT,
    LogErrorMsg,
    LogMessageMsg,
    OK,
    RESIZE_BORDER,
    RIGHT,
    SIZE_USE_EXISTING,
    SYS_COLOUR_WINDOW,
    SYSTEM_MENU,
    TE_MULTILINE,
    TE_RIGHT,
    TOP,
    VERTICAL,
    createKwxComboCtrlDefault,
    createKwxComboCtrlWith,
    createKwxListViewComboPopup,
    createKwxTreeCtrlComboPopup,
    createWxBoxSizer,
    createWxCheckBoxDefault,
    createWxClosure,
    createWxColourEmpty,
    createWxComboBox,
    createWxDialog,
    createWxFileDialog,
    createWxFontDefault,
    createWxFrame,
    createWxGenericComboCtrl,
    createWxIconDefault,
    createWxLogTextCtrl,
    createWxMenu,
    createWxMenuBar,
    createWxOwnerDrawnComboBoxWithChoices,
    createWxPanel,
    createWxStaticBox,
    createWxStaticBoxSizer,
    createWxStaticText,
    createWxString,
    createWxTextCtrl,
    createWxTreeItemId,
    exitMainLoop,
    initAllImageHandlers,
    initialize,
    kwxMessageBox,
    readAndDeleteWxString,
    run,
    setAppName,
    setTopWindow,
    shutdown,
    wxBitmapBundle,
    wxBitmapBundle_FromSVGFile,
    wxClassInfo_FindClass,
    wxCommandEvent,
    wxGetOsDescription,
    wxIdleEvent,
    wxLog_SetActiveTarget,
    wxOwnerDrawnComboBox,
    wxSystemSettings_GetColour,
    wxVersionString,
} from "kwx";
import { Callback, exit, platform, Pointer, pointerOf } from "kwx/platform";
import type {
    kwxListViewComboPopup,
    kwxTreeCtrlComboPopup,
    wxBoxSizer,
    wxClosure,
    wxComboBox,
    wxComboCtrl,
    wxFrame,
    wxLogTextCtrl,
    wxMenu,
    wxMenuBar,
    wxObject,
    wxPanel,
    wxStaticBox,
    wxStaticBoxSizer,
    wxStaticText,
    wxTextCtrl,
    wxTreeItemId,
    wxWindow,
} from "kwx";

declare const __dirname: string;

// ---------------------------------------------------------------------------
// combo.cpp constants
//   enum { ComboCtrl_Compare = wxID_HIGHEST,
//          ComboCtrl_Quit = wxID_EXIT,
//          ComboCtrl_About = wxID_ABOUT }
// The log text control uses the literal id 105 in the original.
// ---------------------------------------------------------------------------
const COMBOCTRL_COMPARE = ID_HIGHEST;
const COMBOCTRL_QUIT = ID_EXIT;
const COMBOCTRL_ABOUT = ID_ABOUT;
const LOG_CTRL_ID = 105;

/** wxDEFAULT_DIALOG_STYLE = wxCAPTION | wxSYSTEM_MENU | wxCLOSE_BOX */
const DEFAULT_DIALOG_STYLE = CAPTION | SYSTEM_MENU | CLOSE_BOX;

/** MyFrame::m_arrItems — the item list handed to every combo box. */
const ITEMS: readonly string[] = [
    "Solid",
    "Transparent",
    "Dot",
    "Long Dash",
    "Short Dash",
    "Dot Dash",
    "Backward Diagonal Hatch",
    "Cross-diagonal Hatch",
    "Forward Diagonal Hatch",
    "Cross Hatch",
    "Horizontal Hatch",
    "Vertical Hatch",
];

// ---------------------------------------------------------------------------
// Assets
//   sample.xpm        -> sample.svg   (wxICON(sample), 32x32)
//   dropbutn.svg      -> unchanged    (drop button, normal)
//   dropbutp.svg      -> unchanged    (drop button, pressed)
//   dropbuth.svg      -> unchanged    (drop button, hover)
//   three-dots.svg    -> unchanged    (file-selector button)
// The artwork is loaded through wxBitmapBundle::FromSVGFile() at its original
// size; the three drop buttons use 16x16, as in the C++ sample.
// ---------------------------------------------------------------------------
const DROP_BUTTON_SIZE = 16;

function assetPath(name: string): string
{
    return __dirname.replace(/\\/g, "/") + "/" + name;
}

/** wxBitmapBundle::FromSVGFile(file, wxSize(w, h)), owned. */
function loadBundle(name: string, width: number, height: number): wxBitmapBundle | null
{
    const path = createWxString(assetPath(name));
    let rawPtr: Pointer = null;
    try
    {
        rawPtr = wxBitmapBundle_FromSVGFile(path.ptr, width, height);
    }
    finally
    {
        path.Delete();
    }
    if (!rawPtr)
    {
        return null;
    }
    return new wxBitmapBundle(rawPtr);
}

/** SetIcon(wxICON(sample)) from the converted 32x32 sample.svg artwork. */
function applyFrameIcon(frame: wxFrame): void
{
    const bundle = loadBundle("sample.svg", 32, 32);
    if (!bundle)
    {
        return;
    }
    const bitmap = bundle.GetBitmap(32, 32);
    if (bitmap)
    {
        const icon = createWxIconDefault();
        if (icon)
        {
            // wxTopLevelWindow::SetIcon() copies the icon.
            icon.CopyFromBitmap(bitmap.ptr);
            frame.SetIcon(icon.ptr);
            icon.Delete();
        }
        bitmap.Delete();
    }
    bundle.Delete();
}

// ---------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------
/** A one-shot wxString whose lifetime is limited to `fn`. */
function withString<T>(text: string, fn: (ptr: Pointer) => T): T
{
    const value = createWxString(text);
    try
    {
        return fn(value.ptr);
    }
    finally
    {
        value.Delete();
    }
}

/** wxLogMessage(message) through kwxFFI's non-formatting entry point. */
function logMessage(text: string): void
{
    withString(text, (ptr) => LogMessageMsg(ptr));
}

/** wxStaticText(parent, wxID_ANY, text) with default position/size/style. */
function createLabel(parent: Pointer, text: string): wxStaticText | null
{
    return withString(text, (ptr) =>
        createWxStaticText(parent, ID_ANY, ptr, -1, -1, -1, -1, 0));
}

/** A wxBoxSizer factory that only fails on allocation failure. */
function newBoxSizer(orient: number): wxBoxSizer
{
    const sizer = createWxBoxSizer(orient);
    if (!sizer)
    {
        throw new Error("combo: failed to allocate a wxBoxSizer");
    }
    return sizer;
}

/** wxMenu(style = 0) with an empty title. */
function newMenu(): wxMenu | null
{
    return withString("", (ptr) => createWxMenu(ptr, 0n));
}

/**
 * Mirrors wxSizerFlags::GetDefaultBorder(): 6px on wxGTK, 5px on wxOSX and 5px
 * scaled by the top-level window's DPI on wxMSW (src/common/sizer.cpp
 * DoGetDefaultBorderInPx()). wxSizerFlags is not bound, so the distance is
 * computed here and passed to wxSizer::AddWindow()/AddSizer().
 */
function defaultBorder(frame: wxFrame): number
{
    if (platform === "linux")
    {
        return 6;
    }
    if (platform === "darwin")
    {
        return 5;
    }
    return Math.round(5 * frame.GetDPIScaleFactor());
}

/**
 * Calls `fn` with a `wxString**` array holding `items` (the shape
 * wxOwnerDrawnComboBox_CreateWithChoices() expects) and the item count. The
 * strings are released afterwards; the control copies them.
 */
function withWxStringArray<T>(
    items: readonly string[],
    fn: (choices: Pointer, count: number) => T,
): T
{
    const strings = items.map((item) => createWxString(item));
    try
    {
        const pointers = new BigUint64Array(strings.length);
        for (let index = 0; index < strings.length; ++index)
        {
            const ptr = strings[index].ptr;
            if (ptr === null)
            {
                throw new Error("combo: failed to allocate a wxString");
            }
            pointers[index] = ptr;
        }
        return fn(pointerOf(pointers), strings.length);
    }
    finally
    {
        for (const text of strings)
        {
            text.Delete();
        }
    }
}

/**
 * Calls `fn` with a `char**` array holding `items` — the shape
 * wxComboBox_Create() reads (`((char**) items)[i]`). The UTF-8 buffers stay
 * alive for the duration of the call.
 */
function withCStringArray<T>(
    items: readonly string[],
    fn: (strings: Pointer, count: number) => T,
): T
{
    const buffers = items.map((item) => new TextEncoder().encode(item + "\0"));
    const pointers = new BigUint64Array(buffers.length);
    for (let index = 0; index < buffers.length; ++index)
    {
        const ptr = pointerOf(buffers[index]);
        if (ptr === null)
        {
            throw new Error("combo: failed to pin a C string");
        }
        pointers[index] = ptr;
    }
    return fn(pointerOf(pointers), buffers.length);
}

// ---------------------------------------------------------------------------
// Combo-box construction
// ---------------------------------------------------------------------------

/**
 * MyFrame's wxOwnerDrawnComboBox construction:
 *   new wxOwnerDrawnComboBox(parent, wxID_ANY, wxEmptyString, wxDefaultPosition,
 *                            wxDefaultSize, m_arrItems, style)
 */
function createOwnerDrawnComboBox(
    parent: Pointer,
    style: number,
): wxOwnerDrawnComboBox | null
{
    const rawPtr = withWxStringArray(ITEMS, (choices, count) =>
        withString("", (value) =>
            createWxOwnerDrawnComboBoxWithChoices(
                parent, ID_ANY, value, -1, -1, -1, -1,
                count, choices, BigInt(style),
            )));
    if (!rawPtr)
    {
        return null;
    }
    return new wxOwnerDrawnComboBox(rawPtr);
}

/** wxComboBox with the same item list, built by the constructor. */
function createPlainComboBox(parent: Pointer, style: number): wxComboBox | null
{
    return withCStringArray(ITEMS, (strings, count) =>
        withString("", (value) =>
            createWxComboBox(
                parent, ID_ANY, value, -1, -1, -1, -1, count, strings, style,
            )));
}

/** odc->SetFont(odc->GetFont().Scale(1.5)) */
function scaleFont(window: wxWindow, factor: number): void
{
    const font = createWxFontDefault();
    if (!font)
    {
        return;
    }
    window.GetFont(font.ptr);
    font.Scale(factor);
    window.SetFont(font.ptr);
    font.Delete();
}

// ---------------------------------------------------------------------------
// Frame state — the MyFrame members
// ---------------------------------------------------------------------------
interface ComboFrameState
{
    frame: wxFrame;
    panel: wxPanel;
    logWin: wxTextCtrl;
    logger: wxLogTextCtrl | null;
    /** Value wxLog::SetActiveTarget() displaced (MyFrame::m_logOld). */
    oldLogTarget: Pointer;
    menuBar: wxMenuBar;
    /** Everything that must outlive the event loop. */
    callbacks: Callback[];
    closures: wxClosure[];
    /** Popup objects referenced by their combo controls. */
    popups: (kwxListViewComboPopup | kwxTreeCtrlComboPopup)[];
}

// ---------------------------------------------------------------------------
// MyFrame::OnAbout
// ---------------------------------------------------------------------------
function onAbout(state: ComboFrameState): void
{
    // wxVERSION_STRING and wxGetOsDescription() — both return an owned wxString.
    const version = readAndDeleteWxString(wxVersionString());
    const os = readAndDeleteWxString(wxGetOsDescription());

    const message =
        `Welcome to ${version}!\n`
        + "\n"
        + "This is the wxWidgets wxComboCtrl and wxOwnerDrawnComboBox sample\n"
        + `running under ${os}.`;

    withString(message, (text) =>
        withString("About wxComboCtrl sample", (caption) =>
            kwxMessageBox(
                text, caption, OK | ICON_INFORMATION, state.frame.ptr, -1, -1,
            )));
}

// ---------------------------------------------------------------------------
// MyFrame::OnShowComparison — the modal comparison dialog
// ---------------------------------------------------------------------------
interface GroupBox
{
    box: wxStaticBox;
    sizer: wxStaticBoxSizer;
}

/** wxStaticBoxSizer(new wxStaticBox(parent, wxID_ANY, label), wxVERTICAL) */
function createGroupBox(parent: Pointer, label: string): GroupBox | null
{
    const box = withString(label, (text) =>
        createWxStaticBox(parent, ID_ANY, text, -1, -1, -1, -1, 0));
    if (!box)
    {
        return null;
    }

    const sizer = createWxStaticBoxSizer(box.ptr, VERTICAL);
    if (!sizer)
    {
        box.Destroy();
        return null;
    }
    return { box, sizer };
}

/**
 * Adds a caption to a group box:
 *   wxSizerFlags().Expand().Border(wxRIGHT)   (first caption of a group)
 *   wxSizerFlags().Border(wxRIGHT)            (the other captions)
 */
function addGroupCaption(
    group: GroupBox,
    text: string,
    expand: boolean,
    border: number,
): void
{
    const label = createLabel(group.box.ptr, text);
    if (!label)
    {
        return;
    }
    const flags = (expand ? EXPAND : 0) | RIGHT;
    group.sizer.AddWindow(label.ptr, 0, flags, border, null);
}

/** The wxOwnerDrawnComboBox column of the comparison dialog. */
function fillOwnerDrawnGroup(group: GroupBox, border: number): void
{
    const box = group.box.ptr;
    const sizer = group.sizer;

    // Writable, with margins, sorted
    addGroupCaption(group, "Writable, with margins, sorted:", true, border);
    const writable = createOwnerDrawnComboBox(box, CB_SORT);
    if (writable)
    {
        // odc->Append("H - Appended Item"); // test sorting in append
        withString("H - Appended Item", (ptr) => { writable.Append(ptr); });
        withString("Dot Dash", (ptr) => { writable.SetValue(ptr); });
        writable.SetMargins(15, 10);
        sizer.AddWindow(writable.ptr, 0, ALL, border, null);
    }
    sizer.AddStretchSpacer(1);

    // Read-only, big font
    addGroupCaption(group, "Read-only, big font:", false, border);
    const bigFont = createOwnerDrawnComboBox(box, CB_SORT | CB_READONLY);
    if (bigFont)
    {
        scaleFont(bigFont, 1.5);
        withString("Dot Dash", (ptr) => { bigFont.SetValue(ptr); });
        withString("Dot Dash (Testing SetText)", (ptr) => { bigFont.SetText(ptr); });
        sizer.AddWindow(bigFont.ptr, 0, ALL, border, null);
    }
    sizer.AddStretchSpacer(1);

    // Read-only disabled
    addGroupCaption(group, "Read-only disabled:", false, border);
    const readOnlyDisabled = createOwnerDrawnComboBox(box, CB_READONLY);
    if (readOnlyDisabled)
    {
        withString("Dot Dash", (ptr) => { readOnlyDisabled.SetValue(ptr); });
        readOnlyDisabled.Enable(false);
        sizer.AddWindow(readOnlyDisabled.ptr, 3, EXPAND | ALL, border, null);
    }

    // Disabled
    addGroupCaption(group, "Disabled:", false, border);
    const disabled = createOwnerDrawnComboBox(box, 0);
    if (disabled)
    {
        withString("Dot Dash", (ptr) => { disabled.SetValue(ptr); });
        disabled.Enable(false);
        sizer.AddWindow(disabled.ptr, 3, EXPAND | ALL, border, null);
    }
}

/** The native wxComboBox column of the comparison dialog. */
function fillNativeGroup(group: GroupBox, border: number): void
{
    const box = group.box.ptr;
    const sizer = group.sizer;

    // Writable, with margins, sorted
    addGroupCaption(group, "Writable, with margins, sorted:", true, border);
    const writable = createPlainComboBox(box, CB_SORT);
    if (writable)
    {
        // cb->Append("H - Appended Item"); // test sorting in append
        withString("H - Appended Item", (ptr) => { writable.Append(ptr); });
        withString("Dot Dash", (ptr) => { writable.SetValue(ptr); });
        writable.SetMargins(15, 10);
        sizer.AddWindow(writable.ptr, 0, ALL, border, null);
    }
    sizer.AddStretchSpacer(1);

    // Read-only, big font
    addGroupCaption(group, "Read-only, big font:", false, border);
    const bigFont = createPlainComboBox(box, CB_SORT | CB_READONLY);
    if (bigFont)
    {
        scaleFont(bigFont, 1.5);
        withString("Dot Dash", (ptr) => { bigFont.SetValue(ptr); });
        sizer.AddWindow(bigFont.ptr, 0, ALL, border, null);
    }
    sizer.AddStretchSpacer(1);

    // Read-only disabled
    addGroupCaption(group, "Read-only disabled:", false, border);
    const readOnlyDisabled = createPlainComboBox(box, CB_READONLY);
    if (readOnlyDisabled)
    {
        withString("Dot Dash", (ptr) => { readOnlyDisabled.SetValue(ptr); });
        readOnlyDisabled.Enable(false);
        sizer.AddWindow(readOnlyDisabled.ptr, 3, EXPAND | ALL, border, null);
    }

    // Disabled
    addGroupCaption(group, "Disabled:", false, border);
    const disabled = createPlainComboBox(box, 0);
    if (disabled)
    {
        withString("Dot Dash", (ptr) => { disabled.SetValue(ptr); });
        disabled.Enable(false);
        sizer.AddWindow(disabled.ptr, 3, EXPAND | ALL, border, null);
    }
}

/** MyFrame::OnShowComparison */
function showComparisonDialog(state: ComboFrameState): void
{
    const dialog = withString("Compare against wxComboBox", (title) =>
        createWxDialog(
            state.frame.ptr, ID_ANY, title, -1, -1, -1, -1,
            DEFAULT_DIALOG_STYLE | RESIZE_BORDER,
        ));
    if (!dialog)
    {
        console.error("combo: failed to create the comparison dialog");
        return;
    }

    const border = defaultBorder(state.frame);

    const colSizer = newBoxSizer(VERTICAL);
    const rowSizer = newBoxSizer(HORIZONTAL);

    const ownerDrawnGroup = createGroupBox(dialog.ptr, " wxOwnerDrawnComboBox ");
    if (!ownerDrawnGroup)
    {
        dialog.Destroy();
        return;
    }
    fillOwnerDrawnGroup(ownerDrawnGroup, border);
    rowSizer.AddSizer(ownerDrawnGroup.sizer.ptr, 1, EXPAND | ALL, border, null);

    const nativeGroup = createGroupBox(dialog.ptr, " wxComboBox ");
    if (!nativeGroup)
    {
        dialog.Destroy();
        return;
    }
    fillNativeGroup(nativeGroup, border);
    rowSizer.AddSizer(nativeGroup.sizer.ptr, 1, EXPAND | ALL, border, null);

    colSizer.AddSizer(rowSizer.ptr, 1, EXPAND | ALL, border, null);

    dialog.SetSizer(colSizer.ptr, true);
    colSizer.SetSizeHints(dialog.ptr);

    // dlg->SetSize(60, 240) resolves to SetSize(int width, int height), i.e.
    // DoSetSize(wxDefaultCoord, wxDefaultCoord, 60, 240, wxSIZE_USE_EXISTING).
    dialog.SetSize(-1, -1, 60, 240, SIZE_USE_EXISTING);
    dialog.Centre(BOTH);
    dialog.ShowModal();

    // The C++ sample leaks the dialog; destroying it keeps the port tidy.
    dialog.Destroy();
}

// ---------------------------------------------------------------------------
// The custom combo controls
// ---------------------------------------------------------------------------

/**
 * wxComboCtrl with the ListView combo popup:
 *   wxComboCtrlWithCustomPopupAnim* cc = new wxComboCtrlWithCustomPopupAnim();
 *   cc->SetTextCtrlStyle(wxTE_RIGHT);
 *   cc->Create(panel, wxID_ANY, wxEmptyString);
 *   cc->UseAltPopupWindow();
 *   cc->SetPopupMinWidth(300);
 *   cc->SetPopupControl(new ListViewComboPopup());
 *   for (i = 0; i < 100; i++) iface->AddSelection(wxString::Format("Item %02i", i));
 *
 * AnimateShow() is not overridden (see the porting notes), so no
 * SetOnAnimateShow() callback is installed.
 */
function createListViewCombo(
    panel: Pointer,
    state: ComboFrameState,
): wxComboCtrl | null
{
    const combo = createKwxComboCtrlDefault(null);
    if (!combo)
    {
        return null;
    }

    combo.SetTextCtrlStyle(TE_RIGHT);

    const created = withString("", (value) =>
        combo.Create(panel, ID_ANY, value, -1, -1, -1, -1, 0n));
    if (!created)
    {
        return null;
    }

    combo.UseAltPopupWindow(true);
    combo.SetPopupMinWidth(300);

    const popup = createKwxListViewComboPopup();
    if (!popup)
    {
        return null;
    }
    state.popups.push(popup);
    combo.SetPopupControl(popup.ptr);

    for (let index = 0; index < 100; ++index)
    {
        const number = index.toString().padStart(2, "0");
        withString(`Item ${number}`, (ptr) => popup.AddString(ptr));
    }

    return combo;
}

/**
 * wxGenericComboCtrl + TreeCtrlComboPopup:
 *   gcc = new wxGenericComboCtrl(panel, wxID_ANY, wxEmptyString, ...);
 *   gcc->UseAltPopupWindow();
 *   gcc->SetPopupControl(new TreeCtrlComboPopup());
 *   root = tcPopup->AddRoot("<hidden_root>");
 *   for (i = 0; i < 4; i++) { group = AppendItem(root, Format("Branch %02i", i));
 *                             for (n = 0; n < 25; n++) AppendItem(group, ...) }
 *   gcc->SetValue("Subitem 05");
 *   gcc->SetButtonPosition(-1, -1, wxLEFT, 0);
 */
function createTreeCombo(
    panel: Pointer,
    state: ComboFrameState,
): wxComboCtrl | null
{
    const combo = withString("", (value) =>
        createWxGenericComboCtrl(panel, ID_ANY, value, -1, -1, -1, -1, 0n));
    if (!combo)
    {
        return null;
    }

    combo.UseAltPopupWindow(true);

    const popup = createKwxTreeCtrlComboPopup();
    if (!popup)
    {
        return null;
    }
    state.popups.push(popup);
    combo.SetPopupControl(popup.ptr);

    // Add items through the popup's tree-control helpers (the wrapped
    // wxTreeCtrl is reachable only that way). Each helper writes its
    // wxTreeItemId result into the supplied object.
    const root: wxTreeItemId | null = createWxTreeItemId();
    const group: wxTreeItemId | null = createWxTreeItemId();
    if (!root || !group)
    {
        root?.Delete();
        group?.Delete();
        return combo;
    }

    withString("<hidden_root>", (ptr) => popup.AddRoot(ptr, root.ptr));

    for (let branch = 0; branch < 4; ++branch)
    {
        const branchName = branch.toString().padStart(2, "0");
        withString(`Branch ${branchName}`, (ptr) =>
            popup.AppendItem(root.ptr, ptr, group.ptr));

        for (let item = 0; item < 25; ++item)
        {
            const number = (branch * 25 + item).toString().padStart(2, "0");
            withString(`Subitem ${number}`, (ptr) =>
                popup.AppendItem(group.ptr, ptr, group.ptr));
        }
    }

    root.Delete();
    group.Delete();

    // gcc->SetValue("Subitem 05")
    withString("Subitem 05", (ptr) => { combo.SetValue(ptr); });

    // Move button to left - it makes more sense for a tree ctrl.
    combo.SetButtonPosition(-1, -1, LEFT, 0);

    return combo;
}

/**
 * wxFileSelectorCombo: a wxComboCtrl whose button opens a wxFileDialog and
 * whose DoSetPopupControl() is empty (this suppresses the wxWidgets assertion
 * for a combo that only has a custom button action).
 *
 *   new wxFileSelectorCombo(panel, wxID_ANY, wxEmptyString, wxDefaultPosition,
 *                           wxDefaultSize, style | wxCC_STD_BUTTON)
 *   SetButtonBitmaps(wxBitmapBundle::FromSVGFile("three-dots.svg", 16x16), true)
 */
function createFileSelectorCombo(
    panel: Pointer,
    state: ComboFrameState,
): wxComboCtrl | null
{
    const combo = withString("", (value) =>
        createKwxComboCtrlWith(
            null, panel, ID_ANY, value, -1, -1, -1, -1,
            BigInt(0 | CC_STD_BUTTON),
        ));
    if (!combo)
    {
        return null;
    }

    const dots = loadBundle("three-dots.svg", DROP_BUTTON_SIZE, DROP_BUTTON_SIZE);
    if (dots)
    {
        combo.SetButtonBitmaps(dots.ptr, true, null, null, null);
        dots.Delete();
    }

    // OnButtonClick(): show a standard wxFileDialog and keep its path.
    const buttonCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        () => { onFileSelectorButton(combo); },
    );
    state.callbacks.push(buttonCallback);
    combo.SetOnButtonClick(buttonCallback.pointer);

    // The C++ override has an empty body; the kwx helper calls it instead of
    // wxComboCtrl::DoSetPopupControl().
    const popupCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        () => { /* DoSetPopupControl(): intentionally empty */ },
    );
    state.callbacks.push(popupCallback);
    combo.SetOnDoSetPopupControl(popupCallback.pointer);

    return combo;
}

/** wxFileSelectorCombo::OnButtonClick() */
function onFileSelectorButton(combo: wxComboCtrl): void
{
    const value = combo.GetValue();
    const defaultFile = value ? value.ptr : null;

    const dialog = withString("Choose File", (message) =>
        withString("", (directory) =>
            withString("All files (*.*)|*.*", (wildcard) =>
                createWxFileDialog(
                    combo.ptr, message, directory, defaultFile,
                    wildcard, -1, -1, FD_OPEN, -1, -1,
                ))));
    if (value)
    {
        // wxComboCtrl::GetValue() returns an owned wxString.
        readAndDeleteWxString(value.ptr);
    }

    if (!dialog)
    {
        return;
    }

    if (dialog.ShowModal() === ID_OK)
    {
        // wxFileDialog::GetPath() returns an owned wxString wrapper; the pointer
        // is what the export consumes.
        const path = dialog.GetPath();
        const fileName = path ? readAndDeleteWxString(path.ptr) : "";
        withString(fileName, (ptr) => { combo.SetValue(ptr); });
    }
    dialog.Destroy();
}

/**
 * wxComboCtrl with a wxCheckBox as main control:
 *   wxComboCtrl* comboCustom = new wxComboCtrl();
 *   wxCheckBox* cbox = new wxCheckBox();
 *   comboCustom->SetMainControl(cbox);
 *   comboCustom->Create(panel, wxID_ANY, wxEmptyString);
 *   cbox->Create(comboCustom, wxID_ANY, "Checkbox as main control");
 *   cbox->SetBackgroundColour(wxSystemSettings::GetColour(wxSYS_COLOUR_WINDOW));
 *   comboCustom->SetPopupControl(new ListViewComboPopup());
 */
function createCheckBoxMainCombo(
    panel: Pointer,
    state: ComboFrameState,
): wxComboCtrl | null
{
    const combo = createKwxComboCtrlDefault(null);
    const checkBox = createWxCheckBoxDefault();
    if (!combo || !checkBox)
    {
        return null;
    }

    combo.SetMainControl(checkBox.ptr);

    const created = withString("", (value) =>
        combo.Create(panel, ID_ANY, value, -1, -1, -1, -1, 0n));
    if (!created)
    {
        return null;
    }

    withString("Checkbox as main control", (text) =>
        checkBox.Create2(combo.ptr, ID_ANY, text, -1, -1, -1, -1, 0));

    const background = createWxColourEmpty();
    if (background)
    {
        wxSystemSettings_GetColour(SYS_COLOUR_WINDOW, background.ptr);
        checkBox.SetBackgroundColour(background.ptr);
        background.Delete();
    }

    const popup = createKwxListViewComboPopup();
    if (popup)
    {
        state.popups.push(popup);
        combo.SetPopupControl(popup.ptr);
    }

    return combo;
}

// ---------------------------------------------------------------------------
// MyFrame::MyFrame()
// ---------------------------------------------------------------------------
function createComboFrame(): ComboFrameState | null
{
    const frame = withString(
        "wxComboCtrl and wxOwnerDrawnComboBox Sample",
        (title) => createWxFrame(
            null, ID_ANY, title, -1, -1, -1, -1, DEFAULT_FRAME_STYLE,
        ),
    );
    if (!frame)
    {
        console.error("combo: failed to create the main frame");
        return null;
    }

    // SetIcon(wxICON(sample))
    applyFrameIcon(frame);

    // --- menu bar ---
    const fileMenu = newMenu();
    const helpMenu = newMenu();
    if (!fileMenu || !helpMenu)
    {
        frame.Destroy();
        return null;
    }

    withString("&About\tF1", (text) =>
        withString("Show about dialog", (help) =>
            helpMenu.Append(COMBOCTRL_ABOUT, text, help, false)));

    withString("&Compare against wxComboBox...", (text) =>
        withString(
            "Show some wxOwnerDrawnComboBoxes side-by-side with native wxComboBoxes.",
            (help) => fileMenu.Append(COMBOCTRL_COMPARE, text, help, false)));

    fileMenu.AppendSeparator();

    withString("E&xit\tAlt-X", (text) =>
        withString("Quit this program", (help) =>
            fileMenu.Append(COMBOCTRL_QUIT, text, help, false)));

    const menuBar = createWxMenuBar(0);
    if (!menuBar)
    {
        frame.Destroy();
        return null;
    }
    withString("&File", (text) => { menuBar.Append(fileMenu.ptr, text); });
    withString("&Help", (text) => { menuBar.Append(helpMenu.ptr, text); });
    frame.SetMenuBar(menuBar.ptr);

    // --- panel and log window ---
    const panel = createWxPanel(frame.ptr, ID_ANY, -1, -1, -1, -1, 0);
    if (!panel)
    {
        frame.Destroy();
        return null;
    }

    // m_logWin = new wxTextCtrl(panel, 105, wxEmptyString, wxDefaultPosition,
    //                           wxSize(-1, 125), wxTE_MULTILINE);
    const logWin = withString("", (text) => createWxTextCtrl(
        panel.ptr, LOG_CTRL_ID, text, -1, -1, -1, 125, TE_MULTILINE,
    ));
    if (!logWin)
    {
        frame.Destroy();
        return null;
    }

    // m_logOld = wxLog::SetActiveTarget(new wxLogTextCtrl(m_logWin));
    const logger = createWxLogTextCtrl(logWin.ptr);
    let oldLogTarget: Pointer = null;
    if (logger)
    {
        oldLogTarget = wxLog_SetActiveTarget(logger.ptr)?.ptr ?? null;
        logger.DisableTimestamp();
    }

    const state: ComboFrameState = {
        frame,
        panel,
        logWin,
        logger,
        oldLogTarget,
        menuBar,
        callbacks: [],
        closures: [],
        popups: [],
    };

    const border = defaultBorder(frame);
    const topSizer = newBoxSizer(VERTICAL);
    const topRowSizer = newBoxSizer(HORIZONTAL);
    let colSizer = newBoxSizer(VERTICAL);

    let rowSizer: wxBoxSizer;
    let label: wxStaticText | null;

    // -----------------------------------------------------------------------
    // OwnerDrawnComboBox with owner-drawn items.
    // -----------------------------------------------------------------------
    rowSizer = newBoxSizer(HORIZONTAL);
    label = createLabel(panel.ptr, "OwnerDrawnComboBox with owner-drawn items:");
    if (label)
    {
        rowSizer.AddWindow(
            label.ptr, 1, ALIGN_CENTER_VERTICAL | RIGHT, border, null,
        );
    }
    colSizer.AddSizer(rowSizer.ptr, 0, EXPAND | ALL, border, null);

    rowSizer = newBoxSizer(HORIZONTAL);
    const penCombo = createOwnerDrawnComboBox(panel.ptr, CB_READONLY);
    if (penCombo)
    {
        // odc->SetSelection(0)
        penCombo.SetSelection(0);
        rowSizer.AddWindow(
            penCombo.ptr, 1, ALIGN_CENTER_VERTICAL | ALL, border, null,
        );
    }
    rowSizer.AddStretchSpacer(1);
    colSizer.AddSizer(rowSizer.ptr, 0, EXPAND | ALL, border, null);

    // -----------------------------------------------------------------------
    // Same, with the button on the left.
    // -----------------------------------------------------------------------
    rowSizer = newBoxSizer(HORIZONTAL);
    label = createLabel(
        panel.ptr,
        "OwnerDrawnComboBox with owner-drawn items and button on the left:",
    );
    if (label)
    {
        rowSizer.AddWindow(
            label.ptr, 1, ALIGN_CENTER_VERTICAL | RIGHT, border, null,
        );
    }
    colSizer.AddSizer(rowSizer.ptr, 0, EXPAND | ALL, border, null);

    rowSizer = newBoxSizer(HORIZONTAL);
    const leftButtonCombo = createOwnerDrawnComboBox(panel.ptr, CB_READONLY);
    if (leftButtonCombo)
    {
        leftButtonCombo.SetSelection(0);

        // Use a button size that is slightly smaller than the default:
        //   wxSize butSize = odc->GetButtonSize();
        //   odc->SetButtonPosition(butSize.x - 2, butSize.y - 6, wxLEFT, 2);
        const butSize = leftButtonCombo.GetButtonSize();
        if (butSize)
        {
            const width = butSize.GetWidth() - 2;
            const height = butSize.GetHeight() - 6;
            butSize.Delete();
            leftButtonCombo.SetButtonPosition(width, height, LEFT, 2);
        }
        else
        {
            leftButtonCombo.SetButtonPosition(-1, -1, LEFT, 2);
        }

        rowSizer.AddWindow(
            leftButtonCombo.ptr, 1, ALIGN_CENTER_VERTICAL | ALL, border, null,
        );
    }
    rowSizer.AddStretchSpacer(1);
    colSizer.AddSizer(rowSizer.ptr, 0, EXPAND | ALL, border, null);

    // -----------------------------------------------------------------------
    // List View / Tree Ctrl wxComboCtrl.
    // -----------------------------------------------------------------------
    rowSizer = newBoxSizer(HORIZONTAL);
    label = createLabel(panel.ptr, "List View wxComboCtrl (custom animation):");
    if (label)
    {
        rowSizer.AddWindow(
            label.ptr, 1, ALIGN_CENTER_VERTICAL | RIGHT, border, null,
        );
    }
    label = createLabel(panel.ptr, "Tree Ctrl wxComboCtrl:");
    if (label)
    {
        rowSizer.AddWindow(
            label.ptr, 1, ALIGN_CENTER_VERTICAL | RIGHT, border, null,
        );
    }
    colSizer.AddSizer(rowSizer.ptr, 0, EXPAND | ALL, border, null);

    rowSizer = newBoxSizer(HORIZONTAL);
    const listViewCombo = createListViewCombo(panel.ptr, state);
    if (listViewCombo)
    {
        rowSizer.AddWindow(
            listViewCombo.ptr, 1, ALIGN_CENTER_VERTICAL | ALL, border, null,
        );
    }

    const treeCombo = createTreeCombo(panel.ptr, state);
    if (treeCombo)
    {
        rowSizer.AddWindow(
            treeCombo.ptr, 1, ALIGN_CENTER_VERTICAL | ALL, border, null,
        );
    }
    colSizer.AddSizer(rowSizer.ptr, 0, EXPAND | ALL, border, null);

    // -----------------------------------------------------------------------
    // Custom drop button bitmaps (wxUSE_IMAGE / wxHAS_SVG section).
    // -----------------------------------------------------------------------
    rowSizer = newBoxSizer(HORIZONTAL);
    label = createLabel(
        panel.ptr, "OwnerDrawnComboBox with simple dropbutton graphics:",
    );
    if (label)
    {
        rowSizer.AddWindow(
            label.ptr, 1, ALIGN_CENTER_VERTICAL | RIGHT, border, null,
        );
    }
    colSizer.AddSizer(rowSizer.ptr, 0, EXPAND | ALL, border, null);

    rowSizer = newBoxSizer(HORIZONTAL);
    const dropButtonCombo = createOwnerDrawnComboBox(panel.ptr, 0);
    const dropButtonCombo2 = createOwnerDrawnComboBox(panel.ptr, 0);

    // Load images from disk.
    const bmpNormal = loadBundle("dropbutn.svg", DROP_BUTTON_SIZE, DROP_BUTTON_SIZE);
    const bmpPressed = loadBundle("dropbutp.svg", DROP_BUTTON_SIZE, DROP_BUTTON_SIZE);
    const bmpHover = loadBundle("dropbuth.svg", DROP_BUTTON_SIZE, DROP_BUTTON_SIZE);

    if (bmpNormal && bmpPressed && bmpHover
        && bmpNormal.IsOk() && bmpPressed.IsOk() && bmpHover.IsOk())
    {
        // odc->SetButtonBitmaps(bmpNormal, false, bmpPressed, bmpHover);
        dropButtonCombo?.SetButtonBitmaps(
            bmpNormal.ptr, false, bmpPressed.ptr, bmpHover.ptr, null,
        );
        // odc2->SetButtonBitmaps(bmpNormal, true, bmpPressed, bmpHover);
        dropButtonCombo2?.SetButtonBitmaps(
            bmpNormal.ptr, true, bmpPressed.ptr, bmpHover.ptr, null,
        );
    }
    else
    {
        withString("Dropbutton images not found", (ptr) => LogErrorMsg(ptr));
    }

    if (dropButtonCombo)
    {
        rowSizer.AddWindow(
            dropButtonCombo.ptr, 1, ALIGN_CENTER_VERTICAL | ALL, border, null,
        );
    }
    if (dropButtonCombo2)
    {
        rowSizer.AddWindow(
            dropButtonCombo2.ptr, 1, ALIGN_CENTER_VERTICAL | ALL, border, null,
        );
    }
    colSizer.AddSizer(rowSizer.ptr, 0, EXPAND | ALL, border, null);

    // -----------------------------------------------------------------------
    // wxComboCtrl with a custom button action (open file dialog) and a
    // wxCheckBox as the main control.
    // -----------------------------------------------------------------------
    rowSizer = newBoxSizer(HORIZONTAL);
    label = createLabel(
        panel.ptr, "wxComboCtrl with custom button and custom main control:",
    );
    if (label)
    {
        rowSizer.AddWindow(
            label.ptr, 1, ALIGN_CENTER_VERTICAL | RIGHT, border, null,
        );
    }
    colSizer.AddSizer(rowSizer.ptr, 0, EXPAND | ALL, border, null);

    rowSizer = newBoxSizer(HORIZONTAL);
    const fileSelectorCombo = createFileSelectorCombo(panel.ptr, state);
    if (fileSelectorCombo)
    {
        rowSizer.AddWindow(
            fileSelectorCombo.ptr, 1, ALIGN_CENTER_VERTICAL | ALL, border, null,
        );
    }

    const checkBoxCombo = createCheckBoxMainCombo(panel.ptr, state);
    if (checkBoxCombo)
    {
        rowSizer.AddWindow(
            checkBoxCombo.ptr, 1, ALIGN_CENTER_VERTICAL | ALL, border, null,
        );
    }
    colSizer.AddSizer(rowSizer.ptr, 0, EXPAND | ALL, border, null);

    // wxComboCtrl::GetFeatures() is called by the original only to make sure it
    // is implemented; it has no observable effect.

    // --- right column: log messages ---
    topRowSizer.AddSizer(colSizer.ptr, 1, ALL, frame.FromDIP(2), null);

    colSizer = newBoxSizer(VERTICAL);
    colSizer.AddSpacer(8);
    label = createLabel(panel.ptr, "Log Messages:");
    if (label)
    {
        colSizer.AddWindow(label.ptr, 0, TOP | LEFT, frame.FromDIP(3), null);
    }
    colSizer.AddWindow(logWin.ptr, 1, EXPAND | ALL, frame.FromDIP(3), null);

    topRowSizer.AddSizer(colSizer.ptr, 1, EXPAND | ALL, frame.FromDIP(2), null);
    topSizer.AddSizer(topRowSizer.ptr, 1, EXPAND, 0, null);

    panel.SetSizer(topSizer.ptr, true);
    topSizer.SetSizeHints(panel.ptr);

    frame.Fit();
    frame.Centre(BOTH);

    return state;
}

// ---------------------------------------------------------------------------
// MyFrame event table
// ---------------------------------------------------------------------------
let comboCtrlClassInfo: Pointer = null;
let comboCtrlClassInfoResolved = false;

/** wxClassInfo::FindClass("wxComboCtrl") */
function findComboCtrlClassInfo(): Pointer
{
    if (!comboCtrlClassInfoResolved)
    {
        comboCtrlClassInfoResolved = true;
        comboCtrlClassInfo = withString(
            "wxComboCtrl",
            (name) => wxClassInfo_FindClass(name),
        );
    }
    return comboCtrlClassInfo;
}

/** MyFrame::OnComboBoxUpdate */
function onComboBoxUpdate(event: wxCommandEvent): void
{
    // Don't show messages for the log output window (it would crash).
    const source: wxObject | null = event.GetEventObject();
    const classInfo = findComboCtrlClassInfo();
    if (!source || !classInfo || !source.IsKindOf(classInfo))
    {
        return;
    }

    const eventType = event.GetEventType();
    if (eventType === EVT_COMBOBOX)
    {
        logMessage(
            `EVT_COMBOBOX(id=${event.GetId()},selection=${event.GetSelection()})`,
        );
    }
    else if (eventType === EVT_TEXT)
    {
        const string = event.GetString();
        const value = string ? readAndDeleteWxString(string.ptr) : "";
        logMessage(`EVT_TEXT(id=${event.GetId()},string="${value}")`);
    }
    else if (eventType === EVT_TEXT_ENTER)
    {
        const string = event.GetString();
        const value = string ? readAndDeleteWxString(string.ptr) : "";
        logMessage(`EVT_TEXT_ENTER(id=${event.GetId()},string="${value}")`);
    }
}

/** Installs one wxEvtHandler::Bind() entry with a command-event handler. */
function bindCommand(
    state: ComboFrameState,
    target: wxWindow,
    id: number,
    eventType: number,
    handler: (event: wxCommandEvent) => void,
): void
{
    const callback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return; // teardown sweep: wxClosure calls handlers with null
            }
            handler(new wxCommandEvent(eventPtr));
        },
    );
    const closure = createWxClosure(callback.pointer, null)!;
    target.Bind(id, id, eventType, closure.ptr);
    state.callbacks.push(callback);
    state.closures.push(closure);
}

function connectComboEvents(state: ComboFrameState): void
{
    const frame = state.frame;

    // EVT_TEXT(wxID_ANY, MyFrame::OnComboBoxUpdate)
    bindCommand(state, frame, ID_ANY, EVT_TEXT, onComboBoxUpdate);
    // EVT_TEXT_ENTER(wxID_ANY, MyFrame::OnComboBoxUpdate)
    bindCommand(state, frame, ID_ANY, EVT_TEXT_ENTER, onComboBoxUpdate);
    // EVT_COMBOBOX(wxID_ANY, MyFrame::OnComboBoxUpdate)
    bindCommand(state, frame, ID_ANY, EVT_COMBOBOX, onComboBoxUpdate);

    // EVT_MENU(ComboCtrl_Compare, MyFrame::OnShowComparison)
    bindCommand(state, frame, COMBOCTRL_COMPARE, EVT_MENU,
        () => { showComparisonDialog(state); });

    // EVT_MENU(ComboCtrl_Quit, MyFrame::OnQuit) — Close(true)
    bindCommand(state, frame, COMBOCTRL_QUIT, EVT_MENU,
        () => { state.frame.Close(true); });

    // EVT_MENU(ComboCtrl_About, MyFrame::OnAbout)
    bindCommand(state, frame, COMBOCTRL_ABOUT, EVT_MENU,
        () => { onAbout(state); });

    // EVT_IDLE(MyFrame::OnIdle) — the handler only calls event.Skip().
    const idleCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            new wxIdleEvent(eventPtr).Skip(true);
        },
    );
    const idleClosure = createWxClosure(idleCallback.pointer, null)!;
    frame.Bind(ID_ANY, ID_ANY, EVT_IDLE, idleClosure.ptr);
    state.callbacks.push(idleCallback);
    state.closures.push(idleClosure);

    // Closing the frame ends the program.
    const closeCallback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            exitMainLoop();
        },
    );
    const closeClosure = createWxClosure(closeCallback.pointer, null)!;
    frame.Bind(ID_ANY, ID_ANY, EVT_CLOSE_WINDOW, closeClosure.ptr);
    state.callbacks.push(closeCallback);
    state.closures.push(closeClosure);
}

/**
 * MyFrame::~MyFrame(): delete wxLog::SetActiveTarget(m_logOld)
 *
 * wxLog::SetActiveTarget() returns the displaced target, which is this frame's
 * wxLogTextCtrl — the C++ destructor deletes exactly that object.
 */
function restoreLogTarget(state: ComboFrameState): void
{
    if (!state.logger)
    {
        return;
    }
    state.logger = null;
    const previous = wxLog_SetActiveTarget(state.oldLogTarget);
    previous?.Delete();
}

export function main(): number
{
    if (!initialize())
    {
        console.error("Failed to initialize wxWidgets");
        return 1;
    }

    setAppName("combo");

    // wxInitAllImageHandlers() — the C++ sample calls it before loading the
    // drop button artwork.
    initAllImageHandlers();

    const state = createComboFrame();
    if (!state)
    {
        shutdown();
        return 1;
    }

    connectComboEvents(state);

    state.frame.Show();
    setTopWindow(state.frame.ptr);

    const exitCode = run();

    for (const callback of state.callbacks)
    {
        callback.close();
    }
    restoreLogTarget(state);
    shutdown();
    return exitCode;
}

exit(main());
