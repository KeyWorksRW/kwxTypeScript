// bmpcombobox.kwxts — port of wxSamples/src/widgets/bmpcombobox.cpp
//
// Same three-pane layout as the C++ sample.  Bitmaps come either from the
// icon files shipped with the sample or from a file picked with
// wxLoadFileSelector(); the C++ directory scan for *.xpm icons is replaced by
// the equivalent list of SVG assets (see the final report).

import {
    ALIGN_CENTRE_HORIZONTAL,
    ALIGN_CENTRE_VERTICAL,
    ALL,
    CB_DROPDOWN,
    CB_READONLY,
    CB_SIMPLE,
    CB_SORT,
    createWxBitmapComboBox,
    createWxBitmapFromImage,
    createWxBoxSizer,
    createWxButton,
    createWxColourFromInt,
    createWxImageFromFile,
    createWxImageSized,
    createWxRadioBox,
    createWxSizerFlags,
    createWxSize,
    createWxStaticText,
    createWxTextCtrl,
    EVT_BUTTON,
    EVT_CHECKBOX,
    EVT_COMBOBOX,
    EVT_COMBOBOX_CLOSEUP,
    EVT_COMBOBOX_DROPDOWN,
    EVT_RADIOBOX,
    EVT_TEXT,
    EVT_TEXT_ENTER,
    EVT_UPDATE_UI,
    EXPAND,
    HORIZONTAL,
    ID_ANY,
    ID_HIGHEST,
    kwxMessageBox,
    OK,
    LEFT,
    NOT_FOUND,
    Null_Bitmap,
    RA_SPECIFY_COLS,
    readAndDeleteWxString,
    RIGHT,
    TE_PROCESS_ENTER,
    TOP,
    VERTICAL,
    wxBitmap,
    wxBitmapBundle_FromSVGFile,
    wxBitmapComboBox,
    wxCheckBox,
    wxColour,
    wxCommandEvent,
    wxImage,
    wxInitAllImageHandlers,
    wxItemContainer,
    wxLoadFileSelector,
    wxRadioBox,
    wxSizer,
    wxTextCtrl,
    wxUpdateUIEvent,
    wxWindow,
    wrapWxBitmapBundle,
} from "kwx";
import { pointerOf, Pointer } from "kwx/platform";

import {
    addSizer,
    addWin,
    attrs,
    bindEvent,
    border,
    doubleBorder,
    logMessage,
    makeStaticBoxSizer,
    samplePath,
    StaticBoxSizerParts,
    WidgetsPage,
    withString,
    withStrings,
} from "./common.kwxts";
import { runItemContainerTest } from "./itemcontainer.kwxts";

// Control ids (BitmapComboBoxPage_XXX in the C++ sample).
const BMPCOMBO_RESET = ID_HIGHEST;
const BMPCOMBO_INSERT = BMPCOMBO_RESET + 1;
const BMPCOMBO_INSERT_TEXT = BMPCOMBO_INSERT + 1;
const BMPCOMBO_CHANGE_HEIGHT = BMPCOMBO_INSERT_TEXT + 1;
const BMPCOMBO_LOAD_FROM_FILE = BMPCOMBO_CHANGE_HEIGHT + 1;
const BMPCOMBO_SET_FROM_FILE = BMPCOMBO_LOAD_FROM_FILE + 1;
const BMPCOMBO_ADD_WIDGET_ICONS = BMPCOMBO_SET_FROM_FILE + 1;
const BMPCOMBO_ADD_SEVERAL_WITH_IMAGES = BMPCOMBO_ADD_WIDGET_ICONS + 1;
const BMPCOMBO_ADD_SEVERAL = BMPCOMBO_ADD_SEVERAL_WITH_IMAGES + 1;
const BMPCOMBO_ADD_MANY = BMPCOMBO_ADD_SEVERAL + 1;
const BMPCOMBO_CLEAR = BMPCOMBO_ADD_MANY + 1;
const BMPCOMBO_CHANGE = BMPCOMBO_CLEAR + 1;
const BMPCOMBO_DELETE = BMPCOMBO_CHANGE + 1;
const BMPCOMBO_DELETE_TEXT = BMPCOMBO_DELETE + 1;
const BMPCOMBO_DELETE_SEL = BMPCOMBO_DELETE_TEXT + 1;
const BMPCOMBO_COMBO = BMPCOMBO_DELETE_SEL + 1;
const BMPCOMBO_CONTAINER_TESTS = BMPCOMBO_COMBO + 1;

// Kinds of comboboxes (ComboKind_XXX).
const COMBO_KIND_SIMPLE = 1;
const COMBO_KIND_DROP_DOWN = 2;

const COMBO_KINDS: string[] = ["default", "simple", "drop down"];

// Images loaded from file are reduced to this width and height, if larger.
const IMAGE_SIZE_TRUNC = 256;

// Icons shipped with this sample as SVG, replacing the C++ scan for *.xpm
// files in the "icons" directory (bmpbtn is skipped there as well).
const WIDGET_ICON_NAMES: string[] = [
    "activityindicator",
    "bmpcombobox",
    "button",
    "checkbox",
    "choice",
    "choicebk",
    "clrpicker",
    "combobox",
    "datepick",
    "dirctrl",
    "dirpicker",
    "filepicker",
    "fontpicker",
    "gauge",
    "header",
    "hyperlnk",
    "listbook",
    "listbox",
    "native",
    "notebook",
    "odcombobox",
    "radiobox",
    "scrolbar",
    "slider",
    "spinbtn",
    "statbmp",
    "statbox",
    "stattext",
    "text",
    "timepick",
    "toggle",
];

// "static bool isFirstScale" of RescaleImage().
let firstImageScale = true;

// "static unsigned int s_item" of OnButtonInsert().
let insertCounter = 0;

/**
 * Builds the `char**` array expected by the kwxFFI string-array parameters.
 * The returned `keep` array must stay reachable until the native call returns.
 */
function charPtrArray(
    items: string[],
): { ptr: Pointer; keep: (Uint8Array | BigUint64Array)[] }
{
    const keep: (Uint8Array | BigUint64Array)[] = [];
    const pointers = new BigUint64Array(items.length);
    keep.push(pointers);

    for (let index = 0; index < items.length; index++)
    {
        const bytes = new TextEncoder().encode(items[index] + "\0");
        keep.push(bytes);
        const address = pointerOf(bytes);
        pointers[index] = address === null ? 0n : address;
    }

    return { ptr: pointerOf(pointers), keep };
}

/** wxRadioBox with wxRA_SPECIFY_COLS, taking its choices from a JS array. */
function makeRadioBox(
    parent: Pointer,
    caption: string,
    items: string[],
    dimension: number,
): wxRadioBox
{
    const built = charPtrArray(items);
    const box = withString(caption, (ptr) =>
        createWxRadioBox(
            parent, ID_ANY, ptr, -1, -1, -1, -1,
            items.length, built.ptr, dimension, RA_SPECIFY_COLS,
        ));
    void built.keep;
    return box!;
}

function isChecked(box: wxCheckBox | null): boolean
{
    return box ? box.GetValue() : false;
}

function hasSortStyle(combo: wxBitmapComboBox): boolean
{
    return (combo.GetWindowStyle() & BigInt(CB_SORT)) !== 0n;
}

/** wxTextCtrl::GetValue() as a JS string. */
function readText(control: wxTextCtrl | null): string
{
    const value = control ? control.GetValue() : null;
    return value ? readAndDeleteWxString(value.ptr) : "";
}

/** wxTextCtrl::SetValue(). */
function writeText(control: wxTextCtrl | null, text: string): void
{
    if (!control)
    {
        return;
    }
    withString(text, (ptr) => control.SetValue(ptr));
}

/** wxString::ToLong(): null when the text is not an integer. */
function parseLong(text: string): number | null
{
    const trimmed = text.trim();
    if (!/^[+-]?\d+$/.test(trimmed))
    {
        return null;
    }
    const value = Number(trimmed);
    return Number.isSafeInteger(value) ? value : null;
}

/** wxString::ToULong(): null when the text is not an unsigned integer. */
function parseUnsigned(text: string): number | null
{
    const trimmed = text.trim();
    if (!/^\d+$/.test(trimmed))
    {
        return null;
    }
    const value = Number(trimmed);
    return Number.isSafeInteger(value) ? value : null;
}

/** wxFileName(filepath).GetName(): base name without the extension. */
function fileNameFromPath(filepath: string): string
{
    const normalized = filepath.replace(/\\/g, "/");
    const base = normalized.slice(normalized.lastIndexOf("/") + 1);
    const dot = base.lastIndexOf(".");
    return dot > 0 ? base.slice(0, dot) : base;
}

/** wxBitmapComboBox sample page. */
export class BitmapComboBoxPage extends WidgetsPage
{
    private radioKind: wxRadioBox | null = null;
    private chkSort: wxCheckBox | null = null;
    private chkProcessEnter: wxCheckBox | null = null;
    private chkReadonly: wxCheckBox | null = null;

    private combo: wxBitmapComboBox | null = null;
    private sizerCombo: wxSizer | null = null;

    private textInsert: wxTextCtrl | null = null;
    private textChangeHeight: wxTextCtrl | null = null;
    private textChange: wxTextCtrl | null = null;
    private textDelete: wxTextCtrl | null = null;

    constructor(parent: Pointer)
    {
        super(parent, "icons/bmpcombobox");
    }

    override getWidget(): wxWindow | null
    {
        return this.combo;
    }

    override createContent(): void
    {
        const sizerTop = createWxBoxSizer(HORIZONTAL)!;
        const sizerLeft = createWxBoxSizer(VERTICAL)!;

        // -- left pane: style --------------------------------------------------
        const style = makeStaticBoxSizer(this.page.ptr, VERTICAL, "&Set style");

        this.radioKind = makeRadioBox(
            this.page.ptr, "Combobox &kind:", COMBO_KINDS, 1);

        this.chkSort = this.createCheckBoxAndAddToSizer(
            style.sizer, "&Sort items", ID_ANY, style.box.ptr);
        this.chkProcessEnter = this.createCheckBoxAndAddToSizer(
            style.sizer, "Process &Enter", ID_ANY, style.box.ptr);
        this.chkReadonly = this.createCheckBoxAndAddToSizer(
            style.sizer, "&Read only", ID_ANY, style.box.ptr);

        const resetButton = withString("&Reset", (ptr) =>
            createWxButton(style.box.ptr, BMPCOMBO_RESET, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(style.sizer, resetButton, 0,
            ALIGN_CENTRE_HORIZONTAL | ALL, this.dip(3));

        addSizer(sizerLeft, style.sizer, 0, EXPAND);
        addWin(sizerLeft, this.radioKind, 0, EXPAND, border());

        // -- left pane: other options -----------------------------------------
        const options = makeStaticBoxSizer(
            this.page.ptr, VERTICAL, "Demo options");

        const heightRow = this.createSizerWithSmallTextAndLabel(
            "Control &height:", BMPCOMBO_CHANGE_HEIGHT, options);
        this.textChangeHeight = heightRow.text;
        heightRow.text.SetSize(-1, -1, this.dip(20), -1, 0);

        const heightFlags = createWxSizerFlags(0)!;
        heightFlags.FixedMinSize();
        heightFlags.Border(ALL);
        options.sizer.AddSizerFlags(heightRow.sizer.ptr, heightFlags.ptr);
        heightFlags.Delete();

        addSizer(sizerLeft, options.sizer, 0, EXPAND | TOP, this.dip(2));

        // -- middle pane: combobox contents -----------------------------------
        const middle = makeStaticBoxSizer(this.page.ptr, VERTICAL,
            "&Change wxBitmapComboBox contents");

        const containerTestsButton = withString("Run &tests", (ptr) =>
            createWxButton(middle.box.ptr, BMPCOMBO_CONTAINER_TESTS, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(middle.sizer, containerTestsButton, 0, EXPAND, border());

        const addIconsButton = withString("Add &widget icons", (ptr) =>
            createWxButton(middle.box.ptr, BMPCOMBO_ADD_WIDGET_ICONS, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(middle.sizer, addIconsButton, 0, EXPAND, border());

        const loadButton = withString("Insert image from &file", (ptr) =>
            createWxButton(middle.box.ptr, BMPCOMBO_LOAD_FROM_FILE, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(middle.sizer, loadButton, 0, EXPAND, border());

        const setFromFileButton = withString("&Set image from file", (ptr) =>
            createWxButton(middle.box.ptr, BMPCOMBO_SET_FROM_FILE, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(middle.sizer, setFromFileButton, 0, EXPAND, border());

        const addSeveralWithImagesButton = withString(
            "A&ppend a few strings with images", (ptr) =>
            createWxButton(middle.box.ptr, BMPCOMBO_ADD_SEVERAL_WITH_IMAGES, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(middle.sizer, addSeveralWithImagesButton, 0, EXPAND, border());

        const addSeveralButton = withString("Append a &few strings", (ptr) =>
            createWxButton(middle.box.ptr, BMPCOMBO_ADD_SEVERAL, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(middle.sizer, addSeveralButton, 0, EXPAND, border());

        const addManyButton = withString("Append &many strings", (ptr) =>
            createWxButton(middle.box.ptr, BMPCOMBO_ADD_MANY, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(middle.sizer, addManyButton, 0, EXPAND, border());

        const deleteHolder: { text: wxTextCtrl | null } = { text: null };
        const deleteRow = this.createSizerWithTextAndButton(
            BMPCOMBO_DELETE, "&Delete this item", BMPCOMBO_DELETE_TEXT,
            (text) => { deleteHolder.text = text; }, middle.box.ptr);
        this.textDelete = deleteHolder.text;
        addSizer(middle.sizer, deleteRow, 0, EXPAND, border());

        const deleteSelectionButton = withString("Delete &selection", (ptr) =>
            createWxButton(middle.box.ptr, BMPCOMBO_DELETE_SEL, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(middle.sizer, deleteSelectionButton, 0, EXPAND, border());

        const clearButton = withString("&Clear", (ptr) =>
            createWxButton(middle.box.ptr, BMPCOMBO_CLEAR, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(middle.sizer, clearButton, 0, EXPAND, border());

        wxInitAllImageHandlers();

        // -- right pane: the combobox -----------------------------------------
        const sizerRight = createWxBoxSizer(VERTICAL)!;
        this.combo = withString("", (ptr) =>
            createWxBitmapComboBox(
                this.page.ptr, BMPCOMBO_COMBO, ptr, -1, -1, -1, -1,
                0, null, TE_PROCESS_ENTER))!;
        addWin(sizerRight, this.combo, 0, EXPAND, border());

        sizerRight.SetMinSize(this.dip(150), 0);
        this.sizerCombo = sizerRight;

        // -- compose ----------------------------------------------------------
        addSizer(sizerTop, sizerLeft, 0, EXPAND | (ALL & ~LEFT), doubleBorder());
        addSizer(sizerTop, middle.sizer, 5, EXPAND, doubleBorder());
        addSizer(sizerTop, sizerRight, 4, EXPAND | (ALL & ~RIGHT), doubleBorder());

        this.reset();
        this.page.SetSizer(sizerTop.ptr, false);

        // -- event handlers ---------------------------------------------------
        this.bindButton(BMPCOMBO_RESET, () =>
        {
            this.reset();
            this.createCombo();
        });
        this.bindButton(BMPCOMBO_CHANGE, () => this.onButtonChange());
        this.bindButton(BMPCOMBO_DELETE, () => this.onButtonDelete());
        this.bindButton(BMPCOMBO_DELETE_SEL, () => this.onButtonDeleteSelection());
        this.bindButton(BMPCOMBO_CLEAR, () => this.combo?.Clear());
        this.bindButton(BMPCOMBO_INSERT, () => this.onButtonInsert());
        this.bindButton(BMPCOMBO_ADD_SEVERAL, () => this.onButtonAddSeveral());
        this.bindButton(BMPCOMBO_ADD_SEVERAL_WITH_IMAGES, () =>
            this.onButtonAddSeveralWithImages());
        this.bindButton(BMPCOMBO_ADD_WIDGET_ICONS, () => this.onButtonAddWidgetIcons());
        this.bindButton(BMPCOMBO_ADD_MANY, () => this.onButtonAddMany());
        this.bindButton(BMPCOMBO_LOAD_FROM_FILE, () => this.onButtonLoadFromFile());
        this.bindButton(BMPCOMBO_SET_FROM_FILE, () => this.onButtonSetFromFile());
        this.bindButton(BMPCOMBO_CONTAINER_TESTS, () => this.onButtonContainerTests());

        this.bindTextEnter(BMPCOMBO_INSERT_TEXT, () => this.onButtonInsert());
        this.bindTextEnter(BMPCOMBO_DELETE_TEXT, () => this.onButtonDelete());
        bindEvent(this.page, BMPCOMBO_CHANGE_HEIGHT, BMPCOMBO_CHANGE_HEIGHT,
            EVT_TEXT, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onTextChangeHeight();
            });

        this.bindUpdateUI(BMPCOMBO_RESET,
            (event) => this.updateResetButton(event));
        this.bindUpdateUI(BMPCOMBO_INSERT,
            (event) => this.updateInsertButton(event));
        this.bindUpdateUI(BMPCOMBO_LOAD_FROM_FILE,
            (event) => this.updateInsertButton(event));
        this.bindUpdateUI(BMPCOMBO_CLEAR,
            (event) => this.updateClearButton(event));
        this.bindUpdateUI(BMPCOMBO_DELETE_TEXT,
            (event) => this.updateClearButton(event));
        this.bindUpdateUI(BMPCOMBO_DELETE,
            (event) => this.updateDeleteButton(event));
        this.bindUpdateUI(BMPCOMBO_CHANGE,
            (event) => this.updateItemManipulator(event));
        this.bindUpdateUI(BMPCOMBO_SET_FROM_FILE,
            (event) => this.updateItemManipulator(event));
        this.bindUpdateUI(BMPCOMBO_DELETE_SEL,
            (event) => this.updateItemManipulator(event));

        bindEvent(this.page, BMPCOMBO_COMBO, BMPCOMBO_COMBO,
            EVT_COMBOBOX_DROPDOWN, (eventPtr) =>
            {
                if (!eventPtr) return;
                logMessage("Combobox dropped down");
            });
        bindEvent(this.page, BMPCOMBO_COMBO, BMPCOMBO_COMBO,
            EVT_COMBOBOX_CLOSEUP, (eventPtr) =>
            {
                if (!eventPtr) return;
                logMessage("Combobox closed up");
            });
        bindEvent(this.page, BMPCOMBO_COMBO, BMPCOMBO_COMBO,
            EVT_COMBOBOX, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onComboSelected(eventPtr);
            });
        bindEvent(this.page, BMPCOMBO_COMBO, BMPCOMBO_COMBO,
            EVT_TEXT, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onComboText(eventPtr);
            });
        bindEvent(this.page, BMPCOMBO_COMBO, BMPCOMBO_COMBO,
            EVT_TEXT_ENTER, (eventPtr) =>
            {
                if (!eventPtr) return;
                this.onComboText(eventPtr);
            });

        bindEvent(this.page, ID_ANY, ID_ANY, EVT_CHECKBOX, (eventPtr) =>
        {
            if (!eventPtr) return;
            this.createCombo();
        });
        bindEvent(this.page, ID_ANY, ID_ANY, EVT_RADIOBOX, (eventPtr) =>
        {
            if (!eventPtr) return;
            this.createCombo();
        });
    }

    override recreateWidget(): void
    {
        this.createCombo();
    }

    // -- helpers --------------------------------------------------------------

    private bindButton(id: number, handler: () => void): void
    {
        bindEvent(this.page, id, id, EVT_BUTTON, (eventPtr) =>
        {
            if (!eventPtr) return;
            handler();
        });
    }

    private bindTextEnter(id: number, handler: () => void): void
    {
        bindEvent(this.page, id, id, EVT_TEXT_ENTER, (eventPtr) =>
        {
            if (!eventPtr) return;
            handler();
        });
    }

    private bindUpdateUI(
        id: number,
        handler: (event: wxUpdateUIEvent) => void,
    ): void
    {
        bindEvent(this.page, id, id, EVT_UPDATE_UI, (eventPtr) =>
        {
            if (!eventPtr) return;
            handler(new wxUpdateUIEvent(eventPtr, true));
        });
    }

    /** CreateSizerWithSmallTextAndLabel() */
    private createSizerWithSmallTextAndLabel(
        label: string,
        id: number,
        parent: StaticBoxSizerParts,
    ): { sizer: wxSizer; text: wxTextCtrl }
    {
        const staticText = withString(label, (ptr) =>
            createWxStaticText(
                parent.box.ptr, ID_ANY, ptr, -1, -1, -1, -1, 0))!;
        const sizer = createWxBoxSizer(HORIZONTAL)!;
        const text = withString("", (ptr) =>
            createWxTextCtrl(
                parent.box.ptr, id, ptr, -1, -1, this.dip(50), -1,
                BigInt(TE_PROCESS_ENTER)))!;

        addWin(sizer, staticText, 0, ALIGN_CENTRE_VERTICAL | RIGHT, border());

        const flags = createWxSizerFlags(1)!;
        flags.FixedMinSize();
        flags.CenterVertical();
        flags.Border(LEFT);
        sizer.AddWindowFlags(text.ptr, flags.ptr);
        flags.Delete();

        return { sizer, text };
    }

    // -- operations -----------------------------------------------------------

    /** BitmapComboBoxWidgetsPage::Reset() */
    private reset(): void
    {
        this.chkSort?.SetValue(false);
        this.chkProcessEnter?.SetValue(true);
        this.chkReadonly?.SetValue(false);
    }

    /** BitmapComboBoxWidgetsPage::CreateCombo() */
    private createCombo(): void
    {
        const sizer = this.sizerCombo;
        if (!sizer)
        {
            return;
        }

        let flags = attrs.defaultFlags;

        if (isChecked(this.chkSort))
        {
            flags |= CB_SORT;
        }
        if (isChecked(this.chkProcessEnter))
        {
            flags |= TE_PROCESS_ENTER;
        }
        if (isChecked(this.chkReadonly))
        {
            flags |= CB_READONLY;
        }

        switch (this.radioKind ? this.radioKind.GetSelection() : 0)
        {
            case COMBO_KIND_SIMPLE:
                flags |= CB_SIMPLE;
                break;

            case COMBO_KIND_DROP_DOWN:
                // The C++ sample assigns instead of OR-ing here.
                flags = CB_DROPDOWN;
                break;

            default:
                break;
        }

        const items: Array<{ text: string; bitmap: wxBitmap | null }> = [];
        const oldCombo = this.combo;
        if (oldCombo)
        {
            const count = oldCombo.GetCount();
            for (let index = 0; index < count; index++)
            {
                const value = oldCombo.GetString(index);
                items.push({
                    text: value ? readAndDeleteWxString(value.ptr) : "",
                    bitmap: oldCombo.GetItemBitmap(index),
                });
            }

            sizer.DetachWindow(oldCombo.ptr);
            // wxWindow::Destroy(), as the C++ sample deletes the old control.
            oldCombo.Destroy();
        }

        const newCombo = withString("", (ptr) =>
            createWxBitmapComboBox(
                this.page.ptr, BMPCOMBO_COMBO, ptr, -1, -1, -1, -1,
                0, null, flags))!;
        this.combo = newCombo;

        this.notifyWidgetRecreation(newCombo);

        for (const item of items)
        {
            const bitmap = item.bitmap;
            withString(item.text, (ptr) =>
            {
                newCombo.AppendWithBitmap(ptr,
                    bitmap ? bitmap.ptr : Null_Bitmap());
            });
        }

        addWin(sizer, newCombo, 0, EXPAND, border());
        sizer.Layout();

        // Allow changing height in order to demonstrate the flexible size of
        // the image "thumbnail" painted in the control itself.
        const height = parseLong(readText(this.textChangeHeight));
        if (height !== null && height >= 5)
        {
            newCombo.SetSize(-1, -1, -1, height, 0);
        }
    }

    private onButtonChange(): void
    {
        const combo = this.combo;
        if (!combo)
        {
            return;
        }
        const selected = combo.GetSelection();
        if (selected !== NOT_FOUND)
        {
            const value = readText(this.textChange);
            withString(value, (ptr) =>
            {
                combo.SetString(selected, ptr);
            });
        }
    }

    private onButtonDelete(): void
    {
        const index = parseUnsigned(readText(this.textDelete));
        const combo = this.combo;
        if (index === null || !combo || index >= combo.GetCount())
        {
            return;
        }
        combo.DeleteItem(index);
    }

    private onButtonDeleteSelection(): void
    {
        const combo = this.combo;
        if (!combo)
        {
            return;
        }
        const selected = combo.GetSelection();
        if (selected !== NOT_FOUND)
        {
            combo.DeleteItem(selected);
        }
    }

    private onButtonInsert(): void
    {
        const combo = this.combo;
        const textControl = this.textInsert;
        if (!combo)
        {
            return;
        }

        const value = readText(textControl);
        if (textControl && !textControl.IsModified())
        {
            insertCounter += 1;
            writeText(textControl, `test item ${insertCounter}`);
        }

        withString(value, (ptr) =>
        {
            combo.InsertWithBitmap(ptr, Null_Bitmap(), combo.GetSelection());
        });
    }

    private onTextChangeHeight(): void
    {
        const combo = this.combo;
        const height = parseLong(readText(this.textChangeHeight));
        if (!combo || height === null || height < 5)
        {
            return;
        }
        combo.SetSize(-1, -1, -1, height, 0);
    }

    private onButtonAddMany(): void
    {
        const combo = this.combo;
        if (!combo)
        {
            return;
        }

        // "many" means 1000 here
        for (let index = 0; index < 1000; index++)
        {
            withString(`item #${index}`, (ptr) => combo.Append(ptr));
        }
    }

    private onButtonAddSeveral(): void
    {
        const combo = this.combo;
        if (!combo)
        {
            return;
        }

        const items = [
            "First",
            "another one",
            "and the last (very very very very very very very very very very long) one",
        ];
        for (const item of items)
        {
            withString(item, (ptr) => combo.Append(ptr));
        }
    }

    private onButtonAddSeveralWithImages(): void
    {
        const combo = this.combo;
        if (!combo)
        {
            return;
        }

        const entries = [
            { text: "Red circle", rgb: 0x0000ff },
            { text: "Blue circle", rgb: 0xff0000 },
            { text: "Green circle", rgb: 0x00ff00 },
            { text: "Black circle", rgb: 0x000000 },
        ];

        for (const entry of entries)
        {
            const colour = createWxColourFromInt(entry.rgb);
            if (!colour)
            {
                continue;
            }
            const bitmap = this.createBitmap(colour);
            colour.Delete();
            if (!bitmap)
            {
                continue;
            }

            withString(entry.text, (ptr) =>
            {
                combo.AppendWithBitmap(ptr, bitmap.ptr);
            });
            bitmap.Delete();
        }
    }

    private onButtonLoadFromFile(): void
    {
        const combo = this.combo;
        if (!combo)
        {
            return;
        }

        let selected = combo.GetSelection();
        if (selected === NOT_FOUND)
        {
            selected = combo.GetCount();
        }

        const queried = this.queryBitmap();
        const bitmap = queried.bitmap;
        if (bitmap && bitmap.IsOk())
        {
            const position = selected;
            withString(queried.name, (ptr) =>
            {
                combo.InsertWithBitmap(ptr, bitmap.ptr, position);
            });
        }
    }

    private onButtonSetFromFile(): void
    {
        const combo = this.combo;
        if (!combo)
        {
            return;
        }

        const queried = this.queryBitmap();
        if (queried.bitmap && queried.bitmap.IsOk())
        {
            combo.SetItemBitmap(combo.GetSelection(), queried.bitmap.ptr);
        }
    }

    private onButtonAddWidgetIcons(): void
    {
        const combo = this.combo;
        if (!combo)
        {
            return;
        }

        let width = 32;
        let height = 32;
        const bitmapSize = combo.GetBitmapSize();
        if (bitmapSize)
        {
            width = bitmapSize.GetWidth();
            height = bitmapSize.GetHeight();
        }
        if (width <= 0)
        {
            width = 32;
            height = 32;
        }

        for (const name of WIDGET_ICON_NAMES)
        {
            const path = samplePath("icons/" + name + ".svg");
            const bundlePtr = withString(path, (ptr) =>
                wxBitmapBundle_FromSVGFile(ptr, width, height));
            if (!bundlePtr)
            {
                continue;
            }

            const bundle = wrapWxBitmapBundle(bundlePtr);
            const bitmap = bundle.GetBitmap(width, height);
            bundle.Delete();

            if (!bitmap)
            {
                continue;
            }
            withString(name, (ptr) =>
            {
                combo.AppendWithBitmap(ptr, bitmap.ptr);
            });
            bitmap.Delete();
        }
    }

    private onButtonContainerTests(): void
    {
        const combo = this.combo;
        if (!combo)
        {
            return;
        }
        runItemContainerTest(new wxItemContainer(combo.ptr, true), combo);
    }

    // -- bitmaps ---------------------------------------------------------------

    /** wxBitmapComboBox::QueryBitmap() */
    private queryBitmap(): { name: string; bitmap: wxBitmap | null }
    {
        const filepathPtr = withStrings(["image", "", ""], (ptrs) =>
            wxLoadFileSelector(ptrs[0], ptrs[1], ptrs[2], this.page.ptr));
        const filepath = filepathPtr ? readAndDeleteWxString(filepathPtr) : "";

        if (filepath === "")
        {
            return { name: "", bitmap: null };
        }

        const name = fileNameFromPath(filepath);
        const bitmap = this.loadBitmap(filepath);
        if (bitmap && bitmap.IsOk())
        {
            // wxLogDebug("%i, %i", ...)
            logMessage(`${bitmap.GetWidth()}, ${bitmap.GetHeight()}`);
        }
        return { name, bitmap };
    }

    /** wxBitmapComboBox::LoadBitmap() */
    private loadBitmap(filepath: string): wxBitmap | null
    {
        let limitWidth = 0;
        let limitHeight = 0;
        const bitmapSize = this.combo ? this.combo.GetBitmapSize() : null;
        if (bitmapSize)
        {
            limitWidth = bitmapSize.GetWidth();
            limitHeight = bitmapSize.GetHeight();
        }
        if (limitWidth <= 0)
        {
            limitWidth = IMAGE_SIZE_TRUNC;
            limitHeight = IMAGE_SIZE_TRUNC;
        }

        const image = withString(filepath, (ptr) => createWxImageFromFile(ptr));
        if (!image)
        {
            return null;
        }
        if (!image.IsOk())
        {
            image.Delete();
            return null;
        }

        const originalWidth = image.GetWidth();
        const originalHeight = image.GetHeight();
        if (limitWidth > 0
            && (originalWidth !== limitWidth || originalHeight !== limitHeight))
        {
            const width = Math.min(originalWidth, limitWidth);
            const height = Math.min(originalHeight, limitHeight);
            this.rescaleImage(image, width, height);
        }

        const bitmap = createWxBitmapFromImage(image.ptr, -1);
        image.Delete();
        return bitmap;
    }

    /** wxBitmapComboBox::RescaleImage() */
    private rescaleImage(image: wxImage, width: number, height: number): void
    {
        if (image.GetWidth() === width && image.GetHeight() === height)
        {
            return;
        }
        if (width <= 0 || height <= 0)
        {
            return;
        }

        if (firstImageScale && this.combo && this.combo.GetCount() > 0)
        {
            withString("wxBitmapComboBox normally only supports images of one "
                + "size. However, for demonstration purposes, loaded bitmaps are "
                + "scaled to fit using wxImage::Rescale.", (message) =>
                withString("Notice", (caption) =>
                    kwxMessageBox(message, caption, OK, this.page.ptr, -1, -1)));
            firstImageScale = false;
        }

        image.Rescale(width, height);
    }

    /**
     * wxBitmapComboBox::CreateBitmap(): a 10x10 bitmap with a filled circle.
     * wxMemoryDC drawing is not used; the pixels are set through wxImage and
     * the magic-colour background becomes the mask.
     */
    private createBitmap(colour: wxColour): wxBitmap | null
    {
        const width = 10;
        const height = 10;

        const image = createWxImageSized(width, height);
        if (!image)
        {
            return null;
        }

        image.SetRGBRect(0, 0, width, height, 255, 0, 255);

        const centerX = height / 2;
        const centerY = height / 2 + 1;
        const radius = height / 2;
        for (let y = 0; y < height; y++)
        {
            for (let x = 0; x < width; x++)
            {
                const deltaX = x - centerX;
                const deltaY = y - centerY;
                if (deltaX * deltaX + deltaY * deltaY <= radius * radius)
                {
                    image.SetRGB(x, y, colour.Red(), colour.Green(), colour.Blue());
                }
            }
        }

        image.SetMaskColour(255, 0, 255);
        const bitmap = createWxBitmapFromImage(image.ptr, -1);
        image.Delete();
        return bitmap;
    }

    // -- event handlers -------------------------------------------------------

    private onComboSelected(eventPtr: Pointer): void
    {
        const combo = this.combo;
        if (!combo)
        {
            return;
        }

        const event = new wxCommandEvent(eventPtr, true);
        const selection = event.GetInt();

        writeText(this.textDelete, String(selection));
        logMessage(`BitmapCombobox item ${selection} selected`);

        const comboValue = combo.GetValue();
        const currentText = comboValue
            ? readAndDeleteWxString(comboValue.ptr)
            : "";
        logMessage(`BitmapCombobox GetValue(): ${currentText}`);
    }

    private onComboText(eventPtr: Pointer): void
    {
        if (!this.combo)
        {
            return;
        }

        const event = new wxCommandEvent(eventPtr, true);
        const value = event.GetString();
        const text = value ? readAndDeleteWxString(value.ptr) : "";

        if (event.GetEventType() === EVT_TEXT_ENTER)
        {
            logMessage(`BitmapCombobox enter pressed (now '${text}')`);
        }
        else
        {
            logMessage(`BitmapCombobox text changed (now '${text}')`);
        }
    }

    // -- update UI handlers ---------------------------------------------------

    private updateResetButton(event: wxUpdateUIEvent): void
    {
        event.Enable(
            isChecked(this.chkSort)
            || !isChecked(this.chkProcessEnter)
            || isChecked(this.chkReadonly));
    }

    private updateInsertButton(event: wxUpdateUIEvent): void
    {
        const combo = this.combo;
        if (!combo)
        {
            return;
        }
        event.Enable(!hasSortStyle(combo));
    }

    private updateDeleteButton(event: wxUpdateUIEvent): void
    {
        const combo = this.combo;
        if (!combo)
        {
            return;
        }
        const index = parseUnsigned(readText(this.textDelete));
        event.Enable(index !== null && index < combo.GetCount());
    }

    private updateItemManipulator(event: wxUpdateUIEvent): void
    {
        const combo = this.combo;
        if (!combo)
        {
            return;
        }
        event.Enable(combo.GetSelection() !== NOT_FOUND);
    }

    private updateClearButton(event: wxUpdateUIEvent): void
    {
        const combo = this.combo;
        if (!combo)
        {
            return;
        }
        event.Enable(combo.GetCount() !== 0);
    }
}

/** Creates the wxBitmapComboBox sample page. */
export function createBitmapComboBoxPage(parent: Pointer): WidgetsPage
{
    return new BitmapComboBoxPage(parent);
}
