    dialog.Centre(CENTRE_ON_SCREEN);

    if (dialog.ShowModal() === ID_OK)
    {
        const pathBuffer = new BigUint64Array(MAX_SELECTED_PATHS);
        const nameBuffer = new BigUint64Array(MAX_SELECTED_PATHS);
        const count = dialog.GetPaths(pointerOf(pathBuffer), MAX_SELECTED_PATHS);
        dialog.GetFilenames(pointerOf(nameBuffer), MAX_SELECTED_PATHS);
        const paths = readStringArray(count, pathBuffer);
        const names = readStringArray(count, nameBuffer);

        let message = "";
        for (let n = 0; n < count; n++)
        {
            message += `File ${n}: ${paths[n]} (${names[n]})\n`;
        }
        message += `Filter index: ${dialog.GetFilterIndex()}`;

        withStrings([message, "Selected files"], (ptrs) =>
        {
            const second = createWxMessageDialog(
                current.frame.ptr, ptrs[0], ptrs[1], OK | CENTRE);
            if (!second) return;
            second.ShowModal();
            second.Destroy();
        });
    }
    dialog.Destroy();
}

