// support.kwxts — shared helpers for the wxWidgets "layout" sample port.
//
// Centralises the string lifetime helpers, the wxSizerFlags wrappers, the menu
// append helpers, the SVG icon loader and the closure bookkeeping that all the
// frames and the dialog in this sample need.

declare const __dirname: string;

import { Callback, Pointer } from "kwx/platform";
import {
    ID_ANY,
    createWxClosure,
    createWxGenericStaticText,
    createWxIconDefault,
    createWxMenu,
    createWxSizerFlags,
    createWxStaticText,
    createWxString,
    wxBitmapBundle,
    wxBitmapBundle_FromSVGFile,
    wxClosure,
    wxEvtHandler,
    wxFrame,
    wxGenericStaticText,
    wxMenu,
    wxSizer,
    wxSizerFlags,
    wxStaticText,
} from "kwx";

/** Runs `fn` with a temporary wxString holding `text`, then frees it. */
export function withString<T>(text: string, fn: (ptr: Pointer) => T): T
{
    const value = createWxString(text);
    try
    {
        return fn(value.ptr);
    }
    finally
    {
        value.Delete();
    }
}

/** Absolute path of an asset shipped next to this module. */
export function assetPath(name: string): string
{
    return __dirname.replace(/\\/g, "/") + "/" + name;
}

// ---------------------------------------------------------------------------
// wxSizerFlags helpers — the binding mutates a native wxSizerFlags and copies
// it into the sizer item, so the temporary must be deleted after Add*Flags().
// ---------------------------------------------------------------------------

/** sizer->Add(window, wxSizerFlags(proportion).<setup>()) */
export function addWindowWithFlags(
    sizer: wxSizer,
    window: Pointer,
    proportion: number,
    setup: (flags: wxSizerFlags) => void,
): void
{
    const flags = createWxSizerFlags(proportion);
    if (!flags)
    {
        sizer.AddWindow(window, proportion, 0, 0, null);
        return;
    }
    setup(flags);
    sizer.AddWindowFlags(window, flags.ptr);
    flags.Delete();
}

/** sizer->Add(child, wxSizerFlags(proportion).<setup>()) */
export function addSizerWithFlags(
    sizer: wxSizer,
    child: Pointer,
    proportion: number,
    setup: (flags: wxSizerFlags) => void,
): void
{
    const flags = createWxSizerFlags(proportion);
    if (!flags)
    {
        sizer.AddSizer(child, proportion, 0, 0, null);
        return;
    }
    setup(flags);
    sizer.AddSizerFlags(child, flags.ptr);
    flags.Delete();
}

// ---------------------------------------------------------------------------
// Widget construction helpers (wxID_ANY + default position/size/style)
// ---------------------------------------------------------------------------

/** wxStaticText(parent, wxID_ANY, text) */
export function makeStaticText(parent: Pointer, text: string): wxStaticText | null
{
    let result: wxStaticText | null = null;
    withString(text, (ptr) =>
    {
        result = createWxStaticText(parent, ID_ANY, ptr, -1, -1, -1, -1, 0);
    });
    return result;
}

/** wxGenericStaticText(parent, wxID_ANY, text) */
export function makeGenericStaticText(
    parent: Pointer,
    text: string,
): wxGenericStaticText | null
{
    let result: wxGenericStaticText | null = null;
    withString(text, (ptr) =>
    {
        result = createWxGenericStaticText(parent, ID_ANY, ptr, -1, -1, -1, -1, 0);
    });
    return result;
}

// ---------------------------------------------------------------------------
// Menu helpers
// ---------------------------------------------------------------------------

/** wxMenu(style = 0) with an empty title. */
export function createPlainMenu(): wxMenu | null
{
    return withString("", (ptr) => createWxMenu(ptr, 0n));
}

/** menu->Append(id, label) */
export function appendMenuItem(menu: wxMenu, id: number, label: string): void
{
    withString(label, (ptr) => { menu.Append(id, ptr, null, false); });
}

/** menu->Append(id, label, help) */
export function appendMenuItemWithHelp(
    menu: wxMenu,
    id: number,
    label: string,
    help: string,
): void
{
    withString(label, (labelPtr) =>
        withString(help, (helpPtr) => { menu.Append(id, labelPtr, helpPtr, false); }));
}

// ---------------------------------------------------------------------------
// Artwork: ../sample.xpm converted pixel for pixel to sample.svg
// ---------------------------------------------------------------------------

/** wxBitmapBundle::FromSVGFile(name, width, height) — result is owned. */
export function loadSvgBundle(
    name: string,
    width: number,
    height: number,
): wxBitmapBundle | null
{
    let raw: Pointer = null;
    withString(assetPath(name), (path) =>
    {
        raw = wxBitmapBundle_FromSVGFile(path, width, height);
    });
    if (!raw)
    {
        return null;
    }
    return new wxBitmapBundle(raw);
}

/** SetIcon(wxICON(sample)) from ../sample.xpm converted to sample.svg. */
export function setFrameIcon(frame: wxFrame): void
{
    const bundle = loadSvgBundle("sample.svg", 32, 32);
    if (!bundle)
    {
        return;
    }

    const bitmap = bundle.GetBitmap(32, 32);
    if (bitmap)
    {
        const icon = createWxIconDefault();
        if (icon)
        {
            icon.CopyFromBitmap(bitmap.ptr);
            frame.SetIcon(icon.ptr);
            icon.Delete();
        }
        bitmap.Delete();
    }
    bundle.Delete();
}

// ---------------------------------------------------------------------------
// Event plumbing: one Callback + one wxClosure per C++ Bind()/event-table entry
// ---------------------------------------------------------------------------

export interface EventResources
{
    callbacks: Callback[];
    closures: wxClosure[];
}

export function createEventResources(): EventResources
{
    return { callbacks: [], closures: [] };
}

export type EventHandler = (eventPtr: Pointer) => void;

/** Bind(first, last, eventType, closure) on `target`, keeping both alive. */
export function bindEvent(
    resources: EventResources,
    target: wxEvtHandler,
    first: number,
    last: number,
    eventType: number,
    handler: EventHandler,
): void
{
    const callback = new Callback(
        { parameters: ["pointer", "pointer", "pointer"], result: "void" },
        (_closureFun, _data, eventPtr) =>
        {
            // wxClosure runs every handler once with a null event while the
            // frame is being torn down.
            if (!eventPtr)
            {
                return;
            }
            handler(eventPtr);
        },
    );

    const closure = createWxClosure(callback.pointer, null);
    if (!closure)
    {
        callback.close();
        throw new Error("layout: createWxClosure failed");
    }

    target.Bind(first, last, eventType, closure.ptr);
    resources.callbacks.push(callback);
    resources.closures.push(closure);
}

/** Releases every native callback slot; call only after run() has returned. */
export function closeEventResources(resources: EventResources): void
{
    for (const callback of resources.callbacks)
    {
        callback.close();
    }
    resources.callbacks.length = 0;
}
