// support.kwxts — shared helpers for the "dialogs" sample port.
//
// Contains:
//   * the menu id enumeration from dialogs.h,
//   * wxString / buffer helpers (the kwxFFI calling conventions),
//   * a single event-router class used to keep the number of native callbacks
//     well below the 64-slot limit,
//   * sizer helpers that mirror the wxSizerFlags combinations used by the
//     C++ sample.

import {
    createWxArrayString,
    createWxClosure,
    createWxColourEmpty,
    createWxSizerFlags,
    createWxString,
    ID_HIGHEST,
    lib,
    readAndDeleteWxString,
    readWxString,
    wxClosure,
    wxColour,
    wxControl,
    wxGetStockLabel,
    wxSizer,
    wxSizerFlags,
    wxString,
    wxWindow,
    wxArrayString,
    wrapWxColour,
    wrapWxWindow,
} from "kwx";
import { Callback, Pointer, pointerOf, readCString } from "kwx/platform";

