// textctrl.kwxts — port of wxSamples/src/widgets/textctrl.cpp
//
// Known binding gap (kept visible instead of being shimmed):
//  * The MSW-only "Control kind" radio box (wxTE_RICH / wxTE_RICH2) is omitted.
//  * WidgetsTextCtrl (a wxTextCtrl subclass) cannot be reproduced; the
//    Alt-click HitTest() report is bound directly on the created control.
//
// wxControl::Ellipsize(), wxPathList, wxStreamToTextRedirector and
// PositionToXY() are used as in the C++ sample.

import {
    ALIGN_CENTRE_HORIZONTAL,
    ALIGN_CENTRE_VERTICAL,
    ALL,
    BOTTOM,
    createWxBoxSizer,
    createWxButton,
    createWxClientDC,
    createWxPathList,
    createWxRadioBox,
    createWxStaticText,
    createWxStopWatch,
    createWxStreamToTextRedirector,
    createWxTextCtrl,
    EVT_BUTTON,
    EVT_CHECKBOX,
    EVT_IDLE,
    EVT_LEFT_DOWN,
    EVT_RADIOBOX,
    EVT_TEXT,
    EVT_TEXT_ENTER,
    EVT_TEXT_PASTE,
    ELLIPSIZE_MIDDLE,
    EVT_UPDATE_UI,
    EXPAND,
    HORIZONTAL,
    ID_ANY,
    ID_HIGHEST,
    LEFT,
    RA_SPECIFY_COLS,
    readAndDeleteWxString,
    RIGHT,
    TE_BESTWRAP,
    TE_CENTRE,
    TE_CHARWRAP,
    TE_DONTWRAP,
    TE_HT_BEFORE,
    TE_HT_BELOW,
    TE_HT_BEYOND,
    TE_HT_ON_TEXT,
    TE_LEFT,
    TE_MULTILINE,
    TE_NO_VSCROLL,
    TE_PASSWORD,
    TE_PROCESS_ENTER,
    TE_PROCESS_TAB,
    TE_READONLY,
    TE_RIGHT,
    TE_WORDWRAP,
    TEXT_TYPE_ANY,
    TOP,
    VERTICAL,
    wxCheckBox,
    wxCommandEvent,
    wxControl_Ellipsize,
    wxEvent,
    wxMouseEvent,
    wxRadioBox,
    wxSizer,
    wxTextCtrl,
    wxTextEntry,
    wxUpdateUIEvent,
    wxWindow,
} from "kwx";
import { platform, Pointer, pointerOf } from "kwx/platform";

import {
    addSizer,
    addSpacer,
    addWin,
    attrs,
    bindEvent,
    border,
    doubleBorder,
    isUsingLogWindow,
    logError,
    logMessage,
    makeStaticBoxSizer,
    StaticBoxSizerParts,
    tripleBorder,
    WidgetsPage,
    withString,
} from "./common.kwxts";

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

/** Control ids from textctrl.cpp. */
const TEXT_PAGE_RESET = ID_HIGHEST;
const TEXT_PAGE_SET = TEXT_PAGE_RESET + 1;
const TEXT_PAGE_ADD = TEXT_PAGE_SET + 1;
const TEXT_PAGE_INSERT = TEXT_PAGE_ADD + 1;
const TEXT_PAGE_CLEAR = TEXT_PAGE_INSERT + 1;
const TEXT_PAGE_LOAD = TEXT_PAGE_CLEAR + 1;

const TEXT_PAGE_STREAM_REDIRECTOR = TEXT_PAGE_LOAD + 1;

const TEXT_PAGE_PASSWORD = TEXT_PAGE_STREAM_REDIRECTOR + 1;
const TEXT_PAGE_NO_VERT_SCROLLBAR = TEXT_PAGE_PASSWORD + 1;
const TEXT_PAGE_WRAP_LINES = TEXT_PAGE_NO_VERT_SCROLLBAR + 1;
const TEXT_PAGE_TEXTCTRL = TEXT_PAGE_WRAP_LINES + 1;

/** enum TextLines */
const TEXT_LINES_SINGLE = 0;
const TEXT_LINES_MULTI = 1;

/** enum WrapStyle */
const WRAP_STYLE_NONE = 0;
const WRAP_STYLE_WORD = 1;
const WRAP_STYLE_CHAR = 2;
const WRAP_STYLE_BEST = 3;

/** enum AlignmentStyle */
const ALIGN_STYLE_LEFT = 0;
const ALIGN_STYLE_CENTRE = 1;
const ALIGN_STYLE_RIGHT = 2;

/** Default values for the controls (ControlValues DEFAULTS). */
interface ControlValues
{
    textLines: number;
    password: boolean;
    readOnly: boolean;
    processEnter: boolean;
    processTab: boolean;
    filename: boolean;
    noVertScrollbar: boolean;
    wrapStyle: number;
    alignmentStyle: number;
}

const DEFAULTS: ControlValues = {
    textLines: TEXT_LINES_MULTI,
    password: false,
    readOnly: false,
    processEnter: true,
    processTab: false,
    filename: false,
    noVertScrollbar: false,
    wrapStyle: WRAP_STYLE_WORD,
    alignmentStyle: ALIGN_STYLE_LEFT,
};

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

const textEncoder = new TextEncoder();

/**
 * Builds the `char**` array expected by wxRadioBox_Create.  The returned
 * buffers must stay reachable until the native call returns.
 */
function makeRadioBox(
    parent: Pointer,
    controlId: number,
    caption: string,
    items: string[],
    dimension: number,
    style: number,
): wxRadioBox
{
    const buffers: Uint8Array[] = [];
    const pointers = new BigUint64Array(items.length);

    for (let index = 0; index < items.length; index++)
    {
        const bytes = textEncoder.encode(items[index] + "\0");
        buffers.push(bytes);
        const address = pointerOf(bytes);
        pointers[index] = address === null ? 0n : address;
    }

    const choices = pointerOf(pointers);

    const radioBox = withString(caption, (ptr) =>
        createWxRadioBox(
            parent, controlId, ptr, -1, -1, -1, -1,
            items.length, choices, dimension, style,
        ));

    // Keep the string buffers alive until the constructor has copied them.
    void buffers;
    return radioBox!;
}

/** wxELLIPSIZE_FLAGS_DEFAULT from wx/gdicmn.h. */
const ELLIPSIZE_FLAGS_DEFAULT = 3;

/**
 * wxControl::Ellipsize(event.GetString(), wxClientDC(this),
 * wxELLIPSIZE_MIDDLE, GetTextExtent('W').x*100) for log messages.
 */
function ellipsizeMiddle(page: wxWindow, text: string): string
{
    const dc = createWxClientDC(page.ptr);
    if (!dc)
    {
        return text;
    }

    const width = new Int32Array(1);
    const height = new Int32Array(1);
    withString("W", (ptr) => page.GetTextExtent(
        ptr, pointerOf(width), pointerOf(height), null, null, null));

    const result = withString(text, (ptr) => wxControl_Ellipsize(
        ptr, dc.ptr, ELLIPSIZE_MIDDLE, width[0] * 100,
        ELLIPSIZE_FLAGS_DEFAULT));

    dc.Delete();
    return result ? readAndDeleteWxString(result) : text;
}

/** Width used by CreateInfoText(), computed once from "9999999". */
let infoTextWidth = 0;

// ---------------------------------------------------------------------------
// TextWidgetsPage
// ---------------------------------------------------------------------------

export class TextPage extends WidgetsPage
{
    private radioTextLines: wxRadioBox | null = null;
    private radioWrap: wxRadioBox | null = null;
    private radioAlign: wxRadioBox | null = null;

    private chkPassword: wxCheckBox | null = null;
    private chkReadonly: wxCheckBox | null = null;
    private chkProcessEnter: wxCheckBox | null = null;
    private chkProcessTab: wxCheckBox | null = null;
    private chkFilename: wxCheckBox | null = null;
    private chkNoVertScrollbar: wxCheckBox | null = null;

    private text: wxTextCtrl | null = null;
    private sizerText: StaticBoxSizerParts | null = null;

    private textPosCur: wxTextCtrl | null = null;
    private textRowCur: wxTextCtrl | null = null;
    private textColCur: wxTextCtrl | null = null;
    private textPosLast: wxTextCtrl | null = null;
    private textLineLast: wxTextCtrl | null = null;
    private textSelFrom: wxTextCtrl | null = null;
    private textSelTo: wxTextCtrl | null = null;
    private textRange: wxTextCtrl | null = null;

    private posCur = -2n;
    private posLast = -2n;
    private selFrom = -2;
    private selTo = -2;
    private range1020 = "";

    constructor(parent: Pointer)
    {
        super(parent, "icons/text");
    }

    override getWidget(): wxWindow | null
    {
        return this.text;
    }

    override getTextEntry(): wxTextEntry | null
    {
        return this.text ? new wxTextEntry(this.text.ptr, true) : null;
    }

    override recreateWidget(): void
    {
        this.createText();
    }

    override createContent(): void
    {
        // Left pane.
        const sizerLeft = makeStaticBoxSizer(
            this.page.ptr, VERTICAL, "&Set textctrl parameters");

        const radioTextLines = makeRadioBox(
            sizerLeft.box.ptr, ID_ANY, "&Number of lines:",
            ["single line", "multi line"], 1, RA_SPECIFY_COLS);
        this.radioTextLines = radioTextLines;
        addWin(sizerLeft.sizer, radioTextLines, 0, EXPAND, border());
        addSpacer(sizerLeft.sizer, this.dip(5));

        const chkPassword = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "&Password control", TEXT_PAGE_PASSWORD,
            sizerLeft.box.ptr);
        this.chkPassword = chkPassword;

        const chkReadonly = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "&Read-only mode", ID_ANY, sizerLeft.box.ptr);
        this.chkReadonly = chkReadonly;

        const chkProcessEnter = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Process &Enter", ID_ANY, sizerLeft.box.ptr);
        this.chkProcessEnter = chkProcessEnter;

        const chkProcessTab = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "Process &Tab", ID_ANY, sizerLeft.box.ptr);
        this.chkProcessTab = chkProcessTab;

        const chkFilename = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "&Filename control", ID_ANY, sizerLeft.box.ptr);
        this.chkFilename = chkFilename;

        const chkNoVertScrollbar = this.createCheckBoxAndAddToSizer(
            sizerLeft.sizer, "No &vertical scrollbar",
            TEXT_PAGE_NO_VERT_SCROLLBAR, sizerLeft.box.ptr);
        this.chkNoVertScrollbar = chkNoVertScrollbar;

        // Not implemented yet in the C++ sample either.
        chkFilename.Enable(false);
        addSpacer(sizerLeft.sizer, this.dip(5));

        const radioWrap = makeRadioBox(
            sizerLeft.box.ptr, TEXT_PAGE_WRAP_LINES, "&Wrap style:",
            ["no wrap", "word wrap", "char wrap", "best wrap"], 1,
            RA_SPECIFY_COLS);
        this.radioWrap = radioWrap;
        addWin(sizerLeft.sizer, radioWrap, 0, EXPAND, border());

        const radioAlign = makeRadioBox(
            sizerLeft.box.ptr, ID_ANY, "&Text alignment",
            ["left", "centre", "right"], 1, RA_SPECIFY_COLS);
        this.radioAlign = radioAlign;
        addWin(sizerLeft.sizer, radioAlign, 0, EXPAND, border());

        const resetButton = withString("&Reset", (ptr) =>
            createWxButton(sizerLeft.box.ptr, TEXT_PAGE_RESET, ptr,
                -1, -1, -1, -1, 0))!;
        addSpacer(sizerLeft.sizer, this.dip(4));
        addWin(sizerLeft.sizer, resetButton, 0, ALIGN_CENTRE_HORIZONTAL,
            tripleBorder());

        // Middle pane, upper part.
        const sizerMiddleUp = makeStaticBoxSizer(
            this.page.ptr, VERTICAL, "&Change contents:");

        const setButton = withString("&Set text value", (ptr) =>
            createWxButton(sizerMiddleUp.box.ptr, TEXT_PAGE_SET, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(sizerMiddleUp.sizer, setButton, 0, EXPAND | ALL, this.dip(1));

        const appendButton = withString("&Append text", (ptr) =>
            createWxButton(sizerMiddleUp.box.ptr, TEXT_PAGE_ADD, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(sizerMiddleUp.sizer, appendButton, 0, EXPAND | ALL, this.dip(1));

        const insertButton = withString("&Insert text", (ptr) =>
            createWxButton(sizerMiddleUp.box.ptr, TEXT_PAGE_INSERT, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(sizerMiddleUp.sizer, insertButton, 0, EXPAND | ALL, this.dip(1));

        const loadButton = withString("&Load file", (ptr) =>
            createWxButton(sizerMiddleUp.box.ptr, TEXT_PAGE_LOAD, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(sizerMiddleUp.sizer, loadButton, 0, EXPAND | ALL, this.dip(1));

        const clearButton = withString("&Clear", (ptr) =>
            createWxButton(sizerMiddleUp.box.ptr, TEXT_PAGE_CLEAR, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(sizerMiddleUp.sizer, clearButton, 0, EXPAND | ALL, this.dip(1));

        const streamButton = withString("St&ream redirection", (ptr) =>
            createWxButton(sizerMiddleUp.box.ptr, TEXT_PAGE_STREAM_REDIRECTOR,
                ptr, -1, -1, -1, -1, 0))!;
        addWin(sizerMiddleUp.sizer, streamButton, 0, EXPAND | ALL, this.dip(1));

        // Middle pane, lower part.
        const sizerMiddleDown = makeStaticBoxSizer(
            this.page.ptr, VERTICAL, "&Info:");
        const infoParent = sizerMiddleDown.box.ptr;

        const textPosCur = this.createInfoText(infoParent);
        this.textPosCur = textPosCur;
        const textRowCur = this.createInfoText(infoParent);
        this.textRowCur = textRowCur;
        const textColCur = this.createInfoText(infoParent);
        this.textColCur = textColCur;

        const sizerRow = createWxBoxSizer(HORIZONTAL)!;
        addSizer(sizerRow,
            this.createTextWithLabel(infoParent, "Current pos:", textPosCur),
            0, RIGHT, border());
        addSizer(sizerRow,
            this.createTextWithLabel(infoParent, "Col:", textColCur),
            0, LEFT | RIGHT, border());
        addSizer(sizerRow,
            this.createTextWithLabel(infoParent, "Row:", textRowCur),
            0, LEFT, border());
        addSizer(sizerMiddleDown.sizer, sizerRow, 0, ALL, border());

        const textLineLast = this.createInfoText(infoParent);
        this.textLineLast = textLineLast;
        const textPosLast = this.createInfoText(infoParent);
        this.textPosLast = textPosLast;
        addSizer(sizerMiddleDown.sizer,
            this.createTextWithLabel(infoParent, "Number of lines:",
                textLineLast, "Last position:", textPosLast),
            0, ALL, border());

        const textSelFrom = this.createInfoText(infoParent);
        this.textSelFrom = textSelFrom;
        const textSelTo = this.createInfoText(infoParent);
        this.textSelTo = textSelTo;
        addSizer(sizerMiddleDown.sizer,
            this.createTextWithLabel(infoParent, "Selection: from",
                textSelFrom, "to", textSelTo),
            0, ALL, border());

        const textRange = withString("", (ptr) =>
            createWxTextCtrl(infoParent, ID_ANY, ptr, -1, -1, -1, -1,
                BigInt(TE_READONLY)))!;
        this.textRange = textRange;
        addSizer(sizerMiddleDown.sizer,
            this.createTextWithLabel(infoParent, "Range 10..20:", textRange),
            0, ALL, border());

        const hitTestHint = withString(
            "Alt-click in the text to see HitTest() result", (ptr) =>
                createWxStaticText(infoParent, ID_ANY, ptr,
                    -1, -1, -1, -1, 0))!;
        addWin(sizerMiddleDown.sizer, hitTestHint, 0, ALL, border());

        const sizerMiddle = createWxBoxSizer(VERTICAL)!;
        addSizer(sizerMiddle, sizerMiddleUp.sizer, 0, EXPAND, 0);
        addSizer(sizerMiddle, sizerMiddleDown.sizer, 1, EXPAND | TOP, border());

        // Right pane.
        const sizerText = makeStaticBoxSizer(this.page.ptr, HORIZONTAL, "&Text:");
        this.sizerText = sizerText;
        this.reset();
        this.createText();
        sizerText.sizer.SetMinSize(this.dip(150), 0);

        // The three panes compose the upper part of the window.
        const sizerTop = createWxBoxSizer(HORIZONTAL)!;
        addSizer(sizerTop, sizerLeft.sizer, 0,
            EXPAND | TOP | BOTTOM | RIGHT, doubleBorder());
        addSizer(sizerTop, sizerMiddle, 0, EXPAND | ALL, doubleBorder());
        addSizer(sizerTop, sizerText.sizer, 1,
            EXPAND | TOP | BOTTOM | LEFT, doubleBorder());

        this.page.SetSizer(sizerTop.ptr, false);

        // Events.
        bindEvent(this.page, ID_ANY, ID_ANY, EVT_IDLE, (eventPtr) =>
        {
            if (!eventPtr) return;
            this.onIdle();
        });

        bindEvent(this.page, TEXT_PAGE_RESET, TEXT_PAGE_RESET, EVT_BUTTON, () =>
        {
            this.reset();
            this.createText();
        });
        bindEvent(this.page, TEXT_PAGE_STREAM_REDIRECTOR,
            TEXT_PAGE_STREAM_REDIRECTOR, EVT_BUTTON, () =>
            {
                this.onStreamRedirector();
            });
        bindEvent(this.page, TEXT_PAGE_CLEAR, TEXT_PAGE_CLEAR, EVT_BUTTON, () =>
        {
            this.onButtonClear();
        });
        bindEvent(this.page, TEXT_PAGE_SET, TEXT_PAGE_SET, EVT_BUTTON, () =>
        {
            this.onButtonSet();
        });
        bindEvent(this.page, TEXT_PAGE_ADD, TEXT_PAGE_ADD, EVT_BUTTON, () =>
        {
            this.onButtonAdd();
        });
        bindEvent(this.page, TEXT_PAGE_INSERT, TEXT_PAGE_INSERT, EVT_BUTTON, () =>
        {
            this.onButtonInsert();
        });
        bindEvent(this.page, TEXT_PAGE_LOAD, TEXT_PAGE_LOAD, EVT_BUTTON, () =>
        {
            this.onButtonLoad();
        });

        bindEvent(clearButton, TEXT_PAGE_CLEAR, TEXT_PAGE_CLEAR, EVT_UPDATE_UI,
            (eventPtr) =>
            {
                if (!eventPtr) return;
                const event = new wxUpdateUIEvent(eventPtr, true);
                event.Enable(this.text ? !this.text.IsEmpty() : false);
            });

        bindEvent(chkPassword, TEXT_PAGE_PASSWORD, TEXT_PAGE_PASSWORD,
            EVT_UPDATE_UI, (eventPtr) =>
            {
                if (!eventPtr) return;
                // Can't put a multiline control in password mode.
                new wxUpdateUIEvent(eventPtr, true).Enable(this.isSingleLine());
            });

        bindEvent(chkNoVertScrollbar, TEXT_PAGE_NO_VERT_SCROLLBAR,
            TEXT_PAGE_NO_VERT_SCROLLBAR, EVT_UPDATE_UI, (eventPtr) =>
            {
                if (!eventPtr) return;
                // The vertical scrollbar can be blocked only when multiline.
                new wxUpdateUIEvent(eventPtr, true).Enable(!this.isSingleLine());
            });

        bindEvent(radioWrap, TEXT_PAGE_WRAP_LINES, TEXT_PAGE_WRAP_LINES,
            EVT_UPDATE_UI, (eventPtr) =>
            {
                if (!eventPtr) return;
                new wxUpdateUIEvent(eventPtr, true).Enable(!this.isSingleLine());
            });

        bindEvent(resetButton, TEXT_PAGE_RESET, TEXT_PAGE_RESET, EVT_UPDATE_UI,
            (eventPtr) =>
            {
                if (!eventPtr) return;
                new wxUpdateUIEvent(eventPtr, true).Enable(this.isResetNeeded());
            });

        bindEvent(this.page, TEXT_PAGE_TEXTCTRL, TEXT_PAGE_TEXTCTRL, EVT_TEXT,
            (eventPtr) => this.onText(eventPtr));
        bindEvent(this.page, TEXT_PAGE_TEXTCTRL, TEXT_PAGE_TEXTCTRL,
            EVT_TEXT_ENTER, (eventPtr) => this.onTextEnter(eventPtr));
        bindEvent(this.page, TEXT_PAGE_TEXTCTRL, TEXT_PAGE_TEXTCTRL,
            EVT_TEXT_PASTE, (eventPtr) => this.onTextPasted(eventPtr));

        bindEvent(this.page, ID_ANY, ID_ANY, EVT_CHECKBOX,
            (eventPtr) => this.onCheckOrRadioBox(eventPtr));
        bindEvent(this.page, ID_ANY, ID_ANY, EVT_RADIOBOX,
            (eventPtr) => this.onCheckOrRadioBox(eventPtr));
    }

    // -- creation helpers ----------------------------------------------------

    /** CreateInfoText(): read-only text control sized for "9999999". */
    private createInfoText(parent: Pointer): wxTextCtrl
    {
        if (infoTextWidth === 0)
        {
            const width = new Int32Array(1);
            withString("9999999", (ptr) =>
                this.page.GetTextExtent(ptr, pointerOf(width), null, null, null,
                    null));
            infoTextWidth = width[0];
        }

        return withString("", (ptr) =>
            createWxTextCtrl(parent, ID_ANY, ptr, -1, -1, infoTextWidth, -1,
                BigInt(TE_READONLY)))!;
    }

    /** CreateTextWithLabelSizer(): "label [text] [label2 [text2]]" row. */
    private createTextWithLabel(
        parent: Pointer,
        label: string,
        text: wxTextCtrl,
        label2 = "",
        text2: wxTextCtrl | null = null,
    ): wxSizer
    {
        const sizerRow = createWxBoxSizer(HORIZONTAL)!;

        const labelWindow = withString(label, (ptr) =>
            createWxStaticText(parent, ID_ANY, ptr, -1, -1, -1, -1, 0))!;
        addWin(sizerRow, labelWindow, 0, ALIGN_CENTRE_VERTICAL | RIGHT, border());
        addWin(sizerRow, text, 0, ALIGN_CENTRE_VERTICAL, 0);

        if (text2)
        {
            const label2Window = withString(label2, (ptr) =>
                createWxStaticText(parent, ID_ANY, ptr, -1, -1, -1, -1, 0))!;
            addWin(sizerRow, label2Window, 0,
                ALIGN_CENTRE_VERTICAL | LEFT | RIGHT, border());
            addWin(sizerRow, text2, 0, ALIGN_CENTRE_VERTICAL, 0);
        }

        return sizerRow;
    }

    /** Writes into one of the read-only info controls without events. */
    private setTextValue(control: wxTextCtrl | null, value: string): void
    {
        if (!control)
        {
            return;
        }
        withString(value, (ptr) => control.ChangeValue(ptr));
    }

    // -- operations ----------------------------------------------------------

    private isSingleLine(): boolean
    {
        return this.radioTextLines
            ? this.radioTextLines.GetSelection() === TEXT_LINES_SINGLE
            : false;
    }

    /** Reset(): restore every control to its default value. */
    private reset(): void
    {
        this.radioTextLines?.SetSelection(DEFAULTS.textLines);

        this.chkPassword?.SetValue(DEFAULTS.password);
        this.chkReadonly?.SetValue(DEFAULTS.readOnly);
        this.chkProcessEnter?.SetValue(DEFAULTS.processEnter);
        this.chkProcessTab?.SetValue(DEFAULTS.processTab);
        this.chkFilename?.SetValue(DEFAULTS.filename);
        this.chkNoVertScrollbar?.SetValue(DEFAULTS.noVertScrollbar);

        this.radioWrap?.SetSelection(DEFAULTS.wrapStyle);
        this.radioAlign?.SetSelection(DEFAULTS.alignmentStyle);
    }

    /** True when at least one option differs from DEFAULTS. */
    private isResetNeeded(): boolean
    {
        const textLines = this.radioTextLines
            ? this.radioTextLines.GetSelection()
            : DEFAULTS.textLines;
        const wrapStyle = this.radioWrap
            ? this.radioWrap.GetSelection()
            : DEFAULTS.wrapStyle;

        return textLines !== DEFAULTS.textLines
            || (this.chkPassword ? this.chkPassword.GetValue() : DEFAULTS.password)
                !== DEFAULTS.password
            || (this.chkReadonly ? this.chkReadonly.GetValue() : DEFAULTS.readOnly)
                !== DEFAULTS.readOnly
            || (this.chkProcessEnter
                ? this.chkProcessEnter.GetValue()
                : DEFAULTS.processEnter) !== DEFAULTS.processEnter
            || (this.chkProcessTab
                ? this.chkProcessTab.GetValue()
                : DEFAULTS.processTab) !== DEFAULTS.processTab
            || (this.chkFilename ? this.chkFilename.GetValue() : DEFAULTS.filename)
                !== DEFAULTS.filename
            || (this.chkNoVertScrollbar
                ? this.chkNoVertScrollbar.GetValue()
                : DEFAULTS.noVertScrollbar) !== DEFAULTS.noVertScrollbar
            || wrapStyle !== DEFAULTS.wrapStyle;
    }

    /** CreateText(): (re)create the text control with the selected styles. */
    private createText(): void
    {
        const sizerText = this.sizerText;
        if (!sizerText)
        {
            return;
        }

        let flags = attrs.defaultFlags;

        if ((this.radioTextLines
            ? this.radioTextLines.GetSelection()
            : TEXT_LINES_MULTI) === TEXT_LINES_MULTI)
        {
            flags |= TE_MULTILINE;
            this.chkPassword?.SetValue(false);
        }

        if (this.chkPassword?.GetValue())
        {
            flags |= TE_PASSWORD;
        }
        if (this.chkReadonly?.GetValue())
        {
            flags |= TE_READONLY;
        }
        if (this.chkProcessEnter?.GetValue())
        {
            flags |= TE_PROCESS_ENTER;
        }
        if (this.chkProcessTab?.GetValue())
        {
            flags |= TE_PROCESS_TAB;
        }
        if (this.chkNoVertScrollbar?.GetValue())
        {
            flags |= TE_NO_VSCROLL;
        }

        switch (this.radioWrap ? this.radioWrap.GetSelection() : WRAP_STYLE_WORD)
        {
            case WRAP_STYLE_NONE:
                flags |= TE_DONTWRAP;
                break;

            case WRAP_STYLE_WORD:
                flags |= TE_WORDWRAP;
                break;

            case WRAP_STYLE_CHAR:
                flags |= TE_CHARWRAP;
                break;

            default: // WRAP_STYLE_BEST
                flags |= TE_BESTWRAP; // wxTE_BESTWRAP is 0
                break;
        }

        switch (this.radioAlign
            ? this.radioAlign.GetSelection()
            : ALIGN_STYLE_LEFT)
        {
            case ALIGN_STYLE_LEFT:
                flags |= TE_LEFT;
                break;

            case ALIGN_STYLE_CENTRE:
                flags |= TE_CENTRE;
                break;

            case ALIGN_STYLE_RIGHT:
                flags |= TE_RIGHT;
                break;

            default:
                break;
        }

        const oldValueString = this.text ? this.text.GetValue() : null;
        const oldValue = oldValueString
            ? readAndDeleteWxString(oldValueString.ptr)
            : "Hello, Universe!";

        if (this.text)
        {
            sizerText.sizer.DetachWindow(this.text.ptr);
            this.text.Destroy();
            this.text = null;
        }

        const created = withString(oldValue, (ptr) =>
            createWxTextCtrl(sizerText.box.ptr, TEXT_PAGE_TEXTCTRL, ptr,
                -1, -1, -1, -1, BigInt(flags)));

        if (!created)
        {
            return;
        }
        this.text = created;

        this.notifyWidgetRecreation(created);

        const isMultiline = (flags & TE_MULTILINE) !== 0;
        addWin(sizerText.sizer, created, 1, isMultiline ? EXPAND : TOP,
            border());
        sizerText.sizer.Layout();

        // WidgetsTextCtrl::OnLeftClick(): HitTest() report on Alt-click.
        bindEvent(created, ID_ANY, ID_ANY, EVT_LEFT_DOWN, (eventPtr) =>
        {
            if (!eventPtr) return;
            const event = new wxMouseEvent(eventPtr, true);
            event.Skip(true);
            if (!event.AltDown())
            {
                return;
            }

            const columnCoord = new Int32Array(1);
            const rowCoord = new Int32Array(1);
            const result = created.HitTestColumnRow(
                event.GetX(), event.GetY(), pointerOf(columnCoord),
                pointerOf(rowCoord));

            let where: string;
            let columnValue = columnCoord[0];
            let rowValue = rowCoord[0];

            switch (result)
            {
                case TE_HT_BEFORE:
                    where = "before";
                    break;

                case TE_HT_BELOW:
                    where = "below";
                    break;

                case TE_HT_BEYOND:
                    where = "beyond";
                    break;

                case TE_HT_ON_TEXT:
                    where = "at";
                    break;

                default:
                    columnValue = -1;
                    rowValue = -1;
                    where = "nowhere near";
                    break;
            }

            logMessage(`Mouse is ${where} (${columnValue}, ${rowValue})`);
        });
    }

    // -- event handlers ------------------------------------------------------

    /** OnIdle(): refresh the information texts. */
    private onIdle(): void
    {
        const text = this.text;
        if (!text)
        {
            return;
        }

        if (this.textPosCur)
        {
            const posCur = text.GetInsertionPoint();
            if (posCur !== this.posCur)
            {
                // long col, row; PositionToXY() writes one `long` into each
                // output pointer, which is 32 bits on Windows and 64 elsewhere.
                const longSize = platform === "windows" ? 4 : 8;
                const buffer = new ArrayBuffer(longSize * 2);
                const xView = new Uint8Array(buffer, 0, longSize);
                const yView = new Uint8Array(buffer, longSize, longSize);
                text.PositionToXY(posCur, pointerOf(xView), pointerOf(yView));

                const columnIndex = longSize === 4
                    ? new Int32Array(buffer, 0, 1)[0]
                    : Number(new BigInt64Array(buffer, 0, 1)[0]);
                const lineIndex = longSize === 4
                    ? new Int32Array(buffer, 4, 1)[0]
                    : Number(new BigInt64Array(buffer, 8, 1)[0]);

                this.setTextValue(this.textPosCur, String(posCur));
                this.setTextValue(this.textRowCur, String(lineIndex));
                this.setTextValue(this.textColCur, String(columnIndex));

                this.posCur = posCur;
            }
        }

        if (this.textPosLast)
        {
            const posLast = text.GetLastPosition();
            if (posLast !== this.posLast)
            {
                this.setTextValue(this.textPosLast, String(posLast));
                this.posLast = posLast;
            }
        }

        if (this.textLineLast)
        {
            this.setTextValue(this.textLineLast, String(text.GetNumberOfLines()));
        }

        if (this.textSelFrom && this.textSelTo)
        {
            const fromValue = new Int32Array(1);
            const toValue = new Int32Array(1);
            text.GetSelection(pointerOf(fromValue), pointerOf(toValue));

            if (fromValue[0] !== this.selFrom)
            {
                this.setTextValue(this.textSelFrom, String(fromValue[0]));
                this.selFrom = fromValue[0];
            }

            if (toValue[0] !== this.selTo)
            {
                this.setTextValue(this.textSelTo, String(toValue[0]));
                this.selTo = toValue[0];
            }
        }

        if (this.textRange)
        {
            const rangeValue = text.GetRange(10n, 20n);
            const range = rangeValue ? readAndDeleteWxString(rangeValue.ptr) : "";
            if (range !== this.range1020)
            {
                this.range1020 = range;
                this.setTextValue(this.textRange, range);
            }
        }
    }

    private onButtonSet(): void
    {
        const text = this.text;
        if (!text)
        {
            return;
        }

        const multiline =
            (text.GetWindowStyle() & BigInt(TE_MULTILINE)) !== 0n;
        withString(
            multiline ? "Here,\nthere and\neverywhere" : "Yellow submarine",
            (ptr) => text.SetValue(ptr));
        text.SetFocus();
    }

    private onButtonAdd(): void
    {
        const text = this.text;
        if (!text)
        {
            return;
        }

        if ((text.GetWindowStyle() & BigInt(TE_MULTILINE)) !== 0n)
        {
            withString("We all live in a\n", (ptr) => text.AppendText(ptr));
        }

        withString("Yellow submarine", (ptr) => text.AppendText(ptr));
    }

    private onButtonInsert(): void
    {
        const text = this.text;
        if (!text)
        {
            return;
        }

        withString("Is there anybody going to listen to my story", (ptr) =>
            text.WriteText(ptr));
        if ((text.GetWindowStyle() & BigInt(TE_MULTILINE)) !== 0n)
        {
            withString("\nall about the girl who came to stay", (ptr) =>
                text.WriteText(ptr));
        }
    }

    private onButtonClear(): void
    {
        const text = this.text;
        if (!text)
        {
            return;
        }

        text.Clear();
        text.SetFocus();
    }

    /**
     * OnButtonLoad(): searches the sample's usual source directories with a
     * wxPathList, then loads the file it finds.
     */
    private onButtonLoad(): void
    {
        const text = this.text;
        if (!text)
        {
            return;
        }

        const pathList = createWxPathList();
        if (!pathList)
        {
            logError("File textctrl.cpp not found.");
            return;
        }

        for (const directory of [".", "..", "../widgets", "../../../samples/widgets"])
        {
            withString(directory, (ptr) => pathList.Add(ptr));
        }

        const found = withString("textctrl.cpp", (ptr) => pathList.FindValidPath(ptr));
        const filename = found ? readAndDeleteWxString(found.ptr) : "";
        pathList.Delete();

        if (!filename)
        {
            logError("File textctrl.cpp not found.");
            return;
        }

        const stopWatch = createWxStopWatch();
        const loaded = withString(filename, (ptr) =>
            text.LoadFile(ptr, TEXT_TYPE_ANY));
        const elapsed = stopWatch ? stopWatch.Time() : 0;
        stopWatch?.Delete();

        if (!loaded)
        {
            // This is not supposed to happen...
            logError("Error loading file.");
            return;
        }

        logMessage(
            `Loaded file '${filename}' in ${Math.floor(elapsed / 1000)}.${elapsed % 1000}s`);
    }

    private onStreamRedirector(): void
    {
        const text = this.text;
        if (!text)
        {
            return;
        }

        // wxStreamToTextRedirector redirect(m_text);
        const redirect = createWxStreamToTextRedirector(text.ptr);

        // JavaScript has no access to std::cout; the redirector is created and
        // destroyed exactly like the C++ object, and any native C++ output
        // written while it is alive still goes to the text control.
        console.log("Outputed to cout, appears in wxTextCtrl!");

        redirect?.Delete();
    }

    private onText(eventPtr: Pointer): void
    {
        if (!eventPtr)
        {
            return;
        }
        if (!isUsingLogWindow())
        {
            return;
        }

        const event = new wxCommandEvent(eventPtr, true);
        const valueString = event.GetString();
        const value = valueString ? readAndDeleteWxString(valueString.ptr) : "";
        logMessage(
            `Text control value changed (now '${ellipsizeMiddle(this.page, value)}')`);
    }

    private onTextEnter(eventPtr: Pointer): void
    {
        if (!eventPtr)
        {
            return;
        }

        const event = new wxCommandEvent(eventPtr, true);
        const valueString = event.GetString();
        const value = valueString ? readAndDeleteWxString(valueString.ptr) : "";
        logMessage(`Text entered: '${value}'`);
        event.Skip(true);
    }

    private onTextPasted(eventPtr: Pointer): void
    {
        if (!eventPtr)
        {
            return;
        }

        logMessage("Text pasted from clipboard.");
        new wxEvent(eventPtr, true).Skip(true);
    }

    private onCheckOrRadioBox(eventPtr: Pointer): void
    {
        if (!eventPtr)
        {
            return;
        }

        const event = new wxCommandEvent(eventPtr, true);
        const target = event.GetEventObject();
        const text = this.text;

        // The text alignment can be changed without recreating the control.
        if (text && target && this.radioAlign
            && target.IsSameAs(this.radioAlign.ptr))
        {
            let flags = Number(text.GetWindowStyle());
            flags &= ~(TE_LEFT | TE_CENTRE | TE_RIGHT);

            switch (event.GetSelection())
            {
                case ALIGN_STYLE_LEFT:
                    flags |= TE_LEFT;
                    break;

                case ALIGN_STYLE_CENTRE:
                    flags |= TE_CENTRE;
                    break;

                case ALIGN_STYLE_RIGHT:
                    flags |= TE_RIGHT;
                    break;

                default:
                    return;
            }

            text.SetWindowStyle(BigInt(flags));
            text.Refresh(true);

            flags = Number(text.GetWindowStyle());
            const alignment = (flags & TE_RIGHT) !== 0
                ? "Right"
                : (flags & TE_CENTRE) !== 0 ? "Center" : "Left";
            logMessage(`Text alignment: ${alignment}`);
            return;
        }

        this.createText();
    }
}

export function createTextPage(parent: Pointer): WidgetsPage
{
    return new TextPage(parent);
}
