// prefs.kwxts — language, style and id tables for the STC sample.
//
// Direct port of prefs.cpp / prefs.h / defsext.h. The C++ tables are plain
// data, so they are reproduced as data; nothing here calls wxWidgets.

import { ID_HIGHEST } from "kwx";
import { wxSTC_LEX_CPP, wxSTC_LEX_PROPERTIES, wxSTC_LEX_PYTHON } from "./stc_consts.kwxts";

/** defsext.h: DEFAULT_LANGUAGE */
export const DEFAULT_LANGUAGE = "<default>";

/** defsext.h: STYLE_TYPES_COUNT */
export const STYLE_TYPES_COUNT = 32;

// ---------------------------------------------------------------------------
// defsext.h — custom menu ids, in declaration order
// ---------------------------------------------------------------------------

/** One entry per defsext.h enumerator, values identical to the C++ enum. */
export interface StcIds
{
    readonly PROPERTIES: number;
    readonly EDIT_FIRST: number;
    readonly INDENTINC: number;
    readonly INDENTRED: number;
    readonly FINDNEXT: number;
    readonly REPLACE: number;
    readonly REPLACENEXT: number;
    readonly BRACEMATCH: number;
    readonly GOTO: number;
    readonly DISPLAYEOL: number;
    readonly INDENTGUIDE: number;
    readonly LINENUMBER: number;
    readonly LONGLINEON: number;
    readonly WHITESPACE: number;
    readonly FOLDTOGGLE: number;
    readonly OVERTYPE: number;
    readonly READONLY: number;
    readonly WRAPMODEON: number;
    readonly ANNOTATION_ADD: number;
    readonly ANNOTATION_REMOVE: number;
    readonly ANNOTATION_CLEAR: number;
    readonly ANNOTATION_STYLE_HIDDEN: number;
    readonly ANNOTATION_STYLE_STANDARD: number;
    readonly ANNOTATION_STYLE_BOXED: number;
    readonly INDICATOR_FILL: number;
    readonly INDICATOR_CLEAR: number;
    readonly INDICATOR_STYLE_FIRST: number;
    readonly INDICATOR_STYLE_PLAIN: number;
    readonly INDICATOR_STYLE_SQUIGGLE: number;
    readonly INDICATOR_STYLE_TT: number;
    readonly INDICATOR_STYLE_DIAGONAL: number;
    readonly INDICATOR_STYLE_STRIKE: number;
    readonly INDICATOR_STYLE_HIDDEN: number;
    readonly INDICATOR_STYLE_BOX: number;
    readonly INDICATOR_STYLE_ROUNDBOX: number;
    readonly INDICATOR_STYLE_STRAIGHTBOX: number;
    readonly INDICATOR_STYLE_DASH: number;
    readonly INDICATOR_STYLE_DOTS: number;
    readonly INDICATOR_STYLE_SQUIGGLELOW: number;
    readonly INDICATOR_STYLE_DOTBOX: number;
    readonly INDICATOR_STYLE_SQUIGGLEPIXMAP: number;
    readonly INDICATOR_STYLE_COMPOSITIONTHICK: number;
    readonly INDICATOR_STYLE_COMPOSITIONTHIN: number;
    readonly INDICATOR_STYLE_FULLBOX: number;
    readonly INDICATOR_STYLE_TEXTFORE: number;
    readonly INDICATOR_STYLE_POINT: number;
    readonly INDICATOR_STYLE_POINTCHARACTER: number;
    readonly INDICATOR_STYLE_LAST: number;
    readonly CHANGECASE: number;
    readonly CHANGELOWER: number;
    readonly CHANGEUPPER: number;
    readonly HIGHLIGHTLANG: number;
    readonly HIGHLIGHTFIRST: number;
    readonly HIGHLIGHTLAST: number;
    readonly CONVERTEOL: number;
    readonly CONVERTCR: number;
    readonly CONVERTCRLF: number;
    readonly CONVERTLF: number;
    readonly MULTIPLE_SELECTIONS: number;
    readonly MULTI_PASTE: number;
    readonly MULTIPLE_SELECTIONS_TYPING: number;
    readonly TECHNOLOGY_DEFAULT: number;
    readonly TECHNOLOGY_DIRECTWRITE: number;
    readonly CUSTOM_POPUP: number;
    readonly USECHARSET: number;
    readonly CHARSETANSI: number;
    readonly CHARSETMAC: number;
    readonly SELECTLINE: number;
    readonly EDIT_LAST: number;
    readonly WINDOW_MINIMAL: number;
    readonly WINDOW_DOCMAP: number;
    readonly ABOUTTIMER: number;
}

/**
 * defsext.h enum { myID_PROPERTIES = wxID_HIGHEST, ... }.
 * A local counter reproduces the C++ implicit continuation, including the
 * explicit assignments (INDENTINC = EDIT_FIRST, INDICATOR_STYLE_PLAIN =
 * INDICATOR_STYLE_FIRST, HIGHLIGHTLAST = HIGHLIGHTFIRST + 99,
 * EDIT_LAST = SELECTLINE).
 */
export const myID: StcIds = (() =>
{
    let next = ID_HIGHEST;
    const take = (): number => next++;

    const PROPERTIES = take();
    const EDIT_FIRST = take();
    const INDENTINC = EDIT_FIRST;
    const INDENTRED = take();
    const FINDNEXT = take();
    const REPLACE = take();
    const REPLACENEXT = take();
    const BRACEMATCH = take();
    const GOTO = take();
    const DISPLAYEOL = take();
    const INDENTGUIDE = take();
    const LINENUMBER = take();
    const LONGLINEON = take();
    const WHITESPACE = take();
    const FOLDTOGGLE = take();
    const OVERTYPE = take();
    const READONLY = take();
    const WRAPMODEON = take();
    const ANNOTATION_ADD = take();
    const ANNOTATION_REMOVE = take();
    const ANNOTATION_CLEAR = take();
    const ANNOTATION_STYLE_HIDDEN = take();
    const ANNOTATION_STYLE_STANDARD = take();
    const ANNOTATION_STYLE_BOXED = take();
    const INDICATOR_FILL = take();
    const INDICATOR_CLEAR = take();
    const INDICATOR_STYLE_FIRST = take();
    const INDICATOR_STYLE_PLAIN = INDICATOR_STYLE_FIRST;
    const INDICATOR_STYLE_SQUIGGLE = take();
    const INDICATOR_STYLE_TT = take();
    const INDICATOR_STYLE_DIAGONAL = take();
    const INDICATOR_STYLE_STRIKE = take();
    const INDICATOR_STYLE_HIDDEN = take();
    const INDICATOR_STYLE_BOX = take();
    const INDICATOR_STYLE_ROUNDBOX = take();
    const INDICATOR_STYLE_STRAIGHTBOX = take();
    const INDICATOR_STYLE_DASH = take();
    const INDICATOR_STYLE_DOTS = take();
    const INDICATOR_STYLE_SQUIGGLELOW = take();
    const INDICATOR_STYLE_DOTBOX = take();
    const INDICATOR_STYLE_SQUIGGLEPIXMAP = take();
    const INDICATOR_STYLE_COMPOSITIONTHICK = take();
    const INDICATOR_STYLE_COMPOSITIONTHIN = take();
    const INDICATOR_STYLE_FULLBOX = take();
    const INDICATOR_STYLE_TEXTFORE = take();
    const INDICATOR_STYLE_POINT = take();
    const INDICATOR_STYLE_POINTCHARACTER = take();
    const INDICATOR_STYLE_LAST = INDICATOR_STYLE_POINTCHARACTER;

    const CHANGECASE = take();
    const CHANGELOWER = take();
    const CHANGEUPPER = take();
    const HIGHLIGHTLANG = take();
    const HIGHLIGHTFIRST = take();
    const HIGHLIGHTLAST = HIGHLIGHTFIRST + 99;
    next = HIGHLIGHTFIRST + 100;
    const CONVERTEOL = take();
    const CONVERTCR = take();
    const CONVERTCRLF = take();
    const CONVERTLF = take();
    const MULTIPLE_SELECTIONS = take();
    const MULTI_PASTE = take();
    const MULTIPLE_SELECTIONS_TYPING = take();
    const TECHNOLOGY_DEFAULT = take();
    const TECHNOLOGY_DIRECTWRITE = take();
    const CUSTOM_POPUP = take();
    const USECHARSET = take();
    const CHARSETANSI = take();
    const CHARSETMAC = take();
    const SELECTLINE = take();
    const EDIT_LAST = SELECTLINE;
    const WINDOW_MINIMAL = take();
    const WINDOW_DOCMAP = take();
    const ABOUTTIMER = take();

    return {
        PROPERTIES, EDIT_FIRST, INDENTINC, INDENTRED, FINDNEXT, REPLACE, REPLACENEXT,
        BRACEMATCH, GOTO, DISPLAYEOL, INDENTGUIDE, LINENUMBER, LONGLINEON, WHITESPACE,
        FOLDTOGGLE, OVERTYPE, READONLY, WRAPMODEON, ANNOTATION_ADD, ANNOTATION_REMOVE,
        ANNOTATION_CLEAR, ANNOTATION_STYLE_HIDDEN, ANNOTATION_STYLE_STANDARD,
        ANNOTATION_STYLE_BOXED, INDICATOR_FILL, INDICATOR_CLEAR, INDICATOR_STYLE_FIRST,
        INDICATOR_STYLE_PLAIN, INDICATOR_STYLE_SQUIGGLE, INDICATOR_STYLE_TT,
        INDICATOR_STYLE_DIAGONAL, INDICATOR_STYLE_STRIKE, INDICATOR_STYLE_HIDDEN,
        INDICATOR_STYLE_BOX, INDICATOR_STYLE_ROUNDBOX, INDICATOR_STYLE_STRAIGHTBOX,
        INDICATOR_STYLE_DASH, INDICATOR_STYLE_DOTS, INDICATOR_STYLE_SQUIGGLELOW,
        INDICATOR_STYLE_DOTBOX, INDICATOR_STYLE_SQUIGGLEPIXMAP,
        INDICATOR_STYLE_COMPOSITIONTHICK, INDICATOR_STYLE_COMPOSITIONTHIN,
        INDICATOR_STYLE_FULLBOX, INDICATOR_STYLE_TEXTFORE, INDICATOR_STYLE_POINT,
        INDICATOR_STYLE_POINTCHARACTER, INDICATOR_STYLE_LAST, CHANGECASE, CHANGELOWER,
        CHANGEUPPER, HIGHLIGHTLANG, HIGHLIGHTFIRST, HIGHLIGHTLAST, CONVERTEOL,
        CONVERTCR, CONVERTCRLF, CONVERTLF, MULTIPLE_SELECTIONS, MULTI_PASTE,
        MULTIPLE_SELECTIONS_TYPING, TECHNOLOGY_DEFAULT, TECHNOLOGY_DIRECTWRITE,
        CUSTOM_POPUP, USECHARSET, CHARSETANSI, CHARSETMAC, SELECTLINE, EDIT_LAST,
        WINDOW_MINIMAL, WINDOW_DOCMAP, ABOUTTIMER,
    };
})();

