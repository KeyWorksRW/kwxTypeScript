function lineEntry(): void
{
    const current = state;
    if (!current) return;

    const message = "This is a small sample\n" +
        "A long, long string to test out the text entrybox";

    if (isCheckedOption(DIALOGS_USE_WRAPPER_FUNCTIONS))
    {
        const position = positionOf(current.frame);
        const value = getTextFromUser(message, "Please enter a string",
            "Default value", current.frame.ptr,
            position.x + 50, position.y + 50, true, 500, -1);
        if (value !== "")
        {
            messageBox(value, "Got string", OK | ICON_INFORMATION, current.frame.ptr);
        }
        return;
    }

    const dialog = withStrings([
        message, "Please enter a string", "Default value",
    ], (ptrs) => createWxTextEntryDialog(
        current.frame.ptr, ptrs[0], ptrs[1], ptrs[2],
        BigInt(OK | CANCEL), -1, -1, -1, -1));
    if (!dialog) return;

    withString("Enter your text here", (ptr) => dialog.SetHint(ptr));

    if (dialog.ShowModal() === ID_OK)
    {
        messageBox(takeText(dialog.GetValue()), "Got string",
            OK | ICON_INFORMATION, current.frame.ptr);
    }
    dialog.Destroy();
}

