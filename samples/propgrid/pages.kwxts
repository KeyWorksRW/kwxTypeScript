            onOff("wxUSE_TEXTBUFFER", true),
            onOff("wxUSE_TEXTFILE", true),
            onOff("wxUSE_INTL", true),
            onOff("wxUSE_DATETIME", true),
            onOff("wxUSE_TIMER", true),
