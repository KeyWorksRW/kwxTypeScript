// ---------------------------------------------------------------------------
// helpers
// ---------------------------------------------------------------------------

function message(text: string, caption: string, style: number, parent: Pointer): number
{
    return withString(text, (messagePtr) =>
        withString(caption, (captionPtr) =>
            kwxMessageBox(messagePtr, captionPtr, style, parent, -1, -1)));
}

/** wxFileName(fname).GetAbsolutePath() */
function absolutePath(fname: string): string
{
    const fileName: wxFileName | null = withString(fname, (path) =>
        createWxFileNameFromPath(path, 0));
    if (!fileName)
    {
        return fname;
    }
    const absolute = fileName.GetAbsolutePath(null, 0);
    const result = absolute ? takeString(absolute) : fname;
    lib.symbols.wxFileName_Delete(fileName.ptr);
    return result;
}

function menuItem(menu: wxMenu, id: number, label: string): void
{
    withString(label, (text) =>
        withString("", (help) => menu.Append(id, text, help, false)));
}

function menuCheckItem(menu: wxMenu, id: number, label: string): void
{
    withString(label, (text) =>
        withString("", (help) => menu.AppendCheckItem(id, text, help)));
}

function menuRadioItem(menu: wxMenu, id: number, label: string): void
{
    withString(label, (text) =>
        withString("", (help) => menu.AppendRadioItem(id, text, help)));
}

function menuSubMenu(menu: wxMenu, submenu: wxMenu, label: string): void
{
    withString(label, (text) =>
        withString("", (help) => menu.AppendSubMenu(submenu.ptr, text, help)));
}

/** menu->Append(id, text, submenu) — a submenu that keeps its own id. */
function menuSubMenuItem(menu: wxMenu, id: number, submenu: wxMenu, label: string): void
{
    withString(label, (text) =>
        withString("", (help) => menu.AppendSub(id, text, submenu.ptr, help)));
}

function newMenu(): wxMenu | null
{
    return withString("", (title) => createWxMenu(title, 0n));
}

// ---------------------------------------------------------------------------
// AppFrame::CreateMenu()
// ---------------------------------------------------------------------------

function createMenuBar(frame: wxFrame): wxMenuBar | null
{
    // File menu
    const menuFile = newMenu();
    if (!menuFile)
    {
        return null;
    }
    menuItem(menuFile, ID_OPEN, "&Open ..\tCtrl+O");
    menuItem(menuFile, ID_SAVE, "&Save\tCtrl+S");
    menuItem(menuFile, ID_SAVEAS, "Save &as ..\tCtrl+Shift+S");
    menuItem(menuFile, ID_CLOSE, "&Close\tCtrl+W");
    menuFile.AppendSeparator();
    menuItem(menuFile, myID.PROPERTIES, "Proper&ties ..\tCtrl+Shift+T");
    menuFile.AppendSeparator();
    menuItem(menuFile, ID_PRINT_SETUP, "Print Set&up ..");
    menuItem(menuFile, ID_PREVIEW, "Print Pre&view\tCtrl+Shift+P");
    menuItem(menuFile, ID_PRINT, "&Print ..\tCtrl+P");
    menuFile.AppendSeparator();
    menuItem(menuFile, ID_EXIT, "&Quit\tCtrl+Q");

    // Edit menu
    const menuEdit = newMenu();
    if (!menuEdit)
    {
        return null;
    }
    menuItem(menuEdit, ID_UNDO, "&Undo\tCtrl+Z");
    menuItem(menuEdit, ID_REDO, "&Redo\tCtrl+Shift+Z");
    menuEdit.AppendSeparator();
    menuItem(menuEdit, ID_CUT, "Cu&t\tCtrl+X");
    menuItem(menuEdit, ID_COPY, "&Copy\tCtrl+C");
    menuItem(menuEdit, ID_PASTE, "&Paste\tCtrl+V");
    menuItem(menuEdit, ID_CLEAR, "&Delete\tDel");
    menuEdit.AppendSeparator();
    menuItem(menuEdit, ID_FIND, "&Find\tCtrl+F");
    menuEdit.Enable(ID_FIND, false);
    menuItem(menuEdit, myID.FINDNEXT, "Find &next\tF3");
    menuEdit.Enable(myID.FINDNEXT, false);
    menuItem(menuEdit, myID.REPLACE, "&Replace\tCtrl+H");
    menuEdit.Enable(myID.REPLACE, false);
    menuItem(menuEdit, myID.REPLACENEXT, "Replace &again\tShift+F4");
    menuEdit.Enable(myID.REPLACENEXT, false);
    menuEdit.AppendSeparator();
    menuItem(menuEdit, myID.BRACEMATCH, "&Match brace\tCtrl+M");
    menuItem(menuEdit, myID.GOTO, "&Goto\tCtrl+G");
    menuEdit.Enable(myID.GOTO, false);
    menuEdit.AppendSeparator();
    menuItem(menuEdit, myID.INDENTINC, "&Indent increase\tCtrl+I");
    menuItem(menuEdit, myID.INDENTRED, "I&ndent reduce\tShift+Ctrl+I");
    menuEdit.AppendSeparator();
    menuItem(menuEdit, ID_SELECTALL, "&Select all\tCtrl+A");
    menuItem(menuEdit, myID.SELECTLINE, "Select &line\tCtrl+L");

    // highlight submenu
    const menuHighlight = newMenu();
    if (menuHighlight)
    {
        for (let nr = 0; nr < g_LanguagePrefs.length; nr++)
        {
            menuItem(menuHighlight, myID.HIGHLIGHTFIRST + nr, g_LanguagePrefs[nr].name);
        }
    }

    // charset submenu
    const menuCharset = newMenu();
    if (menuCharset)
    {
        menuItem(menuCharset, myID.CHARSETANSI, "&ANSI (Windows)");
        menuItem(menuCharset, myID.CHARSETMAC, "&MAC (Macintosh)");
    }

    // View menu
    const menuView = newMenu();
    if (!menuView)
    {
        return null;
    }
    if (menuHighlight)
    {
        menuSubMenuItem(menuView, myID.HIGHLIGHTLANG, menuHighlight, "&Highlight language ..");
    }
    menuView.AppendSeparator();
    menuCheckItem(menuView, myID.FOLDTOGGLE, "&Toggle current fold\tCtrl+T");
    menuCheckItem(menuView, myID.OVERTYPE, "&Overwrite mode\tIns");
    menuCheckItem(menuView, myID.WRAPMODEON, "&Wrap mode\tCtrl+U");
    menuView.AppendSeparator();
    menuCheckItem(menuView, myID.DISPLAYEOL, "Show line &endings");
    menuCheckItem(menuView, myID.INDENTGUIDE, "Show &indent guides");
    menuCheckItem(menuView, myID.LINENUMBER, "Show line &numbers");
    menuCheckItem(menuView, myID.LONGLINEON, "Show &long line marker");
    menuCheckItem(menuView, myID.WHITESPACE, "Show white&space");
    menuView.AppendSeparator();
    if (menuCharset)
    {
        menuSubMenuItem(menuView, myID.USECHARSET, menuCharset, "Use &code page of ..");
    }
    menuView.AppendSeparator();
    menuItem(menuView, myID.WINDOW_MINIMAL, "&Minimal editor");
    menuItem(menuView, myID.WINDOW_DOCMAP, "Document &map\tF2");

    // Annotations menu
    const menuAnnotations = newMenu();
    if (!menuAnnotations)
    {
        return null;
    }
    withString("Add an annotation for the current line", (help) =>
        withString("&Add or edit an annotation...", (text) =>
            menuAnnotations.Append(myID.ANNOTATION_ADD, text, help, false)));
    withString("Remove the annotation for the current line", (help) =>
        withString("&Remove annotation", (text) =>
            menuAnnotations.Append(myID.ANNOTATION_REMOVE, text, help, false)));
    menuItem(menuAnnotations, myID.ANNOTATION_CLEAR, "&Clear all annotations");

    const menuAnnotationsStyle = newMenu();
    if (menuAnnotationsStyle)
    {
        menuRadioItem(menuAnnotationsStyle, myID.ANNOTATION_STYLE_HIDDEN, "&Hidden");
        menuRadioItem(menuAnnotationsStyle, myID.ANNOTATION_STYLE_STANDARD, "&Standard");
        menuRadioItem(menuAnnotationsStyle, myID.ANNOTATION_STYLE_BOXED, "&Boxed");
        menuSubMenu(menuAnnotations, menuAnnotationsStyle, "&Style");
    }

    // Indicators menu
    const menuIndicators = newMenu();
    if (!menuIndicators)
    {
        return null;
    }
    menuItem(menuIndicators, myID.INDICATOR_FILL, "&Add indicator for selection");
    menuItem(menuIndicators, myID.INDICATOR_CLEAR, "&Clear indicator for selection");

    const menuIndicatorStyle = newMenu();
    if (menuIndicatorStyle)
    {
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_PLAIN, "Plain");
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_SQUIGGLE, "Squiggle");
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_TT, "TT");
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_DIAGONAL, "Diagonal");
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_STRIKE, "Strike");
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_HIDDEN, "Hidden");
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_BOX, "Box");
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_ROUNDBOX, "Round box");
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_STRAIGHTBOX, "Straight box");
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_DASH, "Dash");
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_DOTS, "Dots");
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_SQUIGGLELOW, "Squiggle low");
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_DOTBOX, "Dot box");
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_SQUIGGLEPIXMAP, "Squiggle pixmap");
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_COMPOSITIONTHICK, "Composition thick");
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_COMPOSITIONTHIN, "Composition thin");
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_FULLBOX, "Full box");
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_TEXTFORE, "Text fore");
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_POINT, "Point");
        menuRadioItem(menuIndicatorStyle, myID.INDICATOR_STYLE_POINTCHARACTER, "Point character");
        menuSubMenu(menuIndicators, menuIndicatorStyle, "&Style");
    }

    // change case submenu
    const menuChangeCase = newMenu();
    if (menuChangeCase)
    {
        menuItem(menuChangeCase, myID.CHANGEUPPER, "&Upper case");
        menuItem(menuChangeCase, myID.CHANGELOWER, "&Lower case");
    }

    // convert EOL submenu
    const menuConvertEOL = newMenu();
    if (menuConvertEOL)
    {
        menuItem(menuConvertEOL, myID.CONVERTCR, "CR (&Linux)");
        menuItem(menuConvertEOL, myID.CONVERTCRLF, "CR+LF (&Windows)");
        menuItem(menuConvertEOL, myID.CONVERTLF, "LF (&Macintosh)");
    }

    // Extra menu
    const menuExtra = newMenu();
    if (!menuExtra)
    {
        return null;
    }
    menuCheckItem(menuExtra, myID.READONLY, "&Readonly mode");
    menuExtra.AppendSeparator();
    if (menuChangeCase)
    {
        menuSubMenuItem(menuExtra, myID.CHANGECASE, menuChangeCase, "Change &case to ..");
    }
    menuExtra.AppendSeparator();
    if (menuConvertEOL)
    {
        menuSubMenuItem(menuExtra, myID.CONVERTEOL, menuConvertEOL, "Convert line &endings to ..");
    }
    menuCheckItem(menuExtra, myID.MULTIPLE_SELECTIONS, "Toggle &multiple selections");
    menuCheckItem(menuExtra, myID.MULTI_PASTE, "Toggle multi-&paste");
    menuCheckItem(menuExtra, myID.MULTIPLE_SELECTIONS_TYPING, "Toggle t&yping on multiple selections");
    menuExtra.AppendSeparator();

    // #if defined(__WXMSW__) && wxUSE_GRAPHICS_DIRECT2D
    if (platform === "windows")
    {
        const menuTechnology = newMenu();
        if (menuTechnology)
        {
            menuRadioItem(menuTechnology, myID.TECHNOLOGY_DEFAULT, "&Default");
            menuRadioItem(menuTechnology, myID.TECHNOLOGY_DIRECTWRITE, "Direct&Write");
            menuSubMenu(menuExtra, menuTechnology, "&Technology");
        }
        menuExtra.AppendSeparator();
    }

    menuCheckItem(menuExtra, myID.CUSTOM_POPUP, "C&ustom context menu");

    // Help menu
    const menuHelp = newMenu();
    if (!menuHelp)
    {
        return null;
    }
    menuItem(menuHelp, ID_ABOUT, "&About ..\tCtrl+D");

    // construct menu
    const menuBar = createWxMenuBar(0);
    if (!menuBar)
    {
        return null;
    }
    withString("&File", (label) => menuBar.Append(menuFile.ptr, label));
    withString("&Edit", (label) => menuBar.Append(menuEdit.ptr, label));
    withString("&View", (label) => menuBar.Append(menuView.ptr, label));
    withString("&Annotations", (label) => menuBar.Append(menuAnnotations.ptr, label));
    withString("&Indicators", (label) => menuBar.Append(menuIndicators.ptr, label));
    withString("E&xtra", (label) => menuBar.Append(menuExtra.ptr, label));
    withString("&Help", (label) => menuBar.Append(menuHelp.ptr, label));

    menuBar.Check(myID.ANNOTATION_STYLE_BOXED, true);
    return menuBar;
}

// ---------------------------------------------------------------------------
// AppFrame
// ---------------------------------------------------------------------------

function createAppFrame(title: string): FrameState | null
{
    const frame = withString(title, (value) =>
        createWxFrame(null, ID_ANY, value, -1, -1, 750, 550, DEFAULT_FRAME_STYLE));
    if (!frame)
    {
        return null;
    }

    const icon = sampleIcon();
    if (icon)
    {
        frame.SetIcon(icon.ptr);
    }

    // set icon and background
    withString(g_appname, (value) => frame.SetTitle(value));
    const white = withString("WHITE", (name) => createWxColourByName(name));
    if (white)
    {
        frame.SetBackgroundColour(white.ptr);
        white.Delete();
    }

    // create menu
    const menuBar = createMenuBar(frame);
    if (menuBar)
    {
        frame.SetMenuBar(menuBar.ptr);
    }

    // open first page
    // Edit(this, wxID_ANY) with the default style
    const edit = createEdit(frame.ptr, ID_ANY, editDefaultStyle());
    if (!edit)
    {
        frame.Destroy();
        return null;
    }
    edit.win.SetFocus();

    const state: FrameState = { frame, edit };
    fileOpen(state, sampleSourcePath());
    return state;
}

/** The Edit default style: edit.h, "#ifndef __WXMAC__ wxSUNKEN_BORDER | wxVSCROLL". */
function editDefaultStyle(): number
{
    return (platform === "darwin" ? 0 : BORDER_SUNKEN) | VSCROLL;
}

/** AppFrame::FileOpen(fname) */
function fileOpen(state: FrameState, fname: string): void
{
    editLoadFile(state.edit, absolutePath(fname));
    selectNone(state.edit);
}

/** wxStyledTextCtrl::SelectNone() — empty selection without scrolling. */
function selectNone(edit: EditState): void
{
    const pos = edit.ctrl.GetCurrentPos(edit.ctrl.ptr);
    edit.ctrl.SetSelection(edit.ctrl.ptr, pos, pos);
}

// ---------------------------------------------------------------------------
// AppFrame event handlers
// ---------------------------------------------------------------------------

function onFileClose(state: FrameState): void
{
    if (editModified(state.edit))
    {
        if (message("Text is not saved, save before closing?", "Close",
            YES_NO | ICON_QUESTION, state.frame.ptr) === YES)
        {
            editSaveFilePrompt(state.edit);
            if (editModified(state.edit))
            {
                message("Text could not be saved!", "Close abort",
                    OK | ICON_WARNING, state.frame.ptr);
                return;
            }
        }
    }
    editSetFilename(state.edit, "");
    editResetDocument(state.edit);
}

function onClose(state: FrameState, eventPtr: Pointer): void
{
    const event = new wxCloseEvent(eventPtr);
    onFileClose(state);
    if (editModified(state.edit))
    {
        if (event.CanVeto())
        {
            event.Veto(true);
        }
        return;
    }
    state.frame.Destroy();
}

function onAbout(state: FrameState): void
{
    showAbout(state.frame.ptr, g_appname, APP_VERSION);
}

function onExit(state: FrameState): void
{
    state.frame.Close(true);
}

function onFileOpen(state: FrameState): void
{
    const dialog = createFileDialog(state, "Open file",
        FD_OPEN | FD_FILE_MUST_EXIST | FD_CHANGE_DIR);
    if (!dialog)
    {
        return;
    }
    const confirmed = dialog.ShowModal() === ID_OK;
    const path = confirmed ? takeString(dialog.GetPath()) : "";
    dialog.Destroy();
    if (confirmed && path !== "")
    {
        fileOpen(state, path);
    }
}

function onFileSave(state: FrameState): void
{
    if (!editModified(state.edit))
    {
        // wxICON_EXCLAMATION is wxICON_WARNING; only the latter is bound.
        message("There is nothing to save!", "Save file",
            OK | ICON_WARNING, state.frame.ptr);
        return;
    }
    editSaveFilePrompt(state.edit);
}

function onFileSaveAs(state: FrameState): void
{
    const dialog = createFileDialog(state, "Save file", FD_SAVE | FD_OVERWRITE_PROMPT);
    if (!dialog)
    {
        return;
    }
    const confirmed = dialog.ShowModal() === ID_OK;
    const path = confirmed ? takeString(dialog.GetPath()) : "";
    dialog.Destroy();
    if (confirmed && path !== "")
    {
        editSaveFile(state.edit, path);
    }
}

function createFileDialog(state: FrameState, caption: string, style: number)
{
    return withString(caption, (messagePtr) =>
        withString("", (directory) =>
            withString("", (files) =>
                withString("Any file (*)|*", (wildcard) =>
                    createWxFileDialog(
                        state.frame.ptr, messagePtr, directory, files, wildcard,
                        -1, -1, style, -1, -1)))));
}

function onProperties(state: FrameState): void
{
    showEditProperties(editPtr(state.edit), editGetInfo(state.edit));
}

function onPrintSetup(state: FrameState): void
{
    if (!printData || !pageSetupData)
    {
        return;
    }
    // (*g_pageSetupData) = *g_printData;
    pageSetupData.SetPrintData(printData.ptr);

    const dialog = createWxPageSetupDialog(state.frame.ptr, pageSetupData.ptr);
    if (!dialog)
    {
        return;
    }
    dialog.ShowModal();
    // (*g_printData) = dlg.GetPageSetupData().GetPrintData();
    // (*g_pageSetupData) = dlg.GetPageSetupData();
    dialog.GetPageSetupData(pageSetupData.ptr);
    pageSetupData.GetPrintData(printData.ptr);
}

function onPrintPreview(state: FrameState): void
{
    // BLOCKED: needs an EditPrint (wxPrintout subclass); see the header.
    void state;
}

function onPrint(state: FrameState): void
{
    // BLOCKED: needs an EditPrint (wxPrintout subclass); see the header.
    void state;
}

/** AppFrame::OnEdit — m_edit->GetEventHandler()->ProcessEvent(event) */
function onEdit(state: FrameState, eventPtr: Pointer): void
{
    lib.symbols.wxEvtHandler_ProcessEvent(state.edit.ctrl.ptr, eventPtr);
}

function onContextMenu(state: FrameState, eventPtr: Pointer): void
{
    const event = new wxContextMenuEvent(eventPtr);
    const xBuffer = new Int32Array(1);
    const yBuffer = new Int32Array(1);
    event.GetPosition(pointerOf(xBuffer), pointerOf(yBuffer));
    let x = xBuffer[0];
    let y = yBuffer[0];

    // If from keyboard
    if (x === -1 && y === -1)
    {
        const size = state.frame.GetSize();
        if (size)
        {
            x = Math.trunc(size.GetWidth() / 2);
            y = Math.trunc(size.GetHeight() / 2);
        }
    }
    else
    {
        const client = state.frame.ScreenToClient(x, y);
        if (client)
        {
            x = client.GetX();
            y = client.GetY();
        }
    }

    const menu = newMenu();
    if (!menu)
    {
        return;
    }
    menuItem(menu, ID_ABOUT, "&About");
    menuItem(menu, ID_EXIT, "E&xit");
    state.frame.PopupMenu(menu.ptr, x, y);
    lib.symbols.wxMenu_DeletePointer(menu.ptr);
}

// ---------------------------------------------------------------------------
// document map dialog (App::ShowDocumentMap)
// ---------------------------------------------------------------------------

let docMapSplitter: wxSplitterWindow | null = null;
let docMapDialog: wxDialog | null = null;
let docMapSizeCallback: Callback | null = null;

function showDocumentMap(parent: FrameState): void
{
    const width = parent.frame.FromDIP(800);
    const height = parent.frame.FromDIP(600);

    const dialog = withString("Editor with Document Map", (title) =>
        createWxDialog(
            parent.frame.ptr, ID_ANY, title, -1, -1, width, height,
            DEFAULT_DIALOG_STYLE | RESIZE_BORDER));
    if (!dialog)
    {
        return;
    }

    const splitter = createWxSplitterWindow(dialog.ptr, ID_ANY, -1, -1, -1, -1, SP_3D);
    if (!splitter)
    {
        dialog.Destroy();
        return;
    }

    const edit = createEdit(splitter.ptr, ID_ANY, editDefaultStyle());
    if (!edit)
    {
        dialog.Destroy();
        return;
    }
    editLoadFile(edit, sampleSourcePath());

    // Show line numbers in the margin, which are hidden by default.
    editToggleLineNumbers(edit);

    edit.ctrl.SetWrapMode(edit.ctrl.ptr, wxSTC_WRAP_WORD);
    edit.ctrl.SetWrapVisualFlags(wxSTC_WRAPVISUALFLAG_END);

    // bxStyledTextCtrlMiniMap(splitter, edit) — no binding exists, so the map
    // pane is a read-only StyledTextCtrl showing the same document.
    const map = withString("", (title) =>
        createWxStyledTextCtrl(splitter.ptr, ID_ANY, title, -1, -1, -1, -1, 0));
    if (!map)
    {
        dialog.Destroy();
        return;
    }
    const mapCtrl = wrapWxStyledTextCtrl(map);
    // The minimap mirrors the editor's document; the substitute shows a copy.
    const mapText = edit.ctrl.GetText(edit.ctrl.ptr);
    if (mapText)
    {
        mapCtrl.SetText(mapCtrl.ptr, mapText);
        lib.symbols.wxString_Delete(mapText);
    }
    mapCtrl.SetReadOnly(mapCtrl.ptr, true);

    // Create a marker to show that it is shown in the map as well.
    edit.ctrl.MarkerDefine(edit.ctrl.ptr, 3, wxSTC_MARK_ROUNDRECT, 255, 0, 0, 255, 0, 0);
    edit.ctrl.MarkerAdd(edit.ctrl.ptr, 111, 3);

    splitter.SplitVertically(edit.ctrl.ptr, mapCtrl.ptr, 0);
    splitter.SetMinimumPaneSize(dialog.FromDIP(10));

    docMapSplitter = splitter;
    docMapDialog = dialog;
    if (!docMapSizeCallback)
    {
        docMapSizeCallback = newCallback((_fun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            if (docMapSplitter && docMapDialog)
            {
                docMapSplitter.SetSashPosition(-docMapDialog.FromDIP(200), true);
            }
            new wxSizeEvent(eventPtr).Skip(true);
        });
    }
    bindClosure(dialog, ID_ANY, ID_ANY, EVT_SIZE, docMapSizeCallback, null);

    dialog.ShowModal();

    docMapSplitter = null;
    docMapDialog = null;
    releaseEdit(edit);
    dialog.Destroy();
}

// ---------------------------------------------------------------------------
// application
// ---------------------------------------------------------------------------

let frameMenuCallback: Callback | null = null;
let frameCloseCallback: Callback | null = null;
let frameContextCallback: Callback | null = null;
let appMenuCallback: Callback | null = null;

/** One dispatcher for the whole AppFrame event table. */
function dispatchFrameMenu(state: FrameState, eventPtr: Pointer): void
{
    const event = new wxCommandEvent(eventPtr);
    const id = event.GetId();

    switch (id)
    {
        case ID_OPEN: onFileOpen(state); break;
        case ID_SAVE: onFileSave(state); break;
        case ID_SAVEAS: onFileSaveAs(state); break;
        case ID_CLOSE: onFileClose(state); break;
        case myID.PROPERTIES: onProperties(state); break;
        case ID_PRINT_SETUP: onPrintSetup(state); break;
        case ID_PREVIEW: onPrintPreview(state); break;
        case ID_PRINT: onPrint(state); break;
        case ID_EXIT: onExit(state); break;

        // Menu items with standard IDs forwarded to the editor.
        case ID_CLEAR:
        case ID_CUT:
        case ID_COPY:
        case ID_PASTE:
        case ID_SELECTALL:
        case ID_REDO:
        case ID_UNDO:
        case ID_FIND:
            onEdit(state, eventPtr);
            break;

        case ID_ABOUT: onAbout(state); break;

        default:
            // EVT_MENU_RANGE(myID_EDIT_FIRST, myID_EDIT_LAST, OnEdit)
            if (id >= myID.EDIT_FIRST && id <= myID.EDIT_LAST)
            {
                onEdit(state, eventPtr);
                break;
            }
            event.Skip(true);
            return;
    }
}

function bindFrameEvents(state: FrameState): void
{
    if (!frameMenuCallback)
    {
        frameMenuCallback = newCallback((_fun, _data, eventPtr) =>
        {
            if (!eventPtr || !frameState)
            {
                return;
            }
            dispatchFrameMenu(frameState, eventPtr);
        });
    }
    bindClosure(state.frame, ID_LOWEST, ID_HIGHEST - 1, EVT_MENU, frameMenuCallback, null);
    bindClosure(state.frame, myID.PROPERTIES, myID.ABOUTTIMER, EVT_MENU, frameMenuCallback, null);

    if (!frameCloseCallback)
    {
        frameCloseCallback = newCallback((_fun, _data, eventPtr) =>
        {
            if (!eventPtr || !frameState)
            {
                return;
            }
            onClose(frameState, eventPtr);
        });
    }
    bindClosure(state.frame, ID_ANY, ID_ANY, EVT_CLOSE_WINDOW, frameCloseCallback, null);

    if (!frameContextCallback)
    {
        frameContextCallback = newCallback((_fun, _data, eventPtr) =>
        {
            if (!eventPtr || !frameState)
            {
                return;
            }
            onContextMenu(frameState, eventPtr);
        });
    }
    bindClosure(state.frame, ID_ANY, ID_ANY, EVT_CONTEXT_MENU, frameContextCallback, null);
}

/** App::OnMinimalEditor / App::OnDocumentMap, bound on the wxApp handler. */
function bindAppEvents(app: wxApp): void
{
    if (!appMenuCallback)
    {
        appMenuCallback = newCallback((_fun, _data, eventPtr) =>
        {
            if (!eventPtr)
            {
                return;
            }
            const event = new wxCommandEvent(eventPtr);
            switch (event.GetId())
            {
                case myID.WINDOW_MINIMAL:
                    createMinimalEditorFrame();
                    break;
                case myID.WINDOW_DOCMAP:
                    if (frameState)
                    {
                        showDocumentMap(frameState);
                    }
                    break;
                default:
                    event.Skip(true);
                    return;
            }
        });
    }
    bindClosure(app, myID.PROPERTIES, myID.ABOUTTIMER, EVT_MENU, appMenuCallback, null);
}

export function main(): number
{
    if (!initialize())
    {
        console.error("Failed to initialize wxWidgets");
        return 1;
    }

    initAllImageHandlers();

    // set application and vendor name
    setAppName(APP_NAME);
    setVendorName(APP_VENDOR);
    g_appname = `${APP_VENDOR}-${APP_NAME}`;

    // initialize print data and setup
    printData = createWxPrintData();
    if (printData)
    {
        // The C++ copies the id and size of wxThePrintPaperDatabase's A4
        // entry; the paper database itself is not bound, but SetPaperId()
        // makes wxWidgets resolve the same A4 entry.
        printData.SetPaperId(PAPER_A4);
        printData.SetOrientation(PORTRAIT);
    }
    pageSetupData = printData
        ? createWxPageSetupDialogDataFromData(printData.ptr)
        : createWxPageSetupDialogData();

    const state = createAppFrame(g_appname);
    if (!state)
    {
        console.error("stc: failed to create the main frame");
        closeCallbacks();
        shutdown();
        return 1;
    }
    frameState = state;

    bindFrameEvents(state);

    const app = wrapWxApp(wxGetApp());
    if (app)
    {
        bindAppEvents(app);
    }

    // m_frame->Layout(); m_frame->Show(true);
    state.frame.Layout();
    state.frame.Show();
    setTopWindow(state.frame.ptr);

    const exitCode = run();

    frameState = null;
    docMapSplitter = null;
    docMapDialog = null;

    // App::OnExit() deletes the global print data and page setup.
    if (pageSetupData)
    {
        pageSetupData.Delete();
        pageSetupData = null;
    }
    if (printData)
    {
        printData.Delete();
        printData = null;
    }

    closeCallbacks();
    shutdown();
    return exitCode;
}

exit(main());
