// calendar.kwxts — kwxTypeScript port of wxSamples/src/calendar/calendar.cpp.
//
// A faithful port of the wxCalendarCtrl sample: the frame, its full menu tree,
// the splitter with the calendar panel and the log text control, every event
// handler, and the two modal picker dialogs.
//
// Every feature of the C++ original is implemented: the native/generic
// calendar switch, calendar marking, the date range limits, the custom date
// attributes and both picker dialogs.
//
// Run from the repository root:
//   bin\Release\kwxts.exe samples\calendar\calendar.kwxts

declare const __dirname: string;

import {
    ALIGN_CENTER,
    ALL,
    BLUE,
    CAL_BORDER_ROUND,
    CAL_BORDER_SQUARE,
    CAL_HITTEST_DAY,
    CAL_HITTEST_DECMONTH,
    CAL_HITTEST_HEADER,
    CAL_HITTEST_INCMONTH,
    CAL_HITTEST_NOWHERE,
    CAL_HITTEST_SURROUNDING_WEEK,
    CAL_MONDAY_FIRST,
    CAL_SEQUENTIAL_MONTH_SELECTION,
    CAL_SHOW_HOLIDAYS,
    CAL_SHOW_SURROUNDING_WEEKS,
    CAL_SHOW_WEEK_NUMBERS,
    CAL_SUNDAY_FIRST,
    DEFAULT_FRAME_STYLE,
    DP_ALLOWNONE,
    DP_DEFAULT,
    DP_DROPDOWN,
    DP_SHOWCENTURY,
    EVT_CALENDAR_DOUBLECLICKED,
    EVT_CALENDAR_PAGE_CHANGED,
    EVT_CALENDAR_SEL_CHANGED,
    EVT_CALENDAR_WEEKDAY_CLICKED,
    EVT_CALENDAR_WEEK_CLICKED,
    EVT_CLOSE_WINDOW,
    EVT_MENU,
    EVT_RIGHT_DOWN,
    EVT_UPDATE_UI,
    EXPAND,
    GREEN,
    HORIZONTAL,
    ICON_INFORMATION,
    ID_ABOUT,
    ID_ANY,
    ID_CLEAR,
    ID_EXIT,
    LIGHT_GREY,
    Null_Colour,
    Null_Font,
    OK,
    RED,
    SIZE_AUTO,
    SP_NOBORDER,
    SYS_SCREEN_X,
    SYS_SCREEN_Y,
    TE_MULTILINE,
    TE_READONLY,
    TAB_TRAVERSAL,
    VERTICAL,
    createWxBoxSizer,
    createWxCalendarCtrl,
    createWxCalendarDateAttr,
    createWxClosure,
    createWxDateSpanFromMonths,
    createWxFrame,
    createWxGenericCalendarCtrl,
    createWxIconDefault,
    createWxLogTextCtrl,
    createWxMenu,
    createWxMenuBar,
    createWxPanel,
    createWxSplitterWindow,
    createWxStaticText,
    createWxString,
    createWxTextCtrl,
    exitMainLoop,
    initialize,
    run,
    setAppName,
    setTopWindow,
    shutdown,
    wrapWxBitmapBundle,
    wrapWxCalendarEvent,
    wrapWxCommandEvent,
    wrapWxMouseEvent,
    wrapWxUpdateUIEvent,
    wxBitmapBundle_FromSVGFile,
    wxDateTime_GetBeginDST,
    wxLog_SetActiveTarget,
    wxSystemSettings_GetMetric,
    wxUILocale_UseDefault,
} from "kwx";
