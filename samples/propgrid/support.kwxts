// support.kwxts — shared helpers for the wxPropertyGrid sample port.
//
// Contains the menu-id enumeration from propgrid.h, the wxString / native
// array helpers required by the kwxFFI calling conventions, wxVariant builders,
// property-tree navigation, and the logging/message-box wrappers.
//
// wxPropertyGridInterface is exposed as a mixin on wxPropertyGrid,
// wxPropertyGridManager and wxPropertyGridPage, so the interface methods
// (Insert, DeleteProperty, SetPropertyCell, SetPropertyReadOnly, ...) are
// called directly on those objects.

import {
    createWxArrayString,
    createWxString,
    createWxVariantFromArrayString,
    createWxVariantFromBool,
    createWxVariantFromDouble,
    createWxVariantFromLong,
    createWxVariantFromString,
    kwxMessageBox,
    LogDebug,
    LogError,
    LogMessage,
    LogVerbose,
    OK,
    readAndDeleteWxString,
    wxArrayString,
    wxGetTextFromUser,
    wxMenu,
    wxPGProperty,
    wxPropertyGrid,
    wxPropertyGridManager,
    wxPropertyGridPage,
    wxString,
    wxVariant,
} from "kwx";
import { Pointer, pointerOf, readCString } from "kwx/platform";

