export interface StyleInfo
{
    name: string;
    foreground: string;
    foregroundDark: string;
    fontname: string;
    fontsize: number;
    fontstyle: number;
    lettercase: number;
}

const styleInfo = (
    name: string, foreground: string, foregroundDark: string, fontstyle = 0,
): StyleInfo => ({
    name,
    foreground,
    foregroundDark,
    fontname: "",
    fontsize: 10,
    fontstyle,
    lettercase: 0,
});

