// books.kwxts — page factories and book-control wrapper for notebook.kwxts
//
// Helper module for the port of wxSamples/src/notebook/notebook.cpp.
//
// It mirrors the free functions of the C++ sample:
//   CreateUserCreatedPage(), CreateRadioButtonsPage(), CreateVetoPage(),
//   CreateFullPageText(), CreateInsertPage(), CreatePage(), GetIconIndex(),
//   CreateInitialPages() and MyFrame::CreateNewPage().
//
// The C++ sample stores the current book control in a wxBookCtrlBase* and
// switches on an enum to create/destroy the concrete class. Every generated
// book wrapper derives from wxBookCtrlBase, so the Book class below keeps the
// kind tag needed for the wxDynamicCast() checks of the original and forwards
// the handful of wxBookCtrlBase operations the sample needs. Behaviour and
// parameter order are unchanged.

import {
    ALL,
    createWxAuiNotebook,
    createWxBoxSizer,
    createWxButton,
    createWxChoicebook,
    createWxColourByName,
    createWxListbook,
    createWxNotebook,
    createWxPanel,
    createWxRadioBox,
    createWxSimplebook,
    createWxStaticText,
    createWxString,
    createWxTextCtrl,
    createWxToolbook,
    createWxTreebook,
    EXPAND,
    HORIZONTAL,
    ID_ANY,
    lib,
    RA_SPECIFY_COLS,
    RA_SPECIFY_ROWS,
    readAndDeleteWxString,
    TAB_TRAVERSAL,
    TE_MULTILINE,
    VERTICAL,
    wxAuiNotebook,
    wxBookCtrlBase,
    wxChoicebook,
    wxListbook,
    wxNotebook,
    wxSimplebook,
    wxSize,
    wxToolbook,
    wxTreebook,
} from "kwx";
import { Pointer, pointerOf } from "kwx/platform";

/* BookType enum of notebook.h — values are the offsets from ID_BOOK_NOTEBOOK. */
export const BOOK_NOTEBOOK = 0;
export const BOOK_LISTBOOK = 1;
export const BOOK_CHOICEBOOK = 2;
export const BOOK_TREEBOOK = 3;
export const BOOK_TOOLBOOK = 4;
export const BOOK_AUINOTEBOOK = 5;
export const BOOK_SIMPLEBOOK = 6;
export const BOOK_MAX = 7;

/* Page names (notebook.h). */
export const I_WAS_INSERTED_PAGE_NAME = "Inserted";
export const RADIOBUTTONS_PAGE_NAME = "Radio buttons";
export const VETO_PAGE_NAME = "Veto";
export const TEXT_PAGE_NAME = "Text";

/* Pages that can be added by the user. */
export const INSERTED_PAGE_NAME = "Inserted ";
export const ADDED_PAGE_NAME = "Added ";
export const ADDED_PAGE_NAME_BEFORE = " Inserted before ";
export const ADDED_SUB_PAGE_NAME = " Inserted sub-page ";

type BookImpl =
    | wxNotebook
    | wxListbook
    | wxChoicebook
    | wxTreebook
    | wxToolbook
    | wxAuiNotebook
    | wxSimplebook;

/** Call fn with a temporary wxString and release it on every path. */
function withString(text: string, fn: (ptr: Pointer) => void): void
{
    const value = createWxString(text);
    try
    {
        fn(value.ptr);
    }
    finally
    {
        value.Delete();
    }
}

/** wxWindow::FromDIP() — used for the wxSizerFlags default borders. */
export function fromDIP(window: Pointer, value: number): number
{
    if (!window)
    {
        return value;
    }
    return lib.symbols.wxWindow_FromDIP(window, value);
}

/** wxWindow::GetSize() of an arbitrary window pointer. */
export function windowSize(window: Pointer): { width: number; height: number }
{
    if (!window)
    {
        return { width: 0, height: 0 };
    }

    const sizePtr = lib.symbols.wxWindow_GetSize(window);
    if (!sizePtr)
    {
        return { width: 0, height: 0 };
    }

    const size = new wxSize(sizePtr);
    const result = { width: size.GetWidth(), height: size.GetHeight() };
    size.Delete();
    return result;
}

/**
 * wxBookCtrlBase operations used by the sample, forwarded to the concrete
 * wrapper created for the current book type.
 */
export class Book
{
    readonly kind: number;
    private readonly impl: BookImpl;

    constructor(kind: number, impl: BookImpl)
    {
        this.kind = kind;
        this.impl = impl;
    }

    get ptr(): Pointer
    {
        return this.impl.ptr;
    }

    hide(): void
    {
        this.impl.Hide();
    }

    /** wxBookCtrlBase::SetImages() — takes a wxBitmapBundleArray pointer. */
    setImages(images: Pointer): void
    {
        this.impl.SetImages(images);
    }

    /** wxBookCtrlBase::GetImageCount() */
    getImageCount(): number
    {
        return this.impl.GetImageCount();
    }

    addPage(page: Pointer, text: Pointer, select: boolean, imageId: number): void
    {
        this.impl.AddPage(page, text, select, imageId);
    }

    insertPage(
        index: number,
        page: Pointer,
        text: Pointer,
        select: boolean,
        imageId: number,
    ): void
    {
        if (this.kind === BOOK_NOTEBOOK)
        {
            (this.impl as wxNotebook).InsertPage(index, page, text, select, imageId);
        }
        else
        {
            (this.impl as wxBookCtrlBase).InsertPage(
                index, page, text, select, imageId,
            );
        }
    }

    /** wxTreebook::InsertSubPage() — caller must have checked the type. */
    insertSubPage(
        parent: number,
        page: Pointer,
        text: Pointer,
        select: boolean,
        imageId: number,
    ): void
    {
        (this.impl as wxTreebook).InsertSubPage(parent, page, text, select, imageId);
    }

    /** wxTreebook::GetPageParent() — caller must have checked the type. */
    getPageParent(index: number): number
    {
        return (this.impl as wxTreebook).GetPageParent(index);
    }

    getPageText(index: number): string
    {
        if (this.kind === BOOK_NOTEBOOK)
        {
            return readAndDeleteWxString(
                (this.impl as wxNotebook).GetPageText(index),
            );
        }
        return readAndDeleteWxString(
            (this.impl as wxBookCtrlBase).GetPageText(index),
        );
    }

    getPageCount(): number
    {
        if (this.kind === BOOK_NOTEBOOK)
        {
            return (this.impl as wxNotebook).GetPageCount();
        }
        return (this.impl as wxBookCtrlBase).GetPageCount();
    }

    getPage(index: number): Pointer
    {
        if (this.kind === BOOK_NOTEBOOK)
        {
            return (this.impl as wxNotebook).GetPage(index);
        }
        return (this.impl as wxBookCtrlBase).GetPage(index);
    }

    getSelection(): number
    {
        return this.impl.GetSelection();
    }

    setSelection(index: number): number
    {
        if (this.kind === BOOK_NOTEBOOK)
        {
            return (this.impl as wxNotebook).SetSelection(index);
        }
        return (this.impl as wxBookCtrlBase).SetSelection(index);
    }

    changeSelection(index: number): number
    {
        if (this.kind === BOOK_NOTEBOOK)
        {
            return (this.impl as wxNotebook).ChangeSelection(index);
        }
        return (this.impl as wxBookCtrlBase).ChangeSelection(index);
    }

    advanceSelection(forward = true): void
    {
        this.impl.AdvanceSelection(forward);
    }

    deletePage(index: number): boolean
    {
        if (this.kind === BOOK_NOTEBOOK)
        {
            return (this.impl as wxNotebook).DeletePage(index);
        }
        return (this.impl as wxBookCtrlBase).DeletePage(index);
    }

    setPageSize(width: number, height: number): void
    {
        this.impl.SetPageSize(width, height);
    }

    getSize(): { width: number; height: number }
    {
        return windowSize(this.ptr);
    }

    /** wxBookCtrlBase::HitTest(): returns the page and the hit flags. */
    hitTest(x: number, y: number): { page: number; flags: number }
    {
        // The native signature is `long* flags`: `long` is 8 bytes on the
        // 64-bit platforms kwx_ts supports, so the out-parameter buffer is
        // 8 bytes wide. ArrayBuffer is zero-initialized, which keeps the value
        // correct on Windows as well, where only the first 4 bytes are written.
        const flagsBuffer = new ArrayBuffer(8);
        const page = this.impl.HitTestPage(x, y, pointerOf(flagsBuffer));
        const flags = Number(new DataView(flagsBuffer).getBigInt64(0, true));
        return { page, flags };
    }

    /** `delete oldBook` — Detach() must have been called by the caller. */
    destroy(): void
    {
        this.impl.Delete();
    }
}

/** Creates the concrete book control for `kind` (DISPATCH_ON_TYPE macro). */
export function createBook(
    parent: Pointer,
    kind: number,
    style: number,
): Book | null
{
    let impl: BookImpl | null = null;

    switch (kind)
    {
        case BOOK_NOTEBOOK:
            impl = createWxNotebook(parent, ID_ANY, -1, -1, -1, -1, style);
            break;

        case BOOK_LISTBOOK:
            impl = createWxListbook(parent, ID_ANY, -1, -1, -1, -1, style);
            break;

        case BOOK_CHOICEBOOK:
            impl = createWxChoicebook(parent, ID_ANY, -1, -1, -1, -1, style);
            break;

        case BOOK_TREEBOOK:
            impl = createWxTreebook(parent, ID_ANY, -1, -1, -1, -1, style);
            break;

        case BOOK_TOOLBOOK:
            impl = createWxToolbook(parent, ID_ANY, -1, -1, -1, -1, style);
            break;

        case BOOK_AUINOTEBOOK:
            impl = createWxAuiNotebook(
                parent, ID_ANY, -1, -1, -1, -1, BigInt(style),
            );
            break;

        case BOOK_SIMPLEBOOK:
            impl = createWxSimplebook(parent, ID_ANY, -1, -1, -1, -1, style);
            break;

        default:
            console.error("notebook: unknown book control type");
            return null;
    }

    if (!impl)
    {
        return null;
    }

    return new Book(kind, impl);
}

/** wxPanel *CreateUserCreatedPage(wxBookCtrlBase *parent) */
function createUserCreatedPage(parent: Pointer): Pointer
{
    const panel = createWxPanel(parent, ID_ANY, -1, -1, -1, -1, TAB_TRAVERSAL);
    if (!panel)
    {
        return null;
    }

    withString("Panel with a Button", (text) => panel.SetHelpText(text));

    // new wxButton(panel, wxID_ANY, "Button", wxPoint(10, 10), wxDefaultSize)
    withString("Button", (label) =>
    {
        createWxButton(panel.ptr, ID_ANY, label, 10, 10, -1, -1, 0);
    });

    return panel.ptr;
}

/** wxPanel *CreateRadioButtonsPage(wxBookCtrlBase *parent) */
function createRadioButtonsPage(parent: Pointer): Pointer
{
    const panel = createWxPanel(parent, ID_ANY, -1, -1, -1, -1, TAB_TRAVERSAL);
    if (!panel)
    {
        return null;
    }

    withString("Panel with some Radio Buttons", (text) => panel.SetHelpText(text));

    const animals =
        ["Fox", "Hare", "Rabbit", "Sabre-toothed tiger", "T Rex"];
    const computers =
        ["Amiga", "Commodore 64", "PET", "Another"];

    const radiobox1 = createRadioBox(
        panel.ptr, "Choose one", animals, 2, RA_SPECIFY_ROWS,
    );
    const radiobox2 = createRadioBox(
        panel.ptr, "Choose your favourite", computers, 0, RA_SPECIFY_COLS,
    );

    const sizerPanel = createWxBoxSizer(VERTICAL);
    if (sizerPanel && radiobox1 && radiobox2)
    {
        // wxSizerFlags(2).Expand() / wxSizerFlags(1).Expand()
        sizerPanel.AddWindow(radiobox1, 2, EXPAND, 0, null);
        sizerPanel.AddWindow(radiobox2, 1, EXPAND, 0, null);
        panel.SetSizer(sizerPanel.ptr, true);
    }

    return panel.ptr;
}

/**
 * wxRadioBox creation with a wxString caption; returns the window pointer.
 *
 * kwxFFI's wxRadioBox_Create takes a `char**` choice array (see
 * build/_deps/kwx_ffi/src/wx_radiobox.cpp), so the strings are encoded as
 * NUL-terminated UTF-8 buffers and an array of their addresses is passed. Both
 * the buffers and the address array stay reachable until the native call has
 * copied them into the control.
 */
function createRadioBox(
    parent: Pointer,
    caption: string,
    choices: string[],
    dimension: number,
    style: number,
): Pointer
{
    const buffers: Uint8Array[] = [];
    const pointers = new BigUint64Array(choices.length);

    for (let i = 0; i < choices.length; i++)
    {
        const bytes = new TextEncoder().encode(choices[i] + "\0");
        buffers.push(bytes);
        const address = pointerOf(bytes);
        pointers[i] = address === null ? 0n : address;
    }

    const choicesPtr = pointerOf(pointers);

    let result: Pointer = null;
    withString(caption, (text) =>
    {
        const box = createWxRadioBox(
            parent, ID_ANY, text, -1, -1, -1, -1,
            choices.length, choicesPtr, dimension, style,
        );
        result = box ? box.ptr : null;
    });

    // Keep the native buffers alive until the constructor returns.
    void buffers;
    return result;
}

/** wxPanel *CreateVetoPage(wxBookCtrlBase *parent) */
function createVetoPage(parent: Pointer): Pointer
{
    const panel = createWxPanel(parent, ID_ANY, -1, -1, -1, -1, TAB_TRAVERSAL);
    if (!panel)
    {
        return null;
    }

    withString("An empty panel", (text) => panel.SetHelpText(text));

    const sizer = createWxBoxSizer(VERTICAL);
    if (sizer)
    {
        // wxSizerFlags().Expand().DoubleBorder()
        withString("This page intentionally left blank", (label) =>
        {
            const text = createWxStaticText(
                panel.ptr, ID_ANY, label, -1, -1, -1, -1, 0,
            );
            if (text)
            {
                sizer.AddWindow(
                    text.ptr, 0, EXPAND | ALL, fromDIP(panel.ptr, 10), null,
                );
            }
        });
        panel.SetSizer(sizer.ptr, true);
    }

    return panel.ptr;
}

/** wxWindow *CreateFullPageText(wxBookCtrlBase *parent) */
function createFullPageText(parent: Pointer): Pointer
{
    let result: Pointer = null;
    withString("Full page text", (label) =>
    {
        // new wxTextCtrl(parent, wxID_ANY, "Full page text", ..., wxTE_MULTILINE)
        const text = createWxTextCtrl(
            parent, ID_ANY, label, -1, -1, -1, -1, BigInt(TE_MULTILINE),
        );
        if (text)
        {
            withString(
                "Page consisting of just a text control",
                (help) => text.SetHelpText(help),
            );
            result = text.ptr;
        }
    });
    return result;
}

/** wxPanel *CreateInsertPage(wxBookCtrlBase *parent) */
function createInsertPage(parent: Pointer): Pointer
{
    const panel = createWxPanel(parent, ID_ANY, -1, -1, -1, -1, TAB_TRAVERSAL);
    if (!panel)
    {
        return null;
    }

    withString("Maroon panel", (text) => panel.SetHelpText(text));

    // panel->SetBackgroundColour(wxColour("MAROON"))
    withString("MAROON", (name) =>
    {
        const colour = createWxColourByName(name);
        if (colour)
        {
            panel.SetBackgroundColour(colour.ptr);
            colour.Delete();
        }
    });

    const sizer = createWxBoxSizer(VERTICAL);
    if (sizer)
    {
        withString("This page has been inserted, not added.", (label) =>
        {
            const text = createWxStaticText(
                panel.ptr, ID_ANY, label, -1, -1, -1, -1, 0,
            );
            if (text)
            {
                sizer.AddWindow(
                    text.ptr, 0, EXPAND | ALL, fromDIP(panel.ptr, 10), null,
                );
            }
        });
        panel.SetSizer(sizer.ptr, true);
    }

    return panel.ptr;
}

/** int GetIconIndex(wxBookCtrlBase* bookCtrl) */
export function getIconIndex(book: Book): number
{
    const nImages = book.getImageCount();
    if (nImages > 0)
    {
        return book.getPageCount() % nImages;
    }
    return -1;
}

/** wxWindow *CreatePage(wxBookCtrlBase *parent, const wxString& pageName) */
export function createPage(book: Book, pageName: string): Pointer
{
    if (pageName.includes(INSERTED_PAGE_NAME) ||
            pageName.includes(ADDED_PAGE_NAME) ||
                pageName.includes(ADDED_SUB_PAGE_NAME) ||
                    pageName.includes(ADDED_PAGE_NAME_BEFORE))
    {
        return createUserCreatedPage(book.ptr);
    }

    if (pageName === I_WAS_INSERTED_PAGE_NAME)
    {
        return createInsertPage(book.ptr);
    }

    if (pageName === VETO_PAGE_NAME)
    {
        return createVetoPage(book.ptr);
    }

    if (pageName === RADIOBUTTONS_PAGE_NAME)
    {
        return createRadioButtonsPage(book.ptr);
    }

    if (pageName === TEXT_PAGE_NAME)
    {
        return createFullPageText(book.ptr);
    }

    console.error("notebook: unknown page name \"" + pageName + "\"");
    return null;
}

/** Adds a page and releases the temporary wxString used for its label. */
export function addPageWithLabel(
    book: Book,
    page: Pointer,
    label: string,
    select: boolean,
): void
{
    const text = createWxString(label);
    try
    {
        book.addPage(page, text.ptr, select, getIconIndex(book));
    }
    finally
    {
        text.Delete();
    }
}

/** Inserts a page and releases the temporary wxString used for its label. */
export function insertPageWithLabel(
    book: Book,
    index: number,
    page: Pointer,
    label: string,
    select: boolean,
): void
{
    const text = createWxString(label);
    try
    {
        book.insertPage(index, page, text.ptr, select, getIconIndex(book));
    }
    finally
    {
        text.Delete();
    }
}

/** wxTreebook::InsertSubPage() with a temporary wxString label. */
export function insertSubPageWithLabel(
    book: Book,
    parent: number,
    page: Pointer,
    label: string,
    select: boolean,
): void
{
    const text = createWxString(label);
    try
    {
        book.insertSubPage(parent, page, text.ptr, select, getIconIndex(book));
    }
    finally
    {
        text.Delete();
    }
}

/** void CreateInitialPages(wxBookCtrlBase *parent) */
export function createInitialPages(book: Book): void
{
    const radioButtons = createRadioButtonsPage(book.ptr);
    if (radioButtons)
    {
        addPageWithLabel(book, radioButtons, RADIOBUTTONS_PAGE_NAME, false);
    }

    const veto = createVetoPage(book.ptr);
    if (veto)
    {
        addPageWithLabel(book, veto, VETO_PAGE_NAME, false);
    }

    const text = createFullPageText(book.ptr);
    if (text)
    {
        addPageWithLabel(book, text, TEXT_PAGE_NAME, false);
    }

    const inserted = createInsertPage(book.ptr);
    if (inserted)
    {
        insertPageWithLabel(book, 0, inserted, I_WAS_INSERTED_PAGE_NAME, false);
    }

    book.setSelection(1);
}

/** MyFrame::CreateNewPage() — panel with "First"/"Second" buttons. */
export function createNewPage(book: Book): Pointer
{
    const panel = createWxPanel(
        book.ptr, ID_ANY, -1, -1, -1, -1, TAB_TRAVERSAL,
    );
    if (!panel)
    {
        return null;
    }

    withString(
        "Panel with \"First\" and \"Second\" buttons",
        (text) => panel.SetHelpText(text),
    );

    const sizer = createWxBoxSizer(HORIZONTAL);
    if (!sizer)
    {
        return panel.ptr;
    }
    panel.SetSizer(sizer.ptr, true);

    const border = fromDIP(panel.ptr, 5);

    withString("First button", (label) =>
    {
        const button = createWxButton(
            panel.ptr, ID_ANY, label, -1, -1, -1, -1, 0,
        );
        if (button)
        {
            sizer.AddWindow(button.ptr, 0, ALL, border, null);
        }
    });

    withString("Second button", (label) =>
    {
        const button = createWxButton(
            panel.ptr, ID_ANY, label, -1, -1, -1, -1, 0,
        );
        if (button)
        {
            sizer.AddWindow(button.ptr, 0, ALL, border, null);
        }
    });

    return panel.ptr;
}

/** wxPanel *CreateUserCreatedPage() for the "Insert page" menu command. */
export function createUserPage(book: Book): Pointer
{
    return createUserCreatedPage(book.ptr);
}
