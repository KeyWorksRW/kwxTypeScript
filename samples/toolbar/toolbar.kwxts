    EVT_UPDATE_UI,
    EXPAND,
    ID_ABOUT,
    ID_ANY,
    ID_COPY,
    ID_CUT,
    ID_EXIT,
    ID_HELP,
    ID_HIGHEST,
    ID_NEW,
    ID_OPEN,
    ID_PASTE,
    ID_PRINT,
    ID_SAVE,
    IMAGE_QUALITY_HIGH,
    ITEM_DROPDOWN,
    ITEM_NORMAL,
    LogStatusWindow,
    MB_DOCKABLE,
    Null_Bitmap,
    OK,
    PENSTYLE_SOLID,
    RED,
    SIZE_AUTO,
    STB_DEFAULT_STYLE,
    TAB_TRAVERSAL,
    TB_BOTTOM,
    TB_DOCKABLE,
    TB_FLAT,
    TB_HORIZONTAL,
    TB_HORZ_LAYOUT,
    TB_HORZ_TEXT,
    TB_LEFT,
    TB_NOICONS,
    TB_NO_TOOLTIPS,
    TB_RIGHT,
    TB_TEXT,
    TB_TOP,
    TB_VERTICAL,
    TE_MULTILINE,
    TE_READONLY,
    VERTICAL,
    createWxBitmapEmpty,
    createWxBitmapFromImage,
    createWxBoxSizer,
    createWxClosure,
    createWxColourEmpty,
    createWxComboBox,
    createWxFontFromInfo,
    createWxFontInfo,
    createWxFrame,
    createWxIconDefault,
    createWxImageFromFile,
    createWxMemoryDCWithBitmap,
    createWxMenu,
    createWxMenuBar,
    createWxPanel,
    createWxPenFromColour,
    createWxPNGHandler,
    createWxSearchCtrl,
    createWxString,
    createWxTextCtrl,
    createWxToolBar,
    exitMainLoop,
    initialize,
    kwxMessageBox,
    lib,
    readAndDeleteWxString,
    run,
    setAppName,
    setTopWindow,
    shutdown,
    wxBitmap,
    wxBitmapBundle,
    wxBitmapBundle_FromSVGFile,
    wxClosure,
    wxCommandEvent,
    wxFrame,
    wxGetColourFromUserEx,
    wxImage_AddHandler,
    wxLoadFileSelector,
    wxMenu,
    wxPanel,
    wxSearchCtrl,
    wxSizeEvent,
    wxTextCtrl,
    wxToolBar,
    wxUpdateUIEvent,
} from "kwx";
import { Callback, exit, Pointer } from "kwx/platform";

// ---------------------------------------------------------------------------
// constants (toolbar.cpp)
// ---------------------------------------------------------------------------

/** const int ID_TOOLBAR = wxID_HIGHEST; */
const ID_TOOLBAR = ID_HIGHEST;

/** static const long TOOLBAR_STYLE = wxTB_FLAT | wxTB_DOCKABLE | wxTB_TEXT; */
const TOOLBAR_STYLE = TB_FLAT | TB_DOCKABLE | TB_TEXT;

/** enum Positions { TOOLBAR_LEFT, TOOLBAR_TOP, TOOLBAR_RIGHT, TOOLBAR_BOTTOM } */
const TOOLBAR_LEFT = 0;
const TOOLBAR_TOP = 1;
const TOOLBAR_RIGHT = 2;
const TOOLBAR_BOTTOM = 3;

/** The enum of ids following IDM_TOOLBAR_TOGGLE_TOOLBAR = 200. */
const IDM_TOOLBAR_TOGGLE_TOOLBAR = 200;
const IDM_TOOLBAR_TOGGLE_HORIZONTAL_TEXT = 201;
const IDM_TOOLBAR_TOGGLE_ANOTHER_TOOLBAR = 202;
const IDM_TOOLBAR_TOGGLETOOLBARSIZE = 203;
const IDM_TOOLBAR_TOGGLETOOLTIPS = 204;
const IDM_TOOLBAR_TOGGLECUSTOMDISABLED = 205;
const IDM_TOOLBAR_CUSTOM_PATH = 206;
const IDM_TOOLBAR_TOP_ORIENTATION = 207;
const IDM_TOOLBAR_LEFT_ORIENTATION = 208;
const IDM_TOOLBAR_BOTTOM_ORIENTATION = 209;
const IDM_TOOLBAR_RIGHT_ORIENTATION = 210;
const IDM_TOOLBAR_OTHER_1 = 211;
const IDM_TOOLBAR_OTHER_2 = 212;
const IDM_TOOLBAR_OTHER_3 = 213;
const IDM_TOOLBAR_OTHER_4 = 214;
const IDM_FIRST_NEEDS_TOOLBAR = 215;
const IDM_TOOLBAR_TOGGLETOOLBARROWS = 216;
const IDM_TOOLBAR_SHOW_TEXT = 217;
const IDM_TOOLBAR_SHOW_ICONS = 218;
const IDM_TOOLBAR_SHOW_BOTH = 219;
const IDM_TOOLBAR_BG_COL = 220;
const IDM_TOOLBAR_ENABLEPRINT = 221;
const IDM_TOOLBAR_DELETEPRINT = 222;
const IDM_TOOLBAR_INSERTPRINT = 223;
const IDM_TOOLBAR_TOGGLEHELP = 224;
const IDM_TOOLBAR_TOGGLESEARCH = 225;
const IDM_TOOLBAR_CHANGE_TOOLTIP = 226;
const IDM_TOOLBAR_INC_TOOL_SPACING = 227;
const IDM_TOOLBAR_DEC_TOOL_SPACING = 228;
const IDM_LAST_NEEDS_TOOLBAR = 229;
const IDM_TOOLBAR_TOGGLERADIOBTN1 = 230;
const IDM_TOOLBAR_TOGGLERADIOBTN2 = 231;
const IDM_TOOLBAR_TOGGLERADIOBTN3 = 232;

const ID_COMBO = 1000;

/** MyFrame::PopulateToolbar()'s local Tool_* enum order. */
const TOOL_BITMAP_NAMES = [
    "new.svg",
    "open.svg",
    "save.svg",
    "copy.svg",
    "cut.svg",
    "paste.svg",
    "print.svg",
    "help.svg",
];

// ---------------------------------------------------------------------------
// helpers
// ---------------------------------------------------------------------------

/** Absolute path of an asset shipped next to this module. */
function assetPath(name: string): string
{
    return __dirname.replace(/\\/g, "/") + "/" + name;
}

/** A one-shot wxString whose lifetime is limited to `fn`. */
function withString<T>(text: string, fn: (ptr: Pointer) => T): T
{
    const value = createWxString(text);
    try
    {
        return fn(value.ptr);
    }
    finally
    {
        value.Delete();
    }
}

/** wxBitmapBundle::FromSVGFile(name, width, height) — result is owned. */
function loadSvgBundle(name: string, width: number, height: number): wxBitmapBundle | null
{
    let raw: Pointer = null;
    withString(assetPath(name), (path) =>
    {
        raw = wxBitmapBundle_FromSVGFile(path, width, height);
    });
    if (!raw)
    {
        return null;
    }
    return new wxBitmapBundle(raw);
}

/** SetIcon(wxICON(sample)) from ../sample.xpm converted to sample.svg. */
function setFrameIcon(frame: wxFrame): void
{
    const bundle = loadSvgBundle("sample.svg", 32, 32);
    if (!bundle)
    {
        return;
    }

    const bitmap = bundle.GetBitmap(32, 32);
    if (bitmap)
    {
        const icon = createWxIconDefault();
        if (icon)
        {
            icon.CopyFromBitmap(bitmap.ptr);
            frame.SetIcon(icon.ptr);
            icon.Delete();
        }
        bitmap.Delete();
    }
    bundle.Delete();
}

// ---------------------------------------------------------------------------
// state
// ---------------------------------------------------------------------------

interface FrameState
{
    readonly frame: wxFrame;
    /** Toolbar art, loaded once from the sample's vector SVG files. */
    readonly icons: Map<string, wxBitmapBundle>;
    readonly callbacks: Callback[];
    readonly closures: wxClosure[];

    panel: wxPanel | null;
    textWindow: wxTextCtrl | null;

    /** MyFrame members. */
    smallToolbar: boolean;
    horzText: boolean;
    useCustomDisabled: boolean;
    showTooltips: boolean;
    rows: number;
    nPrint: number;
    toolbarPosition: number;
    pathBmp: string;
    searchCtrl: wxSearchCtrl | null;
    searchAttached: boolean;
    /** m_tbar — the extra vertical toolbar, null until toggled on. */
    mbar: wxToolBar | null;
}

function appendText(state: FrameState, text: string): void
{
    if (!state.textWindow)
    {
        return;
    }
    withString(text, (value) => state.textWindow!.AppendText(value));
}

function currentToolBar(state: FrameState): wxToolBar | null
{
    return state.frame.GetToolBar();
}

// ---------------------------------------------------------------------------
// MyFrame::LayoutChildren()
// ---------------------------------------------------------------------------

function layoutChildren(state: FrameState): void
{
    const client = state.frame.GetClientSize();
    if (!client)
    {
        return;
    }

    const height = client.GetHeight();
    let offset = 0;

    if (state.mbar)
    {
        state.mbar.SetSize(0, 0, -1, height, SIZE_AUTO);
        const size = state.mbar.GetSize();
        offset = size ? size.GetWidth() : 0;
    }

    if (state.panel)
    {
        state.panel.SetSize(offset, 0, client.GetWidth() - offset, height, SIZE_AUTO);
    }
}

// ---------------------------------------------------------------------------
// MyFrame::PopulateToolbar()
// ---------------------------------------------------------------------------

function populateToolbar(state: FrameState, toolBar: wxToolBar): void
{
    // Size of the bitmaps we use by default: the bundle's default 16x16 DIP
    // size, doubled for the large toolbar (toolBarBitmaps[...] * (small ? 1 : 2)).
    const sizeBitmap = state.smallToolbar ? 16 : 32;
    const bitmapSize = state.frame.FromDIP(sizeBitmap);

    // Bitmaps and bundles created for this call are released after Realize():
    // wxToolBar copies the bitmap into each tool.
    const bitmaps: wxBitmap[] = [];
    const tempBundles: wxBitmapBundle[] = [];

    const bitmapOf = (bundle: wxBitmapBundle): Pointer =>
    {
        const bitmap = bundle.GetBitmap(bitmapSize, bitmapSize);
        if (!bitmap)
        {
            return Null_Bitmap();
        }
        bitmaps.push(bitmap);
        return bitmap.ptr;
    };

    const icon = (name: string): Pointer =>
    {
        const bundle = state.icons.get(name);
        return bundle ? bitmapOf(bundle) : Null_Bitmap();
    };

    // toolBar->SetToolBitmapSize(FromDIP(sizeBitmap));
    toolBar.SetToolBitmapSize(bitmapSize, bitmapSize);

    // wxBitmapBundle::FromSVG(svg_data, sizeBitmap) for the "About" tool.
    const aboutBundle = loadSvgBundle("about.svg", sizeBitmap, sizeBitmap);
    if (aboutBundle)
    {
        tempBundles.push(aboutBundle);
    }
    const aboutBitmap = aboutBundle ? bitmapOf(aboutBundle) : Null_Bitmap();

    // ---- New (drop-down tool) --------------------------------------------
    // toolBar->AddTool(wxID_NEW, "New", bitmap, wxNullBitmap, wxITEM_DROPDOWN,
    //                  "New file", "This is help for new file tool");
    const newBundle = state.icons.get("new.svg");
    if (newBundle)
    {
        withString("New", (label) =>
        {
            withString("New file", (shortHelp) =>
            {
                withString("This is help for new file tool", (longHelp) =>
                {
                    lib.symbols.wxToolBarBase_AddTool(
                        toolBar.ptr, ID_NEW, label, newBundle.ptr, newBundle.ptr,
                        ITEM_DROPDOWN, shortHelp, longHelp, null);
                });
            });
        });
    }

    // wxMenu* menu = new wxMenu; ... toolBar->SetDropdownMenu(wxID_NEW, menu);
    const dropdown = newMenu();
    if (dropdown)
    {
        appendMenuItem(dropdown, ID_ANY, "&First dummy item", "");
        appendMenuItem(dropdown, ID_ANY, "&Second dummy item", "");
        dropdown.AppendSeparator();
        appendMenuItem(dropdown, ID_EXIT, "Exit", "");
        toolBar.SetDropdownMenu(ID_NEW, dropdown.ptr);
    }

    // ---- Open -------------------------------------------------------------
    withString("Open", (label) =>
    {
        withString("Open file", (shortHelp) =>
        {
            withString("This is help for open file tool", (longHelp) =>
            {
                toolBar.AddTool(ID_OPEN, label, icon("open.svg"), Null_Bitmap(),
                                ITEM_NORMAL, shortHelp, longHelp, null);
            });
        });
    });

    // ---- Controls in toolbar (combo) --------------------------------------
    if (!toolBar.IsVertical())
    {
        const combo = withString("", (value) =>
            createWxComboBox(toolBar.ptr, ID_COMBO, value,
                             -1, -1, state.frame.FromDIP(100), -1, 0, null, 0));
        if (combo)
        {
            for (const item of [
                "This",
                "is a",
                "combobox with extremely, extremely, extremely, extremely long label",
                "in a",
                "toolbar",
            ])
            {
                withString(item, (value) => combo.Append(value));
            }
            withString("Combo Label", (label) => toolBar.AddControl(combo.ptr, label));
        }
    }

    // ---- Save / separator / Copy / Cut / Paste -----------------------------
    withString("Save", (label) =>
    {
        withString("Toggle button 1", (shortHelp) =>
        {
            toolBar.AddCheckTool(ID_SAVE, label, icon("save.svg"),
                                 Null_Bitmap(), shortHelp, null);
        });
    });

    toolBar.AddSeparator();

    withString("Copy", (label) =>
    {
        withString("Toggle button 2", (shortHelp) =>
        {
            toolBar.AddCheckTool(ID_COPY, label, icon("copy.svg"),
                                 Null_Bitmap(), shortHelp, null);
        });
    });

    withString("Cut", (label) =>
    {
        withString("Toggle/Untoggle help button", (shortHelp) =>
        {
            withString("", (longHelp) =>
            {
                toolBar.AddTool(ID_CUT, label, icon("cut.svg"), Null_Bitmap(),
                                ITEM_NORMAL, shortHelp, longHelp, null);
            });
        });
    });

    withString("Paste", (label) =>
    {
        withString("Paste", (shortHelp) =>
        {
            withString("", (longHelp) =>
            {
                toolBar.AddTool(ID_PASTE, label, icon("paste.svg"), Null_Bitmap(),
                                ITEM_NORMAL, shortHelp, longHelp, null);
            });
        });
    });

    toolBar.AddSeparator();

    // ---- Print (optionally with a custom disabled image) -------------------
    if (state.useCustomDisabled)
    {
        const disabled = createWxBitmapEmpty(sizeBitmap, sizeBitmap, -1);
        const printBundle = state.icons.get("print.svg");
        if (disabled && printBundle)
        {
            const dc = createWxMemoryDCWithBitmap(disabled.ptr);
            if (dc)
            {
                const normal = printBundle.GetBitmap(sizeBitmap, sizeBitmap);
                if (normal)
                {
                    dc.DrawBitmap(normal.ptr, 0, 0, false);
                    normal.Delete();
                }
                const pen = createWxPenFromColour(RED, 5, PENSTYLE_SOLID);
                if (pen)
                {
                    dc.SetPen(pen.ptr);
                    dc.DrawLine(0, 0, sizeBitmap, sizeBitmap);
                    pen.Delete();
                }
                dc.Delete();
            }
            bitmaps.push(disabled);

            withString("Print", (label) =>
            {
                withString("", (shortHelp) =>
                {
                    withString("", (longHelp) =>
                    {
                        toolBar.AddTool(ID_PRINT, label, icon("print.svg"),
                                        disabled.ptr, ITEM_NORMAL, shortHelp,
                                        longHelp, null);
                    });
                });
            });
        }
    }
    else
    {
        withString("Print", (label) =>
        {
            withString("Delete this tool. This is a very long tooltip to test " +
                       "whether it does the right thing when the tooltip is more " +
                       "than Windows can cope with.", (shortHelp) =>
            {
                withString("", (longHelp) =>
                {
                    toolBar.AddTool(ID_PRINT, label, icon("print.svg"),
                                    Null_Bitmap(), ITEM_NORMAL, shortHelp,
                                    longHelp, null);
                });
            });
        });
    }

    state.nPrint = 1;

    // ---- stretchable space + Help + About ---------------------------------
    // add a stretchable space before the "Help" button to make it right-aligned
    toolBar.AddStretchableSpace();

    withString("Help", (label) =>
    {
        withString("Help button", (shortHelp) =>
        {
            toolBar.AddCheckTool(ID_HELP, label, icon("help.svg"),
                                 Null_Bitmap(), shortHelp, null);
        });
    });

    withString("About", (label) =>
    {
        withString("About", (shortHelp) =>
        {
            withString("", (longHelp) =>
            {
                toolBar.AddTool(ID_ABOUT, label, aboutBitmap, Null_Bitmap(),
                                ITEM_NORMAL, shortHelp, longHelp, null);
            });
        });
    });

    // ---- optional "Custom" tool built from the user chosen image ----------
    if (state.pathBmp !== "")
    {
        addCustomTool(state, toolBar);
    }

    // after adding the buttons to the toolbar, must call Realize()
    toolBar.Realize();

    const count = Number(toolBar.GetToolsCount());
    toolBar.SetRows(toolBar.IsVertical()
        ? Math.floor(count / state.rows)
        : state.rows);

    for (const bitmap of bitmaps)
    {
        bitmap.Delete();
    }
    for (const bundle of tempBundles)
    {
        bundle.Delete();
    }
}

/**
 * The MyCustomBitmapBundleImpl artwork: the chosen image rescaled to the tool
 * bitmap size with its pixel height painted in red over it. Adds nothing (like
 * the C++ code) when the image cannot be loaded.
 */
function addCustomTool(state: FrameState, toolBar: wxToolBar): void
{
    const image = withString(state.pathBmp, (path) => createWxImageFromFile(path));
    if (!image || !image.IsOk())
    {
        return;
    }

    const sizeBitmap = state.smallToolbar ? 16 : 32;
    const pixels = state.frame.FromDIP(sizeBitmap);

    if (image.GetWidth() !== pixels || image.GetHeight() !== pixels)
    {
        image.RescaleEx(pixels, pixels, IMAGE_QUALITY_HIGH);
    }
    if (image.HasAlpha())
    {
        image.ClearAlpha();
    }

    const bitmap = createWxBitmapFromImage(image.ptr, -1);
    image.Delete();
    if (!bitmap)
    {
        return;
    }

    const dc = createWxMemoryDCWithBitmap(bitmap.ptr);
    if (dc)
    {
        dc.SetTextForeground(RED);
        // wxFontInfo(wxSize(size.x/4, size.y/2)).Bold() — the pixel-size
        // wxFontInfo ctor is not bound, so an equivalent point size is used.
        const pointSize = Math.max(1, Math.round((pixels / 2) * 72 / 96));
        const info = createWxFontInfo(pointSize);
        if (info)
        {
            info.SetBold(true);
            const font = createWxFontFromInfo(info.ptr);
            if (font)
            {
                dc.SetFont(font.ptr);
                font.Delete();
            }
            info.Delete();
        }
        withString(String(pixels), (text) =>
            dc.DrawText(text, Math.floor(pixels / 4), Math.floor(pixels / 4)));
        dc.Delete();
    }

    toolBar.AddSeparator();
    withString("Custom", (label) =>
    {
        withString("", (shortHelp) =>
        {
            withString("", (longHelp) =>
            {
                toolBar.AddTool(ID_ANY, label, bitmap.ptr, Null_Bitmap(),
                                ITEM_NORMAL, shortHelp, longHelp, null);
            });
        });
    });
    bitmap.Delete();
}

// ---------------------------------------------------------------------------
// MyFrame::RecreateToolbar()
// ---------------------------------------------------------------------------

function recreateToolbar(state: FrameState): void
{
    // delete and recreate the toolbar
    const oldToolBar = currentToolBar(state);
    let style = oldToolBar ? Number(oldToolBar.GetWindowStyle()) : TOOLBAR_STYLE;

    if (oldToolBar && state.searchCtrl && !state.searchAttached)
    {
        // see ~MyFrame(): attach the detached tool so that it is deleted with
        // the old toolbar.
        withString("", (label) => oldToolBar.AddControl(state.searchCtrl!.ptr, label));
    }
    state.searchCtrl = null;
    state.searchAttached = false;

    if (oldToolBar)
    {
        // delete toolBar; the wrapper is borrowed from the frame, so the
        // natively owning entry point is used directly.
        lib.symbols.wxToolBar_Delete(oldToolBar.ptr);
    }

    state.frame.SetToolBar(null);

    style &= ~(TB_HORIZONTAL | TB_VERTICAL | TB_BOTTOM | TB_RIGHT | TB_HORZ_LAYOUT);
    switch (state.toolbarPosition)
    {
        case TOOLBAR_LEFT:
            style |= TB_LEFT;
            break;
        case TOOLBAR_TOP:
            style |= TB_TOP;
            break;
        case TOOLBAR_RIGHT:
            style |= TB_RIGHT;
            break;
        case TOOLBAR_BOTTOM:
            style |= TB_BOTTOM;
            break;
    }

    if (state.showTooltips)
    {
        style &= ~TB_NO_TOOLTIPS;
    }
    else
    {
        style |= TB_NO_TOOLTIPS;
    }

    if ((style & TB_TEXT) && !(style & TB_NOICONS) && state.horzText)
    {
        style |= TB_HORZ_LAYOUT;
    }

    const toolBar = state.frame.CreateToolBar(BigInt(style), ID_TOOLBAR);
    if (!toolBar)
    {
        return;
    }

    populateToolbar(state, toolBar);
}

// ---------------------------------------------------------------------------
// menu helpers
// ---------------------------------------------------------------------------

function newMenu(): wxMenu | null
{
    let menu: wxMenu | null = null;
    withString("", (title) => { menu = createWxMenu(title, 0n); });
    return menu;
}

function appendMenuItem(menu: wxMenu, id: number, label: string, help: string): void
{
    withString(label, (text) =>
    {
        withString(help, (helpText) => menu.Append(id, text, helpText, false));
    });
}

function appendCheckItem(menu: wxMenu, id: number, label: string, help: string): void
{
    withString(label, (text) =>
    {
        withString(help, (helpText) => menu.AppendCheckItem(id, text, helpText));
    });
}

function appendRadioItem(menu: wxMenu, id: number, label: string, help: string): void
{
    withString(label, (text) =>
    {
        withString(help, (helpText) => menu.AppendRadioItem(id, text, helpText));
    });
}

// ---------------------------------------------------------------------------
// MyFrame constructor
// ---------------------------------------------------------------------------

function createToolbarFrame(): FrameState | null
{
    const title = createWxString("wxToolBar Sample");
    const frame = createWxFrame(null, ID_ANY, title.ptr, -1, -1, -1, -1,
                                DEFAULT_FRAME_STYLE);
    title.Delete();
    if (!frame)
    {
        return null;
    }

    const icons = new Map<string, wxBitmapBundle>();
    for (const name of TOOL_BITMAP_NAMES)
    {
        const bundle = loadSvgBundle(name, 16, 16);
        if (bundle)
        {
            icons.set(name, bundle);
        }
    }

    const state: FrameState = {
        frame,
        icons,
        callbacks: [],
        closures: [],
        panel: null,
        textWindow: null,
        smallToolbar: true,
        horzText: false,
        useCustomDisabled: false,
        showTooltips: true,
        rows: 1,
        nPrint: 0, // set to 1 in populateToolbar()
        toolbarPosition: TOOLBAR_TOP,
        pathBmp: "",
        searchCtrl: null,
        searchAttached: false,
        mbar: null,
    };

    // Give it a status line
    frame.CreateStatusBar(1, STB_DEFAULT_STYLE, ID_ANY);

    // Give it an icon
    setFrameIcon(frame);

    // ---- menubar ----------------------------------------------------------
    const tbarMenu = newMenu();
    const toolMenu = newMenu();
    const fileMenu = newMenu();
    const helpMenu = newMenu();

    if (tbarMenu)
    {
        appendCheckItem(tbarMenu, IDM_TOOLBAR_TOGGLE_TOOLBAR,
                        "Toggle &toolbar\tCtrl-Z", "Show or hide the toolbar");
        appendCheckItem(tbarMenu, IDM_TOOLBAR_TOGGLE_ANOTHER_TOOLBAR,
                        "Toggle &another toolbar\tCtrl-A",
                        "Show/hide another test toolbar");
        appendCheckItem(tbarMenu, IDM_TOOLBAR_TOGGLE_HORIZONTAL_TEXT,
                        "Toggle hori&zontal text\tCtrl-H",
                        "Show text under/alongside the icon");
        appendCheckItem(tbarMenu, IDM_TOOLBAR_TOGGLETOOLBARSIZE,
                        "&Toggle toolbar size\tCtrl-S",
                        "Toggle between big/small toolbar");
        appendCheckItem(tbarMenu, IDM_TOOLBAR_TOGGLETOOLBARROWS,
                        "Toggle number of &rows\tCtrl-R",
                        "Toggle number of toolbar rows between 1 and 2");
        appendCheckItem(tbarMenu, IDM_TOOLBAR_TOGGLETOOLTIPS,
                        "Show &tooltips\tCtrl-L",
                        "Show tooltips for the toolbar tools");
        appendCheckItem(tbarMenu, IDM_TOOLBAR_TOGGLECUSTOMDISABLED,
                        "Use c&ustom disabled images\tCtrl-U",
                        "Switch between using system-generated and custom disabled images");

        tbarMenu.AppendSeparator();
        appendRadioItem(tbarMenu, IDM_TOOLBAR_TOP_ORIENTATION,
                        "Set toolbar at the top of the window\tCtrl-Up",
                        "Set toolbar at the top of the window");
        appendRadioItem(tbarMenu, IDM_TOOLBAR_LEFT_ORIENTATION,
                        "Set toolbar at the left of the window\tCtrl-Left",
                        "Set toolbar at the left of the window");
        appendRadioItem(tbarMenu, IDM_TOOLBAR_BOTTOM_ORIENTATION,
                        "Set toolbar at the bottom of the window\tCtrl-Down",
                        "Set toolbar at the bottom of the window");
        appendRadioItem(tbarMenu, IDM_TOOLBAR_RIGHT_ORIENTATION,
                        "Set toolbar at the right edge of the window\tCtrl-Right",
                        "Set toolbar at the right edge of the window");
        tbarMenu.AppendSeparator();

        appendRadioItem(tbarMenu, IDM_TOOLBAR_SHOW_TEXT, "Show &text\tCtrl-Alt-T", "");
        appendRadioItem(tbarMenu, IDM_TOOLBAR_SHOW_ICONS, "Show &icons\tCtrl-Alt-I", "");
        appendRadioItem(tbarMenu, IDM_TOOLBAR_SHOW_BOTH, "Show &both\tCtrl-Alt-B", "");
        tbarMenu.AppendSeparator();
        appendMenuItem(tbarMenu, IDM_TOOLBAR_BG_COL,
                       "Choose bac&kground colour...", "");
        appendMenuItem(tbarMenu, IDM_TOOLBAR_CUSTOM_PATH,
                       "Custom &bitmap...\tCtrl-B", "");
    }

    if (toolMenu)
    {
        appendMenuItem(toolMenu, IDM_TOOLBAR_ENABLEPRINT,
                       "&Enable print button\tCtrl-E", "");
        appendMenuItem(toolMenu, IDM_TOOLBAR_DELETEPRINT,
                       "&Delete print button\tCtrl-D", "");
        appendMenuItem(toolMenu, IDM_TOOLBAR_INSERTPRINT,
                       "&Insert print button\tCtrl-I", "");
        appendMenuItem(toolMenu, IDM_TOOLBAR_TOGGLEHELP,
                       "Toggle &help button\tCtrl-T", "");
        appendCheckItem(toolMenu, IDM_TOOLBAR_TOGGLESEARCH,
                        "Toggle &search field\tCtrl-F", "");
        toolMenu.AppendSeparator();
        appendMenuItem(toolMenu, IDM_TOOLBAR_TOGGLERADIOBTN1,
                       "Toggle &1st radio button\tCtrl-1", "");
        appendMenuItem(toolMenu, IDM_TOOLBAR_TOGGLERADIOBTN2,
                       "Toggle &2nd radio button\tCtrl-2", "");
        appendMenuItem(toolMenu, IDM_TOOLBAR_TOGGLERADIOBTN3,
                       "Toggle &3rd radio button\tCtrl-3", "");
        toolMenu.AppendSeparator();
        appendMenuItem(toolMenu, IDM_TOOLBAR_CHANGE_TOOLTIP,
                       "Change tooltip of \"New\"", "");
        toolMenu.AppendSeparator();
        appendMenuItem(toolMenu, IDM_TOOLBAR_INC_TOOL_SPACING,
                       "Increase spacing\tCtrl-+", "");
        appendMenuItem(toolMenu, IDM_TOOLBAR_DEC_TOOL_SPACING,
                       "Decrease spacing\tCtrl--", "");
    }

    if (fileMenu)
    {
        appendMenuItem(fileMenu, ID_EXIT, "E&xit\tAlt-X", "Quit toolbar sample");
    }

    if (helpMenu)
    {
        appendMenuItem(helpMenu, ID_ABOUT, "&About", "About toolbar sample");
    }

    const menuBar = createWxMenuBar(MB_DOCKABLE);
    if (menuBar && fileMenu && tbarMenu && toolMenu && helpMenu)
    {
        withString("&File", (label) => menuBar.Append(fileMenu.ptr, label));
        withString("&Toolbar", (label) => menuBar.Append(tbarMenu.ptr, label));
        withString("Tool&s", (label) => menuBar.Append(toolMenu.ptr, label));
        withString("&Help", (label) => menuBar.Append(helpMenu.ptr, label));

        // Associate the menu bar with the frame
        frame.SetMenuBar(menuBar.ptr);

        menuBar.Check(IDM_TOOLBAR_TOGGLE_TOOLBAR, true);
        menuBar.Check(IDM_TOOLBAR_SHOW_BOTH, true);
        menuBar.Check(IDM_TOOLBAR_TOGGLETOOLTIPS, true);
        menuBar.Check(IDM_TOOLBAR_TOP_ORIENTATION, true);
    }

    state.toolbarPosition = TOOLBAR_TOP;

    // Create the toolbar
    recreateToolbar(state);

    // ---- panel + read-only multiline text control -------------------------
    // wxPanel default style: wxTAB_TRAVERSAL | wxNO_BORDER
    const panel = createWxPanel(frame.ptr, ID_ANY, -1, -1, -1, -1,
                                TAB_TRAVERSAL | BORDER_NONE);
    if (!panel)
    {
        frame.Destroy();
        return null;
    }
    state.panel = panel;

    // Use a read-only text control; Cut tool will not cut selected text anyway.
    const textWindow = withString("", (value) =>
        createWxTextCtrl(panel.ptr, ID_ANY, value, -1, -1, -1, -1,
                         BigInt(TE_MULTILINE | TE_READONLY)));
    if (!textWindow)
    {
        frame.Destroy();
        return null;
    }
    state.textWindow = textWindow;

    const sizer = createWxBoxSizer(VERTICAL);
    if (sizer)
    {
        // sizer->Add(m_textWindow, wxSizerFlags(1).Expand());
        sizer.AddWindow(textWindow.ptr, 1, EXPAND, 0, null);
        panel.SetSizer(sizer.ptr, true);
    }

    // SetInitialSize(FromDIP(wxSize(650, 350)));
    const width = frame.FromDIP(650);
    const height = frame.FromDIP(350);
    frame.SetMinSize(width, height);
    frame.SetSize(-1, -1, width, height, SIZE_AUTO);

    return state;
}

// ---------------------------------------------------------------------------
// MyFrame handlers
// ---------------------------------------------------------------------------

function doEnablePrint(state: FrameState): void
{
    if (state.nPrint === 0)
    {
        return;
    }
    const toolBar = currentToolBar(state);
    if (!toolBar)
    {
        return;
    }
    toolBar.EnableTool(ID_PRINT, !toolBar.GetToolEnabled(ID_PRINT));
    appendText(state, "Print tool state changed.\n");
}

function doDeletePrint(state: FrameState): void
{
    if (state.nPrint === 0)
    {
        return;
    }
    const toolBar = currentToolBar(state);
    if (!toolBar)
    {
        return;
    }
    toolBar.DeleteTool(ID_PRINT);
    appendText(state, "Print tool was deleted.\n");
    state.nPrint--;
}

function doToggleHelp(state: FrameState): void
{
    const toolBar = currentToolBar(state);
    if (!toolBar)
    {
        return;
    }
    toolBar.ToggleTool(ID_HELP, !toolBar.GetToolState(ID_HELP));
    appendText(state, "Help tool was toggled.\n");
}

function onToggleAnotherToolbar(state: FrameState): void
{
    if (state.mbar)
    {
        state.mbar.Delete();
        state.mbar = null;
    }
    else
    {
        const mainToolBar = currentToolBar(state);
        let style = mainToolBar ? Number(mainToolBar.GetWindowStyle()) : TOOLBAR_STYLE;
        style &= ~TB_HORIZONTAL;
        style |= TB_VERTICAL;

        const toolBar = createWxToolBar(state.frame.ptr, ID_ANY, -1, -1, -1, -1, style);
        if (!toolBar)
        {
            return;
        }
        state.mbar = toolBar;

        toolBar.SetMargins(4, 4);

        const bitmaps: wxBitmap[] = [];
        const icon = (name: string): Pointer =>
        {
            const bundle = state.icons.get(name);
            if (!bundle)
            {
                return Null_Bitmap();
            }
            const bitmap = bundle.GetBitmap(16, 16);
            if (!bitmap)
            {
                return Null_Bitmap();
            }
            bitmaps.push(bitmap);
            return bitmap.ptr;
        };

        withString("First", (label) =>
            toolBar.AddRadioTool(IDM_TOOLBAR_OTHER_1, label, icon("new.svg"),
                                 Null_Bitmap(), null, null));
        withString("Second", (label) =>
            toolBar.AddRadioTool(IDM_TOOLBAR_OTHER_2, label, icon("open.svg"),
                                 Null_Bitmap(), null, null));
        withString("Third", (label) =>
            toolBar.AddRadioTool(IDM_TOOLBAR_OTHER_3, label, icon("save.svg"),
                                 Null_Bitmap(), null, null));

        toolBar.AddSeparator();

        withString("Help", (label) =>
        {
            withString("", (shortHelp) =>
            {
                withString("", (longHelp) =>
                {
                    toolBar.AddTool(ID_HELP, label, icon("help.svg"),
                                    Null_Bitmap(), ITEM_NORMAL, shortHelp,
                                    longHelp, null);
                });
            });
        });

        withString("Disabled", (label) =>
        {
            withString("", (shortHelp) =>
            {
                withString("", (longHelp) =>
                {
                    toolBar.AddTool(IDM_TOOLBAR_OTHER_4, label, icon("cut.svg"),
                                    icon("paste.svg"), ITEM_NORMAL, shortHelp,
                                    longHelp, null);
                });
            });
        });

        toolBar.EnableTool(IDM_TOOLBAR_OTHER_4, false);
        toolBar.Realize();

        for (const bitmap of bitmaps)
        {
            bitmap.Delete();
        }
    }

    layoutChildren(state);
}

function onToggleSearch(state: FrameState): void
{
    const toolBar = currentToolBar(state);
    if (!toolBar)
    {
        return;
    }

    if (!state.searchCtrl)
    {
        const search = withString("needle", (value) =>
            createWxSearchCtrl(toolBar.ptr, ID_ANY, value, -1, -1, -1, -1, 0));
        if (!search)
        {
            return;
        }
        search.SetMinSize(state.frame.FromDIP(80), -1);
        withString("", (label) => toolBar.AddControl(search.ptr, label));
        state.searchCtrl = search;
        state.searchAttached = true;
    }
    else if (state.searchAttached)
    {
        // attached now, remove it
        state.searchCtrl.Hide();
        toolBar.RemoveTool(state.searchCtrl.GetId());
        state.searchAttached = false;
    }
    else
    {
        // tool exists in detached state, attach it back
        withString("", (label) => toolBar.AddControl(state.searchCtrl!.ptr, label));
        state.searchCtrl.Show();
        state.searchAttached = true;
    }

    toolBar.Realize();
}

function onToolbarStyle(state: FrameState, id: number): void
{
    const toolBar = currentToolBar(state);
    if (!toolBar)
    {
        return;
    }

    let style = Number(toolBar.GetWindowStyle());
    style &= ~(TB_NOICONS | TB_HORZ_TEXT);

    switch (id)
    {
        case IDM_TOOLBAR_SHOW_TEXT:
            style |= TB_NOICONS | (state.horzText ? TB_HORZ_TEXT : TB_TEXT);
            break;
        case IDM_TOOLBAR_SHOW_ICONS:
            // nothing to do
            break;
        case IDM_TOOLBAR_SHOW_BOTH:
            style |= (state.horzText ? TB_HORZ_TEXT : TB_TEXT);
            break;
    }

    toolBar.SetWindowStyle(BigInt(style));
}

function onToolbarBgCol(state: FrameState): void
{
    const toolBar = currentToolBar(state);
    if (!toolBar)
    {
        return;
    }

    const initial = createWxColourEmpty();
    const chosen = createWxColourEmpty();
    if (!initial || !chosen)
    {
        return;
    }

    toolBar.GetBackgroundColour(initial.ptr);
    withString("Toolbar background colour", (caption) =>
        wxGetColourFromUserEx(state.frame.ptr, initial.ptr, caption, chosen.ptr));

    if (chosen.IsOk())
    {
        toolBar.SetBackgroundColour(chosen.ptr);
        toolBar.Refresh(true);
    }

    initial.Delete();
    chosen.Delete();
}

function onToolbarCustomBitmap(state: FrameState): void
{
    let path = "";
    withString("custom bitmap", (what) =>
    {
        withString("", (extension) =>
        {
            withString("", (defaultName) =>
            {
                const result = wxLoadFileSelector(what, extension, defaultName, null);
                if (result)
                {
                    path = readAndDeleteWxString(result);
                }
            });
        });
    });

    state.pathBmp = path;
    recreateToolbar(state);
}

function onInsertPrint(state: FrameState): void
{
    const toolBar = currentToolBar(state);
    if (!toolBar)
    {
        return;
    }
    state.nPrint++;

    const bundle = state.icons.get("print.svg");
    if (!bundle)
    {
        return;
    }
    const bitmap = bundle.GetBitmap(16, 16);
    if (!bitmap)
    {
        return;
    }

    withString("New print", (label) =>
    {
        withString("Delete this tool", (shortHelp) =>
        {
            withString("This button was inserted into the toolbar", (longHelp) =>
            {
                toolBar.InsertTool(BigInt(0), ID_PRINT, label, bitmap.ptr,
                                   Null_Bitmap(), ITEM_NORMAL, shortHelp,
                                   longHelp);
            });
        });
    });
    bitmap.Delete();

    // must call Realize() after adding a new button
    toolBar.Realize();
}

// ---------------------------------------------------------------------------
// event table
// ---------------------------------------------------------------------------

function bindToolbarEvents(state: FrameState): void
{
    const on = (
        first: number,
        last: number,
        type: number,
        handler: (eventPtr: Pointer) => void,
    ): void =>
    {
        const callback = new Callback(
            { parameters: ["pointer", "pointer", "pointer"], result: "void" },
            (_closureFun, _data, eventPtr) =>
            {
                if (!eventPtr)
                {
                    return; // wxClosure's teardown sweep passes a null event
                }
                handler(eventPtr);
            },
        );
        const closure = createWxClosure(callback.pointer, null)!;
        state.frame.Bind(first, last, type, closure.ptr);
        state.callbacks.push(callback);
        state.closures.push(closure);
    };

    const menu = (id: number, handler: (eventPtr: Pointer) => void): void =>
        on(id, id, EVT_MENU, handler);

    // EVT_SIZE(MyFrame::OnSize)
    on(ID_ANY, ID_ANY, EVT_SIZE, (eventPtr) =>
    {
        if (state.mbar)
        {
            layoutChildren(state);
        }
        else
        {
            new wxSizeEvent(eventPtr).Skip(true);
        }
    });

    // EVT_MENU(wxID_ANY, OnToolLeftClick) — bound first: the dynamic handler
    // list is searched newest-first, so the specific handlers installed below
    // take precedence, exactly like the event table's top-down order.
    on(ID_ANY, ID_ANY, EVT_MENU, (eventPtr) =>
    {
        const id = new wxCommandEvent(eventPtr).GetId();
        appendText(state, "Clicked on tool " + id + "\n");

        if (id === ID_COPY)
        {
            doEnablePrint(state);
        }
        if (id === ID_CUT)
        {
            doToggleHelp(state);
        }
        if (id === ID_PRINT)
        {
            doDeletePrint(state);
        }
    });

    // EVT_MENU(wxID_EXIT)
    menu(ID_EXIT, () => state.frame.Close(true));

    // EVT_MENU(wxID_ABOUT) — processed for the menu and the toolbar help button
    menu(ID_ABOUT, (eventPtr) =>
    {
        const checked = new wxCommandEvent(eventPtr).IsChecked();
        appendText(state, checked ? "Help button down now.\n"
                                  : "Help button up now.\n");

        withString("wxWidgets toolbar sample", (message) =>
        {
            withString("About wxToolBar", (caption) =>
            {
                // (void)wxMessageBox("wxWidgets toolbar sample", "About wxToolBar");
                kwxMessageBox(message, caption, OK | CENTRE, null, -1, -1);
            });
        });
    });

    // EVT_MENU(IDM_TOOLBAR_TOGGLE_TOOLBAR)
    menu(IDM_TOOLBAR_TOGGLE_TOOLBAR, () =>
    {
        const toolBar = currentToolBar(state);
        if (!toolBar)
        {
            recreateToolbar(state);
        }
        else
        {
            // delete the toolbar directly; wxFrameBase::RemoveChild() resets the
            // frame's toolbar pointer when the window is destroyed.
            lib.symbols.wxToolBar_Delete(toolBar.ptr);
        }
    });

    // EVT_MENU(IDM_TOOLBAR_TOGGLE_ANOTHER_TOOLBAR)
    menu(IDM_TOOLBAR_TOGGLE_ANOTHER_TOOLBAR, () => onToggleAnotherToolbar(state));

    // EVT_MENU(IDM_TOOLBAR_TOGGLE_HORIZONTAL_TEXT)
    menu(IDM_TOOLBAR_TOGGLE_HORIZONTAL_TEXT, () =>
    {
        state.horzText = !state.horzText;
        recreateToolbar(state);
    });

    // EVT_MENU_RANGE(TOP..RIGHT, OnChangeOrientation)
    on(IDM_TOOLBAR_TOP_ORIENTATION, IDM_TOOLBAR_RIGHT_ORIENTATION, EVT_MENU,
       (eventPtr) =>
       {
           switch (new wxCommandEvent(eventPtr).GetId())
           {
               case IDM_TOOLBAR_LEFT_ORIENTATION:
                   state.toolbarPosition = TOOLBAR_LEFT;
                   break;
               case IDM_TOOLBAR_TOP_ORIENTATION:
                   state.toolbarPosition = TOOLBAR_TOP;
                   break;
               case IDM_TOOLBAR_RIGHT_ORIENTATION:
                   state.toolbarPosition = TOOLBAR_RIGHT;
                   break;
               case IDM_TOOLBAR_BOTTOM_ORIENTATION:
                   state.toolbarPosition = TOOLBAR_BOTTOM;
                   break;
           }
           recreateToolbar(state);
       });

    // EVT_MENU(IDM_TOOLBAR_TOGGLETOOLBARSIZE)
    menu(IDM_TOOLBAR_TOGGLETOOLBARSIZE, () =>
    {
        state.smallToolbar = !state.smallToolbar;
        recreateToolbar(state);
    });

    // EVT_MENU(IDM_TOOLBAR_TOGGLETOOLBARROWS)
    menu(IDM_TOOLBAR_TOGGLETOOLBARROWS, () =>
    {
        // m_rows may be only 1 or 2
        state.rows = 3 - state.rows;

        const toolBar = currentToolBar(state);
        if (!toolBar)
        {
            return;
        }
        toolBar.SetRows(toolBar.IsVertical()
            ? Math.floor(Number(toolBar.GetToolsCount()) / state.rows)
            : state.rows);
    });

    // EVT_MENU(IDM_TOOLBAR_TOGGLETOOLTIPS)
    menu(IDM_TOOLBAR_TOGGLETOOLTIPS, () =>
    {
        state.showTooltips = !state.showTooltips;
        recreateToolbar(state);
    });

    // EVT_MENU(IDM_TOOLBAR_TOGGLECUSTOMDISABLED)
    menu(IDM_TOOLBAR_TOGGLECUSTOMDISABLED, () =>
    {
        state.useCustomDisabled = !state.useCustomDisabled;
        recreateToolbar(state);
    });

    // EVT_MENU(IDM_TOOLBAR_ENABLEPRINT / DELETEPRINT / INSERTPRINT)
    menu(IDM_TOOLBAR_ENABLEPRINT, () => doEnablePrint(state));
    menu(IDM_TOOLBAR_DELETEPRINT, () => doDeletePrint(state));
    menu(IDM_TOOLBAR_INSERTPRINT, () => onInsertPrint(state));

    // EVT_MENU(IDM_TOOLBAR_TOGGLEHELP)
    menu(IDM_TOOLBAR_TOGGLEHELP, () => doToggleHelp(state));

    // EVT_MENU(IDM_TOOLBAR_TOGGLESEARCH)
    menu(IDM_TOOLBAR_TOGGLESEARCH, () => onToggleSearch(state));

    // EVT_MENU_RANGE(RADIOBTN1..RADIOBTN3, OnToggleRadioBtn)
    on(IDM_TOOLBAR_TOGGLERADIOBTN1, IDM_TOOLBAR_TOGGLERADIOBTN3, EVT_MENU,
       (eventPtr) =>
       {
           if (!state.mbar)
           {
               return;
           }
           const id = new wxCommandEvent(eventPtr).GetId();
           state.mbar.ToggleTool(
               IDM_TOOLBAR_OTHER_1 + id - IDM_TOOLBAR_TOGGLERADIOBTN1, true);
       });

    // EVT_MENU(IDM_TOOLBAR_CHANGE_TOOLTIP)
    menu(IDM_TOOLBAR_CHANGE_TOOLTIP, () =>
    {
        const toolBar = currentToolBar(state);
        if (toolBar)
        {
            withString("New toolbar button", (help) =>
                toolBar.SetToolShortHelp(ID_NEW, help));
        }
    });

    // EVT_MENU(IDM_TOOLBAR_INC_TOOL_SPACING / DEC_TOOL_SPACING)
    menu(IDM_TOOLBAR_INC_TOOL_SPACING, () =>
    {
        const toolBar = currentToolBar(state);
        if (toolBar)
        {
            toolBar.SetToolPacking(toolBar.GetToolPacking() + 1);
        }
    });
    menu(IDM_TOOLBAR_DEC_TOOL_SPACING, () =>
    {
        const toolBar = currentToolBar(state);
        if (toolBar)
        {
            toolBar.SetToolPacking(toolBar.GetToolPacking() - 1);
        }
    });

    // EVT_MENU_RANGE(SHOW_TEXT..SHOW_BOTH, OnToolbarStyle)
    on(IDM_TOOLBAR_SHOW_TEXT, IDM_TOOLBAR_SHOW_BOTH, EVT_MENU, (eventPtr) =>
        onToolbarStyle(state, new wxCommandEvent(eventPtr).GetId()));

    // EVT_MENU(IDM_TOOLBAR_BG_COL)
    menu(IDM_TOOLBAR_BG_COL, () => onToolbarBgCol(state));

    // EVT_MENU(IDM_TOOLBAR_CUSTOM_PATH)
    menu(IDM_TOOLBAR_CUSTOM_PATH, () => onToolbarCustomBitmap(state));

    // EVT_COMBOBOX(ID_COMBO)
    on(ID_COMBO, ID_COMBO, EVT_COMBOBOX, (eventPtr) =>
    {
        const value = new wxCommandEvent(eventPtr).GetString();
        const selection = value ? readAndDeleteWxString(value.ptr) : "";
        withString("Combobox string '" + selection + "' selected", (message) =>
            LogStatusWindow(state.frame.ptr, message));
    });

    // EVT_TOOL_RCLICKED(wxID_ANY)
    on(ID_ANY, ID_ANY, EVT_TOOL_RCLICKED, (eventPtr) =>
    {
        const event = new wxCommandEvent(eventPtr);
        appendText(state, "Tool " + event.GetInt() + " right clicked.\n");
    });

    // EVT_TOOL_DROPDOWN(wxID_ANY)
    on(ID_ANY, ID_ANY, EVT_TOOL_DROPDOWN, (eventPtr) =>
    {
        const event = new wxCommandEvent(eventPtr);
        appendText(state, "Dropdown on tool " + event.GetId() + "\n");
        event.Skip(true);
    });

    // EVT_UPDATE_UI(wxID_COPY), EVT_UPDATE_UI(wxID_CUT)
    for (const id of [ID_COPY, ID_CUT])
    {
        on(id, id, EVT_UPDATE_UI, (eventPtr) =>
        {
            const canCopy = state.textWindow ? state.textWindow.CanCopy() : false;
            new wxUpdateUIEvent(eventPtr).Enable(canCopy);
        });
    }

    // EVT_UPDATE_UI_RANGE(FIRST_NEEDS_TOOLBAR..LAST_NEEDS_TOOLBAR)
    on(IDM_FIRST_NEEDS_TOOLBAR, IDM_LAST_NEEDS_TOOLBAR, EVT_UPDATE_UI, (eventPtr) =>
    {
        new wxUpdateUIEvent(eventPtr).Enable(currentToolBar(state) !== null);
    });

    // EVT_UPDATE_UI_RANGE(RADIOBTN1..RADIOBTN3)
    on(IDM_TOOLBAR_TOGGLERADIOBTN1, IDM_TOOLBAR_TOGGLERADIOBTN3, EVT_UPDATE_UI,
       (eventPtr) =>
       {
           new wxUpdateUIEvent(eventPtr).Enable(state.mbar !== null);
       });

    // EVT_UPDATE_UI(IDM_TOOLBAR_TOGGLE_HORIZONTAL_TEXT)
    on(IDM_TOOLBAR_TOGGLE_HORIZONTAL_TEXT, IDM_TOOLBAR_TOGGLE_HORIZONTAL_TEXT,
       EVT_UPDATE_UI, (eventPtr) =>
       {
           const toolBar = currentToolBar(state);
           new wxUpdateUIEvent(eventPtr).Enable(
               toolBar !== null &&
               toolBar.HasFlag(TB_TEXT) &&
               !toolBar.HasFlag(TB_NOICONS));
       });

    // No EVT_CLOSE_WINDOW row in the C++ table; the kwxTypeScript bootstrap
    // needs one so that closing the frame ends the main loop deterministically.
    on(ID_ANY, ID_ANY, EVT_CLOSE_WINDOW, () => exitMainLoop());
}

// ---------------------------------------------------------------------------
// bootstrap
// ---------------------------------------------------------------------------

export function main(): number
{
    if (!initialize())
    {
        console.error("Failed to initialize wxWidgets");
        return 1;
    }

    setAppName("toolbar");

    // Because we use PNG icons (and the "custom bitmap" file selector) we need
    // to register this image handler before creating the frame.
    const pngHandler = createWxPNGHandler();
    if (pngHandler)
    {
        wxImage_AddHandler(pngHandler.ptr);
    }

    const state = createToolbarFrame();
    if (!state)
    {
        console.error("toolbar: failed to create the main frame");
        shutdown();
        return 1;
    }

    bindToolbarEvents(state);

    state.frame.Show();
    withString("Hello, wxWidgets", (text) => state.frame.SetStatusText(text, 0));
    setTopWindow(state.frame.ptr);

    const exitCode = run();

    for (const callback of state.callbacks)
    {
        callback.close();
    }
    shutdown();
    return exitCode;
}

exit(main());
