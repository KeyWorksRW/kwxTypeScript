}

/** MyFrame::OnCreateNotebook() */
function onCreateNotebook(state: FrameState): void
{
    const notebook = createNotebook(state);
    if (!notebook)
    {
        return;
    }

    const start = getStartPosition(state);
    addPane(state, notebook.ptr, null, "Notebook", (info) =>
