// filepicker.kwxts — port of wxSamples/src/widgets/filepicker.cpp
//
// wxFilePickerCtrl does not derive from wxWindow in the bindings, so the
// wrapper goes through wrapWxWindow() for GetWidget()/sizer insertion and the
// owned window is destroyed through a plain wxWindow view.

import {
    ALIGN_CENTRE_HORIZONTAL,
    createWxBoxSizer,
    createWxButton,
    createWxFilePickerCtrl,
    createWxRadioBox,
    createWxStaticText,
    EVT_BUTTON,
    EVT_CHECKBOX,
    EVT_FILEPICKER_CHANGED,
    EVT_RADIOBOX,
    EVT_UPDATE_UI,
    EXPAND,
    FLP_CHANGE_DIR,
    FLP_DEFAULT_STYLE,
    FLP_FILE_MUST_EXIST,
    FLP_OPEN,
    FLP_OVERWRITE_PROMPT,
    FLP_SAVE,
    FLP_SMALL,
    FLP_USE_TEXTCTRL,
    HORIZONTAL,
    ID_ANY,
    ID_HIGHEST,
    RA_SPECIFY_COLS,
    readAndDeleteWxString,
    VERTICAL,
    wxCheckBox,
    wxCommandEvent,
    wxFileDirPickerEvent,
    wxFilePickerCtrl,
    wxGetCwd,
    wxRadioBox,
    wxSizer,
    wxStaticText,
    wxTextCtrl,
    wxUpdateUIEvent,
    wxWindow,
    wrapWxWindow,
} from "kwx";
import { pointerOf, Pointer } from "kwx/platform";

import {
    addSizer,
    addSpacer,
    addStretchSpacer,
    addWin,
    attrs,
    bindEvent,
    border,
    logMessage,
    makeStaticBoxSizer,
    tripleBorder,
    WidgetsPage,
    withString,
} from "./common.kwxts";

const FILEPICKER_MODE_OPEN = 0;
const FILEPICKER_MODE_SAVE = 1;

const PICKER_PAGE_RESET = ID_HIGHEST;
const PICKER_PAGE_FILE = PICKER_PAGE_RESET + 1;
const PICKER_PAGE_SET_DIR = PICKER_PAGE_FILE + 1;
const PICKER_PAGE_CURRENT_PATH = PICKER_PAGE_SET_DIR + 1;

/** wxFilePickerCtrl wrapper as a wxWindow view. */
function pickerWindow(picker: wxFilePickerCtrl): wxWindow
{
    return wrapWxWindow(picker.ptr);
}

/** Builds the `char**` choice array wxRadioBox_Create() expects. */
function createModeRadioBox(parent: Pointer, caption: string, items: string[]): wxRadioBox | null
{
    const buffers: Uint8Array[] = [];
    const pointers = new BigUint64Array(items.length);

    for (let index = 0; index < items.length; index++)
    {
        const bytes = new TextEncoder().encode(items[index] + "\0");
        buffers.push(bytes);
        const address = pointerOf(bytes);
        pointers[index] = address === null ? 0n : address;
    }

    const choices = items.length > 0 ? pointerOf(pointers) : null;

    const radioBox = withString(caption, (ptr) =>
        createWxRadioBox(parent, ID_ANY, ptr, -1, -1, -1, -1,
            items.length, choices, 0, RA_SPECIFY_COLS));

    void buffers;
    return radioBox;
}

export class FilePickerPage extends WidgetsPage
{
    private filePicker: wxFilePickerCtrl | null = null;

    private chkFileTextCtrl: wxCheckBox | null = null;
    private chkFileOverwritePrompt: wxCheckBox | null = null;
    private chkFileMustExist: wxCheckBox | null = null;
    private chkFileChangeDir: wxCheckBox | null = null;
    private chkSmall: wxCheckBox | null = null;
    private radioFilePickerMode: wxRadioBox | null = null;
    private labelPath: wxStaticText | null = null;
    private textInitialDir: wxTextCtrl | null = null;

    private sizer: wxSizer | null = null;

    constructor(parent: Pointer)
    {
        super(parent, "icons/filepicker");
    }

    override getWidget(): wxWindow | null
    {
        return this.filePicker ? pickerWindow(this.filePicker) : null;
    }

    override createContent(): void
    {
        // left pane
        const leftSizer = createWxBoxSizer(VERTICAL)!;

        this.radioFilePickerMode = createModeRadioBox(
            this.page.ptr, "wxFilePicker mode", ["open", "save"]);
        if (this.radioFilePickerMode)
        {
            addWin(leftSizer, this.radioFilePickerMode, 0, EXPAND, border());
        }

        const styleSizer = makeStaticBoxSizer(
            this.page.ptr, VERTICAL, "&FilePicker style");

        this.chkFileTextCtrl = this.createCheckBoxAndAddToSizer(
            styleSizer.sizer, "With textctrl", ID_ANY, styleSizer.box.ptr);
        this.chkFileOverwritePrompt = this.createCheckBoxAndAddToSizer(
            styleSizer.sizer, "Overwrite prompt", ID_ANY, styleSizer.box.ptr);
        this.chkFileMustExist = this.createCheckBoxAndAddToSizer(
            styleSizer.sizer, "File must exist", ID_ANY, styleSizer.box.ptr);
        this.chkFileChangeDir = this.createCheckBoxAndAddToSizer(
            styleSizer.sizer, "Change working dir", ID_ANY, styleSizer.box.ptr);
        this.chkSmall = this.createCheckBoxAndAddToSizer(
            styleSizer.sizer, "&Small version", ID_ANY, styleSizer.box.ptr);

        addSizer(leftSizer, styleSizer.sizer, 0, EXPAND, border());

        addSizer(leftSizer, this.createSizerWithTextAndButton(
            PICKER_PAGE_SET_DIR, "&Initial directory", ID_ANY,
            (text) => { this.textInitialDir = text; },
        ), 0, EXPAND, border());

        addSpacer(leftSizer, this.dip(10));

        const resetButton = withString("&Reset", (ptr) =>
            createWxButton(this.page.ptr, PICKER_PAGE_RESET, ptr,
                -1, -1, -1, -1, 0))!;
        addWin(leftSizer, resetButton, 0, ALIGN_CENTRE_HORIZONTAL, tripleBorder());

        this.reset(); // set checkboxes state

        // create the picker and the static text displaying its current value
        this.labelPath = withString("", (ptr) =>
            createWxStaticText(this.page.ptr, PICKER_PAGE_CURRENT_PATH, ptr,
                -1, -1, -1, -1, 0));

        this.filePicker = null;
        this.createPicker();

        // right pane
        const sizer = createWxBoxSizer(VERTICAL)!;
        addStretchSpacer(sizer);
        if (this.filePicker)
        {
            addWin(sizer, pickerWindow(this.filePicker), 0, EXPAND, border());
        }
        addStretchSpacer(sizer);
        if (this.labelPath)
        {
            addWin(sizer, this.labelPath, 0, EXPAND, border());
        }
        addStretchSpacer(sizer);
        this.sizer = sizer;

        // global pane
        const globalSizer = createWxBoxSizer(HORIZONTAL)!;
        addSizer(globalSizer, leftSizer, 0, EXPAND, border());
        addSizer(globalSizer, sizer, 1, EXPAND, border());

        this.page.SetSizer(globalSizer.ptr, false);

        bindEvent(this.page, PICKER_PAGE_RESET, PICKER_PAGE_RESET, EVT_BUTTON,
            () =>
            {
                this.reset();
                this.recreatePicker();
            });

        bindEvent(this.page, PICKER_PAGE_SET_DIR, PICKER_PAGE_SET_DIR,
            EVT_BUTTON, () =>
            {
                const value = this.textInitialDir?.GetValue();
                const dirText = value ? readAndDeleteWxString(value.ptr) : "";
                withString(dirText,
                    (ptr) => this.filePicker?.SetInitialDirectory(ptr));
                logMessage(`Initial directory set to "${dirText}"`);
            });

        bindEvent(this.page, PICKER_PAGE_FILE, PICKER_PAGE_FILE,
            EVT_FILEPICKER_CHANGED, (eventPtr) =>
            {
                if (!eventPtr) return;
                const event = new wxFileDirPickerEvent(eventPtr, true);
                const path = event.GetPath();
                const fileName = this.filePicker?.GetFileName();

                logMessage("The file changed to "
                    + `'${path ? readAndDeleteWxString(path.ptr) : ""}' (the control has `
                    + `'${fileName ? readAndDeleteWxString(fileName.ptr) : ""}').`
                    + "The current working directory is "
                    + `'${readAndDeleteWxString(wxGetCwd())}'`);
            });

        bindEvent(this.page, ID_ANY, ID_ANY, EVT_CHECKBOX, (eventPtr) =>
        {
            if (!eventPtr) return;
            const source = new wxCommandEvent(eventPtr, true).GetEventObject();
            if (!source)
            {
                return;
            }
            if (source.ptr === this.chkFileTextCtrl?.ptr
                || source.ptr === this.chkFileOverwritePrompt?.ptr
                || source.ptr === this.chkFileMustExist?.ptr
                || source.ptr === this.chkFileChangeDir?.ptr
                || source.ptr === this.chkSmall?.ptr)
            {
                this.recreatePicker();
            }
        });

        bindEvent(this.page, ID_ANY, ID_ANY, EVT_RADIOBOX, (eventPtr) =>
        {
            if (!eventPtr) return;
            const source = new wxCommandEvent(eventPtr, true).GetEventObject();
            if (source && source.ptr === this.radioFilePickerMode?.ptr)
            {
                this.updateFilePickerMode();
                this.recreatePicker();
            }
        });

        // EVT_UPDATE_UI binds on the control that receives the update.
        if (this.labelPath)
        {
            bindEvent(this.labelPath, PICKER_PAGE_CURRENT_PATH,
                PICKER_PAGE_CURRENT_PATH, EVT_UPDATE_UI, (eventPtr) =>
                {
                    if (!eventPtr) return;
                    const event = new wxUpdateUIEvent(eventPtr, true);
                    const path = this.filePicker?.GetPath();
                    const text = "Current path: "
                        + (path ? readAndDeleteWxString(path.ptr) : "");
                    withString(text, (ptr) => event.SetText(ptr));
                });
        }
    }

    override recreateWidget(): void
    {
        this.recreatePicker();
    }

    /** Called only once, at first construction. */
    private createPicker(): void
    {
        let style = attrs.defaultFlags;

        if (this.chkFileTextCtrl?.GetValue())
        {
            style |= FLP_USE_TEXTCTRL;
        }
        if (this.chkFileOverwritePrompt?.GetValue())
        {
            style |= FLP_OVERWRITE_PROMPT;
        }
        if (this.chkFileMustExist?.GetValue())
        {
            style |= FLP_FILE_MUST_EXIST;
        }
        if (this.chkFileChangeDir?.GetValue())
        {
            style |= FLP_CHANGE_DIR;
        }
        if (this.chkSmall?.GetValue())
        {
            style |= FLP_SMALL;
        }

        if (this.radioFilePickerMode?.GetSelection() === FILEPICKER_MODE_OPEN)
        {
            style |= FLP_OPEN;
        }
        else
        {
            style |= FLP_SAVE;
        }

        // pass an empty string as initial file
        this.filePicker = withString("", (path) =>
            withString("Hello!", (message) =>
                withString("*", (wildcard) => createWxFilePickerCtrl(
                    this.page.ptr, PICKER_PAGE_FILE, -1, -1, -1, -1,
                    path, message, wildcard, BigInt(style)))));

        if (this.filePicker)
        {
            this.notifyWidgetRecreation(pickerWindow(this.filePicker));
        }
    }

    /** Called to recreate an existing control. */
    private recreatePicker(): void
    {
        if (this.sizer)
        {
            this.sizer.Remove(1);
        }

        // The C++ code deletes the previous picker; the wrapper has no
        // Delete(), so its window is destroyed through a wxWindow view.
        if (this.filePicker)
        {
            pickerWindow(this.filePicker).Destroy();
            this.filePicker = null;
        }

        this.createPicker();

        const picker = this.filePicker as wxFilePickerCtrl | null;
        if (this.sizer && picker)
        {
            this.sizer.InsertWindow(1, picker.ptr, 0,
                EXPAND, border(), null);
            this.sizer.Layout();
        }
    }

    /** Restore the checkboxes state to the initial values. */
    private reset(): void
    {
        this.radioFilePickerMode?.SetSelection(
            (FLP_DEFAULT_STYLE & FLP_OPEN) !== 0
                ? FILEPICKER_MODE_OPEN
                : FILEPICKER_MODE_SAVE);
        this.chkFileTextCtrl?.SetValue(
            (FLP_DEFAULT_STYLE & FLP_USE_TEXTCTRL) !== 0);
        this.chkFileOverwritePrompt?.SetValue(
            (FLP_DEFAULT_STYLE & FLP_OVERWRITE_PROMPT) !== 0);
        this.chkFileMustExist?.SetValue(
            (FLP_DEFAULT_STYLE & FLP_FILE_MUST_EXIST) !== 0);
        this.chkFileChangeDir?.SetValue(
            (FLP_DEFAULT_STYLE & FLP_CHANGE_DIR) !== 0);
        this.chkSmall?.SetValue((FLP_DEFAULT_STYLE & FLP_SMALL) !== 0);

        this.updateFilePickerMode();
    }

    /** FilePickerWidgetsPage::UpdateFilePickerMode() */
    private updateFilePickerMode(): void
    {
        switch (this.radioFilePickerMode?.GetSelection())
        {
            case FILEPICKER_MODE_OPEN:
                this.chkFileOverwritePrompt?.SetValue(false);
                this.chkFileOverwritePrompt?.Disable();
                this.chkFileMustExist?.Enable(true);
                break;
            case FILEPICKER_MODE_SAVE:
                this.chkFileMustExist?.SetValue(false);
                this.chkFileMustExist?.Disable();
                this.chkFileOverwritePrompt?.Enable(true);
                break;
            default:
                // no selection yet: nothing to enable or disable
                break;
        }
    }
}

export function createFilePickerPage(parent: Pointer): WidgetsPage
{
    return new FilePickerPage(parent);
}
