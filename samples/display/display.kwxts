// display.kwxts — kwxTypeScript port of wxSamples/src/display/display.cpp
//
// The wxDisplay sample: one notebook page per monitor with its geometry,
// client area, PPI, depth, scaling, name and primary flag, a video-mode
// selector with a "Reset mode" button, and a Display/Help menu bar with
// "Find from point...", "Full screen", "Content Protection" and "About".
//
// Run from the repository root:
//   bin\Release\kwxts.exe samples\display\display.kwxts
//
// Full port: the "Modes:" choice is populated from wxDisplay::GetModes() with
// per-item client data driving ChangeMode(); VideoModeToText() includes the
// refresh-rate suffix; the display-changed and DPI-changed handlers use the
// typed wxDisplayChangedEvent/wxDPIChangedEvent wrappers.
//
// Substitution: the frame icon is loaded at run time from sample.xpm instead of
// the Win32 icon resource (wxICON(sample)); the artwork is identical.

declare const __dirname: string;

import {
    ALL,
    ART_FULL_SCREEN,
    ART_MENU,
    BITMAP_TYPE_XPM,
    CONTENT_PROTECTION_ENABLED,
    CONTENT_PROTECTION_NONE,
    DEFAULT_FRAME_STYLE,
    EVT_BUTTON,
    EVT_CHOICE,
    EVT_CLOSE_WINDOW,
    EVT_DISPLAY_CHANGED,
    EVT_DPI_CHANGED,
    EVT_LEFT_UP,
    EVT_MENU,
    FULLSCREEN_ALL,
    ICON_INFORMATION,
    ID_ABOUT,
    ID_ANY,
    ID_EXIT,
    ID_HIGHEST,
    LogError,
    LogInfo,
    LogStatusWindow,
    NOT_FOUND,
    OK,
    STB_DEFAULT_STYLE,
    TAB_TRAVERSAL,
    VERTICAL,
    createWxBoxSizer,
    createWxButton,
    createWxChoice,
    createWxClosure,
    createWxDisplay,
    createWxFlexGridSizer,
    createWxFrame,
    createWxIconLoad,
    createWxMenu,
    createWxMenuBar,
    createWxNotebook,
    createWxPanel,
    createWxSizerFlags,
    createWxStaticText,
    createWxString,
    createWxVideoMode,
    exitMainLoop,
    initialize,
    kwxMessageBox,
    readAndDeleteWxString,
    run,
    setAppName,
    setTopWindow,
    shutdown,
    wxArtProvider_GetBitmap,
    wxArrayVideoModes,
    wxClosure,
    wxCommandEvent,
    wxDisplay,
    wxDisplay_GetCount,
    wxDisplayChangedEvent,
    wxDPIChangedEvent,
    wxDisplay_GetFromPoint,
    wxFrame,
    wxMenu,
    wxMouseEvent,
    wxNotebook,
    wxSizer,
    wxSizerFlags,
    wxVideoMode,
} from "kwx";
import { Callback, exit, Pointer, pointerOf } from "kwx/platform";

// ---------------------------------------------------------------------------
// display.cpp: enum { Display_FromPoint = wxID_HIGHEST, ... }
// ---------------------------------------------------------------------------

const Display_FromPoint = ID_HIGHEST;
const Display_FullScreen = ID_HIGHEST + 1;
const Display_ContentProtection_None = ID_HIGHEST + 2;
const Display_ContentProtection_Enable = ID_HIGHEST + 3;

const Display_ChangeMode = ID_HIGHEST + 4;
const Display_ResetMode = ID_HIGHEST + 5;
const Display_CurrentMode = ID_HIGHEST + 6;

const Display_Quit = ID_EXIT;
const Display_About = ID_ABOUT;

// ---------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------

interface EventBinding
{
    callback: Callback;
    closure: wxClosure;
}

/** MyFrame's persistent state (frame, book control and live event bindings). */
interface DisplayFrameState
{
    frame: wxFrame;
    book: wxNotebook;
    bindings: EventBinding[];
    /**
     * Copies of the video modes listed by each page's wxChoice, in the same
     * order as the control's items (MyVideoModeClientData in C++). The choice
     * owns none of them, so these wrappers keep - and finally release - the
     * allocations, and also map a selection back to its wxVideoMode.
     */
    modeData: wxVideoMode[][];
}

/** Creates a wxString for the duration of `fn` and releases it afterwards. */
function withString<T>(text: string, fn: (ptr: Pointer) => T): T
{
    const value = createWxString(text);
    try
    {
        return fn(value.ptr);
    }
    finally
    {
        value.Delete();
    }
}

/** Absolute path of an asset shipped next to this module. */
function samplePath(name: string): string
{
    return __dirname.replace(/\\/g, "/") + "/" + name;
}

/** sizer->Add(window, wxSizerFlags(proportion).<setup>()) */
function addWindowWithFlags(
    sizer: wxSizer,
    window: Pointer,
    proportion: number,
    setup: (flags: wxSizerFlags) => void,
): void
{
    const flags = createWxSizerFlags(proportion);
    if (!flags)
    {
        sizer.AddWindow(window, proportion, 0, 0, null);
        return;
    }
    setup(flags);
    sizer.AddWindowFlags(window, flags.ptr);
    flags.Delete();
}

/** sizer->Add(child, wxSizerFlags(proportion).<setup>()) */
function addSizerWithFlags(
    sizer: wxSizer,
    child: Pointer,
    proportion: number,
    setup: (flags: wxSizerFlags) => void,
): void
{
    const flags = createWxSizerFlags(proportion);
    if (!flags)
    {
        sizer.AddSizer(child, proportion, 0, 0, null);
        return;
    }
    setup(flags);
    sizer.AddSizerFlags(child, flags.ptr);
    flags.Delete();
}

/** wxLogInfo(message) — the whole message is the format string. */
function logInfo(text: string): void
{
    withString(text.replace(/%/g, "%%"), (ptr) => LogInfo(ptr));
}

/** wxLogError(message) — the whole message is the format string. */
function logError(text: string): void
{
    withString(text.replace(/%/g, "%%"), (ptr) => LogError(ptr));
}

/** wxLogStatus(frame, message). */
function logStatus(frame: wxFrame, text: string): void
{
    withString(text, (ptr) => LogStatusWindow(frame.ptr, ptr));
}

/** wxStaticText(parent, wxID_ANY, text) with default position/size/style. */
function makeLabel(parent: Pointer, text: string): Pointer
{
    const label = withString(text, (ptr) =>
        createWxStaticText(parent, ID_ANY, ptr, -1, -1, -1, -1, 0));
    return label ? label.ptr : null;
}

/** wxMenu(style = 0) with an empty title. */
function createPlainMenu(): wxMenu | null
{
    return withString("", (ptr) => createWxMenu(ptr, 0n));
}

/** menu->Append(id, label) */
function appendMenuItem(menu: wxMenu, id: number, label: string): void
{
    withString(label, (ptr) => { menu.Append(id, ptr, null, false); });
}

/** menu->Append(id, label, help) */
function appendMenuItemWithHelp(
    menu: wxMenu,
    id: number,
    label: string,
    help: string,
): void
{
    withString(label, (labelPtr) =>
        withString(help, (helpPtr) => { menu.Append(id, labelPtr, helpPtr, false); }));
}

/** menu->Append(id, label, "", wxITEM_RADIO) */
function appendRadioItem(menu: wxMenu, id: number, label: string): void
{
    withString(label, (ptr) => { menu.AppendRadioItem(id, ptr, null); });
}

// ---------------------------------------------------------------------------
// MyFrame::VideoModeToText
// ---------------------------------------------------------------------------

function videoModeToText(mode: wxVideoMode): string
{
    let text = `${mode.GetWidth()}x${mode.GetHeight()}`;

    const bpp = mode.GetDepth();
    if (bpp)
    {
        text += `, ${bpp}bpp`;
    }

    const refresh = mode.GetRefresh();
    if (refresh)
    {
        text += `, ${refresh}Hz`;
    }

    return text;
}

/** Releases the video-mode client data of the pages that are about to go away. */
function clearModeData(state: DisplayFrameState): void
{
    for (const pageModes of state.modeData)
    {
        if (!pageModes)
        {
            continue;
        }
        for (const mode of pageModes)
        {
            mode.Delete();
        }
        pageModes.length = 0;
    }
    state.modeData.length = 0;
}

// ---------------------------------------------------------------------------
// MyFrame::PopuplateWithDisplayInfo
// ---------------------------------------------------------------------------

/** Fills the book control with one page of information per display. */
function populateWithDisplayInfo(state: DisplayFrameState): void
{
    const countDpy = wxDisplay_GetCount();
    for (let nDpy = 0; nDpy < countDpy; nDpy++)
    {
        const displayPtr = createWxDisplay(nDpy);
        if (!displayPtr)
        {
            state.modeData.push([]);
            continue;
        }
        const display = new wxDisplay(displayPtr);

        // Filled with the wxChoice's mode copies below and indexed by display.
        const pageModes: wxVideoMode[] = [];

        const page = createWxPanel(
            state.book.ptr, ID_ANY, -1, -1, -1, -1, TAB_TRAVERSAL);
        if (!page)
        {
            state.modeData.push(pageModes);
            display.Delete();
            continue;
        }

        // create 2 column flex grid sizer with growable 2nd column
        const grid = createWxFlexGridSizer(0, 2, 10, 20);
        if (!grid)
        {
            state.modeData.push(pageModes);
            display.Delete();
            continue;
        }
        grid.AddGrowableCol(1n, 0);

        const addLabel = (text: string): void =>
        {
            const labelPtr = makeLabel(page.ptr, text);
            if (labelPtr)
            {
                grid.AddWindow(labelPtr, 0, 0, 0, null);
            }
        };

        // const wxRect r(display.GetGeometry());
        const rectX = new Int32Array(1);
        const rectY = new Int32Array(1);
        const rectW = new Int32Array(1);
        const rectH = new Int32Array(1);
        display.GetGeometry(
            pointerOf(rectX), pointerOf(rectY), pointerOf(rectW), pointerOf(rectH));

        addLabel("Origin: ");
        addLabel(`(${rectX[0]}, ${rectY[0]})`);

        addLabel("Size: ");
        addLabel(`(${rectW[0]}, ${rectH[0]})`);

        // const wxRect rc(display.GetClientArea());
        const clientX = new Int32Array(1);
        const clientY = new Int32Array(1);
        const clientW = new Int32Array(1);
        const clientH = new Int32Array(1);
        display.GetClientArea(
            pointerOf(clientX), pointerOf(clientY), pointerOf(clientW), pointerOf(clientH));

        addLabel("Client area: ");
        addLabel(`(${clientX[0]}, ${clientY[0]})-(${clientW[0]}, ${clientH[0]})`);

        // const wxSize ppi = display.GetPPI();
        // const wxSize ppiRaw = display.GetRawPPI();
        addLabel("Resolution: ");
        const ppiW = new Int32Array(1);
        const ppiH = new Int32Array(1);
        display.GetPPI(pointerOf(ppiW), pointerOf(ppiH));

        let rawW = ppiW[0];
        let rawH = ppiH[0];
        const raw = display.GetRawPPI();
        if (raw)
        {
            rawW = raw.GetWidth();
            rawH = raw.GetHeight();
        }

        const resolutionText = (rawW === ppiW[0] && rawH === ppiH[0])
            ? `${ppiW[0]}*${ppiH[0]}`
            : `${ppiW[0]}*${ppiH[0]} (logical), ${rawW}*${rawH} (raw)`;
        addLabel(resolutionText);

        addLabel("Depth: ");
        addLabel(`${display.GetDepth()}`);

        addLabel("Scaling: ");
        addLabel(display.GetScaleFactor().toFixed(2));

        addLabel("Name: ");
        const nameValue = display.GetName();
        addLabel(nameValue ? readAndDeleteWxString(nameValue.ptr) : "");

        addLabel("Primary: ");
        addLabel(display.IsPrimary() ? "yes" : "no");

        // const wxString currentMode = VideoModeToText(display.GetCurrentMode());
        let currentMode = "";
        const currentModeValue = display.GetCurrentMode();
        if (currentModeValue)
        {
            currentMode = videoModeToText(currentModeValue);
            currentModeValue.Delete();
        }

        // ---- wxUSE_DISPLAY block: modes choice + reset button ----------------

        // sizer->Add(new wxStaticText(page, wxID_ANY, "&Modes: "),
        //            wxSizerFlags().CentreVertical());
        const modesLabelPtr = makeLabel(page.ptr, "&Modes: ");
        if (modesLabelPtr)
        {
            addWindowWithFlags(grid, modesLabelPtr, 0, (flags) => { flags.CenterVertical(); });
        }

        // wxChoice *choiceModes = new wxChoice(page, Display_ChangeMode);
        const choiceModes = createWxChoice(
            page.ptr, Display_ChangeMode, -1, -1, -1, -1, 0, null, 0);
        if (choiceModes)
        {
            // wxWindowUpdateLocker lockUpdates(choiceModes);
            choiceModes.Freeze();
            try
            {
                const modes: wxArrayVideoModes | null = display.GetModes();
                if (modes)
                {
                    const countModes = modes.GetCount();
                    for (let nMode = 0; nMode < countModes; nMode++)
                    {
                        const mode = modes.Item(nMode);
                        if (!mode)
                        {
                            continue;
                        }

                        const text = videoModeToText(mode);

                        // new MyVideoModeClientData(mode): an untyped client-data
                        // copy of the mode, owned by this module, not the control.
                        const modeCopyPtr = createWxVideoMode(
                            mode.GetWidth(), mode.GetHeight(),
                            mode.GetDepth(), mode.GetRefresh());
                        mode.Delete();

                        if (modeCopyPtr)
                        {
                            const modeCopy = new wxVideoMode(modeCopyPtr);
                            pageModes.push(modeCopy);

                            withString(text, (ptr) =>
                            {
                                choiceModes.AppendWithClientData(ptr, modeCopy.ptr);
                            });
                        }
                    }
                    modes.Delete();
                }
            }
            finally
            {
                choiceModes.Thaw();
            }

            withString(currentMode, (ptr) => { choiceModes.SetStringSelection(ptr); });

            // sizer->Add(choiceModes, wxSizerFlags().Expand());
            addWindowWithFlags(grid, choiceModes.ptr, 0, (flags) => { flags.Expand(); });
        }

        // sizer->Add(new wxStaticText(page, wxID_ANY, "Current: "));
        const currentLabelPtr = makeLabel(page.ptr, "Current: ");
        if (currentLabelPtr)
        {
            grid.AddWindow(currentLabelPtr, 0, 0, 0, null);
        }

        // sizer->Add(new wxStaticText(page, Display_CurrentMode, currentMode));
        const currentValuePtr = withString(currentMode, (ptr) =>
            createWxStaticText(
                page.ptr, Display_CurrentMode, ptr, -1, -1, -1, -1, 0));
        if (currentValuePtr)
        {
            grid.AddWindow(currentValuePtr.ptr, 0, 0, 0, null);
        }

        // add it to another sizer to have borders around it and button below
        const sizerTop = createWxBoxSizer(VERTICAL);
        if (!sizerTop)
        {
            state.modeData.push(pageModes);
            display.Delete();
            continue;
        }

        // sizerTop->Add(sizer, wxSizerFlags(1).Expand().DoubleBorder());
        addSizerWithFlags(sizerTop, grid.ptr, 1, (flags) =>
        {
            flags.Expand();
            flags.DoubleBorder(ALL);
        });

        // sizerTop->Add(new wxButton(page, Display_ResetMode, "&Reset mode"),
        //               wxSizerFlags().Centre().Border());
        const resetButton = withString("&Reset mode", (ptr) =>
            createWxButton(page.ptr, Display_ResetMode, ptr, -1, -1, -1, -1, 0));
        if (resetButton)
        {
            addWindowWithFlags(sizerTop, resetButton.ptr, 0, (flags) =>
            {
                flags.Center();
                flags.Border(ALL);
            });
        }

        page.SetSizer(sizerTop.ptr, true);
        page.Layout();

        // m_book->AddPage(page, wxString::Format("Display %zu", nDpy + 1));
        const added = withString(`Display ${nDpy + 1}`, (ptr) =>
            state.book.AddPage(page.ptr, ptr, false, -1));

        // Keep the modes aligned with the page index used by OnChangeMode.
        state.modeData.push(pageModes);

        if (!added)
        {
            page.Destroy();
        }

        display.Delete();
    }

    // SetClientSize(m_book->GetBestSize());
    // SetMinSize(GetSize());
    const best = state.book.GetBestSize();
    if (best)
    {
        state.frame.SetClientSize(best.GetWidth(), best.GetHeight());
    }

    const size = state.frame.GetSize();
    if (size)
    {
        state.frame.SetMinSize(size.GetWidth(), size.GetHeight());
    }
}

// ---------------------------------------------------------------------------
// MyFrame event handlers
// ---------------------------------------------------------------------------

/** MyFrame::OnQuit */
function onQuit(state: DisplayFrameState): void
{
    // true is to force the frame to close
    state.frame.Close(true);
}

/** MyFrame::OnFromPoint */
function onFromPoint(state: DisplayFrameState): void
{
    withString("Press the mouse anywhere...", (ptr) =>
    {
        state.frame.SetStatusText(ptr, 0);
    });

    state.frame.CaptureMouse();
}

/** MyFrame::OnFullScreen */
function onFullScreen(state: DisplayFrameState): void
{
    state.frame.ShowFullScreen(!state.frame.IsFullScreen(), FULLSCREEN_ALL);
}

/** MyFrame::OnContentProtection */
function onContentProtection(state: DisplayFrameState, event: wxCommandEvent): void
{
    let contentProtection = CONTENT_PROTECTION_NONE;
    if (event.GetId() === Display_ContentProtection_Enable)
    {
        contentProtection = CONTENT_PROTECTION_ENABLED;
    }

    if (state.frame.SetContentProtection(contentProtection))
    {
        switch (state.frame.GetContentProtection())
        {
            case CONTENT_PROTECTION_ENABLED:
                logInfo(
                    "The contents of this window should now NOT be visible in screen captures.");
                break;
            case CONTENT_PROTECTION_NONE:
                logInfo(
                    "The contents of this window should now be visible in screen captures.");
                break;
        }
    }
    else
    {
        logError("Content protection could not be changed");
    }
}

/** MyFrame::OnAbout */
function onAbout(state: DisplayFrameState): void
{
    withString(
        "Demo program for wxDisplay class.\n\n(c) 2003-2006 Vadim Zeitlin",
        (messagePtr) =>
        {
            withString("About Display Sample", (captionPtr) =>
            {
                kwxMessageBox(
                    messagePtr, captionPtr, OK | ICON_INFORMATION,
                    state.frame.ptr, -1, -1);
            });
        });
}

/** MyFrame::OnChangeMode */
function onChangeMode(state: DisplayFrameState, event: wxCommandEvent): void
{
    const selection = state.book.GetSelection();
    if (selection < 0)
    {
        return;
    }

    // The choice's items were filled in wxDisplay::GetModes() order, so the
    // selection index maps straight onto the mode stored for that item in C++
    // (MyVideoModeClientData::mode).
    const pageModes = state.modeData[selection];
    const index = event.GetInt();
    if (!pageModes || index < 0 || index >= pageModes.length)
    {
        return;
    }

    const displayPtr = createWxDisplay(selection);
    if (!displayPtr)
    {
        return;
    }

    const display = new wxDisplay(displayPtr);
    if (!display.ChangeMode(pageModes[index].ptr))
    {
        logError("Changing video mode failed!");
    }
    display.Delete();
}

/** MyFrame::OnResetMode */
function onResetMode(state: DisplayFrameState): void
{
    const selection = state.book.GetSelection();
    if (selection < 0)
    {
        return;
    }

    const displayPtr = createWxDisplay(selection);
    if (!displayPtr)
    {
        return;
    }

    const display = new wxDisplay(displayPtr);
    display.ResetMode();
    display.Delete();
}

/** MyFrame::OnDisplayChanged */
function onDisplayChanged(state: DisplayFrameState, event: wxDisplayChangedEvent): void
{
    state.book.DeleteAllPages();
    clearModeData(state);
    populateWithDisplayInfo(state);

    logStatus(state.frame, "Display resolution was changed.");

    event.Skip(true);
}

/** MyFrame::OnDPIChanged */
function onDPIChanged(state: DisplayFrameState, event: wxDPIChangedEvent): void
{
    const oldDPI = event.GetOldDPI();
    const newDPI = event.GetNewDPI();
    if (oldDPI && newDPI)
    {
        logStatus(
            state.frame,
            `DPI changed: was ${oldDPI.GetWidth()}*${oldDPI.GetHeight()}, ` +
            `now ${newDPI.GetWidth()}*${newDPI.GetHeight()}`);
    }

    event.Skip(true);
}

/** MyFrame::OnLeftClick */
function onLeftClick(state: DisplayFrameState, event: wxMouseEvent): void
{
    if (!state.frame.HasCapture())
    {
        return;
    }

    // mouse events are in client coords, wxDisplay works in screen ones
    const position = event.GetPosition();
    if (!position)
    {
        return;
    }

    const screen = state.frame.ClientToScreen(position.GetX(), position.GetY());
    if (!screen)
    {
        return;
    }

    const screenX = screen.GetX();
    const screenY = screen.GetY();

    const dpy = wxDisplay_GetFromPoint(screenX, screenY);
    if (dpy === NOT_FOUND)
    {
        logError("Mouse clicked outside of display!?");
    }

    logStatus(
        state.frame,
        `Mouse clicked in display ${dpy} (at (${screenX}, ${screenY}))`);

    state.frame.ReleaseMouse();
}

/** Connects the MyFrame event table entries. */
function connectFrameEvents(state: DisplayFrameState): void
{
    const bind = (
        first: number,
        last: number,
        eventType: number,
        handler: (eventPtr: Pointer) => void,
    ): void =>
    {
        const callback = new Callback(
            { parameters: ["pointer", "pointer", "pointer"], result: "void" },
            (_closureFun, _data, eventPtr) =>
            {
                // wxClosure invokes every handler with a null event at teardown.
                if (!eventPtr)
                {
                    return;
                }
                handler(eventPtr);
            },
        );
        const closure = createWxClosure(callback.pointer, null)!;
        state.frame.Connect(first, last, eventType, closure.ptr);
        state.bindings.push({ callback, closure });
    };

    // EVT_MENU(Display_Quit, MyFrame::OnQuit)
    bind(Display_Quit, Display_Quit, EVT_MENU, () => { onQuit(state); });
    // EVT_MENU(Display_FromPoint, MyFrame::OnFromPoint)
    bind(Display_FromPoint, Display_FromPoint, EVT_MENU, () => { onFromPoint(state); });
    // EVT_MENU(Display_FullScreen, MyFrame::OnFullScreen)
    bind(Display_FullScreen, Display_FullScreen, EVT_MENU, () => { onFullScreen(state); });
    // EVT_MENU(Display_ContentProtection_None, MyFrame::OnContentProtection)
    bind(Display_ContentProtection_None, Display_ContentProtection_None, EVT_MENU,
        (eventPtr) => { onContentProtection(state, new wxCommandEvent(eventPtr)); });
    // EVT_MENU(Display_ContentProtection_Enable, MyFrame::OnContentProtection)
    bind(Display_ContentProtection_Enable, Display_ContentProtection_Enable, EVT_MENU,
        (eventPtr) => { onContentProtection(state, new wxCommandEvent(eventPtr)); });
    // EVT_MENU(Display_About, MyFrame::OnAbout)
    bind(Display_About, Display_About, EVT_MENU, () => { onAbout(state); });

    // EVT_CHOICE(Display_ChangeMode, MyFrame::OnChangeMode)
    bind(Display_ChangeMode, Display_ChangeMode, EVT_CHOICE,
        (eventPtr) => { onChangeMode(state, new wxCommandEvent(eventPtr)); });
    // EVT_BUTTON(Display_ResetMode, MyFrame::OnResetMode)
    bind(Display_ResetMode, Display_ResetMode, EVT_BUTTON, () => { onResetMode(state); });

    // EVT_DISPLAY_CHANGED(MyFrame::OnDisplayChanged)
    bind(ID_ANY, ID_ANY, EVT_DISPLAY_CHANGED,
        (eventPtr) => { onDisplayChanged(state, new wxDisplayChangedEvent(eventPtr)); });

    // EVT_DPI_CHANGED(MyFrame::OnDPIChanged)
    bind(ID_ANY, ID_ANY, EVT_DPI_CHANGED,
        (eventPtr) => { onDPIChanged(state, new wxDPIChangedEvent(eventPtr)); });

    // EVT_LEFT_UP(MyFrame::OnLeftClick)
    bind(ID_ANY, ID_ANY, EVT_LEFT_UP,
        (eventPtr) => { onLeftClick(state, new wxMouseEvent(eventPtr)); });

    // The C++ frame has no explicit close handler; ending the loop here is the
    // kwxTypeScript equivalent of the last top-level window being destroyed.
    bind(ID_ANY, ID_ANY, EVT_CLOSE_WINDOW, () => { exitMainLoop(); });
}

// ---------------------------------------------------------------------------
// MyFrame constructor
// ---------------------------------------------------------------------------

function createMainFrame(): DisplayFrameState | null
{
    const frame = withString("Display wxWidgets Sample", (ptr) =>
        createWxFrame(null, ID_ANY, ptr, -1, -1, -1, -1, DEFAULT_FRAME_STYLE));
    if (!frame)
    {
        return null;
    }

    // SetIcon(wxICON(sample)) — load the same artwork at run time (a
    // kwxTypeScript program has no Win32 resources).
    const iconPath = createWxString(samplePath("sample.xpm"));
    const icon = createWxIconLoad(iconPath.ptr, BigInt(BITMAP_TYPE_XPM), -1, -1);
    iconPath.Delete();
    if (icon)
    {
        if (icon.IsOk())
        {
            frame.SetIcon(icon.ptr);
        }
        icon.Delete();
    }

    // create a menu bar
    const menuDisplay = createPlainMenu();
    const helpMenu = createPlainMenu();
    if (!menuDisplay || !helpMenu)
    {
        frame.Destroy();
        return null;
    }

    appendMenuItem(menuDisplay, Display_FromPoint, "Find from &point...");
    menuDisplay.AppendSeparator();

    // itemFullScreen = new wxMenuItem(menuDisplay, Display_FullScreen,
    //                                 "Full &screen\tF12")
    // The item is appended after the content-protection submenu, as in C++.
    const contentProtectionMenu = createPlainMenu();
    if (contentProtectionMenu)
    {
        appendRadioItem(contentProtectionMenu, Display_ContentProtection_None, "&None");
        contentProtectionMenu.Check(Display_ContentProtection_None, true);
        appendRadioItem(contentProtectionMenu, Display_ContentProtection_Enable, "&Enabled");

        withString("Content &Protection", (textPtr) =>
        {
            menuDisplay.AppendSub(ID_ANY, textPtr, contentProtectionMenu.ptr, null);
        });
    }

    appendMenuItem(menuDisplay, Display_FullScreen, "Full &screen\tF12");

    const fullScreenItem = menuDisplay.FindItem(Display_FullScreen);
    if (fullScreenItem)
    {
        // itemFullScreen->SetBitmap(
        //     wxArtProvider::GetBitmap(wxART_FULL_SCREEN, wxART_MENU))
        const bitmap = wxArtProvider_GetBitmap(ART_FULL_SCREEN, ART_MENU, -1, -1);

        if (bitmap)
        {
            fullScreenItem.SetBitmap(bitmap.ptr);
            bitmap.Delete();
        }
    }

    menuDisplay.AppendSeparator();
    appendMenuItemWithHelp(
        menuDisplay, Display_Quit, "E&xit\tAlt-X", "Quit this program");

    // the "About" item should be in the help menu
    appendMenuItemWithHelp(helpMenu, Display_About, "&About\tF1", "Show about dialog");

    // now append the freshly created menu to the menu bar...
    const menuBar = createWxMenuBar(0);
    if (!menuBar)
    {
        frame.Destroy();
        return null;
    }

    withString("&Display", (ptr) => { menuBar.Append(menuDisplay.ptr, ptr); });
    withString("&Help", (ptr) => { menuBar.Append(helpMenu.ptr, ptr); });

    // EnableFullScreenView();  (default enable=true, mode=wxFULLSCREEN_ALL)
    frame.EnableFullScreenView(true, BigInt(FULLSCREEN_ALL));

    // ... and attach this menu bar to the frame
    frame.SetMenuBar(menuBar.ptr);

    // create status bar: CreateStatusBar() defaults (1 pane, wxSTB_DEFAULT_STYLE, id 0)
    frame.CreateStatusBar(1, STB_DEFAULT_STYLE, 0);

    // create child controls
    // m_book = new wxBookCtrl(this, wxID_ANY);
    // wxBookCtrl is wxNotebook when wxUSE_NOTEBOOK is on (the default).
    const book = createWxNotebook(frame.ptr, ID_ANY, -1, -1, -1, -1, 0);
    if (!book)
    {
        frame.Destroy();
        return null;
    }

    const state: DisplayFrameState = { frame, book, bindings: [], modeData: [] };
    populateWithDisplayInfo(state);
    return state;
}

// ---------------------------------------------------------------------------
// MyApp::OnInit
// ---------------------------------------------------------------------------

export function main(): number
{
    if (!initialize())
    {
        console.error("display: initialize() failed");
        return 1;
    }

    setAppName("Display wxWidgets Sample");

    const state = createMainFrame();
    if (!state)
    {
        console.error("display: failed to create the main frame");
        shutdown();
        return 1;
    }

    connectFrameEvents(state);

    // and show it (the frames, unlike simple controls, are not shown when
    // created initially)
    state.frame.Show();
    setTopWindow(state.frame.ptr);

    const exitCode = run();

    for (const binding of state.bindings)
    {
        binding.callback.close();
    }
    clearModeData(state);
    shutdown();
    return exitCode;
}

exit(main());
