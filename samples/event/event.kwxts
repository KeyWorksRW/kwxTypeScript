    TRANSPARENT_PEN,
    VERTICAL,
    WHITE,
    wxEventFilter_SetResult,
    wxEvtHandler_AddFilter,
    wxEvtHandler_RemoveFilter,
    createWxAffineMatrix2D,
    createWxAutoBufferedPaintDC,
    createWxBitmapLoad,
    createWxBoxSizer,
    createWxButton,
    createWxClosure,
    createWxCommandEvent,
    createWxCursorFromStock,
    createWxDialog,
    createWxEventFilter,
    createWxEvtHandler,
    createWxFrame,
    createWxGCDC,
    createWxIconLoad,
    createKwxPanel,
    createWxLogTextCtrl,
    createWxMenu,
    createWxMenuBar,
    createWxPaintDC,
