function fileOpenGeneric(): void
{
    const current = state;
    if (!current) return;

    // C++ passes wxEmptyString and then SetDirectory(wxGetHomeDir()); the
    // generic dialog has no SetDirectory binding, so pass the directory to the
    // constructor, which starts from the same state.
    const home = homeDir();
    const dialog = withStrings([
        "Testing open file dialog", home, "", "C++ files (*.cpp;*.h)|*.cpp;*.h",
    ], (ptrs) => createWxGenericFileDialog(
        current.frame.ptr, ptrs[0], ptrs[1], ptrs[2], ptrs[3], FD_OPEN));
    if (!dialog) return;

    const base = wrapWxFileDialog(dialog.ptr);
    hookInfo = "";
    const hook = createFileCustomizeHook(base);
    if (hook) dialog.SetCustomizeHook(hook.ptr);

    if (dialog.ShowModal() === ID_OK)
    {
        const info = `Full file name: ${takeText(dialog.GetPath())}\n` +
            `Path: ${takeText(dialog.GetDirectory())}\n` +
            `Name: ${takeText(dialog.GetFilename())}\n` +
            `Custom window: ${hookInfo}`;

        withStrings([info, "Selected file"], (ptrs) =>
        {
            const second = createWxMessageDialog(
                current.frame.ptr, ptrs[0], ptrs[1], OK | CENTRE);
            if (!second) return;
            second.ShowModal();
            second.Destroy();
        });
    }

    dialog.Destroy();
    if (hook) hook.Delete();
    resetHookState();
    closeCustomizerCallbacks();
}

