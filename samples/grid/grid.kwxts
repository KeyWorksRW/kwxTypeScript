// ---------------------------------------------------------------------------
// Menu construction helpers
// ---------------------------------------------------------------------------

function newMenu(): wxMenu | null
{
    const title = createWxString("");
    const menu = createWxMenu(title.ptr, 0n);
    title.Delete();
    return menu;
}

function appendItem(
    menu: wxMenu,
    id: number,
    text: string,
    help?: string,
): void
{
    withString(text, (label) =>
    {
        withString(help ?? "", (helpText) =>
            menu.Append(id, label, helpText, false));
    });
}

function appendCheck(
    menu: wxMenu,
    id: number,
    text: string,
    help?: string,
): void
{
    withString(text, (label) =>
    {
        withString(help ?? "", (helpText) =>
            menu.AppendCheckItem(id, label, helpText));
    });
}

function appendRadio(menu: wxMenu, id: number, text: string): void
{
    withString(text, (label) =>
    {
        withString("", (helpText) => menu.AppendRadioItem(id, label, helpText));
    });
}

function appendSub(
    menu: wxMenu,
    id: number,
    text: string,
    submenu: wxMenu,
    help?: string,
): void
{
    withString(text, (label) =>
    {
        withString(help ?? "", (helpText) =>
            menu.AppendSub(id, label, submenu.ptr, helpText));
    });
}

function appendSubMenu(menu: wxMenu, submenu: wxMenu, text: string): void
{
    withString(text, (label) =>
    {
        withString("", (helpText) =>
            menu.AppendSubMenu(submenu.ptr, label, helpText));
    });
}

function addMenu(bar: wxMenuBar, menu: wxMenu, title: string): void
{
    withString(title, (label) => bar.Append(menu.ptr, label));
}

// ---------------------------------------------------------------------------
// The complete menu tree of GridFrame::GridFrame()
// ---------------------------------------------------------------------------

interface GridMenus
{
    readonly menuBar: wxMenuBar;
    readonly fileMenu: wxMenu;
    readonly viewMenu: wxMenu;
    readonly colMenu: wxMenu;
    readonly editMenu: wxMenu;
    readonly selectMenu: wxMenu;
    readonly autosizeMenu: wxMenu;
    readonly helpMenu: wxMenu;
    readonly setupMenu: wxMenu;
}

function buildMenus(): GridMenus | null
{
    const fileMenu = newMenu();
    const viewMenu = newMenu();
    const colMenu = newMenu();
    const editMenu = newMenu();
    const selectMenu = newMenu();
    const autosizeMenu = newMenu();
    const helpMenu = newMenu();
    const setupMenu = newMenu();
    const rowLabelMenu = newMenu();
    const colLabelMenu = newMenu();
    const cornerLabelMenu = newMenu();
    const colHeaderMenu = newMenu();
    const tabBehaviourMenu = newMenu();
    const selectionMenu = newMenu();

    for (const menu of [
        fileMenu, viewMenu, colMenu, editMenu, selectMenu, autosizeMenu,
        helpMenu, setupMenu, rowLabelMenu, colLabelMenu, cornerLabelMenu,
        colHeaderMenu, tabBehaviourMenu, selectionMenu,
    ])
    {
        if (!menu)
        {
            return null;
        }
    }

    const f = fileMenu!;
    const v = viewMenu!;
    const c = colMenu!;
    const e = editMenu!;
    const s = selectMenu!;
    const a = autosizeMenu!;
    const h = helpMenu!;
    const setup = setupMenu!;
    const rowLabel = rowLabelMenu!;
    const colLabel = colLabelMenu!;
    const cornerLabel = cornerLabelMenu!;
    const colHeader = colHeaderMenu!;
    const tabBehaviour = tabBehaviourMenu!;
    const selection = selectionMenu!;

    // File
    appendItem(f, ID_VTABLE, "&Virtual table test\tCtrl-V");
    appendItem(f, ID_BUGS_TABLE, "&Bugs table test\tCtrl-B");
    appendItem(f, ID_TABULAR_TABLE, "&Tabular table test\tCtrl-T");
    f.AppendSeparator();

    appendCheck(setup, ID_RENDER_ROW_LABEL, "Render row labels");
    appendCheck(setup, ID_RENDER_COL_LABEL, "Render column labels");
    appendCheck(setup, ID_RENDER_GRID_LINES, "Render grid cell lines");
    appendCheck(setup, ID_RENDER_GRID_BORDER, "Render border");
    appendCheck(setup, ID_RENDER_SELECT_HLIGHT, "Render selection highlight");
    setup.AppendSeparator();
    appendCheck(setup, ID_RENDER_LOMETRIC, "Use LOMETRIC mapping mode");
    appendCheck(setup, ID_RENDER_DEFAULT_SIZE, "Use wxDefaultSize");
    appendCheck(setup, ID_RENDER_MARGIN, "Logical 50 unit margin");
    appendCheck(setup, ID_RENDER_ZOOM, "Zoom 125%");

    setup.Check(ID_RENDER_ROW_LABEL, true);
    setup.Check(ID_RENDER_COL_LABEL, true);
    setup.Check(ID_RENDER_GRID_LINES, true);
    setup.Check(ID_RENDER_GRID_BORDER, true);

    appendSubMenu(f, setup, "Render setup");
    appendItem(f, ID_PRINT, "Render");
    appendItem(f, ID_RENDER_COORDS, "Render G5:P30");

    f.AppendSeparator();
    appendItem(f, ID_CLEAR, "Clear &log\tCtrl-L");
    f.AppendSeparator();
    appendItem(f, ID_EXIT, "E&xit\tAlt-X");

    // Grid
    appendCheck(v, ID_TOGGLEROWLABELS, "&Row labels");
    appendCheck(v, ID_TOGGLECOLLABELS, "&Col labels");
    appendCheck(v, ID_TOGGLEEDIT, "&Editable");
    appendCheck(v, ID_TOGGLEROWSIZING, "Ro&w drag-resize");
    appendCheck(v, ID_TOGGLECOLSIZING, "C&ol drag-resize");
    appendCheck(v, ID_TOGGLEROWLABELSIZING, "Row label drag-resize");
    appendCheck(v, ID_TOGGLECOLLABELSIZING, "Col label drag-resize");
    appendCheck(v, ID_TOGGLEROWMOVING, "Row drag-move");
    appendCheck(v, ID_TOGGLECOLMOVING, "Col drag-&move");
    appendCheck(v, ID_TOGGLECOLHIDING, "Col hiding popup menu");
    appendCheck(v, ID_TOGGLEGRIDSIZING, "&Grid drag-resize");
    appendCheck(v, ID_TOGGLEGRIDDRAGCELL, "&Grid drag-cell");
    appendCheck(v, ID_TOGGLEGRIDLINES, "&Grid Lines");
    appendCheck(v, ID_SET_HIGHLIGHT_WIDTH, "&Set Cell Highlight Width...");
    appendCheck(v, ID_SET_RO_HIGHLIGHT_WIDTH, "&Set Cell RO Highlight Width...");
    appendCheck(v, ID_AUTOSIZECOLS, "&Auto-size cols");
    appendCheck(v, ID_CELLOVERFLOW, "&Overflow cells");
    appendCheck(v, ID_RESIZECELL, "&Resize cell (7,1)");
    appendCheck(
        v, ID_TOGGLE_CHECKERED_CELLS,
        "Toggle Chec&kered Cells\tCtrl+Shift+K",
    );
    appendCheck(
        v, ID_TOGGLE_COLOURED_CELLS,
        "Toggle Co&loured Cells\tCtrl+Shift+L",
    );
    appendItem(v, ID_HIDECOL, "&Hide column A");
    appendItem(v, ID_SHOWCOL, "&Show column A");
    appendItem(v, ID_HIDEROW, "&Hide row 2");
    appendItem(v, ID_SHOWROW, "&Show row 2");

    appendRadio(rowLabel, ID_ROWLABELHORIZALIGN, "&Horizontal");
    appendRadio(rowLabel, ID_ROWLABELVERTALIGN, "&Vertical");
    appendSub(
        v, ID_ROWLABELALIGN, "R&ow label alignment", rowLabel,
        "Change alignment of row labels",
    );

    appendRadio(colLabel, ID_COLLABELHORIZALIGN, "&Horizontal");
    appendRadio(colLabel, ID_COLLABELVERTALIGN, "&Vertical");
    appendSub(
        v, ID_COLLABELALIGN, "Col l&abel alignment", colLabel,
        "Change alignment of col labels",
    );

    appendRadio(cornerLabel, ID_CORNERLABELHORIZALIGN, "&Horizontal");
    appendRadio(cornerLabel, ID_CORNERLABELVERTALIGN, "&Vertical");
