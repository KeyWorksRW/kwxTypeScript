// headerctrl.kwxts — port of wxSamples/src/widgets/headerctrl.cpp
//
// Port notes / binding gaps (see the final report):
//  * In this binding set wxHeaderCtrlSimple is NOT a wxWindow subclass, so its
//    native pointer is wrapped with wrapWxWindow() for the static box sizer, for
//    NotifyWidgetRecreation() and for the EVT_HEADER_* bindings; the column API
//    is reached through the wxHeaderCtrlSimple wrapper.
//  * wxHeaderColumn (the abstract base) has no generated wrapper.  Every
//    operation the sample needs — construction from title/width/alignment/flags
//    and SetBitmap() — exists on wxHeaderColumnSimple, so nothing is lost.
//  * wxArtBits are bound as ART_*; wxArtProvider::GetBitmapBundle() is available
//    only as the free function wxArtProvider_GetBitmapBundle(id, client, w, h).
//  * HEADER_CTRL_FAMILY (NATIVE_CTRLS vs GENERIC_CTRLS) is book category
//    metadata; it lives in pages.kwxts, not in this page module.

import {
    ALIGN_CENTRE,
    ALIGN_CENTRE_HORIZONTAL,
    ALIGN_LEFT,
    ALIGN_NOT,
    ALIGN_RIGHT,
    ART_BUTTON,
    ART_ERROR,
    ART_INFORMATION,
    ART_QUESTION,
    ART_WARNING,
    COL_DEFAULT_FLAGS,
    COL_HIDDEN,
    COL_REORDERABLE,
    COL_RESIZABLE,
    COL_SORTABLE,
    createWxBoxSizer,
    createWxButton,
    createWxHeaderColumnSimple,
    createWxHeaderCtrlSimple,
    createWxRadioBox,
    EVT_BUTTON,
    EVT_CHECKBOX,
    EVT_HEADER_BEGIN_RESIZE,
    EVT_HEADER_END_RESIZE,
    EVT_HEADER_RESIZING,
    EVT_RADIOBOX,
    EVT_UPDATE_UI,
    EXPAND,
    HD_ALLOW_HIDE,
    HD_ALLOW_REORDER,
    HD_BITMAP_ON_RIGHT,
    HD_DEFAULT_STYLE,
    HORIZONTAL,
    ID_ANY,
    NOT_FOUND,
    RA_SPECIFY_COLS,
    VERTICAL,
    wxArtProvider_GetBitmapBundle,
    wxCheckBox,
    wxHeaderColumnSimple,
    wxHeaderCtrlEvent,
    wxHeaderCtrlSimple,
    wxRadioBox,
    wxUpdateUIEvent,
    wxWindow,
    wrapWxHeaderCtrlSimple,
    wrapWxWindow,
} from "kwx";
import { Pointer, pointerOf } from "kwx/platform";

import {
    addSizer,
    addSpacer,
    addStretchSpacer,
    addWin,
    attrs,
    bindEvent,
    border,
    logMessage,
    makeStaticBoxSizer,
    StaticBoxSizerParts,
    WidgetsPage,
    withString,
} from "./common.kwxts";

const NUMBER_OF_COLUMNS = 4;

/** gs_colAlignments */
const COL_ALIGNMENT_LABELS: string[] = ["none", "left", "centre", "right"];

/** gs_colAlignFlags */
const COL_ALIGNMENT_FLAGS: number[] = [ALIGN_NOT, ALIGN_LEFT, ALIGN_CENTRE, ALIGN_RIGHT];

const COL_WITH_BITMAP_DEFAULT = false;
const COL_ALIGNMENT_FLAG_DEFAULT = ALIGN_NOT;
const COL_ALIGNMENT_INDEX_DEFAULT = 0;

/** Radio box geometry: 2 columns, wxRA_SPECIFY_COLS. */
const COL_ALIGNMENT_DIMENSION = 2;

/** wxART_ERROR, wxART_QUESTION, wxART_WARNING, wxART_INFORMATION */
const COLUMN_ART_IDS: Pointer[] = [ART_ERROR, ART_QUESTION, ART_WARNING, ART_INFORMATION];

/** The three header style check boxes. */
interface HeaderStyleChecks
{
    readonly chkAllowReorder: wxCheckBox;
    readonly chkAllowHide: wxCheckBox;
    readonly chkBitmapOnRight: wxCheckBox;
}

/** One entry of the C++ m_colSettings array. */
interface ColumnSettings
{
    readonly chkAllowResize: wxCheckBox;
    readonly chkAllowReorder: wxCheckBox;
    readonly chkAllowSort: wxCheckBox;
    readonly chkAllowHide: wxCheckBox;
    readonly chkWithBitmap: wxCheckBox;
    readonly rbAlignments: wxRadioBox;
}

/**
 * Creates the "Alignment" wxRadioBox.  kwxFFI takes a `char**` item array, so
 * the labels are encoded as NUL-terminated UTF-8 buffers and their addresses
 * are passed; both stay reachable until the native call has copied them.
 */
function createAlignmentRadioBox(parent: Pointer): wxRadioBox
{
    const buffers: Uint8Array[] = [];
    const pointers = new BigUint64Array(COL_ALIGNMENT_LABELS.length);

    for (let index = 0; index < COL_ALIGNMENT_LABELS.length; index++)
    {
        const bytes = new TextEncoder().encode(COL_ALIGNMENT_LABELS[index] + "\0");
        buffers.push(bytes);
        const address = pointerOf(bytes);
        pointers[index] = address === null ? 0n : address;
    }

    const radioBox = withString("Alignment", (ptr) =>
        createWxRadioBox(
            parent, ID_ANY, ptr, -1, -1, -1, -1,
            COL_ALIGNMENT_LABELS.length, pointerOf(pointers),
            COL_ALIGNMENT_DIMENSION, RA_SPECIFY_COLS,
        ));

    // Keeps the native buffers alive until the constructor has copied them.
    void buffers;
    return radioBox!;
}

export class HeaderCtrlPage extends WidgetsPage
{
    private header: Pointer = null;
    private headerSizer: StaticBoxSizerParts | null = null;
    private styleChecks: HeaderStyleChecks | null = null;
    private readonly colSettings: ColumnSettings[] = [];
    /** Columns appended to the current header, released on the next recreation. */
    private readonly columns: wxHeaderColumnSimple[] = [];

    constructor(parent: Pointer)
    {
        super(parent, "icons/header");
    }

    override getWidget(): wxWindow | null
    {
        return this.header ? wrapWxWindow(this.header) : null;
    }

    override createContent(): void
    {
        // Top pane.
        const topSizer = createWxBoxSizer(HORIZONTAL)!;

        // Header style.
        const style = makeStaticBoxSizer(this.page.ptr, VERTICAL, "&Header style");

        const chkAllowReorder = this.createCheckBoxAndAddToSizer(
            style.sizer, "Allow &reorder", ID_ANY, style.box.ptr);
        const chkAllowHide = this.createCheckBoxAndAddToSizer(
            style.sizer, "Alow &hide", ID_ANY, style.box.ptr);
        const chkBitmapOnRight = this.createCheckBoxAndAddToSizer(
            style.sizer, "&Bitmap on right", ID_ANY, style.box.ptr);

        this.styleChecks = { chkAllowReorder, chkAllowHide, chkBitmapOnRight };
        this.resetHeaderStyle();

        addStretchSpacer(style.sizer, 1);

        const resetButton = withString("&Reset", (ptr) =>
            createWxButton(style.box.ptr, ID_ANY, ptr, -1, -1, -1, -1, 0))!;
        addWin(style.sizer, resetButton, 0, ALIGN_CENTRE_HORIZONTAL, border());

        addSizer(topSizer, style.sizer, 0, EXPAND, 0);

        // Column flags.
        for (let index = 0; index < NUMBER_OF_COLUMNS; index++)
        {
            const columnSizer = makeStaticBoxSizer(
                this.page.ptr, VERTICAL, `Column ${index + 1} style`);

            const settings: ColumnSettings = {
                chkAllowResize: this.createCheckBoxAndAddToSizer(
                    columnSizer.sizer, "Allow resize", ID_ANY, columnSizer.box.ptr),
                chkAllowReorder: this.createCheckBoxAndAddToSizer(
                    columnSizer.sizer, "Allow reorder", ID_ANY, columnSizer.box.ptr),
                chkAllowSort: this.createCheckBoxAndAddToSizer(
                    columnSizer.sizer, "Allow sort", ID_ANY, columnSizer.box.ptr),
                chkAllowHide: this.createCheckBoxAndAddToSizer(
                    columnSizer.sizer, "Hidden", ID_ANY, columnSizer.box.ptr),
                chkWithBitmap: this.createCheckBoxAndAddToSizer(
                    columnSizer.sizer, "With bitmap", ID_ANY, columnSizer.box.ptr),
                rbAlignments: createAlignmentRadioBox(columnSizer.box.ptr),
            };
            this.colSettings.push(settings);

            addWin(columnSizer.sizer, settings.rbAlignments, 0, EXPAND, border());
            this.resetColumnStyle(index);

            addSpacer(topSizer, this.dip(15));
            addSizer(topSizer, columnSizer.sizer, 0, EXPAND, 0);
        }

        // Bottom pane.
        const headerBox = makeStaticBoxSizer(this.page.ptr, VERTICAL, "Header");
        this.headerSizer = headerBox;
        this.recreateWidget();

        // The two panes compose the window.
        const allSizer = createWxBoxSizer(VERTICAL)!;
        addSizer(allSizer, topSizer, 0, EXPAND, border());
        addSizer(allSizer, headerBox.sizer, 1, EXPAND, border());

        this.page.SetSizer(allSizer.ptr, false);

        // m_chk*->Bind(wxEVT_CHECKBOX, &...OnStyleCheckOrRadioBox)
        const onStyleChanged = (eventPtr: Pointer): void =>
        {
            if (!eventPtr)
            {
                return;
            }
            this.recreateWidget();
        };

        bindEvent(chkAllowReorder, ID_ANY, ID_ANY, EVT_CHECKBOX, onStyleChanged);
        bindEvent(chkAllowHide, ID_ANY, ID_ANY, EVT_CHECKBOX, onStyleChanged);
        bindEvent(chkBitmapOnRight, ID_ANY, ID_ANY, EVT_CHECKBOX, onStyleChanged);

        for (const settings of this.colSettings)
        {
            bindEvent(settings.chkAllowResize, ID_ANY, ID_ANY, EVT_CHECKBOX, onStyleChanged);
            bindEvent(settings.chkAllowReorder, ID_ANY, ID_ANY, EVT_CHECKBOX, onStyleChanged);
            bindEvent(settings.chkAllowSort, ID_ANY, ID_ANY, EVT_CHECKBOX, onStyleChanged);
            bindEvent(settings.chkAllowHide, ID_ANY, ID_ANY, EVT_CHECKBOX, onStyleChanged);
            bindEvent(settings.chkWithBitmap, ID_ANY, ID_ANY, EVT_CHECKBOX, onStyleChanged);
            bindEvent(settings.rbAlignments, ID_ANY, ID_ANY, EVT_RADIOBOX, onStyleChanged);
        }

        // btnReset->Bind(wxEVT_BUTTON, &...OnResetButton)
        bindEvent(resetButton, ID_ANY, ID_ANY, EVT_BUTTON, (eventPtr) =>
        {
            if (!eventPtr) return;
            this.resetHeaderStyle();
            for (let index = 0; index < this.colSettings.length; index++)
            {
                this.resetColumnStyle(index);
            }
            this.recreateWidget();
        });

        bindEvent(resetButton, ID_ANY, ID_ANY, EVT_UPDATE_UI, (eventPtr) =>
        {
            if (!eventPtr) return;
            let enable = this.getHeaderStyleFlags() !== HD_DEFAULT_STYLE;
            for (let index = 0; !enable && index < this.colSettings.length; index++)
            {
                enable = this.getColumnStyleFlags(index) !== COL_DEFAULT_FLAGS
                    || this.colSettings[index].chkWithBitmap.GetValue() !== COL_WITH_BITMAP_DEFAULT
                    || this.colSettings[index].rbAlignments.GetSelection()
                        !== COL_ALIGNMENT_INDEX_DEFAULT;
            }
            new wxUpdateUIEvent(eventPtr, true).Enable(enable);
        });
    }

    override recreateWidget(): void
    {
        const sizer = this.headerSizer;
        if (!sizer)
        {
            return;
        }

        // Clear(true) destroys the header window; drop the stale pointer and the
        // column objects that were appended to it.
        this.header = null;
        sizer.sizer.Clear(true /* delete windows */);
        this.deleteColumns();

        const flags = attrs.defaultFlags | this.getHeaderStyleFlags();

        this.header = createWxHeaderCtrlSimple(
            sizer.box.ptr, ID_ANY, -1, -1, -1, -1, BigInt(flags));

        const window = wrapWxWindow(this.header);
        this.notifyWidgetRecreation(window);

        bindEvent(window, ID_ANY, ID_ANY, EVT_HEADER_RESIZING, (eventPtr) =>
        {
            if (!eventPtr) return;
            const event = new wxHeaderCtrlEvent(eventPtr, true);
            logMessage(`Column ${event.GetColumn() + 1} resizing, width = ${event.GetWidth()}`);
            event.Skip(true);
        });

        bindEvent(window, ID_ANY, ID_ANY, EVT_HEADER_BEGIN_RESIZE, (eventPtr) =>
        {
            if (!eventPtr) return;
            const event = new wxHeaderCtrlEvent(eventPtr, true);
            logMessage(`Column ${event.GetColumn() + 1} resize began, width = ${event.GetWidth()}`);
            event.Skip(true);
        });

        bindEvent(window, ID_ANY, ID_ANY, EVT_HEADER_END_RESIZE, (eventPtr) =>
        {
            if (!eventPtr) return;
            const event = new wxHeaderCtrlEvent(eventPtr, true);
            logMessage(`Column ${event.GetColumn() + 1} resize ended, width = ${event.GetWidth()}`);
            event.Skip(true);
        });

        const headerControl: wxHeaderCtrlSimple = wrapWxHeaderCtrlSimple(this.header);

        for (let index = 0; index < this.colSettings.length; index++)
        {
            this.appendColumn(headerControl, index);
        }

        addStretchSpacer(sizer.sizer, 1);
        addWin(sizer.sizer, window, 0, EXPAND, 0);
        addStretchSpacer(sizer.sizer, 1);
        sizer.sizer.Layout();
    }

    /** Appends the column described by the current settings of `index`. */
    private appendColumn(header: wxHeaderCtrlSimple, index: number): void
    {
        const settings = this.colSettings[index];
        const alignment = this.getColumnAlignmentFlag(index);
        const flags = this.getColumnStyleFlags(index);

        withString(`Column ${index + 1}`, (title) =>
        {
            const columnPtr = createWxHeaderColumnSimple(
                title, this.dip(100), alignment, flags);
            if (!columnPtr)
            {
                return;
            }

            // Owned here (not borrowed).  AppendColumn() copies the column, but
            // the temporary is kept alive until the next recreation so the port
            // stays correct under either ownership model.
            const column = new wxHeaderColumnSimple(columnPtr);

            if (settings.chkWithBitmap.GetValue())
            {
                const bundle = wxArtProvider_GetBitmapBundle(
                    COLUMN_ART_IDS[index % COLUMN_ART_IDS.length], ART_BUTTON, -1, -1);
                if (bundle)
                {
                    column.SetBitmap(bundle.ptr);
                    bundle.Delete();
                }
            }

            header.AppendColumn(column.ptr);
            this.columns.push(column);
        });
    }

    /** Releases the wxHeaderColumnSimple objects of the previous recreation. */
    private deleteColumns(): void
    {
        for (const column of this.columns)
        {
            column.Delete();
        }
        this.columns.length = 0;
    }

    /** HeaderCtrlWidgetsPage::ResetHeaderStyle() */
    private resetHeaderStyle(): void
    {
        const checks = this.styleChecks;
        if (!checks)
        {
            return;
        }
        checks.chkAllowReorder.SetValue((HD_DEFAULT_STYLE & HD_ALLOW_REORDER) !== 0);
        checks.chkAllowHide.SetValue((HD_DEFAULT_STYLE & HD_ALLOW_HIDE) !== 0);
        checks.chkBitmapOnRight.SetValue((HD_DEFAULT_STYLE & HD_BITMAP_ON_RIGHT) !== 0);
    }

    /** HeaderCtrlWidgetsPage::GetHeaderStyleFlags() */
    private getHeaderStyleFlags(): number
    {
        const checks = this.styleChecks;
        if (!checks)
        {
            return 0;
        }

        let flags = 0;
        if (checks.chkAllowReorder.GetValue())
        {
            flags |= HD_ALLOW_REORDER;
        }
        if (checks.chkAllowHide.GetValue())
        {
            flags |= HD_ALLOW_HIDE;
        }
        if (checks.chkBitmapOnRight.GetValue())
        {
            flags |= HD_BITMAP_ON_RIGHT;
        }
        return flags;
    }

    /** HeaderCtrlWidgetsPage::ResetColumnStyle() */
    private resetColumnStyle(index: number): void
    {
        const settings = this.colSettings[index];
        if (!settings)
        {
            return;
        }
        settings.chkAllowResize.SetValue((COL_DEFAULT_FLAGS & COL_RESIZABLE) !== 0);
        settings.chkAllowReorder.SetValue((COL_DEFAULT_FLAGS & COL_REORDERABLE) !== 0);
        settings.chkAllowSort.SetValue((COL_DEFAULT_FLAGS & COL_SORTABLE) !== 0);
        settings.chkAllowHide.SetValue((COL_DEFAULT_FLAGS & COL_HIDDEN) !== 0);
        settings.chkWithBitmap.SetValue(COL_WITH_BITMAP_DEFAULT);
        settings.rbAlignments.SetSelection(COL_ALIGNMENT_INDEX_DEFAULT);
    }

    /** HeaderCtrlWidgetsPage::GetColumnStyleFlags() */
    private getColumnStyleFlags(index: number): number
    {
        const settings = this.colSettings[index];
        if (!settings)
        {
            return 0;
        }

        let flags = 0;
        if (settings.chkAllowResize.GetValue())
        {
            flags |= COL_RESIZABLE;
        }
        if (settings.chkAllowReorder.GetValue())
        {
            flags |= COL_REORDERABLE;
        }
        if (settings.chkAllowSort.GetValue())
        {
            flags |= COL_SORTABLE;
        }
        if (settings.chkAllowHide.GetValue())
        {
            flags |= COL_HIDDEN;
        }
        return flags;
    }

    /** HeaderCtrlWidgetsPage::GetColumnAlignmentFlag() */
    private getColumnAlignmentFlag(index: number): number
    {
        const settings = this.colSettings[index];
        if (!settings)
        {
            return COL_ALIGNMENT_FLAG_DEFAULT;
        }

        // wxRadioBox::GetSelection() returns wxNOT_FOUND (-1) when nothing is
        // selected; C++ falls back to COL_ALIGNMENT_FLAG_DEFAULT then.
        const selection = settings.rbAlignments.GetSelection();
        if (selection === NOT_FOUND || selection < 0 || selection >= COL_ALIGNMENT_FLAGS.length)
        {
            return COL_ALIGNMENT_FLAG_DEFAULT;
        }
        return COL_ALIGNMENT_FLAGS[selection];
    }
}

export function createHeaderCtrlPage(parent: Pointer): WidgetsPage
{
    return new HeaderCtrlPage(parent);
}
