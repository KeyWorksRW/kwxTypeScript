    appendItem(c, ID_SETLABELTEXTCOLOUR, "Set label &text colour...");
    appendItem(c, ID_SETLABEL_FONT, "Set label fo&nt...");
    appendItem(c, ID_GRIDLINECOLOUR, "&Grid line colour...");
    appendItem(c, ID_SET_CELL_FG_COLOUR, "Set cell &foreground colour...");
    appendItem(c, ID_SET_CELL_BG_COLOUR, "Set cell &background colour...");
    appendItem(c, ID_SET_CELL_HL_COLOUR, "Set cell &highlight colour...");
    appendItem(c, ID_SET_SELECTION_FG_COLOUR, "Set selection f&oreground colour...");
    appendItem(c, ID_SET_SELECTION_BG_COLOUR, "Set selection b&ackground colour...");
    appendItem(c, ID_SET_FROZEN_BORDER, "Set f&rozen border colour...");

    // Edit
    appendItem(e, ID_INSERTROW, "Insert &rows\tCtrl+I");
    appendItem(e, ID_INSERTCOL, "Insert &columns\tCtrl+Shift+I");
    appendItem(e, ID_DELETEROW, "Delete selected ro&ws\tCtrl+D");
