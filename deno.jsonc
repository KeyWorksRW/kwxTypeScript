{
  // Type-checking configuration. The runtime is kwx_ts; Deno is used here as
  // the TypeScript compiler during development only. The import map resolves
  // the bare specifiers that the embedded runtime provides at run time.
  "lock": false,
  "imports": {
    "kwx": "./wx/mod.ts",
    "kwx/platform": "./src/kwx_platform.ts"
  },
  "tasks": {
    // The generated corpus is included: kwxgen verify already gates it against
    // the kwxFFI headers, and this catches wrapper-level type errors that the
    // generator itself cannot see (for example conflicting inherited signatures).
    "check": "deno check --no-lock src/kwx_platform.ts src/kwxApp.ts wx/mod.ts examples/demo.ts"
  }
}
